启动程序():
    输出("=== 162 数组方法 ===")
    数字数组 = [10, 20, 30, 40, 50]
    // ① 长度
    检查("长度", 数字数组.长度() == 5)
    // ② 追加
    数字数组.追加(60)
    检查("追加-长度+1", 数字数组.长度() == 6)
    检查("追加-末元素", 数字数组[6] == 60)
    // ③ 插入（索引从 1 开始）
    数字数组.插入(1, 5)
    检查("插入-开头", 数字数组[1] == 5)
    检查("插入-长度+1", 数字数组.长度() == 7)
    水果数组 = ["苹果", "香蕉", "橙子"]
    水果数组.插入(2, "梨")
    检查("插入-索引2", 水果数组[2] == "梨")
    检查("插入-原索引2后移", 水果数组[3] == "香蕉")
    // ④ 删除（索引从 1 开始）
    数字数组.删除(1)
    检查("删除-长度-1", 数字数组.长度() == 6)
    检查("删除-原索引2成首元素", 数字数组[1] == 10)
    // ⑤ 取末尾（取出并返回）
    末尾 = 数字数组.取末尾()
    检查("取末尾-返回值", 末尾 == 60)
    检查("取末尾-长度-1", 数字数组.长度() == 5)
    // ⑥ 获取（越界返回 空值）
    检查("获取-命中", 数字数组.获取(2) == 20)
    检查("获取-越界返回空值", 数字数组.获取(99) == 空值)
    // ⑦ 是否包含
    检查("是否包含-真", 数字数组.是否包含(20) == 真)
    检查("是否包含-假", 数字数组.是否包含(80) == 假)
    // ⑧ 查找索引（未找到返回 0）
    检查("查找索引-命中", 数字数组.查找索引(40) == 4)
    检查("查找索引-未找到返回0", 数字数组.查找索引(80) == 0)
    // ⑨ 反转（原地）
    数组甲 = [1, 2, 3]
    数组甲.反转()
    检查("反转-首元素", 数组甲[1] == 3)
    检查("反转-末元素", 数组甲[3] == 1)
    // ⑩ 排序（原地升序）
    数组乙 = [3, 1, 2]
    数组乙.排序()
    检查("排序-升序", 数组乙[1] == 1)
    检查("排序-末位最大", 数组乙[3] == 3)
    // ⑪ 清空
    数组丙 = [1, 2, 3]
    数组丙.清空()
    检查("清空-长度0", 数组丙.长度() == 0)
    // 边界：插入/删除越界抛异常（规范明示）
    捕获:
        数组丁 = [1, 2]
        数组丁.插入(99, 3)
        检查("插入-越界应抛异常", 假)
    异常:
        检查("插入-越界抛异常", 真)
    结束
    捕获:
        数组戊 = [1, 2]
        数组戊.删除(99)
        检查("删除-越界应抛异常", 假)
    异常:
        检查("删除-越界抛异常", 真)
    结束
    收尾()
结束
