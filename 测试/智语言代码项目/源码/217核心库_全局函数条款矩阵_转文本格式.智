// 217 §4.1 全局函数**条款级矩阵（第二十七轮）** —— 重点：转文本的**容器内文本带引号**格式
// 规范依据（原文）：
//   §2.4 与 §4.1 两处示例一致：`转文本([1, 2, 3])` ⇒ `"[1, 2, 3]"`、
//   `转文本({"键": "值"})` ⇒ `{"键": "值"}`（**容器内文本元素带双引号**）；
//   §4.2 示例 `["苹果", "香蕉", "橙子", "葡萄"]` 亦带引号。
// 为什么必须带引号：`[""].转文本()` 与 `[].转文本()` 否则同为 `"[]"` —— 长度 1 与 0 无法区分（语义歧义）。
// 本轮已按规范修 base `运行时值::转文本`（新增 `容器内值转文本` / `容器内键转文本`），双模自动一致。

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

启动程序():
    输出("=== 217 §4.1 全局函数 条款矩阵（转文本格式）===")

    // ───────── ① 转文本：标量 ─────────
    输出("-- ① 转文本 标量 --")
    检查("整数 42 ⇒ 「42」", 转文本(42) == "42")
    检查("负数 -7 ⇒ 「-7」", 转文本(0 - 7) == "-7")
    检查("小数 3.14 ⇒ 「3.14」", 转文本(3.14) == "3.14")
    检查("小数整值保留小数点 2.0 ⇒ 「2.0」", 转文本(2.0) == "2.0")
    检查("负小数 -0.5 ⇒ 「-0.5」", 转文本(0 - 0.5) == "-0.5")
    检查("逻辑真 ⇒ 「真」", 转文本(真) == "真")
    检查("逻辑假 ⇒ 「假」", 转文本(假) == "假")
    检查("文本恒等（顶层不加引号）", 转文本("甲乙") == "甲乙")
    检查("空文本 ⇒ 空串", 转文本("") == "")
    检查("文本内含引号 不加引号但保留原字符", 转文本("说\引号好\引号") == "说\引号好\引号")

    // ───────── ② 转文本：数组（容器内文本必须带引号）─────────
    输出("-- ② 转文本 数组 --")
    检查("数值数组 ⇒ [1, 2, 3]", 转文本([1, 2, 3]) == "[1, 2, 3]")
    检查("空数组 ⇒ []", 转文本([]) == "[]")
    检查("嵌套数组 ⇒ [[1, 2], [3]]", 转文本([[1, 2], [3]]) == "[[1, 2], [3]]")
    检查("含空值 ⇒ [1, 空值]", 转文本([1, 空值]) == "[1, 空值]")
    检查("文本元素带引号 ⇒ [\引号a\引号, \引号b\引号]", 转文本(["a", "b"]) == "[\引号a\引号, \引号b\引号]")
    检查("中文文本元素带引号", 转文本(["甲", "乙"]) == "[\引号甲\引号, \引号乙\引号]")
    // ★ 歧义消除护栏：长度 1 的空串数组 与 空数组 必须可区分
    检查("[「 」] 与 [] 不再同形（关键）", 转文本([""]) != 转文本([]))
    检查("空串数组 ⇒ [\引号\引号]", 转文本([""]) == "[\引号\引号]")
    检查("含引号文本元素转义 ⇒ [\引号a\反斜杠\引号b\引号]", 转文本(["a\引号b"]) == "[\引号a\反斜杠\引号b\引号]")
    检查("混合类型数组元素类型不丢", 转文本([1, "甲", 真]) == "[1, \引号甲\引号, 真]")
    // 分隔结果（§4.2 示例格式）
    检查("分隔结果渲染带引号", "甲,乙".分隔(",") == ["甲", "乙"])
    记录("空文本分隔 实际形式", 转文本("".分隔(",")))
    检查("空文本分隔 ⇒ [\引号\引号]（§4.2 边界规则 4）", 转文本("".分隔(",")) == "[\引号\引号]")

    // ───────── ③ 转文本：映射（键与文本值都带引号）─────────
    输出("-- ③ 转文本 映射 --")
    检查("映射 ⇒ {\引号键\引号: \引号值\引号}", 转文本({"键": "值"}) == "{\引号键\引号: \引号值\引号}")
    检查("空映射 ⇒ {}", 转文本({}) == "{}")
    检查("数值值不加引号", 转文本({"甲": 1}) == "{\引号甲\引号: 1}")
    检查("嵌套映射与数组", 转文本({"a": [1, {"b": 真}]}) == "{\引号a\引号: [1, {\引号b\引号: 真}]}")

    // ───────── ④ 转整数（§4.1：整数恒等 / 小数向零取整 / 文本解析）─────────
    输出("-- ④ 转整数 --")
    检查("整数恒等", 转整数(42) == 42)
    检查("小数 3.7 向零取整 ⇒ 3", 转整数(3.7) == 3)
    检查("小数 -3.7 向零取整 ⇒ -3", 转整数(0 - 3.7) == 0 - 3)
    检查("小数 2.999 向零取整 ⇒ 2", 转整数(2.999) == 2)
    检查("文本 123 ⇒ 123", 转整数("123") == 123)
    检查("文本 +7 ⇒ 7", 转整数("+7") == 7)
    检查("文本 007 ⇒ 7", 转整数("007") == 7)
    检查("文本首尾空白可接受（与转小数同口径）", 转整数("  12  ") == 12)
    检查("文本 -0 ⇒ 0", 转整数("-0") == 0)
    非整数文本抛异常 = 假
    捕获:
        转整数("12.9")
    异常:
        非整数文本抛异常 = 异常错误().类型 == "类型转换错误"
    结束
    检查("文本 12.9 抛类型转换错误", 非整数文本抛异常)
    非法文本抛异常 = 假
    捕获:
        转整数("甲")
    异常:
        非法文本抛异常 = 异常错误().类型 == "类型转换错误"
    结束
    检查("非法文本抛类型转换错误", 非法文本抛异常)

    // ───────── ⑤ 转小数（整数提升 / 小数恒等 / 文本解析）─────────
    输出("-- ⑤ 转小数 --")
    检查("整数提升 ⇒ 42.0", 转小数(42) == 42.0)
    检查("小数恒等", 转小数(3.14) == 3.14)
    检查("文本 3.14", 转小数("3.14") == 3.14)
    检查("文本 -2.5", 转小数("-2.5") == 0 - 2.5)
    // ★ 本轮修的护栏：此前 `转小数("  3.5  ")` 抛异常，而 `转整数(" 12")` 通过（同族不一致）
    检查("文本首尾空白可接受（与转整数统一）", 转小数("  3.5  ") == 3.5)
    检查("文本 .5 ⇒ 0.5", 转小数(".5") == 0.5)
    检查("文本 5. ⇒ 5.0", 转小数("5.") == 5.0)
    检查("文本科学计数法 1e3 ⇒ 1000.0（记录口径）", 转小数("1e3") == 1000.0)
    非法小数抛异常 = 假
    捕获:
        转小数("甲乙")
    异常:
        非法小数抛异常 = 异常错误().类型 == "类型转换错误"
    结束
    检查("非法文本抛类型转换错误", 非法小数抛异常)

    // ───────── ⑥ 类型（§4.1：具体类型名）─────────
    输出("-- ⑥ 类型 --")
    检查("整数", 类型(1) == "整数")
    检查("小数", 类型(1.5) == "小数")
    检查("文本", 类型("甲") == "文本")
    检查("逻辑", 类型(真) == "逻辑")
    检查("空值", 类型(空值) == "空值")
    检查("数组", 类型([]) == "数组")
    检查("映射", 类型({}) == "映射")
    检查("函数", 类型(检查) == "函数")

    // ───────── ⑦ 异常错误（§4.1 / §4.5）─────────
    输出("-- ⑦ 异常错误 --")
    异常类型 = ""
    异常描述 = ""
    异常位置 = ""
    格式信息长度 = 0
    捕获:
        值 = 10 / 0
    异常:
        错误 = 异常错误()
        异常类型 = 错误.类型
        异常描述 = 错误.描述
        异常位置 = 错误.位置
        格式信息长度 = 错误.格式信息().长度()
    结束
    检查("异常类型 = 除零异常", 异常类型 == "除零异常")
    检查("异常描述 = 除数不能为零", 异常描述 == "除数不能为零")
    检查("异常位置 非空", 异常位置.长度() > 0)
    检查("格式信息 非空", 格式信息长度 > 0)
    检查("格式信息 含类型与描述", 异常类型.长度() > 0 且 异常描述.长度() > 0)

    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
