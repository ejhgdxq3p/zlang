// ============================================================
// 任意类型全面测试（对照《智语言编程规范》2.4.3 任意类型）
// 覆盖：有名任意类型 / 匿名任意类型 / 变量声明 / 参数 / 返回值
//      类型守恒 / 类型集合 / 约束范围 / 全局函数 / 容器 / 结构体泛型 / 类型判断
// 双模（解释 + 编译）手动单文件跑。索引从 1 开始。
// 注意：本文件刻意包含若干「已知 parity 缺口」用例，会单独标注双模差异。
// ============================================================

通过数 = 0
失败数 = 0
总用例数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总用例数 = 本模块.总用例数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ===== 一、有名任意类型（无约束） =====
// 参数声明 任意<甲>，返回值引用 任意<甲>（类型守恒）
取原样(任意<甲> 数据) 任意<甲>:
    返回 数据
结束

// ===== 二、有名任意类型（有约束：整数|小数） =====
取较大值(任意<甲: 整数|小数> 第一个, 任意<甲> 第二个) 任意<甲>:
    如果 第一个 > 第二个:
        返回 第一个
    否则:
        返回 第二个
    结束
结束

// ===== 三、匿名任意类型：变量声明（有约束） =====
测试匿名变量():
    任意<整数|文本> 可变数据 = 42
    检查("匿名变量 初始整数", 可变数据 == 42)
    可变数据 = "状态更新"
    检查("匿名变量 重新赋值为文本", 可变数据 == "状态更新")

    // 含空值约束
    任意<整数|文本|空值> 可能姓名 = 空值
    检查("匿名变量 含空值约束初始空值", 可能姓名 == 空值)
    可能姓名 = 100
    检查("匿名变量 含空值约束重新赋值", 可能姓名 == 100)
结束

// ===== 四、匿名任意类型：函数返回值（类型集合） =====
安全除法(小数 被除数, 小数 除数) 任意<小数|文本>:
    如果 除数 == 0:
        返回 "除数不能为零"
    否则:
        返回 被除数 / 除数
    结束
结束

// ===== 五、有名任意类型：类型守恒验证 =====
测试类型守恒():
    整数 整数结果 = 取原样(10)
    检查("有名任意 整数守恒", 整数结果 == 10)

    文本 文本结果 = 取原样("你好")
    检查("有名任意 文本守恒", 文本结果 == "你好")

    小数 小数结果 = 取较大值(3.5, 2.1)
    检查("有名任意约束 小数取较大", 小数结果 == 3.5)

    整数 较大整数 = 取较大值(10, 20)
    检查("有名任意约束 整数取较大", 较大整数 == 20)
结束

// ===== 六、匿名任意类型返回值接收（方式一：可确定具体类型） =====
测试匿名返回():
    任意<小数|文本> 结果1 = 安全除法(10.0, 2.0)
    检查("匿名返回 小数分支", 结果1 == 5.0)

    任意<小数|文本> 结果2 = 安全除法(10.0, 0.0)
    检查("匿名返回 文本分支", 结果2 == "除数不能为零")
结束

// ===== 七、全局函数作用于任意类型 =====
测试全局函数():
    整数 整数结果 = 取原样(42)
    检查("转整数(任意) 转换", 转整数(整数结果) == 42)

    文本 文本结果 = 取原样("abc")
    检查("转文本(任意) 转换", 转文本(文本结果) == "abc")

    小数 小数结果 = 取原样(3.14)
    检查("转小数(任意) 转换", 转小数(小数结果) == 3.14)

    检查("类型(任意) 整数", 类型(取原样(7)) == "整数")
    检查("类型(任意) 文本", 类型(取原样("x")) == "文本")
    检查("类型(任意) 逻辑", 类型(取原样(真)) == "逻辑")
    检查("类型(任意) 小数", 类型(取原样(1.5)) == "小数")
结束

// ===== 八、类型判断分发（方式二：运行时） =====
分发处理(任意<甲> 数据) 空值:
    如果 类型(数据) == "整数":
        整数 数字 = 数据
        输出("    分发到整数：" + 转文本(数字))
    否则如果 类型(数据) == "文本":
        文本 文字 = 数据
        输出("    分发到文本：" + 文字)
    否则如果 类型(数据) == "逻辑":
        逻辑 标志 = 数据
        输出("    分发到逻辑：" + 转文本(标志))
    否则:
        输出("    分发到其他类型")
    结束
    返回 空值
结束

测试类型分发():
    分发处理(100)
    分发处理("消息")
    分发处理(真)
    检查("类型分派 执行无异常", 真)
结束

// ===== 九、任意类型与容器 =====
测试容器():
    // 无约束容器元素
    数组 任意数组 = [1, "文本", 真]
    检查("数组<任意> 长度", 任意数组.长度() == 3)
    检查("数组<任意> 取整数元素", 任意数组[1] == 1)
    检查("数组<任意> 取文本元素", 任意数组[2] == "文本")

    映射 任意映射 = {"键1": "值1", "键2": 100}
    检查("映射<任意> 取文本值", 任意映射.获取("键1") == "值1")
    检查("映射<任意> 取整数值", 任意映射.获取("键2") == 100)

    // 约束容器
    数组<整数> 数字列表 = [1, 2, 3]
    整数 第一个 = 数字列表[1]
    检查("数组<整数> 取出整数", 第一个 == 1)
结束

// ===== 十、结构体泛型（有名任意类型 参数） =====
结构体 栈(任意<甲> 元素类型):
    数组<甲> 数据 = []

    压入(任意<甲> 新元素):
        自身.数据.追加(新元素)
    结束

    取长度() 整数:
        返回 自身.数据.长度()
    结束

    取顶部() 任意<甲>:
        返回 自身.数据.取末尾()
    结束
结束

// 泛型结构体内部 映射<键型,整数> 经 任意<键型> 参数插入/查找（对照规范 §1859-1865 字典示例，已闭环双模）
结构体 字典(任意<键型> 键类型):
    映射<键型, 整数> 数据 = {}
    设置(任意<键型> 新键, 整数 新值):
        自身.数据.插入(新键, 新值)
    结束
    查(任意<键型> 键) 任意<整数>:
        返回 自身.数据.获取(键)
    结束
结束

// 注：字典（映射<键型,整数> 经 任意<键型> 键）插入/查找已闭环双模（第十四轮 嵌套映射就地写回 + 字段接收者写回归一）。
结构体 容器(任意<乙> 元素类型):
    数组<乙> 数据 = []

    添加(任意<乙> 新元素):
        自身.数据.追加(新元素)
    结束

    取数量() 整数:
        返回 自身.数据.长度()
    结束

    取末() 任意<乙>:
        返回 自身.数据.取末尾()
    结束
结束

测试结构体泛型():
    整数栈 = 栈(0)
    整数栈.压入(10)
    整数栈.压入(20)
    检查("结构体泛型 栈长度", 整数栈.取长度() == 2)
    整数 栈顶 = 整数栈.取顶部()
    检查("结构体泛型 栈取顶部", 栈顶 == 20)

    盒子 = 容器(0)
    盒子.添加(7)
    盒子.添加(9)
    检查("结构体泛型 数组方法-数量", 盒子.取数量() == 2)
    整数 末值 = 盒子.取末()
    检查("结构体泛型 数组方法-取末", 末值 == 9)

    // 泛型结构体内部 映射<键型,整数> 经 任意<键型> 键 插入/查找（对照规范 §1859-1865）
    缺陷字典 = 字典("")
    缺陷字典.设置("苹果", 5)
    任意 缺陷结果 = 缺陷字典.查("苹果")
    输出("    泛型映射键经任意包装查值=" + 转文本(缺陷结果))
    检查("结构体泛型 映射键插入查找正确(返回5)", 缺陷结果 == 5)
结束

// ===== 十一、遍历循环内使用任意类型（已知 parity 缺口复现） =====
// 缺口 A：遍历循环内「返回 索引」当函数返回类型为 任意 时，编译模式结果错误。
//          此处返回值类型改为具体 整数 即双模全绿；保留 任意 版本以复现差异。
测试遍历返回任意():
    整数 结果 = 0
    数组<整数> 列表 = [10, 20, 30]
    循环 索引, 元素 遍历 列表:
        如果 元素 == 20:
            返回 索引
        结束
    结束
    返回 结果
结束

// 缺口 B 复现：任意类型变量 调 转文本() 当值为空值时，编译期报"空值不能参与类型转换"。
// 正常非空的任意变量调 转文本() 应工作（已在 测试全局函数 覆盖）。此处测试含空值的任意调文本的预期错误行为。
测试任意空值转文本():
    // 标注：此用例在两种模式下若执行 转文本(空值) 都应报错（符合规范空值安全）。
    // 用类型判断保护后调用，验证正常路径。
    任意<整数|文本|空值> 数据 = 100
    如果 类型(数据) != "空值":
        文本 展示 = 转文本(数据)
        检查("任意非空 调文本", 展示 == "100")
    否则:
        检查("任意非空 调文本", 假)
    结束
结束

启动程序():
