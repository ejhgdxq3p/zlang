// ---------- 三、HTTP 服务端 + 客户端 ----------
运行网页测试():
    服务 = 网络.启动服务(18082, 处理请求, {})
    服务端口 = 18082

    捕获:
        // GET /
        响应1 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/", {})
        检查("HTTP GET / 状态码 200", 响应1.状态码() == 200)
        检查("HTTP GET / 是否成功", 响应1.是否成功())
        // 读取内容（可能含 HTTP 包装，做包含判定）
        检查("HTTP GET / 含欢迎文本", 响应1.内容().是否包含("欢迎"))

        // GET /重定向
        响应2 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/重定向", {"跟随重定向": 假})
        检查("HTTP /重定向 状态码 302", 响应2.状态码() == 302)
        检查("HTTP /重定向 含位置头", 响应2.响应头().是否包含("位置"))

        // GET /不存在
        响应3 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/不存在", {})
        检查("HTTP /不存在 状态码 404", 响应3.状态码() == 404)

        // POST /数据
        响应4 = 网络.发送("http://127.0.0.1:" + 转文本(服务端口) + "/数据", {"姓名": "张三", "年龄": 25}, {})
        检查("HTTP POST 状态码 200", 响应4.状态码() == 200)
        检查("HTTP POST 回显姓名", 响应4.内容().是否包含("张三"))
    异常:
        错误 = 异常错误()
        输出("HTTP 测试异常详情：" + 转文本(错误.描述))
        检查("HTTP 客户端请求未抛异常", 假)
    结束

    网络.服务关闭(服务)
    输出("HTTP 服务已关闭，端口释放")
    输出("")
    输出("===== 网络模块详细验证 汇总 =====")
