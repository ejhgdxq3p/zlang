// 规范 §2.9.2：聚合导入（默认形式）后访问 —— 全部「基础类型」成员
//   默认形式 ⇒ 对外名保留子命名空间 类型库
//   覆盖：整数 / 小数 / 文本 / 逻辑 / 空值 的 变量、常量、函数（参数 + 返回）

导入 聚合校验/类型_默认 展开

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== §2.9 聚合导入 · 成员类型覆盖（基础类型）=====")

    // —— 变量 ——
    检查("整数变量 = 42", 类型库.型整数变量 == 42)
    检查("小数变量 = 3.25", 类型库.型小数变量 == 3.25)
    检查("文本变量 = 智语言", 类型库.型文本变量 == "智语言")
    检查("逻辑变量 = 真", 类型库.型逻辑变量 == 真)

    // —— 常量 ——
    检查("整数常量 = 7", 类型库.型整数常量 == 7)
    检查("小数常量 = 1.5", 类型库.型小数常量 == 1.5)
    检查("文本常量 = 常量文本", 类型库.型文本常量 == "常量文本")
    检查("逻辑常量 = 假", 类型库.型逻辑常量 == 假)

    // —— 函数：参数与返回各基础类型 ——
    检查("整数函数 型整数加(2,3)=5", 类型库.型整数加(2, 3) == 5)
    检查("小数函数 型小数乘(1.5,2)=3", 类型库.型小数乘(1.5, 2.0) == 3.0)
    检查("文本函数 型文本拼接=甲乙", 类型库.型文本拼接("甲", "乙") == "甲乙")
    检查("逻辑函数 型逻辑取反(真)=假", 类型库.型逻辑取反(真) == 假)
    检查("空值函数 返回空值", 类型库.型取空() == 空值)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
