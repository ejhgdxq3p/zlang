通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 数据枚举 ──
枚举 结果:
    成功(数据)
    出错(错误信息)
    空
结束

// ── 枚举作为变量/参数 ──
处理(结果 结果值) 文本:
    如果 结果值 == 结果.空:
        返回 "无结果"
    否则:
        返回 "有结果"
    结束
结束

// ── 测试 ──
测试_数据枚举():
    成功结果 = 结果.成功("数据获取完成")
    检查("数据枚举 成功 携带数据", 成功结果 == 结果.成功("数据获取完成"))
    失败结果 = 结果.出错("出错了")
    检查("数据枚举 出错 携带错误", 失败结果 == 结果.出错("出错了"))
    空结果 = 结果.空
    检查("数据枚举 空成员", 空结果 == 结果.空)
    检查("数据枚举 作参数 空->无结果", 处理(空结果) == "无结果")
    检查("数据枚举 作参数 成功->有结果", 处理(成功结果) == "有结果")
    检查("数据枚举 不等 成功!=失败", 成功结果 != 失败结果)
    检查("数据枚举 不等 成功!=空", 成功结果 != 结果.空)
    检查("数据枚举 同变体两次构造相等", 结果.成功("A") == 结果.成功("A"))
    检查("数据枚举 同变体不同载荷值相等(仅比较标签)", 结果.成功("A") == 结果.成功("B"))
结束

// ── 主入口 ──
启动程序():
    输出("========== 数据枚举(载荷) 测试（仅解释模式） ==========")
    测试_数据枚举()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
