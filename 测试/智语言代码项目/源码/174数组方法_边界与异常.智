// §4.3 边界：索引从 1 起；插入/删除越界抛异常；取末尾/获取/查找索引/反转/排序/清空 边界
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 174 数组方法-边界 ===")
    // 空数组
    空数组 = []
    检查("长度-空数组", 空数组.长度() == 0)
    检查("是否包含-空数组", 空数组.是否包含(1) == 假)
    检查("查找索引-空数组返0", 空数组.查找索引(1) == 0)
    检查("获取-空数组返空值", 空数组.获取(1) == 空值)
    // 插入边界：索引=长度+1（末尾追加语义）与越界
    数组甲 = [1, 2]
    捕获:
        数组甲.插入(3, 9)
        检查("插入-索引=长度+1", 数组甲.长度() == 3)
    异常:
        记录("插入(长度+1) 抛异常", "抛")
    结束
    捕获:
        数组乙 = [1, 2]
        数组乙.插入(0, 9)
        记录("插入(0) 未抛", "未抛")
    异常:
        检查("插入-索引0抛异常", 真)
    结束
    捕获:
        数组丙 = [1, 2]
        数组丙.插入(9, 9)
        记录("插入(9) 未抛", "未抛")
    异常:
        检查("插入-远超长度抛异常", 真)
    结束
    // 删除边界
    捕获:
        数组丁 = [1, 2]
        数组丁.删除(0)
        记录("删除(0) 未抛", "未抛")
    异常:
        检查("删除-索引0抛异常", 真)
    结束
    // 取末尾
    数组戊 = [7]
    检查("取末尾-单元素", 数组戊.取末尾() == 7)
    检查("取末尾-取后空", 数组戊.长度() == 0)
    捕获:
        数组己 = []
        末 = 数组己.取末尾()
        记录("取末尾(空数组) 未抛", 转文本(末))
    异常:
        检查("取末尾-空数组抛异常", 真)
    结束
    // 获取/查找索引/是否包含
    数组庚 = [10, 20, 20, 30]
    检查("获取-首元素", 数组庚.获取(1) == 10)
    检查("查找索引-重复取首次", 数组庚.查找索引(20) == 2)
    检查("是否包含-命中", 数组庚.是否包含(30) == 真)
    检查("是否包含-未命中", 数组庚.是否包含(99) == 假)
    // 反转/排序边界
    单元素 = [1]
    单元素.反转()
    检查("反转-单元素", 单元素[1] == 1)
    空数组2 = []
    空数组2.反转()
    空数组2.排序()
    检查("反转/排序-空数组安全", 空数组2.长度() == 0)
    文本数组 = ["乙", "甲", "丙"]
    文本数组.排序()
    记录("文本数组.排序() 后首元素", 文本数组[1])
    逆序数组 = [5, 4, 3, 2, 1]
    逆序数组.排序()
    检查("排序-逆序转升序", 逆序数组[1] == 1)
    检查("排序-末位最大", 逆序数组[5] == 5)
    // 下标语法
    下标数组 = [1, 2, 3]
    检查("下标-1基读取", 下标数组[1] == 1)
    检查("下标-末位", 下标数组[3] == 3)
    下标数组[2] = 99
    检查("下标-写入", 下标数组[2] == 99)
    // 嵌套数组
    嵌套 = [[1, 2], [3, 4]]
    检查("嵌套-外层长度", 嵌套.长度() == 2)
    检查("嵌套-内层读取", 嵌套[2][2] == 4)
    收尾()
结束
