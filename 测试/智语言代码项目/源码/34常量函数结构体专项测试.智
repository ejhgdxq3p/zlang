// 常量 / 函数 / 结构体 专项测试（解释模式与编译模式双模对拍）
// 覆盖规则：模块级常量、函数内常量（遮蔽）、结构体常量字段（实例化访问/同值/参与运算/私有）

常量 圆周率 = 3.14159
常量 最大人数 = 100
常量 应用名称 = "智语言学习系统"
常量 是否调试 = 真
常量 整数 步进 = 2

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 函数内常量 + 内层遮蔽外层 ──
常量 外层常量 = 100
处理() 整数:
    常量 外层常量 = 10
    返回 外层常量
结束

计算() 整数:
    常量 整数 基数 = 10
    返回 基数 * 2
结束

// ── 结构体常量字段 ──
结构体 圆(小数 半径):
    常量 类别 = "圆形"          // ✅ 字面量，编译期常量
    名称 = "圆"
    面积() 小数:
        返回 本模块.圆周率 * 半径 ^ 2
    结束
结束

结构体 配置():
    私有 常量 名称 = "默认配置"
    取名称() 文本:
        返回 自身.名称
    结束
结束

启动程序():
    输出("========== 常量/函数/结构体 专项测试 ==========")

    // 1. 模块级常量：定义、参与运算
    检查("模块级常量取值", 本模块.最大人数 == 100)
    检查("模块级常量文本", 本模块.应用名称 == "智语言学习系统")
    检查("模块级常量逻辑", 本模块.是否调试 == 真)
    倍数 = 本模块.步进 * 5
    检查("常量参与运算", 倍数 == 10)

    // 2. 函数内常量（遮蔽 / 参与运算）
    检查("内层常量遮蔽外层", 处理() == 10)
    检查("函数内常量参与运算", 计算() == 20)

    // 3. 结构体常量字段
    大圆 = 圆(2.0)
    小圆 = 圆(1.0)
    检查("结构体常量字段访问", 大圆.类别 == "圆形")
    检查("不同实例常量同值", 小圆.类别 == "圆形")
    检查("结构体常量参与运算", 大圆.面积() > 0)

    默认配置 = 配置()
    检查("私有常量字段", 默认配置.取名称() == "默认配置")

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
