// 64 时间模块精确测试（导入 时间，覆盖模块实际暴露的全部函数）
// 覆盖：当前时间 / 当前毫秒时间 / 获取计时器 / 格式化 / 解析 / 获取年/月/日/时/分/秒/星期
//       / 加 / 减 / 间隔天数 / 休眠
// 注意：时间.格式化 的格式串使用中文占位符（年/月/日/时/分/秒），而非 %Y 形式。

导入 时间

总数 = 0
通过数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
    否则:
        输出("❌ " + 名称)
    结束
结束

启动程序():
    戳 = 时间.当前时间()
    检查("当前时间 整数>0", 类型(戳) == "整数" 且 戳 > 0)
    检查("当前毫秒时间 >=0", 时间.当前毫秒时间() >= 0)
    检查("获取计时器 >=0", 时间.获取计时器() >= 0)

    // 格式化 + 解析 往返一致（格式串用中文占位符）
    串 = 时间.格式化("年-月-日 时:分:秒", 戳)
    检查("格式化 含 日期/时间 分隔符", 串.是否包含("-") 且 串.是否包含(":"))
    回 = 时间.解析(串, "年-月-日 时:分:秒")
    检查("解析 往返=原戳", 回 == 戳)
    年串 = 时间.格式化("年", 戳)
    检查("格式化 年长度=4", 年串.长度() == 4)
    检查("格式化 年==获取年", 年串 == 转文本(时间.获取年(戳)))

    // 分量合理性
    检查("获取年 合理[2024,2035]", 时间.获取年(戳) >= 2024 且 时间.获取年(戳) <= 2035)
    检查("获取月 1..12", 时间.获取月(戳) >= 1 且 时间.获取月(戳) <= 12)
    检查("获取日 1..31", 时间.获取日(戳) >= 1 且 时间.获取日(戳) <= 31)
    检查("获取时 0..23", 时间.获取时(戳) >= 0 且 时间.获取时(戳) <= 23)
    检查("获取分 0..59", 时间.获取分(戳) >= 0 且 时间.获取分(戳) <= 59)
    检查("获取秒 0..59", 时间.获取秒(戳) >= 0 且 时间.获取秒(戳) <= 59)
    检查("获取星期 1..7", 时间.获取星期(戳) >= 1 且 时间.获取星期(戳) <= 7)

    // 加 / 减 / 间隔天数
    后 = 时间.加(戳, 86400)
    检查("加86400 间隔天数=1", 时间.间隔天数(后, 戳) == 1)
    前 = 时间.减(后, 86400)
    检查("减 还原=原戳", 前 == 戳)
    检查("间隔天数 同日=0", 时间.间隔天数(戳, 戳) == 0)
    后2 = 时间.加(戳, 3600)
    检查("加3600 间隔天数=0", 时间.间隔天数(后2, 戳) == 0)

    // 休眠 不崩溃
    时间.休眠(1)
    检查("休眠 不崩溃", 真)

    // 计时器 差值 合理
    起 = 时间.获取计时器()
    时间.休眠(1)
    止 = 时间.获取计时器()
    检查("计时器 休眠后增大", 止 >= 起)

    // 格式化 不同单位组合
    月中 = 时间.格式化("月", 戳)
    检查("格式化 月 1位或2位", 月中.长度() >= 1 且 月中.长度() <= 2)
    检查("格式化 月==获取月", 转整数(月中) == 时间.获取月(戳))
    日串 = 时间.格式化("日", 戳)
    检查("格式化 日==获取日", 转整数(日串) == 时间.获取日(戳))

    // 解析 跨格式（年-月-日 与 年/月/日）
    简 = 时间.格式化("年-月-日", 戳)
    回简 = 时间.解析(简, "年-月-日")
    检查("解析 仅日期 截断到日", 时间.获取年(回简) == 时间.获取年(戳) 且 时间.获取月(回简) == 时间.获取月(戳) 且 时间.获取日(回简) == 时间.获取日(戳))
    斜 = 时间.解析(时间.格式化("年/月/日", 戳), "年/月/日")
    检查("解析 斜杠格式 同日期", 时间.获取年(斜) == 时间.获取年(戳))

    // 加/减 其它秒数
    后三 = 时间.加(戳, 3)
    检查("加3秒 间隔<1天", 时间.间隔天数(后三, 戳) == 0)
    回三 = 时间.减(后三, 3)
    检查("减3秒 还原", 回三 == 戳)

    // 解析 非法格式 应抛异常（逻辑版本143 健壮性）
    解析异常 = 假
    捕获:
        时间.解析("不是时间", "年-月-日")
    异常:
        解析异常 = 真
    结束
    检查("解析(非法格式) 抛异常", 解析异常 == 真)

    输出("")
    输出("===== 64 时间模块精确测试 结果 =====")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
