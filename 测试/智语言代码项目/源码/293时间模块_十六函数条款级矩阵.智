// §5.4 时间模块（16 个函数）条款级矩阵（双模）
// 规范条款：§5.4.1~§5.4.4 函数表 + 时间戳容错约定 5 条
//   ① 时间戳允许为负，按向下取整做日历计算（-1 ⇒ 1969-12-31 23:59:59、获取年(-1)=1969）
//   ② 加/减/间隔天数溢出抛可捕获异常（不回绕、不 panic）
//   ③ 间隔天数 = 甲 − 乙，向零截断（86400/1、-86400/-1、86399/0）
//   ④ 解析支持 年-月-日 / 年/月/日（可不补零）、可选 时:分:秒；纯数字按时间戳返回
//   ⑤ 不存在的日历日严格报错（13 月、32 日、非闰年 2-29、4-31）
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

应抛运行时(文本 名称, 匿名函数 操作):
    捕获:
        操作()
        检查(名称 + "（应抛异常却成功）", 假)
    异常:
        检查(名称, 异常错误().类型 == "运行时异常")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 293 时间模块十六函数条款级矩阵（§5.4）===")

    输出("-- 5.4.1 获取时间 --")
    现在 = 时间.当前时间()
    检查("当前时间为正数（2020 年后）", 现在 > 1577836800)
    毫秒 = 时间.当前毫秒时间()
    检查("当前毫秒 ≥ 当前秒 × 1000", 毫秒 >= 现在 * 1000)
    检查("毫秒与秒在同一量级（差 < 1000 秒）", 毫秒 / 1000 - 现在 < 1000)

    相等文本("格式化(0) 纪元", 时间.格式化("年-月-日 时:分:秒", 0), "1970-01-01 00:00:00")
    相等文本("格式化(-1) 负时间戳（条款 1）", 时间.格式化("年-月-日 时:分:秒", 0 - 1), "1969-12-31 23:59:59")
    相等文本("格式化 年月日", 时间.格式化("年-月-日", 0), "1970-01-01")
    相等文本("格式化 时分秒", 时间.格式化("时:分:秒", 3661), "01:01:01")
    相等文本("格式化 千年", 时间.格式化("年-月-日", 946684800), "2000-01-01")

    相等文本("解析 标准格式", 转文本(时间.解析("1970-01-02", "年-月-日")), "86400")
    相等文本("解析 逗号不补零（条款 4）", 转文本(时间.解析("2024-1-5", "年-月-日")), "1704412800")
    相等文本("解析 斜杠（条款 4）", 转文本(时间.解析("2024/1/5", "年/月/日")), "1704412800")
    相等文本("解析 闰年 2-29", 转文本(时间.解析("2024-02-29", "年-月-日")), "1709164800")
    相等文本("解析 纯数字按时间戳（条款 4）", 转文本(时间.解析("1700000000", "年-月-日")), "1700000000")
    相等文本("解析 负时间戳文本", 转文本(时间.解析("-1", "年-月-日")), "-1")
    相等文本("解析 含时分秒", 转文本(时间.解析("1970-01-01 00:01:40", "年-月-日 时:分:秒")), "100")

    输出("-- 5.4.1 解析：不存在的日历日严格报错（条款 5）--")
    应抛运行时("非闰年 2-29 抛", 函数(): 时间.解析("2023-02-29", "年-月-日") 结束)
    应抛运行时("13 月抛", 函数(): 时间.解析("2024-13-01", "年-月-日") 结束)
    应抛运行时("0 月抛", 函数(): 时间.解析("2024-00-10", "年-月-日") 结束)
    应抛运行时("32 日抛", 函数(): 时间.解析("2024-01-32", "年-月-日") 结束)
    应抛运行时("4-31（当月无此日）抛", 函数(): 时间.解析("2024-04-31", "年-月-日") 结束)
    应抛运行时("2-30 抛", 函数(): 时间.解析("2024-02-30", "年-月-日") 结束)
    应抛运行时("纪元前非闰 1900-02-29 抛", 函数(): 时间.解析("1900-02-29", "年-月-日") 结束)

    输出("-- 5.4.2 时间分量 --")
    检查("纪元 获取年", 时间.获取年(0) == 1970)
    检查("纪元 获取月", 时间.获取月(0) == 1)
    检查("纪元 获取日", 时间.获取日(0) == 1)
    检查("纪元 获取时", 时间.获取时(0) == 0)
    检查("纪元 获取分", 时间.获取分(0) == 0)
    检查("纪元 获取秒", 时间.获取秒(0) == 0)
    检查("纪元为星期四（1=周一）", 时间.获取星期(0) == 4)
    检查("负时间戳 获取年（条款 1）", 时间.获取年(0 - 1) == 1969)
    检查("负时间戳 获取月", 时间.获取月(0 - 1) == 12)
    检查("负时间戳 获取日", 时间.获取日(0 - 1) == 31)
    检查("负时间戳 获取时", 时间.获取时(0 - 1) == 23)
    检查("负时间戳 获取分", 时间.获取分(0 - 1) == 59)
    检查("负时间戳 获取秒", 时间.获取秒(0 - 1) == 59)
    检查("负时间戳 获取星期（1969-12-31 周三）", 时间.获取星期(0 - 1) == 3)
    检查("星期范围 1..7", 时间.获取星期(现在) >= 1 且 时间.获取星期(现在) <= 7)
    检查("闰日 2024-02-29 获取日", 时间.获取日(1709164800) == 29)
    检查("闰日 2024-02-29 获取月", 时间.获取月(1709164800) == 2)

    输出("-- 5.4.3 时间计算 --")
    检查("加 3600 秒", 时间.加(0, 3600) == 3600)
    检查("加 0 秒不变", 时间.加(100, 0) == 100)
    检查("加负秒数等于减", 时间.加(100, 0 - 50) == 50)
    检查("减 3600 秒", 时间.减(7200, 3600) == 3600)
    检查("减负秒数等于加", 时间.减(100, 0 - 50) == 150)
    检查("跨年加法（2024-12-31 23:59:59 + 1）", 时间.获取年(时间.加(1735689599, 1)) == 2025)
    检查("跨年减法（1970-01-01 00:00:00 - 1）", 时间.获取年(时间.减(0, 1)) == 1969)

    检查("间隔天数 86400 vs 0 = 1（条款 3）", 时间.间隔天数(86400, 0) == 1)
    检查("间隔天数 0 vs 86400 = -1", 时间.间隔天数(0, 86400) == 0 - 1)
    检查("间隔天数 相差 86399 向零截断 = 0", 时间.间隔天数(86399, 0) == 0)
    检查("间隔天数 -1 vs 0 向零截断 = 0", 时间.间隔天数(0 - 1, 0) == 0)
    检查("间隔天数 十天", 时间.间隔天数(864000, 0) == 10)
    检查("间隔天数 同值 = 0", 时间.间隔天数(12345, 12345) == 0)

    输出("-- 5.4.3 溢出抛异常（条款 2）--")
    应抛运行时("加溢出抛", 函数(): 时间.加(9223372036854775807, 1) 结束)
    应抛运行时("减溢出抛", 函数(): 时间.减(0 - 9223372036854775807 - 1, 1) 结束)
    检查("加不溢出边界", 时间.加(9223372036854775806, 1) == 9223372036854775807)

    输出("-- 5.4.4 计时 --")
    计时甲 = 时间.获取计时器()
    检查("计时器为整数毫秒", 计时甲 >= 0)
    时间.休眠(20)
    计时乙 = 时间.获取计时器()
    检查("计时器单调不减", 计时乙 >= 计时甲)
    检查("休眠 20 毫秒后增量 ≥ 19", 时间.减(计时乙, 计时甲) >= 19)
    时间.休眠(0)
    检查("休眠 0 不阻塞崩溃", 真)
    应抛运行时("休眠负数抛", 函数(): 时间.休眠(0 - 5) 结束)

    输出("-- 格式化/解析 往返一致 --")
    样本 = 时间.解析("2024-06-15", "年-月-日")
    回写 = 时间.格式化("年-月-日", 样本)
    相等文本("解析→格式化 往返", 回写, "2024-06-15")
    再解析 = 时间.解析(回写, "年-月-日")
    检查("格式化→解析 往返", 再解析 == 样本)

    收尾()
结束
