// 66 输入函数测试（规范 4.1 第 8 个全局函数 输入）
// 输入(): 无参，从标准输入读取一行文本并返回
// 2026-10-19：§4.1 签名为 输入()（零参数）；提示语须用 输出 单独打印（旧写法 输入("提示")
//   属非规范扩展，且实现根本忽略该实参 —— 静默丢弃 ⇒ 现由编译期参数个数校验拦下）。

总数 = 0
通过数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
    否则:
        输出("❌ " + 名称)
    结束
结束

启动程序():
    // ===== 输入() 无提示读取一行 =====
    行 = 输入()
    检查("输入 无提示读取一行", 行 == "测试输入行")

    // ===== 提示语用 输出，读取仍为无参 输入() =====
    输出("请输入>")
    行2 = 输入()
    检查("输入 提示后读取一行", 行2 == "第二行")

    // ===== 输入() 读取后可参与运算 =====
    输出("你输入了：" + 行 + " / " + 行2)

    输出("")
    输出("===== 66 输入函数测试 结果 =====")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
