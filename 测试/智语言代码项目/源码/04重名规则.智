// ============================================================
// 重名规则测试
// 覆盖规范：①参数与字段重名(参数优先，字段用自身.字段)
//          ②方法参数与字段重名(参数遮蔽，字段用自身.字段)
//          ③参数与方法参数重名(方法参数遮蔽结构体参数)
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ① 参数与字段重名：参数优先，访问同名字段必须用 自身.字段
//    （字段默认值位置不能引用参数，故在初始化中绑定）
结构体 矩形丙(小数 宽, 小数 高):
    小数 宽
    小数 高
    文本 颜色 = "黑色"
    初始化():
        自身.宽 = 宽
        自身.高 = 高
    结束
    设置宽(小数 新宽):
        自身.宽 = 新宽
    结束
    获取宽() 小数:
        返回 自身.宽
    结束
    获取构造宽() 小数:
        返回 宽
    结束
结束

// ② 方法参数与字段重名：方法内参数遮蔽字段，字段用 自身.字段
结构体 用户5():
    文本 姓名 = "默认"
    获取姓名() 文本:
        返回 自身.姓名
    结束
    设置姓名(文本 姓名):
        自身.姓名 = 姓名
    结束
结束

// ③ 参数与方法参数重名：方法参数遮蔽结构体全局参数
结构体 矩形丁(小数 宽, 小数 高):
    文本 颜色 = "黑色"
    缩放(小数 宽):
        新宽度 = 宽 * 2
        返回 新宽度
    结束
    获取构造宽() 小数:
        返回 宽
    结束
结束

// ── 测试 ──
测试_参数与字段重名():
    矩形实例 = 矩形丙(3.0, 4.0)
    检查("参数与字段重名-字段初始=构造参数3", 矩形实例.获取宽() == 3.0)
    检查("参数与字段重名-构造参数3(参数优先)", 矩形实例.获取构造宽() == 3.0)
    矩形实例.设置宽(10.0)
    检查("参数与字段重名-改字段后=10", 矩形实例.获取宽() == 10.0)
    检查("参数与字段重名-构造参数仍为3", 矩形实例.获取构造宽() == 3.0)
结束

测试_方法参数与字段重名():
    用户实例 = 用户5()
    检查("方法参数与字段重名-默认姓名", 用户实例.获取姓名() == "默认")
    用户实例.设置姓名("张三")
    检查("方法参数与字段重名-设置后张三", 用户实例.获取姓名() == "张三")
结束

测试_参数与方法参数重名():
    矩形实例 = 矩形丁(3.0, 4.0)
    检查("参数与方法参数重名-缩放用方法参数5*2=10", 矩形实例.缩放(5.0) == 10.0)
    检查("参数与方法参数重名-构造参数仍为3", 矩形实例.获取构造宽() == 3.0)
结束

// ── 主入口 ──
启动程序():
    输出("========== 重名规则测试 ==========")
    测试_参数与字段重名()
    测试_方法参数与字段重名()
    测试_参数与方法参数重名()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
