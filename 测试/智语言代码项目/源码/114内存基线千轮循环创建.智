// 114 内存基线：**千轮循环内创建**（存活槽位不得随轮数线性增长）
// ══════════════════════════════════════════════════════════════════════════
// 判据（B7 内存基线）：本用例 1000 轮、每轮创建 结构体×2 + 数组×1 + 追加，
//   ⇒ 若回收正确，**存活槽位应稳定在常数级**（不随轮数增长）；
//   ⇒ 若每轮泄漏，存活将 ≈ 轮数×常数（4000+）——即"内存随循环增长"的典型病症。
// 观测：由 `内存对账门禁`（自动纳入 `源码/*内存*.智`）在两模式下报出 存活/不可达。
// 语义自校验：累计 = 3 × (1+…+1000) = 1501500。
// ══════════════════════════════════════════════════════════════════════════
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 点:
    整数 横 = 0
    整数 纵 = 0
结束

结构体 轨迹:
    数组<点> 点列表 = []
结束

启动程序():
    输出("===== 千轮循环内创建（内存基线载体）=====")
    整数 累计 = 0
    整数 轮 = 1
    循环 轮 <= 1000:
        点 甲 = 点()
        甲.横 = 轮
        甲.纵 = 轮 * 2
        数组<整数> 列 = [轮, 轮 + 1]
        轨迹 轨 = 轨迹()
        轨.点列表.追加(甲)
        累计 = 累计 + 甲.横 + 列[1] + 轨.点列表[1].横
        轮 = 轮 + 1
    结束
    检查("千轮累计 = 3×(1+…+1000) = 1501500", 累计 == 1501500)

    输出("===== 千轮覆盖同一变量（槽覆盖释放路径）=====")
    点 车 = 点()
    整数 覆盖累计 = 0
    整数 步 = 1
    循环 步 <= 1000:
        车 = 点()
        车.横 = 步
        覆盖累计 = 覆盖累计 + 车.横
        步 = 步 + 1
    结束
    检查("千轮覆盖累计 = 500500", 覆盖累计 == 500500)
    检查("覆盖后槽内为末轮值", 车.横 == 1000)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
