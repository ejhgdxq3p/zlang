// 210 并发：**任务体内读模块变量 / 模块常量**（F34 修复的常驻护栏，2026-10-02）
//
// 背景（**F34 真实缺陷，已修**；**真双模分歧** ✗）：
//   任务体是独立线程上的**子 VM**（`并发执行器.rs`：`虚拟机::新建()` ✗）
//   ⇒ 子 VM 的 `全局变量表` 为空 ✗ ⇒ 任务体内读「模块变量/常量」得 **空值** ✗；
//   而**编译模式**直接访存真全局 ⇒ 正确 ✓（实测 S6：解释 空值 ✗ / 编译 101 ✓）。
// 修法：任务启动时把父 VM 的 `全局变量表` **浅拷贝**进子 VM ✓（句柄别名、**刻意不 +1** ✓：
//   子 VM 只读全局、其帧释放只作用于局部表 ✓、全局槽覆盖写入亦不 −1 ✓ ⇒ 无泄漏/无误回收 ✓）。
// 残留差异（**已知限制**，规范未定义）：任务**写**全局 ⇒ 解释模式仅改子 VM 副本（不回写 ✓），
//   编译模式为共享内存（真写 ✓）—— 并发写全局本属数据竞争，规范未定义 ✓。
通过数 = 0
失败数 = 0
总数 = 0

导入 并发

模块基数 = 100
模块常量 = 7

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 210 任务内读模块变量 / 常量（F34 护栏）===")

    // ① 任务体内读模块变量（修复前：解释 空值 ✗ / 编译 101 ✓）
    句柄一 = 并发.启动任务(函数() 整数:
        返回 本模块.模块基数 + 1
    结束)
    检查("任务内读模块变量 = 101", 句柄一.等待结果() == 101)

    // ② 任务体内读模块常量
    句柄二 = 并发.启动任务(函数() 整数:
        返回 本模块.模块常量
    结束)
    检查("任务内读模块常量 = 7", 句柄二.等待结果() == 7)

    // ③ 任务体内同时读模块变量 + 捕获变量（两条通路都要通 ✓）
    本地增量 = 5
    句柄三 = 并发.启动任务(函数() 整数:
        返回 本模块.模块基数 + 本地增量
    结束)
    检查("任务内 模块变量 + 捕获变量 = 105", 句柄三.等待结果() == 105)

    // ④ 嵌套任务内读模块变量（子任务的子 VM 也要继承 ✓）
    句柄四 = 并发.启动任务(函数() 整数:
        内句柄 = 并发.启动任务(函数() 整数:
            返回 本模块.模块基数 + 2
        结束)
        返回 内句柄.等待结果()
    结束)
    检查("嵌套任务内读模块变量 = 102", 句柄四.等待结果() == 102)

    // ⑤ 主流程读模块变量（对照：始终正常 ✓）
    检查("主流程读模块变量 = 100", 本模块.模块基数 == 100)

    // ⑥ 批量等待路径也读模块变量
    集合 = [并发.启动任务(函数() 整数:
        返回 本模块.模块常量 + 1
    结束)]
    结果列表 = 并发.批量等待(集合)
    检查("批量等待任务内读模块常量 = 8", 结果列表[1] == 8)

    记录("F34 已知限制（规范未定义）", "任务**写**全局在解释模式不回写父 VM，编译模式为共享写")
    收尾()
结束
