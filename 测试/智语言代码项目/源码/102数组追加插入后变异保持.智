// 正向回归（2026-09-21）：数组 `.追加` / `.插入`（新建值元素）后元素内方法变异必须保持。
//   根因同 100/101：base `堆_数组追加`/`堆_数组插入` 对写入值 +1，而语句持有的新建值临时未 −1
//   ⇒ 计数虚高 ⇒ 元素上写入触发 COW 分离丢失（实测 追加 70→1、插入 71→2，双模一致）。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 单车(整数 初始速度):
    整数 速度 = 初始速度
    移动(整数 新速度):
        自身.速度 = 新速度
    结束
    取速度() 整数:
        返回 自身.速度
    结束
结束

启动程序():
    甲 = []
    甲.追加(单车(1))
    检查("追加后元素读值正确", 甲[1].取速度() == 1)
    甲[1].移动(70)
    检查("追加后元素变异保持", 甲[1].取速度() == 70)

    乙 = [单车(1)]
    乙.插入(1, 单车(2))
    检查("插入后新元素读值正确", 乙[1].取速度() == 2)
    乙[1].移动(71)
    检查("插入后新元素变异保持", 乙[1].取速度() == 71)
    乙[2].移动(72)
    检查("插入后原元素变异保持", 乙[2].取速度() == 72)

    丙 = []
    丙.追加(单车(7))
    丙.追加(单车(8))
    丙[1].移动(77)
    丙[2].移动(78)
    检查("连续追加-首元素变异保持", 丙[1].取速度() == 77)
    检查("连续追加-次元素变异保持", 丙[2].取速度() == 78)

    丁 = 单车(9)
    戊 = [丁]
    戊[1].移动(79)
    检查("字面量含变量-元素变异保持", 戊[1].取速度() == 79)
    检查("字面量含变量-源变量不受影响", 丁.取速度() == 9)

    己 = []
    庚 = 单车(10)
    己.追加(庚)
    己[1].移动(80)
    检查("追加既有变量-元素变异保持", 己[1].取速度() == 80)
    检查("追加既有变量-源变量不受影响", 庚.取速度() == 10)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
