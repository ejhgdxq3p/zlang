// 222 并发项目模式（多模块）**边界与超时**矩阵（2026-10-22）
//
// 与 221 的分工：221 覆盖"主流程能跑通"（流水线/工作池/多路监听/异常传播）；
//   本用例专攻**规范里最容易被实现者漏掉、也最容易挂死**的条款：
//     §5.7.2 `批量等待(数组, 超时毫秒)`：超时后**未完成的填空值**，任务继续运行、**句柄仍然有效**
//     §5.7.5 `并发.终止器(毫秒)`：**超时自动触发**（计时从创建时刻起）
//     §5.7.5 `终止器.信号通道()`：可接入 `多路监听` 阻塞等待（等价于 `监听终止`）
//     §5.7.2 任务内**再启动任务**（嵌套任务）并把结果带回来
//     §5.7.4 `多路监听` 返回映射**只含一个键 `"来源"`**（不搬运通道数据）
//     §5.7.3 **同步通道（容量 0）**：发送方必须等到接收方就绪
//     §5.7.3 多任务并发写**同一通道**不串包、不丢消息
//
// 资源纪律（硬要求）：
//   · 休眠总计 ≤ 350ms（300ms 慢任务 + 150ms 等待终止器，复用同一段）·任务 ≤ 6
//   · 消息 ≤ 15 条·任何阻塞等待前都先保证对端已启动；超时值一律**大于**对端耗时，避免抖动
//   · 用例总耗时目标 < 2s（远低于 90s 硬超时）
导入 并发
导入 时间
导入 并发项目/流水线
导入 并发项目/工作池

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

慢返回() 文本:
    时间.休眠(300)
    返回 "慢完成"
结束

快返回() 文本:
    返回 "快完成"
结束

启动程序():
    输出("=== 222 并发项目模式：批量等待超时 / 终止器超时 / 同步通道 ===")

    // ───────── ① 批量等待超时（§5.7.2）─────────
    输出("-- ① 批量等待超时 --")
    慢任务 = 并发.启动任务(慢返回)
    快任务 = 并发.启动任务(快返回)
    起始 = 时间.获取计时器()
    部分 = 并发.批量等待([慢任务, 快任务], 100)
    耗时 = 时间.获取计时器() - 起始
    记录("部分结果[1] 是否空值", 转文本(部分[1] == 空值))
    检查("批量等待 返回 2 个槽位", 部分.长度() == 2)
    检查("★ 未完成任务位置 ⇒ 空值", 部分[1] == 空值)
    检查("★ 已完成任务位置 ⇒ 真实结果", 转文本(部分[2]) == "快完成")
    // ⚠ 不打印具体毫秒数：它是**测量值**（双模实测 111 / 103），打印会破坏双模 stdout 逐字节一致判据。
    检查("★★ 超时后立即返回（不等慢任务跑完 300ms）", 耗时 < 280)
    稍后 = 慢任务.等待结果()
    检查("★★ 超时未完成的任务**句柄仍有效**，稍后取到结果", 转文本(稍后) == "慢完成")
    检查("补充：快任务亦已完成", 快任务.是否完成() == 真)

    // ───────── ② 终止器超时自动触发（§5.7.5）─────────
    输出("-- ② 终止器超时自动触发 --")
    定时停止 = 并发.终止器(100)
    检查("刚创建时 是否终止 ⇒ 假（计时未到）", 定时停止.是否终止() == 假)
    时间.休眠(200)
    检查("★★ 超时后自动触发 ⇒ 是否终止 = 真", 定时停止.是否终止() == 真)
    检查("自动触发后 再手动触发无副作用", 定时停止.是否终止() == 真)

    // ───────── ③ 终止器.信号通道() 接入多路监听（§5.7.4/§5.7.5）─────────
    输出("-- ③ 信号通道 接入多路监听 --")
    手动停止 = 并发.终止器()
    信号 = 手动停止.信号通道()
    手动停止.触发终止()
    选项一 = 并发.监听通道("数据", 信号)
    选项二 = 并发.监听超时("兜底", 3000)
    多路结果 = 并发.多路监听([选项一, 选项二])
    检查("★ 终止器信号通道 ⇒ 监听通道事件立即就绪（不等 3s 兜底）", 多路结果.获取("来源") == "数据")
    检查("★ 多路监听 返回映射只含一个键（来源）", 多路结果.长度() == 1)
    检查("★ 且键名确为 来源", 多路结果.获取("来源") != 空值)

    // ───────── ④ 任务内再启动任务（嵌套任务）─────────
    输出("-- ④ 嵌套任务 --")
    外层任务 = 并发.启动任务(函数() 整数:
        内层任务 = 并发.启动任务(函数() 整数:
            返回 41
        结束)
        内层值 = 内层任务.等待结果()
        返回 内层值 + 1
    结束)
    检查("★★ 任务内 `启动任务` + `等待结果` ⇒ 外层拿到 42", 转文本(外层任务.等待结果()) == "42")

    // ───────── ⑤ 同步通道（容量 0）─────────
    输出("-- ⑤ 同步通道（容量 0）--")
    同步通道 = 并发.通道(0)
    发送者 = 并发.启动任务(函数():
        同步通道.发送("同步载荷")
        同步通道.关闭()
    结束)
    收到 = 同步通道.接收()
    检查("★ 容量 0：发送方等接收方就绪，接收方拿到完整数据", 转文本(收到) == "同步载荷")
    发送者.等待结果()
    检查("同步通道 关闭后 是否关闭 ⇒ 真", 同步通道.是否关闭() == 真)

    // ───────── ⑥ 多任务并发写同一通道（不串包、不丢）─────────
    输出("-- ⑥ 多任务并发写同一通道 --")
    共享 = 并发.通道(10)
    甲 = 并发.启动任务(函数():
        循环 序 = 1, 序 <= 5, 序 += 1:
            共享.发送("甲")
        结束
    结束)
    乙 = 并发.启动任务(函数():
        循环 序 = 1, 序 <= 5, 序 += 1:
            共享.发送("乙")
        结束
    结束)
    丙 = 并发.启动任务(函数():
        循环 序 = 1, 序 <= 5, 序 += 1:
            共享.发送("丙")
        结束
    结束)
    计数甲 = 0
    计数乙 = 0
    计数丙 = 0
    合计取到 = 0
    循环 序 = 1, 序 <= 15, 序 += 1:
        值 = 共享.接收()
        如果 值 == 空值:
            跳出
        结束
        合计取到 = 合计取到 + 1
        如果 值 == "甲":
            计数甲 = 计数甲 + 1
        否则如果 值 == "乙":
            计数乙 = 计数乙 + 1
        否则如果 值 == "丙":
            计数丙 = 计数丙 + 1
        结束
    结束
    甲.等待结果()
    乙.等待结果()
    丙.等待结果()
    记录("取到条数 / 甲 / 乙 / 丙", 转文本(合计取到) + " / " + 转文本(计数甲) + " / " + 转文本(计数乙) + " / " + 转文本(计数丙))
    检查("★ 15 条一条不丢", 合计取到 == 15)
    检查("★ 无串包：三类各 5 条", 计数甲 == 5 且 计数乙 == 5 且 计数丙 == 5)
    共享.关闭()
    检查("关闭后 接收 ⇒ 空值", 共享.接收() == 空值)

    // ───────── ⑦ 跨模块复核（模块函数里的并发仍可用）─────────
    输出("-- ⑦ 跨模块复核 --")
    检查("模块 工作池.累加(100) = 5050", 工作池.累加(100) == 5050)
    流水 = 流水线.做流水线(3, 2)
    检查("模块 流水线(3, ×2) ⇒ [2, 4, 6]", 流水 == [2, 4, 6])

    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
