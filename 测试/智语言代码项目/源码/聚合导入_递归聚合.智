// 文件: 聚合导入_递归聚合.智
// 职责: 验证【递归聚合】（规范 §2.9.5）：
//       中间聚合 聚合了 成员库(展开)，本测试再 展开聚合 中间聚合，
//       应自动获得 成员库 的全部公开成员（钻石/递归依赖同源去重，不冲突）。

导入 聚合子模块/中间聚合 展开

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 聚合导入 递归聚合（中间层再被聚合，透传子模块成员） =====")

    // 以下成员实际来自 成员库，经 中间聚合 透传而来（本测试用 展开 形式）
    检查("递归: 函数 求平方(6)=36", 求平方(6) == 36)
    检查("递归: 变量 公开变量=100", 公开变量 == 100)
    检查("递归: 常量 公开常量=3.14159", 公开常量 == 3.14159)
    检查("递归: 枚举 蓝!=红", 颜色.蓝 != 颜色.红)

    矩形 矩形实例 = 矩形(2, 5)
    检查("递归: 结构体字段 宽=2", 矩形实例.宽 == 2)
    检查("递归: 结构体方法 面积()=10", 矩形实例.面积() == 10)

    圆形 圆实例 = 圆形(4)
    检查("递归: 接口方法 圆形.描述()", 圆实例.描述() == "圆形半径=4")

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
