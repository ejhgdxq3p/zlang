// 覆盖规范 §2.3.3「各类型声明写法」+ §2.3.4「默认值规则」
//   基本类型(5)/容器类型(4)：显式声明可省略初始化，取自然零值 0 / 0.0 / "" / 假 / 空值 / [] / {}
//   并验证「空容器是值、不是空值」（§2.3.3 L1414）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

整数 甲
小数 乙
文本 丙
逻辑 丁
空值 戊
数组<整数> 己
数组 庚
映射<文本, 整数> 辛
映射 壬

整数 甲2 = 7
小数 乙2 = 1.5
文本 丙2 = "文"
逻辑 丁2 = 真
数组<整数> 癸 = [1, 2, 3]
映射<文本, 整数> 子 = {"甲": 1}

测试_基本类型默认值():
    检查("整数-省略初始化→0", 本模块.甲 == 0)
    检查("小数-省略初始化→0.0", 本模块.乙 == 0.0)
    检查("文本-省略初始化→空文本", 本模块.丙 == "")
    检查("逻辑-省略初始化→假", 本模块.丁 == 假)
    检查("空值-省略初始化→空值", 本模块.戊 == 空值)
    检查("整数-显式初始化", 本模块.甲2 == 7)
    检查("小数-显式初始化", 本模块.乙2 == 1.5)
    检查("文本-显式初始化", 本模块.丙2 == "文")
    检查("逻辑-显式初始化", 本模块.丁2 == 真)
结束

测试_容器类型默认值():
    检查("数组<整数>-省略初始化→[]", 本模块.己.长度() == 0)
    检查("数组-无约束-省略初始化→[]", 本模块.庚.长度() == 0)
    检查("映射-省略初始化→{}", 本模块.辛.长度() == 0)
    检查("映射-无约束-省略初始化→{}", 本模块.壬.长度() == 0)
    检查("数组-显式初始化", 本模块.癸.长度() == 3)
    检查("映射-显式初始化", 本模块.子.长度() == 1)
    // 空容器是可直接使用的值（不是空值）
    检查("空容器≠空值(数组)", 本模块.己 != 空值)
    检查("空容器≠空值(映射)", 本模块.辛 != 空值)
结束

启动程序():
    输出("=== 130 基本/容器类型默认值 ===")
    测试_基本类型默认值()
    测试_容器类型默认值()
    收尾()
结束
