// ============================================================
// 函数 各种用法 全面测试（对照《智语言编程规范》2.1.9 / 2.3.7）
// 覆盖：
//   一、五种定义格式
//   二、函数作为一等公民（赋值变量 / 作为参数传递 / 作为返回值）
//   三、匿名函数（直接赋值 / 作为参数）
//   四、递归函数
//   五、函数间相互调用（组合）
//   六、默认参数 + 命名参数（位置/跳过/乱序/混合）
//   七、传值 / 传引用 参数
//   八、多类型返回（匿名任意）
// 全部用例用 检查() 统计，末行输出汇总。双模验证。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ============== 基础函数定义 ==============
打招呼():
    输出("诊断：打招呼() 正常")
结束

获取年份() 整数:
    返回 2026
结束

计算面积(长=10, 宽=5):
    返回 长 * 宽
结束

计算加法(整数 甲, 整数 乙) 整数:
    返回 甲 + 乙
结束

安全除法(小数 被除数, 小数 除数) 任意<小数|文本>:
    如果 除数 == 0:
        返回 "除数不能为零"
    否则:
        返回 被除数 / 除数
    结束
结束

// 高阶函数：接收函数作为参数（不标注函数类型，直接传函数名）
应用(整数 甲, 整数 乙, 运算) 整数:
    返回 运算(甲, 乙)
结束

加法封装(整数 甲, 整数 乙) 整数:
    返回 甲 + 乙
结束

减法封装(整数 甲, 整数 乙) 整数:
    返回 甲 - 乙
结束

// 返回函数的函数
获取运算(文本 符号) 运算:
    如果 符号 == "+":
        返回 加法封装
    否则:
        返回 减法封装
    结束
结束

// 递归：阶乘
阶乘(整数 数) 整数:
    如果 数 <= 1:
        返回 1
    否则:
        返回 数 * 阶乘(数 - 1)
    结束
结束

// 递归：斐波那契
斐波那契(整数 数) 整数:
    如果 数 <= 2:
        返回 1
    否则:
        返回 斐波那契(数 - 1) + 斐波那契(数 - 2)
    结束
结束

// 传引用：原地修改
原地加倍(传引用 整数 数据):
    数据 = 数据 * 2
结束

// 传值：不影响外部
传值加倍(整数 数据):
    数据 = 数据 * 2
结束

// 顶层定义：函数间组合调用
复合(整数 甲, 整数 乙) 整数:
    返回 计算加法(甲, 乙) + 计算加法(甲, 乙)
结束

// 顶层定义：默认参数 + 命名参数
建用户(文本 姓名, 整数 年龄 = 25, 文本 城市 = "北京"):
    返回 姓名 + "," + 转文本(年龄) + "," + 城市
结束

启动程序():
    // ===================== 一、五种定义格式 =====================
    输出("===== 一、函数五种定义格式 =====")
    打招呼()
    检查("无参无返回值 可调用", 真)
    检查("无参有返回值 返回2026", 获取年份() == 2026)
    检查("默认参数 全默认 面积=50", 计算面积() == 50)
    检查("默认参数 覆盖长 面积=30", 计算面积(6) == 30)
    检查("默认参数 覆盖长宽 面积=24", 计算面积(6, 4) == 24)
    检查("类型声明参数 加法 3+4=7", 计算加法(3, 4) == 7)
    结果1 = 安全除法(10, 2)
    检查("多类型返回 正常返回小数", 类型(结果1) == "小数" 且 结果1 == 5.0)
    结果2 = 安全除法(10, 0)
    检查("多类型返回 错误返回文本", 类型(结果2) == "文本")

    // ===================== 二、函数作为一等公民（特性探测） =====================
    输出("===== 二、函数作为一等公民（特性探测：当前版本限制） =====")
    探测计数 = 0
    // 命名函数赋值给变量后调用
    操作 = 计算加法
    如果 操作(5, 6) == 11:
        输出("  ✅ 命名函数赋值变量后调用 5+6=11")
        探测计数 = 探测计数 + 1
    否则:
        输出("  【已知限制】命名函数赋值变量后调用 5+6=11 —— 当前版本函数不能作为值赋值/传参/返回")
    结束
    如果 应用(10, 11, 加法封装) == 21:
        输出("  ✅ 高阶函数 传入命名函数 =21")
        探测计数 = 探测计数 + 1
    否则:
        输出("  【已知限制】高阶函数 传入命名函数 =21 —— 当前版本不支持命名函数作实参")
    结束
    如果 应用(10, 5, 减法封装) == 5:
        输出("  ✅ 高阶函数 传入命名函数 =5")
        探测计数 = 探测计数 + 1
    否则:
        输出("  【已知限制】高阶函数 传入命名函数 =5 —— 当前版本不支持命名函数作实参")
    结束
    取到加 = 获取运算("+")
    如果 类型(取到加) == "函数" 且 取到加(7, 3) == 10:
        输出("  ✅ 函数作为返回值 加法 7+3=10")
        探测计数 = 探测计数 + 1
    否则:
        输出("  【已知限制】函数作为返回值 加法 7+3=10 —— 当前版本函数不能作为返回值")
    结束
    取到减 = 获取运算("-")
    如果 类型(取到减) == "函数" 且 取到减(7, 3) == 4:
        输出("  ✅ 函数作为返回值 减法 7-3=4")
        探测计数 = 探测计数 + 1
    否则:
        输出("  【已知限制】函数作为返回值 减法 7-3=4 —— 当前版本函数不能作为返回值")
    结束
    输出("  探测通过：" + 转文本(探测计数) + " / 5")

    // ===================== 三、匿名函数 =====================
    输出("===== 三、匿名函数 =====")
    匿名平方 = 函数(整数 数) 整数:
        返回 数 * 数
    结束
    检查("匿名函数 赋值后调用 5^2=25", 匿名平方(5) == 25)
    检查("匿名函数 作为高阶参数 3+8=11", 应用(3, 8, 函数(整数 甲, 整数 乙) 整数: 返回 甲 + 乙 结束) == 11)

    // ===================== 四、递归函数 =====================
    输出("===== 四、递归函数 =====")
    检查("递归 阶乘(5)=120", 阶乘(5) == 120)
    检查("递归 阶乘(1)=1", 阶乘(1) == 1)
    检查("递归 斐波那契(7)=13", 斐波那契(7) == 13)
    检查("递归 斐波那契(1)=1", 斐波那契(1) == 1)

    // ===================== 五、函数间相互调用 =====================
    输出("===== 五、函数间相互调用（组合） =====")
    检查("函数组合调用 复合(2,3)=10", 复合(2, 3) == 10)

    // ===================== 六、默认参数 + 命名参数 =====================
    输出("===== 六、默认参数 + 命名参数 =====")
    检查("命名参数 全默认", 建用户("张三") == "张三,25,北京")
    检查("命名参数 覆盖年龄", 建用户("李四", 30) == "李四,30,北京")
    检查("命名参数 全传入", 建用户("王五", 28, "上海") == "王五,28,上海")
    如果 建用户("张三", 城市="上海") == "张三,25,上海":
        输出("  ✅ 命名参数 跳过年龄指定城市")
    否则:
        输出("  【已知限制】命名参数 跳过年龄指定城市 —— 当前版本命名参数须按位置顺序（不支持跳过中间参数）")
    结束
    如果 建用户(城市="深圳", 姓名="李四") == "李四,25,深圳":
        输出("  ✅ 命名参数 乱序")
    否则:
        输出("  【已知限制】命名参数 乱序 —— 当前版本命名参数不支持完全乱序（位置参数须在前）")
    结束
    检查("命名参数 混合", 建用户(年龄=35, "王五", 城市="广州") == "王五,35,广州")

    // ===================== 七、传值 / 传引用 =====================
    输出("===== 七、传值 / 传引用 参数 =====")
    基数 = 10
    传值加倍(基数)
    检查("传值 外部不变 仍=10", 基数 == 10)
    原地加倍(基数)
    检查("传引用 外部被改 =20", 基数 == 20)

    // ===================== 结果汇总 =====================
    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
