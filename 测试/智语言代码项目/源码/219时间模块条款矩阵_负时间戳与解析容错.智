// 219 §5.4 时间模块**条款级矩阵（第二十七轮）**
// 断言逐条取自规范 §5.4 顶部「时间戳与容错约定（2026-10-19 定稿）」：
//   1) 时间戳为 Unix 秒、允许为负（1970 之前），按**向下取整**的日历计算
//      ⇒ `格式化(-1) = 1969-12-31 23:59:59`、`获取年(-1) = 1969`
//   2) `加` / `减` / `间隔天数` 溢出 ⇒ **抛可捕获异常（运行时异常）**，不 panic 不回绕
//   3) `间隔天数` 按**向零截断**取整日数（86399 ⇒ 0、86400 ⇒ 1、-86400 ⇒ -1）
//   5) **不存在的日历日严格报错**（13 月 / 32 日 / 2023-02-29 / 2024-04-31），绝不静默规整
// 口径固定：本实现 `间隔天数(甲, 乙) = 甲 − 乙`（既有 8+ 用例一致，规范示例已同步订正）。
// 时区口径：实现按 **UTC** 计算（不读系统时区）⇒ 跨平台与双模恒定。
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

启动程序():
    输出("=== 219 §5.4 时间模块 条款矩阵 ===")

    // ───────── ① 纪元与 UTC 口径 ─────────
    输出("-- ① 纪元与时区口径 --")
    检查("格式化(0) = 1970-01-01 00:00:00（UTC 口径）", 时间.格式化("年-月-日 时:分:秒", 0) == "1970-01-01 00:00:00")
    检查("获取年(0) = 1970", 时间.获取年(0) == 1970)
    检查("获取月(0) = 1", 时间.获取月(0) == 1)
    检查("获取日(0) = 1", 时间.获取日(0) == 1)
    检查("获取时(0) = 0", 时间.获取时(0) == 0)
    检查("获取分(0) = 0", 时间.获取分(0) == 0)
    检查("获取秒(0) = 0", 时间.获取秒(0) == 0)
    检查("获取星期(0) = 4（1970-01-01 星期四）", 时间.获取星期(0) == 4)

    // ───────── ② 负时间戳（规范约定 1）─────────
    输出("-- ② 负时间戳：向下取整的日历 --")
    检查("格式化(-1) = 1969-12-31 23:59:59", 时间.格式化("年-月-日 时:分:秒", 0 - 1) == "1969-12-31 23:59:59")
    检查("获取年(-1) = 1969", 时间.获取年(0 - 1) == 1969)
    检查("获取月(-1) = 12", 时间.获取月(0 - 1) == 12)
    检查("获取日(-1) = 31", 时间.获取日(0 - 1) == 31)
    检查("获取时(-1) = 23", 时间.获取时(0 - 1) == 23)
    检查("获取分(-1) = 59", 时间.获取分(0 - 1) == 59)
    检查("获取秒(-1) = 59", 时间.获取秒(0 - 1) == 59)
    检查("获取星期(-1) = 3（1969-12-31 星期三）", 时间.获取星期(0 - 1) == 3)
    检查("格式化(-86400) = 1969-12-31 00:00:00", 时间.格式化("年-月-日 时:分:秒", 0 - 86400) == "1969-12-31 00:00:00")
    检查("负时间戳 年份 1969", 时间.格式化("年", 0 - 86400) == "1969")

    // ───────── ③ 已知日期向量 ─────────
    输出("-- ③ 已知日期 ←→ 时间戳 向量 --")
    检查("解析 2024-01-01 = 1704067200", 时间.解析("2024-01-01", "年-月-日") == 1704067200)
    检查("2024-01-01 是星期一", 时间.获取星期(时间.解析("2024-01-01", "年-月-日")) == 1)
    检查("2024-01-07 是星期日（7）", 时间.获取星期(时间.解析("2024-01-07", "年-月-日")) == 7)
    检查("解析 2024-02-29 合法（闰年）", 时间.获取日(时间.解析("2024-02-29", "年-月-日")) == 29)
    检查("解析 2023-03-01 是星期三", 时间.获取星期(时间.解析("2023-03-01", "年-月-日")) == 3)
    检查("2024-01-05 12:30:45 往返一致", 时间.格式化("年-月-日 时:分:秒", 时间.解析("2024-01-05 12:30:45", "年-月-日 时:分:秒")) == "2024-01-05 12:30:45")

    // ───────── ④ 格式化占位符与分隔符 ─────────
    输出("-- ④ 格式化 占位符 --")
    基准 = 时间.解析("2024-03-05 06:07:08", "年-月-日 时:分:秒")
    检查("年-月-日", 时间.格式化("年-月-日", 基准) == "2024-03-05")
    检查("年/月/日", 时间.格式化("年/月/日", 基准) == "2024/03/05")
    检查("时:分:秒 补零", 时间.格式化("时:分:秒", 基准) == "06:07:08")
    检查("仅月-日", 时间.格式化("月-日", 基准) == "03-05")
    检查("仅年", 时间.格式化("年", 基准) == "2024")

    // ───────── ⑤ 解析容错（规范约定 4）─────────
    输出("-- ⑤ 解析 容错 --")
    检查("月日不补零 ≡ 补零", 时间.解析("2024-1-5", "年-月-日") == 时间.解析("2024-01-05", "年-月-日"))
    检查("斜杠分隔 年/月/日", 时间.解析("2024/01/05", "年/月/日") == 时间.解析("2024-01-05", "年-月-日"))
    检查("纯数字 ⇒ 时间戳", 时间.解析("1700000000", "年-月-日") == 1700000000)
    检查("解析负时间戳文本", 时间.解析("-1", "年-月-日") == 0 - 1)

    // ───────── ⑥ 不存在日期严格报错（规范约定 5）─────────
    输出("-- ⑥ 非法日历日 ⇒ 抛运行时异常 --")
    平年二月三十被拒 = 假
    捕获:
        时间.解析("2023-02-29", "年-月-日")
    异常:
        平年二月三十被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("2023-02-29（平年）抛运行时异常", 平年二月三十被拒)
    四月三十一被拒 = 假
    捕获:
        时间.解析("2024-04-31", "年-月-日")
    异常:
        四月三十一被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("2024-04-31 抛运行时异常", 四月三十一被拒)
    十三月被拒 = 假
    捕获:
        时间.解析("2024-13-01", "年-月-日")
    异常:
        十三月被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("13 月抛运行时异常", 十三月被拒)
    三十二日被拒 = 假
    捕获:
        时间.解析("2024-01-32", "年-月-日")
    异常:
        三十二日被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("32 日抛运行时异常", 三十二日被拒)
    零月被拒 = 假
    捕获:
        时间.解析("2024-00-10", "年-月-日")
    异常:
        零月被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("0 月抛运行时异常", 零月被拒)

    // ───────── ⑦ 加 / 减 与溢出（规范约定 2）─────────
    输出("-- ⑦ 加 / 减 / 溢出 --")
    检查("加 3600 秒 ⇒ 时 +1", 时间.获取时(时间.加(基准, 3600)) == 7)
    检查("减 3600 秒 ⇒ 时 -1", 时间.获取时(时间.减(基准, 3600)) == 5)
    检查("加 0 不变", 时间.加(基准, 0) == 基准)
    检查("加负数等于减", 时间.加(基准, 0 - 500) == 时间.减(基准, 500))
    检查("加后减 互为逆运算", 时间.减(时间.加(基准, 777), 777) == 基准)
    检查("跨日：加 86400 ⇒ 3 月 6 日", 时间.格式化("年-月-日", 时间.加(基准, 86400)) == "2024-03-06")
    检查("跨年：减 86400×65 ⇒ 2023-12-31", 时间.格式化("年-月-日", 时间.减(基准, 86400 * 65)) == "2023-12-31")
    加溢出被拒 = 假
    捕获:
        时间.加(9223372036854775807, 1)
    异常:
        加溢出被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("加 溢出抛运行时异常（进程不崩溃）", 加溢出被拒)
    减溢出被拒 = 假
    捕获:
        时间.减(0 - 9223372036854775807 - 1, 1)
    异常:
        减溢出被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("减 溢出抛运行时异常（不回绕）", 减溢出被拒)

    // ───────── ⑧ 间隔天数（向零截断 + 甲−乙）─────────
    输出("-- ⑧ 间隔天数 --")
    检查("同日 = 0", 时间.间隔天数(基准, 基准) == 0)
    检查("相差 86399 秒 ⇒ 0（截断）", 时间.间隔天数(时间.加(基准, 86399), 基准) == 0)
    检查("相差 86400 秒 ⇒ 1", 时间.间隔天数(时间.加(基准, 86400), 基准) == 1)
    检查("相差 -86400 秒 ⇒ -1", 时间.间隔天数(基准, 时间.加(基准, 86400)) == 0 - 1)
    检查("相差 -86399 秒 ⇒ 0", 时间.间隔天数(基准, 时间.加(基准, 86399)) == 0)
    检查("方向 = 甲 − 乙（甲晚于乙为正）", 时间.间隔天数(时间.加(基准, 86400 * 7), 基准) == 7)
    检查("闰年全年 366 天", 时间.间隔天数(时间.解析("2025-01-01", "年-月-日"), 时间.解析("2024-01-01", "年-月-日")) == 366)
    检查("平年全年 365 天", 时间.间隔天数(时间.解析("2024-01-01", "年-月-日"), 时间.解析("2023-01-01", "年-月-日")) == 365)

    // ───────── ⑨ 计时与休眠 ─────────
    输出("-- ⑨ 计时 / 休眠 --")
    计时甲 = 时间.获取计时器()
    检查("获取计时器 类型 = 整数", 类型(计时甲) == "整数")
    检查("获取计时器 非负", 计时甲 >= 0)
    时间.休眠(0)
    计时乙 = 时间.获取计时器()
    检查("计时器 单调不减", 计时乙 >= 计时甲)
    休眠负被拒 = 假
    捕获:
        时间.休眠(0 - 5)
    异常:
        休眠负被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("休眠负数 抛运行时异常（不永久挂起）", 休眠负被拒)

    // ───────── ⑩ 当前时间 / 毫秒 ─────────
    输出("-- ⑩ 当前时间 --")
    秒现在 = 时间.当前时间()
    毫秒现在 = 时间.当前毫秒时间()
    检查("当前时间 类型 = 整数", 类型(秒现在) == "整数")
    检查("当前毫秒时间 类型 = 整数", 类型(毫秒现在) == "整数")
    检查("当前时间 在合理区间（> 2020 年）", 秒现在 > 1577836800)
    检查("毫秒时间 ≈ 秒 × 1000（差 < 10 秒）", 毫秒现在 - 秒现在 * 1000 < 10000 且 秒现在 * 1000 - 毫秒现在 < 10000)
    检查("当前时间 可格式化", 时间.格式化("年", 秒现在).长度() == 4)

    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
