通过数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        输出("失败: " + 名称)
    结束
结束

// 深层容器作为函数参数传递
读取深层(数组 源) -> 整数:
    返回 源[1][1]
结束

// 深层容器作为返回值
构造深层() -> 数组:
    数组 结果 = [[1, 2], [3, 4]]
    返回 结果
结束

启动程序():
    // ═══ 第一组：数组四层嵌套 ═══
    数组 四层 = [[[[1, 2]]]]
    检查("数组四层读", 四层[1][1][1][2] == 2)
    四层[1][1][1][1] = 100
    检查("数组四层写", 四层[1][1][1][1] == 100)

    // ═══ 第二组：数组五层嵌套 ═══
    数组 五层 = [[[[[7]]]]]
    检查("数组五层读", 五层[1][1][1][1][1] == 7)
    五层[1][1][1][1][1] = 77
    检查("数组五层写", 五层[1][1][1][1][1] == 77)

    // ═══ 第三组：映射四层嵌套 ═══
    映射 映四 = {"甲": {"乙": {"丙": {"丁": 5}}}}
    检查("映射四层读", 映四["甲"]["乙"]["丙"]["丁"] == 5)
    映四["甲"]["乙"]["丙"]["丁"] = 55
    检查("映射四层写", 映四["甲"]["乙"]["丙"]["丁"] == 55)

    // ═══ 第四组：数组套映射套数组套映射（交替四层）═══
    数组 交替 = [{"表": [{"值": 1}, {"值": 2}]}]
    检查("交替四层读", 交替[1]["表"][2]["值"] == 2)
    交替[1]["表"][2]["值"] = 22
    检查("交替四层写", 交替[1]["表"][2]["值"] == 22)
    检查("交替四层相邻不变", 交替[1]["表"][1]["值"] == 1)

    // ═══ 第五组：映射套数组套映射套数组（交替四层）═══
    映射 交替二 = {"组": [{"数": [1, 2, 3]}]}
    检查("交替二读", 交替二["组"][1]["数"][3] == 3)
    交替二["组"][1]["数"][3] = 33
    检查("交替二写", 交替二["组"][1]["数"][3] == 33)

    // ═══ 第六组：深层容器方法调用 ═══
    数组 方法表 = [[1, 2, 3]]
    检查("深层数组长度", 方法表[1].长度() == 3)
    方法表[1].追加(4)
    检查("深层数组追加后长度", 方法表[1].长度() == 4)
    检查("深层数组追加后值", 方法表[1][4] == 4)

    映射 方法映 = {"内": {"甲": 1}}
    检查("深层映射长度", 方法映["内"].长度() == 1)
    方法映["内"].插入("乙", 2)
    检查("深层映射插入后长度", 方法映["内"].长度() == 2)
    检查("深层映射插入后值", 方法映["内"]["乙"] == 2)

    // ═══ 第七组：深层容器在循环中读写 ═══
    数组 循矩阵 = [[1, 2, 3], [4, 5, 6]]
    整数 累加 = 0
    循环 行号 = 1, 行号 <= 2, 行号 += 1:
        循环 列号 = 1, 列号 <= 3, 列号 += 1:
            累加 = 累加 + 循矩阵[行号][列号]
        结束
    结束
    检查("循环累加深层数组", 累加 == 21)

    循环 甲号 = 1, 甲号 <= 2, 甲号 += 1:
        循环 乙号 = 1, 乙号 <= 3, 乙号 += 1:
            循矩阵[甲号][乙号] = 循矩阵[甲号][乙号] * 10
        结束
    结束
    检查("循环写深层数组1", 循矩阵[1][1] == 10)
    检查("循环写深层数组2", 循矩阵[2][3] == 60)

    // ═══ 第八组：遍历深层容器 ═══
    数组 遍历表 = [[1, 2], [3, 4]]
    整数 遍历和 = 0
    循环 行数据 遍历 遍历表:
        循环 元素 遍历 行数据:
            遍历和 = 遍历和 + 元素
        结束
    结束
    检查("遍历嵌套数组", 遍历和 == 10)

    映射 遍历映 = {"甲": [1, 2], "乙": [3, 4]}
    整数 映和 = 0
    数组 键表 = 遍历映.所有键()
    循环 键 遍历 键表:
        数组 值表 = 遍历映[键]
        循环 值 遍历 值表:
            映和 = 映和 + 值
        结束
    结束
    检查("遍历映射套数组", 映和 == 10)

    // ═══ 第九组：深层容器作为函数参数与返回值 ═══
    数组 传参表 = [[9, 8], [7, 6]]
    检查("深层传参", 读取深层(传参表) == 9)
    数组 返回表 = 构造深层()
    检查("深层返回值读", 返回表[2][2] == 4)
    返回表[2][2] = 44
    检查("深层返回值写", 返回表[2][2] == 44)

    // ═══ 第十组：深层容器句柄共享语义 ═══
    数组 内层 = [1, 2]
    数组 外层数组 = [内层]
    外层数组[1][1] = 111
    检查("深层写外层可见", 外层数组[1][1] == 111)

    // ═══ 第十一组：深层越界与缺键 ═══
    数组 深越界 = [[1, 2]]
    捕获:
        整数 甲值 = 深越界[1][9]
        检查("深层越界未报错(应为假)", 假)
    异常:
        检查("深层数组越界抛异常", 真)
    结束

    映射 深缺键 = {"甲": {"乙": 1}}
    捕获:
        整数 乙值 = 深缺键["甲"]["丙"]
        检查("深层缺键未报错(应为假)", 假)
    异常:
        检查("深层映射缺键抛异常", 真)
    结束

    捕获:
        整数 丙值 = 深缺键["无此键"]["乙"]
        检查("深层外键缺失未报错(应为假)", 假)
    异常:
        检查("深层外层缺键抛异常", 真)
    结束

    // ═══ 第十二组：深层动态构造 ═══
    映射 动态 = {}
    映射 动内 = {}
    动内.插入("计数", 0)
    动态.插入("节点", 动内)
    动态["节点"]["计数"] = 动态["节点"]["计数"] + 5
    检查("动态构造深层写", 动态["节点"]["计数"] == 5)

    数组 动数组 = []
    数组 动内数组 = [1, 2]
    动数组.追加(动内数组)
    检查("动态构造深层数组读", 动数组[1][2] == 2)
    动数组[1][2] = 20
    检查("动态构造深层数组写", 动数组[1][2] == 20)

    // ═══ 第十三组：深层索引表达式为变量/运算 ═══
    数组 变索引 = [[10, 20, 30], [40, 50, 60]]
    整数 下标行 = 2
    整数 下标列 = 3
    检查("变量下标读", 变索引[下标行][下标列] == 60)
    检查("运算下标读", 变索引[下标行 - 1][下标列 - 2] == 10)
    变索引[下标行][下标列 - 1] = 500
    检查("运算下标写", 变索引[2][2] == 500)

    映射 变键 = {"甲": {"乙": 1}}
    文本 外键 = "甲"
    文本 内键 = "乙"
    检查("变量键读", 变键[外键][内键] == 1)
    变键[外键][内键] = 11
    检查("变量键写", 变键[外键][内键] == 11)

    输出("通过数 = " + 转文本(本模块.通过数) + " / 总数 = " + 转文本(本模块.总数))
结束
