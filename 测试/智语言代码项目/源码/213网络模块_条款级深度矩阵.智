结束

// ───────── ⑦ UDP 数据报 ─────────
数据报语义():
    接收端 = 网络.数据报(19137)
    发送端 = 网络.数据报(0)
    检查("数据报(固定端口) 本地端口 = 19137", 接收端.本地端口() == 19137)
    检查("数据报(0) 本地端口 由系统分配 > 0", 发送端.本地端口() > 0)

    发送端.发送("探测甲", "127.0.0.1", 19137)
    消息 = 接收端.接收(3000)
    检查("接收 非空值", 消息 != 空值)
    如果 消息 != 空值:
        检查("消息.数据 = 探测甲", 消息.数据 == "探测甲")
        检查("消息.来源地址 = 127.0.0.1", 消息.来源地址 == "127.0.0.1")
        检查("消息.来源端口 = 发送端本地端口", 消息.来源端口 == 发送端.本地端口())
    结束
    超时结果 = 接收端.接收(200)
    检查("接收超时 ⇒ 返回空值（规范明文）", 超时结果 == 空值)

    广播可调用 = 真
    捕获:
        发送端.启用广播()
    异常:
        广播可调用 = 假
    结束
    检查("启用广播 可调用", 广播可调用 == 真)
    发送端.连接("127.0.0.1", 19137)
    发送端.发送("连接后发送", "127.0.0.1", 19137)
    连接后消息 = 接收端.接收(3000)
    检查("连接后 仍未指定默认发送目标也可收（4 参写法）", 连接后消息 != 空值)
    断开可调用 = 真
    捕获:
        发送端.断开连接()
    异常:
        断开可调用 = 假
    结束
    检查("断开连接 可调用", 断开可调用 == 真)
    组播结果 = ""
    捕获:
        接收端.加入组播组("224.0.0.251")
        接收端.离开组播组("224.0.0.251")
        组播结果 = "正常"
    异常:
        组播结果 = "异常"
    结束
    记录("加入/离开组播组（环境相关）", 组播结果)
    发送端.关闭()
    接收端.关闭()
结束

// ───────── ⑧ HTTP 服务端 + 客户端 ─────────
处理请求(网络请求 请求) 网络响应:
    路径 = 请求.路径()
    方法 = 请求.方法()
    如果 路径 == "/":
        返回 网络.响应成功("根页面正文", {"内容类型": "text/plain"})
    否则如果 路径 == "/创建":
        返回 网络.响应创建(201, "已创建", {"内容类型": "text/plain"})
    否则如果 路径 == "/错误":
        返回 网络.响应错误("内部出错了")
    否则如果 路径 == "/重定向":
        返回 网络.响应重定向("/")
    否则如果 路径 == "/凭证":
        返回 网络.设置会话凭证("会话标识", "abc123", {"路径": "/", "有效期": 3600, "仅HTTP": 真})
    否则如果 路径 == "/回显":
        查询 = 请求.查询参数()
        头 = 请求.请求头()
        回显 = "方法=" + 方法
        关键词值 = 查询.获取("关键词")
        如果 关键词值 != 空值:
            回显 = 回显 + ";关键词=" + 关键词值
        否则:
            回显 = 回显 + ";关键词=缺失"
        结束
        页值 = 查询.获取("页")
        如果 页值 != 空值:
            回显 = 回显 + ";页=" + 页值
        否则:
            回显 = 回显 + ";页=缺失"
        结束
        头值 = 头.获取("x-test-header")
        如果 头值 != 空值:
            回显 = 回显 + ";自定义头=" + 头值
        否则:
            回显 = 回显 + ";自定义头=缺失"
        结束
        回显 = 回显 + ";内容=" + 请求.内容()
        回显 = 回显 + ";客户端=" + 请求.客户端地址()
        如果 请求.完整网址().是否包含("/回显"):
            回显 = 回显 + ";完整网址=含路径"
        结束
        返回 网络.响应成功(回显)
    否则:
        返回 网络.响应未找到()
    结束
结束

网页语义():
    端口 = 19138
    服务 = 网络.启动服务(端口, 处理请求, {})
    等待就绪()
    基址 = "http://127.0.0.1:" + 转文本(端口)
    检查("启动服务 返回网络服务对象", 服务 != 空值)

    响应根 = 网络.获取(基址 + "/", {"超时": 5000})
    检查("GET / 状态码 = 200", 响应根.状态码() == 200)
    检查("GET / 是否成功 = 真", 响应根.是否成功() == 真)
    检查("GET / 内容 = 根页面正文", 响应根.内容() == "根页面正文")
    检查("GET / 响应头 含 内容类型", 响应根.响应头().是否包含("内容类型"))

    响应创建 = 网络.获取(基址 + "/创建", {"超时": 5000})
    检查("GET /创建 状态码 = 201", 响应创建.状态码() == 201)
    检查("GET /创建 内容 = 已创建", 响应创建.内容() == "已创建")

    响应错误 = 网络.获取(基址 + "/错误", {"超时": 5000})
    检查("GET /错误 状态码 = 500", 响应错误.状态码() == 500)
    检查("GET /错误 内容 含 内部出错了", 响应错误.内容().是否包含("内部出错了"))

    响应未找到 = 网络.获取(基址 + "/没有这个路径", {"超时": 5000})
    检查("未匹配路径 状态码 = 404", 响应未找到.状态码() == 404)

    响应重定向 = 网络.获取(基址 + "/重定向", {"超时": 5000, "跟随重定向": 假})
    检查("GET /重定向 不跟随时 状态码 = 302", 响应重定向.状态码() == 302)
    检查("GET /重定向 响应头 含 位置", 响应重定向.响应头().是否包含("位置"))

    响应跟随 = 网络.获取(基址 + "/重定向", {"超时": 5000, "跟随重定向": 真})
    检查("GET /重定向 跟随后 状态码 = 200", 响应跟随.状态码() == 200)
    检查("GET /重定向 跟随后 内容 = 根页面正文", 响应跟随.内容() == "根页面正文")

    响应凭证 = 网络.获取(基址 + "/凭证", {"超时": 5000})
    凭证头 = 响应凭证.响应头()
    检查("设置会话凭证 响应头含 set-cookie（协议头名小写）", 凭证头.是否包含("set-cookie"))
    凭证文本 = 转文本(凭证头)
    检查("set-cookie 头含凭证值 abc123", 凭证文本.是否包含("abc123"))
    凭证值 = 响应凭证.会话凭证("会话标识")
    检查("网络响应.会话凭证(名称) 可取回凭证值", 凭证值 == "abc123")

    响应回显 = 网络.发送(基址 + "/回显?关键词=你好&页=1", "正文甲", {"超时": 5000, "请求头": {"x-test-header": "ValueX"}})
    回显文本 = 响应回显.内容()
    检查("POST 回显 方法=POST", 回显文本.是否包含("方法=POST"))
    检查("POST 回显 查询参数 关键词=你好", 回显文本.是否包含("关键词=你好"))
    检查("POST 回显 查询参数 页=1", 回显文本.是否包含("页=1"))
    检查("POST 回显 请求头 自定义头=ValueX", 回显文本.是否包含("自定义头=ValueX"))
    检查("POST 回显 请求体 内容=正文甲", 回显文本.是否包含("内容=正文甲"))
    检查("POST 回显 客户端地址=127.0.0.1", 回显文本.是否包含("客户端=127.0.0.1"))
    检查("POST 回显 完整网址 含路径", 回显文本.是否包含("完整网址=含路径"))

    关闭可调用 = 真
    捕获:
        服务.关闭()
    异常:
        关闭可调用 = 假
