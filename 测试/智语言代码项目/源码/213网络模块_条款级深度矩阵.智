// ───────── ⑤ 设置超时 ⇒ 抛运行时异常 ─────────
超时语义():
    端口 = 19135
    监听器 = 网络.监听(端口, {})
    并发.启动任务(函数():
        服务端 = 监听器.接受()
        时间.休眠(1200)
        服务端.关闭()
    结束
    )
    等待就绪()
    连接 = 网络.连接("127.0.0.1", 端口, {})
    连接.设置超时(300)
    超时抛异常 = 假
    开始 = 时间.获取计时器()
    捕获:
        空内容 = 连接.读取一行()
        记录("超时读取 未抛异常返回长度", 转文本(空内容.长度()))
    异常:
        超时抛异常 = 真
    结束
    耗时 = 时间.获取计时器() - 开始
    检查("设置超时(300) 后读取 抛可捕获异常", 超时抛异常 == 真)
    检查("超时在合理区间（≥250ms 且 < 1100ms）", 耗时 >= 250 且 耗时 < 1100)
    设置类可调用 = 真
    捕获:
        连接.设置超时(0)
        连接.设置无延迟(假)
    异常:
        设置类可调用 = 假
    结束
    检查("设置超时(0)=无超时 与 设置无延迟(假) 均可调用", 设置类可调用 == 真)
    连接.关闭()
    监听器.关闭()
结束

