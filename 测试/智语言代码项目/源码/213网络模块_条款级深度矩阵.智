    时间.休眠(400)
结束

启动程序():
    输出("=== 213 网络模块 条款级深度矩阵 ===")

    输出("-- ① §5.3.1 监听 / 连接 / 地址端口 / 一行读写 --")
    回环一()

    输出("-- ② §5.3.1 读取指定 = 不读满不罢休 --")
