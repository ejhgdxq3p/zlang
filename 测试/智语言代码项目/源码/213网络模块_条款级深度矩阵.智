    读取语义()

    输出("-- ④ §5.3.1 读取一行 自定义分隔符 --")
    自定义分隔符()

    输出("-- ⑤ §5.3.1 设置超时 ⇒ 抛运行时异常 --")
    超时语义()

    输出("-- ⑥ §5.3.1 关闭写入 ⇒ 对端 EOF，本端仍可读 --")
    半关闭语义()

    输出("-- ⑦ §5.3.2 UDP 数据报 --")
    数据报语义()

    输出("-- ⑧ §5.3.4 HTTP 服务端 响应五式 + 请求七方法 --")
    网页语义()

    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

// ───────── ① 监听 / 连接 / 地址端口 / 一行读写 ─────────
回环一():
    端口 = 19131
    监听器 = 网络.监听(端口, {})
    检查("监听器 本地端口 = 请求端口", 监听器.本地端口() == 端口)

    并发.启动任务(函数():
        服务端 = 监听器.接受()
        服务端.设置超时(3000)
        问 = 服务端.读取一行()
        服务端.写入一行("回复:" + 问)
        服务端.关闭()
    结束
    )

    等待就绪()
    连接 = 网络.连接("127.0.0.1", 端口, {})
    连接.设置超时(3000)
    连接.设置无延迟(真)
    检查("连接 远端地址 = 127.0.0.1", 连接.远端地址() == "127.0.0.1")
    检查("连接 远端端口 = 监听端口", 连接.远端端口() == 端口)
    检查("连接 本地地址 = 127.0.0.1", 连接.本地地址() == "127.0.0.1")
    检查("连接 本地端口 > 0", 连接.本地端口() > 0)
    连接.写入一行("甲")
    检查("写入一行 ⇒ 对端读取一行 不含换行（原样）", 连接.读取一行() == "回复:甲")
    连接.关闭()
    监听器.关闭()
    拒绝已抛异常 = 假
    捕获:
        监听器.接受()
    异常:
        拒绝已抛异常 = 真
    结束
    检查("监听器关闭后 接受 抛异常", 拒绝已抛异常 == 真)
结束

// ───────── ② 读取指定：不读满不罢休 ─────────
读取指定语义():
    端口 = 19132
    监听器 = 网络.监听(端口, {})
    并发.启动任务(函数():
        服务端 = 监听器.接受()
        服务端.写入("ABCDEF")
        时间.休眠(200)
        服务端.关闭()
    结束
    )
    等待就绪()
    连接 = 网络.连接("127.0.0.1", 端口, {})
    连接.设置超时(3000)
    段一 = 连接.读取指定(3)
    段二 = 连接.读取指定(3)
    检查("读取指定(3) 第一次 = ABC", 段一 == "ABC")
    检查("读取指定(3) 第二次 = DEF", 段二 == "DEF")
    检查("读满后 再读取指定 ⇒ 连接关闭返回空文本", 连接.读取指定(3) == "")
    连接.关闭()
    监听器.关闭()
结束

// ───────── ③ 读取：有多少读多少 ─────────
读取语义():
    端口 = 19133
    监听器 = 网络.监听(端口, {})
    并发.启动任务(函数():
        服务端 = 监听器.接受()
        服务端.写入("XY")
        时间.休眠(300)
        服务端.写入("ZW")
        时间.休眠(100)
        服务端.关闭()
    结束
    )
    等待就绪()
    连接 = 网络.连接("127.0.0.1", 端口, {})
    连接.设置超时(3000)
    第一批 = 连接.读取(100)
    检查("读取(100) 在仅 2 字节时就返回（不等待读满）", 第一批.长度() == 2)
    检查("读取(100) 第一批 = XY", 第一批 == "XY")
    剩余 = 连接.读取全部()
    检查("读取全部 读到连接关闭 得 ZW", 剩余 == "ZW")
    连接.关闭()
    监听器.关闭()
结束

