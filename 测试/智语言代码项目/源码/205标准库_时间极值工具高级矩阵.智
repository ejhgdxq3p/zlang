// 205 标准库深度矩阵（二）：**时间极值/解析格式族 + 工具高级（正则/编码族/数据族）**
//
// ⚠⚠ **本文件严禁出现 `时间.休眠(负数)`** ⚠⚠
//   实测（2026-10-02，双模一致）：`时间.休眠(0 - 1)` ⇒ **永久挂起** ✗（解释 6s 硬超时、编译模式亦挂起并留下
//   无法自动清理的 S1.exe ✗）⇒ 已登记为 **F31（真实缺陷）**；恢复方式：抛可捕获异常或按 0 处理。
//   本用例只保留注释，绝不执行该调用 ✓（避免把整套测试挂死 ✗）。
//
// 实测结论（双模逐字一致 ✓，本文件据此断言）：
//   · `格式化(0)` = "1970-01-01"、`格式化(-86400)` = "1969-12-31"、`9999-12-31 23:59:59` 可正常格式化 ✓
//     ⇒ 时间基准为 **UTC 无偏移**（时区无关 ✓，与 192 的结论一致 ✓）
//   · `解析("2024/06/15", "年/月/日")` 可用（格式串自定义分隔符 ✓）；格式串**无分隔符**（"年月日"）⇒ 抛异常 ✓
//   · `格式化` 遇到**未知占位符** ⇒ 原样保留字面文本 ✓（如 "星期几" ✓）
//   · 工具：正则支持 `$1` 反向引用 ✓ 与 `(?m)` 多行 ✓；`\1` 形式**不支持**（输出字面）✗（记录）
//   · 编码/哈希：**只支持 BASE64 / MD5 / SHA256**，且名称**大小写敏感**（"base64"/"md5" 抛异常 ✓）
通过数 = 0
失败数 = 0
总数 = 0

导入 时间
导入 工具

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 205 时间极值 / 工具高级矩阵 ===")

    // ───────── ① 时间：时间戳极值（UTC 无偏移基准）─────────
    输出("-- 时间戳极值 --")
    检查("格式化(0) = 1970-01-01（纪元）", 时间.格式化("年-月-日", 0) == "1970-01-01")
    检查("格式化(-86400) 回退一天 = 1969-12-31", 时间.格式化("年-月-日", 0 - 86400) == "1969-12-31")
    检查("格式化(9999-12-31 23:59:59) 上界可用", 时间.格式化("年-月-日 时:分:秒", 253402300799) == "9999-12-31 23:59:59")
    检查("格式化(0) 时:分:秒 = 00:00:00", 时间.格式化("时:分:秒", 0) == "00:00:00")
    检查("获取星期(0) = 4（1970-01-01 为星期四，1=周一）", 时间.获取星期(0) == 4)
    检查("获取年(0) = 1970", 时间.获取年(0) == 1970)
    检查("获取时(0) = 0", 时间.获取时(0) == 0)

    // ───────── ② 时间：解析格式族 ─────────
    输出("-- 解析格式族 --")
    甲 = 时间.解析("2024/06/15", "年/月/日")
    检查("自定义分隔符 解析成功且往返一致", 时间.格式化("年-月-日", 甲) == "2024-06-15")
    检查("解析后 获取年/月/日 自洽", (时间.获取年(甲) == 2024) 且 (时间.获取月(甲) == 6) 且 (时间.获取日(甲) == 15))
    检查("解析 带时分秒 往返", 时间.格式化("时:分:秒", 时间.解析("2024-06-15 08:09:10", "年-月-日 时:分:秒")) == "08:09:10")
    捕获:
        无分隔解析 = 时间.解析("2024年06月15日", "年月日")
        记录("无分隔符格式串 未抛", 转文本(无分隔解析))
        检查("无分隔符格式串 应抛异常", 假)
    异常:
        检查("格式串无分隔符（年月日）⇒ 抛可捕获异常", 真)
    结束
    捕获:
        非法解析 = 时间.解析("abc", "年-月-日")
        记录("解析(abc) 未抛", 转文本(非法解析))
        检查("解析(abc) 应抛异常", 假)
    异常:
        检查("解析非日期文本 ⇒ 抛可捕获异常", 真)
    结束
    检查("格式化 未知占位符原样保留", 时间.格式化("年-月-日 星期几", 0) == "1970-01-01 星期几")

    // ───────── ③ 时间：计算（含极大值直加）─────────
    输出("-- 时间 计算 --")
    检查("加巨大秒数（无溢出保护，直加）", 时间.加(0, 99999999999) == 99999999999)
    检查("加后可用作时间戳（格式化不崩）", 时间.格式化("年-月-日", 99999999999).长度() > 0)
    检查("减与加互逆（极大值）", 时间.减(时间.加(0, 99999999999), 99999999999) == 0)
    检查("间隔天数 同日 = 0", 时间.间隔天数(甲, 甲) == 0)
    // ⚠ F31：`时间.休眠(0 - 1)` ⇒ 永久挂起（双模一致）✗ ⇒ 本文件绝不执行 ✗
    记录("F31 提醒", "时间.休眠(负数) 永久挂起（双模一致），已登记待修 ⇒ 本用例不执行 ✗")

    // ───────── ④ 工具：正则高级 ─────────
    输出("-- 正则高级 --")
    检查("字符类 [0-9]+ ⇒ 2 个匹配", 工具.正则匹配("[0-9]+", "甲123乙45").长度() == 2)
    检查("字符类 首匹配 123", 工具.正则匹配("[0-9]+", "甲123乙45")[1] == "123")
    检查("或 | ⇒ 2 个匹配", 工具.正则匹配("甲|乙", "甲乙丙").长度() == 2)
    检查("贪婪 <.*> 匹配整段", 工具.正则匹配("<.*>", "<a><b>")[1] == "<a><b>")
    检查("非贪婪 <.*?> ⇒ 2 个匹配", 工具.正则匹配("<.*?>", "<a><b>").长度() == 2)
    检查("非贪婪 首匹配 <a>", 工具.正则匹配("<.*?>", "<a><b>")[1] == "<a>")
    检查("多行标志 (?m) ⇒ 两行都命中", 工具.正则匹配("(?m)^a", "a\换行a").长度() == 2)
    检查("捕获组：返回整体匹配（不展开分组）", 工具.正则匹配("(\反斜杠d+)(\反斜杠w)", "12ab")[1] == "12a")
    检查("替换引用 $1 生效", 工具.正则替换("(\反斜杠d+)", "[$1]", "a12b3") == "a[12]b[3]")
    记录("替换引用 反斜杠1 形式（不支持 ⇒ 原样）", 工具.正则替换("(\反斜杠d+)", "[\反斜杠1]", "a12b3"))
    检查("空模式 ⇒ 位置匹配（长度 = 字符数+1）", 工具.正则匹配("", "abc").长度() == 4)
    捕获:
        非法模式 = 工具.正则匹配("(", "abc")
        记录("非法模式 ( 未抛", 转文本(非法模式))
        检查("非法模式 应抛异常", 假)
    异常:
        检查("非法正则模式 ⇒ 抛可捕获异常", 真)
    结束

    // ───────── ⑤ 工具：编码 / 哈希 方案族与大小写 ─────────
    输出("-- 编码 / 哈希 方案族 --")
    检查("BASE64 已知向量：abc ⇒ YWJj", 工具.编码方案("BASE64", "abc") == "YWJj")
    检查("BASE64 往返（中文）", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "你好，智语言！")) == "你好，智语言！")
    检查("MD5 标准向量", 工具.哈希算法("MD5", "abc") == "900150983cd24fb0d6963f7d28e17f72")
    检查("SHA256 标准向量", 工具.哈希算法("SHA256", "abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    捕获:
        小写方案 = 工具.编码方案("base64", "abc")
        记录("方案名 base64（小写）未抛", 小写方案)
        检查("编码方案名大小写敏感 应抛异常", 假)
    异常:
        检查("编码方案名 “base64” ⇒ 抛可捕获异常（大小写敏感）", 真)
    结束
    捕获:
        小写算法 = 工具.哈希算法("md5", "abc")
        记录("算法名 md5（小写）未抛", 小写算法)
        检查("哈希算法名大小写敏感 应抛异常", 假)
    异常:
        检查("哈希算法名 “md5” ⇒ 抛可捕获异常（大小写敏感）", 真)
    结束
    捕获:
        不支持哈希 = 工具.哈希算法("SHA512", "abc")
        记录("SHA512 未抛，结果长度", 转文本(不支持哈希.长度()))
        检查("不支持算法 应抛异常", 假)
    异常:
        检查("仅支持 MD5/SHA256：SHA512 ⇒ 抛可捕获异常", 真)
    结束
    // 2026-10-19：非法 BASE64 **数据** 也改为抛可捕获异常（原静默返回空串，已登记观察项 ⇒ 已闭环）
    捕获:
        工具.解码方案("BASE64", "!!!!")
        检查("非法 BASE64 数据 ⇒ 抛可捕获异常", 假)
    异常:
        检查("非法 BASE64 数据 ⇒ 抛可捕获异常", 真)
    结束

    // ───────── ⑥ 工具：数据格式族 ─────────
    输出("-- 数据格式族 --")
    检查("解析顶层大整数", 工具.解析数据("JSON", "1234567890123456789") == 1234567890123456789)
    检查("解析嵌套数组长度 = 2", 工具.解析数据("JSON", "[[1,2],[3]]").长度() == 2)
    检查("解析小数精度 0.1", 工具.解析数据("JSON", "[0.1, 0.2]")[1] == 0.1)
    // 期望串里的双引号必须用 `\引号` 转义（本语言无 `“` ✗）；实测生成结果**无空格**：{"甲":null}
    检查("生成数据 空值 ⇒ null", 工具.生成数据("JSON", {"甲": 空值}) == "{\引号甲\引号:null}")
    检查("生成数据 嵌套结构", 工具.生成数据("JSON", {"甲": [1, {"乙": 2}]}) == "{\引号甲\引号:[1,{\引号乙\引号:2}]}")
    // 2026-10-19：非法 JSON 改为抛可捕获异常（原为静默返回空值 —— 与合法 JSON null 不可区分 ✗）
    捕获:
        工具.解析数据("JSON", "")
        检查("解析空串 ⇒ 抛可捕获异常", 假)
    异常:
        检查("解析空串 ⇒ 抛可捕获异常", 真)
    结束
    记录("解析 “null” 的类型（合法 null ⇒ 空值）", 类型(工具.解析数据("JSON", "null")))
    唯一集 = {}
    循环 序 = 1, 序 <= 300, 序 += 1:
        唯一集.插入(工具.唯一编号(), 序)
    结束
    检查("唯一编号 300 次生成全部唯一", 唯一集.长度() == 300)
    检查("唯一编号 分段数 = 5（UUID 形式）", 工具.唯一编号().分隔("-").长度() == 5)

    收尾()
结束
