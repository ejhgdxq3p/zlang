// ============================================================
// 赋值完整规则验证（对照用户规则表）
// 规则表：
//   汽车 乙 = 甲        结构体   复制数据      两个独立实例
//   列表 = [车甲,车乙]  数组     复制数据      数组槽位里是独立副本
//   可移动 设备 = 车甲   接口     复制标签      标签贴在车甲上
//   可移动 设备2 = 设备  接口     复制标签      两个标签贴在同一实例上
//   可移动 元素 = 列表[1] 接口    复制标签      标签贴在数组槽位实例上
//
// 本文件分两部分：
//   【A】逐行验证规则表
//   【B】值传递 vs 引用传递 vs 写时复制 全面验证
//
// 接口是「引用语义类型」：接口变量/参数持有指向原实例的句柄，
// 通过接口方法修改作用于原实例（接口本意，与「值复制」不冲突：
// 复制的是「标签/句柄」，不是底层实例数据）。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ───────────────── 接口与结构体 ─────────────────
接口 可移动:
    移动(速度):
    结束
    当前速度() 小数:
    结束
结束

结构体 汽车(文本 品牌) 适配 可移动:
    小数 速度 = 0.0
    移动(小数 新速度):
        自身.速度 = 新速度
    结束
    当前速度() 小数:
        返回 自身.速度
    结束
结束

// ───────────────── 辅助函数（须在被调用前定义）─────────────────
// 接口类型函数参数（验证函数参数语法 + 接口引用语义）
改速度接口(可移动 设备, 小数 速度) 整数:
    设备.移动(速度)
    返回 0
结束

// 接口作为【函数参数】调用带状态方法（已知 gap 验证用）
测试_接口参数(可移动 设备, 小数 速度) 小数:
    设备.移动(速度)
    返回 设备.当前速度()
结束

// ============================================================
// 【A】逐行验证规则表
// ============================================================
测试_规则表():
    // —— 行1：汽车 乙 = 甲  → 结构体 复制数据，两个独立实例 ——
    甲 = 汽车("甲")
    甲.移动(10.0)
    乙 = 甲
    乙.移动(999.0)
    检查("规则1-结构体赋值复制数据: 甲仍=10", 甲.当前速度() == 10.0)
    检查("规则1-结构体赋值复制数据: 乙=999", 乙.当前速度() == 999.0)

    // —— 行2：列表 = [车甲,车乙] → 数组 复制数据，槽位独立副本 ——
    车甲 = 汽车("车甲")
    车甲.移动(30.0)
    车乙 = 汽车("车乙")
    车乙.移动(20.0)
    数组<汽车> 列表 = [车甲, 车乙]
    列表[1].移动(77.0)
    检查("规则2-数组复制数据: 槽位[1]=77", 列表[1].当前速度() == 77.0)
    检查("规则2-数组复制数据: 原车甲仍=30(值复制)", 车甲.当前速度() == 30.0)
    列表[2].移动(55.0)
    检查("规则2-数组两槽位独立: 槽位[2]=55", 列表[2].当前速度() == 55.0)
    检查("规则2-数组两槽位独立: 槽位[1]不受影响=77", 列表[1].当前速度() == 77.0)

    // —— 行3：可移动 设备 = 车甲 → 接口 复制标签，标签贴在车甲上 ——
    源车 = 汽车("源")
    源车.移动(40.0)
    可移动 设备 = 源车
    设备.移动(88.0)
    检查("规则3-接口复制标签: 原源车被接口方法改为88", 源车.当前速度() == 88.0)
    检查("规则3-接口复制标签: 接口读取=88", 设备.当前速度() == 88.0)

    // —— 行4：可移动 设备2 = 设备 → 接口 复制标签，两个标签同实例 ——
    可移动 设备2 = 设备
    设备2.移动(11.0)
    检查("规则4-两标签同实例: 设备2改后源车=11", 源车.当前速度() == 11.0)
    检查("规则4-两标签同实例: 设备读=11", 设备.当前速度() == 11.0)
    检查("规则4-两标签同实例: 设备2读=11", 设备2.当前速度() == 11.0)

    // —— 行5：可移动 元素 = 列表[1] → 接口 复制标签，贴在数组槽位实例上 ——
    可移动 元素 = 列表[1]
    元素.移动(123.0)
    检查("规则5-接口贴数组槽位: 槽位[1]经接口改=123", 列表[1].当前速度() == 123.0)
    检查("规则5-接口贴数组槽位: 接口读取=123", 元素.当前速度() == 123.0)
    检查("规则5-接口贴数组槽位: 不影响原车甲(值复制)=30", 车甲.当前速度() == 30.0)
结束

// ============================================================
// 【B】值传递 vs 引用传递 vs 写时复制 全面验证
// ============================================================

// B1: 接口参数按【引用语义】传递（接口方法在原实例上修改）
测试_传值() 整数:
    车 = 汽车("值传递")
    车.移动(5.0)
    可移动 接口车 = 车
    改速度接口(接口车, 500.0)
    检查("B1-接口参数引用语义: 原车被改为500", 车.当前速度() == 500.0)
    返回 0
结束

// B3: 写时复制 验证——接口标签复制零数据复制；结构体赋值已深拷贝（见规则1）
测试_写时复制() 整数:
    原型 = 汽车("原型")
    原型.移动(1.0)
    可移动 批量标签 = 原型
    批前 = 原型.当前速度()
    批量标签.移动(2.0)
    检查("B3-写时复制接口标签: 原型经接口改=2", 原型.当前速度() == 2.0)
    检查("B3-写时复制接口标签: 批量标签读=2", 批量标签.当前速度() == 2.0)
    检查("B3-写时复制接口标签: 批前快照=1", 批前 == 1.0)
    // 数组复制（句柄级）：复制数组变量，槽位句柄共享，直到某槽位被写
    车甲二 = 汽车("写时复制甲")
    车甲二.移动(10.0)
    车乙二 = 汽车("写时复制乙")
    车乙二.移动(20.0)
    数组<汽车> 原数组 = [车甲二, 车乙二]
    数组<汽车> 副本数组 = 原数组
    副本数组[1].移动(99.0)
    检查("B3-写时复制数组: 副本槽位[1]=99", 副本数组[1].当前速度() == 99.0)
    检查("B3-写时复制数组: 原数组槽位[1]仍为10(值复制)", 原数组[1].当前速度() == 10.0)
    返回 0
结束

// B4: 数组元素作为接口变量接收者 + 方法修改（parity 关键点）
测试_接口数组元素() 整数:
    车甲三 = 汽车("车甲三")
    车甲三.移动(30.0)
    车乙三 = 汽车("车乙三")
    车乙三.移动(20.0)
    数组<可移动> 接口列表 = [车甲三, 车乙三]
    接口列表[1].移动(99.0)
    检查("B4-接口数组元素方法: 槽位[1]=99", 接口列表[1].当前速度() == 99.0)
    可移动 取元素 = 接口列表[1]
    取元素.移动(55.0)
    检查("B4-接口数组元素取出再改: 槽位[1]=55", 接口列表[1].当前速度() == 55.0)
    检查("B4-接口数组元素值复制: 原车甲三仍=30", 车甲三.当前速度() == 30.0)
    返回 0
结束

// B5: 接口作为【函数参数】调用带状态方法（已知 gap 验证）
测试_接口参数分发() 整数:
    参数车 = 汽车("参数车")
    参数车.移动(7.0)
    结果 = 测试_接口参数(参数车, 200.0)
    检查("B5-接口参数分发: 返回值=200", 结果 == 200.0)
    检查("B5-接口参数分发: 原参数车被改为200", 参数车.当前速度() == 200.0)
    返回 0
结束

启动程序():
    输出("========== 赋值完整规则验证 ==========")
    测试_规则表()
    测试_传值()
    测试_写时复制()
    测试_接口数组元素()
    测试_接口参数分发()
    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
