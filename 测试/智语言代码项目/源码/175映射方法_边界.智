// §4.4 边界：仅查键、未命中返空值、空映射、整数键、嵌套映射、下标语法
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 175 映射方法-边界 ===")
    空映射 = {}
    检查("长度-空映射", 空映射.长度() == 0)
    检查("是否包含-空映射", 空映射.是否包含("甲") == 假)
    检查("获取-空映射返空值", 空映射.获取("甲") == 空值)
    检查("所有键-空映射", 空映射.所有键().长度() == 0)
    检查("所有值-空映射", 空映射.所有值().长度() == 0)
    // 删除不存在的键
    映射甲 = {"甲": 1}
    捕获:
        映射甲.删除("不存在")
        检查("删除-不存在键不报错", 映射甲.长度() == 1)
    异常:
        记录("删除(不存在键) 抛异常", "抛")
    结束
    // 整数键
    映射乙 = {1: "一", 2: "二"}
    检查("整数键-长度", 映射乙.长度() == 2)
    检查("整数键-获取", 映射乙.获取(1) == "一")
    检查("整数键-包含", 映射乙.是否包含(2) == 真)
    映射乙.插入(3, "三")
    检查("整数键-插入", 映射乙.获取(3) == "三")
    // 值类型多样
    映射丙 = {"整数": 1, "文本": "x", "逻辑": 真, "数组": [1, 2]}
    检查("混合值-长度", 映射丙.长度() == 4)
    检查("混合值-数组值", 映射丙.获取("数组").长度() == 2)
    // 嵌套映射
    映射丁 = {"内": {"甲": 1}}
    内层 = 映射丁.获取("内")
    检查("嵌套-内层可取", 内层.获取("甲") == 1)
    // 下标语法
    映射戊 = {}
    映射戊["键"] = 100
    检查("下标-写入读取", 映射戊["键"] == 100)
    检查("下标-与获取一致", 映射戊["键"] == 映射戊.获取("键"))
    // 所有键/值 与插入一致
    映射己 = {"a": 1, "b": 2}
    检查("所有键-个数与长度一致", 映射己.所有键().长度() == 映射己.长度())
    检查("所有值-个数与长度一致", 映射己.所有值().长度() == 映射己.长度())
    检查("所有键-含a", 映射己.所有键().是否包含("a") == 真)
    检查("所有值-含2", 映射己.所有值().是否包含(2) == 真)
    收尾()
结束
