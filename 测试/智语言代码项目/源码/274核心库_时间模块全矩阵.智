// §5.4 时间模块完整矩阵（16 个函数）
// 依据：规范 §5.4（时间戳=UTC 秒；格式化占位 年/月/日/时/分/秒；获取星期 1=周一…7=周日）
// 固定时间戳基准（UTC）：
//   0          = 1970-01-01 00:00:00（周四）
//   1704112496 = 2024-01-01 12:34:56（周一）
//   951782400  = 2000-02-29 00:00:00（闰日）
//   1709164800 = 2024-02-29 00:00:00（闰日）
//   1704585600 = 2024-01-07 00:00:00（周日）
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

启动程序():
    输出("=== 05 时间模块完整矩阵 ===")

    // ───────── 当前时间 / 当前毫秒时间 ─────────
    现在 = 时间.当前时间()
    检查("当前时间-为正且晚于 2023 年", 现在 > 1700000000)
    检查("当前时间-为整数", 类型(现在) == "整数")
    毫秒 = 时间.当前毫秒时间()
    检查("当前毫秒时间-为正", 毫秒 > 1700000000000)
    差值 = 毫秒 - 现在 * 1000
    检查("当前毫秒≈当前时间×1000（±5 秒）", 差值 > 0 - 5000 且 差值 < 5000)

    // ───────── 解析（固定基准）─────────
    检查("解析-纪元零点", 时间.解析("1970-01-01 00:00:00", "年-月-日 时:分:秒") == 0)
    检查("解析-2024-01-01 12:34:56", 时间.解析("2024-01-01 12:34:56", "年-月-日 时:分:秒") == 1704112496)
    检查("解析-2000 闰日", 时间.解析("2000-02-29", "年-月-日") == 951782400)
    检查("解析-2024 闰日", 时间.解析("2024-02-29", "年-月-日") == 1709164800)
    检查("解析-只有日期时补零点", 时间.解析("2024-01-01", "年-月-日") == 1704067200)
    捕获:
        时间.解析("abc", "年-月-日")
        检查("解析-非法文本应抛异常", 假)
    异常:
        检查("解析-非法文本抛异常", 真)
        检查("解析-异常描述非空", 异常错误().描述.长度() > 0)
    结束
    捕获:
        时间.解析("", "年-月-日")
        检查("解析-空串应抛异常", 假)
    异常:
        检查("解析-空串抛异常", 真)
    结束
    捕获:
        时间.解析("2024-13-01", "年-月-日")
        检查("解析-月份13 应抛异常", 假)
    异常:
        检查("解析-月份13 抛异常", 真)
    结束
    捕获:
        记录("解析-2024-02-30（规范未定义的非法日期）", 时间.格式化("年-月-日", 时间.解析("2024-02-30", "年-月-日")))
    异常:
        检查("解析-2024-02-30 抛异常", 真)
    结束
    捕获:
        记录("解析-纯数字文本（未文档化的 epoch 秒回退）", 转文本(时间.解析("1704112496", "年-月-日")))
    异常:
        记录("解析-纯数字文本 抛异常", "抛")
    结束
    记录("解析-格式参数是否被校验（以下用错误格式解析合法日期）", 时间.格式化("年-月-日", 时间.解析("2024-01-01", "完全错误的格式")))

    // ───────── 格式化 ─────────
    检查("格式化-完整格式", 时间.格式化("年-月-日 时:分:秒", 1704112496) == "2024-01-01 12:34:56")
    检查("格式化-日期分隔符", 时间.格式化("年/月/日", 1704112496) == "2024/01/01")
    检查("格式化-时间分隔符", 时间.格式化("时.分.秒", 1704112496) == "12.34.56")
    检查("格式化-纪元零点日期", 时间.格式化("年-月-日", 0) == "1970-01-01")
    检查("格式化-纪元零点时间", 时间.格式化("时:分:秒", 0) == "00:00:00")
    检查("格式化-月日补零", 时间.格式化("月-日", 时间.解析("2024-03-05", "年-月-日")) == "03-05")
    检查("格式化-无占位符原样返回", 时间.格式化("纯文本", 0) == "纯文本")
    检查("格式化-闰日", 时间.格式化("年-月-日", 951782400) == "2000-02-29")

    // ───────── 字段提取 ─────────
    检查("获取年", 时间.获取年(1704112496) == 2024)
    检查("获取月", 时间.获取月(1704112496) == 1)
    检查("获取日", 时间.获取日(1704112496) == 1)
    检查("获取时", 时间.获取时(1704112496) == 12)
    检查("获取分", 时间.获取分(1704112496) == 34)
    检查("获取秒", 时间.获取秒(1704112496) == 56)
    检查("字段-纪元零点全零日期", 时间.获取年(0) == 1970 且 时间.获取月(0) == 1 且 时间.获取日(0) == 1)
    检查("字段-纪元零点全零时间", 时间.获取时(0) == 0 且 时间.获取分(0) == 0 且 时间.获取秒(0) == 0)
    检查("字段-闰日", 时间.获取年(951782400) == 2000 且 时间.获取月(951782400) == 2 且 时间.获取日(951782400) == 29)

    // ───────── 获取星期（1=周一 … 7=周日）─────────
    检查("星期-1970-01-01 为周四", 时间.获取星期(0) == 4)
    检查("星期-2024-01-01 为周一", 时间.获取星期(1704112496) == 1)
    检查("星期-2024-01-07 为周日", 时间.获取星期(1704585600) == 7)
    检查("星期-2024-02-29", 时间.获取星期(1709164800) == 4)
    检查("星期-范围合法", 时间.获取星期(现在) >= 1 且 时间.获取星期(现在) <= 7)

    // ───────── 加 / 减 ─────────
    检查("加-60 秒", 时间.加(0, 60) == 60)
    检查("加-86400 秒为次日", 时间.格式化("年-月-日 时:分:秒", 时间.加(1704112496, 86400)) == "2024-01-02 12:34:56")
    检查("加-0 秒不变", 时间.加(1704112496, 0) == 1704112496)
    检查("减-60 秒", 时间.减(60, 60) == 0)
    检查("减-86400 秒为前一日", 时间.格式化("年-月-日", 时间.减(1704112496, 86400)) == "2023-12-31")
    检查("加减-互为逆运算", 时间.减(时间.加(1704112496, 3600), 3600) == 1704112496)

    // ───────── 间隔天数（整日截断）─────────
    检查("间隔天数-同一时刻为0", 时间.间隔天数(1704112496, 1704112496) == 0)
    检查("间隔天数-正一日", 时间.间隔天数(时间.加(1704112496, 86400), 1704112496) == 1)
    检查("间隔天数-负一日", 时间.间隔天数(1704112496, 时间.加(1704112496, 86400)) == 0 - 1)
    检查("间隔天数-差23小时为0（截断）", 时间.间隔天数(时间.加(1704112496, 86399), 1704112496) == 0)
    检查("间隔天数-差36小时为1（截断）", 时间.间隔天数(时间.加(1704112496, 129600), 1704112496) == 1)
    检查("间隔天数-负差23小时为0", 时间.间隔天数(1704112496, 时间.加(1704112496, 86399)) == 0)

    // ───────── 计时器 / 休眠 ─────────
    计时一 = 时间.获取计时器()
    检查("获取计时器-非负", 计时一 >= 0)
    时间.休眠(10)
    计时二 = 时间.获取计时器()
    检查("获取计时器-单调不减", 计时二 >= 计时一)
    时间.休眠(0)
    检查("休眠0-可调用", 真)
    捕获:
        时间.休眠(0 - 1)
        检查("休眠-负数应抛异常", 假)
    异常:
        检查("休眠-负数抛异常", 真)
    结束

    // ───────── 格式化 / 解析 往返 ─────────
    原戳 = 1704112496
    往返文本 = 时间.格式化("年-月-日 时:分:秒", 原戳)
    检查("往返-格式化再解析一致", 时间.解析(往返文本, "年-月-日 时:分:秒") == 原戳)
    检查("往返-字段与文本一致", 时间.格式化("年-月-日", 时间.解析("2024-12-31", "年-月-日")) == "2024-12-31")

    收尾()
结束
