// 文件: 聚合导入_结构体字段方法.智
// 职责: 专项验证「经聚合模块访问结构体内部的字段与方法」。
//   规范 §2.7.3 + §2.9.2：两个门面均以**展开导入**引入（裸名直接可用）——
//     —— 默认形式聚合 ⇒ 对外名 = `成员库.成员`（子命名空间保留在对外名里）
//     —— 展开形式聚合 ⇒ 对外名 = `成员`（源模块名前缀已去掉）
//   并验证字段参与运算、方法返回值参与运算、结构体实例作函数参数。

导入 聚合子模块/聚合_默认 展开
导入 聚合子模块/聚合_展开 展开

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 经聚合模块访问 结构体字段与方法 =====")

    // —— 默认形式聚合：对外名保留子命名空间 成员库 ——
    成员库.矩形 甲 = 成员库.矩形(6, 7)
    检查("默认.实例化", 甲.宽 == 6 且 甲.高 == 7)
    检查("默认.字段参与运算", 甲.宽 + 甲.高 == 13)
    检查("默认.方法返回值参与运算", 甲.面积() * 2 == 84)

    // 嵌套方法调用：经聚合导出的函数 接收 经聚合导出的结构体（类型身份一致）
    检查("默认.跨聚合类型一致: 面积汇总", 成员库.面积汇总(甲) == 42)

    // —— 展开形式聚合：对外名已去掉源模块前缀（裸名）——
    矩形 乙 = 矩形(4, 5)
    检查("展开.字段访问", 乙.宽 == 4)
    检查("展开.方法访问", 乙.面积() == 20)

    // 接口适配结构体方法（展开形式）
    圆形 丙 = 圆形(9)
    检查("展开.接口方法", 丙.描述() == "圆形半径=9")

    // 默认形式下的接口方法访问（对外名保留子命名空间）
    成员库.圆形 丁 = 成员库.圆形(2)
    检查("默认.接口方法", 丁.描述() == "圆形半径=2")

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
