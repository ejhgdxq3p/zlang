// ============================================================
// 五大基础类型 全面测试（对照《智语言编程规范》2.3.2 基本类型 / 2.4.5 空值安全）
// 覆盖：整数、小数、文本、逻辑、空值
//   · 类型声明 vs 推断
//   · 算术运算 / 比较运算 / 逻辑运算
//   · 文本拼接与转义序列
//   · 空值等值判断与安全规则
// 全部用例用 检查() 统计，末行输出汇总。双模验证。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    // ===================== 整数 =====================
    输出("===== 一、整数 =====")
    年龄 = 18
    检查("推断 整数 年龄=18", 年龄 == 18)
    整数 显式整数
    检查("显式 整数 默认值=0", 显式整数 == 0)
    整数 数量 = 100
    检查("整数加 年龄+数量=118", 年龄 + 数量 == 118)
    检查("整数减 数量-年龄=82", 数量 - 年龄 == 82)
    检查("整数乘 年龄*2=36", 年龄 * 2 == 36)
    检查("整数除 数量/3 为小数33.333", 转文本(数量 / 3) == "33.333333333333336")
    检查("整数取余 数量%3=1", 数量 % 3 == 1)
    检查("整数幂 2^10=1024", 2 ^ 10 == 1024)
    检查("整数取负 -42=-42", -42 == -42)
    检查("整数比较 >", 数量 > 50)
    检查("整数比较 <", 数量 < 200)
    检查("整数比较 >=", 数量 >= 100)
    检查("整数比较 <=", 数量 <= 100)
    检查("整数比较 ==", 数量 == 100)
    检查("整数比较 !=", 数量 != 99)
    检查("整数作为索引 数组[2]=20", [10, 20, 30][2] == 20)
    检查("整数边界 大数相加", 9000000000000000000 + 1 == 9000000000000000001)

    // ===================== 小数 =====================
    输出("===== 二、小数 =====")
    小数 温度 = 36.5
    检查("推断/声明 小数 温度=36.5", 温度 == 36.5)
    小数 显式小数
    检查("显式 小数 默认值=0.0", 显式小数 == 0.0)
    检查("小数加 温度+1.5=38.0", 温度 + 1.5 == 38.0)
    检查("小数减 温度-0.5=36.0", 温度 - 0.5 == 36.0)
    检查("小数乘 温度*2=73.0", 温度 * 2 == 73.0)
    检查("小数除 温度/2=18.25", 温度 / 2 == 18.25)
    检查("小数幂 2.0^3=8.0", 2.0 ^ 3 == 8.0)
    检查("整数自动提升 5*3.14 类型为小数", 类型(5 * 3.14) == "小数")
    检查("整数自动提升 5*3.14 值约15.7", (5 * 3.14) > 15.6 且 (5 * 3.14) < 15.8)
    检查("小数比较 >", 温度 > 30.0)
    检查("小数比较 == 近似", 3.14 == 3.14)
    检查("小数取负 -3.14=-3.14", -3.14 == -3.14)
    检查("小数除法恒小数 7/2=3.5", 7 / 2.0 == 3.5)

    // ===================== 文本 =====================
    输出("===== 三、文本 =====")
    文本 姓名 = "小明"
    检查("声明 文本 姓名=小明", 姓名 == "小明")
    文本 显式文本
    检查("显式 文本 默认值=空串", 显式文本 == "")
    空文本 = ""
    检查("推断 空文本", 空文本 == "")
    检查("文本拼接 姓名+同学", 姓名 + "同学" == "小明同学")
    检查("文本拼接 整数须转换", 姓名 + 转文本(年龄) == "小明18")
    检查("文本比较 ==", "苹果" == "苹果")
    检查("文本比较 !=", "苹果" != "香蕉")
    检查("文本长度 中文=2", 姓名.长度() == 2)
    检查("文本长度 英文=5", "hello".长度() == 5)
    检查("文本是否包含 真", "你好世界".是否包含("世界") == 真)
    检查("文本是否包含 假", "你好世界".是否包含("地球") == 假)
    检查("文本截取 你好", "你好世界".截取(1, 2) == "你好")
    检查("文本查找 命中", "你好世界".查找("世界") == 3)
    检查("文本查找 未命中=0", "你好世界".查找("地球") == 0)
    检查("文本替换", "abc123".替换("123", "X") == "abcX")
    检查("转义序列 换行 长度", "第一行\换行 第二行".长度() > 5)
    检查("转义序列 制表 占1字符", "姓名\制表 年龄".长度() == 6)
    检查("转义序列 引号 展开为2字符长度8", "他说：\引号 你好\引号".长度() == 8)

    // ===================== 逻辑 =====================
    输出("===== 四、逻辑 =====")
    逻辑 是否成年 = 真
    检查("声明 逻辑 真", 是否成年 == 真)
    是否有效 = 假
    检查("推断 逻辑 假", 是否有效 == 假)
    逻辑 显式逻辑
    检查("显式 逻辑 默认=假", 显式逻辑 == 假)
    检查("逻辑 且 真且假=假", 是否成年 且 是否有效 == 假)
    检查("逻辑 或 真或假=真", 是否成年 或 是否有效 == 真)
    检查("逻辑 非 非假=真", 非 是否有效 == 真)
    检查("逻辑 非 非真=假", 非 是否成年 == 假)
    检查("比较产生逻辑 10>5", 10 > 5 == 真)
    检查("比较产生逻辑 10==5", 10 == 5 == 假)
    条件结果 = 假
    如果 是否成年:
        条件结果 = 真
    否则:
        条件结果 = 假
    结束
    检查("逻辑用于条件 真分支", 条件结果 == 真)
    检查("逻辑运算 结合 (真或假)且真", (是否成年 或 是否有效) 且 是否成年 == 真)

    // ===================== 空值 =====================
    输出("===== 五、空值 =====")
    空值 结果 = 空值
    检查("声明 空值", 结果 == 空值)
    当前用户 = 空值
    检查("推断 空值", 当前用户 == 空值)
    检查("空值等值 与自身==", 当前用户 == 空值)
    检查("空值等值 与自身===", 当前用户 === 空值)
    // [停用·规范 §2.4.5 铁律：空值只允许与自身 == / === 判断 ⇒ 本行写法非法；同类已由 2.4.5_负向_空值与非空值比较.智 覆盖] 检查("空值不等值 与非空", 当前用户 != "小明")
    任意<整数|文本|空值> 包装空 = 空值
    检查("空值包装 匿名任意可持有", 包装空 == 空值)
    如果 包装空 == 空值:
        检查("空值包装 分支可进入", 真)
    否则:
        检查("空值包装 分支可进入", 假)
    结束
    // 空值不能参与算术/逻辑/比较运算（与自身比较除外），以下为安全用法检测
    空容器中查找 = [1, 2, 3].查找索引(99)
    检查("空值语义 未命中返回非崩溃", 空容器中查找 == 0)

    // ===================== 结果汇总 =====================
    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
