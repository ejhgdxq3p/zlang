// 组合：文本.分隔 → 数组 → 映射 → JSON → 解析 全链往返；转文本 嵌套容器
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 181 组合-文本与容器互转 ===")
    // 文本 → 数组 → 逐项处理 → 文本
    名单文本 = "甲,乙,丙"
    名单 = 名单文本.分隔(",")
    检查("分隔-3 元素", 名单.长度() == 3)
    检查("分隔-首元素", 名单[1] == "甲")
    重建 = ""
    循环 序 = 1, 序 <= 名单.长度(), 序 += 1:
        如果 序 > 1:
            重建 = 重建 + ","
        结束
        重建 = 重建 + 名单[序]
    结束
    检查("数组→文本 往返", 重建 == 名单文本)
    // 数组 → 反转 → 文本
    名单.反转()
    检查("反转后首元素", 名单[1] == "丙")
    // 映射 → JSON → 解析 → 映射（嵌套值）
    原始 = {"姓名": "甲", "标签": ["x", "y"], "年龄": 20}
    文本化 = 工具.生成数据("JSON", 原始)
    检查("生成数据-非空", 文本化.长度() > 0)
    回来 = 工具.解析数据("JSON", 文本化)
    检查("解析-键数", 回来.长度() == 3)
    检查("解析-文本值", 回来.获取("姓名") == "甲")
    检查("解析-整数值", 回来.获取("年龄") == 20)
    标签回来 = 回来.获取("标签")
    检查("解析-数组值长度", 标签回来.长度() == 2)
    检查("解析-数组值元素", 标签回来[1] == "x")
    // 嵌套容器转文本
    嵌套 = {"外层": [[1, 2], [3, 4]]}
    嵌套文本 = 转文本(嵌套)
    检查("转文本-嵌套映射非空", 嵌套文本.长度() > 0)
    记录("转文本(嵌套容器)", 嵌套文本)
    // 数组转文本再分隔回来（字符串化往返）
    数字文本 = 转文本([1, 2, 3])
    检查("数组转文本-形如列表", 数字文本.长度() > 0)
    记录("转文本([1,2,3])", 数字文本)
    // 编码 → 解码 链式（含中文与符号）
    原文 = "甲,乙|丙 丁"
    检查("编码解码-特殊符号往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", 原文)) == 原文)
    // 哈希 → 文本方法链
    摘要 = 工具.哈希算法("SHA256", 重建)
    检查("哈希-大写长度64", 摘要.长度() == 64)
    检查("哈希-截取前8位", 摘要.截取(1, 8).长度() == 8)
    收尾()
结束
