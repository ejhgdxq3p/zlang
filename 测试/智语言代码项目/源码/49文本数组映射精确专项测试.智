// 49 文本/数组/映射 精确专项（规范 4.2 / 4.3 / 4.4 逐项精确断言）
// 重点补全上一轮未逐一精确断言的点：
//   文本：链式调用、截取边界(起>长/长>余)、查找未找到=0、分隔精确数组、去除空白边界
//   数组：查找索引边界、反转/排序后精确序、清空后长度0、是否包含精确
//   映射：所有键/所有值 精确集合、遍历循环(循环 键, 值 遍历 映射:)、获取缺失=空值、删除后是否包含=假

总数 = 0
通过数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
    否则:
        输出("❌ " + 名称)
    结束
结束

启动程序():
    // ===== 文本方法（7个，逐项精确） =====
    消息 = "你好世界"
    检查("文本.长度 中文=4", 消息.长度() == 4)
    检查("文本.截取(1,2)=你好", 消息.截取(1, 2) == "你好")
    检查("文本.截取(3,2)=世界", 消息.截取(3, 2) == "世界")
    // 截取边界：起始超长
    检查("文本.截取 起>长 返回空", 消息.截取(10, 2) == "")
    // 截取边界：长度超出剩余
    检查("文本.截取 长>余 截到末尾", 消息.截取(3, 100) == "世界")
    检查("文本.查找(世界)=3", 消息.查找("世界") == 3)
    检查("文本.查找(地球)=0", 消息.查找("地球") == 0)
    检查("文本.替换 工作->朋友", 消息.替换("世界", "朋友") == "你好朋友")
    水果 = "苹果,香蕉,橙子,葡萄"
    分 = 水果.分隔(",")
    检查("文本.分隔 长度=4", 分.长度() == 4)
    检查("文本.分隔[1]=苹果", 分[1] == "苹果")
    检查("文本.分隔[4]=葡萄", 分[4] == "葡萄")
    检查("文本.是否包含(你好)=真", 消息.是否包含("你好") == 真)
    检查("文本.是否包含(再见)=假", 消息.是否包含("再见") == 假)
    检查("文本.去除空白 前后", "   你好   ".去除空白() == "你好")
    检查("文本.去除空白 中间保留", "  a b  ".去除空白() == "a b")
    // 链式调用
    链 = "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2)
    检查("文本.链式=你好", 链 == "你好")

    // ===== 数组方法（10个，逐项精确） =====
    数字 = [10, 20, 30, 40, 50]
    检查("数组.长度=5", 数字.长度() == 5)
    数字.追加(60)
    检查("数组.追加 长度=6", 数字.长度() == 6)
    数字.插入(1, 5)
    检查("数组.插入[1]=5", 数字[1] == 5)
    检查("数组.插入 长度=7", 数字.长度() == 7)
    数字.删除(1)
    检查("数组.删除 长度=6", 数字.长度() == 6)
    末 = 数字.取末尾()
    检查("数组.取末尾=60", 末 == 60)
    检查("数组.取末尾后 长度=5", 数字.长度() == 5)
    检查("数组.是否包含(20)=真", 数字.是否包含(20) == 真)
    检查("数组.是否包含(80)=假", 数字.是否包含(80) == 假)
    检查("数组.查找索引(40)>0", 数字.查找索引(40) > 0)
    检查("数组.查找索引(80)=0", 数字.查找索引(80) == 0)
    // 反转精确
    反 = [1, 2, 3, 4]
    反.反转()
    检查("数组.反转[1]=4", 反[1] == 4)
    检查("数组.反转[4]=1", 反[4] == 1)
    // 排序精确（整数）
    排 = [3, 1, 2]
    排.排序()
    检查("数组.排序[1]=1", 排[1] == 1)
    检查("数组.排序[3]=3", 排[3] == 3)
    // 清空
    清 = [1, 2, 3]
    清.清空()
    检查("数组.清空 长度=0", 清.长度() == 0)
    // 空数组查找索引=0
    检查("空数组.查找索引=0", [].查找索引(1) == 0)

    // ===== 映射方法（8个，逐项精确） =====
    学生 = {"姓名": "小明", "年龄": 18, "班级": "高一(1)班", "成绩": 92}
    检查("映射.长度=4", 学生.长度() == 4)
    所有键 = 学生.所有键()
    检查("映射.所有键 长度=4", 所有键.长度() == 4)
    检查("映射.所有键 含姓名", 所有键.是否包含("姓名"))
    检查("映射.所有键 含成绩", 所有键.是否包含("成绩"))
    所有值 = 学生.所有值()
    检查("映射.所有值 长度=4", 所有值.长度() == 4)
    检查("映射.所有值 含小明", 所有值.是否包含("小明"))
    检查("映射.所有值 含92", 所有值.是否包含(92))
    学生.插入("性别", "男")
    检查("映射.插入 长度=5", 学生.长度() == 5)
    学生.插入("年龄", 19)
    检查("映射.插入 更新年龄=19", 学生.获取("年龄") == 19)
    检查("映射.获取 姓名=小明", 学生.获取("姓名") == "小明")
    检查("映射.是否包含(班级)=真", 学生.是否包含("班级") == 真)
    检查("映射.是否包含(不存在)=假", 学生.是否包含("不存在键") == 假)
    检查("映射.获取 缺失=空值", 学生.获取("缺失键") == 空值)
    学生.删除("班级")
    检查("映射.删除 长度=4", 学生.长度() == 4)
    检查("映射.删除后 是否包含=假", 学生.是否包含("班级") == 假)
    学生.清空()
    检查("映射.清空 长度=0", 学生.长度() == 0)

    // ===== 映射遍历循环（规范 循环 键, 值 遍历 映射:） =====
    成绩表 = {"语文": 88, "数学": 95, "英语": 76}
    总和 = 0
    计数 = 0
    循环 科目, 分 遍历 成绩表:
        总和 += 分
        计数 += 1
    结束
    检查("映射遍历 计数=3", 计数 == 3)
    检查("映射遍历 总和=259", 总和 == 259)
    // 遍历收集键
    键集合 = []
    循环 键名, 值 遍历 成绩表:
        键集合.追加(键名)
    结束
    检查("映射遍历 收集键含语文", 键集合.是否包含("语文"))
    检查("映射遍历 收集键含英语", 键集合.是否包含("英语"))

    // ===== 数组遍历(循环 元素 遍历 数组:) =====
    求和2 = 0
    循环 元素 遍历 [10, 20, 30]:
        求和2 += 元素
    结束
    检查("数组遍历 求和=60", 求和2 == 60)

    输出("")
    输出("===== 49 文本数组映射精确专项 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + " 通过：" + 转文本(本模块.通过数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
