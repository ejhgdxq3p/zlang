// 文本 7 方法 × 边界矩阵：截取/查找/替换/分隔/去除空白/是否包含/长度（含 Unicode）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 190 文本边界与 Unicode ===")
    文 = "你好世界"
    // ① 截取边界（索引从 1 开始）
    检查("截取-首字符", 文.截取(1, 1) == "你")
    检查("截取-末字符", 文.截取(4, 1) == "界")
    检查("截取-整串", 文.截取(1, 4) == 文)
    检查("截取-跨中段", 文.截取(2, 2) == "好世")
    记录("截取-起始=长度(4)", 文.截取(4, 1))
    记录("截取-起始越界(5,1)", 文.截取(5, 1))
    记录("截取-长度0(1,0)", 文.截取(1, 0))
    记录("截取-长度超长(1,99)", 文.截取(1, 99))
    记录("截取-起始0(0,2)", 文.截取(0, 2))
    // ② 查找边界
    检查("查找-首字符位置1", 文.查找("你") == 1)
    检查("查找-末字符位置4", 文.查找("界") == 4)
    检查("查找-未找到返回0", 文.查找("地球") == 0)
    重复 = "甲甲甲"
    检查("查找-重复取首次", 重复.查找("甲") == 1)
    检查("查找-子串跨位", "甲乙丙".查找("乙丙") == 2)
    检查("查找-空串在任意位置", "甲乙".查找("") >= 0)
    // ③ 替换边界
    检查("替换-全部替换", "甲甲甲".替换("甲", "乙") == "乙乙乙")
    检查("替换-无匹配原样", 文.替换("地球", "火星") == 文)
    检查("替换-替换成空串", "甲乙丙".替换("乙", "") == "甲丙")
    检查("替换-替换成多字符", "甲乙".替换("乙", "丙丁") == "甲丙丁")
    检查("替换-正则元字符按字面量", "a.b".替换(".", "-") == "a-b")
    检查("替换-含反斜杠字面量", "a\反斜杠b".替换("\反斜杠", "/") == "a/b")
    // ④ 分隔边界
    检查("分隔-单字符", "甲,乙,丙".分隔(",").长度() == 3)
    检查("分隔-不存在分隔符", "甲乙".分隔(",").长度() == 1)
    检查("分隔-连续分隔符产生空段", "甲,,乙".分隔(",").长度() == 3)
    记录("分隔-多字符分隔符", 转文本("甲::乙".分隔("::").长度()))
    记录("分隔-首尾均有分隔符", 转文本(",甲,".分隔(",").长度()))
    // ⑤ 去除空白（含转义空白）
    检查("去除空白-半角空格", "  甲乙  ".去除空白() == "甲乙")
    检查("去除空白-制表符", "\制表甲乙\制表".去除空白() == "甲乙")
    检查("去除空白-换行符", "\换行甲乙\换行".去除空白() == "甲乙")
    检查("去除空白-无空白原样", "甲乙".去除空白() == "甲乙")
    检查("去除空白-全空白得空", "   ".去除空白() == "")
    检查("去除空白-中间空白保留", "甲 乙".去除空白() == "甲 乙")
    // ⑥ 是否包含边界
    检查("是否包含-空串总为真", 文.是否包含("") == 真)
    检查("是否包含-自身为真", 文.是否包含(文) == 真)
    检查("是否包含-不存在为假", 文.是否包含("地球") == 假)
    // ⑦ 长度与 Unicode
    检查("长度-中文4", 文.长度() == 4)
    检查("长度-空串0", "".长度() == 0)
    检查("长度-半角数字", "12345".长度() == 5)
    检查("长度-中英混合", "甲a乙b".长度() == 4)
    记录("长度-emoji 单个", 转文本("😀".长度()))
    记录("长度-emoji 两个", 转文本("😀😀".长度()))
    // ⑧ 链式组合
    链 = "  你好世界  ".去除空白().替换("世界", "智语言").截取(1, 2)
    检查("链式-规范示例等价", 链 == "你好")
    收尾()
结束
