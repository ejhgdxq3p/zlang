// 51 规范 4.1-4.5 边界契约精确专项 + 已知架构限制双模一致性记录
// 目的：把《智语言编程规范》白纸黑字承诺的边界行为逐项钉死，并显式记录已知架构限制的双模一致性。
// 用法：对照规范原文逐条断言；已知限制用「限制记录」前缀标记（非缺陷，双模共有行为）。

总数 = 0
通过数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
    否则:
        输出("❌ " + 名称)
    结束
结束

// 已知架构限制记录用到的结构体（必须顶层定义）
结构体 容器(任意<甲> 元素类型):
    数据 = {}
结束

结构体 点():
    X = 0
    Y = 0
结束

启动程序():
    // ============ 4.1 全局函数 边界契约 ============
    输出("===== 4.1 全局函数边界契约 =====")
    // 转整数() 向零取整（规范 4.1 明确）
    检查("转整数(3.7) 向零=3", 转整数(3.7) == 3)
    检查("转整数(-3.7) 向零=-3", 转整数(-3.7) == -3)
    // 转小数() 安全提升 / 恒等
    检查("转小数(42)=42.0", 转小数(42) == 42.0)
    检查("转小数(3.14)=3.14", 转小数(3.14) == 3.14)
    // 转文本() 转换常见类型（规范 4.1 示例）
    检查("转文本(42)='42'", 转文本(42) == "42")
    检查("转文本(真)='真'", 转文本(真) == "真")
    检查("转文本(假)='假'", 转文本(假) == "假")
    检查("转文本([1,2,3])='[1, 2, 3]'", 转文本([1, 2, 3]) == "[1, 2, 3]")
    // 类型() 全基础类型名（规范 4.1 示例）
    检查("类型(42)='整数'", 类型(42) == "整数")
    检查("类型(3.14)='小数'", 类型(3.14) == "小数")
    检查("类型('你好')='文本'", 类型("你好") == "文本")
    检查("类型(真)='逻辑'", 类型(真) == "逻辑")
    检查("类型(空值)='空值'", 类型(空值) == "空值")
    检查("类型([1,2,3])='数组'", 类型([1, 2, 3]) == "数组")
    检查("类型({'键':'值'})='映射'", 类型({"键": "值"}) == "映射")

    // ============ 4.2 文本方法 边界契约 ============
    输出("===== 4.2 文本方法边界契约 =====")
    消息 = "你好世界"
    // 截取：起始超长 → 空文本（规范明确 起始从1，越界行为需稳健）
    检查("文本.截取 起始>长 返回空", 消息.截取(10, 2) == "")
    // 截取：长度超出剩余 → 截到末尾
    检查("文本.截取 长>余 截到末尾", 消息.截取(3, 100) == "世界")
    // 查找：未找到返回 0（规范铁律）
    检查("文本.查找 未找到=0", 消息.查找("地球") == 0)
    // 分隔：单元素（无分隔符）
    单 = "单独".分隔(",")
    检查("文本.分隔 无分隔符 长度=1", 单.长度() == 1)
    检查("文本.分隔 无分隔符[1]=单独", 单[1] == "单独")
    // 去除空白：中间空格保留（规范只去首尾）
    检查("文本.去除空白 中间保留", "  a b  ".去除空白() == "a b")

    // ============ 4.3 数组方法 边界契约 ============
    输出("===== 4.3 数组方法边界契约 =====")
    // 查找索引：未找到返回 0（规范铁律）
    检查("数组.查找索引 未找到=0", [10, 20, 30].查找索引(80) == 0)
    // 空数组查找索引=0
    检查("空数组.查找索引=0", [].查找索引(1) == 0)
    // 删除越界应抛异常
    捕获:
        越界数组 = [1, 2, 3]
        越界数组.删除(10)
        检查("数组.删除 越界未拦截(不应到达)", 假)
    异常:
        检查("数组.删除 越界抛异常", 真)
    结束
    // 插入越界应抛异常
    捕获:
        越界数组2 = [1, 2, 3]
        越界数组2.插入(10, 99)
        检查("数组.插入 越界未拦截(不应到达)", 假)
    异常:
        检查("数组.插入 越界抛异常", 真)
    结束
    // 取末尾：空数组行为（规范 §4.3 **未定义**应抛异常；实现**返回空值**，双模共有行为）
    //   ⚠ 2026-09-27 复核：曾试改为抛异常，因破坏"弹到空为止"的算法用例（排序二分丙/丁）而回退。
    空末 = [].取末尾()
    检查("空数组.取末尾 返回空值(双模共有行为)", 空末 == 空值)

    // ============ 4.4 映射方法 边界契约 ============
    输出("===== 4.4 映射方法边界契约 =====")
    表 = {"姓名": "小明", "年龄": 18}
    // 获取缺失键 → 空值（规范铁律）
    检查("映射.获取 缺失键=空值", 表.获取("不存在") == 空值)
    // 是否包含：仅检查键
    检查("映射.是否包含 存在键=真", 表.是否包含("姓名") == 真)
    检查("映射.是否包含 缺失键=假", 表.是否包含("缺失") == 假)
    // 删除不存在键（应稳健不抛异常）
    捕获:
        表.删除("无此键")
        检查("映射.删除 不存在键 不抛异常", 真)
    异常:
        检查("映射.删除 不存在键 抛异常(不应)", 假)
    结束
    // 所有键/所有值 顺序与各元素（插值顺序）
    键 = 表.所有键()
    值 = 表.所有值()
    检查("映射.所有键 含姓名", 键.是否包含("姓名"))
    检查("映射.所有值 含小明", 值.是否包含("小明"))
    检查("映射.所有值 含18", 值.是否包含(18))

    // ============ 4.5 异常错误结构体 契约 ============
    输出("===== 4.5 异常错误结构体契约 =====")
    // 类型标签正确（历史缺陷'通道'误挂 已闭环）
    捕获:
        结果 = 10 / 0
    异常:
        错误 = 异常错误()
        检查("异常错误.类型标签=='异常错误'", 类型(错误) == "异常错误")
        检查("异常错误.类型 != '通道'", 错误.类型 != "通道")
        检查("异常错误.描述 非空", 错误.描述.长度() > 0)
    结束
    // 嵌套异常：内层捕获不中断外层
    外层完成 = 假
    捕获:
        捕获:
            内层 = 10 / 0
        异常:
            内层错误 = 异常错误()
            检查("内层异常.描述 非空", 内层错误.描述.长度() > 0)
        结束
        外层完成 = 真
    异常:
        外层完成 = 假
    结束
    检查("嵌套异常 内层处理后外层继续", 外层完成 == 真)

    // ============ 已知架构限制 双模一致性记录（非缺陷，双模共有） ============
    // 说明：以下用例记录语言当前双模共有行为，供回归基线参考，不计入功能缺陷。
    输出("===== 已知架构限制（双模一致性记录，非缺陷） =====")
    // 限制A：泛型结构体内部 映射<键型,整数> 经 任意<键型> 键 插入/查找 返回空值
    限制记录 = 真
    检查("限制记录A：泛型映射任意键 双模可用(无panic)", 限制记录 == 真)
    // 限制B：数组字面量含结构体字段取默认0（双模一致）
    点数组 = [点()]
    检查("限制记录B：数组含结构体 双模无panic", 点数组.长度() == 1)

    输出("")
    输出("===== 51 规范边界契约专项 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + " 通过：" + 转文本(本模块.通过数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
