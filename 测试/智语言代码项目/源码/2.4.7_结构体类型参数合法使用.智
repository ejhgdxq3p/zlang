// 文件: 2.4.7_结构体类型参数合法使用.智
// 职责: 规范 §2.4.7 —— 结构体类型参数**不冲突**时必须正常：
//   ① 类型参数只用于构造参数、成员名与之不同 ⇒ 正常 ✓
//   ② 类型参数与**结构体名**同名 ⇒ 允许（结构体名在外层作用域，规范明文）✓
//   ③ 无类型参数的结构体 ⇒ 正常 ✓
结构体 盒子(任意<值> 内容):
    整数 数量 = 0

    取数量() 整数:
        返回 自身.数量
    结束
结束

结构体 值(任意<值> 内容):
    整数 数量 = 0
结束

结构体 点():
    整数 横 = 0
结束

通过数 = 0
失败数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("FAILCASE " + 名称)
    结束
结束

启动程序():
    甲 = 盒子(1)
    甲.数量 = 3
    检查("类型参数不冲突可正常使用", 甲.取数量() == 3)

    乙 = 值(2)
    乙.数量 = 4
    检查("类型参数与结构体名同名（允许）", 乙.数量 == 4)

    丙 = 点()
    丙.横 = 5
    检查("无类型参数结构体正常", 丙.横 == 5)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
