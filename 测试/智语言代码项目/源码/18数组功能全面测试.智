// 用于"捕获异常"的辅助：被调用函数可能抛异常，由调用方 try 捕获
启动程序():
    输出("===== A. 基础：长度/索引 1-based =====")
    数 = [10, 20, 30, 40, 50]
    检查("长度()=5", 数.长度() == 5)
    检查("索引1=10", 数[1] == 10)
    检查("索引5=50", 数[5] == 50)
    检查("索引从1开始(索引3=30)", 数[3] == 30)

    输出("===== B. 追加 =====")
    果 = ["苹果", "香蕉", "橙子"]
    果.追加("葡萄")
    检查("追加后长度=4", 果.长度() == 4)
    检查("追加元素在末尾", 果[4] == "葡萄")
    数.追加(60)
    检查("整数数组追加后长度=6", 数.长度() == 6)
    检查("整数数组追加末尾=60", 数[6] == 60)

    输出("===== C. 插入（索引从1开始）=====")
    插入测试 = [1, 2, 3]
    插入测试.插入(1, 100)        // 在开头插入
    检查("插入索引1: 长度=4", 插入测试.长度() == 4)
    检查("插入索引1: 新首=100", 插入测试[1] == 100)
    检查("插入索引1: 原首后移=1", 插入测试[2] == 1)
    插入测试.插入(3, 200)        // 在中间插入
    检查("插入索引3: 长度=5", 插入测试.长度() == 5)
    检查("插入索引3: 位置3=200", 插入测试[3] == 200)
    检查("插入索引3: 位置4=2", 插入测试[4] == 2)

    输出("===== D. 删除 =====")
    删除测试 = [1, 2, 3, 4, 5]
    删除测试.删除(1)             // 删首
    检查("删除索引1: 长度=4", 删除测试.长度() == 4)
    检查("删除索引1: 新首=2", 删除测试[1] == 2)
    删除测试.删除(3)             // 删第3个（原4）
    检查("删除索引3: 长度=3", 删除测试.长度() == 3)
    检查("删除索引3: 现位置3=5", 删除测试[3] == 5)

    输出("===== E. 取末尾 =====")
    末测 = [7, 8, 9]
    弹出 = 末测.取末尾()
    检查("取末尾返回值=9", 弹出 == 9)
    检查("取末尾后长度=2", 末测.长度() == 2)
    检查("取末尾后末位=8", 末测[2] == 8)

    输出("===== F. 是否包含 / 查找索引 =====")
    查测 = [11, 22, 33, 22]
    检查("是否包含(22)=真", 查测.是否包含(22))
    检查("是否包含(99)=假", 查测.是否包含(99) == 假)
    检查("查找索引(11)=1", 查测.查找索引(11) == 1)
    检查("查找索引(22)=2（首次出现）", 查测.查找索引(22) == 2)
    检查("查找索引(99)=0（未找到）", 查测.查找索引(99) == 0)

    输出("===== G. 反转（原地）=====")
    反测 = [1, 2, 3, 4]
    反测.反转()
    检查("反转后[1]=4", 反测[1] == 4)
    检查("反转后[4]=1", 反测[4] == 1)
    检查("反转后[2]=3", 反测[2] == 3)
    检查("反转长度不变=4", 反测.长度() == 4)
    文本反 = ["甲", "乙", "丙"]
    文本反.反转()
    检查("文本数组反转[1]=丙", 文本反[1] == "丙")
    检查("文本数组反转[3]=甲", 文本反[3] == "甲")

    输出("===== H. 排序（原地，仅同类型数值）=====")
    排测 = [3, 1, 4, 1, 5, 2]
    排测.排序()
    检查("排序后[1]=1", 排测[1] == 1)
    检查("排序后[2]=1", 排测[2] == 1)
    检查("排序后[3]=2", 排测[3] == 2)
    检查("排序后[6]=5", 排测[6] == 5)
    检查("排序后长度不变=6", 排测.长度() == 6)
    小数排 = [3.5, 1.2, 2.8]
    小数排.排序()
    检查("小数排序[1]=1.2", 小数排[1] == 1.2)
    检查("小数排序[3]=3.5", 小数排[3] == 3.5)

    输出("===== I. 清空 =====")
    清测 = [1, 2, 3]
    清测.清空()
    检查("清空后长度=0", 清测.长度() == 0)

    输出("===== J. 链式调用 =====")
    链 = []
    链.追加(10).追加(20).追加(30)
    检查("链式追加后长度=3", 链.长度() == 3)
    检查("链式追加[1]=10", 链[1] == 10)
    检查("链式追加[3]=30", 链[3] == 30)

    输出("===== K. 泛型声明 数组<整数> =====")
    数组<整数> 整数数组 = [5, 6, 7]
    检查("泛型数组长度=3", 整数数组.长度() == 3)
    整数数组.追加(8)
    检查("泛型数组追加后=4", 整数数组.长度() == 4)
    检查("泛型数组追加末尾=8", 整数数组[4] == 8)

    输出("===== L. 数组赋值值复制（深拷贝隔离）=====")
    源 = [1, 2, 3]
    副本 = 源
    副本[1] = 99
    检查("副本修改不影响原[1]=1", 源[1] == 1)
    检查("副本独立[1]=99", 副本[1] == 99)
    检查("原[2]不变=2", 源[2] == 2)

    输出("===== M. 嵌套数组深拷贝 =====")
    嵌套源 = [[1, 2], [3, 4]]
    嵌套副本 = 嵌套源
    嵌套副本[1][1] = 999
    检查("嵌套副本修改不影响原[1][1]=1", 嵌套源[1][1] == 1)
    检查("嵌套副本独立[1][1]=999", 嵌套副本[1][1] == 999)

    输出("===== N. 数组含结构体 =====")
    点数组 = [坐标点(1, 2), 坐标点(3, 4)]
    检查("结构体数组长度=2", 点数组.长度() == 2)
    检查("结构体数组[1].横坐标=1", 点数组[1].横坐标 == 1)
    检查("结构体数组[2].距离=25", 点数组[2].距离() == 25)
    点副本 = 点数组
    点副本[1].横坐标 = 100
    检查("结构体数组赋值值复制隔离（原[1].横坐标=1）", 点数组[1].横坐标 == 1)
    检查("结构体数组副本独立[1].横坐标=100", 点副本[1].横坐标 == 100)

    输出("===== O. 越界访问抛异常 =====")
    越界测 = [1, 2, 3]
    捕获到异常 = 假
    捕获:
        临时 = 越界测[10]
    异常:
        捕获到异常 = 真
    结束
    检查("索引越界(10)抛异常", 捕获到异常)

    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
