// ============================================================
// 值传递 / 引用传递 规范新测试（对照《智语言编程规范》§2.3.7 参数传递）
// 严格遵守语法规则：
//   1) 顶层变量用「变量 X = 0」（规范无 全局 变量 关键字）
//   2) 传值默认，传引用必须显式 传引用 且带类型、无默认值
//   3) 传引用 仅用于函数参数定义
//   4) 函数内对参数重新赋值不影响原变量（别名仅局部）
//   5) 所有类型变量赋值均为值复制（数组/映射/结构体深度独立）
// 全部双模验证（解释模式 + 编译模式）。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ---------- 基础类型 ----------
// 传值：函数内修改只影响副本
改转整数(整数 数据):
    数据 = 数据 + 100
结束

改转文本(文本 数据):
    数据 = "改后"
结束

// 传引用：函数内修改影响外部原件
改整数引用(传引用 整数 数据):
    数据 = 数据 + 100
结束

// ---------- 结构体 ----------
结构体 盒子(文本 标签):
    文本 标签 = 标签
    整数 数量 = 0
    增加(整数 增量):
        自身.数量 = 自身.数量 + 增量
    结束
    改标签(文本 新标签):
        自身.标签 = 新标签
    结束
结束

改结构体(盒子 数据):
    数据.增加(50)
    数据.改标签("传值改")
结束

改结构体引用(传引用 盒子 数据):
    数据.增加(50)
    数据.改标签("引用改")
结束

// 结构体含数组字段
结构体 包裹(整数 编号):
    整数 编号 = 编号
    内容 = [0, 0, 0]
    填内容(整数 位置, 整数 值):
        自身.内容[位置] = 值
    结束
结束

改包裹引用(传引用 包裹 数据):
    数据.编号 = 999
    数据.填内容(1, 111)
结束

// ---------- 容器 ----------
改数组(数组<整数> 数据):
    数据.追加(999)
结束

改数组引用(传引用 数组<整数> 数据):
    数据.追加(999)
结束

改映射(映射<文本, 整数> 数据):
    数据.插入("x", 999)
结束

改映射引用(传引用 映射<文本, 整数> 数据):
    数据.插入("x", 999)
结束

// 传引用后函数内重新赋值（不影响原变量）
重赋值引用(传引用 数组<整数> 数据):
    数据 = [4, 5, 6]
结束

// ---------- 接口 ----------
接口 可计数:
    增加(整数 量):
    结束
    取数() 整数:
    结束
结束

结构体 计数器(整数 初始) 适配 可计数:
    整数 值 = 0
    增加(整数 量):
        自身.值 = 自身.值 + 量
    结束
    取数() 整数:
        返回 自身.值
    结束
    初始化():
        自身.值 = 初始
    结束
结束

改接口(可计数 设备, 整数 量) 整数:
    设备.增加(量)
    返回 0
结束

启动程序():
    输出("===== 1. 传值：基础类型隔离 =====")
    甲 = 10
    改转整数(甲)
    检查("整数传值：原地不变=10", 甲 == 10)

    文本乙 = "原"
    改转文本(文本乙)
    检查("文本传值：原地不变=原", 文本乙 == "原")

    输出("===== 2. 传引用：基础类型就地修改 =====")
    丙 = 20
    改整数引用(丙)
    检查("整数传引用：原地被改=120", 丙 == 120)

    输出("===== 3. 传值：结构体隔离 =====")
    盒 = 盒子("A")
    盒.增加(5)
    改结构体(盒)
    检查("结构体传值：数量不变=5", 盒.数量 == 5)
    检查("结构体传值：标签不变=A", 盒.标签 == "A")

    输出("===== 4. 传引用：结构体就地修改 =====")
    盒2 = 盒子("B")
    盒2.增加(5)
    改结构体引用(盒2)
    检查("结构体传引用：数量被改=55", 盒2.数量 == 55)
    检查("结构体传引用：标签被改=引用改", 盒2.标签 == "引用改")

    输出("===== 5. 传引用：结构体含数组字段嵌套写回 =====")
    包 = 包裹(1)
    包.填内容(1, 11)
    改包裹引用(包)
    检查("结构体含数组传引用：编号被改=999", 包.编号 == 999)
    检查("结构体含数组传引用：嵌套元素写回=111", 包.内容[1] == 111)

    输出("===== 6. 传值：数组隔离 =====")
    列 = [1, 2, 3]
    改数组(列)
    检查("数组传值：原地长度不变=3", 列.长度() == 3)

    输出("===== 7. 传引用：数组就地修改 =====")
    列2 = [1, 2, 3]
    改数组引用(列2)
    检查("数组传引用：原地被追加=4", 列2.长度() == 4)
    检查("数组传引用：新末位=999", 列2[4] == 999)

    输出("===== 8. 传值：映射隔离 =====")
    表 = {"a": 1}
    改映射(表)
    检查("映射传值：原地长度不变=1", 表.长度() == 1)

    输出("===== 9. 传引用：映射就地修改 =====")
    表2 = {"a": 1}
    改映射引用(表2)
    检查("映射传引用：长度=2", 表2.长度() == 2)
    检查("映射传引用：含新键x", 表2.是否包含("x"))
    检查("映射传引用：x=999", 表2.获取("x") == 999)

    输出("===== 10. 传引用后函数内重新赋值不影响原变量 =====")
    原链 = [1, 2, 3]
    重赋值引用(原链)
    检查("传引用重赋值：原变量仍=3长度", 原链.长度() == 3)

    输出("===== 11. 接口参数引用语义作用于原实例 =====")
    计 = 计数器(10)
    改接口(计, 5)
    检查("接口参数：原实例被改=15", 计.取数() == 15)

    输出("===== 12. 变量赋值值复制（深度独立） =====")
    源 = [1, 2, 3]
    副 = 源
    副.追加(4)
    检查("数组值复制：源不变=3长度", 源.长度() == 3)
    检查("数组值复制：副本独立=4长度", 副.长度() == 4)

    源盒 = 盒子("S")
    源盒.增加(7)
    副盒 = 源盒
    副盒.增加(3)
    副盒.改标签("副")
    检查("结构体值复制：源数量不变=7", 源盒.数量 == 7)
    检查("结构体值复制：副数量独立=10", 副盒.数量 == 10)
    检查("结构体值复制：源标签不变=S", 源盒.标签 == "S")

    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("❌ 存在失败用例")
    否则:
        输出("✅ 全部通过")
    结束
结束
