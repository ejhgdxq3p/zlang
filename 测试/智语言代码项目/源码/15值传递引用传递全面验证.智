// ============================================================
// 值传递 / 引用传递 / COW 反思 全面验证
// 对照《智语言编程规范》2.3.7「所有类型变量赋值是值复制」
// 以及用户赋值规则表（结构体/数组/接口三类）。
//
// 核心问题：
//   1) 结构体变量赋值是否深度独立？（值复制，非共享）
//   2) 结构体传值参数是否独立？
//   3) 数组赋值是否深度独立（含嵌套数组）？
//   4) 接口是否引用语义（共享同一实例）？
//   5) 文本是否不可变共享安全？
//   6) 结构体含数组字段时，赋值后修改副本嵌套元素是否隔离？
// 全部双模验证。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 箱子(整数 编号):
    整数 编号 = 编号
    标签 = "空"
    内容 = [0, 0]
    修改标签(文本 新标签):
        自身.标签 = 新标签
    结束
    修改内容(整数 位置, 整数 值):
        自身.内容[位置] = 值
    结束
结束

// 传值参数：函数内修改副本不应影响原实例
修改箱子(箱子 目标, 整数 新编号):
    目标.编号 = 新编号
    目标.修改标签("已改")
    目标.修改内容(1, 999)
结束

// 传引用参数：函数内修改应影响原实例
修改箱子引用(传引用 箱子 目标, 整数 新编号):
    目标.编号 = 新编号
    目标.修改标签("引用改")
    目标.修改内容(2, 777)
结束

// ── 接口：引用语义
接口 可计数:
    递增():
    结束
    读数() 整数:
    结束
结束

结构体 计数器 适配 可计数:
    值 = 0
    递增():
        自身.值 = 自身.值 + 1
    结束
    读数() 整数:
        返回 自身.值
    结束
结束

启动程序():
    输出("===== 1. 结构体变量赋值深度独立（值复制） =====")
    甲 = 箱子(1)
    甲.修改标签("甲标签")
    甲.修改内容(1, 11)
    乙 = 甲                 // 值复制
    乙.编号 = 2
    乙.修改标签("乙标签")
    乙.修改内容(1, 22)
    检查("甲.编号 不受 乙 影响（值复制）", 甲.编号 == 1)
    检查("甲.标签 不受 乙 影响（文本字段独立）", 甲.标签 == "甲标签")
    检查("甲.内容[1] 不受 乙 影响（嵌套数组独立）", 甲.内容[1] == 11)
    检查("乙 已是独立实例", 乙.编号 == 2 且 乙.标签 == "乙标签" 且 乙.内容[1] == 22)

    输出("===== 2. 结构体传值参数独立 =====")
    丙 = 箱子(3)
    丙.修改标签("丙标签")
    丙.修改内容(1, 33)
    修改箱子(丙, 30)
    检查("传值参数不改原实例.编号", 丙.编号 == 3)
    检查("传值参数不改原实例.标签", 丙.标签 == "丙标签")
    检查("传值参数不改原实例.内容[1]", 丙.内容[1] == 33)

    输出("===== 3. 结构体传引用参数共享 =====")
    丁 = 箱子(4)
    修改箱子引用(丁, 40)
    检查("传引用参数改原实例.编号", 丁.编号 == 40)
    检查("传引用参数改原实例.标签", 丁.标签 == "引用改")
    检查("传引用参数改原实例.内容[2]", 丁.内容[2] == 777)

    输出("===== 4. 数组赋值深度独立 =====")
    列甲 = [1, 2, 3]
    列乙 = 列甲             // 值复制
    列乙[1] = 20
    检查("数组赋值是值复制（修改副本不影响原）", 列甲[1] == 1)
    检查("副本独立", 列乙[1] == 20)

    输出("===== 5. 接口引用语义（共享同一实例） =====")
    实例 = 计数器()
    实例.递增()
    实例.递增()
    可计数 引用一 = 实例
    可计数 引用二 = 引用一      // 复制标签，同一实例
    引用二.递增()
    检查("接口变量修改作用于原实例", 实例.读数() == 3)
    检查("接口标签互赋共享同一实例", 引用一.读数() == 3)
    检查("引用二 读同一实例", 引用二.读数() == 3)

    输出("===== 6. 接口数组：值复制+写回槽位 =====")
    计数器一 = 计数器()
    计数器二 = 计数器()
    计数器一.递增()
    数组<可计数> 计数列表 = [计数器一, 计数器二]
    // 接口数组元素取出是句柄引用（写回有效），与 20 文件 E 段一致。
    计数列表[1].递增()
    计数列表[1].递增()
    // 已知边界缺口（GAP）：容器持有接口实例时，存入是值拷贝（不同实例），
    // 数组内元素就地修改不写回外部原变量（与 20 文件 E 段一致）。
    检查("接口数组元素就地修改作用于数组副本: 计数列表[1]读数=3", 计数列表[1].读数() == 3)
    检查("原实例counter一不被接口数组修改(保持=1)", 计数器一.读数() == 1)
    检查("原实例计数器二独立", 计数器二.读数() == 0)

    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("❌ 存在失败用例")
    否则:
        输出("✅ 全部通过")
    结束
结束
