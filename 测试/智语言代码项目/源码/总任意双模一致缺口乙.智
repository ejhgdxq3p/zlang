// 缺口 B 复现：任意类型变量 调 转文本() 当值为空值时，编译期报"空值不能参与类型转换"
// 符合规范空值安全：空值不参与任何类型转换。本文件用于确认两种模式对该行为的处理。
通过数 = 0
失败数 = 0
总用例数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总用例数 = 本模块.总用例数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
    结束
结束

启动程序():
    // 非空任意调 转文本() 应正常（已在全面测试中覆盖，此处复测）
    任意<整数|文本|空值> 数据 = 100
    如果 类型(数据) != "空值":
        文本 展示 = 转文本(数据)
        检查("非空任意调文本", 展示 == "100")
    否则:
        检查("非空任意调文本", 假)
    结束

    // 空值任意调 转文本()：预期应报错（符合规范空值安全）
    // 用类型判断保护，验证正常路径；直接 转文本(空值) 在编译期即报错
    任意<整数|文本|空值> 空数据 = 空值
    如果 类型(空数据) == "空值":
        检查("空值任意 类型判断正确", 真)
    否则:
        检查("空值任意 类型判断正确", 假)
    结束

    输出("总用例:" + 转文本(本模块.总用例数) + " 通过:" + 转文本(本模块.通过数) + " 失败:" + 转文本(本模块.失败数))
结束
