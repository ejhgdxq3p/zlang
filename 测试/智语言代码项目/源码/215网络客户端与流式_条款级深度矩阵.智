// 215 网络客户端与流式**条款级深度矩阵**：规范 §5.3.3（客户端四函数 + 网络响应 7 方法 + 流式响应 4 方法）
//
// 分工：213 覆盖 TCP/UDP/HTTP 服务端与读取语义；本用例专攻**客户端**条款：
//   · §5.3.3 `网络.发送` 数据为**映射 ⇒ 自动转 JSON**（文本 ⇒ 原始请求体）
//   · §5.3.3 `网络.请求` 自定义方法（PUT / DELETE / GET）
//   · §5.3.3 `网络响应.会话凭证(名称)` 不存在 ⇒ **空值**；`所有会话凭证()` ⇒ 映射
//   · §5.3.3 `网络响应.添加头` ⇒ 中间件式追加响应头（客户端可见）
//   · §5.3.3 `流式获取` + `流式响应.读取/状态码/响应头/关闭`（读到数据结束返回空字符串）
//   · §5.3.5 选项 `会话凭证`（请求携带 Cookie）、`最大重定向次数`
//
// 全部 127.0.0.1 本地回环；连接前 `等待就绪()` 吸收编译模式监听就绪时序。
导入 网络
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

等待就绪():
    时间.休眠(1500)
结束

// ───────── 服务端处理器 ─────────
处理客户端请求(网络请求 请求) 网络响应:
    路径 = 请求.路径()
    如果 路径 == "/文本":
        返回 网络.响应成功("响应体甲乙")
    否则如果 路径 == "/映射回显":
        返回 网络.响应成功(请求.内容())
    否则如果 路径 == "/方法回显":
        返回 网络.响应成功("方法=" + 请求.方法())
    否则如果 路径 == "/凭证":
        响应 = 网络.响应成功("凭证页")
        响应.添加头("set-cookie", "a=1")
        返回 响应
    否则如果 路径 == "/追加头":
        响应二 = 网络.响应成功("带头")
        响应二.添加头("x-extra", "extra-value")
        返回 响应二
    否则如果 路径 == "/曲奇回显":
        头 = 请求.请求头()
        曲奇 = 头.获取("cookie")
        如果 曲奇 != 空值:
            返回 网络.响应成功("曲奇=" + 曲奇)
        否则:
            返回 网络.响应成功("曲奇=无")
        结束
    否则如果 路径 == "/大文本":
        片段 = "0123456789"
        正文 = ""
        循环 序 = 1, 序 <= 60, 序 += 1:
            正文 = 正文 + 片段
        结束
        返回 网络.响应成功(正文)
    否则如果 路径 == "/跳一":
        返回 网络.响应重定向("/跳二")
    否则如果 路径 == "/跳二":
        返回 网络.响应成功("二段落地")
    否则如果 路径 == "/状态201":
        返回 网络.响应创建(201, "创建了")
    否则:
        返回 网络.响应未找到()
    结束
结束

启动程序():
    输出("=== 215 网络客户端与流式 条款级深度矩阵 ===")
    端口 = 19151
    服务 = 网络.启动服务(端口, 处理客户端请求, {})
    等待就绪()
    基址 = "http://127.0.0.1:" + 转文本(端口)

    // ───────── ① 网络.获取 ─────────
    输出("-- ① §5.3.3 网络.获取 --")
    响应文本 = 网络.获取(基址 + "/文本", {"超时": 5000})
    检查("获取 状态码 200", 响应文本.状态码() == 200)
    检查("获取 内容 = 响应体甲乙", 响应文本.内容() == "响应体甲乙")
    检查("获取 是否成功 = 真", 响应文本.是否成功() == 真)
    检查("获取 响应头 是映射", 类型(响应文本.响应头()) == "映射")

    // ───────── ② 网络.发送：文本 vs 映射 ─────────
    输出("-- ② §5.3.3 网络.发送（文本 / 映射自动转 JSON）--")
    响应原文 = 网络.发送(基址 + "/映射回显", "原始文本体", {"超时": 5000})
    检查("发送 文本 ⇒ 服务端收到的内容（原样）", 响应原文.内容() == "原始文本体")

    响应映射 = 网络.发送(基址 + "/映射回显", {"姓名": "张三", "年龄": 25}, {"超时": 5000})
    回显文本 = 响应映射.内容()
    // 不打印 JSON 原文：映射键序不保证稳定，会破坏双模 stdout 逐字节一致性判据
    检查("发送 映射 ⇒ 自动转 JSON（含键 姓名）", 回显文本.是否包含("姓名"))
    检查("发送 映射 ⇒ JSON 含值 张三", 回显文本.是否包含("张三"))
    检查("发送 映射 ⇒ 形如 JSON 对象（首字符花括号）", 回显文本.长度() > 0 且 回显文本.查找("{") == 1)

    // ───────── ③ 网络.请求：自定义方法 ─────────
    输出("-- ③ §5.3.3 网络.请求 自定义方法 --")
    响应更新 = 网络.请求("PUT", 基址 + "/方法回显", "更新体", {"超时": 5000})
    检查("请求 PUT ⇒ 服务端方法 = PUT", 响应更新.内容() == "方法=PUT")
    响应删除 = 网络.请求("DELETE", 基址 + "/方法回显", "", {"超时": 5000})
    检查("请求 DELETE ⇒ 服务端方法 = DELETE", 响应删除.内容() == "方法=DELETE")
    响应读取 = 网络.请求("GET", 基址 + "/方法回显", "", {"超时": 5000})
    检查("请求 GET ⇒ 服务端方法 = GET", 响应读取.内容() == "方法=GET")

    // ───────── ④ 网络响应 会话凭证 ─────────
    输出("-- ④ §5.3.3 网络响应 会话凭证 --")
    响应凭证 = 网络.获取(基址 + "/凭证", {"超时": 5000})
    凭证头 = 响应凭证.响应头()
    检查("服务端追加的 set-cookie 头 客户端可见", 凭证头.是否包含("set-cookie"))
    凭证值 = 响应凭证.会话凭证("a")
    记录("会话凭证(a) 的类型", 类型(凭证值))
    记录("会话凭证(a) 的值", 转文本(凭证值))
    检查("不存在的凭证名 ⇒ 空值（规范明文）", 响应凭证.会话凭证("没有这个凭证") == 空值)
    所有凭证 = 响应凭证.所有会话凭证()
    检查("所有会话凭证 类型 = 映射", 类型(所有凭证) == "映射")
    记录("所有会话凭证 条目数", 转文本(所有凭证.长度()))

    // ───────── ⑤ 网络响应.添加头 ─────────
    输出("-- ⑤ §5.3.3 网络响应.添加头（中间件）--")
    响应追加 = 网络.获取(基址 + "/追加头", {"超时": 5000})
    检查("添加头 的自定义头 客户端可见", 响应追加.响应头().是否包含("x-extra"))

    // ───────── ⑥ §5.3.5 会话凭证 选项（请求携带 Cookie）─────────
    输出("-- ⑥ §5.3.5 选项 会话凭证 --")
    响应曲奇 = 网络.获取(基址 + "/曲奇回显", {"超时": 5000, "会话凭证": {"a": "1"}})
    曲奇文本 = 响应曲奇.内容()
    记录("服务端看到的 Cookie 头", 曲奇文本)
    检查("会话凭证选项 ⇒ 请求携带 a=1", 曲奇文本.是否包含("a=1"))

    // ───────── ⑦ §5.3.5 跟随重定向 / 最大重定向次数 ─────────
    输出("-- ⑦ §5.3.5 重定向控制 --")
    响应链不跟随 = 网络.获取(基址 + "/跳一", {"超时": 5000, "跟随重定向": 假})
    检查("不跟随 ⇒ 状态码 302", 响应链不跟随.状态码() == 302)
    响应链跟随 = 网络.获取(基址 + "/跳一", {"超时": 5000, "跟随重定向": 真})
    检查("跟随 ⇒ 落地 200 且内容 = 二段落地", 响应链跟随.状态码() == 200 且 响应链跟随.内容() == "二段落地")
    链限结果 = ""
    捕获:
        响应链限 = 网络.获取(基址 + "/跳一", {"超时": 5000, "跟随重定向": 真, "最大重定向次数": 0})
        链限结果 = "状态码=" + 转文本(响应链限.状态码())
    异常:
        链限结果 = "抛异常"
    结束
    记录("最大重定向次数=0 时的行为（规范未细定）", 链限结果)

    // ───────── ⑧ 流式获取 / 流式响应 ─────────
    输出("-- ⑧ §5.3.3 流式获取 / 流式响应 --")
    流 = 网络.流式获取(基址 + "/大文本", {"超时": 10000})
    检查("流式 状态码 = 200", 流.状态码() == 200)
    检查("流式 响应头 类型=映射", 类型(流.响应头()) == "映射")
    已收 = ""
    块数 = 0
    循环 真:
        块 = 流.读取(100)
        如果 块 == "":
            跳出
        结束
        已收 = 已收 + 块
        块数 = 块数 + 1
        如果 块数 > 100:
            跳出
        结束
    结束
    检查("流式分块读取 累计 600 字节", 已收.长度() == 600)
    检查("流式分块读取 内容首尾正确", 已收.是否包含("0123456789") 且 已收.长度() == 600)
    检查("流式读取 至少读到 1 块", 块数 >= 1)
    关闭可调用 = 真
    捕获:
        流.关闭()
    异常:
        关闭可调用 = 假
    结束
    检查("流式 关闭 可调用", 关闭可调用 == 真)

    // ───────── ⑨ 状态码 201 / 404 边界 ─────────
    输出("-- ⑨ 状态码边界 --")
    响应创建201 = 网络.获取(基址 + "/状态201", {"超时": 5000})
    检查("201 状态码 = 201", 响应创建201.状态码() == 201)
    检查("201 是否成功 = 真（200-299）", 响应创建201.是否成功() == 真)
    响应缺失404 = 网络.获取(基址 + "/没有的路径", {"超时": 5000})
    检查("404 状态码 = 404", 响应缺失404.状态码() == 404)
    检查("404 是否成功 = 假", 响应缺失404.是否成功() == 假)

    服务.关闭()
    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
