// 覆盖《智语言编程规范》§2.3.5「模块级成员访问」：**`本模块.<容器>.<变更方法>(...)` 必须写回模块槽位**
// 背景（2026-10-12 缺陷修复）：此前 `本模块.` 前缀在语义层被剥成裸名 ⇒ 模块变量**按值取出副本**，
//   容器变更方法（`.插入/.删除/.清空/.追加/.排序/.反转`）在副本上生效并把新句柄作为**返回值**返回，
//   而语句位置丢弃返回值 ⇒ **静默空操作**（实测 `本模块.地.插入("甲",1)` 后 长度 仍为 0；
//   数组侧因未走 COW 而"碰巧"可用，同样不可靠）。
//   修法：识别「接收者语法形态为 `本模块.X` 且方法属于容器变更方法」⇒ 改写为 `X = 调用(...)`（写回）。
// 本用例同时钉住：数组侧（追加/排序/反转）、结构体方法内、条件/循环块内、以及**局部容器不受影响**。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

// ── 模块级容器（被 `本模块.` 访问）──
计分表 = {}
序列 = [3, 1, 2]
嵌套表 = {"内": {"甲": 1}}

加一项():
    本模块.计分表.插入("函数键", 9)
结束

结构体 助手():
    加一项():
        本模块.计分表.插入("方法键", 7)
    结束
结束

启动程序():
    输出("=== 271 模块级容器写回（§2.3.5 本模块.）===")

    // ── 映射：插入 / 删除 / 清空（此前全部静默失效）──
    本模块.计分表.插入("甲", 1)
    检查("模块映射 插入生效（长度=1）", 本模块.计分表.长度() == 1)
    本模块.计分表.插入("乙", 2)
    检查("模块映射 再插入（长度=2）", 本模块.计分表.长度() == 2)
    检查("模块映射 取回值正确", 本模块.计分表.获取("乙") == 2)

    // ── 函数体内写回 ──
    加一项()
    检查("函数内 `本模块.映射.插入` 写回（长度=3）", 本模块.计分表.长度() == 3)
    检查("函数内写入的值可查回", 本模块.计分表.获取("函数键") == 9)

    // ── 结构体方法内写回 ──
    甲 = 助手()
    甲.加一项()
    检查("结构体方法内 `本模块.映射.插入` 写回（长度=4）", 本模块.计分表.长度() == 4)

    // ── 条件块内写回 ──
    如果 真:
        本模块.计分表.插入("条件键", 5)
    结束
    检查("条件块内写回（长度=5）", 本模块.计分表.长度() == 5)

    // ── 循环块内写回 ──
    索引 = 0
    循环 索引 < 3:
        本模块.计分表.插入("循环" + 转文本(索引), 索引)
        索引 += 1
    结束
    检查("循环块内写回（长度=8）", 本模块.计分表.长度() == 8)

    // ── 删除 / 清空 ──
    本模块.计分表.删除("甲")
    检查("模块映射 删除生效（长度=7）", 本模块.计分表.长度() == 7)
    本模块.计分表.清空()
    检查("模块映射 清空生效（长度=0）", 本模块.计分表.长度() == 0)

    // ── 数组侧：追加 / 排序 / 反转（对照，此前即可用，不得回归）──
    本模块.序列.追加(0)
    检查("模块数组 追加生效（长度=4）", 本模块.序列.长度() == 4)
    本模块.序列.排序()
    检查("模块数组 排序生效（首元素=0）", 本模块.序列[1] == 0)
    本模块.序列.反转()
    检查("模块数组 反转生效（首元素=3）", 本模块.序列[1] == 3)

    // ── 多级路径读（不受影响）──
    检查("模块映射 多级路径读不变", 本模块.嵌套表.获取("内").获取("甲") == 1)

    // ── 局部容器不受影响（对照）──
    局部 = {}
    局部.插入("甲", 1)
    检查("局部容器 `地.插入` 仍正常（长度=1）", 局部.长度() == 1)

    收尾()
结束
