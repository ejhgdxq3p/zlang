// 正向回归（2026-09-21）：**值语义深拷贝必须「按成员身份」**。
//
//   规范依据（§4772 / §4834）：接口 = **复制标签** —— 标签贴在**同一个实例**上，经标签修改作用于原实例。
//   ⇒ 值语义深拷贝遇到 **接口 / `任意<接口>` 成员**时，**只复制标签，绝不克隆被指对象**。
//
//   缺陷背景（已修复）：`base::堆_深拷贝` 是**通用递归克隆**——它只看句柄，看不见"这个句柄是标签还是值"
//     ⇒ `乙 = 甲`（甲含 `可移动 设备` 字段）会把接口指向的单车实例**一起克隆**
//     ⇒ `乙.设备.移动(70)` 改的是克隆体，`甲.设备` 仍为 10（应为 70）。解释 / 编译**双模一致地错**。
//
//   修复：值语义深拷贝改走**类型感知**路径 —— 只有"确实含引用语义成员"的复合类型才逐成员展开
//     （接口成员复制标签 + 值成员递归拷贝），其余仍走通用 `深度复制` ⇒ 行为与既往一致、回归面最小。
//   覆盖：① 结构体整体复制 ② 接口字段整体重新赋值（值语义仍隔离）③ 按值传参 ④ 嵌套结构体成员。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

接口 可移动:
    移动(整数 新速度):
    结束
    取速度() 整数:
    结束
结束

结构体 单车(整数 初始速度) 适配 可移动:
    整数 速度 = 初始速度
    移动(整数 新速度):
        自身.速度 = 新速度
    结束
    取速度() 整数:
        返回 自身.速度
    结束
结束

结构体 容器():
    可移动 设备 = 单车(0)
结束

结构体 外层():
    容器 内 = 容器()
结束

改容器(容器 数据):
    数据.设备.移动(60)
结束

启动程序():
    // ① 结构体整体复制后，经接口字段写入 ⇒ 原实例同步（标签共享）
    甲 = 容器()
    甲.设备.移动(10)
    乙 = 甲
    检查("复制后-甲.设备", 甲.设备.取速度() == 10)
    检查("复制后-乙.设备", 乙.设备.取速度() == 10)

    乙.设备.移动(70)
    检查("经乙.设备写-甲.设备同步（标签共享）", 甲.设备.取速度() == 70)
    检查("经乙.设备写-乙.设备", 乙.设备.取速度() == 70)

    // ② 接口字段整体重新赋值 ⇒ 只改乙自己的标签，甲不受影响（值语义隔离仍成立）
    乙.设备 = 单车(0)
    检查("接口字段重赋值-甲不受影响", 甲.设备.取速度() == 70)
    检查("接口字段重赋值-乙新实例", 乙.设备.取速度() == 0)

    // ③ 按值传参：函数内改接口字段 ⇒ 作用于原实例（传值拷贝同样须"按成员身份"）
    丙 = 容器()
    丙.设备.移动(30)
    改容器(丙)
    检查("传值实参-函数内改接口字段作用于原实例", 丙.设备.取速度() == 60)

    // ④ 嵌套结构体成员（递归按成员身份）
    丁 = 外层()
    丁.内.设备.移动(20)
    戊 = 丁
    戊.内.设备.移动(80)
    检查("嵌套成员-原结构体同步", 丁.内.设备.取速度() == 80)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
