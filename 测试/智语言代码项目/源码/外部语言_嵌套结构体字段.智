// ══════════════════════════════════════════════════════════════════════════
// 【规范 §6.5.6 守护夹具 —— 外部块内结构体：嵌套结构体字段】
//   规范 §6.5.6 规则②：「已声明的外部结构体类型（嵌套结构体字段，禁止自引用与环状嵌套）」
//   规范 §6.5.6 示例形态：`结构体 点():` / `长小数 x = 0.0`（**类型在前 + 显式默认值**）/ `结束`
//   依赖：外部语言/嵌套结构库（C 库；C 结构体 Line{Point start,end; long long count}）
//   本用例聚焦「返回方向往返」：C 按值返回含嵌套字段的结构体，验证 shim 序列化编组正确。
//   （数组<标量外部类型> 字段、以及「把结构体作为参数传回 C」的 reconstruct 为后续增量。）
//   双模验证：
//     智语言开发套件.exe 运行       --直接执行 .\外部FFI_嵌套结构体字段.智  （解释）
//     智语言开发套件.exe 构建运行   --重新编译 .\外部FFI_嵌套结构体字段.智  （编译）
//   要点：① 不用 `智语言` 修饰符（扁平约定逃生舱）；默认即真实 C ABI，走 shim 编组。
//         ② 声明层只用外部类型名：`长整数` = 码4 = i64 = C long long（与 C 库 long long 一致）。
//         ③ 字段「类型在前」：`长整数 横坐标 = 0` / `点 起点`。
// ══════════════════════════════════════════════════════════════════════════
外部:
    导入 嵌套结构库

    生成线 关联 make_line

    结构体 点():
        长整数 横坐标 = 0
        长整数 纵坐标 = 0
    结束

    结构体 线():
        点 起点
        点 终点
        长整数 计数 = 0
    结束

    生成线(长整数 横一, 长整数 纵一, 长整数 横二, 长整数 纵二, 长整数 计数) 线:
    结束
结束

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 外部块内结构体：嵌套结构体字段 FFI（返回方向往返）=====")

    线甲 = 生成线(0, 0, 3, 4, 2)
    检查("嵌套字段 起点.横坐标 = 0", 线甲.起点.横坐标 == 0)
    检查("嵌套字段 起点.纵坐标 = 0", 线甲.起点.纵坐标 == 0)
    检查("嵌套字段 终点.横坐标 = 3", 线甲.终点.横坐标 == 3)
    检查("嵌套字段 终点.纵坐标 = 4", 线甲.终点.纵坐标 == 4)
    检查("标量字段 计数 = 2", 线甲.计数 == 2)

    横差 = 线甲.终点.横坐标 - 线甲.起点.横坐标
    纵差 = 线甲.终点.纵坐标 - 线甲.起点.纵坐标
    检查("线长平方 = 25", 横差 * 横差 + 纵差 * 纵差 == 25)

    输出("结果：通过 " + 转文本(本模块.通过数) + " / 总数 " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
