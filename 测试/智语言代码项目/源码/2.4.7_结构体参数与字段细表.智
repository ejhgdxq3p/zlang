测试_细表():
    甲 = 矩形(3.0, 4.0)
    检查("字段默认值引用结构体参数", 甲.取宽度() == 3.0)
    检查("结构体常量可访问", 甲.取边数() == 4)
    甲.缩放(9.0)
    检查("方法参数与结构体参数同名 ⇒ 参数优先", 甲.取宽度() == 9.0)
    检查("结构体参数在该方法内不被改写", 甲.取参数宽() == 3.0)
    乙 = 点()
    乙.点 = 7
    检查("结构体名与字段同名", 乙.取点() == 7)
结束

