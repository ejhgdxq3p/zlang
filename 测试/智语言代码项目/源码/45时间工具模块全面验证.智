启动程序():
    输出("===== 时间模块 全面验证 =====")
    现在 = 时间.当前时间()
    检查("当前时间() > 0", 现在 > 0)

    毫秒 = 时间.当前毫秒时间()
    检查("当前毫秒时间() >= 当前时间()*1000", 毫秒 >= 现在 * 1000)
    检查("当前毫秒时间() < (当前时间()+1)*1000", 毫秒 < (现在 + 1) * 1000)

    格式串 = 时间.格式化("年-月-日 时:分:秒", 现在)
    检查("格式化() 非空", 格式串.长度() > 0)
    解析值 = 时间.解析(格式串, "年-月-日 时:分:秒")
    检查("格式化->解析 往返一致", 解析值 == 现在)

    固定 = 0
    检查("时间0 获取年=1970", 时间.获取年(固定) == 1970)
    检查("时间0 获取月=1", 时间.获取月(固定) == 1)
    检查("时间0 获取日=1", 时间.获取日(固定) == 1)
    检查("时间0 获取时=0", 时间.获取时(固定) == 0)
    检查("时间0 获取分=0", 时间.获取分(固定) == 0)
    检查("时间0 获取秒=0", 时间.获取秒(固定) == 0)
    检查("时间0 格式化(年)=1970", 时间.格式化("年", 固定) == "1970")
    检查("时间0 格式化(月)=01", 时间.格式化("月", 固定) == "01")
    检查("时间0 格式化(日)=01", 时间.格式化("日", 固定) == "01")
    检查("时间0 格式化(年-月-日)=1970-01-01", 时间.格式化("年-月-日", 固定) == "1970-01-01")

    年 = 时间.获取年(现在)
    月 = 时间.获取月(现在)
    日 = 时间.获取日(现在)
    时 = 时间.获取时(现在)
    分 = 时间.获取分(现在)
    秒 = 时间.获取秒(现在)
    星期 = 时间.获取星期(现在)
    检查("获取年 范围[1970,2100]", 年 >= 1970 且 年 <= 2100)
    检查("获取月 范围[1,12]", 月 >= 1 且 月 <= 12)
    检查("获取日 范围[1,31]", 日 >= 1 且 日 <= 31)
    检查("获取时 范围[0,23]", 时 >= 0 且 时 <= 23)
    检查("获取分 范围[0,59]", 分 >= 0 且 分 <= 59)
    检查("获取秒 范围[0,59]", 秒 >= 0 且 秒 <= 59)
    检查("获取星期 范围[1,7]", 星期 >= 1 且 星期 <= 7)

    加后 = 时间.加(现在, 3600)
    检查("加(现在,3600) == 现在+3600", 加后 == 现在 + 3600)
    减后 = 时间.减(现在, 3600)
    检查("减(现在,3600) == 现在-3600", 减后 == 现在 - 3600)

    间隔1 = 时间.间隔天数(现在, 现在 - 86400)
    检查("间隔天数(现在, 现在-86400) == 1", 间隔1 == 1)
    间隔0 = 时间.间隔天数(现在, 现在)
    检查("间隔天数(现在, 现在) == 0", 间隔0 == 0)

    计时前 = 时间.获取计时器()
    时间.休眠(20)
    计时后 = 时间.获取计时器()
    检查("休眠(20) 实际耗时>=15ms", (计时后 - 计时前) >= 15)

    解析异常 = 假
    捕获:
        临时 = 时间.解析("不是时间", "年-月-日")
    异常:
        解析异常 = 真
    结束
    检查("解析非法格式抛异常", 解析异常)

    输出("===== 工具模块 全面验证 =====")
    数字列表 = 工具.正则匹配("[0-9]+", "订单号12345和67890")
    检查("正则匹配 数量=2", 数字列表.长度() == 2)
    检查("正则匹配[1]=12345", 数字列表[1] == "12345")
    检查("正则匹配[2]=67890", 数字列表[2] == "67890")

    替换结果 = 工具.正则替换("[0-9]+", "#", "abc123def456")
    检查("正则替换 结果=abc#def#", 替换结果 == "abc#def#")

    哈希甲 = 工具.哈希算法("MD5", "hello world")
    检查("哈希 MD5 长度32", 哈希甲.长度() == 32)
    检查("哈希 MD5 精确值", 哈希甲 == "5eb63bbbe01eeed093cb22bb8f5acdc3")
    哈希乙 = 工具.哈希算法("SHA256", "hello world")
    检查("哈希 SHA256 长度64", 哈希乙.长度() == 64)
    检查("哈希 SHA256 精确值", 哈希乙 == "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9")

    原始文本 = "智语言ABC123测试"
    编码文本 = 工具.编码方案("BASE64", 原始文本)
    检查("编码 BASE64 非空", 编码文本.长度() > 0)
    还原文本 = 工具.解码方案("BASE64", 编码文本)
    检查("解码 BASE64 还原一致", 还原文本 == 原始文本)

    数据文本 = "{" + "\引号" + "name" + "\引号" + ":" + "\引号" + "zhangsan" + "\引号" + "," + "\引号" + "age" + "\引号" + ":25}"
    映射结果 = 工具.解析数据("JSON", 数据文本)
    检查("解析JSON name=zhangsan", 转文本(映射结果.获取("name")) == "zhangsan")
    检查("解析JSON age=25", 转整数(映射结果.获取("age")) == 25)

    数组数据 = "[1, 2, 3]"
    数组结果 = 工具.解析数据("JSON", 数组数据)
    检查("解析JSON数组 长度=3", 数组结果.长度() == 3)
    检查("解析JSON数组[1]=1", 数组结果[1] == 1)
    检查("解析JSON数组[2]=2", 数组结果[2] == 2)

    数据映射 = {"姓名": "张三", "年龄": 25}
    生成文本 = 工具.生成数据("JSON", 数据映射)
    检查("生成JSON 含姓名", 生成文本.是否包含("张三"))
    检查("生成JSON 含年龄", 生成文本.是否包含("25"))

    编号甲 = 工具.唯一编号()
    编号乙 = 工具.唯一编号()
    检查("唯一编号 非空", 编号甲.长度() > 0)
    检查("唯一编号 两次不同", 编号甲 != 编号乙)

    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.总数 - 本模块.通过数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
