// 文件: 聚合导入_全成员_别名形式.智
// 职责: 验证【别名形式聚合】导入后，经别名前缀 库 访问全部成员类型。

导入 聚合子模块/聚合_别名 展开

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 聚合导入 别名形式（别名前缀）全成员访问 =====")

    // 函数（别名前缀）
    检查("函数别名: 库.求平方(5)=25", 库.求平方(5) == 25)

    // 变量（别名前缀）
    检查("变量别名: 库.公开变量=100", 库.公开变量 == 100)

    // 常量（别名前缀）
    检查("常量别名: 库.公开常量=3.14159", 库.公开常量 == 3.14159)

    // 枚举（别名前缀）
    检查("枚举别名: 库.颜色.红!=绿", 库.颜色.红 != 库.颜色.绿)

    // 结构体（别名前缀，字段 + 方法）
    库.矩形 矩形实例 = 库.矩形(3, 4)
    检查("结构体别名: 字段 宽=3", 矩形实例.宽 == 3)
    检查("结构体别名: 方法 面积()=12", 矩形实例.面积() == 12)

    // 接口方法（别名前缀）
    库.圆形 圆实例 = 库.圆形(3)
    检查("接口方法别名: 圆形.描述()", 圆实例.描述() == "圆形半径=3")

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
