// 272 全局函数：**`输入()` 与 `错误输出()` 的流语义**（2026-10-22）
//
// 为什么单独一个文件：
//   §4.1 的 8 个全局函数里，`转文本/转整数/转小数/类型/异常错误` 已由 271 覆盖；
//   `输出/错误输出/输入` 是**流**函数，必须由外部驱动才能验证（stdin 喂入、stdout/stderr 分流）。
//   ⇒ 本文件**不能**进普通门禁（无 stdin 时 `输入()` 只能读到空串），由 `测试/3测试脚本/验全局函数流.py` 驱动。
//
// 断言来源（先探针实测）：
//   · `错误输出` 写入 **stderr**（解释模式与编译模式都如此；编译模式下曾因 `构建运行` 只在失败时
//     转发 stderr 而**凭空消失** ⇒ 已修 F50，本文件是护栏）；
//   · `输入()` 逐行读取，**空行不算结束**（返回空串并继续）；
//   · **EOF 后返回空串**（`类型` 仍为 文本），且再次调用立即返回（不挂死）—— 规范未定义 EOF 行为，此处锁定实测口径。
//
// 驱动约定：stdin 必须恰好是「甲行\n乙行\n\n丙行\n」四行（第三行为空行）。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 272 输入 / 错误输出 流语义 ===")

    // `错误输出` 的两个标记：驱动脚本断言它们**只**出现在 stderr，不出现在 stdout
    错误输出("标准错误标记-甲")
    输出("引擎标记-输出")

    行一 = 输入()
    如果 行一 == "":
        // ⚠ 未喂入 stdin（例如被全量门禁扫到）：只验"不挂死"，逐行读取断言交由驱动脚本验证。
        //   判据：驱动约定第一行是「甲行」，非空 ⇒ 以此区分"没数据"与"数据恰好是空行"。
        输出("  （未喂入 stdin ⇒ 跳过逐行读取断言；完整验证用 测试/3测试脚本/验全局函数流.py）")
        检查("无 stdin 时 `输入()` 立即返回空串（不挂死）", 行一.长度() == 0)
    否则:
        检查("输入 第 1 行 = 甲行", 行一 == "甲行")
        行二 = 输入()
        检查("输入 第 2 行 = 乙行", 行二 == "乙行")
        行三 = 输入()
        检查("输入 空行 ⇒ 返回空串（不当作结束）", 行三 == "")
        检查("空行长度 = 0", 行三.长度() == 0)
        行四 = 输入()
        检查("空行之后仍能继续读到 丙行", 行四 == "丙行")
        行五 = 输入()
        检查("EOF 后 类型仍为 文本", 类型(行五) == "文本")
        检查("EOF 后 返回空串（长度 0）", 行五.长度() == 0)
        检查("EOF 后 再次调用仍立即返回（不挂死）", 输入().长度() == 0)
        记录("输入() 的返回类型", 类型(行一))
    结束

    错误输出("标准错误标记-乙")
    收尾()
结束
