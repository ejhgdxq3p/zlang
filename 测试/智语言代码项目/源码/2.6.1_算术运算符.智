测试_全部():
    甲 = 10
    乙 = 3
    检查("加法", 甲 + 乙 == 13)
    检查("减法", 甲 - 乙 == 7)
    检查("乘法", 甲 * 乙 == 30)
    检查("整数相除返回小数", 甲 / 乙 > 3.333 且 甲 / 乙 < 3.334)
    检查("整数除整数得小数(10/4)", 10 / 4 == 2.5)
    检查("整除10%%3", 甲 %% 乙 == 3)
    检查("整除25%%10", 25 %% 10 == 2)
    检查("取余10%3", 甲 % 乙 == 1)
    检查("取余-11%3=1(非负余数)", -11 % 3 == 1)
    检查("整除-11%%3=-4(向下取整)", -11 %% 3 == -4)
    检查("恒等式-11=3*(-11%%3)+(-11%3)", 3 * (-11 %% 3) + (-11 % 3) == -11)
    检查("幂10^3", 甲 ^ 乙 == 1000)
    检查("幂2^10", 2 ^ 10 == 1024)
    检查("幂5^2", 5 ^ 2 == 25)
    检查("幂3^3", 3 ^ 3 == 27)
    检查("一元取负", -甲 == -10)
    检查("取负优先级高于乘(2*-3)", 2 * -3 == -6)
    检查("复杂表达式", (甲 + 乙) * 2 - 5 == 21)
    检查("总页数25%%10", 25 %% 10 == 2)
    检查("最后一页25%10", 25 % 10 == 5)

    计数 = 0
