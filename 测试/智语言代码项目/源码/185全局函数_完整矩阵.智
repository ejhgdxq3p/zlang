// 全局函数 8 项完整矩阵：转整数/转小数/转文本/类型 的类型交叉 + 非法输入 + 错误输出
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

结构体 点(整数 横, 整数 纵):
结束

开机():
    输出("=== 185 全局函数完整矩阵 ===")
    // ① 转文本 × 各类型
    检查("转文本-整数", 转文本(42) == "42")
    检查("转文本-负整数", 转文本(-7) == "-7")
    检查("转文本-零", 转文本(0) == "0")
    检查("转文本-小数", 转文本(3.5) == "3.5")
    检查("转文本-真", 转文本(真) == "真")
    检查("转文本-假", 转文本(假) == "假")
    检查("转文本-空文本", 转文本("") == "")
    检查("转文本-数组", 转文本([1, 2]).长度() > 0)
    记录("转文本([1, 2])", 转文本([1, 2]))
    记录("转文本(映射含甲键)", 转文本({"甲": 1}))
    // ② 类型() × 各类型
    检查("类型-整数", 类型(1) == "整数")
    检查("类型-小数", 类型(1.5) == "小数")
    检查("类型-逻辑", 类型(真) == "逻辑")
    检查("类型-文本", 类型("甲") == "文本")
    检查("类型-数组", 类型([1]) == "数组")
    检查("类型-映射", 类型({"甲": 1}) == "映射")
    检查("类型-结构体", 类型(点(1, 2)) == "点")
    // ③ 转整数
    检查("转整数-恒等", 转整数(42) == 42)
    检查("转整数-小数向零取整(正)", 转整数(3.7) == 3)
    检查("转整数-小数向零取整(负)", 转整数(-3.7) == -3)
    检查("转整数-文本", 转整数("123") == 123)
    检查("转整数-负文本", 转整数("-42") == -42)
    捕获:
        转整数("甲乙")
        检查("转整数-非法应抛异常", 假)
    异常:
        检查("转整数-非法抛异常且描述非空", 异常错误().描述.长度() > 0)
    结束
    // ④ 转小数
    检查("转小数-整数提升", 转小数(42) == 42.0)
    检查("转小数-恒等", 转小数(3.25) == 3.25)
    检查("转小数-文本", 转小数("2.5") == 2.5)
    检查("转小数-负文本", 转小数("-0.5") == -0.5)
    捕获:
        转小数("甲乙")
        检查("转小数-非法应抛异常", 假)
    异常:
        检查("转小数-非法抛异常", 真)
    结束
    // ⑤ 错误输出（写 stderr，不污染 stdout）
    错误输出("185-错误输出通道探针")
    检查("错误输出-不影响 stdout 流程", 真)
    收尾()
结束

启动程序():
    开机()
结束
