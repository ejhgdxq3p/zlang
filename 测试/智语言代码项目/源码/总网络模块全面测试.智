// ---------- 一、TCP 本地回环（系统分配端口，避免冲突） ----------
运行通信测试():
    // 0) 监听(0)：系统自动分配端口，本地端口 必须返回实际绑定端口（与 数据报(0) 一致）
    监听器零 = 网络.监听(0, {})
    检查("TCP 监听(0) 返回实际端口", 监听器零.本地端口() > 0)
    监听器零.关闭()

    // 1) 监听 + 接受 + 连接 + 写入一行/读取一行
    监听器 = 网络.监听(18100, {})
    服务端口 = 监听器.本地端口()
    检查("TCP 监听器本地端口>0", 服务端口 > 0)
    检查("TCP 监听器本地端口==绑定端口", 服务端口 == 18100)

    // 请求-应答模式（确定性）：服务端先阻塞读客户端上行，再回写并关闭，
    // 规避「先写后立即关」模式下后台任务写入异常被吞、连接被析构提前关闭的偶发 EOF 竞态。
    并发.启动任务(函数():
        客户端 = 监听器.接受()
        上行 = 客户端.读取一行()
        客户端.写入一行("你好，服务端(" + 上行 + ")")
        客户端.关闭()
    结束)

    捕获:
        连接 = 网络.连接("127.0.0.1", 服务端口, {})
        // 连接元数据
        检查("TCP 远端端口==监听端口", 连接.远端端口() == 服务端口)
        检查("TCP 远端地址==127.0.0.1", 连接.远端地址() == "127.0.0.1")
        检查("TCP 本地地址==127.0.0.1", 连接.本地地址() == "127.0.0.1")
        检查("TCP 本地端口>0", 连接.本地端口() > 0)
        // 无延迟/超时 设置不抛异常
        连接.设置无延迟(真)
        连接.设置超时(0)
        检查("TCP 设置无延迟/超时 不抛异常", 真)
        // 行读写
        连接.写入一行("来自客户端问候")
        回复 = 连接.读取一行()
        输出("调试 子测试1收到=[" + 回复 + "]")
        检查("TCP 读取一行==服务端回复", 回复 == "你好，服务端(来自客户端问候)")
        连接.关闭()
    异常:
        检查("TCP 行读写未抛异常", 假)
    结束
    监听器.关闭()

    // 2) 读取(字节数) 部分读取 + 读取指定(字节数) 定长读取 + 读取全部()
    监听器2 = 网络.监听(18101, {})
    端口2 = 监听器2.本地端口()
    并发.启动任务(函数():
        对方 = 监听器2.接受()
        对方.写入("HELLOWORLD")      // 10 字节，无换行
        对方.写入一行("第二行")       // 自动换行
        对方.写入("尾巴数据")         // 关闭前再写一段
        对方.关闭()
    结束)
    捕获:
        连接2 = 网络.连接("127.0.0.1", 端口2, {})
        片段甲 = 连接2.读取(5)
        片段乙 = 连接2.读取(5)
        检查("TCP 读取(5) 第一次=HELLO", 片段甲 == "HELLO")
        检查("TCP 读取(5) 第二次=WORLD", 片段乙 == "WORLD")
        行 = 连接2.读取一行()
        检查("TCP 读取一行=第二行", 行 == "第二行")
        定长 = 连接2.读取指定(6)
        检查("TCP 读取指定(6)=尾巴", 定长 == "尾巴")
        全部 = 连接2.读取全部()
        检查("TCP 读取全部=数据", 全部 == "数据")
        连接2.关闭()
    异常:
        检查("TCP 部分/定长/全部读取未抛异常", 假)
    结束
    监听器2.关闭()

    // 3) 关闭写入（半关闭）：客户端写完关闭写端，仍可收服务端回复
    监听器3 = 网络.监听(18102, {})
    端口3 = 监听器3.本地端口()
    并发.启动任务(函数():
        服务端 = 监听器3.接受()
        上行 = 服务端.读取一行()
        检查("TCP 半关闭上行=UPLOAD", 上行 == "UPLOAD")
        服务端.写入一行("ACK")
        服务端.关闭()
    结束)
    捕获:
        客户端3 = 网络.连接("127.0.0.1", 端口3, {})
        客户端3.写入一行("UPLOAD")
        客户端3.关闭写入()
        回执 = 客户端3.读取一行()
        检查("TCP 关闭写入后仍可读=ACK", 回执 == "ACK")
        客户端3.关闭()
    异常:
        检查("TCP 半关闭流程未抛异常", 假)
    结束
    监听器3.关闭()

    // 4) 设置超时：对不发送数据的连接读取应抛异常
    监听器4 = 网络.监听(18103, {})
    端口4 = 监听器4.本地端口()
    并发.启动任务(函数():
        沉默 = 监听器4.接受()
        // 接受后不写不关，故意制造读取超时
    结束)
    捕获:
        超时连接 = 网络.连接("127.0.0.1", 端口4, {})
        超时连接.设置超时(400)
        抛出标志 = 假
        捕获:
            丢弃 = 超时连接.读取(10)
        异常:
            抛出标志 = 真
        结束
        检查("TCP 读取超时抛异常", 抛出标志)
        超时连接.关闭()
    异常:
        检查("TCP 超时配置未抛异常", 假)
    结束
    监听器4.关闭()

    // 5) 负向：连接未监听端口应抛异常
    捕获:
        故障连接 = 网络.连接("127.0.0.1", 1, {})
        检查("TCP 连接拒绝端口不应成功", 假)
    异常:
        检查("TCP 连接拒绝端口抛异常", 真)
    结束
结束

// ---------- 二、UDP 数据报 双向自收发 ----------
运行数据报测试():
    接收端 = 网络.数据报(0)
    接收端口 = 接收端.本地端口()
    检查("UDP 接收端系统分配端口>0", 接收端口 > 0)

    发送端 = 网络.数据报(0)
    发送端口 = 发送端.本地端口()
    检查("UDP 发送端系统分配端口>0", 发送端口 > 0)

    并发.启动任务(函数():
        处理接收(接收端)
    结束)

    // 直接发送 + 接收回执
    发送端.发送("探测消息", "127.0.0.1", 接收端口)
    回复 = 发送端.接收(3000)
    检查("UDP 发送方收到回执", 回复 != 空值)
    如果 回复 != 空值:
        消息 = 回复
        检查("UDP 回执数据==已收到，谢谢！", 消息.数据 == "已收到，谢谢！")
        检查("UDP 回执来源地址==127.0.0.1", 消息.来源地址 == "127.0.0.1")
        检查("UDP 回执来源端口==接收端端口", 消息.来源端口 == 接收端口)
    结束

    // 连接/断开连接 不抛异常
    捕获:
        发送端.连接("127.0.0.1", 接收端口)
        发送端.断开连接()
        检查("UDP 连接/断开连接 不抛异常", 真)
    异常:
        检查("UDP 连接/断开连接 不抛异常", 假)
    结束

    // 启用广播 不抛异常
    捕获:
        发送端.启用广播()
        检查("UDP 启用广播 不抛异常", 真)
    异常:
        检查("UDP 启用广播 不抛异常", 假)
    结束

    // 加入/离开组播组 不抛异常
    捕获:
        发送端.加入组播组("224.0.0.1")
        发送端.离开组播组("224.0.0.1")
        检查("UDP 加入/离开组播组 不抛异常", 真)
    异常:
        检查("UDP 加入/离开组播组 不抛异常", 假)
    结束

    // 超时接收无数据返回空值（无人在该端口回包）
    空等 = 发送端.接收(500)
    检查("UDP 超时无数据返回空值", 空等 == 空值)

    发送端.关闭()
    接收端.关闭()
    检查("UDP 套接字关闭完成", 真)
结束

处理接收(网络数据报 接收套接字):
    结果 = 接收套接字.接收(3000)
    如果 结果 != 空值:
        消息 = 结果
        接收套接字.发送("已收到，谢谢！", 消息.来源地址, 消息.来源端口)
    结束
结束

// ---------- 三、HTTP 服务端 + 客户端 全面 ----------
运行网页测试():
    服务 = 网络.启动服务(18200, 处理网络请求, {})
    服务端口 = 18200

    捕获:
        // 基础 GET
        响应1 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/", {"超时": 5000})
        检查("HTTP GET / 状态码200", 响应1.状态码() == 200)
        检查("HTTP GET / 是否成功", 响应1.是否成功())
        检查("HTTP GET / 含欢迎文本", 响应1.内容().是否包含("欢迎"))

        // 响应头（默认头 + 自定义头，HTTP 头名须为 ASCII，符合 RFC 7230）
        检查("HTTP GET / 响应头为映射", 响应1.响应头() != 空值)
        头1 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/自定义头", {"超时": 5000})
        输出("调试 自定义头响应=" + 转文本(头1.响应头()))
        // 响应头键按 HTTP 约定小写化（ASCII 不区分大小写），故用小写键查询
        检查("HTTP 自定义响应头值正确", 头1.响应头().获取("x-zhilang") == "zhilang-abc")

        // 重定向：不跟随
        响应2 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/重定向", {"超时": 5000, "跟随重定向": 假})
        检查("HTTP /重定向 状态码302", 响应2.状态码() == 302)
        检查("HTTP /重定向 含位置头", 响应2.响应头().是否包含("位置"))
        // 重定向：跟随（默认应跟随）
        响应跟随 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/重定向", {"超时": 5000})
        输出("调试 重定向跟随状态=" + 转文本(响应跟随.状态码()))
        检查("HTTP /重定向 跟随后200", 响应跟随.状态码() == 200)

        // 404
        响应3 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/不存在", {"超时": 5000})
        检查("HTTP /不存在 状态码404", 响应3.状态码() == 404)
        检查("HTTP /不存在 是否成功为假", 响应3.是否成功() == 假)

        // 500 错误响应
        响应异常 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/错误", {"超时": 5000})
        检查("HTTP /错误 状态码500", 响应异常.状态码() == 500)
        检查("HTTP /错误 内容==消息", 响应异常.内容() == "服务器内部错误示例")

        // 201 创建响应
        响应4 = 网络.发送("http://127.0.0.1:" + 转文本(服务端口) + "/创建", {"姓名": "李四"}, {"超时": 5000})
        检查("HTTP POST /创建 状态码201", 响应4.状态码() == 201)
        检查("HTTP POST /创建 内容含创建成功", 响应4.内容().是否包含("创建成功"))
        // 中文语义头名 内容类型 ↔ 线格式 Content-Type 往返（规范 §5.3.4 示例键）
        检查("HTTP 语义头名内容类型往返", 响应4.响应头().获取("内容类型") == "application/json")

        // POST 数据回显（请求体）
        响应体 = 网络.发送("http://127.0.0.1:" + 转文本(服务端口) + "/体", {"姓名": "张三", "年龄": 25}, {"超时": 5000})
        检查("HTTP POST 请求体回显含张三", 响应体.内容().是否包含("张三"))

        // 显式方法 PUT
        响应改 = 网络.请求("PUT", "http://127.0.0.1:" + 转文本(服务端口) + "/创建", {"姓名": "王五"}, {"超时": 5000})
        检查("HTTP PUT /创建 状态码201", 响应改.状态码() == 201)

        // DELETE 方法
        响应删 = 网络.请求("DELETE", "http://127.0.0.1:" + 转文本(服务端口) + "/删除", "", {"超时": 5000})
        检查("HTTP DELETE /删除 状态码404(未实现)", 响应删.状态码() == 404)

        // 请求头透传（HTTP 头名须为 ASCII，符合 RFC 7230）
        响应头 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/请求头", {"超时": 5000, "请求头": {"Authorization": "Bearer token123"}})
        检查("HTTP 请求头透传含Bearer", 响应头.内容().是否包含("Bearer"))

        // 会话凭证请求头（客户端发送方向：API 层纯中文 → 线格式 percent-encoding → 服务端还原纯中文）
        响应凭证 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/带凭证", {"超时": 5000, "会话凭证": {"会话标识": "abc123xyz"}})
        检查("HTTP 客户端发送中文凭证", 响应凭证.内容().是否包含("会话标识=abc123xyz"))

        // 查询参数解析
        响应查询 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/查询?关键词=你好&页=1", {"超时": 5000})
        检查("HTTP 查询参数解析正确", 响应查询.内容().是否包含("你好"))

        // 请求方法/完整网址/客户端地址 解析
        响应元 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/地址", {"超时": 5000})
        检查("HTTP 客户端地址为127.0.0.1", 响应元.内容().是否包含("127.0.0.1"))
        响应网址 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/完整网址", {"超时": 5000})
        检查("HTTP 完整网址含路径", 响应网址.内容().是否包含("/完整网址"))

        // 会话凭证（Set-Cookie）
        响应会话 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/cookie", {"超时": 5000})
        输出("调试 cookie响应头=" + 转文本(响应会话.响应头()))
        输出("调试 cookie所有凭证=" + 转文本(响应会话.所有会话凭证()))
        凭证 = 响应会话.会话凭证("会话标识")
        检查("HTTP 会话凭证可读取", 凭证 != 空值)
        全部凭证 = 响应会话.所有会话凭证()
        检查("HTTP 所有会话凭证为映射", 全部凭证 != 空值)

        // 中间件添加头（HTTP 头名小写化，故用小写键查询）
        响应跨域 = 网络.获取("http://127.0.0.1:" + 转文本(服务端口) + "/跨域", {"超时": 5000})
        输出("调试 跨域响应头=" + 转文本(响应跨域.响应头()))
        检查("HTTP 响应添加头跨域允许来源", 响应跨域.响应头().获取("access-control-allow-origin") == "*")

        // 流式获取（先用 / 小响应验证流式机制是否可用，避免大响应把结论掩盖）
        流 = 网络.流式获取("http://127.0.0.1:" + 转文本(服务端口) + "/", {"超时": 5000})
        如果 流 == 空值:
            输出("调试 流式获取返回空值（流式机制异常）")
        否则:
            检查("流式 状态码200", 流.状态码() == 200)
            检查("流式 响应头为映射", 流.响应头() != 空值)
            期望内容 = "欢迎访问智语言 HTTP 服务！"
            已收 = ""
            循环 真:
                块 = 流.读取(1024)
                如果 块 == "":
                    跳出
                结束
                已收 = 已收 + 块
            结束
            检查("流式 读取内容一致", 已收 == 期望内容)
            流.关闭()
        结束
        检查("流式 关闭不抛异常", 真)

        // 大文件流式（/大文件 中文路径 → 请求目标 percent-encoding 修复验证）
        流大 = 网络.流式获取("http://127.0.0.1:" + 转文本(服务端口) + "/大文件", {"超时": 5000})
        如果 流大 == 空值:
            检查("流式 大文件获取成功", 假)
        否则:
            期望大内容 = 生成大内容()
            大已收 = ""
            循环 真:
                大块 = 流大.读取(4096)
                如果 大块 == "":
                    跳出
                结束
                大已收 = 大已收 + 大块
            结束
            检查("流式 大文件内容完整", 大已收 == 期望大内容)
            输出("调试 大文件状态=" + 转文本(流大.状态码()))
            输出("调试 大文件含首=" + 转文本(大已收.是否包含("智语言网络流式测试数据")))
            输出("调试 大文件含中=" + 转文本(大已收.是否包含("中点标记")))
            输出("调试 大文件含尾=" + 转文本(大已收.是否包含("结束标记")))
            输出("调试 大文件中点索引=" + 转文本(大已收.查找("中点标记")))
            输出("调试 大文件尾索引=" + 转文本(大已收.查找("结束标记")))
            输出("调试 期望中点索引=" + 转文本(期望大内容.查找("中点标记")))
            输出("调试 期望尾索引=" + 转文本(期望大内容.查找("结束标记")))
            流大.关闭()
        结束

        // 头值含非 ASCII → 显式抛清晰异常（此前被 tiny_http/ureq 静默丢弃）
        头值抛出 = 假
        捕获:
            响应头测 = 网络.响应成功("数据")
            响应头测.添加头("X-测试", "中文值")
        异常:
            头值抛出 = 真
        结束
        检查("HTTP 头值非 ASCII 显式报错", 头值抛出)
        // 头名含中文（非「位置」）→ 显式抛清晰异常
        头名抛出 = 假
        捕获:
            响应头测乙 = 网络.响应成功("数据")
            响应头测乙.添加头("中文头名", "值")
        异常:
            头名抛出 = 真
        结束
        检查("HTTP 头名非 ASCII 显式报错", 头名抛出)
    异常:
        错误 = 异常错误()
        输出("HTTP 测试异常详情：" + 转文本(错误.描述))
        检查("HTTP 客户端请求未抛异常", 假)
    结束

    // 服务关闭不抛异常
    捕获:
        网络.服务关闭(服务)
        检查("HTTP 服务关闭不抛异常", 真)
    异常:
        检查("HTTP 服务关闭不抛异常", 假)
    结束
    输出("HTTP 服务已关闭，端口释放")
结束

// HTTP 处理器：覆盖各路径与请求解析
处理网络请求(网络请求 请求) 网络响应:
    路径 = 请求.路径()
    方法 = 请求.方法()

    如果 路径 == "/":
        返回 网络.响应成功("欢迎访问智语言 HTTP 服务！")
    否则如果 路径 == "/重定向":
        返回 网络.响应重定向("/")
    否则如果 路径 == "/不存在":
        返回 网络.响应未找到()
    否则如果 路径 == "/错误":
        返回 网络.响应错误("服务器内部错误示例")
    否则如果 路径 == "/创建":
        返回 网络.响应创建(201, "创建成功", {"内容类型": "application/json"})
    否则如果 路径 == "/自定义头":
        // 头值须 ASCII：非 ASCII 头值会被 tiny_http 校验拒绝并静默丢弃（RFC 9110 头值仅 obs-text 语义）
        返回 网络.响应成功("ok", {"X-ZhiLang": "zhilang-abc"})
    否则如果 路径 == "/跨域":
        响应 = 网络.响应成功("数据")
        响应.添加头("Access-Control-Allow-Origin", "*")
        返回 响应
    否则如果 路径 == "/cookie":
        返回 网络.设置会话凭证("会话标识", "abc123xyz", {"路径": "/", "有效期": 3600})
    否则如果 路径 == "/头":
        返回 网络.响应成功("方法=" + 方法)
    否则如果 路径 == "/查询":
        参数 = 请求.查询参数()
        // ★F2/F15 迁移（2026-10-14）：可空值参与文本拼接 ⇒ `转文本(...)` ✓
        返回 网络.响应成功("关键词=" + 转文本(参数.获取("关键词")))
    否则如果 路径 == "/请求头":
        头 = 请求.请求头()
        返回 网络.响应成功("认证=" + 转文本(头.获取("authorization")))
    否则如果 路径 == "/带凭证":
        头 = 请求.请求头()
        返回 网络.响应成功("凭证=" + 转文本(头.获取("cookie")))
    否则如果 路径 == "/体":
        返回 网络.响应成功("体=" + 请求.内容())
    否则如果 路径 == "/地址":
        返回 网络.响应成功("地址=" + 请求.客户端地址())
    否则如果 路径 == "/完整网址":
        返回 网络.响应成功("网址=" + 请求.完整网址())
    否则如果 路径 == "/大文件":
        返回 网络.响应成功(生成大内容())
    否则:
        返回 网络.响应未找到()
    结束
结束

// ---------- 四、TLS/HTTPS（规范 §5.3.5：TLS/证书/密钥/验证证书） ----------
运行传输层安全测试():
    证书文件 = "../夹具产物/cert.pem"
    密钥文件 = "../夹具产物/key.pem"

    安全服务 = 网络.启动服务(18201, 处理网络请求, {"TLS": 真, "证书": 证书文件, "密钥": 密钥文件})
    时间.休眠(300)

    捕获:
        // ① raw TLS 往返（rustls 懒握手、读有超时；就绪重试规避启动竞态）
        成功 = 假
        尝试次数 = 0
        循环 真:
            如果 成功:
                跳出
            结束
            如果 尝试次数 >= 5:
                跳出
            结束
            捕获:
                连接 = 网络.连接("127.0.0.1", 18201, {"TLS": 真, "验证证书": 假, "超时": 3000})
                连接.设置超时(3000)
                连接.写入("GET / HTTP/1.1" + "\回车\换行" + "Host: 127.0.0.1" + "\回车\换行" + "Connection: close" + "\回车\换行" + "\回车\换行")
                连接.关闭写入()
                回文本 = 连接.读取全部()
                连接.关闭()
                检查("TLS 连接握手+往返成功", 回文本.是否包含("200"))
                成功 = 真
            异常:
                尝试次数 = 尝试次数 + 1
                时间.休眠(300)
            结束
        结束
        如果 成功 == 假:
            检查("TLS 连接握手+往返成功", 假)
        结束

        // ② HTTPS 经 网络.获取（验证证书=假 自签场景）
        安全响应 = 网络.获取("https://127.0.0.1:18201/", {"验证证书": 假, "超时": 5000})
        检查("HTTPS 获取 验证证书=假 状态码200", 安全响应.状态码() == 200)
        检查("HTTPS 获取 内容正确", 安全响应.内容().是否包含("欢迎"))
    异常:
        错误详情 = 异常错误()
        输出("TLS 测试异常详情：" + 转文本(错误详情.描述))
        检查("TLS 用例未抛异常", 假)
    结束

    // ③ 验证证书默认值=真：对自签证书应被干净拒绝（可捕获的异常而非挂起）
    证书拒绝 = 假
    捕获:
        响应验证 = 网络.获取("https://127.0.0.1:18201/", {"超时": 5000})
    异常:
        证书拒绝 = 真
    结束
    检查("HTTPS 自签证书默认验证拒绝", 证书拒绝)

    捕获:
        网络.服务关闭(安全服务)
    异常:
        检查("HTTPS 服务关闭不抛异常", 假)
    结束
    检查("HTTPS 服务关闭不抛异常", 真)
结束

