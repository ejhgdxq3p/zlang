// ============================================================
// 接口深入测试（补充覆盖面）
// 覆盖规范：接口变量赋值后调用带状态方法(状态应保留)、
//          接口变量作为参数传递(引用语义，修改作用于原实例)、
//          接口方法返回结构体实例、接口类型作为函数返回值、
//          接口数组批量调用只读方法、多接口适配方法调用
// 注：接口是引用类型，接口变量/参数共享原实例（修改作用于原实例）；
//     数组元素取出为值复制(规范2.3.7)，只读遍历安全，修改只作用于副本。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 接口定义 ──
接口 可移动:
    移动(速度):
    结束
    停止():
    结束
    当前速度() 小数:
    结束
结束

接口 可累计:
    增加(数量):
    结束
    总量() 整数:
    结束
结束

// ── 适配接口的结构体 ──
结构体 汽车(文本 品牌) 适配 可移动:
    小数 速度 = 0.0
    移动(小数 新速度):
        自身.速度 = 新速度
    结束
    停止():
        自身.速度 = 0.0
    结束
    当前速度() 小数:
        返回 自身.速度
    结束
结束

结构体 步数器(文本 标签) 适配 可累计:
    整数 累计 = 0
    增加(整数 数量):
        自身.累计 += 数量
    结束
    总量() 整数:
        返回 自身.累计
    结束
结束

// ── 接口方法返回结构体实例 ──
结构体 坐标点(整数 横, 整数 纵):
    获取横坐标() 整数:
        返回 横
    结束
    获取纵坐标() 整数:
        返回 纵
    结束
    描述() 文本:
        返回 "(" + 转文本(横) + "," + 转文本(纵) + ")"
    结束
结束

接口 可定位:
    获取位置() 坐标点:
    结束
结束

结构体 定位器(文本 名称) 适配 可定位:
    整数 横 = 0
    整数 纵 = 0
    获取位置() 坐标点:
        返回 坐标点(自身.横, 自身.纵)
    结束
    设置位置(整数 新横, 整数 新纵):
        自身.横 = 新横
        自身.纵 = 新纵
    结束
结束

// ── 接口类型作为函数返回值 ──
制造汽车(文本 品牌) 汽车:
    返回 汽车(品牌)
结束

// ── 接口类型作为函数参数：已闭环（逻辑版本138）──
// 接口实例以【句柄】传值（引用语义由句柄保证），方法原地修改作用于原实例。
// 双模（解释/编译）均验证通过，见 测试_接口参数_带状态 与 13接口赋值规则/B5、14接口全面/C段。
改速度(可移动 设备, 小数 速度):
    设备.移动(速度)
    返回 设备.当前速度()
结束

// 接口作参数 + 接口方法返回结构体（组合路径）
取位置(可定位 定位接口):
    返回 定位接口.获取位置()
结束

// ── 接口数组批量调用只读方法（值语义，遍历安全）──
批量当前速度(数组<可移动> 列表) 小数:
    合计 = 0.0
    循环 设备 遍历 列表:
        合计 += 设备.当前速度()
    结束
    返回 合计
结束

// ── 测试 ──
测试_接口变量调用带状态方法():
    汽车1 = 汽车("奔驰")
    可移动 设备 = 汽车1
    设备.移动(80.0)
    检查("接口变量-移动后原实例速度80", 汽车1.当前速度() == 80.0)
    检查("接口变量-变量读取速度80", 设备.当前速度() == 80.0)
    设备.停止()
    检查("接口变量-停止后原实例速度0", 汽车1.当前速度() == 0.0)
    检查("接口变量-停止后变量速度0", 设备.当前速度() == 0.0)
结束

测试_接口变量作为参数():
    // 接口直接作为函数参数：已闭环，方法修改作用于原实例（双模验证）
    车丙 = 汽车("丙")
    车丙.移动(50.0)
    结果 = 改速度(车丙, 120.0)
    检查("接口参数-带状态方法改原实例速度120", 车丙.当前速度() == 120.0)
    检查("接口参数-返回值=当前速度120", 结果 == 120.0)
结束

测试_接口参数返回结构体():
    定位 = 定位器("GPS2")
    定位.设置位置(7, 8)
    点 = 取位置(定位)
    检查("接口参数-方法返回结构体横坐标7", 点.获取横坐标() == 7)
    检查("接口参数-方法返回结构体纵坐标8", 点.获取纵坐标() == 8)
    检查("接口参数-原定位器未被改动", 定位.获取位置().获取横坐标() == 7)
结束

测试_接口方法返回结构体():
    定位 = 定位器("GPS")
    定位.设置位置(3, 4)
    可定位 定位接口 = 定位
    位置 = 定位接口.获取位置()
    检查("接口返回结构体-横坐标3", 位置.获取横坐标() == 3)
    检查("接口返回结构体-纵坐标4", 位置.获取纵坐标() == 4)
    检查("接口返回结构体-描述", 位置.描述() == "(3,4)")
结束

测试_接口作为函数返回值():
    新车 = 制造汽车("宝马")
    检查("接口函数返回-品牌方法可用", 新车.当前速度() == 0.0)
    新车.移动(60.0)
    检查("接口函数返回-移动后60", 新车.当前速度() == 60.0)
结束

测试_接口数组批量只读():
    车甲 = 汽车("甲")
    车乙 = 汽车("乙")
    车甲.移动(30.0)
    车乙.移动(70.0)
    数组<可移动> 列表 = [车甲, 车乙]
    检查("接口数组-批量只读合计速度100", 批量当前速度(列表) == 100.0)
    检查("接口数组-原实例甲速度30", 车甲.当前速度() == 30.0)
    检查("接口数组-原实例乙速度70", 车乙.当前速度() == 70.0)
结束

