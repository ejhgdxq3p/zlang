// 规范 §2.4.7 遮蔽表：「代码块局部变量 遮蔽 函数局部变量 ✅ 内层优先」。
//   本用例验证**块作用域**：块内 `整数 甲 = 2` 是**新局部**（不写外层），出块后恢复外层值。
通过数 = 0
失败数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("FAILCASE " + 名称)
    结束
结束

测试_块遮蔽():
    整数 甲 = 1
    如果 真:
        整数 甲 = 2
        检查("块内是新局部（内层优先）", 甲 == 2)
    结束
    检查("出块后恢复外层值", 甲 == 1)
结束

测试_块内隐式赋值不新建():
    整数 乙 = 10
    如果 真:
        乙 = 20
        检查("块内隐式写法是赋值（非新局部）", 乙 == 20)
    结束
    检查("隐式写法改到外层变量", 乙 == 20)
结束

启动程序():
    测试_块遮蔽()
    测试_块内隐式赋值不新建()
    输出("RESULT 通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " 失败：" + 转文本(本模块.失败数))
结束
