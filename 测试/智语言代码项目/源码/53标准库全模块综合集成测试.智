// 53 标准库全模块综合集成场景测试（严格对照规范 4.1/4.2/4.3/4.4/5.4/5.6）
// 场景：学生成绩管理系统 —— 混合调用 8 全局函数 + 文本7 + 数组10 + 映射8 + 时间15 + 工具11
// 用 检查() 钉死，末行汇总。双模验证。
// 注：无类型变量链式调用是已知类型推断限制，本测试统一用「拆中间变量」写法规避（顺从实现）。
// 循环语法严格用「循环 变量 遍历 容器」（遍历是循环子句，非独立语句，不用 于）。
// ============================================================

导入 时间
导入 工具

通过数53 = 0
失败数53 = 0
总数53 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数53 = 本模块.总数53 + 1
    如果 条件:
        本模块.通过数53 = 本模块.通过数53 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数53 = 本模块.失败数53 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    // ---- 数组：成绩列表 ----
    数学分 = [88, 92, 76, 95, 81]
    检查("数组.长度=5", 数学分.长度() == 5)
    数学分.追加(100)
    检查("数组.追加 后长度=6", 数学分.长度() == 6)
    末位 = 数学分.取末尾()    // 取末尾 是弹出式，返回末位并移除
    检查("数组.取末尾=100", 末位 == 100)
    检查("取末尾后长度=5", 数学分.长度() == 5)
    // 循环遍历求和（正确语法：循环 元素 遍历 数组）
    总和 = 0
    循环 分 遍历 数学分:
        总和 = 总和 + 分
    结束
    检查("遍历求和=432", 总和 == 432)
    平均分 = 转小数(总和) / 转小数(数学分.长度())
    检查("平均分≈86.4", 平均分 > 转小数(86) 且 平均分 < 转小数(87))
    数学分.排序()
    检查("数组.排序 首<=尾", 数学分[1] <= 数学分[数学分.长度()])
    反转前长 = 数学分.长度()
    数学分.反转()
    检查("数组.反转 长度不变", 数学分.长度() == 反转前长)
    检查("数组.是否包含(95)=真", 数学分.是否包含(95))
    检查("数组.查找索引(95)>0", 数学分.查找索引(95) > 0)

    // ---- 映射：学生档案 ----
    档案 = {"姓名": "张三", "班级": "高三(2)班"}
    档案.插入("学号", "2026001")
    检查("映射.插入 长度=3", 档案.长度() == 3)
    检查("映射.获取 姓名=张三", 档案.获取("姓名") == "张三")
    所有键 = 档案.所有键()
    检查("映射.所有键 长度=3", 所有键.长度() == 3)
    所有值 = 档案.所有值()
    检查("映射.所有值 长度=3", 所有值.长度() == 3)
    档案.删除("班级")
    检查("映射.删除 后长度=2", 档案.长度() == 2)
    检查("映射.是否包含 班级=假", 档案.是否包含("班级") == 假)
    检查("映射.获取 缺失=空值", 档案.获取("地址") == 空值)
    临时 = {"甲": 1}
    临时.清空()
    检查("映射.清空 后长度=0", 临时.长度() == 0)

    // ---- 文本：格式化日志 ----
    // ★F2/F15 迁移（2026-10-14）：可空值参与文本拼接 ⇒ 用 `转文本(...)`（规范 5613 示例写法 ✓）
    日志 = "学生" + 转文本(档案.获取("姓名")) + " 平均分" + 转文本(平均分)
    检查("文本拼接 含张三", 日志.是否包含("张三"))
    检查("文本.长度>0", 日志.长度() > 0)
    检查("文本.查找 张三位置>0", 日志.查找("张三") > 0)
    替换日志 = 日志.替换("平均分", "均分")
    检查("文本.替换 生效", 替换日志.是否包含("均分"))
    分隔日志 = 日志.分隔(" ")
    检查("文本.分隔 长度>=2", 分隔日志.长度() >= 2)
    干净日志 = 日志.去除空白()
    检查("文本.去除空白 不破坏内容", 干净日志.是否包含("张三"))

    // ---- 时间：计时一段操作 ----
    起点 = 时间.获取计时器()
    时间.休眠(1000)
    终点 = 时间.获取计时器()
    检查("时间.休眠(1000) 计时>=900ms", 终点 - 起点 >= 900)
    现在 = 时间.当前时间()
    检查("时间.当前时间>0", 现在 > 0)
    年 = 时间.获取年(现在)
    检查("时间.获取年>2000", 年 > 2000)
    月 = 时间.获取月(现在)
    检查("时间.获取月 1-12", 月 >= 1 且 月 <= 12)
    日 = 时间.获取日(现在)
    检查("时间.获取日 1-31", 日 >= 1 且 日 <= 31)
    格式化文 = 时间.格式化("年-月-日", 现在)
    检查("时间.格式化 含横线", 格式化文.是否包含("-"))
    生日戳 = 时间.解析("2000-01-01", "年-月-日")
    检查("时间.解析 整数且早于现在", 类型(生日戳) == "整数" 且 生日戳 < 现在)
    明天 = 时间.加(现在, 86400)
    检查("时间.加(86400)=现在+86400", 明天 == 现在 + 86400)
    间隔 = 时间.间隔天数(明天, 现在)
    检查("时间.间隔天数=1", 间隔 == 1)

    // ---- 工具：JSON 往返 + 哈希 + 编码 ----
    成绩映射 = {"数学": 88, "语文": 92}
    文本化 = 工具.生成数据("JSON", 成绩映射)
    检查("生成数据 返回文本", 类型(文本化) == "文本")
    还原 = 工具.解析数据("JSON", 文本化)
    检查("解析数据 返回映射", 类型(还原) == "映射")
    检查("解析数据 可取 数学=88", 还原.获取("数学") == 88)
    哈希 = 工具.哈希算法("MD5", 文本化)
    检查("哈希 MD5 长度32", 哈希.长度() == 32)
    哈希2 = 工具.哈希算法("SHA256", 文本化)
    检查("哈希 SHA256 长度64", 哈希2.长度() == 64)
    编码 = 工具.编码方案("BASE64", 文本化)
    解码 = 工具.解码方案("BASE64", 编码)
    检查("BASE64 往返一致", 解码 == 文本化)
    匹配结果 = 工具.正则匹配("[0-9]+", "成绩88语文92")
    检查("正则匹配 返回数组且>=2", 类型(匹配结果) == "数组" 且 匹配结果.长度() >= 2)
    替换 = 工具.正则替换("[0-9]+", "#", "a1b2")
    检查("正则替换 数字被替换", 替换 == "a#b#")
    编号1 = 工具.唯一编号()
    编号2 = 工具.唯一编号()
    检查("唯一编号 非空且两次不同", 编号1.长度() > 0 且 编号1 != 编号2)

    // ---- 8 全局函数混合 ----
    检查("转文本(整数)='123'", 转文本(123) == "123")
    检查("转整数(文本)=456", 转整数("456") == 456)
    检查("转小数(整数)=7.0", 转小数(7) == 7.0)
    检查("类型(数组)=数组", 类型(数学分) == "数组")
    检查("类型(映射)=映射", 类型(档案) == "映射")
    检查("类型(文本)=文本", 类型("x") == "文本")
    检查("类型(逻辑)=逻辑", 类型(真) == "逻辑")
    检查("类型(空值)=空值", 类型(空值) == "空值")
    输入值 = 输入()
    检查("输入() 返回文本类型", 类型(输入值) == "文本")
    错误输出("诊断：错误输出() 正常")
    捕获:
        抛出 "综合测试异常"
    异常:
        错误 = 异常错误()
        检查("异常错误 类型=异常错误", 类型(错误) == "异常错误")
        检查("异常错误.描述 含消息", 错误.描述.是否包含("综合测试异常"))
    结束
    构造异常 = 异常错误("构造消息")
    检查("异常错误(消息) 描述正确", 构造异常.描述 == "构造消息")

    // ---- 结果汇总 ----
    输出("")
    输出("===== 53 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数53) + "，通过：" + 转文本(本模块.通过数53) + "，失败：" + 转文本(本模块.失败数53))
    如果 本模块.失败数53 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
