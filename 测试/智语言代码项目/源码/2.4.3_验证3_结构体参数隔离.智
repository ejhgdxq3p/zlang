通过数 = 0
失败数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  FAIL " + 名称)
    结束
结束

结构体 参数矩形(小数 宽, 小数 高):
    小数 宽 = 宽
    小数 高 = 高
    取宽() 小数:
        返回 自身.宽
    结束
    取参数宽() 小数:
        返回 宽
    结束
    用参数(小数 比例) 小数:
        返回 自身.宽 * 比例
    结束
    遮蔽参数(小数 宽) 小数:
        返回 宽 * 自身.高
    结束
    局部遮蔽() 小数:
        宽 = 5.0
        返回 自身.宽
    结束
结束

测试_全部():
    甲 = 参数矩形(3.0, 4.0)
    检查("关系一-同名字段取参数值", 甲.取宽() == 3.0)
    检查("参数可直接使用", 甲.用参数(2.0) == 6.0)
    检查("方法参数遮蔽结构体参数", 甲.遮蔽参数(5.0) == 20.0)
    检查("方法内赋值=新局部（字段不受影响）", 甲.局部遮蔽() == 3.0)
    甲.宽 = 9.0
    检查("字段可改", 甲.取宽() == 9.0)
    检查("字段改动不影响结构体参数", 甲.取参数宽() == 3.0)
结束

启动程序():
    测试_全部()
    输出("RESULT 通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " 失败：" + 转文本(本模块.失败数))
结束
