// 271 六模块：**返回类型契约 + 变异语义 + 值语义**全矩阵（2026-10-22）
//
// 与 217~220 的分工：
//   217 = 8 全局函数 + 容器显示格式；218 = 文本/数组/映射的边界规则；219 = 时间；220 = 工具。
//   **271 = 换一个维度：每个成员的「返回类型」是否与 §4.1/§4.2/§4.3/§4.4/§5.4/§5.6 声明一致，
//   以及「变异方法是否就地生效」「容器赋值是否深拷贝」「文本方法是否纯函数」这三条语义骨架。**
//   这三条一旦错，用户代码会静默错值（比参数边界错更难发现）。
//
// 断言来源：先写探针逐成员实测 `类型(...)`，再与规范表格逐行对照后落为断言（不凭直觉猜）。
// 已知边界（**规范未定义、只用记录**）：把"无返回值"的变异方法当表达式用（如 `类型(表.追加(1))`）
//   实测返回的是**接收者类型**（数组/映射）—— 那是写回机制的表现，规范要求语句位置调用，故不断言。
//
// 资源纪律：纯内存计算，无循环上界问题、无休眠/并发，耗时 < 100ms。
导入 时间
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 271 六模块返回类型 / 变异 / 值语义矩阵 ===")

    // ───────── ① 8 全局函数：返回类型（§4.1）─────────
    输出("-- ① 全局函数返回类型 --")
    检查("转文本(1) ⇒ 文本", 类型(转文本(1)) == "文本")
    检查("转文本(1.5) ⇒ 文本", 类型(转文本(1.5)) == "文本")
    检查("转文本(真) ⇒ 文本", 类型(转文本(真)) == "文本")
    检查("转整数(12) ⇒ 整数", 类型(转整数("12")) == "整数")
    检查("转整数(1.9) ⇒ 整数（截断）", 类型(转整数(1.9)) == "整数")
    检查("转小数(1) ⇒ 小数", 类型(转小数("1.5")) == "小数")
    检查("类型(1) ⇒ 文本", 类型(类型(1)) == "文本")
    检查("类型(1) 的值 = 整数", 类型(1) == "整数")
    检查("类型([]) = 数组", 类型([]) == "数组")
    检查("类型({}) = 映射", 类型({}) == "映射")
    检查("类型(空值) = 空值", 类型(空值) == "空值")
    检查("类型(1.5) = 小数", 类型(1.5) == "小数")
    检查("类型(真) = 逻辑", 类型(真) == "逻辑")
    // ⚠ 函数名不能作为值使用（§2.5），故不测 `类型(转文本)`
    检查("类型(真 且 假) = 逻辑", 类型(真 且 假) == "逻辑")
    检查("类型(1 / 2) = 小数（整数相除返小数）", 类型(1 / 2) == "小数")
    异常类型名 = ""
    捕获:
        坏 = 1 / 0
    异常:
        异常类型名 = 类型(异常错误())
    结束
    检查("异常错误() ⇒ 异常错误（结构体）", 异常类型名 == "异常错误")

    // ───────── ② 文本 7 方法：返回类型 + 纯函数性（§4.2）─────────
    输出("-- ② 文本方法：返回类型 --")
    检查("截取 ⇒ 文本", 类型("abcd".截取(2, 2)) == "文本")
    检查("查找 ⇒ 整数", 类型("abcd".查找("b")) == "整数")
    检查("替换 ⇒ 文本", 类型("abcd".替换("a", "x")) == "文本")
    检查("分隔 ⇒ 数组", 类型("甲,乙".分隔(",")) == "数组")
    检查("去除空白 ⇒ 文本", 类型("  ab  ".去除空白()) == "文本")
    检查("是否包含 ⇒ 逻辑", 类型("abcd".是否包含("b")) == "逻辑")
    检查("长度 ⇒ 整数", 类型("abcd".长度()) == "整数")

    输出("-- ② 文本方法：纯函数（不改接收者）--")
    原文 = "abc"
    替换结果 = 原文.替换("a", "x")
    检查("替换返回新文本", 替换结果 == "xbc")
    检查("替换后原文本不变（纯函数）", 原文 == "abc")
    去空白结果 = "  abc  ".去除空白()
    检查("去除空白返回新文本", 去空白结果 == "abc")
    检查("分隔不改变原文本", 类型("a,b".分隔(",")) == "数组")

    // ───────── ③ 数组 11 方法：返回类型 + 就地变异（§4.3）─────────
    输出("-- ③ 数组方法：返回类型 --")
    检查("[1,2].长度() ⇒ 整数", 类型([1, 2].长度()) == "整数")
    检查("[1,2].获取(1) ⇒ 元素类型（整数）", 类型([1, 2].获取(1)) == "整数")
    检查("[1,2].取末尾() ⇒ 元素类型（整数）", 类型([1, 2].取末尾()) == "整数")
    检查("[1,2].是否包含(1) ⇒ 逻辑", 类型([1, 2].是否包含(1)) == "逻辑")
    检查("[1,2].查找索引(2) ⇒ 整数", 类型([1, 2].查找索引(2)) == "整数")

    输出("-- ③ 数组方法：就地变异生效 --")
    表 = [1, 2]
    表.追加(3)
    检查("追加后长度 3", 表.长度() == 3)
    检查("追加速度：末尾元素 = 3", 表.获取(3) == 3)
    表.插入(1, 0)
    检查("插入后长度 4", 表.长度() == 4)
    检查("插入位置正确：[1] = 0", 表.获取(1) == 0)
    表.删除(1)
    检查("删除后长度 3", 表.长度() == 3)
    检查("删除后首元素回到 1", 表.获取(1) == 1)
    表.反转()
    检查("反转后首元素 = 3", 表.获取(1) == 3)
    检查("反转后末元素 = 1", 表.获取(3) == 1)
    表.排序()
    检查("排序后升序：首元素 = 1", 表.获取(1) == 1)
    检查("排序后升序：末元素 = 3", 表.获取(3) == 3)
    弹出值 = 表.取末尾()
    检查("取末尾返回末元素 = 3", 弹出值 == 3)
    检查("取末尾后长度 = 2（弹出语义）", 表.长度() == 2)
    表.清空()
    检查("清空后长度 = 0", 表.长度() == 0)
    检查("清空后取末尾 ⇒ 空值", 表.取末尾() == 空值)

    输出("-- ③ 数组方法：查找与包含边界 --")
    表二 = [5, 6, 5]
    检查("是否包含 不存在的元素 ⇒ 假", 表二.是否包含(9) == 假)
    检查("查找索引 返回首次出现位置 = 1", 表二.查找索引(5) == 1)
    检查("查找索引 未找到 ⇒ 0（规范：不是 -1）", 表二.查找索引(9) == 0)
    检查("获取 越界 ⇒ 空值（不抛）", 表二.获取(99) == 空值)

    // ───────── ④ 映射 8 方法：返回类型 + 就地变异（§4.4）─────────
    输出("-- ④ 映射方法 --")
    映 = {"甲": 1}
    检查("长度 ⇒ 整数", 类型(映.长度()) == "整数")
    检查("所有键 ⇒ 数组", 类型(映.所有键()) == "数组")
    检查("所有值 ⇒ 数组", 类型(映.所有值()) == "数组")
    检查("获取 ⇒ 值类型（整数）", 类型(映.获取("甲")) == "整数")
    检查("是否包含 ⇒ 逻辑", 类型(映.是否包含("甲")) == "逻辑")
    检查("获取 缺键 ⇒ 空值", 映.获取("无此键") == 空值)
    检查("是否包含 缺键 ⇒ 假", 映.是否包含("无此键") == 假)
    映.插入("乙", 2)
    检查("插入后长度 2", 映.长度() == 2)
    检查("插入后可取到值 2", 映.获取("乙") == 2)
    映.插入("乙", 20)
    检查("重复插入同键 ⇒ 覆盖（长度仍 2）", 映.长度() == 2)
    检查("覆盖后值 = 20", 映.获取("乙") == 20)
    检查("所有键 长度 = 2", 映.所有键().长度() == 2)
    检查("所有值 长度 = 2", 映.所有值().长度() == 2)
    映.删除("甲")
    检查("删除后长度 1", 映.长度() == 1)
    检查("删除后 是否包含(甲) ⇒ 假", 映.是否包含("甲") == 假)
    映.删除("不存在的键")
    检查("删除不存在的键 不报错、长度不变", 映.长度() == 1)
    映.清空()
    检查("清空后长度 0", 映.长度() == 0)

    // ───────── ⑤ 值语义（容器赋值是深拷贝）─────────
    输出("-- ⑤ 值语义 --")
    源表 = [1]
    副表 = 源表
    副表.追加(2)
    检查("★★ 数组赋值是深拷贝：改副本不影响原件", 源表.长度() == 1)
    检查("副本已变（长度 2）", 副表.长度() == 2)

    源映 = {"甲": 1}
    副映 = 源映
    副映.插入("乙", 2)
    检查("★★ 映射赋值是深拷贝：改副本不影响原件", 源映.长度() == 1)
    检查("映射副本已变（长度 2）", 副映.长度() == 2)

    嵌套源 = [[1]]
    嵌套副 = 嵌套源
    嵌套副.追加([2])
    检查("嵌套数组赋值同样深拷贝", 嵌套源.长度() == 1)

    // ───────── ⑥ 时间模块返回类型（§5.4）─────────
    输出("-- ⑥ 时间模块返回类型 --")
    检查("当前时间 ⇒ 整数（时间戳）", 类型(时间.当前时间()) == "整数")
    检查("格式化 ⇒ 文本", 类型(时间.格式化(0, "年")) == "文本")
    检查("解析 ⇒ 整数（时间戳）", 类型(时间.解析("2026-01-01", "年-月-日")) == "整数")
    检查("间隔天数 ⇒ 整数", 类型(时间.间隔天数(86400, 0)) == "整数")
    检查("加 ⇒ 整数", 类型(时间.加(0, 1)) == "整数")

    // ───────── ⑦ 工具模块返回类型（§5.6）─────────
    输出("-- ⑦ 工具模块返回类型 --")
    检查("正则匹配 ⇒ 数组", 类型(工具.正则匹配("\反斜杠d+", "123")) == "数组")
    检查("正则替换 ⇒ 文本", 类型(工具.正则替换("\反斜杠d", "a1", "x")) == "文本")
    检查("解析数据(JSON) ⇒ 数组", 类型(工具.解析数据("JSON", "[1,2]")) == "数组")
    检查("生成数据(JSON) ⇒ 文本", 类型(工具.生成数据("JSON", [1, 2])) == "文本")
    检查("哈希算法(MD5) ⇒ 文本", 类型(工具.哈希算法("MD5", "abc")) == "文本")
    检查("唯一编号 ⇒ 文本", 类型(工具.唯一编号()) == "文本")

    // ───────── ⑧ 跨模块链式组合（把六模块串起来）─────────
    输出("-- ⑧ 跨模块链式组合 --")
    原始 = "  丙,甲,乙  "
    清洗 = 原始.去除空白()
    检查("链式-1 去除空白 ⇒ 丙,甲,乙", 清洗 == "丙,甲,乙")
    片段 = 清洗.分隔(",")
    检查("链式-2 分隔 ⇒ 3 段", 片段.长度() == 3)
    片段.排序()
    // ⚠ 排序口径（§4.3 规则 1）：文本按 **UTF-8 字节序 / Unicode 码点序**，不是拼音序 ——
    //   丙 U+4E19 < 乙 U+4E59 < 甲 U+7532 ⇒ 升序为 [丙, 乙, 甲]（按拼音直觉写会错）
    检查("链式-3 排序按码点序：首段 = 丙（U+4E19 最小）", 片段.获取(1) == "丙")
    检查("链式-3b 排序按码点序：末段 = 甲", 片段.获取(3) == "甲")
    检查("链式-4 是否包含 乙 ⇒ 真", 片段.是否包含("乙") == 真)
    拼回 = 片段.获取(1) + "|" + 片段.获取(2) + "|" + 片段.获取(3)
    检查("链式-5 文本拼回 = 丙|乙|甲（码点序）", 拼回 == "丙|乙|甲")
    摘要 = 工具.哈希算法("MD5", 拼回)
    检查("链式-6 哈希结果长度 32（十六进制）", 摘要.长度() == 32)
    检查("链式-7 同输入哈希稳定", 工具.哈希算法("MD5", 拼回) == 摘要)
    解析回 = 工具.解析数据("JSON", "[1,2,3]")
    检查("链式-8 JSON 解析 ⇒ 可索引数组", 解析回.获取(2) == 2)
    时间差 = 时间.间隔天数(86400 * 3, 0)
    检查("链式-9 时间.间隔天数(3 天, 0) = 3", 时间差 == 3)

    收尾()
结束
