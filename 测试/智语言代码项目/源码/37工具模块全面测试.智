// ============================================================
// 工具模块 全面测试（细致版，覆盖规范 5.6 + 类型推导注册的全部 9 个函数）
// 对照《智语言编程规范》5.6：哈希算法 / 正则匹配 / 正则替换 / 解析数据 / 生成数据
// 另含编码方案 / 解码方案 / 唯一编号 / 生成唯一编号（类型推导注册）
// 所有用例用 检查() 统计，末行输出汇总。双模验证。
// ============================================================

导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    // ===================== 一、哈希算法 =====================
    输出("===== 一、哈希算法（值正确性） =====")
    哈希1 = 工具.哈希算法("MD5", "hello")
    检查("MD5(hello) 值正确", 哈希1 == "5d41402abc4b2a76b9719d911017c592")
    检查("MD5(hello) 长度32", 哈希1.长度() == 32)
    哈希2 = 工具.哈希算法("SHA256", "hello")
    检查("SHA256(hello) 值正确", 哈希2 == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824")
    检查("SHA256(hello) 长度64", 哈希2.长度() == 64)
    哈希3 = 工具.哈希算法("MD5", "智语言")
    检查("MD5(中文) 长度32", 哈希3.长度() == 32)
    检查("MD5(中文) 稳定可复现", 哈希3 == 工具.哈希算法("MD5", "智语言"))

    // ===================== 二、正则匹配 =====================
    输出("===== 二、正则匹配 =====")
    数字 = 工具.正则匹配("[0-9]+", "订单123和456")
    检查("正则匹配 返回数组", 类型(数字) == "数组")
    检查("正则匹配 命中数量=2", 数字.长度() == 2)
    检查("正则匹配[1]=123", 数字[1] == "123")
    检查("正则匹配[2]=456", 数字[2] == "456")
    无命中 = 工具.正则匹配("[0-9]+", "纯文本无数字")
    检查("正则匹配 无命中返回空数组", 无命中.长度() == 0)
    字母 = 工具.正则匹配("[a-zA-Z]+", "ab12cd34")
    检查("正则匹配 字母段=2", 字母.长度() == 2)

    // ===================== 三、正则替换 =====================
    输出("===== 三、正则替换 =====")
    脱敏 = 工具.正则替换("[0-9]+", "X", "a1b2c3")
    检查("正则替换 全部数字变X", 脱敏 == "aXbXcX")
    检查("正则替换 返回文本", 类型(脱敏) == "文本")
    保留 = 工具.正则替换("x", "Y", "x1x2x3")
    检查("正则替换 单字符x→Y", 保留 == "Y1Y2Y3")
    不变 = 工具.正则替换("[0-9]+", "X", "无数字")
    检查("正则替换 无匹配原文不变", 不变 == "无数字")

    // ===================== 四、生成数据 / 解析数据 往返 =====================
    输出("===== 四、JSON 生成与解析往返 =====")
    数组文 = 工具.生成数据("JSON", [1, 2, 3])
    检查("生成数据 JSON数组 返回文本", 类型(数组文) == "文本")
    检查("生成数据 JSON数组 含元素", 数组文.是否包含("2"))
    回解数组 = 工具.解析数据("JSON", 数组文)
    检查("解析数据 数组类型", 类型(回解数组) == "数组")
    检查("解析数据 数组长度3", 回解数组.长度() == 3)
    检查("解析数据 数组[1]=1", 回解数组[1] == 1)
    检查("解析数据 数组[3]=3", 回解数组[3] == 3)

    用户 = {"姓名": "张三", "年龄": 25, "城市": "北京"}
    映射文 = 工具.生成数据("JSON", 用户)
    检查("生成数据 JSON映射 返回文本", 类型(映射文) == "文本")
    检查("生成数据 JSON映射 含姓名", 映射文.是否包含("张三"))
    回解映射 = 工具.解析数据("JSON", 映射文)
    检查("解析数据 映射类型", 类型(回解映射) == "映射")
    检查("解析数据 映射可取姓名", 回解映射.获取("姓名") == "张三")
    检查("解析数据 映射可取年龄", 回解映射.获取("年龄") == 25)
    检查("解析数据 映射可取城市", 回解映射.获取("城市") == "北京")

    // 直接解析 生成数据 产出的字面 JSON 文本（规范 5.6 案例等价写法）
    字面文本 = 工具.生成数据("JSON", {"姓名": "李四", "年龄": 30})
    直接 = 工具.解析数据("JSON", 字面文本)
    检查("解析数据 字面JSON 映射类型", 类型(直接) == "映射")
    检查("解析数据 字面JSON 取姓名", 直接.获取("姓名") == "李四")
    检查("解析数据 字面JSON 取年龄", 直接.获取("年龄") == 30)

    // ===================== 五、编码 / 解码 =====================
    输出("===== 五、BASE64 编码解码 =====")
    编码 = 工具.编码方案("BASE64", "hello")
    检查("编码 BASE64 返回文本", 类型(编码) == "文本")
    检查("编码 BASE64('hello')=aGVsbG8=", 编码 == "aGVsbG8=")
    解码 = 工具.解码方案("BASE64", 编码)
    检查("解码 BASE64 还原", 解码 == "hello")
    中文编码 = 工具.编码方案("BASE64", "智语言")
    中文解码 = 工具.解码方案("BASE64", 中文编码)
    检查("编码/解码 中文往返一致", 中文解码 == "智语言")

    // ===================== 六、唯一编号 =====================
    输出("===== 六、唯一编号 =====")
    编号甲 = 工具.唯一编号()
    编号乙 = 工具.唯一编号()
    检查("唯一编号 返回非空文本", 编号甲.长度() > 0 且 编号乙.长度() > 0)
    检查("唯一编号 两次不同", 编号甲 != 编号乙)
    编号丙 = 工具.唯一编号()
    检查("生成唯一编号 返回非空文本", 编号丙.长度() > 0)

    输出("")
    输出("===== 工具模块测试汇总 =====")
    输出("总数=" + 转文本(本模块.总数) + " 通过=" + 转文本(本模块.通过数) + " 失败=" + 转文本(本模块.失败数))
结束
