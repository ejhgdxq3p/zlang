// ============================================================
// 初始化与资源释放方法测试（2026-09-16 修订）
// 覆盖规范：初始化无参数列表、无返回类型、不能重载、可使用无返回值返回语句；
//   `清理` 已解除保留名 —— 不再是生命周期方法、不再自动调用；
//   资源释放改为「用户自定义方法 + 显式调用」（推荐配合 `始终:` 块，见 精准测试案例/56）。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 初始化：无参数列表、无返回类型、可使用无返回值返回语句 ──
结构体 用户3(文本 姓名, 整数 年龄):
    整数 实际年龄 = 0
    获取年龄() 整数:
        返回 自身.实际年龄
    结束
    初始化():
        如果 年龄 > 150:
            自身.实际年龄 = 0
        否则:
            自身.实际年龄 = 年龄
        结束
    结束
结束

// ── 资源释放：普通方法，由持有者显式调用（无自动析构） ──
资源释放计数 = 0

结构体 资源(整数 标识):
    私有 逻辑 已释放 = 假
    初始化():
        输出("创建资源" + 转文本(标识))
    结束
    关闭():
        本模块.资源释放计数 = 本模块.资源释放计数 + 1
        自身.已释放 = 真
    结束
    是否已释放() 逻辑:
        返回 自身.已释放
    结束
    获取标识() 整数:
        返回 标识
    结束
结束

测试_初始化提前返回():
    超大年龄用户 = 用户3("张三", 200)
    检查("初始化-年龄>150提前返回并置0", 超大年龄用户.获取年龄() == 0)
    正常用户 = 用户3("李四", 30)
    检查("初始化-正常年龄30", 正常用户.获取年龄() == 30)
结束

测试_资源显式释放():
    临时 = 资源(99)
    检查("创建实例不自动释放", 本模块.资源释放计数 == 0)
    临时.关闭()
    检查("显式调用后释放计数增加", 本模块.资源释放计数 == 1)
    检查("释放状态已置位", 临时.是否已释放())
结束

启动程序():
    输出("========== 初始化与资源释放方法测试 ==========")
    测试_初始化提前返回()
    测试_资源显式释放()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
