// 规范 §2.9.5 递归聚合：中间层聚合到的成员应随聚合链透传
//   中间聚合 = 聚合导入 聚合校验/基础库（默认）⇒ 公开成员为子命名空间 基础库
//   递归聚合 = 聚合导入 聚合校验/中间聚合 展开 ⇒ 展开后仍应保留 基础库 子命名空间
导入 聚合校验/递归聚合 展开

通过数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    结束
结束

启动程序():
    输出("===== §2.9.5 递归聚合（默认形式透传） =====")

    检查("递归: 基础库.求平方(8)=64", 基础库.求平方(8) == 64)
    检查("递归: 基础库.公开变量=100", 基础库.公开变量 == 100)
    检查("递归: 基础库.公开常量=2.5", 基础库.公开常量 == 2.5)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
