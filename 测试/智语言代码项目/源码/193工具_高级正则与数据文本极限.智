启动程序():
    输出("=== 193 工具 高级正则与 JSON ===")
    // ① 正则：量词与字符类
    检查("量词-{2,3}", 工具.正则匹配("甲{2,3}", "甲甲甲甲").长度() >= 1)
    检查("量词-+", 工具.正则匹配("甲+", "乙甲甲丙").长度() == 1)
    检查("量词-*", 工具.正则匹配("甲*乙", "乙").长度() == 1)
    检查("量词-?", 工具.正则匹配("甲?乙", "乙").长度() == 1)
    检查("字符类-区间", 工具.正则匹配("[a-z]+", "12abc34").长度() == 1)
    检查("字符类-排除", 工具.正则匹配("[^0-9]+", "12abc34").长度() == 1)
    // ② 正则：分组与交替
    检查("分组-括号", 工具.正则匹配("(甲|乙)丙", "乙丙").长度() == 1)
    检查("交替-多选择", 工具.正则匹配("甲|乙|丙", "乙").长度() == 1)
    // ③ 正则：转义（F13 修复后可用反斜杠）
    检查("转义-字面点", 工具.正则匹配("甲\反斜杠.乙", "甲.乙").长度() == 1)
    检查("转义-字面反斜杠", 工具.正则匹配("甲\反斜杠\反斜杠乙", "甲\反斜杠乙").长度() == 1)
    检查("转义-数字类", 工具.正则匹配("\反斜杠d{3}", "abc123def").长度() == 1)
    检查("转义-空白类", 工具.正则匹配("\反斜杠s+", "甲乙  丙").长度() == 1)
    检查("转义-词类", 工具.正则匹配("\反斜杠w+", "甲a乙b").长度() >= 1)
    // ④ 正则：锚点与多匹配顺序
    多项 = 工具.正则匹配("\反斜杠d+", "a1b22c333")
    检查("多匹配-数量3", 多项.长度() == 3)
    检查("多匹配-顺序保持", 多项[1] == "1" 且 多项[2] == "22" 且 多项[3] == "333")
    检查("锚点-首", 工具.正则匹配("^\反斜杠d+", "123abc").长度() == 1)
    检查("锚点-尾", 工具.正则匹配("\反斜杠d+$", "abc123").长度() == 1)
    检查("锚点-整串不匹配", 工具.正则匹配("^\反斜杠d+$", "123abc").长度() == 0)
    // ⑤ 正则替换：多组与特殊字符
    检查("替换-多组替换", 工具.正则替换("\反斜杠d+", "*", "甲1乙22丙333") == "甲*乙*丙*")
    检查("替换-中文模式", 工具.正则替换("甲+", "X", "甲甲乙甲") == "X乙X")
    检查("替换-无匹配原样", 工具.正则替换("\反斜杠d+", "*", "甲乙丙") == "甲乙丙")
    检查("替换-替换为空", 工具.正则替换("\反斜杠d+", "", "甲1乙") == "甲乙")
    // ⑥ JSON：深层嵌套 / 数组套映射 / 转义 / Unicode
    深 = {"甲": {"乙": {"丙": [1, {"丁": "戊"}]}}}
    深文 = 工具.生成数据("JSON", 深)
    深回 = 工具.解析数据("JSON", 深文)
    检查("JSON-三层嵌套取值", 深回.获取("甲").获取("乙").获取("丙")[2].获取("丁") == "戊")
    检查("JSON-嵌套数组长度", 深回.获取("甲").获取("乙").获取("丙").长度() == 2)
    检查("JSON-嵌套数组整数值", 深回.获取("甲").获取("乙").获取("丙")[1] == 1)
    含特殊 = {"键": "含,逗号 与 冒号: 与 引号"}
    特文 = 工具.生成数据("JSON", 含特殊)
    特回 = 工具.解析数据("JSON", 特文)
    检查("JSON-特殊字符往返长度", 特回.获取("键").长度() == 含特殊.获取("键").长度())
    含中文 = {"名": "张三", "城市": "北京"}
    中文回 = 工具.解析数据("JSON", 工具.生成数据("JSON", 含中文))
    检查("JSON-中文值往返", 中文回.获取("名") == "张三" 且 中文回.获取("城市") == "北京")
    空映射回 = 工具.解析数据("JSON", 工具.生成数据("JSON", {}))
    检查("JSON-空映射往返", 空映射回.长度() == 0)
    数组回 = 工具.解析数据("JSON", 工具.生成数据("JSON", ["甲", "乙"]))
    检查("JSON-纯数组往返", 数组回.长度() == 2 且 数组回[2] == "乙")
    // ⑦ BASE64 边界
    检查("BASE64-单字符往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "甲")) == "甲")
    检查("BASE64-长串往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "智语言编程规范文档内容测试")) == "智语言编程规范文档内容测试")
    记录("BASE64-甲编码长度", 转文本(工具.编码方案("BASE64", "甲").长度()))
    // ⑧ 哈希一致性（同输入同输出，不同输入不同输出）
    检查("哈希-MD5 确定性", 工具.哈希算法("MD5", "固定输入") == 工具.哈希算法("MD5", "固定输入"))
    检查("哈希-MD5 区分输入", 工具.哈希算法("MD5", "输入甲") != 工具.哈希算法("MD5", "输入乙"))
    检查("哈希-含中文可用", 工具.哈希算法("MD5", "中文内容").长度() == 32)
    收尾()
结束
