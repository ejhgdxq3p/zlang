// 275 时间模块：**格式占位 / 负时间戳 / 日历边界 / 解析容错 / 方向与截断**（2026-10-22）
//
// 与 219 的分工：219 覆盖 §5.4 定稿约定 1~5 的主干；本用例补齐**"时间模块是否好用"的三块硬骨头**：
//   ① `格式化` 的**占位符语义**（格式串里 年/月/日/时/分/秒 是占位符，不是字面量 —— 会误导用户）；
//   ② **负时间戳**的全分量一致性（1970 之前，§5.4 约定 1 要求向下取整的日历计算）；
//   ③ `解析` 的**容错与严格性**（不补零 / 斜杠 / 纯数字直通 vs 不存在日历日必须抛）。
//
// ⚠⚠ 参数顺序（§5.4.1，极易写错）：`时间.格式化(文本 格式, 整数 时间戳)` —— **格式在前**；
//     `时间.解析(文本 时间文本, 文本 格式)` —— **时间文本在前**。两者顺序相反！
//
// 断言值全部来自探针实测（`探针_时间深度.智`）。
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 275 时间模块：格式占位 / 日历边界 / 解析容错 ===")

    // ───────── ① 格式化：参数顺序与占位符 ─────────
    输出("-- ① 格式化 --")
    检查("格式化(年-月-日, 0) = 1970-01-01", 时间.格式化("年-月-日", 0) == "1970-01-01")
    检查("★ 完整格式 = 1970-01-01 00:00:00",
        时间.格式化("年-月-日 时:分:秒", 0) == "1970-01-01 00:00:00")
    检查("★ 负时间戳 -1 = 1969-12-31 23:59:59（§5.4 约定 1）",
        时间.格式化("年-月-日 时:分:秒", 0 - 1) == "1969-12-31 23:59:59")
    检查("格式化(时:分, 3600) = 01:00", 时间.格式化("时:分", 3600) == "01:00")
    检查("格式化(年, 1700000000) = 2023", 时间.格式化("年", 1700000000) == "2023")
    检查("格式化(月-日, 1700000000) = 11-14", 时间.格式化("月-日", 1700000000) == "11-14")
    检查("格式化(年-月-日, -1) = 1969-12-31", 时间.格式化("年-月-日", 0 - 1) == "1969-12-31")
    检查("空格式 ⇒ 空串", 时间.格式化("", 0) == "")
    检查("返回类型 = 文本", 类型(时间.格式化("年", 0)) == "文本")

    // ⚠ 占位符按**单字**替换：格式串里的"时""分""日"等字符会被当作占位符。
    //   实测 `格式化("时间", 0)` ⇒ `00间`（"时"被换成小时）⇒ 想输出字面量必须避免这些字。
    //   属**设计局限**（模板语法无转义），此处**锁定行为**以防实现悄悄改动。
    记录("格式化(时间, 0) 的实际输出（占位符按单字替换）", 时间.格式化("时间", 0))
    检查("★ 已知局限：格式串中的「时」被替换 ⇒ 时间 ⇒ 00间",
        时间.格式化("时间", 0) == "00间")

    // ───────── ② 分量：纪元与星期基准 ─────────
    输出("-- ② 时间分量 --")
    检查("年(0) = 1970", 时间.获取年(0) == 1970)
    检查("月(0) = 1", 时间.获取月(0) == 1)
    检查("日(0) = 1", 时间.获取日(0) == 1)
    检查("时(0) = 0", 时间.获取时(0) == 0)
    检查("分(0) = 0", 时间.获取分(0) == 0)
    检查("秒(0) = 0", 时间.获取秒(0) == 0)
    // 1 = 星期一（§5.4.2）。1970-01-01 是星期四 ⇒ 4 ✓
    检查("★ 星期(0) = 4（1970-01-01 星期四，1=星期一）", 时间.获取星期(0) == 4)
    检查("★ 星期(259200) = 7（第 3 天 = 1970-01-04 星期日）", 时间.获取星期(259200) == 7)
    检查("★ 星期(345600) = 1（第 4 天 = 1970-01-05 星期一）", 时间.获取星期(345600) == 1)
    星期值 = 时间.获取星期(0)
    检查("星期取值域 1..7", 星期值 >= 1 且 星期值 <= 7)

    检查("★ 负时间戳 年(-1) = 1969", 时间.获取年(0 - 1) == 1969)
    检查("★ 负时间戳 月(-1) = 12", 时间.获取月(0 - 1) == 12)
    检查("★ 负时间戳 日(-1) = 31", 时间.获取日(0 - 1) == 31)
    检查("★ 负时间戳 时(-1) = 23", 时间.获取时(0 - 1) == 23)
    检查("★ 负时间戳 秒(-1) = 59", 时间.获取秒(0 - 1) == 59)
    检查("★ 负时间戳 星期(-1) = 3（1969-12-31 星期三）", 时间.获取星期(0 - 1) == 3)

    // ───────── ③ 计算：加/减/间隔天数方向与截断 ─────────
    输出("-- ③ 时间计算 --")
    检查("加(0, 3600) = 3600", 时间.加(0, 3600) == 3600)
    检查("减(0, 3600) = -3600", 时间.减(0, 3600) == 0 - 3600)
    检查("加(0, 0) = 0（加零不变）", 时间.加(0, 0) == 0)
    检查("加(0, -3600) 等价 减", 时间.加(0, 0 - 3600) == 0 - 3600)
    检查("★ 间隔天数(86400, 0) = 1（方向：甲−乙，§5.4 约定 3）", 时间.间隔天数(86400, 0) == 1)
    检查("★ 间隔天数(0, 86400) = -1（反向为负）", 时间.间隔天数(0, 86400) == 0 - 1)
    检查("★ 间隔天数(86399, 0) = 0（向零截断）", 时间.间隔天数(86399, 0) == 0)
    检查("★ 间隔天数(86400, 1) = 0（86399 秒不足一天）", 时间.间隔天数(86400, 1) == 0)
    检查("间隔天数(172800, 0) = 2", 时间.间隔天数(172800, 0) == 2)
    检查("间隔天数(甲, 甲) = 0（自反）", 时间.间隔天数(12345, 12345) == 0)

    溢出被拒 = 假
    溢出描述 = ""
    捕获:
        溢出值 = 时间.加(9223372036854775807, 1)
        记录("加 溢出未抛，得到", 转文本(溢出值))
    异常:
        溢出被拒 = 真
        溢出描述 = 异常错误().描述
    结束
    // ⚠ 描述里不能出现 "panic" 字样（门禁错误标志含该词，会把正常通过误判为运行出错）
    检查("★ 加 溢出 ⇒ 抛可捕获异常（不回绕、进程不崩溃，§5.4 约定 2）", 溢出被拒)
    记录("溢出文案是否含「超出整数范围」", 转文本(溢出描述.是否包含("超出整数范围")))

    // ───────── ④ 解析：容错（宽松）与严格（日历日）─────────
    输出("-- ④ 时间解析 --")
    标准 = 时间.解析("2024-01-05", "年-月-日")
    记录("2024-01-05 的时间戳", 转文本(标准))
    检查("解析 2024-01-05 得 1704412800", 标准 == 1704412800)
    检查("★ 不补零 2024-1-5 等价（§5.4 约定 4）", 时间.解析("2024-1-5", "年-月-日") == 标准)
    检查("★ 斜杠 2024/01/05 等价", 时间.解析("2024/01/05", "年/月/日") == 标准)
    检查("★ 带时分秒：2024-01-05 06:07:08 = 标准 + 22028 秒",
        时间.解析("2024-01-05 06:07:08", "年-月-日 时:分:秒") == 标准 + 22028)
    检查("★ 纯数字串按时间戳直通（\引号0\引号 ⇒ 0）", 时间.解析("0", "年-月-日") == 0)
    检查("闰年 2 月 29 合法 ⇒ 1709164800", 时间.解析("2024-02-29", "年-月-日") == 1709164800)

    非闰年229被拒 = 假
    捕获:
        错一 = 时间.解析("2023-02-29", "年-月-日")
        记录("2023-02-29 未抛，得到", 转文本(错一))
    异常:
        非闰年229被拒 = 真
    结束
    检查("★★ 非闰年 2023-02-29 ⇒ 抛异常（不静默规整到 3-1）", 非闰年229被拒)

    四月卅一被拒 = 假
    捕获:
        错二 = 时间.解析("2024-04-31", "年-月-日")
        记录("2024-04-31 未抛，得到", 转文本(错二))
    异常:
        四月卅一被拒 = 真
    结束
    检查("★★ 2024-04-31 ⇒ 抛异常（4 月只有 30 天）", 四月卅一被拒)

    十三月被拒 = 假
    捕获:
        错三 = 时间.解析("2024-13-01", "年-月-日")
        记录("13 月未抛，得到", 转文本(错三))
    异常:
        十三月被拒 = 真
    结束
    检查("★ 13 月 ⇒ 抛异常", 十三月被拒)

    空串被拒 = 假
    捕获:
        错四 = 时间.解析("", "年-月-日")
        记录("空串未抛，得到", 转文本(错四))
    异常:
        空串被拒 = 真
    结束
    检查("★ 空串 ⇒ 抛异常（不返回 0 之类的默认值）", 空串被拒)

    // ───────── ⑤ 计时 ─────────
    输出("-- ⑤ 计时 --")
    计时一 = 时间.获取计时器()
    计时二 = 时间.获取计时器()
    检查("获取计时器 单调不减", 计时二 >= 计时一)
    检查("获取计时器 返回非负", 计时一 >= 0)
    检查("获取计时器 返回类型 = 整数", 类型(计时一) == "整数")
    起始 = 时间.获取计时器()
    时间.休眠(120)
    经过 = 时间.获取计时器() - 起始
    记录("休眠 120ms 后实际经过（毫秒）", 转文本(经过 >= 100))
    检查("★ 休眠 120ms 后 经过 >= 100ms（不为 0）", 经过 >= 100)
    检查("休眠 不改变时间戳语义（加 0 秒不干扰）", 时间.加(0, 0) == 0)

    // ───────── ⑥ 当前时间：类型与量级 ─────────
    输出("-- ⑥ 当前时间 --")
    现在 = 时间.当前时间()
    检查("当前时间 返回整数", 类型(现在) == "整数")
    检查("★ 当前时间 量级合理（> 2020-01-01 的 1577836800）", 现在 > 1577836800)
    毫秒 = 时间.当前毫秒时间()
    检查("当前毫秒时间 返回整数", 类型(毫秒) == "整数")
    检查("★ 毫秒时间 ≈ 秒时间 × 1000（差值在 1 天内）",
        毫秒 > 0 且 毫秒 / 1000 >= 现在 - 86400 且 毫秒 / 1000 <= 现在 + 86400)

    收尾()
结束
