// 正向回归（2026-09-21）：**新建值免拷贝**（可证明的拷贝省略）与**计数正确性**。
//
//   判据 `是新建值`（`创建结构体` / 复合字面量）：**本语句新产生、句柄从未外泄 ⇒ 不可能是别名**
//     ⇒ 值语义存储可**安全省略深拷贝**（本语句独占该新对象，直接"移动"入槽 / 入容器 / 入字段）。
//   · 顺带消除旧实现的一处泄漏：原先对新建值**也深拷贝** ⇒ 原对象从此无人引用、也无人释放。
//   · **记账差异（关键）**：`操作码::存储`（局部槽/全局槽）是**移动语义、不 +1**（故无需 −1）；
//     而 base 的**字段/容器存储类**对写入值 **+1** ⇒ 必须有配套 −1 平衡（否则计数虚高 ⇒ 泄漏）。
//   本用例覆盖：循环声明 / 循环覆盖 / 容器元素 / 字段写入 / 既有值仍须深拷贝（隔离不变）。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 单车(整数 初速):
    整数 速度 = 初速
    改速(整数 新速):
        自身.速度 = 新速
    结束
    取速度() 整数:
        返回 自身.速度
    结束
结束

启动程序():
    // ① 循环内「声明 + 新建值」（覆盖释放 + 免拷贝）
    轮数 = 0
    甲 = 单车(0)
    整数 序1 = 1
    循环 序1 <= 2000:
        甲 = 单车(序1)
        轮数 = 轮数 + 1
        序1 = 序1 + 1
    结束
    检查("循环新建-最终值正确", 甲.取速度() == 2000)
    检查("循环新建-轮数", 轮数 == 2000)

    // ② 循环内「覆盖赋值」（同一槽反复写入新建值）
    乙 = 单车(0)
    整数 序2 = 1
    循环 序2 <= 100:
        乙 = 单车(序2)
        序2 = 序2 + 1
    结束
    检查("循环覆盖-最终值", 乙.取速度() == 100)

    // ③ 容器元素为新建值（base 容器存储 +1 ⇒ 需配套 −1）
    数组<单车> 列表 = []
    整数 序3 = 1
    循环 序3 <= 50:
        列表.追加(单车(序3))
        序3 = 序3 + 1
    结束
    检查("容器新建元素-长度", 列表.长度() == 50)
    检查("容器新建元素-首", 列表[1].取速度() == 1)
    检查("容器新建元素-末", 列表[50].取速度() == 50)

    // ④ 字段写入为新建值
    盒 = 单车(9)
    盒.改速(11)
    检查("字段写入-方法内", 盒.取速度() == 11)

    // ⑤ 既有值仍必须深拷贝（隔离不变）
    源 = 单车(5)
    副 = 源
    副.改速(77)
    检查("既有值-副本被改", 副.取速度() == 77)
    检查("既有值-原值不受影响", 源.取速度() == 5)

    // ⑥ 数组既有值仍须深拷贝（隔离不变）
    数组甲 = [1, 2, 3]
    数组乙 = 数组甲
    数组乙.追加(4)
    检查("数组既有值-副本变化", 数组乙.长度() == 4)
    检查("数组既有值-原件不变", 数组甲.长度() == 3)

    // ⑦ 字面量直接入槽（免拷贝路径）语义正确
    数组丙 = [9, 8, 7]
    检查("字面量入槽-长度", 数组丙.长度() == 3)
    检查("字面量入槽-首元素", 数组丙[1] == 9)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
