// ============================================================
// 枚举 全面测试（简单枚举，无载荷 —— 双模安全）
// 覆盖：简单枚举定义、成员访问(枚举名.成员名)、等值/不等比较、枚举作函数参数。
// 语法严格符合编程规范文档 §2.1.6 / §枚举章节
// 注：数据枚举(带载荷)的编译模式存在 parity 崩溃 bug，单独放 76数据枚举载荷测试.智 仅解释模式运行。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 简单枚举 ──
枚举 颜色:
    红色
    绿色
    蓝色
结束

// ── 枚举作为变量/参数 ──
描述颜色(颜色 色) 文本:
    如果 色 == 颜色.红色:
        返回 "红"
    否则如果 色 == 颜色.绿色:
        返回 "绿"
    否则:
        返回 "蓝"
    结束
结束

// ── 测试 ──
测试_简单枚举():
    红 = 颜色.红色
    绿 = 颜色.绿色
    检查("简单枚举 成员可访问", 红 == 颜色.红色)
    检查("简单枚举 等值 红==红", 红 == 颜色.红色)
    检查("简单枚举 不等 红!=绿", 红 != 绿)
    检查("简单枚举 作参数 红->红", 描述颜色(红) == "红")
    检查("简单枚举 作参数 绿->绿", 描述颜色(绿) == "绿")
    检查("简单枚举 作参数 蓝->蓝", 描述颜色(颜色.蓝色) == "蓝")
    检查("简单枚举 变量传递 红==红", 红 == 红)
    检查("简单枚举 多成员 蓝存在", 颜色.蓝色 != 颜色.红色)
结束

// ── 主入口 ──
启动程序():
    输出("========== 枚举(简单) 全面测试 ==========")
    测试_简单枚举()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
