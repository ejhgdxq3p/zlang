// 56 诊断：干净数组（无前置 追加）取末尾 是否也损坏接收者
启动程序():
    取末数组 = [10, 20, 30, 40, 50]
    末位 = 取末数组.取末尾()
    输出("干净数组 末位=" + 转文本(末位))
    输出("干净数组 取末尾后 类型=" + 类型(取末数组))
    输出("干净数组 取末尾后 长度=" + 转文本(取末数组.长度()))

    水果 = ["苹果", "香蕉", "橙子"]
    末2 = 水果.取末尾()
    输出("水果 末位=" + 转文本(末2))
    输出("水果 取末尾后 类型=" + 类型(水果))
结束
