    检查("嵌套数组: 原嵌套甲[2][2] 不变(=4)", 嵌套甲[2][2] == 4)
    检查("嵌套数组: 副本嵌套乙[1][1] 已改(=40)", 嵌套乙[1][1] == 40)
    检查("嵌套数组: 副本嵌套乙[1][2] 不变(=2)", 嵌套乙[1][2] == 2)

    输出("通过: " + 转文本(本模块.通过数) + "/" + 转文本(本模块.总数))
