// 嵌套甲 = [[1,2],[3,4]]
//   - 嵌套甲[1][1]=1, 嵌套甲[1][2]=2
//   - 嵌套甲[2][1]=3, 嵌套甲[2][2]=4
// 深拷贝生效后：修改嵌套乙不应影响嵌套甲任何位置。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  PASS " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
