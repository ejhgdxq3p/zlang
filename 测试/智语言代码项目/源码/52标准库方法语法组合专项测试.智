启动程序():
    // ============ 1. 标准库方法 命名参数调用（规范 2.3.7） ============
    输出("===== 1. 方法命名参数调用 =====")
    文本1 = "你好世界"
    // 文本.截取 命名参数（跳过/乱序）
    检查("文本.截取(起始=1,长度=2)='你好'", 文本1.截取(起始 = 1, 长度 = 2) == "你好")
    检查("文本.截取 乱序(长度=3,起始=3)='世界'", 文本1.截取(长度 = 3, 起始 = 3) == "世界")
    // 数组.插入 命名参数
    列表 = [10, 20, 30]
    列表.插入(索引 = 2, 新元素 = 99)
    检查("数组.插入(索引=2,新元素=99) 后[2]=99", 列表[2] == 99)
    // 映射.插入 命名参数
    映射1 = {"键": 1}
    映射1.插入(键 = "新", 值 = 2)
    检查("映射.插入(键='新',值=2) 含'新'", 映射1.是否包含("新") == 真)

    // ============ 2. 输出 单参数（规范 §4.1：输出(文本 内容)，非文本须显式 转文本） ============
    输出("===== 2. 输出单参数 =====")
    // 2026-10-19：全局函数形参补登记后，输出/错误输出 明确为**单参数**；多参数属非法调用
    //   （此前静默丢弃多余实参）。多值拼接用文本连接：转文本(10) + 真/假 + 转文本(3.14)。
    输出("多参数拼接:" + 转文本(10) + "逻辑真" + 转文本(3.14) + "结尾")
    检查("输出单参数 + 显式转文本拼接可用", 真)

    // ============ 3. 方法返回值参与 算术/比较 运算 ============
    输出("===== 3. 方法返回值参与运算 =====")
    检查("文本.长度()*2 = 8", "你好世界".长度() * 2 == 8)
    检查("数组.长度()+1 = 4", [1, 2, 3].长度() + 1 == 4)
    检查("映射.长度()==1", {"a": 1}.长度() == 1)
    检查("文本.查找()>0 参与比较", "abc".查找("b") > 0)
    检查("数组.查找索引() 参与比较", [5, 6, 7].查找索引(6) == 2)

    // ============ 4. 全局函数 嵌套调用 ============
    输出("===== 4. 全局函数嵌套调用 =====")
    检查("转整数(转文本(42))=42", 转整数(转文本(42)) == 42)
    检查("转文本(转整数('100'))='100'", 转文本(转整数("100")) == "100")
    检查("转小数(转整数(3))=3.0", 转小数(转整数(3)) == 3.0)
    检查("类型(转文本(42))='文本'", 类型(转文本(42)) == "文本")
    检查("转文本('你好').长度()=2", "你好".长度() == 2)

    // ============ 5. 文本方法 链式组合 ============
    输出("===== 5. 文本方法链式组合 =====")
    // 字面量直接三连链式（规范示例写法，合法）：去除空白().替换().截取()
    检查("文本 链式三连 去除空白().替换().截取()", "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2) == "你好")
    // 字面量两连：截取().查找()（用类型标注变量规避链式中间返回推断限制）
    文本 段 = "Hello World".截取(1, 5)
    检查("文本 链式两连 截取().查找()", 段.查找("Hello") == 1)
    // 字面量两连：分隔().长度()
    检查("文本 链式两连 分隔().长度()", "a,b,c".分隔(",").长度() == 3)

    // ============ 6. 数组/映射 方法 返回值再调用方法 ============
    输出("===== 6. 容器方法返回值再调用方法 =====")
    表 = {"分数": [80, 90, 70], "等级": [1, 2, 3]}
    // 映射.获取 返回任意类型，链式 .长度() 需先赋值规避类型推断限制
    分数表 = 表.获取("分数")
    检查("映射.获取(数组).长度()=3", 分数表.长度() == 3)
    所有键 = 表.所有键()
    检查("映射.所有键().长度()=2", 所有键.长度() == 2)
    所有值 = 表.所有值()
    检查("映射.所有值().长度()=2", 所有值.长度() == 2)
    数字串 = ["1", "2", "3"]
    检查("数组.映射思路：所有元素文本化后长度", 数字串.长度() == 3)

    // ============ 7. 方法调用与 全局函数 混合 ============
    输出("===== 7. 方法 + 全局函数混合 =====")
    检查("转文本(数组.长度()) 混合", 转文本([1, 2, 3, 4].长度()) == "4")
    检查("转整数(文本.截取()返回) 混合", 转整数("12345".截取(1, 2)) == 12)
    检查("文本.长度() 方法形式 基础", "测试".长度() == 2)

    // 注：遍历/条件 控制流内调用标准库方法 已独立到 52b 文件（本文件过大时解析器状态累积触发遍历解析异常，独立文件正常）

    输出("")
    输出("===== 52 标准库方法语法组合专项 结果汇总 =====")
