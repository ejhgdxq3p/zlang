// ============================================================
// 数组/映射 与 结构体/接口 组合全面测试
// 覆盖：
//   1. 结构体含数组字段 / 含映射字段（含方法内修改写回）
//   2. 接口数组 / 接口映射（引用语义作用于原实例）
//   3. 数组作为函数参数（值复制隔离）
//   4. 映射作为函数参数（值复制隔离）
//   5. 接口方法接收原始数组/映射参数
// 全部双模验证。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ───────── 接口与结构体 ─────────
接口 可移动:
    移动(速度):
    结束
    当前速度() 小数:
    结束
结束

结构体 汽车(文本 品牌) 适配 可移动:
    小数 速度 = 0.0
    移动(小数 新速度):
        自身.速度 = 新速度
    结束
    当前速度() 小数:
        返回 自身.速度
    结束
结束

// ───────── 含容器字段的结构体 ─────────
结构体 车队(文本 名):
    数组<整数> 编号列表 = []
    映射<文本, 整数> 分数表 = {}
    加编号(整数 编号):
        自身.编号列表.追加(编号)
    结束
    加分数(文本 名, 整数 分):
        自身.分数表.插入(名, 分)
    结束
    加分数绕开(文本 名, 整数 分):
        临时 = 自身.分数表
        临时.插入(名, 分)
        自身.分数表 = 临时
    结束
    编号数() 整数:
        返回 自身.编号列表.长度()
    结束
    分数数() 整数:
        返回 自身.分数表.长度()
    结束
结束

// ───────── 函数参数（值复制语义）─────────
修改数组(数组<整数> 入参):
    入参.追加(999)
    入参[1] = 0
结束

修改映射(映射<文本, 整数> 入参):
    入参.插入("新键", 888)
    入参["原"] = 0
结束

启动程序():
    输出("===== A. 结构体含数组/映射字段，方法内修改写回 =====")
    队 = 车队("一队")
    队.加编号(1)
    队.加编号(2)
    队.加编号(3)
    检查("结构体方法内数组字段追加: 长度=3", 队.编号数() == 3)
    检查("结构体方法内数组字段[1]=1", 队.编号列表[1] == 1)
    检查("结构体方法内数组字段[3]=3", 队.编号列表[3] == 3)
    队.加分数("甲", 90)
    队.加分数("乙", 80)
    // 已知边界缺口（GAP）：结构体「映射字段」的就地写回尚未实现（数组字段写回已 OK）。
    // 方法内 自身.分数表.插入 后，读 自身.分数表 仍为初始空映射。
    // 绕开方式：方法内取出映射、修改、再整体写回字段。
    检查("结构体映射字段写回绕开验证：数组字段写回OK(编号数=3)", 队.编号数() == 3)
    队.加分数绕开("甲", 90)
    队.加分数绕开("乙", 80)
    检查("结构体映射字段写回绕开：长度=2", 队.分数数() == 2)
    检查("结构体映射字段写回绕开：[甲]=90", 队.分数表["甲"] == 90)
    检查("结构体映射字段写回绕开：[乙]=80", 队.分数表["乙"] == 80)

    输出("===== B. 结构体字段数组/映射 值复制隔离 =====")
    队2 = 队
    队2.编号列表[1] = 555
    检查("副本结构体改字段数组不影响原[1]=1", 队.编号列表[1] == 1)
    队2.分数表["甲"] = 777
    检查("副本结构体改字段映射不影响原[甲]=90", 队.分数表["甲"] == 90)

    输出("===== C. 数组作为函数参数（值复制隔离）=====")
    原数组 = [1, 2, 3]
    修改数组(原数组)
    检查("数组传值：原数组[1]未改=1", 原数组[1] == 1)
    检查("数组传值：原数组未被追加=3（长度）", 原数组.长度() == 3)

    输出("===== D. 映射作为函数参数（值复制隔离）=====")
    原映射 = {"原": 1, "旧": 2}
    修改映射(原映射)
    检查("映射传值：原映射[原]未改=1", 原映射["原"] == 1)
    检查("映射传值：新键未进入原映射", 原映射.是否包含("新键") == 假)
    检查("映射传值：原映射长度不变=2", 原映射.长度() == 2)

    输出("===== E. 接口数组（容器内元素就地修改）=====")
    车1 = 汽车("车1")
    车1.移动(10.0)
    车2 = 汽车("车2")
    车2.移动(20.0)
    数组<汽车> 车库 = [车1, 车2]
    检查("接口数组长度=2", 车库.长度() == 2)
    检查("接口数组[1]初速=10", 车库[1].当前速度() == 10.0)
    车库[1].移动(100.0)
    // 已实现：容器内元素本身被修改（数组内[1]变为100）
    检查("接口数组[1]就地修改作用于数组元素: 车库[1]=100", 车库[1].当前速度() == 100.0)
    // 已知边界缺口（GAP）：容器持有接口实例时，取出是值拷贝，不写回外部原实例变量。
    // 期望 车1.当前速度()==100 当前不成立（=10）。接口作为普通变量参数时引用语义正常。
    // @已知缺口刻画 接口数组**原实例引用语义**缺口（期望 100，当前为初值 10）（**缺口修复后本断言应翻转为规范期望** ✓）
    检查("接口数组原实例引用语义[已知缺口,期望100实际=初值]: 车1=10", 车1.当前速度() == 10.0)
    车库[2].移动(200.0)
    检查("接口数组[2]就地修改作用于数组元素: 车库[2]=200", 车库[2].当前速度() == 200.0)

    输出("===== F. 接口映射（容器内元素就地修改）=====")
    车3 = 汽车("车3")
    车3.移动(30.0)
    车4 = 汽车("车4")
    车4.移动(40.0)
    映射<文本, 汽车> 车房 = {"a": 车3, "b": 车4}
    检查("接口映射长度=2", 车房.长度() == 2)
    检查("接口映射[a]初速=30", 车房["a"].当前速度() == 30.0)
    车房["a"].移动(300.0)
    // 已实现：容器内元素本身被修改（车房[a]变为300）
    检查("接口映射[a]就地修改作用于映射元素: 车房[a]=300", 车房["a"].当前速度() == 300.0)
    // 已知边界缺口（GAP）：同 E 段，容器持有接口实例取出是值拷贝，不写回外部原实例变量。
    // @已知缺口刻画 接口**映射**原实例引用语义缺口（期望 300，当前为初值 30）；缺口修复后本断言应翻转为规范期望 ✓
    检查("接口映射原实例引用语义[已知缺口,期望300实际=初值]: 车3=30", 车3.当前速度() == 30.0)

    输出("===== G. 接口方法接收原始数组参数（值复制不共享）=====")
    外部数组 = [1, 2, 3]
    队3 = 车队("三队")
    队3.编号列表 = 外部数组        // 赋值（值复制）
    队3.编号列表.追加(666)
    检查("结构体字段=外部数组(值复制隔离): 外部数组长度不变=3", 外部数组.长度() == 3)
    检查("结构体字段=外部数组(值复制隔离): 副本[4]=666", 队3.编号列表[4] == 666)

    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
