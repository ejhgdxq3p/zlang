// 规范 §5.6 工具模块（共 8 个）：正则 2 / 数据格式 2 / 哈希 1 / 编码 2 / 唯一标识 1
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 165 工具模块 ===")
    // ⚠ 缺口 F6（2026-09-27 实测）：规范 §5.6 正则示例写作 `"\\d+"`，
    //   但实现报「无效的转义序列【\\】/【\\d+】」⇒ 该写法**不可用**。
    //   本用例改用等价的字符类 `[0-9]+`（可正常匹配）以继续覆盖功能面。
    //   待决：实现支持 `\\` 转义，或规范示例改用字符类。
    // ① 正则匹配
    数字数组 = 工具.正则匹配("[0-9]+", "abc123def456")
    检查("正则匹配-命中个数", 数字数组.长度() == 2)
    检查("正则匹配-首个匹配", 数字数组[1] == "123")
    检查("正则匹配-次个匹配", 数字数组[2] == "456")
    检查("正则匹配-无命中", 工具.正则匹配("[0-9]+", "abcdef").长度() == 0)
    // ② 正则替换
    脱敏 = 工具.正则替换("[0-9]{11}", "138****8000", "我的电话是13800138000")
    检查("正则替换-结果", 脱敏 == "我的电话是138****8000")
    // ③ 哈希算法
    哈希结果甲 = 工具.哈希算法("MD5", "hello world")
    检查("哈希-MD5长度32", 哈希结果甲.长度() == 32)
    哈希结果乙 = 工具.哈希算法("SHA256", "hello world")
    检查("哈希-SHA256长度64", 哈希结果乙.长度() == 64)
    检查("哈希-同输入同结果", 工具.哈希算法("MD5", "hello world") == 哈希结果甲)
    检查("哈希-不同输入不同结果", 工具.哈希算法("MD5", "hello world!") != 哈希结果甲)
    // ④ 编码 / 解码
    原始文本 = "你好，智语言！"
    编码结果 = 工具.编码方案("BASE64", 原始文本)
    检查("编码-BASE64非空", 编码结果.长度() > 0)
    检查("编码-BASE64与原串不同", 编码结果 != 原始文本)
    解码结果 = 工具.解码方案("BASE64", 编码结果)
    检查("解码-BASE64还原", 解码结果 == 原始文本)
    // ⑤ 数据格式（映射 → JSON → 映射 往返）
    用户数据 = {"姓名": "李四", "年龄": 30}
    数据文本 = 工具.生成数据("JSON", 用户数据)
    检查("生成数据-JSON非空", 数据文本.长度() > 0)
    解析结果 = 工具.解析数据("JSON", 数据文本)
    检查("解析数据-可获取姓名", 解析结果.获取("姓名") == "李四")
    检查("解析数据-可获取年龄", 解析结果.获取("年龄") == 30)
    // ⑥ 唯一标识
    编号1 = 工具.唯一编号()
    编号2 = 工具.唯一编号()
    检查("唯一编号-非空", 编号1.长度() > 0)
    检查("唯一编号-两次不同", 编号1 != 编号2)
    收尾()
结束
