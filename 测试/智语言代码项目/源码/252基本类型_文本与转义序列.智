// 覆盖《智语言编程规范》§2.4.1「文本类型」：
//   双引号包裹、任意 Unicode 字符、无固定长度上限（受内存限制）；
//   文本操作：+ 拼接、.长度()、.是否包含()；转义序列 \换行 \制表 \引号 \反斜杠（各产生 1 个字符）
// 语法事实（实测）：转义序列用**中文名**（\换行 \回车 \制表 \退格 \换页 \空字符 \引号 \反斜杠 \Uxxxxxx）；
//   反斜杠的转义是 `\反斜杠`，**不是** `\\`（写 `\\` 报「无效的转义序列【\】」）。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 252 文本与转义序列（§2.4.1）===")

    文本 姓名 = "小明"
    问候 = "你好，世界！"
    空文本 = ""

    检查("文本长度（中文按字符计）", 姓名.长度() == 2)
    检查("空文本长度 = 0", 空文本.长度() == 0)
    检查("是否包含方法", 问候.是否包含("世界") == 真)
    检查("加号拼接", 姓名 + "同学" == "小明同学")
    检查("Unicode 扩展字符可用", "𠀀".长度() >= 1)

    // 转义序列：\换行 \制表 \引号 \反斜杠 各为 1 个字符
    换行文本 = "A\换行B"
    制表文本 = "A\制表B"
    引号文本 = "A\引号B"
    反斜杠文本 = "A\反斜杠B"

    检查("换行转义是 1 个字符", 换行文本.长度() == 3)
    检查("制表转义是 1 个字符", 制表文本.长度() == 3)
    检查("引号转义是 1 个字符", 引号文本.长度() == 3)
    检查("反斜杠转义是 1 个字符", 反斜杠文本.长度() == 3)
    检查("换行拼接两段文本长度为 7", ("第一行" + "\换行" + "第二行").长度() == 7)
    检查("引号转义产生双引号字符", 引号文本.是否包含("\引号") == 真)

    收尾()
结束
