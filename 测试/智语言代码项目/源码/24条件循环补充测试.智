// ---------- 条件语句补充 ----------

// 三层嵌套 + 逻辑非前缀
深度嵌套条件() 整数:
    通过计数 = 0
    是否会员 = 真
    是否周末 = 假
    消费 = 200
    如果 是否会员:
        如果 非 是否周末:
            如果 消费 > 100:
                通过计数 = 通过计数 + 1
            结束
        结束
    结束
    返回 通过计数
结束

// 函数内返回分支（多条件链边界）
多条件链(整数 分) 文本:
    如果 分 > 100:
        返回 "超"
    否则如果 分 == 100:
        返回 "满"
    否则如果 分 < 0:
        返回 "负"
    否则:
        返回 "中"
    结束
结束

// 空分支（条件成立但分支体为空，应正常跳过不报错）
空分支() 整数:
    标记 = 0
    如果 假:
        // 空体
    结束
    如果 真:
        标记 = 1
    结束
    返回 标记
结束

// 括号分组组合 (A 且 B) 或 C
括号组合() 整数:
    结果 = 0
    如果 (真 且 假) 或 真:
        结果 = 结果 + 1
    结束
    如果 (假 且 真) 或 假:
        // 不应进入
    否则:
        结果 = 结果 + 1
    结束
    返回 结果
结束

// ---------- 循环语句补充 ----------

// 嵌套循环（乘法表规模）
嵌套循环() 整数:
    计数 = 0
    循环 外圈 = 1, 外圈 <= 3, 外圈 += 1:
        循环 内圈 = 1, 内圈 <= 2, 内圈 += 1:
            计数 = 计数 + 1
        结束
    结束
    返回 计数
结束

// 区间边界：单点区间（起始即满足终止，执行 1 次）
单点区间() 整数:
    计数 = 0
    循环 单点 = 5, 单点 <= 5, 单点 += 1:
        计数 = 计数 + 1
    结束
    返回 计数
结束

// 区间边界：反向递减到终止点（执行 1 次）
反向区间边界() 整数:
    计数 = 0
    循环 逆点 = 1, 逆点 >= 1, 逆点 -= 1:
        计数 = 计数 + 1
    结束
    返回 计数
结束

// 数组筛选追加
筛选追加() 整数:
    源 = [85, 58, 92, 66, 45, 78, 95]
    优秀 = []
    不及格 = []
    循环 分 遍历 源:
        如果 分 >= 90:
            优秀.追加(分)
        否则如果 分 < 60:
            不及格.追加(分)
        结束
    结束
    // 优秀(92,95)=2 个，不及格(58,45)=2 个 -> 2 + 20 = 22
    返回 优秀.长度() + 不及格.长度() * 10
结束

// 无限循环菜单（用计数器模拟，避免真正不死循环）
菜单模拟() 文本:
    选择 = 0
    结果 = ""
    安全计数 = 0
    循环 真:
        安全计数 = 安全计数 + 1
        如果 安全计数 >= 100:
            跳出
        结束
        选择 = 选择 + 1
        如果 选择 == 1:
            结果 = "查看"
        否则如果 选择 == 2:
            结果 = "修改"
        否则如果 选择 == 3:
            结果 = "退出"
            跳出
        否则:
            结果 = "无效"
        结束
    结束
    返回 结果
结束

// 基础循环：后置递减到 0 仍执行一次
后置递减() 整数:
    计数 = 0
    降数 = 3
    循环 降数 > 0:
        计数 = 计数 + 1
        降数 = 降数 - 1
    结束
    返回 计数
结束

// 遍历映射并修改值（键保持不变）
映射修改值() 整数:
    库存 = {"苹果": 100, "香蕉": 80, "橙子": 50}
    循环 键, 值 遍历 库存:
        如果 值 < 60:
            库存.插入(键, 值 + 50)
        结束
    结束
    返回 库存.获取("橙子")
结束

