// 306 接手回归（第四轮）：模块级变量在任务、HTTP 处理器与主程序之间共享
// ══════════════════════════════════════════════════════════════════════════
//   一、任务里写模块级变量，主程序能读到 ——解释模式曾只改任务自己的副本
//   二、任务改动模块级容器后，主程序手里的容器仍然有效 ——解释模式曾报「无效句柄」
//   三、HTTP 处理器读写模块级变量 ——解释模式下处理器曾读到空值、写入不生效
// 判据：解释 + 编译 双模一致且全部通过。
// ══════════════════════════════════════════════════════════════════════════
导入 网络
导入 并发
导入 时间
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

访问次数 = 10
名单 = ["甲", "乙"]

处理请求(网络请求 请求) 网络响应:
    本模块.访问次数 = 本模块.访问次数 + 1
    返回 网络.响应成功("第" + 转文本(本模块.访问次数) + "次")
结束

启动程序():
    输出("===== 一、任务写模块级变量 =====")
    本模块.访问次数 = 20
    子任务 = 并发.启动任务(函数() 整数:
        读到 = 本模块.访问次数
        本模块.访问次数 = 99
        本模块.名单.追加("丙")
        返回 读到
    结束)
    任务读到 = 并发.批量等待([子任务], 3000)[1]
    检查("任务读到主程序先前写入的值", 任务读到 == 20)
    检查("主程序读到任务写入的值", 本模块.访问次数 == 99)

    输出("===== 二、任务改动模块级容器 =====")
    整数 长度 = 0
    捕获:
        长度 = 本模块.名单.长度()
    异常:
        长度 = -1
    结束
    检查("容器仍有效且含任务追加的元素", 长度 == 3)

    输出("===== 三、HTTP 处理器读写模块级变量 =====")
    本模块.访问次数 = 0
    服务 = 网络.启动服务(18351, 处理请求, {})
    第一次 = 网络.获取("http://127.0.0.1:18351/", {"超时": 5000}).内容()
    第二次 = 网络.获取("http://127.0.0.1:18351/", {"超时": 5000}).内容()
    服务.关闭()
    检查("处理器内计数随请求累加", 第一次 == "第1次" 且 第二次 == "第2次")
    检查("主程序读到处理器累加后的值", 本模块.访问次数 == 2)

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
