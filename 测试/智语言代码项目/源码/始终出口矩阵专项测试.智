// ============================================================
// 「始终」出口矩阵专项测试（捕获 / 异常 / 始终 执行时机）
// 目标语义：无论从哪个出口离开，始终体都恰好执行一次
//   覆盖出口：正常走完 / 抛出 / 传播 / 裸返回 / 带值返回 / 跳出 / 继续
//   覆盖嵌套：两层始终顺序（内层先、外层后）
// 全部双模验证（解释 + 编译）。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

始终计数 = 0
始终序列 = ""

// ① 带值返回：单层始终
返回单层() 整数:
    捕获:
        返回 42
    始终:
        本模块.始终计数 = 本模块.始终计数 + 1
    结束
结束

// ② 带值返回：两层始终（顺序应为 内 → 外）
返回两层() 整数:
    捕获:
        捕获:
            返回 7
        始终:
            本模块.始终序列 = 本模块.始终序列 + "内"
        结束
    始终:
        本模块.始终序列 = 本模块.始终序列 + "外"
    结束
结束

// ③ 裸返回：始终执行且后续语句不再执行（返回确实生效）
裸返回测试():
    捕获:
        如果 真:
            返回
        结束
    始终:
        本模块.始终计数 = 本模块.始终计数 + 1
    结束
    本模块.始终计数 = 本模块.始终计数 + 100
结束

// ④ 抛出：始终执行 → 异常按语义传播到调用方
抛出后传播() 整数:
    捕获:
        抛出 异常错误("始终出口矩阵-测试抛出")
    始终:
        本模块.始终计数 = 本模块.始终计数 + 1
    结束
    返回 0
结束

// ⑤ 抛出：有异常块 → 吞掉 → 始终仍执行
抛出后被吞() 整数:
    结果 = 0
    捕获:
        抛出 异常错误("始终出口矩阵-测试吞掉")
    异常:
        结果 = 1
    始终:
        本模块.始终计数 = 本模块.始终计数 + 1
    结束
    返回 结果
结束

// ⑥ 异常块内带值返回：始终执行
异常块内返回() 整数:
    捕获:
        抛出 异常错误("始终出口矩阵-异常块内返回")
    异常:
        返回 99
    始终:
        本模块.始终计数 = 本模块.始终计数 + 1
    结束
结束

// ⑦ 循环体内的始终：每一轮都执行
循环每轮 = 0
循环每轮始终() 整数:
    合计 = 0
    序号 = 0
    循环 序号 < 3:
        捕获:
            合计 = 合计 + 1
        始终:
            本模块.循环每轮 = 本模块.循环每轮 + 1
        结束
        序号 = 序号 + 1
    结束
    返回 合计
结束

// ⑧ 捕获块在循环内 + 跳出：始终执行一次后跳出
跳出前始终 = 0
跳出穿越() 整数:
    序号 = 0
    结果 = 0
    循环 序号 < 5:
        捕获:
            如果 序号 == 2:
                跳出
            结束
            结果 = 结果 + 1
        始终:
            本模块.跳出前始终 = 本模块.跳出前始终 + 1
        结束
        序号 = 序号 + 1
    结束
    返回 结果
结束

// ⑨ 捕获块在循环内 + 继续：每次继续前始终都执行
继续前始终 = 0
继续穿越() 整数:
    序号 = 0
    结果 = 0
    循环 序号 < 3:
        序号 = 序号 + 1
        捕获:
            如果 序号 == 2:
                继续
            结束
            结果 = 结果 + 1
        始终:
            本模块.继续前始终 = 本模块.继续前始终 + 1
        结束
    结束
    返回 结果
结束

启动程序():
    输出("##### 「始终」出口矩阵专项测试 #####")

    本模块.始终计数 = 0
    检查("① 带值返回穿越始终-返回值正确", 返回单层() == 42)
    检查("① 带值返回穿越始终-始终已执行", 本模块.始终计数 == 1)

    本模块.始终序列 = ""
    检查("② 两层始终-返回值正确", 返回两层() == 7)
    检查("② 两层始终-顺序为内外", 本模块.始终序列 == "内外")

    本模块.始终计数 = 0
    裸返回测试()
    检查("③ 裸返回穿越始终-始终已执行一次", 本模块.始终计数 == 1)

    本模块.始终计数 = 0
    传播结果 = 0
    捕获:
        传播结果 = 抛出后传播()
    异常:
        传播结果 = -1
    结束
    检查("④ 抛出后始终执行", 本模块.始终计数 == 1)
    检查("④ 异常按语义传播到调用方", 传播结果 == -1)

    本模块.始终计数 = 0
    检查("⑤ 抛出被异常块吞掉", 抛出后被吞() == 1)
    检查("⑤ 吞掉后始终仍执行", 本模块.始终计数 == 1)

    本模块.始终计数 = 0
    检查("⑥ 异常块内返回-返回值正确", 异常块内返回() == 99)
    检查("⑥ 异常块内返回-始终已执行", 本模块.始终计数 == 1)

    本模块.循环每轮 = 0
    检查("⑦ 循环体始终-合计", 循环每轮始终() == 3)
    检查("⑦ 循环体始终-每轮都执行共3次", 本模块.循环每轮 == 3)

    本模块.跳出前始终 = 0
    检查("⑧ 跳出穿越始终-跳出生效", 跳出穿越() == 2)
    检查("⑧ 跳出穿越始终-跳出那轮的始终也执行(共3次)", 本模块.跳出前始终 == 3)

    本模块.继续前始终 = 0
    检查("⑨ 继续穿越始终-计数正确", 继续穿越() == 2)
    检查("⑨ 继续穿越始终-始终执行共3次", 本模块.继续前始终 == 3)

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
