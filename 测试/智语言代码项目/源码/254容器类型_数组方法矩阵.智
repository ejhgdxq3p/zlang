// 覆盖《智语言编程规范》§2.4.2「数组」：
//   索引从 1 开始（有效范围 1..长度）；越界**抛运行时异常**；查找未找到返回 0；
//   方法表：长度/追加/插入/删除/取末尾/是否包含/查找索引/反转/排序/清空/获取（越界返回空值）；
//   遍历：`循环 元素 遍历`、`循环 索引, 元素 遍历`（索引从 1 开始）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 254 数组方法矩阵（§2.4.2）===")

    列 = [10, 20, 30]
    检查("索引从 1 开始：列[1]", 列[1] == 10)
    检查("末元素索引 = 长度：列[3]", 列[3] == 30)
    检查("长度()", 列.长度() == 3)

    // 追加 / 插入 / 删除
    列.追加(40)
    检查("追加后长度 4", 列.长度() == 4)
    检查("追加元素在末尾", 列[4] == 40)
    列.插入(1, 5)
    检查("插入到索引 1（开头）", 列[1] == 5)
    检查("插入后原首元素后移", 列[2] == 10)
    列.删除(1)
    检查("删除索引 1 后新首元素", 列[1] == 10)
    检查("删除后长度 4", 列.长度() == 4)

    // 取末尾（取出并返回 ⇒ 元素被移除）
    末尾 = 列.取末尾()
    检查("取末尾返回值", 末尾 == 40)
    检查("取末尾后长度减 1", 列.长度() == 3)

    // 查询
    检查("是否包含（存在）", 列.是否包含(20) == 真)
    检查("是否包含（不存在）", 列.是否包含(99) == 假)
    检查("查找索引（存在）", 列.查找索引(20) == 2)
    检查("查找索引（未找到返回 0）", 列.查找索引(99) == 0)

    // 获取（安全读取，越界返回空值）
    越界取值 = 列.获取(99)
    检查("获取越界返回空值", (越界取值 == 空值) == 真)
    检查("获取有效索引", 列.获取(1) == 10)

    // 反转 / 排序 / 清空
    排序列 = [3, 1, 2]
    排序列.排序()
    检查("排序后升序", 排序列[1] == 1 且 排序列[3] == 3)
    排序列.反转()
    检查("反转后降序", 排序列[1] == 3 且 排序列[3] == 1)
    排序列.清空()
    检查("清空后长度 0", 排序列.长度() == 0)

    // 遍历：元素 / 索引+元素（索引从 1 开始）
    水果 = ["苹果", "香蕉", "橙子"]
    个数 = 0
    首索引 = 0
    首元素 = ""
    循环 索引, 元素 遍历 水果:
        个数 = 个数 + 1
        如果 个数 == 1:
            首索引 = 索引
            首元素 = 元素
        结束
    结束
    检查("遍历计数", 个数 == 3)
    检查("遍历索引从 1 开始", 首索引 == 1)
    检查("遍历元素取值", 首元素 == "苹果")

    // 空数组取末尾 ⇒ 空值（规范签名 任意<甲|空值>；与 .获取(越界) 同款「无元素可取」语义）
    空列 = []
    空结果 = 空列.取末尾()
    检查("空数组取末尾返回空值", (空结果 == 空值) == 真)
    检查("空数组取末尾后仍为空", 空列.长度() == 0)

    // 越界：运行时异常，且可被 捕获
    捕获:
        越界值 = 列[99]
        检查("数组越界应抛异常", 假)
    异常:
        错误 = 异常错误()
        检查("越界异常类型非空", 错误.类型.长度() > 0)
        检查("越界异常类型含『越界』", 错误.类型.是否包含("越界") == 真)
    结束

    收尾()
结束
