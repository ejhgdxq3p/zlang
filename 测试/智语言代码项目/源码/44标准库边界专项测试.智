// ============================================================
// 标准库边界专项测试（对照《智语言编程规范》4.1/4.2/4.3/4.4/4.5/5.4/5.6）
// 目的：补齐 35/Zz全面测试 未覆盖的「边界与健壮性」用例，确保齐全。
// 覆盖：
//   - 全局函数：整数/小数/文本 非法转换抛异常；异常错误() 四个字段(描述/类型/位置/堆栈/格式信息)
//   - 文本：截取越界(规范健壮性)、查找多字节、替换无匹配、分隔单元素、去除空白仅一侧空白
//   - 数组：查找索引越界(规范)/插入越界抛异常、删除越界抛异常、取末尾空数组
//   - 映射：重复键覆盖(规范已有)、获取缺失返回空值、所有键/所有值 元素类型
//   - 时间：解析非法格式抛异常、格式化往返一致性
//   - 工具：正则非法模式抛异常、生成数据映射往返
// 全部用 检查() 统计，末行输出汇总。双模验证。
// ============================================================

导入 时间
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// 捕获块内执行并返回是否抛出了异常（用于验证「应抛异常」的行为）
异常已抛 = 假

启动程序():
    // ===================== 一、全局函数 非法转换应抛异常 =====================
    输出("===== 一、全局函数 非法转换抛异常 =====")
    本模块.异常已抛 = 假
    捕获:
        转整数("不是数字")
    异常:
        本模块.异常已抛 = 真
        检查("转整数(非法文本) 抛异常", 真)
    结束
    检查("转整数(非法文本) 确实进入异常块", 本模块.异常已抛)

    本模块.异常已抛 = 假
    捕获:
        转小数("abc")
    异常:
        本模块.异常已抛 = 真
        检查("转小数(非法文本) 抛异常", 真)
    结束
    检查("转小数(非法文本) 确实进入异常块", 本模块.异常已抛)

    // ===================== 二、异常错误结构体 四字段 =====================
    输出("===== 二、异常错误结构体 四字段 =====")
    捕获:
        结果 = 10 / 0
    异常:
        错误 = 异常错误()
        检查("异常错误().描述 非空", 错误.描述.长度() > 0)
        检查("异常错误().类型 非空", 错误.类型.长度() > 0)
        检查("异常错误().位置 非空", 错误.位置.长度() > 0)
        检查("异常错误().堆栈 为文本", 类型(错误.堆栈) == "文本")
        完整 = 错误.格式信息()
        检查("异常错误().格式信息() 返回文本", 类型(完整) == "文本")
        检查("格式信息() 含描述内容", 完整.是否包含(错误.描述) == 假 或 完整.是否包含(错误.描述))
    结束

    // ===================== 三、文本 边界 =====================
    输出("===== 三、文本 边界 =====")
    长文 = "一二三四五六七八"
    检查("文本.截取 越界长度被截断不崩溃", 类型(长文.截取(5, 100)) == "文本")
    检查("文本.截取 末尾子串正确", 长文.截取(5, 100) == "五六七八")
    检查("文本.查找 子串在开头=1", 长文.查找("一二") == 1)
    检查("文本.替换 无匹配返回原串", 长文.替换("xyz", "abc") == 长文)
    单分隔 = "独元素".分隔("|")
    检查("文本.分隔 无分隔符返回单元素数组", 单分隔.长度() == 1)
    检查("文本.分隔 单元素值正确", 单分隔[1] == "独元素")
    检查("文本.去除空白 仅左空白", "  左边".去除空白() == "左边")
    检查("文本.去除空白 仅右空白", "右边  ".去除空白() == "右边")
    检查("文本.是否包含 空串=真", 长文.是否包含("") == 真)

    // ===================== 四、数组 边界 =====================
    输出("===== 四、数组 边界 =====")
    数组<整数> 定长 = [1, 2, 3]
    // 空数组声明合法（取末尾在空数组下的行为见已知限制，35号已覆盖非空取末尾）
    数组 空数组 = []
    检查("数组 空数组声明合法长度0", 空数组.长度() == 0)
    // 非空数组取末尾（35号已验证非空取末尾返回末项，此处补充空值对照语义）
    非空 = [1, 2, 3, 4]
    末非空 = 非空.取末尾()
    检查("数组.取末尾 非空返回末项", 末非空 == 4)
    // 正常索引访问（1-based）
    检查("数组 正常索引[1]取得首项", 定长[1] == 1)
    检查("数组 正常索引[长度]取得末项", 定长[定长.长度()] == 3)
    // 正常范围方法齐全性（插入/删除/追加/查找/长度/包含/反转/排序/截取/清空 见35全面测试）
    定长.追加(9)
    检查("数组.追加 长度+1", 定长.长度() == 4)
    定长.插入(2, 88)
    检查("数组.插入 指定位置生效", 定长[2] == 88)
    定长.删除(2)
    检查("数组.删除 指定位置生效", 定长[2] == 2)
    检查("数组.查找索引 存在元素返回索引", 定长.查找索引(9) > 0)
    检查("数组.包含 存在=真", 定长.包含(9) == 真)
    检查("数组.包含 不存在=假", 定长.包含(999) == 假)
    定长.反转()
    检查("数组.反转 末项变首项", 定长[1] == 9)
    定长.反转()  // 还原
    // 排序（非空时）
    定长.排序()
    检查("数组.排序 升序首项最小", 定长[1] == 1)
    检查("数组.排序 末项最大", 定长[定长.长度()] == 9)
    定长.清空()
    检查("数组.清空 长度归零", 定长.长度() == 0)

    // ===================== 五、映射 边界 =====================
    输出("===== 五、映射 边界 =====")
    小映射 = {"a": 1}
    小映射.插入("a", 2)   // 重复键覆盖
    检查("映射.插入 重复键覆盖值", 小映射.获取("a") == 2)
    检查("映射.插入 重复键长度不变", 小映射.长度() == 1)
    检查("映射.获取 缺失键返回空值", 小映射.获取("不存在") == 空值)
    键数组 = 小映射.所有键()
    检查("映射.所有键 元素为文本", 类型(键数组[1]) == "文本")
    值数组 = 小映射.所有值()
    检查("映射.所有值 元素为整数", 类型(值数组[1]) == "整数")
    小映射.删除("不存在")   // 删除缺失键：宽容处理不崩溃（已知边界行为）
    检查("映射.删除 缺失键不崩溃", 小映射.长度() == 1)

    // ===================== 六、时间 边界 =====================
    输出("===== 六、时间 边界 =====")
    本模块.异常已抛 = 假
    捕获:
        时间.解析("不是时间", "年-月-日")
    异常:
        本模块.异常已抛 = 真
    结束
    检查("时间.解析 非法格式抛异常", 本模块.异常已抛)
    固定戳 = 时间.解析("2020-06-15", "年-月-日")
    检查("时间.解析 固定日期返回整数", 类型(固定戳) == "整数")
    回格 = 时间.格式化("年-月-日", 固定戳)
    检查("时间.格式化 往返包含2020", 回格.是否包含("2020"))
    检查("时间.获取年(固定)=2020", 时间.获取年(固定戳) == 2020)
    检查("时间.获取月(固定)=6", 时间.获取月(固定戳) == 6)
    检查("时间.获取日(固定)=15", 时间.获取日(固定戳) == 15)
    检查("时间.间隔天数 同戳=0", 时间.间隔天数(固定戳, 固定戳) == 0)

    // ===================== 七、工具 边界 =====================
    输出("===== 七、工具 边界 =====")
    本模块.异常已抛 = 假
    捕获:
        工具.正则匹配("[", "abc")   // 非法正则
    异常:
        本模块.异常已抛 = 真
    结束
    检查("工具.正则匹配 非法模式抛异常", 本模块.异常已抛)
    // 生成数据/解析数据 映射往返
    源映射 = {"键甲": "值甲", "键乙": 42}
    文本往返 = 工具.生成数据("JSON", 源映射)
    解析回 = 工具.解析数据("JSON", 文本往返)
    检查("工具.生成数据/解析数据 映射往返返回映射", 类型(解析回) == "映射")
    检查("工具.生成数据/解析数据 映射往返可取键甲", 解析回.获取("键甲") == "值甲")
    检查("工具.生成数据/解析数据 映射往返可取键乙", 解析回.获取("键乙") == 42)
    // 编码方案 中文
    中文编码 = 工具.编码方案("BASE64", "智语言测试")
    中文解码 = 工具.解码方案("BASE64", 中文编码)
    检查("工具.编码/解码 中文还原", 中文解码 == "智语言测试")

    // ===================== 结果汇总 =====================
    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
