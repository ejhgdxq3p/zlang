// §5.4 边界：纪元 0、已知日期的星期/分量、加减负数、间隔天数方向、格式化符
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 176 时间模块-边界 ===")
    // 纪元 0 = 1970-01-01（UTC）
    检查("纪元0-获取年1970", 时间.获取年(0) == 1970)
    检查("纪元0-获取月1", 时间.获取月(0) == 1)
    检查("纪元0-获取日1", 时间.获取日(0) == 1)
    // ✅ F9 已修（2026-09-27）：`时间.获取星期` 现按规范 §5.4.2「1-7，**1 为星期一**」。
    //   三个已知基准（UTC）：1970-01-01 周四 ⇒ 4；2024-01-01 周一 ⇒ 1；2024-01-07 周日 ⇒ 7
    检查("星期-1970-01-01(周四)=4", 时间.获取星期(0) == 4)
    检查("星期-2024-01-01(周一)=1", 时间.获取星期(1704067200) == 1)
    检查("星期-2024-01-07(周日)=7", 时间.获取星期(1704585600) == 7)
    检查("星期-1969-12-31(周三，负时间戳)=3", 时间.获取星期(-86400) == 3)
    检查("星期-落在1到7", 时间.获取星期(1234567890) >= 1 且 时间.获取星期(1234567890) <= 7)

    // 加减边界
    检查("加0不变", 时间.加(0, 0) == 0)
    检查("减0不变", 时间.减(0, 0) == 0)
    检查("加负数等于减", 时间.加(1000, -500) == 时间.减(1000, 500))
    // 间隔天数方向与单位（86400 秒 = 1 天）
    检查("间隔天数-正一天", 时间.间隔天数(86400, 0) == 1)
    检查("间隔天数-负一天", 时间.间隔天数(0, 86400) == -1)
    检查("间隔天数-同刻为0", 时间.间隔天数(100, 100) == 0)
    // 格式化 / 解析
    检查("格式化-纪元0取年含1970", 时间.格式化("年", 0) == "1970")
    检查("格式化-纪元0取月日", 时间.格式化("月-日", 0).查找("-") > 0)
    解析甲 = 时间.解析("1970-01-01", "年-月-日")
    检查("解析-纪元日往返为0(UTC)", 解析甲 >= 0)
    记录("解析(1970-01-01) 实际", 转文本(解析甲))
    检查("解析-往返年一致", 时间.获取年(解析甲) == 1970)
    // 当前时间与毫秒的一致性
    现在 = 时间.当前时间()
    毫秒 = 时间.当前毫秒时间()
    检查("当前毫秒与秒同量级", 毫秒 / 1000 >= 现在 - 5 且 毫秒 / 1000 <= 现在 + 5)
    // 计时器与休眠
    甲时刻 = 时间.获取计时器()
    时间.休眠(0)
    检查("休眠0-可调用", 时间.获取计时器() >= 甲时刻)
    收尾()
结束
