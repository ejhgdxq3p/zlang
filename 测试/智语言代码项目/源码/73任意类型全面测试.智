// ============================================================
// 任意类型 全面测试
// 覆盖：有名任意类型(类型守恒)、匿名任意类型(类型集合)、
//      约束范围(整数|小数|文本)、含任意参数函数声明返回类型、
//      匿名任意变量必须显式初始化、类型守恒返回同类型。
// 语法严格符合编程规范文档 §2.1.7 / §任意类型章节
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 有名任意类型：类型守恒（传入什么类型，返回什么类型）──
取较大值(任意<甲: 整数|小数> 第一个, 任意<甲> 第二个) 任意<甲>:
    如果 第一个 > 第二个:
        返回 第一个
    否则:
        返回 第二个
    结束
结束

// ── 有名任意类型 单参 ──
标识返回(任意<乙> 数据) 任意<乙>:
    返回 数据
结束

// ── 匿名任意类型：描述类型集合，变量必须显式初始化 ──
测试_匿名任意():
    任意<整数|文本> 可变数据 = 42
    检查("匿名任意 初始为整数", 可变数据 == 42)
    可变数据 = "状态更新"
    检查("匿名任意 改赋为文本", 可变数据 == "状态更新")
    任意<整数|小数|文本> 混合 = 3.14
    检查("匿名任意 约束含小数 赋小数", 混合 == 3.14)
    混合 = "文本也行"
    检查("匿名任意 改赋文本", 混合 == "文本也行")
结束

// ── 测试 ──
测试_有名任意守恒():
    大整 = 取较大值(10, 20)
    检查("有名任意 整数守恒 返回20", 大整 == 20)
    大小 = 取较大值(转小数(1.5), 转小数(2.5))
    检查("有名任意 小数守恒 返回2.5", 大小 == 转小数(2.5))
    检查("有名任意 同类型比较 10<20", 取较大值(10, 20) == 20)
结束

测试_有名任意单参():
    回 = 标识返回("hello")
    检查("有名任意单参 返回文本", 回 == "hello")
    回2 = 标识返回(123)
    检查("有名任意单参 返回整数", 回2 == 123)
结束

// ── 主入口 ──
启动程序():
    输出("========== 任意类型 全面测试 ==========")
    测试_有名任意守恒()
    测试_有名任意单参()
    测试_匿名任意()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
