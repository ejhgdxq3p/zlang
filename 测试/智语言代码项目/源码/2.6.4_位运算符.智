测试_全部():
    甲 = 5
    乙 = 3
    检查("位与", (甲 & 乙) == 1)
    检查("位或", (甲 | 乙) == 7)
    检查("位非", (~甲) == -6)
    检查("异或", (甲 ~| 乙) == 6)
    检查("左移", (甲 << 1) == 10)
    检查("右移", (甲 >> 1) == 2)

    读权限 = 4
    写权限 = 2
    执行权限 = 1
    用户权限 = 读权限 | 写权限
    检查("权限组合=6", 用户权限 == 6)
    检查("有读权限", (用户权限 & 读权限) != 0)
    检查("无执行权限", (用户权限 & 执行权限) == 0)

    数 = 5
    数 &= 3
    检查("&= 得1", 数 == 1)
    数 = 5
    数 |= 2
    检查("|= 得7", 数 == 7)
    数 = 5
    数 ~|= 3
    检查("~|= 得6", 数 == 6)
    数 = 5
    数 <<= 2
    检查("<<= 得20", 数 == 20)
    数 = 20
    数 >>= 2
    检查(">>= 得5", 数 == 5)
