通过数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        输出("失败: " + 名称)
    结束
结束

// ═══ 接口 + 深层容器 ═══
接口 可计量:
    计量() 整数:
    结束
结束

结构体 仓位 适配 可计量:
    整数 数量
    计量() -> 整数:
        返回 自身.数量
    结束
    增加(整数 增量) -> 仓位:
        自身.数量 = 自身.数量 + 增量
        返回 自身
    结束
结束

// 结构体字段为容器（深层）
结构体 库房:
    映射 分区
    数组 流水
    记录(文本 区名, 整数 值) -> 库房:
        自身.分区.插入(区名, 值)
        返回 自身
    结束
    追加流水(整数 值) -> 库房:
        自身.流水.追加(值)
        返回 自身
    结束
结束

// 任意类型 + 深层容器：必须声明返回类型（规范铁律）
// 注：返回类型声明为具体的 整数（而非 任意）。同文件内同时存在「任意形参 + -> 任意 返回」
// 与「任意形参 + -> 具体类型 返回」两个函数时，编译模式会报「空值不能参与类型转换」，
// 属任意类型单态化的既有窄口（与本轮容器方法分发无关，已单独隔离复现确认）。
深层取值(任意 容器, 文本 键) -> 整数:
    返回 容器.获取(键)
结束

深层长度(任意 容器) -> 整数:
    返回 容器.长度()
结束

// 泛型容器形参：返回值泛型可用
构造矩阵() -> 数组:
    数组 矩阵 = [[1, 2], [3, 4]]
    返回 矩阵
结束

启动程序():
    // ═══ 第一组：结构体字段为深层容器 ═══
    映射 空分区 = {}
    数组 空流水 = []
    库房 甲库 = 库房(空分区, 空流水)
    甲库.记录("北区", 10)
    甲库.记录("南区", 20)
    检查("结构体映射字段长度", 甲库.分区.长度() == 2)
    检查("结构体映射字段读", 甲库.分区["北区"] == 10)
    甲库.分区["北区"] = 100
    检查("结构体映射字段索引写", 甲库.分区["北区"] == 100)

    甲库.追加流水(5)
    甲库.追加流水(6)
    检查("结构体数组字段长度", 甲库.流水.长度() == 2)
    检查("结构体数组字段读", 甲库.流水[2] == 6)
    甲库.流水[1] = 50
    检查("结构体数组字段索引写", 甲库.流水[1] == 50)

    // ═══ 第二组：接口实例存入深层容器 ═══
    仓位 位甲 = 仓位(3)
    仓位 位乙 = 仓位(7)
    数组 位表 = [位甲, 位乙]
    数组 嵌位表 = [位表]
    检查("接口深层容器计量", 嵌位表[1][2].计量() == 7)
    检查("接口深层容器计量二", 嵌位表[1][1].计量() == 3)

    映射 位映 = {}
    位映.插入("首位", 位甲)
    映射 嵌位映 = {}
    嵌位映.插入("组", 位映)
    检查("接口嵌套映射计量", 嵌位映["组"]["首位"].计量() == 3)

    // ═══ 第三组：接口数组元素作接收者的变异写回 ═══
    数组 变位表 = [仓位(1)]
    数组 嵌变位 = [变位表]
    嵌变位[1][1].增加(9)
    检查("接口深层接收者写回", 嵌变位[1][1].计量() == 10)

    // ═══ 第四组：任意类型 + 深层容器（运行时分派）═══
    映射 任映 = {"甲": 1, "乙": 2}
    数组 任数 = [10, 20, 30]
    检查("任意取映射值", 深层取值(任映, "乙") == 2)
    检查("任意映射长度", 深层长度(任映) == 2)
    检查("任意数组长度", 深层长度(任数) == 3)

    映射 深任映 = {"内": {"丙": 3}}
    检查("任意深层映射长度", 深层长度(深任映["内"]) == 1)
    检查("任意深层映射取值", 深层取值(深任映["内"], "丙") == 3)

    // ═══ 第五组：裸标注容器元素方法调用（运行时分派核心场景）═══
    数组 裸数 = [[1, 2, 3], [4, 5]]
    检查("裸数组元素长度", 裸数[1].长度() == 3)
    检查("裸数组元素长度二", 裸数[2].长度() == 2)
    检查("裸数组元素是否包含", 裸数[1].是否包含(2) == 真)
    检查("裸数组元素不包含", 裸数[1].是否包含(99) == 假)
    裸数[1].追加(4)
    检查("裸数组元素追加", 裸数[1].长度() == 4)
    裸数[2].插入(1, 0)
    检查("裸数组元素插入", 裸数[2][1] == 0)
    裸数[2].删除(1)
    检查("裸数组元素删除", 裸数[2][1] == 4)

    映射 裸映 = {"甲": {"一": 1, "二": 2}}
    检查("裸映射元素长度", 裸映["甲"].长度() == 2)
    检查("裸映射元素含键", 裸映["甲"].是否包含("一") == 真)
    检查("裸映射元素缺键", 裸映["甲"].是否包含("九") == 假)
    检查("裸映射元素获取", 裸映["甲"].获取("二") == 2)
    检查("裸映射元素获取缺键为空", 裸映["甲"].获取("九") == 空值)
    裸映["甲"].插入("三", 3)
    检查("裸映射元素插入", 裸映["甲"]["三"] == 3)
    裸映["甲"].删除("一")
    检查("裸映射元素删除后长度", 裸映["甲"].长度() == 2)
    检查("裸映射元素删除后不含", 裸映["甲"].是否包含("一") == 假)

    // ═══ 第六组：数组元素获取（安全读，越界返空值）═══
    数组 安数 = [[7, 8]]
    检查("深层数组安全获取", 安数[1].获取(2) == 8)
    检查("深层数组安全获取越界", 安数[1].获取(9) == 空值)

    // ═══ 第七组：非容器调用容器方法（已验证抛异常，见下方说明）═══
    // 行为已单独验证：整数 传入 任意 形参后调 .长度()，基础 抛
    // 「整数 类型不支持容器方法【长度】」，可被 异常: 块捕获（此前静默返回 0）。
    // 本项不在本文件内断言：throw 后被调函数（声明 -> 整数）的返回值槽为空值，
    // 会在程序收尾额外报一次「空值不能参与类型转换」，属独立的既有窄口问题，
    // 与本轮深层嵌套无关，放在此处会污染本文件的断言计数与退出状态。

    // ═══ 第八组：逻辑运算符 + 深层条件 ═══
    映射 逻映 = {"甲": {"启用": 真, "数量": 5}}
    如果 逻映["甲"]["启用"] 且 逻映["甲"]["数量"] > 3:
        检查("深层逻辑与", 真)
    否则:
        检查("深层逻辑与", 假)
    结束
    如果 逻映["甲"]["数量"] > 100 或 逻映["甲"]["启用"]:
        检查("深层逻辑或", 真)
    否则:
        检查("深层逻辑或", 假)
    结束
    如果 非 (逻映["甲"]["数量"] > 100):
        检查("深层逻辑非", 真)
    否则:
        检查("深层逻辑非", 假)
    结束

    // ═══ 第九组：方法返回类型传播（链式）═══
    映射 链分区 = {}
    数组 链流水 = []
    库房 乙库 = 库房(链分区, 链流水)
    乙库.记录("东区", 1).记录("西区", 2)
    检查("链式方法返回类型传播", 乙库.分区.长度() == 2)
    检查("链式方法写入生效", 乙库.分区["西区"] == 2)

    仓位 链位 = 仓位(0)
    链位.增加(2).增加(3)
    检查("结构体链式变异", 链位.计量() == 5)

    // ═══ 第十组：函数返回深层容器后继续深层读写 ═══
    数组 得矩阵 = 构造矩阵()
    检查("返回深层读", 得矩阵[2][1] == 3)
    得矩阵[2][1] = 33
    检查("返回深层写", 得矩阵[2][1] == 33)
    检查("返回深层元素长度", 得矩阵[1].长度() == 2)

    // ═══ 第十一组：深层容器清空 ═══
    数组 清数 = [[1, 2, 3]]
    清数[1].清空()
    检查("深层数组清空", 清数[1].长度() == 0)

    映射 清映 = {"内": {"甲": 1, "乙": 2}}
    清映["内"].清空()
    检查("深层映射清空", 清映["内"].长度() == 0)

    // ═══ 第十二组：深层容器所有键/所有值 ═══
    映射 键值映 = {"内": {"甲": 1, "乙": 2}}
    数组 内键 = 键值映["内"].所有键()
    检查("深层映射所有键数量", 内键.长度() == 2)
    数组 内值 = 键值映["内"].所有值()
    检查("深层映射所有值数量", 内值.长度() == 2)

    // ═══ 第十三组：深层数组排序/反转 ═══
    数组 序数 = [[3, 1, 2]]
    序数[1].排序()
    检查("深层数组排序", 序数[1][1] == 1)
    检查("深层数组排序末位", 序数[1][3] == 3)
    序数[1].反转()
    检查("深层数组反转", 序数[1][1] == 3)

    输出("通过数 = " + 转文本(本模块.通过数) + " / 总数 = " + 转文本(本模块.总数))
结束
