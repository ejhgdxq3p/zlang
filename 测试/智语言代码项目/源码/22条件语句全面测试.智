// ============================================================
// 条件语句全面测试（对照《智语言编程规范》2.5.1 条件语句）
// 覆盖：单条件 / 双条件 / 多条件 / 嵌套条件 / 复合逻辑(且或非)
//       + 括号分组 + 函数内返回分支 + 条件结果参与后续计算
// 全部双模验证。
// ============================================================

通过数 = 0
失败数 = 0
总用例数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总用例数 = 本模块.总用例数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// 用于函数内返回分支测试
评定等级(整数 分数) 文本:
    如果 分数 >= 90:
        返回 "A"
    否则如果 分数 >= 80:
        返回 "B"
    否则如果 分数 >= 70:
        返回 "C"
    否则如果 分数 >= 60:
        返回 "D"
    否则:
        返回 "F"
    结束
结束

// 复合逻辑应用：用户权限判断（返回 真/假）
可访问系统(逻辑 已登录, 逻辑 是管理员, 逻辑 被冻结) 逻辑:
    如果 已登录 且 非 被冻结:
        如果 是管理员 或 真:
            返回 真
        结束
    否则:
        返回 假
    结束
    返回 假
结束

启动程序():
    输出("===== A. 单条件语句 =====")
    年龄 = 18
    标志 = 假
    如果 年龄 >= 18:
        标志 = 真
    结束
    检查("单条件成立(成年标志)", 标志 == 真)

    分数 = 55
    及格标志 = 假
    如果 分数 >= 60:
        及格标志 = 真
    结束
    检查("单条件不成立(55分不及格)", 及格标志 == 假)

    输出("===== B. 双条件语句 =====")
    余额 = 500
    价格 = 300
    购买结果 = 假
    剩余余额 = 余额
    如果 余额 >= 价格:
        剩余余额 = 余额 - 价格
        购买结果 = 真
    否则:
        购买结果 = 假
    结束
    检查("双条件成立(购买成功)", 购买结果 == 真)
    检查("双条件成立(剩余余额=200)", 剩余余额 == 200)

    余额2 = 200
    价格2 = 300
    购买2 = 假
    如果 余额2 >= 价格2:
        购买2 = 真
    否则:
        购买2 = 假
    结束
    检查("双条件不成立(余额不足)", 购买2 == 假)

    输出("===== C. 多条件语句(分支选择) =====")
    检查("多条件 92=>A", 评定等级(92) == "A")
    检查("多条件 85=>B", 评定等级(85) == "B")
    检查("多条件 72=>C", 评定等级(72) == "C")
    检查("多条件 61=>D", 评定等级(61) == "D")
    检查("多条件 50=>F", 评定等级(50) == "F")
    检查("多条件 90=>A(边界)", 评定等级(90) == "A")
    检查("多条件 60=>D(边界)", 评定等级(60) == "D")
    检查("多条件 59=>F(边界)", 评定等级(59) == "F")

    输出("===== D. 嵌套条件语句 =====")
    分数 = 85
    出勤 = 90
    嵌套结果 = ""
    如果 分数 >= 60:
        如果 出勤 >= 80:
            嵌套结果 = "合格出勤良好"
        否则:
            嵌套结果 = "合格出勤不足"
        结束
    否则:
        嵌套结果 = "不合格"
    结束
    检查("嵌套条件(合格出勤良好)", 嵌套结果 == "合格出勤良好")

    分数2 = 50
    嵌套2 = ""
    如果 分数2 >= 60:
        嵌套2 = "合格"
    否则:
        如果 出勤 >= 80:
            嵌套2 = "不合格但出勤好"
        否则:
            嵌套2 = "不合格出勤差"
        结束
    结束
    检查("嵌套条件(不合格但出勤好)", 嵌套2 == "不合格但出勤好")

    输出("===== E. 复合逻辑(且/或/非) =====")
    年龄 = 20
    有会员卡 = 真
    是否学生 = 假
    逻辑与 = 假
    如果 年龄 >= 18 且 有会员卡:
        逻辑与 = 真
    结束
    检查("逻辑与(成年且有卡)", 逻辑与 == 真)

    逻辑或 = 假
    如果 是否学生 或 年龄 >= 60:
        逻辑或 = 真
    结束
    检查("逻辑或(非学生但age>=60不成立->假)", 逻辑或 == 假)

    逻辑或2 = 假
    如果 是否学生 或 年龄 >= 18:
        逻辑或2 = 真
    结束
    检查("逻辑或(年龄>=18成立->真)", 逻辑或2 == 真)

    逻辑非 = 假
    如果 非 是否学生:
        逻辑非 = 真
    结束
    检查("逻辑非(非学生->真)", 逻辑非 == 真)

    输出("===== F. 复合逻辑括号分组 =====")
    组合 = 假
    如果 (年龄 >= 18 且 有会员卡) 或 是否学生:
        组合 = 真
    结束
    检查("括号分组(成年且有卡 或 学生)", 组合 == 真)

    组合2 = 假
    如果 年龄 >= 18 且 (有会员卡 或 是否学生):
        组合2 = 真
    结束
    检查("括号分组(成年 且 (有卡或学生))", 组合2 == 真)

    组合3 = 假
    如果 (年龄 >= 60 或 是否学生) 且 非 有会员卡:
        组合3 = 真
    结束
    检查("括号分组(复杂->假)", 组合3 == 假)

    输出("===== G. 复合逻辑应用(权限) =====")
    检查("权限(已登录未冻结管理员)", 可访问系统(真, 真, 假) == 真)
    检查("权限(未登录)", 可访问系统(假, 真, 假) == 假)
    检查("权限(被冻结)", 可访问系统(真, 真, 真) == 假)
    检查("权限(已登录非管理员未冻结)", 可访问系统(真, 假, 假) == 真)

    输出("===== H. 条件结果参与后续计算 =====")
    成绩 = 85
    附加 = 0
    如果 成绩 >= 60:
        附加 = 10
    否则:
        附加 = 0
    结束
    总分 = 成绩 + 附加
    检查("条件分支赋值参与计算(85+10=95)", 总分 == 95)

    输出("")
    输出("===== 条件语句测试汇总 =====")
    输出("总用例数=" + 转文本(本模块.总用例数) + " 通过数=" + 转文本(本模块.通过数) + " 失败数=" + 转文本(本模块.失败数))
    如果 本模块.失败数 == 0:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
