// ============================================================
// 结构体组合 + 匿名函数规则验证（对照《智语言编程规范》）
// ① 结构体成员仅 字段/方法/初始化/清理；用组合（字段引用实例）替代嵌套
// ② 具名函数仅模块顶层；函数体内只能用匿名函数（写法一：直接返回；写法二：先赋值再返回）
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 组合：地址 作为独立结构体，被 用户 以字段引用 ──
结构体 地址():
    城市 = ""
    区域 = 0

    设置(文本 城市名, 整数 区号):
        自身.城市 = 城市名
        自身.区域 = 区号
    结束

    描述() 文本:
        返回 自身.城市 + "-" + 转文本(自身.区域)
    结束
结束

结构体 用户():
    姓名 = ""
    住址 = 地址()

    打招呼() 文本:
        返回 "我是" + 自身.姓名 + "，住在" + 自身.住址.描述()
    结束
结束

// ── 匿名函数写法一：直接返回 ──
创建加法器(整数 增量) 函数(整数) 整数:
    返回 函数(整数 数值) 整数:
        返回 数值 + 增量
    结束
结束

// ── 匿名函数写法二：先赋值给变量，再返回 ──
创建乘法器(整数 倍数) 函数(整数) 整数:
    乘法函数 = 函数(整数 数值) 整数:
        返回 数值 * 倍数
    结束
    返回 乘法函数
结束

启动程序():
    输出("===== 一、结构体组合 =====")
    // 组合：字段默认值 = 结构体实例（规范：用组合替代嵌套）
    // 注：方法参数默认传值，修改 自身 需 返回 自身 并重新赋值；本测试用直接字段赋值（值语义明确）
    甲 = 用户()
    甲.姓名 = "张三"
    北京 = 地址()
    北京.城市 = "北京"
    北京.区域 = 1
    甲.住址 = 北京
    检查("组合字段赋值", 甲.住址.描述() == "北京-1")
    检查("组合方法跨结构体调用", 甲.打招呼() == "我是张三，住在北京-1")

    乙 = 用户()
    检查("字段默认值逐实例独立", 乙.住址.城市 == "")
    检查("字段默认值区域独立", 乙.住址.区域 == 0)
    上海 = 地址()
    上海.城市 = "上海"
    上海.区域 = 21
    乙.住址 = 上海
    检查("实例间互不影响", 甲.住址.城市 == "北京" 且 乙.住址.城市 == "上海")

    输出("===== 二、匿名函数（函数体内仅匿名） =====")
    加五 = 创建加法器(5)
    检查("写法一 直接返回匿名函数", 加五(10) == 15)
    乘三 = 创建乘法器(3)
    检查("写法二 先赋值再返回", 乘三(10) == 30)
    检查("闭包捕获各自独立", 加五(1) == 6 且 乘三(1) == 3)

    输出("")
    输出("===== 汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "  通过：" + 转文本(本模块.通过数) + "  失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 == 0:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
