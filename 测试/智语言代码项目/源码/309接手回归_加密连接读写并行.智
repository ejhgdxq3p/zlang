// 309 接手回归（第四轮）：TLS 连接上读与写互不阻塞
// ══════════════════════════════════════════════════════════════════════════
//   一个任务阻塞在读取上时，另一个任务仍能对同一条 TLS 连接写入。
//   TLS 连接曾经读写共用一把锁：读方等数据期间写方被卡住，直到读超时。
// 依赖：测试/夹具产物/ 下的自签证书（由 测试/双引擎回归.sh 用 openssl 现场生成）。
//       证书不存在时本用例跳过（不算失败）。
// ══════════════════════════════════════════════════════════════════════════
导入 网络
导入 并发
导入 时间
导入 文件
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    证书文件 = "../夹具产物/cert.pem"
    密钥文件 = "../夹具产物/key.pem"
    如果 文件.是否存在(证书文件) == 假:
        输出("跳过：没有测试证书（需要 openssl，由回归脚本生成）")
        返回
    结束

    监听器 = 网络.监听(18361, {"TLS": 真, "证书": 证书文件, "密钥": 密钥文件})
    接受任务 = 并发.启动任务(函数() 文本:
        服务端 = 监听器.接受()
        服务端.设置超时(5000)
        第一行 = 服务端.读取一行()
        服务端.写入一行("回:" + 第一行)
        第二行 = 服务端.读取一行()
        服务端.关闭()
        返回 第一行 + "|" + 第二行
    结束)
    时间.休眠(200)
    客户端 = 网络.连接("127.0.0.1", 18361, {"TLS": 真, "验证证书": 假, "超时": 3000})
    客户端.设置超时(5000)
    读任务 = 并发.启动任务(函数() 文本:
        捕获:
            返回 客户端.读取一行()
        异常:
            返回 "<读异常>"
        结束
        返回 "<无>"
    结束)
    时间.休眠(300)
    开始 = 时间.当前毫秒时间()
    客户端.写入一行("你好")
    检查("读方阻塞期间写入立即完成", 时间.当前毫秒时间() - 开始 < 1000)
    检查("读方收到对端回复", 并发.批量等待([读任务], 6000)[1] == "回:你好")
    客户端.写入一行("再见")
    检查("服务端按顺序收到两行", 并发.批量等待([接受任务], 6000)[1] == "你好|再见")
    尾 = "<未读>"
    捕获:
        尾 = 客户端.读取(16)
    异常:
        尾 = "<异常>"
    结束
    检查("对端关闭后读到空文本", 尾 == "")
    客户端.关闭()
    监听器.关闭()

    输出("结果：通过 " + 转文本(本模块.通过数) + " / 总数 " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
