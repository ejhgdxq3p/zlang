// 110 内存值语义隔离矩阵（基本类型 / 容器 / 自定义 全覆盖）
// ══════════════════════════════════════════════════════════════════════════
// 依据《智语言编程规范》值语义与「存储即深拷贝」（降级层承担，非 COW）：
//   任何一次 **存储 / 赋值 / 传参 / 字段写 / 元素写** 都不得让两个名字共享同一实例。
// ⇒ 本用例是**内存管理**最基础的安全网：
//   ① 若深拷贝被省掉 ⇒ 副本写入会串改原对象（语义错，本用例失败）；
//   ② 若提前回收被引入 ⇒ 源对象读到被回收后的值/异常（本用例失败）。
// 配合 `内存对账门禁`（可达性对账：可达 ⇒ 计数>0）形成双保险。
// ══════════════════════════════════════════════════════════════════════════
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 车:
    整数 速度 = 0
结束

结构体 车库:
    数组<车> 车辆 = []
结束

启动程序():
    输出("===== ① 基本类型：赋值互相独立 =====")
    整数 整数甲 = 10
    整数 整数乙 = 整数甲
    整数乙 = 99
    检查("整数：源不变", 整数甲 == 10)
    检查("整数：副本生效", 整数乙 == 99)

    小数 小数甲 = 1.5
    小数 小数乙 = 小数甲
    小数乙 = 2.5
    检查("小数：源不变", 小数甲 == 1.5)

    文本 文本甲 = "abc"
    文本 文本乙 = 文本甲
    文本乙 = 文本乙 + "d"
    检查("文本：源不变", 文本甲 == "abc")
    检查("文本：副本生效", 文本乙 == "abcd")

    逻辑 逻辑甲 = 1 == 1
    逻辑 逻辑乙 = 逻辑甲
    逻辑乙 = 2 == 3
    检查("逻辑：源不变", 逻辑甲 == (1 == 1))

    输出("===== ② 容器：整体赋值 / 元素写 互相独立 =====")
    数组<整数> 列甲 = [1, 2, 3]
    数组<整数> 列乙 = 列甲
    列乙[1] = 9
    检查("数组：整体赋值独立（列甲[1] 不变）", 列甲[1] == 1)
    检查("数组：元素写生效（列乙[1]）", 列乙[1] == 9)
    列乙.追加(4)
    检查("数组：副本追加不影响源长度", 列甲.长度() == 3)
    检查("数组：副本长度增加", 列乙.长度() == 4)

    映射<文本, 整数> 表甲 = {"x": 1, "y": 2}
    映射<文本, 整数> 表乙 = 表甲
    表甲 = {"z": 9}
    检查("映射：重赋值不影响副本（表乙 2 项）", 表乙.长度() == 2)
    检查("映射：重赋值生效（表甲 1 项）", 表甲.长度() == 1)
    检查("映射：副本取值正确", 表乙["x"] == 1)

    输出("===== ③ 自定义：结构体 / 嵌套容器 深拷贝 =====")
    车 车甲 = 车()
    车甲.速度 = 10
    车 车乙 = 车甲
    车乙.速度 = 99
    检查("结构体：赋值独立（车甲不变）", 车甲.速度 == 10)
    检查("结构体：赋值生效（车乙）", 车乙.速度 == 99)

    车库 库甲 = 车库()
    库甲.车辆.追加(车甲)
    车库 库乙 = 库甲
    库乙.车辆[1].速度 = 77
    检查("嵌套容器：整体赋值独立（库甲元素不变）", 库甲.车辆[1].速度 == 10)
    检查("嵌套容器：副本变异生效", 库乙.车辆[1].速度 == 77)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
