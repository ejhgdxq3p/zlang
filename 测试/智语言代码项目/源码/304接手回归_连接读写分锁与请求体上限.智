// 304 接手回归（第三轮）：连接读写分锁、关闭唤醒读方、请求体上限、设置超时签名
// ══════════════════════════════════════════════════════════════════════════
//   一、一个任务阻塞在读取上时，另一个任务仍能对同一连接写入 ——读写曾共用一把锁，写方被卡死
//   二、连接.关闭() 唤醒正阻塞在读取上的任务 ——曾只清句柄表，读方永远等下去
//   三、请求体超过「最大请求体」时返回 413，不进处理器 ——曾无上限整体读入内存
//   四、网络.连接设置超时(连接, 毫秒) 两个参数 ——签名里曾多出一个无意义的第三参数
// 判据：解释 + 编译 双模一致且全部通过。
// ══════════════════════════════════════════════════════════════════════════
导入 网络
导入 并发
导入 时间
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

处理请求(网络请求 请求) 网络响应:
    返回 网络.响应成功("已处理")
结束

启动程序():
    输出("===== 一、读阻塞时仍可写 =====")
    监听器 = 网络.监听(18331, {})
    客户端 = 网络.连接("127.0.0.1", 18331, {})
    服务端连接 = 监听器.接受()
    服务端连接.设置超时(3000)
    客户端.设置超时(3000)
    读任务 = 并发.启动任务(函数() 文本:
        捕获:
            返回 服务端连接.读取一行()
        异常:
            返回 "<读异常>"
        结束
        返回 "<未知>"
    结束)
    时间.休眠(200)
    开始 = 时间.当前毫秒时间()
    服务端连接.写入一行("问")
    写耗时 = 时间.当前毫秒时间() - 开始
    检查("读方阻塞期间写入立即完成", 写耗时 < 1000)
    收到 = ""
    捕获:
        收到 = 客户端.读取一行()
    异常:
        收到 = "<异常>"
    结束
    检查("对端收到写入内容", 收到 == "问")
    客户端.写入一行("答")
    读结果 = 并发.批量等待([读任务], 5000)
    检查("读任务随后读到应答", 读结果[1] == "答")

    输出("===== 二、关闭唤醒阻塞的读方 =====")
    服务端连接.设置超时(0)
    读任务二 = 并发.启动任务(函数() 文本:
        捕获:
            片段 = 服务端连接.读取(16)
            返回 "读到[" + 片段 + "]"
        异常:
            返回 "异常唤醒"
        结束
        返回 "<未知>"
    结束)
    时间.休眠(200)
    服务端连接.关闭()
    读结果二 = 并发.批量等待([读任务二], 3000)
    检查("关闭后读方在限时内返回", 读结果二[1] == "读到[]" 或 读结果二[1] == "异常唤醒")
    客户端.关闭()
    监听器.关闭()

    输出("===== 三、请求体上限 =====")
    服务 = 网络.启动服务(18332, 处理请求, {"最大请求体": 16})
    小响应 = 网络.请求("POST", "http://127.0.0.1:18332/体", "短内容", {"超时": 5000})
    检查("未超限的请求正常处理", 小响应.状态码() == 200 且 小响应.内容() == "已处理")
    整数 大状态 = 0
    捕获:
        大响应 = 网络.请求("POST", "http://127.0.0.1:18332/体", "0123456789012345678901234567890123456789", {"超时": 5000})
        大状态 = 大响应.状态码()
    异常:
        大状态 = 413
    结束
    检查("超限的请求得到 413", 大状态 == 413)
    服务.关闭()

    输出("===== 四、连接设置超时 两参数 =====")
    监听器二 = 网络.监听(18333, {})
    客户端二 = 网络.连接("127.0.0.1", 18333, {})
    对端二 = 监听器二.接受()
    网络.连接设置超时(对端二, 300)
    超时了 = 假
    捕获:
        对端二.读取(4)
    异常:
        超时了 = 真
    结束
    检查("模块函数形式设置的超时生效", 超时了 == 真)
    对端二.关闭()
    客户端二.关闭()
    监听器二.关闭()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
