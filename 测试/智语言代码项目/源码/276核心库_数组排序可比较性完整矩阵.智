// 276 数组排序：**可比较性规则完整矩阵**（2026-10-22）
//
// 规范依据 §4.3「`.排序()` 的可比较性规则」（2026-10-19 定稿，双模式一致）：
//   规则 1：元素须同一**可比类别** —— 数值（整数/小数**可混合**，按数值大小）、
//           `逻辑`（**假 < 真**）、`文本`（**按 UTF-8 字节序 / Unicode 码点序**）；
//   规则 2：出现 `空值`、`数组`、`映射`、`结构体`、`接口`、函数、NaN 或**跨类别混排**
//           ⇒ **抛可捕获异常**（类型 `运行时异常`），**数组保持原样**；
//   规则 3：空数组、单元素数组 ⇒ 无操作、不抛异常。
//
// 为什么单列一个用例：排序是**唯一同时涉及"值序"与"异常边界"**的核心库方法，
//   而且"文本按码点序"极易被误认为拼音序（`丙 < 乙 < 甲`）；规则 2 的"数组保持原样"
//   一旦被破坏就是**半排序**的脏数据，比抛异常更危险。
//
// 断言值全部来自探针实测（`探针_排序矩阵.智`），比较用**索引取值**而非文本形式（不与显示格式耦合）。
结构体 甲盒(整数 初值):
    整数 值 = 初值
结束

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 276 数组排序：可比较性完整矩阵 ===")

    // ───────── ① 规则 1：同类可比（含允许的混合）─────────
    输出("-- ① 同类可比 --")
    整数表 = [3, 1, 2]
    整数表.排序()
    检查("整数升序：[3,1,2] ⇒ [1,2,3]",
        整数表.获取(1) == 1 且 整数表.获取(3) == 3 且 整数表.长度() == 3)
    检查("排序不改变长度", 整数表.长度() == 3)

    小数表 = [2.5, 0.5, 1.5]
    小数表.排序()
    检查("小数升序：首 0.5、末 2.5", 小数表.获取(1) == 0.5 且 小数表.获取(3) == 2.5)

    混合数值 = [2.5, 1, 3]
    混合数值.排序()
    检查("★ 整数与小数**可混合**按数值排序：首 1", 混合数值.获取(1) == 1)
    检查("混合排序次项 2.5、末项 3", 混合数值.获取(2) == 2.5 且 混合数值.获取(3) == 3)

    负表 = [0, 0 - 1, 1]
    负表.排序()
    检查("含负数：[0,-1,1] ⇒ [-1,0,1]", 负表.获取(1) == 0 - 1 且 负表.获取(3) == 1)

    逻辑表 = [真, 假, 真]
    逻辑表.排序()
    检查("★ 逻辑排序：假 < 真（首项为假）", 逻辑表.获取(1) == 假)
    检查("逻辑排序末项为真", 逻辑表.获取(3) == 真)

    中文表 = ["甲", "丙", "乙"]
    中文表.排序()
    // 码点：丙 U+4E19 < 乙 U+4E59 < 甲 U+7532 ⇒ 不是拼音序（甲乙丙）也不是笔画序
    检查("★★ 中文按 Unicode 码点序：首 = 丙", 中文表.获取(1) == "丙")
    检查("★★ 中码点序：中 = 乙", 中文表.获取(2) == "乙")
    检查("★★ 中码点序：末 = 甲", 中文表.获取(3) == "甲")

    英文表 = ["b", "a", "C"]
    英文表.排序()
    检查("★ 英文按字节序：大写 C(67) 在前", 英文表.获取(1) == "C")
    检查("字节序：a(97) < b(98)", 英文表.获取(2) == "a" 且 英文表.获取(3) == "b")

    空串表 = ["", "a"]
    空串表.排序()
    检查("空串排在最前（空串 < 任何非空）", 空串表.获取(1) == "")

    重复表 = [2, 2, 1, 1]
    重复表.排序()
    检查("重复元素排序：[2,2,1,1] ⇒ [1,1,2,2]",
        重复表.获取(1) == 1 且 重复表.获取(2) == 1 且 重复表.获取(3) == 2 且 重复表.获取(4) == 2)

    // ───────── ② 规则 2：不可比 ⇒ 抛异常且数组保持原样 ─────────
    输出("-- ② 不可比 ⇒ 抛异常 --")
    含空值 = [1, 空值]
    空值被拒 = 假
    捕获:
        含空值.排序()
    异常:
        空值被拒 = 真
    结束
    检查("★ 含 空值 ⇒ 抛异常（§2.4.5 空值不参与比较）", 空值被拒)
    检查("★ 抛异常后数组**保持原样**（长度仍 2）", 含空值.长度() == 2)
    检查("★ 抛异常后首元素未被移动（仍 1）", 含空值.获取(1) == 1)

    含数组 = [1, [2]]
    含数组被拒 = 假
    捕获:
        含数组.排序()
    异常:
        含数组被拒 = 真
    结束
    检查("★ 含 数组 ⇒ 抛异常", 含数组被拒)
    检查("★ 抛后长度保持 2", 含数组.长度() == 2)

    含映射 = [1, {"甲": 2}]
    含映射被拒 = 假
    捕获:
        含映射.排序()
    异常:
        含映射被拒 = 真
    结束
    检查("★ 含 映射 ⇒ 抛异常", 含映射被拒)

    含结构体 = [1, 甲盒(2)]
    含结构体被拒 = 假
    捕获:
        含结构体.排序()
    异常:
        含结构体被拒 = 真
    结束
    检查("★ 含 结构体 ⇒ 抛异常", 含结构体被拒)

    跨类别 = [1, "甲"]
    跨类别被拒 = 假
    捕获:
        跨类别.排序()
    异常:
        跨类别被拒 = 真
    结束
    检查("★ 整数 + 文本 混排 ⇒ 抛异常", 跨类别被拒)
    检查("★ 抛后长度保持 2", 跨类别.长度() == 2)

    逻辑混 = [真, 1]
    逻辑混被拒 = 假
    捕获:
        逻辑混.排序()
    异常:
        逻辑混被拒 = 真
    结束
    检查("★ 逻辑 + 整数 混排 ⇒ 抛异常（逻辑不与数值混用）", 逻辑混被拒)

    // ───────── ③ 规则 3：边界（不抛）─────────
    输出("-- ③ 边界 --")
    空表 = []
    空表.排序()
    检查("★ 空数组 排序 ⇒ 无操作、不抛、长度 0", 空表.长度() == 0)
    单表 = [7]
    单表.排序()
    检查("★ 单元素 排序 ⇒ 无操作、值不变", 单表.长度() == 1 且 单表.获取(1) == 7)
    已序表 = [1, 2, 3]
    已序表.排序()
    检查("已有序数组 排序后不变", 已序表.获取(1) == 1 且 已序表.获取(3) == 3)
    逆序表 = [3, 2, 1]
    逆序表.排序()
    检查("完全逆序 排序正确", 逆序表.获取(1) == 1 且 逆序表.获取(3) == 3)

    // ───────── ④ 对照：`是否包含` 不受可比较性约束 ─────────
    输出("-- ④ 对照：是否包含 --")
    混查 = [1, "甲", 空值]
    检查("★ 混合类型数组 `.是否包含(甲)` ⇒ 真（不抛）", 混查.是否包含("甲") == 真)
    检查("★ 混合类型数组 `.是否包含(空值)` ⇒ 真（空值可比较相等）", 混查.是否包含(空值) == 真)
    检查("★ 混合类型数组 `.是否包含(不存在)` ⇒ 假", 混查.是否包含("无") == 假)
    检查("混合类型数组 长度 3", 混查.长度() == 3)

    // ───────── ⑤ 原地语义（排序不返回新数组）─────────
    输出("-- ⑤ 原地语义 --")
    原地 = [3, 1, 2]
    原地.排序()
    检查("★ 排序是**原地**修改：变量本身已变（首项 1）", 原地.获取(1) == 1)
    检查("原地排序后长度不变", 原地.长度() == 3)
    // ⚠ `别名` 是保留关键字，不能作变量名 ⇒ 用 `副本`
    副本 = 原地
    副本.排序()
    检查("★ 值语义：副本排序不影响原件（赋值时已深拷贝）", 原地.长度() == 3)

    收尾()
结束
