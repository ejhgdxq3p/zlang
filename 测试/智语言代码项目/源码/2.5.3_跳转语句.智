通过数 = 0
失败数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("FAILCASE " + 名称)
    结束
结束

简单函数() 整数:
    整数 次数 = 0
    次数 += 1
    返回 次数
结束

判断正负(整数 值) 文本:
    如果 值 > 0:
        返回 "正数"
    否则如果 值 < 0:
        返回 "负数"
    否则:
        返回 "零"
    结束
结束

查找目标(数组 列表, 任意<甲> 目标) 任意<整数|空值>:
    循环 索引, 元素 遍历 列表:
        如果 元素 == 目标:
            返回 索引
        结束
    结束
    返回 空值
结束

查找矩阵(数组 矩阵, 任意<甲> 目标) 任意<映射|空值>:
    循环 行索引, 行 遍历 矩阵:
        循环 列索引, 元素 遍历 行:
            如果 元素 == 目标:
                返回 {"行": 行索引, "列": 列索引}
            结束
        结束
    结束
    返回 空值
结束

测试_全部():
    文本 跳序 = ""
    循环 序甲 = 1, 序甲 < 10, 序甲 += 1:
        如果 序甲 == 5:
            跳序 = 跳序 + "|跳出|"
            跳出
        结束
        跳序 = 跳序 + 转文本(序甲)
    结束
    检查("跳出立即终止循环", 跳序 == "1234|跳出|")

    文本 奇序 = ""
    循环 序丙 = 1, 序丙 < 10, 序丙 += 1:
        如果 序丙 % 2 == 0:
            继续
        结束
        奇序 = 奇序 + 转文本(序丙)
    结束
    检查("继续跳过偶数", 奇序 == "13579")

    文本 组序 = ""
    循环 序庚 = 1, 序庚 < 20, 序庚 += 1:
        如果 序庚 < 5:
            继续
        结束
        如果 序庚 == 7:
            跳出
        结束
        组序 = 组序 + 转文本(序庚)
    结束
    检查("继续+跳出组合=56", 组序 == "56")

    检查("裸返回提前结束", 简单函数() == 1)
    检查("返回-正数", 判断正负(5) == "正数")
    检查("返回-负数", 判断正负(-3) == "负数")
    检查("返回-零", 判断正负(0) == "零")

    列表 = [10, 20, 30, 40, 50]
    检查("循环中返回索引=3", 查找目标(列表, 30) == 3)
    检查("未找到返回空值", 查找目标(列表, 99) == 空值)

    矩阵 = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    位置 = 查找矩阵(矩阵, 5)
    检查("多级跳出-行=2", 位置.获取("行") == 2)
    检查("多级跳出-列=2", 位置.获取("列") == 2)
    检查("多级跳出-未找到=空值", 查找矩阵(矩阵, 99) == 空值)
结束

启动程序():
    测试_全部()
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
