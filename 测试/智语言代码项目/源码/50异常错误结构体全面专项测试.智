// 异常错误结构体 全面专项（规范 4.1 / 4.5）
// 重点验证：异常错误() 返回对象类型标签正确（历史缺陷：误挂"通道"）、
// 描述/类型/位置/堆栈/格式信息() 全字段可用、嵌套异常、除零/越界/类型转换异常

总通过 = 0
总数 = 0

检查(文本 描述, 逻辑 结果):
    本模块.总数 = 本模块.总数 + 1
    如果 结果:
        本模块.总通过 = 本模块.总通过 + 1
        输出("✅ " + 描述)
    否则:
        输出("❌ " + 描述)
    结束
结束

启动程序():
    // ---- 1. 除零异常：类型标签 + 描述 + 格式信息 ----
    捕获:
        结果 = 10 / 0
    异常:
        错误 = 异常错误()
        检查("异常错误().类型 非空", 错误.类型.长度() > 0)
        检查("异常错误().描述 非空", 错误.描述.长度() > 0)
        检查("异常错误().描述 含 零", 错误.描述.是否包含("零"))
        检查("异常错误().位置 非空", 错误.位置.长度() > 0)
        检查("异常错误().堆栈 为文本", 类型(错误.堆栈) == "文本")
        检查("异常错误().格式信息() 返回文本且非空", 类型(错误.格式信息()) == "文本" 且 错误.格式信息().长度() > 0)
        // 关键历史缺陷复核：异常错误对象自身类型必须是"异常错误"，不能是"通道"等
        检查("异常错误() 对象类型标签正确", 类型(错误) == "异常错误")
        检查("异常错误().类型 字段 非 通道(历史缺陷)", 错误.类型 != "通道")
    结束

    // ---- 2. 数组越界异常 ----
    捕获:
        数组 = [1, 2, 3]
        元素 = 数组[5]
    异常:
        错误 = 异常错误()
        检查("数组越界 异常错误().类型 非空", 错误.类型.长度() > 0)
        检查("数组越界 异常错误().描述 非空", 错误.描述.长度() > 0)
        检查("数组越界 对象类型标签正确", 类型(错误) == "异常错误")
    结束

    // ---- 3. 类型转换异常（转整数("abc")） ----
    捕获:
        数 = 转整数("abc")
    异常:
        错误 = 异常错误()
        检查("整数转换异常 描述 非空", 错误.描述.长度() > 0)
        检查("整数转换异常 类型标签正确", 类型(错误) == "异常错误")
    结束

    // ---- 4. 嵌套异常：内层异常不传播到外层 ----
    外层捕获 = 假
    内层捕获 = 假
    捕获:
        捕获:
            内层 = 10 / 0
        异常:
            内层捕获 = 真
            内层错误 = 异常错误()
            检查("嵌套-内层 对象类型标签正确", 类型(内层错误) == "异常错误")
        结束
        外层捕获 = 真 // 内层已被处理，外层应继续走到这里
    异常:
        外层捕获 = 假
    结束
    检查("嵌套异常-内层已捕获", 内层捕获 == 真)
    检查("嵌套异常-外层继续执行(未被内层异常中断)", 外层捕获 == 真)

    // ---- 5. 异常错误() 在异常块内 返回的 格式信息() 确实包含描述 ----
    // 注：转文本(空值) 是编译期错误（规范 4.1 明确），不能用异常块捕获，此处不做运行期测试
    // 说明：异常错误() 仅在 异常: 块内可用，外部调用编译报错，此处不主动测试外部调用（会编译失败）
    // 但验证 异常: 块内 异常错误() 返回的 格式信息() 确实包含描述
    捕获:
        结果 = 5 / 0
    异常:
        错误 = 异常错误()
        完整 = 错误.格式信息()
        检查("格式信息() 包含 描述内容", 完整.是否包含(错误.描述))
    结束

    // ---- 7. 自定义异常抛出（抛出 关键字） ----
    捕获:
        抛出 "自定义错误：数据无效"
    异常:
        错误 = 异常错误()
        检查("抛出 自定义文本 描述正确", 错误.描述 == "自定义错误：数据无效" 或 错误.描述.是否包含("数据无效"))
        检查("抛出 对象类型标签正确", 类型(错误) == "异常错误")
    结束

    // ---- 8. 全局函数 转整数() 非法文本 抛异常（规范 4.1 示例） ----
    捕获:
        结果 = 转整数("xyz不合法")
    异常:
        错误 = 异常错误()
        检查("转整数(非法文本) 抛异常 类型标签正确", 类型(错误) == "异常错误")
        检查("转整数(非法文本) 描述非空", 错误.描述.长度() > 0)
    结束

    输出("")
    输出("异常错误结构体专项 通过：" + 转文本(本模块.总通过) + "/" + 转文本(本模块.总数))
    如果 本模块.总通过 != 本模块.总数:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
