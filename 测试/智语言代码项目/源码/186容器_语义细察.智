启动程序():
    输出("=== 186 容器语义细察 ===")
    // ① 取末尾：**弹出**语义
    数组甲 = [10, 20, 30]
    末 = 数组甲.取末尾()
    检查("取末尾-返回值", 末 == 30)
    检查("取末尾-长度减一(弹出)", 数组甲.长度() == 2)
    检查("取末尾-剩余元素", 数组甲[2] == 20)
    检查("取末尾-连续弹出", 数组甲.取末尾() == 20 且 数组甲.长度() == 1)
    空数组 = []
    // ℹ 空数组取末尾：规范 §4.3 **未定义**该情形，实现**返回空值**（双模一致）。
    //   2026-09-27 曾试改为「抛可捕获异常」，因实测**破坏"弹到空为止"的算法用例**
    //   （`测试/1单个代码文件测试/…/排序二分丙.智`、`排序二分丁.智`）而**回退** ⇒ 保持既有语义。
    空末 = 空数组.取末尾()
    检查("取末尾-空数组返回空值", 空末 == 空值)
    检查("取末尾-空数组后长度仍为0", 空数组.长度() == 0)
    // ② 值语义：赋值/传参后副本独立
    原数组 = [1, 2]
    副本 = 原数组
    副本.追加(3)
    检查("值语义-数组副本追加不影响原", 原数组.长度() == 2)
    检查("值语义-数组副本自身已变", 副本.长度() == 3)
    原映射 = {"甲": 1}
    映射副本 = 原映射
    映射副本.插入("乙", 2)
    检查("值语义-映射副本插入不影响原", 原映射.长度() == 1)
    // ③ 嵌套容器：改动内层是否波及原（写时拷贝正确性）
    外层 = {"内": [1]}
    外层副本 = 外层
    内层 = 外层副本.获取("内")
    内层.追加(2)
    记录("嵌套-局部副本追加后长度", 转文本(内层.长度()))
    记录("嵌套-外层副本内层长度", 转文本(外层副本.获取("内").长度()))
    记录("嵌套-原外层内层长度", 转文本(外层.获取("内").长度()))
    检查("嵌套-取出的内层是副本(原容器不受影响)", 外层.获取("内").长度() == 1)
    // ④ 键类型：整数键 / 逻辑键 / 文本键
    整数键映射 = {}
    整数键映射.插入(1, "甲")
    检查("整数键-插入并获取", 整数键映射.获取(1) == "甲")
    检查("整数键-是否包含", 整数键映射.是否包含(1) == 真)
    检查("整数键-长度", 整数键映射.长度() == 1)
    // ⑤ 删除/清空的返回值与后续状态
    映射乙 = {"甲": 1, "乙": 2}
    映射乙.删除("甲")
    检查("删除-长度减一", 映射乙.长度() == 1)
    检查("删除-已删键不可见", 映射乙.是否包含("甲") == 假)
    检查("删除-取已删键得空值", 映射乙.获取("甲") == 空值)
    映射乙.清空()
    检查("清空-长度归零", 映射乙.长度() == 0)
    检查("清空-所有键为空数组", 映射乙.所有键().长度() == 0)
    数组乙 = [1, 2, 3]
    数组乙.清空()
    检查("数组清空-长度归零", 数组乙.长度() == 0)
    数组乙.追加(9)
    检查("数组清空-追加仍可用", 数组乙.长度() == 1)
    检查("数组清空-追加的元素正确", 数组乙[1] == 9)
    // ⑥ 所有键/所有值的完备性
    映射丙 = {"甲": 10, "乙": 20, "丙": 30}
    键集 = 映射丙.所有键()
    值集 = 映射丙.所有值()
    检查("所有键-长度", 键集.长度() == 3)
    检查("所有值-长度", 值集.长度() == 3)
    检查("所有键-含甲", 键集.是否包含("甲") == 真)
    检查("所有值-含30", 值集.是否包含(30) == 真)
    // ⑦ 排序 / 查找索引 / 反转 的语义
    乱序 = [3, 1, 2, 1]
    乱序.排序()
    检查("排序-升序", 乱序[1] == 1 且 乱序[4] == 3)
    检查("查找索引-返回首次出现", 乱序.查找索引(1) == 1)
    检查("查找索引-未找到返回0", 乱序.查找索引(99) == 0)
    乱序.反转()
    检查("反转-降序", 乱序[1] == 3)
    收尾()
结束
