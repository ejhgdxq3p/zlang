// §4.4 映射方法（8 个）条款级矩阵（双模）
// 规范条款：§4.4 方法表（长度/所有键/所有值/插入/删除/是否包含/获取/清空）
//   · .插入 是「插入或更新」，更新已有键不改变键顺序
//   · .是否包含 只检查键
//   · .获取 键不存在返回空值
//   · .删除 不存在的键为无操作
枚举 等级:
    低
    高
结束

结构体 键盒(整数 编号):
    整数 标识 = 编号
结束

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 292 映射方法八方法条款级矩阵（§4.4）===")

    输出("-- .长度() --")
    空映射甲 = {}
    检查("空映射", 空映射甲.长度() == 0)
    检查("四键映射", {"姓名": "小明", "年龄": 18, "班级": "高一", "成绩": 92}.长度() == 4)
    检查("单键映射", {"甲": 1}.长度() == 1)
    检查("整数键映射", {1: "一", 2: "二"}.长度() == 2)

    输出("-- .所有键() / .所有值()：插入序 --")
    学生 = {"姓名": "小明", "年龄": 18, "班级": "高一"}
    键数组 = 学生.所有键()
    检查("所有键长度", 键数组.长度() == 3)
    相等文本("第 1 键", 键数组[1], "姓名")
    相等文本("第 2 键", 键数组[2], "年龄")
    相等文本("第 3 键", 键数组[3], "班级")
    值数组 = 学生.所有值()
    检查("所有值长度", 值数组.长度() == 3)
    检查("所有值含回原值", 值数组.是否包含(18) == 真)
    空键 = 空映射甲.所有键()
    检查("空映射所有键为空数组", 空键.长度() == 0)

    输出("-- .插入(键, 值)：新增 --")
    库存 = {"苹果": 3}
    库存.插入("香蕉", 5)
    检查("新增后长度", 库存.长度() == 2)
    检查("新增键可查", 库存.是否包含("香蕉") == 真)
    检查("新增值可查", 库存.获取("香蕉") == 5)
    相等文本("新增键追加在末尾", 库存.所有键()[2], "香蕉")

    输出("-- .插入(键, 值)：更新已有键（不改变顺序、不增加长度）--")
    库存.插入("苹果", 10)
    检查("更新后长度不变", 库存.长度() == 2)
    检查("更新后取到新值", 库存.获取("苹果") == 10)
    相等文本("更新不改变键顺序", 库存.所有键()[1], "苹果")
    库存.插入("苹果", 0)
    检查("再次更新为零", 库存.获取("苹果") == 0)

    输出("-- .删除(键) --")
    临时表 = {"甲": 1, "乙": 2, "丙": 3}
    临时表.删除("乙")
    检查("删除后长度减一", 临时表.长度() == 2)
    检查("删除后不含该键", 临时表.是否包含("乙") == 假)
    相等文本("其余键顺序保持", 转文本(临时表.所有键()), "[\引号甲\引号, \引号丙\引号]")
    临时表.删除("不存在")
    检查("删除不存在的键为无操作（长度不变）", 临时表.长度() == 2)
    临时表.删除("甲")
    临时表.删除("丙")
    检查("逐个删除后为空", 临时表.长度() == 0)

    输出("-- .是否包含(键)：只检查键 --")
    查询 = {"甲": 1, "乙": 2}
    检查("键存在", 查询.是否包含("甲") == 真)
    检查("键不存在", 查询.是否包含("丙") == 假)
    检查("值不参与包含判定", 查询.是否包含(1) == 假)
    检查("空映射不含任何键", 空映射甲.是否包含("甲") == 假)

    输出("-- .获取(键)：键不存在返回空值 --")
    检查("命中", 查询.获取("甲") == 1)
    缺失值 = 查询.获取("丙")
    检查("缺失返回空值", 缺失值 == 空值)
    检查("获取不改变映射", 查询.长度() == 2)
    数字键表 = {7: "幸"}
    检查("获取整数键", 数字键表.获取(7) == "幸")

    输出("-- .清空() --")
    清空甲 = {"a": 1, "b": 2}
    清空甲.清空()
    检查("清空后长度 0", 清空甲.长度() == 0)
    检查("清空后所有键为空", 清空甲.所有键().长度() == 0)
    清空甲.插入("新", 9)
    检查("清空后可继续插入", 清空甲.获取("新") == 9)
    空映射甲.清空()
    检查("空映射清空无操作", 空映射甲.长度() == 0)

    输出("-- 键类型：文本/整数/逻辑/枚举/结构体 --")
    检查("整数键 1 与 2 区分", {1: "一", 2: "二"}.获取(2) == "二")
    逻辑键表 = {真: "是", 假: "否"}
    检查("逻辑键 真", 逻辑键表.获取(真) == "是")
    检查("逻辑键 假", 逻辑键表.获取(假) == "否")
    枚举键表 = {等级.低: 1, 等级.高: 2}
    检查("枚举键 高", 枚举键表.获取(等级.高) == 2)
    结构键表 = {键盒(1): "一", 键盒(2): "二"}
    检查("结构体键字面量按字段区分（F62）", 结构键表.获取(键盒(2)) == "二")
    检查("结构体键字面量长度 2", 结构键表.长度() == 2)
    结构键表.插入(键盒(3), "三")
    检查("结构体键运行时插入可区分", 结构键表.获取(键盒(3)) == "三")
    检查("结构体键总长度 3", 结构键表.长度() == 3)

    输出("-- 嵌套值：数组 / 映射 --")
    嵌套表 = {"列表": [1, 2, 3], "子表": {"甲": 1}}
    检查("数组值长度", 嵌套表.获取("列表").长度() == 3)
    检查("数组值元素", 嵌套表.获取("列表")[2] == 2)
    检查("映射值可取", 嵌套表.获取("子表").获取("甲") == 1)
    嵌套表.插入("新表", {"乙": 2})
    检查("插入新映射值", 嵌套表.获取("新表").获取("乙") == 2)

    输出("-- 值语义：取出的容器值是副本 --")
    源表 = {"列表": [1, 2]}
    取出列表 = 源表.获取("列表")
    取出列表.追加(3)
    检查("取出并修改不影响映射内数组", 源表.获取("列表").长度() == 2)

    收尾()
结束
