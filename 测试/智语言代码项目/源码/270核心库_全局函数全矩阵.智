// §4.1 全局函数完整矩阵（输出 / 错误输出 / 转整数 / 转小数 / 转文本 / 类型）
// 依据：《智语言编程规范》§4.1、§2.4（类型规则）、§2.2（字面量）
// 判定：失败项以 ❌ 行标记；末尾输出「通过：N / M」；双模必须一致。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

结构体 坐标:
    整数 横 = 0
    整数 纵 = 0
结束

启动程序():
    输出("=== 01 全局函数完整矩阵 ===")

    // ───────── 转整数 ─────────
    检查("转整数-整数恒等", 转整数(42) == 42)
    检查("转整数-负整数恒等", 转整数(0 - 42) == 0 - 42)
    检查("转整数-零", 转整数(0) == 0)
    检查("转整数-正小数向零取整", 转整数(3.7) == 3)
    检查("转整数-负小数向零取整", 转整数(0 - 3.7) == 0 - 3)
    检查("转整数-0.999 向零", 转整数(0.999) == 0)
    检查("转整数-负 0.999 向零", 转整数(0 - 0.999) == 0)
    检查("转整数-2.5 向零", 转整数(2.5) == 2)
    检查("转整数-负 2.5 向零", 转整数(0 - 2.5) == 0 - 2)
    检查("转整数-文本正整数", 转整数("123") == 123)
    检查("转整数-文本负整数", 转整数("-42") == 0 - 42)
    检查("转整数-文本零", 转整数("0") == 0)
    检查("转整数-文本前导零", 转整数("007") == 7)
    检查("转整数-最大整数", 转整数("9223372036854775807") == 9223372036854775807)
    检查("转整数-最小整数", 转整数("-9223372036854775808") == 0 - 9223372036854775807 - 1)
    捕获:
        转整数("abc")
        检查("转整数-非法文本应抛异常", 假)
    异常:
        检查("转整数-非法文本抛异常", 真)
        记录("转整数(abc) 异常类型", 异常错误().类型)
        检查("转整数-异常描述非空", 异常错误().描述.长度() > 0)
    结束
    捕获:
        转整数("")
        检查("转整数-空串应抛异常", 假)
    异常:
        检查("转整数-空串抛异常", 真)
    结束
    捕获:
        转整数("12.5")
        检查("转整数-小数字文本应抛异常", 假)
    异常:
        检查("转整数-小数字文本抛异常", 真)
    结束
    捕获:
        转整数("9223372036854775808")
        检查("转整数-上溢文本应抛异常", 假)
    异常:
        检查("转整数-上溢文本抛异常", 真)
    结束
    捕获:
        转整数(" 42 ")
        记录("转整数(含空格) 的实际处置", 转文本(转整数(" 42 ")))
    异常:
        检查("转整数-含空格抛异常（不做隐式 trim）", 真)
    结束

    // ───────── 转小数 ─────────
    检查("转小数-整数提升", 转小数(42) == 42.0)
    检查("转小数-负整数提升", 转小数(0 - 7) == 0 - 7.0)
    检查("转小数-小数恒等", 转小数(3.14) == 3.14)
    检查("转小数-文本", 转小数("3.14") == 3.14)
    检查("转小数-文本负数", 转小数("-2.5") == 0 - 2.5)
    检查("转小数-文本整数", 转小数("7") == 7.0)
    检查("转小数-文本前导零", 转小数("0.50") == 0.5)
    检查("转小数-零", 转小数(0) == 0.0)
    捕获:
        转小数("abc")
        检查("转小数-非法文本应抛异常", 假)
    异常:
        检查("转小数-非法文本抛异常", 真)
        检查("转小数-异常描述非空", 异常错误().描述.长度() > 0)
    结束
    捕获:
        转小数("")
        检查("转小数-空串应抛异常", 假)
    异常:
        检查("转小数-空串抛异常", 真)
    结束

    // ───────── 转文本 ─────────
    检查("转文本-整数", 转文本(42) == "42")
    检查("转文本-负整数", 转文本(0 - 7) == "-7")
    检查("转文本-零", 转文本(0) == "0")
    检查("转文本-小数", 转文本(3.14) == "3.14")
    检查("转文本-负小数", 转文本(0 - 0.5) == "-0.5")
    检查("转文本-小数整值保留小数点", 转文本(2.0) == "2.0")
    检查("转文本-逻辑真", 转文本(真) == "真")
    检查("转文本-逻辑假", 转文本(假) == "假")
    检查("转文本-文本恒等", 转文本("abc") == "abc")
    检查("转文本-中文文本", 转文本("你好世界") == "你好世界")
    检查("转文本-空文本", 转文本("") == "")
    检查("转文本-数组", 转文本([1, 2, 3]) == "[1, 2, 3]")
    检查("转文本-空数组", 转文本([]) == "[]")
    检查("转文本-嵌套数组", 转文本([[1, 2], [3]]) == "[[1, 2], [3]]")
    // 容器内**文本元素**的显示形式（2026-10-22 定案）：规范 §4.1/§2.4 示例与 §4.2 示例一致，
    //   容器内文本一律**带双引号**（`["a", "b"]` / `{"键": "值"}`）⇒ 消除 `[""]` 与 `[]` 同形的歧义。
    //   已在 base `运行时值::转文本` 按规范实现（`容器内值转文本` / `容器内键转文本`），此处为护栏。
    检查("转文本-数组含文本元素带引号", 转文本(["a", "b"]) == "[\引号a\引号, \引号b\引号]")
    检查("转文本-空串数组与空数组可区分", 转文本([""]) == "[\引号\引号]" 且 转文本([""]) != 转文本([]))
    检查("转文本-数组含空值", 转文本([1, 空值]) == "[1, 空值]")
    检查("转文本-映射键值带引号", 转文本({"键": "值"}) == "{\引号键\引号: \引号值\引号}")
    检查("转文本-空映射", 转文本({}) == "{}")
    检查("转文本-嵌套容器", 转文本({"a": [1, 2]}) == "{\引号a\引号: [1, 2]}")
    检查("转文本-结构相等往返", 转文本([1, [2, 3]]) == "[1, [2, 3]]")

    // ───────── 类型 ─────────
    检查("类型-整数", 类型(42) == "整数")
    检查("类型-小数", 类型(3.14) == "小数")
    检查("类型-文本", 类型("abc") == "文本")
    检查("类型-逻辑真", 类型(真) == "逻辑")
    检查("类型-逻辑假", 类型(假) == "逻辑")
    检查("类型-空值", 类型(空值) == "空值")
    检查("类型-数组", 类型([1, 2]) == "数组")
    检查("类型-空数组", 类型([]) == "数组")
    检查("类型-映射", 类型({"a": 1}) == "映射")
    检查("类型-空映射", 类型({}) == "映射")
    检查("类型-结构体", 类型(坐标()) == "坐标")
    检查("类型-转换后整数", 类型(转整数("7")) == "整数")
    检查("类型-转换后小数", 类型(转小数("7")) == "小数")

    // ───────── 输出 / 错误输出（可调用性；错误输出走 stderr，不参与 stdout 断言）─────────
    输出("  ℹ 输出通道可用")
    错误输出("  ℹ 错误输出通道可用")

    收尾()
结束
