// 规范 §4.4 映射方法（共 8 个）：是否包含仅查键；获取未命中返回 空值
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 163 映射方法 ===")
    学生信息 = {"姓名": "小明", "年龄": 18, "班级": "高一(1)班"}
    // ① 长度
    检查("长度", 学生信息.长度() == 3)
    // ② 所有键 / ③ 所有值
    键数组 = 学生信息.所有键()
    值数组 = 学生信息.所有值()
    检查("所有键-个数", 键数组.长度() == 3)
    检查("所有值-个数", 值数组.长度() == 3)
    检查("所有键-含姓名", 键数组.是否包含("姓名") == 真)
    检查("所有值-含小明", 值数组.是否包含("小明") == 真)
    // ④ 插入（新增与更新）
    学生信息.插入("成绩", 92)
    检查("插入-新增键", 学生信息.长度() == 4)
    检查("插入-新增可取", 学生信息.获取("成绩") == 92)
    学生信息.插入("成绩", 95)
    检查("插入-同键更新", 学生信息.获取("成绩") == 95)
    检查("插入-更新不增数量", 学生信息.长度() == 4)
    // ⑤ 删除
    学生信息.删除("成绩")
    检查("删除-数量-1", 学生信息.长度() == 3)
    检查("删除-键不存在", 学生信息.是否包含("成绩") == 假)
    // ⑥ 是否包含（仅查键）
    检查("是否包含-键存在真", 学生信息.是否包含("姓名") == 真)
    检查("是否包含-值不是键", 学生信息.是否包含("小明") == 假)
    // ⑦ 获取（未命中返回 空值）
    检查("获取-命中", 学生信息.获取("年龄") == 18)
    检查("获取-未命中返回空值", 学生信息.获取("不存在") == 空值)
    // ⑧ 清空
    映射甲 = {"甲": 1}
    映射甲.清空()
    检查("清空-长度0", 映射甲.长度() == 0)
    // 下标语法与空容器
    映射乙 = {}
    检查("空映射字面量", 映射乙.长度() == 0)
    映射乙["键"] = 1
    检查("下标赋值后可读", 映射乙["键"] == 1)
    收尾()
结束
