// 270 的边界补充：8 个全局函数的转换取舍、异常路径与 类型() 全谱（规范 §4.1 / §2.4.4 / §2.4.5）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

结构体 点():
    整数 横 = 0
    整数 纵 = 0
结束

平方(整数 甲) 整数:
    返回 甲 * 甲
结束

枚举 颜色:
    红
    绿
    蓝
结束

启动程序():
    输出("=== 281 全局函数转换与类型边界 ===")

    // ───────── 转整数：小数向零截断、文本解析、非法抛异常 ─────────
    检查("转整数-3.9 向零截断为 3", 转整数(3.9) == 3)
    检查("转整数--3.9 向零截断为 -3", 转整数(0 - 3.9) == 0 - 3)
    检查("转整数-整数原样", 转整数(42) == 42)
    检查("转整数-文本整数", 转整数("123") == 123)
    检查("转整数-文本负数", 转整数("-456") == 0 - 456)
    检查("转整数-文本零", 转整数("0") == 0)
    捕获:
        转整数("abc")
        检查("转整数-非法文本应抛异常", 假)
    异常:
        检查("转整数-非法文本抛异常", 真)
        检查("转整数-异常类型为类型转换错误", 异常错误().类型 == "类型转换错误")
    结束
    捕获:
        转整数("12.9")
        检查("转整数-小数字文本应抛异常（不做隐式截断）", 假)
    异常:
        检查("转整数-小数字文本抛异常", 真)
    结束
    捕获:
        转整数("9223372036854775808")
        检查("转整数-溢出文本应抛异常", 假)
    异常:
        检查("转整数-溢出文本抛异常", 真)
    结束

    // ───────── 转小数：整数提升、文本解析、非法抛异常 ─────────
    检查("转小数-整数提升", 转小数(3) == 3.0)
    检查("转小数-文本小数", 转小数("3.14") == 3.14)
    检查("转小数-负数文本", 转小数("-0.5") == 0 - 0.5)
    检查("转小数-小数原样", 转小数(2.5) == 2.5)
    捕获:
        转小数("abc")
        检查("转小数-非法文本应抛异常", 假)
    异常:
        检查("转小数-非法文本抛异常", 真)
    结束

    // ───────── 转文本：全类型（除空值/结构体）─────────
    检查("转文本-整数", 转文本(42) == "42")
    检查("转文本-负数", 转文本(0 - 7) == "-7")
    检查("转文本-小数", 转文本(3.5) == "3.5")
    检查("转文本-逻辑真", 转文本(真) == "真")
    检查("转文本-逻辑假", 转文本(假) == "假")
    检查("转文本-文本原样", 转文本("文本") == "文本")
    检查("转文本-数组", 转文本([1, 2]) == "[1, 2]")
    检查("转文本-空数组", 转文本([]) == "[]")
    检查("转文本-空映射", 转文本({}) == "{}")
    检查("转文本-整数与小数混合数组可读", 转文本([1, 2.5]).是否包含("2.5"))

    // ───────── 类型()：全谱类型名 ─────────
    检查("类型-整数", 类型(42) == "整数")
    检查("类型-小数", 类型(3.5) == "小数")
    检查("类型-文本", 类型("甲") == "文本")
    检查("类型-逻辑", 类型(真) == "逻辑")
    检查("类型-空值", 类型(空值) == "空值")
    检查("类型-数组", 类型([1]) == "数组")
    检查("类型-映射", 类型({"甲": 1}) == "映射")
    检查("类型-结构体实例", 类型(点()) == "点")
    点实例 = 点()
    检查("类型-结构体字段可读", 点实例.横 == 0)
    点实例.横 = 5
    检查("类型-结构体字段可写", 点实例.横 == 5)
    颜色变量 = 颜色.红
    检查("类型-枚举成员", 类型(颜色变量) == "颜色")

    // ───────── 函数引用 的类型 ─────────
    检查("类型-函数引用", 类型(平方) == "函数")
    检查("函数引用-可调用", 平方(4) == 16)

    // ───────── 输出 / 错误输出 通道（不返回值，验证不抛异常）─────────
    输出("  ℹ 输出通道正常")
    错误输出("  ℹ 错误输出通道正常")
    检查("输出-可多次调用", 真)

    // ───────── 异常错误() 仅在异常块内可用（正向：块内可读）─────────
    捕获:
        抛出 异常错误("自定义")
    异常:
        检查("异常错误-块内可构造", 异常错误().描述 == "自定义")
    结束

    收尾()
结束
