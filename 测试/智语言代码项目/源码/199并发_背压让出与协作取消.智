// 190 并发模块：**单文件模式**下的「背压 / 让出 / 父任务退出 / 协作取消 / 有界压力」（2026-09-28）
//
// 与 189（通道·监听·终止器基础矩阵）互补：本用例专测**规范中易被忽略但影响正确性**的条款：
//   · §5.7.3「有缓冲通道发送时缓冲区满 ⇒ 阻塞直到有空间」（**不丢弃、保序**）；
//   · §5.7.2「任务让出：用于长计算任务防止饿死其他任务」；
//   · §5.7.2「父任务退出 ⇒ 子任务继续运行，不自动取消」；
//   · §5.7.5 终止器 + 任务循环检查 ⇒ **协作取消**；
//   · 有界压力：多生产者 / 单消费者（8 × 20 = 160 条）。
//
// 资源纪律（硬要求）：休眠 ≤ 100ms、任务 ≤ 10、消息 ≤ 160、一切等待都有**超时看护** ✓，
//   循环不依赖"永真 + 无看护" ✗（协作取消那处由终止器 + 批量等待超时双重兜底 ✓）。
导入 并发
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 190 并发：背压 / 让出 / 父任务退出 / 协作取消 / 有界压力 ===")

    // ① 背压：缓冲区满时发送**阻塞**（不丢弃、保序）
    背压通道 = 并发.通道(1)
    背压通道.发送(1)
    背压任务 = 并发.启动任务(函数() 整数:
        背压通道.发送(2)
        背压通道.发送(3)
        返回 9
    结束)
    并发.监听超时("等一会儿", 50)
    并发.多路监听([])
    检查("背压-第一条=1", 背压通道.接收() == 1)
    检查("背压-第二条=2（未丢弃）", 背压通道.接收() == 2)
    检查("背压-第三条=3（保序）", 背压通道.接收() == 3)
    检查("背压-任务完成=9", 背压任务.等待结果() == 9)
    背压通道.关闭()

    // ② 任务让出：长任务正确 + 同任务组其他任务也能完成
    // ⚠ 规避解析歧义：匿名函数实参内，语句若以**裸标识符结尾**且下一语句以标识符开头，
    //   会被读成「类型标注 名称」⇒ 报「表达式中不允许类型标注」✗。
    //   故把「以裸标识符结尾」的语句放到该块**最后一条**（这里先 让出、再累加）✓。
    长任务 = 并发.启动任务(函数() 整数:
        局部和 = 0
        循环 序号 = 1, 序号 <= 300, 序号 += 1:
            并发.任务让出()
            局部和 = 局部和 + 序号
        结束
        返回 局部和
    结束)
    短任务 = 并发.启动任务(函数() 整数:
        返回 5
    结束)
    检查("让出-长任务结果=45150", 长任务.等待结果() == 45150)
    检查("让出-短任务完成=5", 短任务.等待结果() == 5)

    // ③ 子任务独立运行（由主程序启动）—— **规避两个本轮新登记缺陷**：
    //   F26：**匿名函数体内**调用 `并发.启动任务`/`批量等待`（二者索引用 usize::MAX 哨兵）
    //        ⇒ 编译模式报「回调桥：未知函数 18446744073709551615」**编译失败** ✗（解释模式正常 ⇒ **真双模分歧**）；
    //   F25：**父任务退出后**，其子任务通信所用通道被关闭 ⇒ 子任务发送抛「向已关闭的通道发送数据」✗
    //        （与规范 §5.7.2「父任务退出 ⇒ 子任务继续运行，不自动取消」冲突 ✓）。
    //   最小复现件：`测试/2项目类测试/并发语义项目/已知缺陷复现/F25F26_父任务内启动子任务.智` ✓
    后代通道 = 并发.通道(1)
    子任务 = 并发.启动任务(函数():
        时间.休眠(80)
        后代通道.发送("子完成")
        后代通道.关闭()
    结束)
    检查("子任务-无返回值任务等待结果=空值", 子任务.等待结果() == 空值)
    检查("子任务-送达内容正确", 后代通道.接收() == "子完成")
    检查("子任务-发送后通道已关闭=真", 后代通道.是否关闭() == 真)

    // ④ 协作取消：终止器 + 任务循环检查
    停止信号 = 并发.终止器()
    协作任务 = 并发.启动任务(函数() 整数:
        轮数 = 0
        循环 真:
            如果 停止信号.是否终止():
                跳出
            结束
            轮数 = 轮数 + 1
            并发.任务让出()
        结束
        返回 轮数
    结束)
    时间.休眠(50)
    停止信号.触发终止()
    取消结果 = 并发.批量等待([协作任务], 800)
    检查("协作取消-任务在超时前退出", 取消结果[1] != 空值)
    检查("协作取消-终止状态=真", 停止信号.是否终止() == 真)

    // ⑤ 有界压力：多生产者 / 单消费者（160 条）
    压力通道 = 并发.通道(16)
    生产者表 = []
    循环 索引 = 1, 索引 <= 8, 索引 += 1:
        生产编号 = 索引
        生产句柄 = 并发.启动任务(函数() 整数:
            循环 次序 = 1, 次序 <= 20, 次序 += 1:
                压力通道.发送(生产编号)
            结束
            返回 生产编号
        结束)
        生产者表.追加(生产句柄)
    结束
    收到总数 = 0
    循环 序号 = 1, 序号 <= 160, 序号 += 1:
        项 = 压力通道.接收()
        如果 项 == 空值:
            跳出
        结束
        收到总数 = 收到总数 + 1
    结束
    检查("有界压力-收到 160 条（无丢失）", 收到总数 == 160)
    检查("有界压力-生产者全部完成", 并发.批量等待(生产者表).长度() == 8)
    压力通道.关闭()
    检查("关闭后-接收=空值", 压力通道.接收() == 空值)

    // ⑥ 任务让出（基础可用性）
    并发.任务让出()
    检查("任务让出-可调用且不抛", 真)

    收尾()
结束
