// 48 文件模块(15) + 系统模块(7) 全面测试（规范 5.2 / 5.5）
// 双模运行：解释 + 编译。限时 2 分钟。
// 文件操作落在测试子目录 ./测试文件临时/ 下，避免污染项目根。

导入 文件
导入 系统

总数 = 0
通过数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
    否则:
        输出("❌ " + 名称)
    结束
结束

启动程序():
    目录 = "./测试临时48_" + 转文本(系统.获取进程编号())
    // 清理可能存在的旧目录
    如果 文件.是否存在(目录):
        文件.删除目录(目录)
    结束
    文件.创建目录(目录)
    检查("文件.是否存在 目录 真", 文件.是否存在(目录) == 真)
    检查("文件.是目录 真", 文件.是目录(目录) == 真)
    检查("文件.是文件 目录 假", 文件.是文件(目录) == 假)

    // ---- 文件模块：写入/读取/追加 ----
    文件1 = 目录 + "/a.txt"
    文件.写入(文件1, "第一行" + "\换行" + "第二行")
    检查("文件.写入后 存在", 文件.是否存在(文件1) == 真)
    检查("文件.是文件 真", 文件.是文件(文件1) == 真)
    大小 = 文件.获取大小(文件1)
    检查("文件.获取大小 > 0", 大小 > 0)
    内容 = 文件.读取(文件1)
    检查("文件.读取 含第一行", 内容.是否包含("第一行"))
    检查("文件.读取 含第二行", 内容.是否包含("第二行"))

    文件.追加(文件1, "\换行" + "第三行")
    内容2 = 文件.读取(文件1)
    检查("文件.追加 含第三行", 内容2.是否包含("第三行"))

    // ---- 文件模块：复制/重命名 ----
    文件2 = 目录 + "/b.txt"
    文件.复制(文件1, 文件2)
    检查("文件.复制 目标存在", 文件.是否存在(文件2) == 真)

    文件3 = 目录 + "/c.txt"
    文件.重命名(文件2, 文件3)
    检查("文件.重命名 旧不存在", 文件.是否存在(文件2) == 假)
    检查("文件.重命名 新存在", 文件.是否存在(文件3) == 真)

    // ---- 文件模块：遍历目录 ----
    列表 = 文件.遍历目录(目录)
    检查("文件.遍历目录 含a.txt", 列表.是否包含("a.txt"))
    检查("文件.遍历目录 含c.txt", 列表.是否包含("c.txt"))
    检查("文件.遍历目录 长度>=2", 列表.长度() >= 2)

    // ---- 文件模块：删除文件/目录 ----
    文件.删除(文件3)
    检查("文件.删除 后不存在", 文件.是否存在(文件3) == 假)
    文件.删除(文件1)
    // 删空目录
    文件.删除目录(目录)
    检查("文件.删除目录 后不存在", 文件.是否存在(目录) == 假)

    // ---- 文件模块：读取不存在文件 ----
    // 规范 §5.2：读取不存在文件应抛「文件错误」异常（库实际行为即抛异常，与规范一致）。
    // 故此处断言异常被捕获，而非期望返回空文本。
    读取不存在已捕获 = 假
    捕获:
        缺失内容 = 文件.读取("./不存在的文件_xyz.txt")
    异常:
        读取不存在已捕获 = 真
    结束
    检查("文件.读取 不存在 抛文件错误异常", 读取不存在已捕获 == 真)

    // ---- 文件模块：当前目录/切换目录 ----
    原目录 = 文件.获取当前目录()
    检查("文件.获取当前目录 非空", 原目录.长度() > 0)
    // 切到一个子目录再切回（用相对路径）
    文件.创建目录(目录)
    文件.切换目录(目录)
    现在目录 = 文件.获取当前目录()
    检查("文件.切换目录 生效", 现在目录.是否包含("测试临时48_"))
    文件.切换目录("..")
    回目录 = 文件.获取当前目录()
    检查("文件.切换目录 .. 回到原目录", 回目录 == 原目录)
    文件.删除目录(目录)

    // ---- 系统模块 ----
    // 系统模块：须 模块.函数 限定调用（裸名需 导入 系统 展开）
    参数 = 系统.获取参数()
    检查("获取参数 返回数组或空值", 类型(参数) == "数组" 或 参数 == 空值)
    平台 = 系统.获取平台()
    检查("系统.平台名称 非空", 平台.长度() > 0)
    // 库返回首字母大写（"Windows"/"Linux"/"Macos"）
    检查("系统.平台名称 为 Windows/Linux/Macos 之一", 平台 == "Windows" 或 平台 == "Linux" 或 平台 == "Macos")

    进程号 = 系统.获取进程编号()
    检查("系统.进程编号 > 0", 进程号 > 0)

    // 环境变量
    系统.设置环境变量("智语言测试临时变量", "测试值123")
    读回 = 系统.获取环境变量("智语言测试临时变量")
    检查("系统.设置/获取环境变量 一致", 读回 == "测试值123")

    // 执行外部命令（cmd/sh 跨平台，输出 "智语言" 并回显）
    捕获:
        结果 = 系统.执行("echo 智语言命令测试")
        检查("执行 返回文本", 类型(结果) == "文本")
        // Windows 下 echo 输出 GBK 但 系统.执行 内部已转码；用宽松检查
        // 检查("执行 含关键字", 结果.是否包含("命令测试")) // 编码敏感，跳过精确断言
    异常:
        检查("执行 不应抛异常", 假)
    结束

    输出("")
    输出("===== 48 文件与系统模块 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + " 通过：" + 转文本(本模块.通过数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
