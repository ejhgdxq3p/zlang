收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 187 工具模块算法与正则 ===")
    // ① 哈希：与公开标准向量逐字比对
    检查("MD5(空) 标准向量", 工具.哈希算法("MD5", "") == "d41d8cd98f00b204e9800998ecf8427e")
    检查("MD5(abc) 标准向量", 工具.哈希算法("MD5", "abc") == "900150983cd24fb0d6963f7d28e17f72")
    检查("SHA256(abc) 标准向量", 工具.哈希算法("SHA256", "abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    检查("MD5 长度32", 工具.哈希算法("MD5", "甲").长度() == 32)
    检查("SHA256 长度64", 工具.哈希算法("SHA256", "甲").长度() == 64)
    检查("哈希-中文输入稳定", 工具.哈希算法("MD5", "智语言") == 工具.哈希算法("MD5", "智语言"))
    检查("哈希-不同输入不同结果", 工具.哈希算法("MD5", "甲") != 工具.哈希算法("MD5", "乙"))
    // ② 编码：BASE64 往返（含中文/符号）
    检查("BASE64-中文往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "你好，智语言！")) == "你好，智语言！")
    检查("BASE64-甲乙编码值", 工具.编码方案("BASE64", "甲乙") == "55Sy5LmZ")
    检查("BASE64-空串往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "")) == "")
    检查("BASE64-长文本往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "0123456789" + "0123456789" + "0123456789")) == "012345678901234567890123456789")
    // ③ 唯一编号：UUID 形态
    编号甲 = 工具.唯一编号()
    编号乙 = 工具.唯一编号()
    检查("UUID-长度36", 编号甲.长度() == 36)
    检查("UUID-连字符5段", 编号甲.分隔("-").长度() == 5)
    检查("UUID-两次不同", 编号甲 != 编号乙)
    检查组 = [工具.唯一编号(), 工具.唯一编号(), 工具.唯一编号()]
    检查("UUID-批量互不相同", 检查组[1] != 检查组[2] 且 检查组[2] != 检查组[3] 且 检查组[1] != 检查组[3])
    // ④ 正则（F13 修复后可用反斜杠元字符）
    检查("正则-反斜杠d+ 多匹配", 工具.正则匹配("\反斜杠d+", "a1b22c333").长度() == 3)
    检查("正则-字符类", 工具.正则匹配("[0-9]+", "a1b22").长度() == 2)
    检查("正则-中文匹配", 工具.正则匹配("甲+", "甲甲乙").长度() == 1)
    检查("正则-无匹配返回空数组", 工具.正则匹配("\反斜杠d+", "甲乙").长度() == 0)
    检查("正则-锚点整串", 工具.正则匹配("^\反斜杠d+$", "12345").长度() == 1)
    检查("正则-方括号自定义集", 工具.正则匹配("[甲乙]+", "甲乙丙丁甲").长度() > 0)
    检查("正则替换-数字脱敏", 工具.正则替换("\反斜杠d+", "#", "甲1乙22丙333") == "甲#乙#丙#")
    检查("正则替换-无匹配原样", 工具.正则替换("\反斜杠d+", "#", "甲乙") == "甲乙")
    // ⑤ 数据格式：JSON 往返（嵌套 + 数组）
    数据 = {"名": "甲", "数": 7, "列表": [1, 2, 3], "内": {"键": "值"}}
    结构化文本 = 工具.生成数据("JSON", 数据)
    回来 = 工具.解析数据("JSON", 结构化文本)
    检查("JSON-顶层键数", 回来.长度() == 4)
    检查("JSON-文本值", 回来.获取("名") == "甲")
    检查("JSON-整数值", 回来.获取("数") == 7)
    检查("JSON-数组元素", 回来.获取("列表")[2] == 2)
    检查("JSON-嵌套值", 回来.获取("内").获取("键") == "值")
    数组文本化 = 工具.生成数据("JSON", [1, 2, 3])
    检查("JSON-数组往返", 工具.解析数据("JSON", 数组文本化).长度() == 3)
    // ⑥ 不支持参数 ⇒ ✅ F14 已修（2026-09-27）：现抛**可捕获异常**（原先静默返回错误文本/原样输入）
    捕获:
        工具.哈希算法("SHA1", "abc")
        检查("哈希-非法算法应抛异常", 假)
    异常:
        检查("哈希-非法算法抛异常", 真)
        检查("哈希-异常描述含算法名", 异常错误().描述.是否包含("SHA1"))
    结束
    捕获:
        工具.编码方案("HEX", "甲乙")
        检查("编码-非法方案应抛异常", 假)
    异常:
        检查("编码-非法方案抛异常", 真)
    结束
    捕获:
        工具.解码方案("URL", "abc")
        检查("解码-非法方案应抛异常", 假)
    异常:
        检查("解码-非法方案抛异常", 真)
    结束
    捕获:
        工具.编码方案("BASE64", "甲乙")
        检查("编码-合法方案不抛异常", 真)
    异常:
        检查("编码-合法方案不应抛异常", 假)
    结束
    收尾()
结束
