// ============================================================
// 结构体基础定义测试
// 覆盖规范：三种定义格式（采用实现已支持的“字段带类型”写法）、
//          自身引用规则、访问控制、类型标注、访问提升顶层
// 注：规范“格式一/二”示例的“无类型字段/无类型参数”写法在
//     当前实现中不被支持（见 08规范差异验证.智），本文件采用
//     实现已确认可用的“字段/参数均带类型”等价写法。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 格式一：无参数，字段带类型直接赋初始值 ──
// 注：字段名须为中文（ASCII 字段名会被 . 解析器误判为路径分隔符，项目铁律亦要求中文命名）
结构体 坐标():
    小数 横坐标 = 0.0
    小数 纵坐标 = 0.0
结束

结构体 计数器():
    整数 当前值 = 0
    整数 最大值 = 100
    整数 最小值 = 0
    递增():
        如果 自身.当前值 < 自身.最大值:
            自身.当前值 += 1
        结束
    结束
    递减():
        如果 自身.当前值 > 自身.最小值:
            自身.当前值 -= 1
        结束
    结束
    获取值() 整数:
        返回 自身.当前值
    结束
结束

// ── 格式二等价：参数带类型（实现要求），字段带类型 ──
结构体 用户(文本 姓名, 整数 年龄):
    整数 注册时间 = 0
    逻辑 是否激活 = 假
    文本 角色 = "普通用户"
    打招呼():
        输出("你好，我是" + 姓名 + "，今年" + 转文本(年龄) + "岁")
    结束
    获取姓名() 文本:
        返回 姓名
    结束
    获取年龄() 整数:
        返回 年龄
    结束
结束

结构体 矩形(小数 宽, 小数 高):
    文本 颜色 = "黑色"
    逻辑 是否填充 = 假
    获取面积() 小数:
        返回 宽 * 高
    结束
    获取周长() 小数:
        返回 2 * (宽 + 高)
    结束
结束

// ── 格式三：参数有类型定义 ──
结构体 学生(文本 姓名, 整数 年龄, 文本 班级):
    私有 文本 学号 = "000"
    数组<整数> 成绩列表 = []
    打招呼():
        输出("你好，我是" + 姓名)
    结束
    添加成绩(整数 分数):
        如果 分数 >= 0 且 分数 <= 100:
            自身.成绩列表.追加(分数)
        结束
    结束
    获取平均分() 小数:
        本地成绩 = 自身.成绩列表
        如果 本地成绩.长度() == 0:
            返回 0.0
        结束
        总和 = 0
        循环 分数 遍历 本地成绩:
            总和 += 分数
        结束
        返回 总和 / 本地成绩.长度()
    结束
    获取姓名() 文本:
        返回 姓名
    结束
    获取班级() 文本:
        返回 班级
    结束
结束

// ── 访问控制 ──
结构体 账户():
    文本 姓名
    私有 文本 密码
    整数 年龄
    打招呼():
        输出("你好，" + 自身.姓名)
    结束
    私有 验证密码(文本 输入) 逻辑:
        返回 输入 == 自身.密码
    结束
    修改密码(文本 旧密码, 文本 新密码):
        如果 自身.验证密码(旧密码):
            自身.密码 = 新密码
        结束
    结束
    获取密码() 文本:
        返回 自身.密码
    结束
    获取姓名() 文本:
        返回 自身.姓名
    结束
    获取年龄() 整数:
        返回 自身.年龄
    结束
结束

// ── 无状态功能提升到模块顶层（替代“结构体名.静态方法”）──
计算加法(整数 甲, 整数 乙) 整数:
    返回 甲 + 乙
结束

// ── 测试 ──
测试_格式一无参数():
    原点 = 坐标()
    检查("格式一-坐标默认横坐标=0", 原点.横坐标 == 0.0)
    检查("格式一-坐标默认纵坐标=0", 原点.纵坐标 == 0.0)
    默认计数器 = 计数器()
    默认计数器.递增()
    默认计数器.递增()
    默认计数器.递减()
    检查("格式一-计数器递增2递减1=1", 默认计数器.获取值() == 1)
结束

测试_格式二默认参数():
    默认用户 = 用户("未命名", 0)
    检查("格式二-默认姓名未命名", 默认用户.获取姓名() == "未命名")
    检查("格式二-默认年龄0", 默认用户.获取年龄() == 0)
    张三 = 用户("张三", 25)
    检查("格式二-传参姓名张三", 张三.获取姓名() == "张三")
    检查("格式二-传参年龄25", 张三.获取年龄() == 25)
    小矩形 = 矩形(3.0, 4.0)
    检查("格式二-矩形面积12", 小矩形.获取面积() == 12.0)
    检查("格式二-矩形周长14", 小矩形.获取周长() == 14.0)
    默认矩形 = 矩形(1.0, 1.0)
    检查("格式二-默认矩形面积1", 默认矩形.获取面积() == 1.0)
结束

测试_格式三类型参数():
    张三学生 = 学生("张三", 18, "高一(1)班")
    张三学生.添加成绩(95)
    张三学生.添加成绩(88)
    检查("格式三-姓名", 张三学生.获取姓名() == "张三")
    检查("格式三-班级", 张三学生.获取班级() == "高一(1)班")
    检查("格式三-平均分91.5", 张三学生.获取平均分() == 91.5)
    空学生 = 学生("李四", 20, "高二")
    检查("格式三-无成绩平均分0", 空学生.获取平均分() == 0.0)
结束

测试_自身引用规则():
    计数 = 计数器()
    计数.递增()
    计数.递增()
    检查("自身引用-递增后=2", 计数.获取值() == 2)
    计数.递减()
    检查("自身引用-递减后=1", 计数.获取值() == 1)
结束

测试_访问控制():
    账户1 = 账户()
    账户1.姓名 = "小明"
    检查("访问控制-公开字段赋值", 账户1.获取姓名() == "小明")
    检查("访问控制-私有字段默认空", 账户1.获取密码() == "")
    账户1.修改密码("", "新密")
    检查("访问控制-私有字段经方法修改后可读取", 账户1.获取密码() == "新密")
    检查("访问控制-公开年龄默认0", 账户1.获取年龄() == 0)
    账户1.年龄 = 30
    检查("访问控制-公开年龄修改", 账户1.获取年龄() == 30)
结束

测试_类型标注与顶层函数():
    学生 标注学生 = 学生("李四", 20, "高二")
    检查("类型标注-创建实例", 标注学生.获取姓名() == "李四")
    检查("顶层函数-计算加法3+4=7", 计算加法(3, 4) == 7)
结束

// ── 主入口 ──
启动程序():
    输出("========== 结构体基础定义测试 ==========")
    测试_格式一无参数()
    测试_格式二默认参数()
    测试_格式三类型参数()
    测试_自身引用规则()
    测试_访问控制()
    测试_类型标注与顶层函数()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
