// 272 跨函数返回堆对象（缺陷B 回归护栏）
// 背景：函数返回「从形参容器中取出的堆对象」曾丢失引用 ⇒ 调用方拿到**无效句柄**。
//   根因（2026-10-12 定位）：`返回 <投影>` / `返回 <非标量裸变量>` 为调用方计数(+1)时，
//   附带了两道前提错误的闸门 —— `可释放()` 与「本函数拥有型槽清单非空」；
//   而返回值可能源自**形参容器/形参副本**（该函数清单为空时照样被释放）⇒ 漏发 +1 ⇒ 悬垂。
//   修法：返回值必然移交调用方 ⇒ 一律为调用方计数（标量除外，纯值不携句柄，且加计数本就是 no-op）。
// 覆盖：映射取值 / 结构体字段里的映射 / 数组索引 / 裸变量中转 / 传引用对照 / 返回容器本身 / 各类型值。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

结构体 盒():
    内 = {}
结束

取值(映射 地, 文本 键) 文本:
    返回 地.获取(键)
结束

取任意(映射 地, 文本 键) 任意:
    返回 地.获取(键)
结束

取中转(映射 地, 文本 键) 文本:
    局部 = 地.获取(键)
    返回 局部
结束

取字段(盒 甲, 文本 键) 文本:
    返回 甲.内.获取(键)
结束

取数组元素(数组<文本> 列) 文本:
    返回 列[2]
结束

取引用(传引用 映射 地, 文本 键) 文本:
    返回 地.获取(键)
结束

取映射(映射 地) 映射:
    返回 地
结束

启动程序():
    输出("=== 272 跨函数返回堆对象（缺陷B 护栏）===")

    地 = {"甲": "文本值"}
    检查("投影返回：映射取文本", 取值(地, "甲") == "文本值")
    检查("投影返回：任意返回类型", 取任意(地, "甲") == "文本值")
    检查("裸变量中转后返回", 取中转(地, "甲") == "文本值")
    检查("投影返回后再跨函数比较", 取值(地, "甲") == 取中转(地, "甲"))

    甲 = 盒()
    甲.内.插入("键", "字段文本")
    检查("结构体字段里的映射取值", 取字段(甲, "键") == "字段文本")

    检查("数组索引返回", 取数组元素(["一", "二", "三"]) == "二")
    检查("传引用形参返回（对照）", 取引用(地, "甲") == "文本值")

    回 = 取映射(地)
    检查("返回映射本身后仍可取值", 回.获取("甲") == "文本值")

    地2 = {"列": [1, 2, 3], "盒": 盒(), "嵌": {"内": "深层"}}
    检查("返回数组值", 取任意(地2, "列") == [1, 2, 3])
    检查("返回结构体值（类型可辨）", 类型(取任意(地2, "盒")) == "盒")
    检查("返回嵌套映射值再取值", 取任意(地2, "嵌").获取("内") == "深层")

    标签 = {"一": "甲", "二": "乙", "三": "丙"}
    名称表 = ["一", "二", "三"]
    全过 = 真
    循环 序 遍历 [1, 2, 3, 1, 2, 3]:
        如果 取值(标签, 名称表[序]).长度() != 1:
            全过 = 假
        结束
    结束
    检查("连续多次跨函数取回均有效", 全过)

    收尾()
结束
