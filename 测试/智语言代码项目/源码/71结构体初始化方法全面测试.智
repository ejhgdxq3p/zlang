// ============================================================
// 结构体 初始化方法 全面测试（用户重点关注项）
// 覆盖：无参初始化、带参数初始化、初始化使用结构体参数(全局参数)、
//      初始化设置字段默认值、初始化调用其他方法、无初始化(字段默认/参数绑定)、
//      多结构体各自独立初始化、嵌套结构体初始化自动调用、字段默认值后被初始化覆盖、
//      初始化不写返回类型、初始化不能为字段另设重载。
// 语法严格符合编程规范文档 §2.1.5 / §2.4 初始化章节
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 情况1：无参初始化，设置字段默认值 ──
结构体 计数器():
    整数 值 = -1
    整数 计数 = 0
    初始化():
        自身.值 = 0
        自身.计数 = 0
    结束
    增加() 整数:
        自身.计数 += 1
        自身.值 += 1
        返回 自身.值
    结束
    取值() 整数:
        返回 自身.值
    结束
    取计数() 整数:
        返回 自身.计数
    结束
结束

// ── 情况2：带结构体参数 + 初始化 使用参数（全局参数直接引用）──
结构体 矩形(整数 宽, 整数 高):
    整数 面积 = 0
    初始化():
        自身.面积 = 宽 * 高
    结束
    取面积() 整数:
        返回 自身.面积
    结束
    取宽() 整数:
        返回 宽
    结束
    取高() 整数:
        返回 高
    结束
结束

// ── 情况3：初始化里调用自身其他方法/访问其他字段 ──
结构体 学生(文本 姓名):
    文本 全名 = ""
    整数 学号 = 0
    初始化():
        自身.全名 = "学生:" + 姓名
        自身.学号 = 自身.生成学号()
    结束
    生成学号() 整数:
        返回 自身.全名.长度() * 100
    结束
    取全名() 文本:
        返回 自身.全名
    结束
    取学号() 整数:
        返回 自身.学号
    结束
结束

// ── 情况4：无初始化方法，字段直接默认值 + 参数绑定 ──
结构体 配置项(文本 键名):
    文本 名称 = "默认"
    逻辑 启用 = 真
    取名称() 文本:
        返回 自身.名称
    结束
    取键() 文本:
        返回 键名
    结束
    是否启用() 逻辑:
        返回 自身.启用
    结束
结束

// ── 情况5：字段有默认值，初始化覆盖之 ──
结构体 盒子(整数 容量):
    整数 剩余 = 999
    初始化():
        自身.剩余 = 容量
    结束
    取剩余() 整数:
        返回 自身.剩余
    结束
取容量() 整数:
    返回 容量
结束
结束

// ── 情况6：嵌套结构体，内层初始化创建实例时自动调用 ──
结构体 发动机():
    整数 马力 = 0
    初始化():
        自身.马力 = 150
    结束
    取马力() 整数:
        返回 自身.马力
    结束
结束

结构体 汽车(文本 品牌):
    文本 车牌 = ""
    // ⚠ 订正（2026-09-20，按规范 §2.4.3 字段规则）：
    //   规范「字段类型支持总表」第 1588 行：**结构体类型的字段「必须初始化」**（无自然零值）。
    //   规范「结构体字段支持」示例第 1565 行给出标准写法：`内部结构 子对象 = 内部结构()`。
    //   原写 `发动机 引擎`（只有类型标注、无初始值）**违反规范** ——
    //   此前靠语义层「对 Err 静默补空值」的兜底通过，该字段运行期实为**空值**（并非发动机实例），
    //   属于「解释与编译同错」的隐性缺陷（双模门禁查不出）。
    //   P1 已把该兜底改为 fail-fast ⇒ 用例按规范补上初始化表达式（语义不变：
    //   初始化() 内仍会再赋一个新发动机，最终 马力=150，断言不变）。
    发动机 引擎 = 发动机()
    初始化():
        自身.车牌 = "京A-" + 品牌
        自身.引擎 = 发动机()
    结束
    取车牌() 文本:
        返回 自身.车牌
    结束
    取引擎马力() 整数:
        返回 自身.引擎.取马力()
    结束
结束

// ── 情况7：多结构体各自独立初始化（互不干扰）──
结构体 工具甲():
    整数 标记 = 0
    初始化():
        自身.标记 = 1
    结束
    取标记() 整数:
        返回 自身.标记
    结束
结束

结构体 工具乙():
    整数 标记 = 0
    初始化():
        自身.标记 = 2
    结束
    取标记() 整数:
        返回 自身.标记
    结束
结束

// ── 测试 ──
测试_无参初始化():
    甲 = 计数器()
    检查("无参初始化 值被设为0", 甲.取值() == 0)
    检查("无参初始化 计数被设为0", 甲.取计数() == 0)
    甲.增加()
    检查("无参初始化后方法可用 值=1", 甲.取值() == 1)
    检查("无参初始化后方法可用 计数=1", 甲.取计数() == 1)
结束

测试_带参初始化():
    矩 = 矩形(4, 5)
    检查("带参初始化 面积=20", 矩.取面积() == 20)
    检查("带参初始化 宽=4", 矩.取宽() == 4)
    检查("带参初始化 高=5", 矩.取高() == 5)
    矩2 = 矩形(0, 10)
    检查("带参初始化 零宽面积=0", 矩2.取面积() == 0)
结束

测试_初始化调方法():
    生 = 学生("小明")
    检查("初始化调方法 全名=学生:小明", 生.取全名() == "学生:小明")
    检查("初始化调方法 学号=学号长度*100", 生.取学号() == ("学生:小明".长度() * 100))
结束

测试_无初始化():
    项 = 配置项("超时")
    检查("无初始化 字段默认值 名称=默认", 项.取名称() == "默认")
    检查("无初始化 字段默认值 启用=真", 项.是否启用() == 真)
    检查("无初始化 参数绑定 键=超时", 项.取键() == "超时")
结束

测试_初始化覆盖默认值():
    盒 = 盒子(50)
    检查("字段默认999被初始化覆盖 剩余=50", 盒.取剩余() == 50)
    检查("初始化覆盖 容量=50", 盒.取容量() == 50)
结束

测试_嵌套初始化():
    车 = 汽车("红旗")
    检查("嵌套初始化 车牌=京A-红旗", 车.取车牌() == "京A-红旗")
    检查("嵌套初始化 内层引擎自动初始化 马力=150", 车.取引擎马力() == 150)
结束

测试_多结构体独立():
    一 = 工具甲()
    二 = 工具乙()
    检查("多结构体 甲标记=1", 一.取标记() == 1)
    检查("多结构体 乙标记=2", 二.取标记() == 2)
    检查("多结构体 互不影响", 一.取标记() != 二.取标记())
结束

// ── 主入口 ──
启动程序():
    输出("========== 结构体 初始化方法 全面测试 ==========")
    测试_无参初始化()
    测试_带参初始化()
    测试_初始化调方法()
    测试_无初始化()
    测试_初始化覆盖默认值()
    测试_嵌套初始化()
    测试_多结构体独立()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
