// 55 诊断：取末尾 在 追加 之后的行为（隔离 COW/惰性复制 bug）
启动程序():
    数学分 = [88, 92, 76, 95, 81]
    输出("初始 长度=" + 转文本(数学分.长度()))
    数学分.追加(100)
    输出("追加100后 长度=" + 转文本(数学分.长度()))
    输出("追加100后 [6]=" + 转文本(数学分[6]))
    末位 = 数学分.取末尾()
    输出("取末尾 返回值=" + 转文本(末位))
    输出("取末尾后 长度=" + 转文本(数学分.长度()))
    输出("取末尾后 类型=" + 类型(数学分))
    输出("取末尾后 [1]=" + 转文本(数学分[1]))
    输出("取末尾后 [5]=" + 转文本(数学分[5]))
    输出("是否包含(95)=" + 转文本(数学分.是否包含(95)))
    输出("查找索引(95)=" + 转文本(数学分.查找索引(95)))
    总和 = 0
    循环 分 遍历 数学分:
        总和 = 总和 + 分
    结束
    输出("遍历求和=" + 转文本(总和))
    数学分.排序()
    输出("排序后 [1]=" + 转文本(数学分[1]))
    输出("排序后 末位=" + 转文本(数学分[数学分.长度()]))
    输出("排序后 首<=尾=" + 转文本(数学分[1] <= 数学分[数学分.长度()]))
结束
