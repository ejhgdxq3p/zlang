// 时间 16 函数 × 闰年 / 跨月 / 跨年 / 负时间戳 / 大时间戳
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 192 时间 闰年与跨度极限 ===")
    // ① 闰年：2024-02-29 存在，2023/2100 非闰（2100 是百年非闰）
    闰 = 时间.解析("2024-02-29", "年-月-日")
    检查("闰年-2024-02-29 解析成功", 闰 > 0)
    检查("闰年-格式往返", 时间.格式化("年-月-日", 闰) == "2024-02-29")
    检查("闰年-月分量", 时间.获取月(闰) == 2)
    检查("闰年-日分量", 时间.获取日(闰) == 29)
    检查("闰年-加一年到 2025-02-28", 时间.格式化("年-月-日", 时间.加(闰, 86400 * 365)) == "2025-02-28")
    // 2026-10-19：不存在的日历日改为**严格校验并抛异常**（原为静默规整到 3 月 1 日 ✗ 静默改数据）
    捕获:
        时间.解析("2023-02-29", "年-月-日")
        检查("非闰-2023-02-29 应抛异常", 假)
    异常:
        检查("非闰-2023-02-29 抛异常", 真)
    结束
    捕获:
        时间.解析("2100-02-29", "年-月-日")
        检查("百年非闰-2100-02-29 应抛异常", 假)
    异常:
        检查("百年非闰-2100-02-29 抛异常", 真)
    结束
    // ② 跨月 / 跨年
    月尾 = 时间.解析("2024-01-31", "年-月-日")
    检查("跨月-1月31日+1天=2月1日", 时间.格式化("年-月-日", 时间.加(月尾, 86400)) == "2024-02-01")
    年末 = 时间.解析("2023-12-31 23:59:59", "年-月-日 时:分:秒")
    检查("跨年-年末+1秒", 时间.格式化("年-月-日 时:分:秒", 时间.加(年末, 1)) == "2024-01-01 00:00:00")
    检查("跨年-年末-1秒", 时间.格式化("年-月-日 时:分:秒", 时间.减(年末, 1)) == "2023-12-31 23:59:58")
    年初 = 时间.解析("2024-01-01", "年-月-日")
    检查("跨年-年初-1天=上一年末", 时间.格式化("年-月-日", 时间.减(年初, 86400)) == "2023-12-31")
    // ③ 分量边界值
    检查("小时-午夜为0", 时间.获取时(时间.解析("2024-06-15 00:00:00", "年-月-日 时:分:秒")) == 0)
    检查("小时-正午为12", 时间.获取时(时间.解析("2024-06-15 12:00:00", "年-月-日 时:分:秒")) == 12)
    检查("小时-末刻为23", 时间.获取时(时间.解析("2024-06-15 23:59:59", "年-月-日 时:分:秒")) == 23)
    检查("分秒-59", 时间.获取分(时间.解析("2024-06-15 23:59:59", "年-月-日 时:分:秒")) == 59)
    检查("月-12月", 时间.获取月(时间.解析("2024-12-01", "年-月-日")) == 12)
    检查("日-12月31日", 时间.获取日(时间.解析("2024-12-31", "年-月-日")) == 31)
    // ④ 负时间戳（1970 之前）
    负 = 时间.解析("1969-12-31", "年-月-日")
    检查("负时间戳-解析为负", 负 < 0)
    检查("负时间戳-往返", 时间.格式化("年-月-日", 负) == "1969-12-31")
    检查("负时间戳-分量", 时间.获取年(负) == 1969 且 时间.获取月(负) == 12 且 时间.获取日(负) == 31)
    检查("负时间戳-星期(周三)", 时间.获取星期(负) == 3)
    检查("负时间戳-加一天到 1970-01-01", 时间.格式化("年-月-日", 时间.加(负, 86400)) == "1970-01-01")
    // ⑤ 大时间戳（2100 年以后）
    远 = 时间.解析("2100-01-01", "年-月-日")
    检查("大时间戳-往返", 时间.格式化("年-月-日", 远) == "2100-01-01")
    检查("大时间戳-年份", 时间.获取年(远) == 2100)
    检查("间隔天数-百年跨度>36500", 时间.间隔天数(远, 时间.解析("2000-01-01", "年-月-日")) > 36500)
    // ⑥ 格式化分隔符多样性（同一时间不同写法）
    基 = 时间.解析("2024-03-05 06:07:08", "年-月-日 时:分:秒")
    检查("格式-斜杠风格往返", 时间.格式化("年/月/日", 基) == "2024/03/05")
    检查("格式-点风格往返", 时间.格式化("年.月.日", 基) == "2024.03.05")
    检查("格式-紧凑时分", 时间.格式化("时:分", 基) == "06:07")
    检查("格式-仅月日", 时间.格式化("月-日", 基) == "03-05")
    // ⑦ 间隔天数 的符号与零
    检查("间隔-自反为0", 时间.间隔天数(基, 基) == 0)
    检查("间隔-大减小为正7", 时间.间隔天数(时间.加(基, 86400 * 7), 基) == 7)
    检查("间隔-小减大为负7", 时间.间隔天数(基, 时间.加(基, 86400 * 7)) == -7)
    检查("间隔-不足一天为0", 时间.间隔天数(时间.加(基, 3600), 基) == 0)
    收尾()
结束
