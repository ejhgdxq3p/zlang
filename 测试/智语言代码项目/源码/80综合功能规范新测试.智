启动程序():
    输出("========== 一、值传递 / 引用传递（重点） ==========")

    输出("--- 1.1 基础类型 ---")
    甲 = 10
    改值(甲)
    检查("整数传值：原地不变=10", 甲 == 10)
    乙 = 20
    改引用(乙)
    检查("整数传引用：原地被改=120", 乙 == 120)

    输出("--- 1.2 数组 ---")
    列 = [1, 2, 3]
    改数组值(列)
    检查("数组传值：长度不变=3", 列.长度() == 3)
    列2 = [1, 2, 3]
    改数组引用(列2)
    检查("数组传引用：长度被改=4", 列2.长度() == 4)
    检查("数组传引用：末位=999", 列2[4] == 999)

    输出("--- 1.3 结构体 ---")
    计 = 计数器(5)
    改结构体值(计)
    检查("结构体传值：值不变=5", 计.取数() == 5)
    计2 = 计数器(5)
    改结构体引用(计2)
    检查("结构体传引用：值被改=55", 计2.取数() == 55)

    输出("--- 1.4 变量赋值值复制（深度独立） ---")
    源盒 = 计数器(1)
    源盒.增加(2)
    副盒 = 源盒
    副盒.增加(3)
    检查("结构体值复制：源独立=3", 源盒.取数() == 3)
    检查("结构体值复制：副独立=6", 副盒.取数() == 6)

    输出("========== 二、方法返回类型推断 + 返回值类型传播 ==========")
    向 = 造向量(3.0, 4.0)
    检查("函数返回推断：长度=5", 转整数(向.长度()) == 5)
    检查("方法返回值传播：缩放2倍长度=10", 转整数(向.缩放(2.0).长度()) == 10)
    合 = 向.加(造向量(1.0, 1.0))
    检查("方法返回值传播：加后横=4", 合.横 == 4.0)
    检查("方法返回值传播：加后纵=5", 合.纵 == 5.0)

    输出("========== 三、任意类型 ==========")
    检查("有名任意-整数守恒", 取较大值(10, 20) == 20)
    检查("有名任意-小数守恒", 取较大值(转小数(1.5), 转小数(2.5)) == 转小数(2.5))
    // 匿名任意：类型集合语义，直接赋值/比较（须显式初始化）
    任意<整数|文本> 数据 = 100
    检查("匿名任意变量：整数可用", 数据 == 100)
    数据 = "文本值"
    检查("匿名任意变量：可改文本", 数据 == "文本值")
    任意<整数|小数|文本> 混合 = 3.14
    检查("匿名任意：约束含小数赋小数", 混合 == 3.14)
    混合 = "文本也行"
    检查("匿名任意：改赋文本", 混合 == "文本也行")

    输出("========== 四、枚举 ==========")
    红 = 颜色.红色
    检查("枚举简单成员", 描述颜色(红) == "红")
    绿 = 颜色.绿色
    检查("枚举简单成员-绿", 描述颜色(绿) == "绿")
    成 = 结果.成功(200)
    检查("数据枚举-成功载荷", 成 == 结果.成功(200))
    败 = 结果.失败("错误")
    检查("数据枚举-失败载荷", 败 == 结果.失败("错误"))

    输出("========== 五、接口适配 / 类型系统 ==========")
    矩 = 矩形(3.0, 4.0)
    检查("接口适配：矩形面积=12", 转整数(算面积(矩)) == 12)
    可面积 形状 = 矩
    检查("接口类型变量：面积传播=12", 转整数(形状.面积()) == 12)

    输出("========== 六、逻辑运算符（且/或/非/属于/不属于） ==========")
    检查("逻辑且", 真 且 真)
    检查("逻辑或", 真 或 假)
    检查("逻辑非", 非 假)
    检查("属于-数组", 红 属于 [颜色.红色, 颜色.绿色])
    检查("不属于-数组", 红 不属于 [颜色.蓝色])
    检查("逻辑组合", (甲 > 0 且 乙 > 0) 或 假)

    输出("========== 七、模块导入（基本导入） ==========")
