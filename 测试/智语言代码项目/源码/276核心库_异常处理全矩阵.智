// §4.5 异常处理与 异常错误 结构体完整矩阵
// 依据：规范 §4.5（捕获/异常/始终）、§4.6（异常错误 结构体：类型/描述/位置/堆栈/格式信息）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

始终计数 = 0

内层抛出自定义():
    抛出 异常错误("内层自定义异常")
结束

内层抛出转换错误():
    返回 转整数("abc")
结束

裸抛转发():
    捕获:
        抛出 异常错误("裸抛源")
    异常:
        抛出
    结束
结束

提前返回并始终():
    捕获:
        返回
    始终:
        本模块.始终计数 = 本模块.始终计数 + 1
    结束
结束

启动程序():
    输出("=== 07 异常处理完整矩阵 ===")

    // ───────── 捕获接住运行时异常 ─────────
    已捕获 = 假
    捕获:
        转整数("abc")
    异常:
        已捕获 = 真
    结束
    检查("捕获-接住运行时异常", 已捕获 == 真)

    // ───────── 异常错误 字段 ─────────
    捕获:
        转整数("abc")
    异常:
        错误 = 异常错误()
        检查("异常错误-类型为非空文本", 类型(错误.类型) == "文本" 且 错误.类型.长度() > 0)
        检查("异常错误-类型为类型转换错误", 错误.类型 == "类型转换错误")
        检查("异常错误-描述非空", 错误.描述.长度() > 0)
        检查("异常错误-描述含出错输入", 错误.描述.是否包含("abc"))
        // ⚠ 双模差异（已登记）：运行时异常的位置/堆栈两模内容不同 ——
        //   解释模式：位置 = "指令偏移 19"，堆栈 = ""
        //   编译模式：位置 = ""，堆栈 = "#0 启动程序 ()"
        //   ⇒ 此处只断言"为文本"，具体内容用 ℹ 记录（规范 §4.6 要求位置/堆栈可追溯，
        //     当前两侧都只是占位级信息，属**待统一项**）。
        检查("异常错误-位置为文本", 类型(错误.位置) == "文本")
        记录("异常错误-位置当前内容", 错误.位置)
        检查("异常错误-堆栈为文本", 类型(错误.堆栈) == "文本")
        记录("异常错误-堆栈当前内容", 错误.堆栈)
        格式文本 = 错误.格式信息()
        检查("异常错误-格式信息非空", 格式文本.长度() > 0)
        检查("异常错误-格式信息含类型", 格式文本.是否包含(错误.类型))
        检查("异常错误-格式信息含描述", 格式文本.是否包含(错误.描述))
    结束

    // ───────── 自定义抛出（异常错误 构造）─────────
    捕获:
        抛出 异常错误("自定义错误信息")
    异常:
        检查("自定义抛出-类型为异常错误", 异常错误().类型 == "异常错误")
        检查("自定义抛出-描述精确", 异常错误().描述 == "自定义错误信息")
        检查("自定义抛出-位置为源码位置", 异常错误().位置.是否包含(".智:"))
    结束

    // ───────── 跨函数传播 ─────────
    捕获:
        内层抛出自定义()
    异常:
        检查("跨函数-自定义异常传播到调用方", 异常错误().描述 == "内层自定义异常")
    结束
    捕获:
        内层抛出转换错误()
    异常:
        检查("跨函数-运行时异常传播到调用方", 异常错误().类型 == "类型转换错误")
    结束

    // ───────── 裸抛出（重新抛出）─────────
    捕获:
        裸抛转发()
    异常:
        检查("裸抛出-保留原异常描述", 异常错误().描述 == "裸抛源")
    结束

    // ───────── 嵌套 捕获（内层处理后不冒泡）─────────
    外层已进入 = 假
    内层已处理 = 假
    捕获:
        捕获:
            抛出 异常错误("内层")
        异常:
            内层已处理 = 真
        结束
    异常:
        外层已进入 = 真
    结束
    检查("嵌套-内层已处理", 内层已处理 == 真)
    检查("嵌套-内层处理外层不触发", 外层已进入 == 假)

    // ───────── 异常块内再次抛出 → 外层接住 ─────────
    外层描述 = ""
    捕获:
        捕获:
            抛出 异常错误("第一层")
        异常:
            抛出 异常错误("第二层")
        结束
    异常:
        外层描述 = 异常错误().描述
    结束
    检查("重抛-外层接到第二层异常", 外层描述 == "第二层")

    // ───────── 始终块执行时机 ─────────
    顺序甲 = ""
    捕获:
        顺序甲 = 顺序甲 + "危险"
        抛出 异常错误("x")
    异常:
        顺序甲 = 顺序甲 + "异常"
    始终:
        顺序甲 = 顺序甲 + "始终"
    结束
    检查("始终-异常路径顺序：危险→异常→始终", 顺序甲 == "危险异常始终")
    顺序乙 = ""
    捕获:
        顺序乙 = 顺序乙 + "危险"
    异常:
        顺序乙 = 顺序乙 + "异常"
    始终:
        顺序乙 = 顺序乙 + "始终"
    结束
    检查("始终-正常路径顺序：危险→始终（不进异常块）", 顺序乙 == "危险始终")
    本模块.始终计数 = 0
    提前返回并始终()
    检查("始终-提前返回仍执行", 本模块.始终计数 == 1)

    // ───────── 异常后程序继续执行 ─────────
    继续标记 = ""
    捕获:
        抛出 异常错误("中断")
    异常:
        继续标记 = 继续标记 + "A"
    结束
    继续标记 = 继续标记 + "B"
    检查("异常处理后可继续执行", 继续标记 == "AB")

    // ───────── 容器/映射异常 ─────────
    捕获:
        越界 = [1, 2, 3][5]
    异常:
        检查("数组越界-类型非空", 异常错误().类型.长度() > 0)
        检查("数组越界-描述含越界信息", 异常错误().描述.长度() > 0)
    结束
    捕获:
        缺失 = {"甲": 1}["乙"]
    异常:
        检查("映射缺键-类型非空", 异常错误().类型.长度() > 0)
        检查("映射缺键-描述含键信息", 异常错误().描述.长度() > 0)
    结束

    // ───────── 异常对象可用于比较/传递 ─────────
    捕获:
        抛出 异常错误("携带信息")
    异常:
        当前 = 异常错误()
        检查("异常对象-描述可比较", 当前.描述 == "携带信息")
        检查("异常对象-类型可比较", 当前.类型 == "异常错误")
    结束

    收尾()
结束
