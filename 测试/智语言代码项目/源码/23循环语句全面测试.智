// ============================================================
// 循环语句全面测试（对照《智语言编程规范》2.5.2 循环 / 2.5.3 跳转）
// 覆盖：基础循环 / 区间循环 / 数组遍历(元素、索引+元素) / 映射遍历(键值、键、值)
//       / 无限循环+跳出 / 跳出+继续+组合 / 遍历中修改 / 返回
// 全部双模验证。索引从 1 开始。
// ============================================================

通过数 = 0
失败数 = 0
总用例数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总用例数 = 本模块.总用例数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// 查找目标，返回 1-based 索引（未找到返回 0）
查找目标(数组<整数> 列表, 整数 目标) 整数:
    循环 索引, 元素 遍历 列表:
        如果 元素 == 目标:
            返回 索引
        结束
    结束
    返回 0
结束

启动程序():
    输出("===== A. 基础循环(前测条件) =====")
    总和 = 0
    当前 = 1
    循环 当前 <= 100:
        总和 = 总和 + 当前
        当前 = 当前 + 1
    结束
    检查("基础循环 1..100 累加=5050", 总和 == 5050)

    计数器甲 = 0
    计数 = 0
    循环 计数器甲 < 5:
        计数 = 计数 + 1
        计数器甲 = 计数器甲 + 1
    结束
    检查("基础循环 i<5 执行5次", 计数 == 5)

    计数器乙 = 5
    倒序 = 0
    循环 计数器乙 > 0:
        倒序 = 倒序 + 1
        计数器乙 = 计数器乙 - 1
    结束
    检查("基础递减循环 5->1 执行5次", 倒序 == 5)

    输出("===== B. 区间循环 =====")
    区间和 = 0
    循环 区间变量 = 1, 区间变量 <= 10, 区间变量 += 1:
        区间和 = 区间和 + 区间变量
    结束
    检查("区间循环 1..10 累加=55", 区间和 == 55)

    偶数和 = 0
    循环 偶数变量 = 2, 偶数变量 <= 20, 偶数变量 += 2:
        偶数和 = 偶数和 + 偶数变量
    结束
    检查("区间内偶数 2..20 和=110", 偶数和 == 110)

    反向 = 0
    循环 反向变量 = 10, 反向变量 >= 1, 反向变量 -= 1:
        反向 = 反向 + 1
    结束
    检查("反向区间 10..1 执行10次", 反向 == 10)

    步长3计数 = 0
    循环 步 = 1, 步 <= 30, 步 += 3:
        步长3计数 = 步长3计数 + 1
    结束
    检查("步长为3 1..30 共10个", 步长3计数 == 10)

    输出("===== C. 数组遍历 =====")
    水果 = ["苹果", "香蕉", "橙子", "葡萄"]
    拼接 = ""
    循环 果 遍历 水果:
        拼接 = 拼接 + 果
    结束
    检查("数组遍历元素全部", 拼接 == "苹果香蕉橙子葡萄")

    索引拼接 = ""
    循环 序号, 元素 遍历 水果:
        索引拼接 = 索引拼接 + 转文本(序号) + 元素
    结束
    检查("索引从1开始(第1=苹果)", 索引拼接 == "1苹果2香蕉3橙子4葡萄")

    输出("===== D. 映射遍历 =====")
    学生 = {"姓名": "小明", "年龄": 18, "成绩": 92}
    键值拼接 = ""
    循环 键, 值 遍历 学生:
        键值拼接 = 键值拼接 + 键 + 转文本(值)
    结束
    检查("映射遍历键值对(3项)", 学生.长度() == 3)
    检查("映射遍历含姓名小明", 键值拼接.是否包含("姓名小明"))

    仅键 = ""
    循环 键 遍历 学生.所有键():
        仅键 = 仅键 + 键
    结束
    检查("映射遍历键(姓名年龄成绩)", 仅键 == "姓名年龄成绩")

    // 映射.所有值() 返回的是 值 本身，连接前需转文本
    值串 = ""
    循环 值 遍历 学生.所有值():
        值串 = 值串 + 转文本(值)
    结束
    检查("映射遍历值(含18与92)", 值串.是否包含("18") 且 值串.是否包含("92"))

    输出("===== E. 遍历空容器直接跳过 =====")
    空数组 = []
    空计数 = 0
    循环 元素 遍历 空数组:
        空计数 = 空计数 + 1
    结束
    检查("空数组遍历不执行", 空计数 == 0)

    空映射 = {}
    空计数2 = 0
    循环 键, 值 遍历 空映射:
        空计数2 = 空计数2 + 1
    结束
    检查("空映射遍历不执行", 空计数2 == 0)

    输出("===== F. 无限循环 + 跳出 =====")
    计数2 = 0
    安全计数 = 0
    循环 真:
        安全计数 = 安全计数 + 1
        如果 安全计数 >= 100:
            跳出
        结束
        计数2 = 计数2 + 1
        如果 计数2 == 5:
            跳出
        结束
    结束
    检查("无限循环第5次跳出", 计数2 == 5)

    输出("===== G. 跳出 / 继续 =====")
    跳出计数 = 0
    循环 序号 = 1, 序号 < 10, 序号 += 1:
        如果 序号 == 5:
            跳出
        结束
        跳出计数 = 跳出计数 + 1
    结束
    检查("跳出(遇到5终止, 1..4共4次)", 跳出计数 == 4)

    奇数计数 = 0
    循环 序号 = 1, 序号 < 10, 序号 += 1:
        如果 序号 % 2 == 0:
            继续
        结束
        奇数计数 = 奇数计数 + 1
    结束
    检查("继续(跳过偶数, 奇数1,3,5,7,9共5次)", 奇数计数 == 5)

    组合计数 = 0
    循环 序号 = 1, 序号 < 20, 序号 += 1:
        如果 序号 < 5:
            继续
        结束
        如果 序号 == 7:
            跳出
        结束
        组合计数 = 组合计数 + 1
    结束
    检查("继续+跳出组合(5,6共2次)", 组合计数 == 2)

    输出("===== H. 遍历中修改 =====")
    分数数组 = [85, 58, 92, 66, 45, 78, 95]
    优秀数组 = []
    不及格数组 = []
    循环 分数 遍历 分数数组:
        如果 分数 >= 90:
            优秀数组.追加(分数)
        否则如果 分数 < 60:
            不及格数组.追加(分数)
        结束
    结束
    检查("遍历筛选 优秀数组长度=2", 优秀数组.长度() == 2)
    检查("遍历筛选 不及格数组长度=2", 不及格数组.长度() == 2)

    商品库存 = {"苹果": 100, "香蕉": 80, "橙子": 50}
    循环 键, 值 遍历 商品库存:
        如果 值 < 60:
            商品库存.插入(键, 值 + 50)
        结束
    结束
    输出("诊断: 商品库存长度=" + 转文本(商品库存.长度()) + " 橙子=" + 转文本(商品库存.获取("橙子")) + " 苹果=" + 转文本(商品库存.获取("苹果")) + " 香蕉=" + 转文本(商品库存.获取("香蕉")))
    检查("遍历映射修改: 橙子补足(50+50=100)", 商品库存.获取("橙子") == 100)
    检查("遍历映射修改: 苹果未变(100)", 商品库存.获取("苹果") == 100)
    检查("遍历映射修改: 香蕉未变(80)", 商品库存.获取("香蕉") == 80)

    输出("===== I. 循环中使用返回(1-based索引) =====")
    数组 = [10, 20, 30, 40, 50]
    位置 = 查找目标(数组, 30)
    检查("查找目标 返回1-based索引(30在位置3)", 位置 == 3)
    位置2 = 查找目标(数组, 99)
    检查("查找目标 未找到返回0", 位置2 == 0)

    输出("")
    输出("===== 循环语句测试汇总 =====")
    输出("总用例数=" + 转文本(本模块.总用例数) + " 通过数=" + 转文本(本模块.通过数) + " 失败数=" + 转文本(本模块.失败数))
    如果 本模块.失败数 == 0:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
