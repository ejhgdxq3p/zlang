// 273 映射读取的值语义（缺陷C1 回归护栏）
// 背景：从容器读出的**文本**此前是"借用"（不计数）⇒ 源被销毁（清空/删除/整体覆盖）后悬垂
//   （实测 `甲.内.获取(键)` 后 `甲.内.清空()` ⇒ 读出值变**无效句柄**，双模一致）。
// 修法：文本按方案定义「值语义的**不可变**堆对象，表示上允许共享（+1）、语义上不可区分」⇒
//   读取映射值（四条路径：`.获取` / `[键]` 索引 / `堆_映射加载` / `映射.取值`）若为文本即为读取方 +1。
// 覆盖：字段里的映射（多级投影 ⇒ 临时副本场景）/ 局部映射 / 删除 / 索引器 / 文本标注槽 /
//       数组元素（对照）/ 跨函数返回（缺陷B 护栏）。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

结构体 盒():
    内 = {}
    列 = []
结束

取值(映射 地, 文本 键) 文本:
    返回 地.获取(键)
结束

启动程序():
    输出("=== 273 映射读取的值语义（缺陷C1 护栏）===")

    // ── 缺陷原形：字段里的映射（接收者是多级投影 ⇒ 临时副本会消亡）──
    甲 = 盒()
    甲.内.插入("键", "字段文本")
    读出 = 甲.内.获取("键")
    甲.内.清空()
    检查("字段映射取值后清空源 ⇒ 读出值仍有效", 读出 == "字段文本")
    检查("源确已清空（对照）", 甲.内.长度() == 0)

    乙 = 盒()
    乙.内.插入("键", "删除用例")
    读出2 = 乙.内.获取("键")
    乙.内.删除("键")
    检查("字段映射取值后删除源 ⇒ 读出值仍有效", 读出2 == "删除用例")

    丙 = 盒()
    丙.内.插入("键", "索引用例")
    读出3 = 丙.内["键"]
    丙.内.清空()
    检查("索引器读字段映射后清空源 ⇒ 读出值仍有效", 读出3 == "索引用例")

    丁 = 盒()
    丁.内.插入("键", "标注槽用例")
    文本 读出4 = 丁.内.获取("键")
    丁.内.清空()
    检查("文本标注槽读后清空源 ⇒ 读出值仍有效", 读出4 == "标注槽用例")

    // ── 原有正确形状（对照，不得回归）──
    地 = {"键": "局部文本"}
    读出5 = 地.获取("键")
    地.清空()
    检查("局部映射取值后清空源（对照）", 读出5 == "局部文本")

    戊 = 盒()
    戊.列.追加("元素文本")
    读出6 = 戊.列[1]
    戊.列.清空()
    检查("数组元素读取后清空源（对照）", 读出6 == "元素文本")

    己 = {"甲": "跨函数文本"}
    检查("跨函数返回映射取值（缺陷B 护栏）", 取值(己, "甲") == "跨函数文本")

    // ── 读出值继续参与运算/再入容器──
    庚 = 盒()
    庚.内.插入("键", "链式文本")
    读出7 = 庚.内.获取("键")
    庚.内.清空()
    辛 = 盒()
    辛.内.插入("另", 读出7)
    检查("读出值可再入另一个容器", 辛.内.获取("另") == "链式文本")
    检查("读出值可参与拼接", 读出7 + "!" == "链式文本!")

    收尾()
结束
