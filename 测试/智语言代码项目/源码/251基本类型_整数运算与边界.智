启动程序():
    输出("=== 251 整数运算与边界（§2.4.1）===")

    数量 = 100
    年龄 = 18

    检查("整数加法", 年龄 + 数量 == 118)
    检查("整数减法", 数量 - 年龄 == 82)
    检查("整数乘法", 年龄 * 2 == 36)
    检查("取余 %", 数量 % 3 == 1)
    检查("幂 ^", 2 ^ 10 == 1024)

    // 除法为真除法：结果都是小数（整数/整数 不截断）
    检查("7 / 2 = 3.5（真除法）", 7 / 2 == 3.5)
    检查("100 / 3 ≈ 33.333…", 100 / 3 > 33.33 且 100 / 3 < 33.34)
    检查("真除法结果如实显示", 转文本(100 / 3) == "33.333333333333336")

    // 整数运算精确（大整数乘法不丢精度）
    检查("整数大数乘法精确", 1000000000000 * 3 == 3000000000000)
    检查("最大整数可读可写", 转文本(9223372036854775807) == "9223372036854775807")

    // 混合运算：整数自动提升为小数
    检查("整数自动提升为小数", 5 * 3.14 == 5.0 * 3.14)
    检查("提升后为小数运算（非整数精确值）", (5 * 3.14 == 15.7) == 假)

    // 溢出行为：64 位二补码回绕（规范 §2.4.1 已写明；与 Java / C# / Go / Rust 默认一致）
    检查("最大值 + 1 回绕为最小值", 9223372036854775807 + 1 == -9223372036854775808)
    检查("最小值 - 1 回绕为最大值", -9223372036854775808 - 1 == 9223372036854775807)
    检查("回绕结果如实显示", 转文本(9223372036854775807 + 1) == "-9223372036854775808")

    收尾()
结束
