// 数组 11 / 映射 8 方法 × 索引边界 + 与结构体/参数的深拷贝交互
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

结构体 盒子(数组<整数> 内容):
    数组<整数> 内容 = 内容
    追加到盒(整数 值):
        自身.内容.追加(值)
    结束
    取内容() 数组<整数>:
        返回 自身.内容
    结束
结束

改数组(数组<整数> 形参数组):
    形参数组.追加(999)
结束

返回数组() 数组<整数>:
    局部 = [1]
    局部.追加(2)
    返回 局部
结束

启动程序():
    输出("=== 191 数组/映射 索引边界与深拷贝 ===")
    数组甲 = [10, 20, 30]
    // ① 获取：1..长度 有效，越界返回空值（规范 §4.3：任意<甲|空值>）
    检查("获取-索引1", 数组甲.获取(1) == 10)
    检查("获取-索引长度", 数组甲.获取(3) == 30)
    检查("获取-索引长度+1 得空值", 数组甲.获取(4) == 空值)
    检查("获取-索引0 得空值", 数组甲.获取(0) == 空值)
    检查("获取-负索引得空值", 数组甲.获取(-1) == 空值)
    // ② 插入：首/中/尾 有效，越界抛异常（规范§4.3）
    数组乙 = [1, 3]
    数组乙.插入(1, 0)
    检查("插入-首位", 数组乙[1] == 0)
    检查("插入-首位后长度", 数组乙.长度() == 3)
    数组乙.插入(3, 2)
    检查("插入-中位", 数组乙[3] == 2)
    数组乙.插入(数组乙.长度() + 1, 9)
    检查("插入-末位后", 数组乙[数组乙.长度()] == 9)
    捕获:
        数组乙.插入(99, 7)
        检查("插入-越界应抛异常", 假)
    异常:
        检查("插入-越界抛异常", 真)
    结束
    // ③ 删除：首/尾 有效，越界抛异常
    数组丙 = [1, 2, 3]
    数组丙.删除(1)
    检查("删除-首位后剩余", 数组丙[1] == 2)
    数组丙.删除(数组丙.长度())
    检查("删除-末位后长度", 数组丙.长度() == 1)
    捕获:
        数组丙.删除(99)
        检查("删除-越界应抛异常", 假)
    异常:
        检查("删除-越界抛异常", 真)
    结束
    // ④ 深拷贝：值语义贯穿 参数 / 结构体字段 / 返回
    原 = [1]
    改数组(原)
    检查("参数-值传递不受影响", 原.长度() == 1)
    盒 = 盒子([1])
    盒.追加到盒(2)
    检查("结构体字段-自有容器可改", 盒.取内容().长度() == 2)
    取回 = 盒.取内容()
    取回.追加(3)
    检查("取回的是副本(不改盒内)", 盒.取内容().长度() == 2)
    返回的 = 返回数组()
    检查("返回值-完整携带", 返回的.长度() == 2)
    返回的.追加(3)
    检查("返回值-追加后独立", 返回的.长度() == 3)
    // ⑤ 大数组与增长
    大 = []
    循环 序 = 1, 序 <= 300, 序 += 1:
        大.追加(序)
    结束
    检查("大数组-长度300", 大.长度() == 300)
    检查("大数组-首元素", 大[1] == 1)
    检查("大数组-末元素", 大[300] == 300)
    检查("大数组-查找末位", 大.查找索引(300) == 300)
    大.反转()
    检查("大数组-反转后首元素", 大[1] == 300)
    大.排序()
    检查("大数组-排序后首元素", 大[1] == 1)
    大.清空()
    检查("大数组-清空后长度归零", 大.长度() == 0)
    // ⑥ 排序边界
    单 = [5]
    单.排序()
    检查("排序-单元素", 单[1] == 5)
    已排 = [1, 2, 3]
    已排.排序()
    检查("排序-已排序不变", 已排[1] == 1 且 已排[3] == 3)
    逆 = [3, 2, 1]
    逆.排序()
    检查("排序-逆序变升序", 逆[1] == 1 且 逆[3] == 3)
    重复 = [2, 1, 2, 1]
    重复.排序()
    检查("排序-含重复", 重复[1] == 1 且 重复[4] == 2)
    文本序 = ["乙", "甲", "丙"]
    文本序.排序()
    检查("排序-文本元素", 文本序.长度() == 3)
    // ⑦ 映射键的边界
    映射甲 = {}
    检查("映射-空获取返空值", 映射甲.获取("不存在") == 空值)
    // ℹ 规范 §4.4：`.删除` 返回「无返回值」⇒ 删除不存在的键不参与断言，只记录行为
    捕获:
        映射甲.删除("不存在")
        记录("映射-删除不存在的键", "未抛异常")
    异常:
        记录("映射-删除不存在的键", "抛异常")
    结束
    映射甲.插入("甲", 1)
    映射甲.插入("甲", 2)
    检查("映射-同键覆盖", 映射甲.获取("甲") == 2)
    检查("映射-覆盖后长度不变", 映射甲.长度() == 1)
    映射甲.插入("", 3)
    检查("映射-空串键可用", 映射甲.获取("") == 3)
    映射甲.插入("带 空格", 4)
    检查("映射-含空格键可用", 映射甲.获取("带 空格") == 4)
    收尾()
结束
