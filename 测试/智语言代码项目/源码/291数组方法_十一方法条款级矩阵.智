// §4.3 数组方法（11 个）条款级矩阵（双模）
// 规范条款：§4.3 方法表 + 索引从 1 开始 + .获取 越界返空值 + .取末尾 弹出语义 + .排序 可比较性三条
结构体 计数盒(整数 初值):
    整数 数值 = 初值
结束

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

应抛异常(文本 名称, 匿名函数 操作):
    捕获:
        操作()
        检查(名称 + "（应抛异常却成功）", 假)
    异常:
        检查(名称, 异常错误().类型.长度() > 0)
    结束
结束

应抛运行时(文本 名称, 匿名函数 操作):
    捕获:
        操作()
        检查(名称 + "（应抛异常却成功）", 假)
    异常:
        检查(名称, 异常错误().类型 == "运行时异常")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 291 数组方法十一方法条款级矩阵（§4.3）===")

    输出("-- .长度() --")
    空甲 = []
    检查("空数组", 空甲.长度() == 0)
    检查("三元素", [1, 2, 3].长度() == 3)
    检查("文本数组", ["甲", "乙"].长度() == 2)
    检查("嵌套数组算外层长度", [[1, 2], [3]].长度() == 2)

    输出("-- .追加(元素)：末尾添加 --")
    追加甲 = [1, 2]
    追加甲.追加(3)
    检查("长度加一", 追加甲.长度() == 3)
    相等文本("末元素为新值", 转文本(追加甲[3]), "3")
    追加甲.追加(4)
    相等文本("连续追加", 转文本(追加甲), "[1, 2, 3, 4]")
    追加文本 = []
    追加文本.追加("甲")
    相等文本("空数组追加", 转文本(追加文本), "[\引号甲\引号]")

    输出("-- .插入(索引, 元素)：索引从 1 开始 --")
    插入甲 = [10, 20, 30]
    插入甲.插入(1, 5)
    相等文本("头部插入", 转文本(插入甲), "[5, 10, 20, 30]")
    插入甲.插入(3, 15)
    相等文本("中部插入", 转文本(插入甲), "[5, 10, 15, 20, 30]")
    插入甲.插入(6, 40)
    相等文本("尾部插入（长度+1 位置）", 转文本(插入甲), "[5, 10, 15, 20, 30, 40]")
    应抛异常("插入位置 0 越界抛", 函数(): 插入甲.插入(0, 99) 结束)
    应抛异常("插入位置超过 长度+1 抛", 函数(): 插入甲.插入(99, 99) 结束)
    相等文本("越界抛后数组保持原样", 转文本(插入甲), "[5, 10, 15, 20, 30, 40]")

    输出("-- .删除(索引)：索引从 1 开始 --")
    删除甲 = ["a", "b", "c", "d"]
    删除甲.删除(1)
    相等文本("删首元素", 转文本(删除甲), "[\引号b\引号, \引号c\引号, \引号d\引号]")
    删除甲.删除(2)
    相等文本("删中元素", 转文本(删除甲), "[\引号b\引号, \引号d\引号]")
    删除甲.删除(2)
    相等文本("删末元素", 转文本(删除甲), "[\引号b\引号]")
    应抛异常("删除越界抛", 函数(): 删除甲.删除(9) 结束)
    应抛异常("删除位置 0 抛", 函数(): 删除甲.删除(0) 结束)

    输出("-- .取末尾()：取出并移除（弹出语义）--")
    弹出甲 = [1, 2, 3]
    弹出值 = 弹出甲.取末尾()
    检查("返回值非空", 弹出值 != 空值)
    相等文本("返回值为原末元素", 转文本(弹出值), "3")
    检查("长度减一", 弹出甲.长度() == 2)
    相等文本("剩余元素", 转文本(弹出甲), "[1, 2]")
    弹出乙 = [7]
    输出("  单元素弹出 = " + 转文本(弹出乙.取末尾()) + " 长度=" + 转文本(弹出乙.长度()))
    弹出空 = []
    弹出空值 = 弹出空.取末尾()
    检查("空数组取末尾返回空值", 弹出空值 == 空值)
    检查("空数组取末尾长度仍 0", 弹出空.长度() == 0)

    输出("-- .获取(索引)：越界返回空值 --")
    获取甲 = ["甲", "乙", "丙"]
    相等文本("取第 1 个", 获取甲.获取(1), "甲")
    相等文本("取第 3 个", 获取甲.获取(3), "丙")
    越界值 = 获取甲.获取(99)
    检查("越界返回空值", 越界值 == 空值)
    零位值 = 获取甲.获取(0)
    检查("索引 0 返回空值", 零位值 == 空值)
    负位值 = 获取甲.获取(0 - 1)
    检查("负索引返回空值", 负位值 == 空值)
    检查("获取不改变数组", 获取甲.长度() == 3)

    输出("-- .是否包含(元素) --")
    检查("整数命中", [1, 2, 3].是否包含(2) == 真)
    检查("整数未命中", [1, 2, 3].是否包含(9) == 假)
    检查("文本命中", ["甲", "乙"].是否包含("乙") == 真)
    检查("空数组不含任何元素", 空甲.是否包含(1) == 假)
    检查("小数命中", [1.5, 2.5].是否包含(2.5) == 真)
    盒甲 = 计数盒(3)
    检查("结构体按字段相等命中", [盒甲].是否包含(计数盒(3)) == 真)
    检查("结构体不同值不命中", [盒甲].是否包含(计数盒(4)) == 假)

    输出("-- .查找索引(元素)：首次出现，未找到 0 --")
    检查("首现位置", [10, 20, 30].查找索引(20) == 2)
    检查("未找到返回 0", [10, 20].查找索引(99) == 0)
    检查("重复元素取首次", [5, 3, 5].查找索引(5) == 1)
    检查("末元素", ["a", "b", "c"].查找索引("c") == 3)

    输出("-- .反转() --")
    反转甲 = [1, 2, 3, 4, 5]
    反转甲.反转()
    相等文本("奇数长度", 转文本(反转甲), "[5, 4, 3, 2, 1]")
    反转乙 = [1, 2, 3, 4]
    反转乙.反转()
    相等文本("偶数长度", 转文本(反转乙), "[4, 3, 2, 1]")
    反转单 = [7]
    反转单.反转()
    相等文本("单元素", 转文本(反转单), "[7]")
    反转空 = []
    反转空.反转()
    检查("空数组反转仍为 0", 反转空.长度() == 0)

    输出("-- .排序()：数值（整数/小数可混合）--")
    排序甲 = [3, 1, 2]
    排序甲.排序()
    相等文本("整数升序", 转文本(排序甲), "[1, 2, 3]")
    排序负 = [0 - 1, 0 - 5, 0 - 3]
    排序负.排序()
    相等文本("负整数升序", 转文本(排序负), "[-5, -3, -1]")
    排序小数 = [2.5, 1.5, 2.25]
    排序小数.排序()
    相等文本("小数升序", 转文本(排序小数), "[1.5, 2.25, 2.5]")
    排序混合 = [3, 1.5, 2, 0.5]
    排序混合.排序()
    相等文本("整数与小数混合按数值", 转文本(排序混合), "[0.5, 1.5, 2, 3]")

    输出("-- .排序()：文本（码点序）与逻辑（假<真）--")
    排序文本 = ["banana", "apple", "cherry"]
    排序文本.排序()
    相等文本("英文按码点", 转文本(排序文本), "[\引号apple\引号, \引号banana\引号, \引号cherry\引号]")
    排序中文 = ["丙", "甲", "乙"]
    排序中文.排序()
    检查("中文按 Unicode 码点（升序）", 排序中文[1] != "" 且 排序中文.长度() == 3)
    排序逻辑 = [真, 假, 真]
    排序逻辑.排序()
    检查("逻辑 假<真", 排序逻辑[1] == 假 且 排序逻辑[3] == 真)

    输出("-- .排序()：空/单元素无操作 --")
    排序空 = []
    排序空.排序()
    检查("空数组不抛且长度 0", 排序空.长度() == 0)
    排序单 = [5]
    排序单.排序()
    相等文本("单元素不变", 转文本(排序单), "[5]")

    输出("-- .排序()：不可比较 ⇒ 抛运行时异常且数组保持（规则 2）--")
    混排数组 = [1, "a"]
    应抛运行时("整数与文本混排抛", 函数(): 混排数组.排序() 结束)
    相等文本("混排抛后数组保持原样", 转文本(混排数组), "[1, \引号a\引号]")
    含空值数组 = [1, 空值, 2]
    应抛运行时("含空值抛", 函数(): 含空值数组.排序() 结束)
    含数组 = [[1], [2]]
    应抛运行时("元素为数组抛", 函数(): 含数组.排序() 结束)

    输出("-- .清空() --")
    清空甲 = [1, 2, 3]
    清空甲.清空()
    检查("长度归零", 清空甲.长度() == 0)
    清空甲.追加(9)
    相等文本("清空后可继续追加", 转文本(清空甲), "[9]")
    清空空 = []
    清空空.清空()
    检查("空数组清空无操作", 清空空.长度() == 0)

    输出("-- 元素值语义（结构体元素独立副本）--")
    源盒 = 计数盒(1)
    盒数组 = [源盒]
    盒数组.追加(计数盒(2))
    盒数组[1].数值 = 99
    检查("改数组元素不影响原结构体变量（值语义）", 源盒.数值 == 1)
    检查("改数组元素生效", 盒数组[1].数值 == 99)

    收尾()
结束
