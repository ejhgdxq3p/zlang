// ============================================================
// 复杂综合结构体测试
// 综合：结构体参数 + 字段(含数组字段) + 初始化覆盖 + 多方法 +
//      方法间相互调用 + 结构体间组合调用
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 商品结构体（被购物车组合）──
结构体 商品(文本 名称, 小数 单价):
    获取名称() 文本:
        返回 名称
    结束
    获取单价() 小数:
        返回 单价
    结束
    获取描述() 文本:
        返回 名称 + "(" + 转文本(单价) + ")"
    结束
结束

// ── 综合账户：参数 + 字段(数组) + 初始化覆盖 + 多方法 ──
结构体 综合账户(文本 账户名, 小数 初始余额):
    私有 小数 余额
    私有 数组<文本> 交易记录 = []
    文本 账号
    初始化():
        自身.余额 = 初始余额
        自身.账号 = "ACC-" + 账户名
        自身.交易记录 = []
    结束
    存款(小数 金额):
        自身.余额 += 金额
        自身.交易记录.追加("存款" + 转文本(金额))
    结束
    取款(小数 金额):
        如果 金额 <= 自身.余额:
            自身.余额 -= 金额
            自身.交易记录.追加("取款" + 转文本(金额))
        结束
    结束
    获取余额() 小数:
        返回 自身.余额
    结束
    获取交易数() 整数:
        返回 自身.交易记录.长度()
    结束
    获取账号() 文本:
        返回 自身.账号
    结束
结束

// ── 购物车：组合商品结构体 + 方法间调用 ──
结构体 购物车():
    私有 数组<商品> 明细 = []
    私有 小数 合计 = 0.0
    添加(文本 名称, 小数 单价):
        新商品 = 商品(名称, 单价)
        自身.明细.追加(新商品)
        自身.合计 += 单价
    结束
    获取合计() 小数:
        返回 自身.合计
    结束
    获取数量() 整数:
        返回 自身.明细.长度()
    结束
    列出明细() 文本:
        描述 = ""
        循环 项 遍历 自身.明细:
            描述 += 项.获取描述() + ";"
        结束
        返回 描述
    结束
结束

// ── 测试 ──
测试_综合账户():
    账户 = 综合账户("张三", 1000.0)
    检查("综合账户-初始余额1000", 账户.获取余额() == 1000.0)
    检查("综合账户-账号ACC-张三", 账户.获取账号() == "ACC-张三")
    账户.存款(500.0)
    账户.存款(200.0)
    检查("综合账户-存款后1700", 账户.获取余额() == 1700.0)
    检查("综合账户-交易数2", 账户.获取交易数() == 2)
    账户.取款(700.0)
    检查("综合账户-取款后1000", 账户.获取余额() == 1000.0)
    检查("综合账户-交易数3", 账户.获取交易数() == 3)
    账户.取款(99999.0)
    检查("综合账户-超额取款不扣减", 账户.获取余额() == 1000.0)
结束

测试_购物车组合():
    车 = 购物车()
    车.添加("苹果", 3.0)
    车.添加("香蕉", 5.0)
    检查("购物车-数量2", 车.获取数量() == 2)
    检查("购物车-合计8", 车.获取合计() == 8.0)
    // ⚠ 修订（2026-09-19，按规范文档）：`获取描述()` 输出 `名称 + "(" + 转文本(单价) + ")"`，
    //   而规范 §5.1.2 要求小数文本化去尾零但**至少保留一位小数**（`转文本(3.0) == "3.0"`）
    //   ⇒ 实际描述为 `苹果(3.0)`（原断言 `苹果(3)` 系过期期望）。
    检查("购物车-明细含商品描述", 车.列出明细().查找("苹果(3.0)") > 0)
结束

// ── 主入口 ──
启动程序():
    输出("========== 复杂综合结构体测试 ==========")
    测试_综合账户()
    测试_购物车组合()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
