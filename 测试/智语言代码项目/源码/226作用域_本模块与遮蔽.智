// 覆盖《智语言编程规范》§2.3.5「作用域规则」：
//   L1787-1796 变量遮蔽示例：函数内 `数值 = 20` ⇒ 隐式声明新的局部变量（遮蔽同名模块变量的语义），
//                            模块变量须用 `本模块.数值` 访问，调用后模块变量不被修改
//   L1835 模块变量读取/修改一律 `本模块.`；L1839 `本模块.` 可访问所有模块级成员（含容器多层路径）
//   L1928 / L1958 / L4712 字段必须用 `自身.字段名`（且与模块变量同名时互不干扰）
// 注：规范 L1796 示例在顶层写裸名 `输出(数值)` 与 L1835 有张力；本用例统一按 L1835 用 `本模块.`。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

// ── 模块级：变量 / 容器（用于多层路径）──
数值 = 10
计数器 = 100
缓存数据 = {"甲": 1}

// ── 结构体：字段 计数器 与 模块变量 计数器 同名，各自独立 ──
结构体 处理器():
    计数器 = 0

    合计() 整数:
        返回 本模块.计数器 + 自身.计数器
    结束

    双加一():
        本模块.计数器 = 本模块.计数器 + 1
        自身.计数器 = 自身.计数器 + 1
    结束
结束

// ── 局部变量遮蔽模块变量（合规：模块变量用 本模块. 访问）──
测试遮蔽() 整数:
    数值 = 20
    返回 数值
结束

// ── 内层代码块语义（规范 L1845 / L1869-1872「声明与赋值区分」）──
//   隐式 `乙 = 20`（当前作用域链上已有 乙）⇒ **赋值**同一个变量（非新声明）；
//   显式 `整数 乙 = 20` ⇒ 块内**新建遮蔽变量**（外层 乙 不受影响）。
内层隐式() 整数:
    乙 = 10
    如果 真:
        乙 = 20
    结束
    返回 乙
结束

内层显式() 整数:
    乙 = 10
    如果 真:
        整数 乙 = 20
        输出("  （内层显式声明遮蔽，块内=" + 转文本(乙) + "）")
    结束
    返回 乙
结束

// ── 本模块. 复合赋值 ──
复合加一() 整数:
    本模块.计数器 += 1
    返回 本模块.计数器
结束

// ── 本模块. 多层路径（模块容器 → 方法）──
读缓存() 整数:
    返回 本模块.缓存数据.获取("甲")
结束

启动程序():
    输出("=== 226 作用域：本模块. 与遮蔽（§2.3.5）===")

    检查("局部遮蔽模块变量：裸名取局部=20", 测试遮蔽() == 20)
    检查("遮蔽后模块变量未被修改=10", 本模块.数值 == 10)
    检查("内层块隐式赋值＝赋值同一变量（10→20）", 内层隐式() == 20)
    检查("内层块显式声明＝块内遮蔽（外层仍 10）", 内层显式() == 10)

    器 = 处理器()
    检查("字段与模块变量同名互不干扰（100+0）", 器.合计() == 100)
    器.双加一()
    检查("本模块.计数器 被改=101", 本模块.计数器 == 101)
    检查("自身.计数器 被改=1（字段）", 器.计数器 == 1)

    检查("本模块. 支持复合赋值=102", 复合加一() == 102)
    检查("本模块. 多层路径（容器取值）", 读缓存() == 1)

    收尾()
结束
