// ============================================================
// 值传递 / 引用传递 / 接口 全面测试（对照《智语言编程规范》§2.3.7、§3.5）
// 重点覆盖：基础值传递隔离、引用传递就地修改、引用交换、结构体引用传递、
//           接口作变量/作函数参数引用语义、接口数组多元素。
// 双模验证：解释模式 + 编译模式
// 已知架构限制（测试中已标注 ⚠，非测试缺陷）：
//   - 接口数组/映射元素作接收者时方法写回原实例未生效
//   - 链式成员方法写回（自身.字段.方法()）当前不落回原实例
// ============================================================

总数 = 0
通过数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        输出("  ❌ " + 描述)
    结束
结束

// ---------- 值传递：基础类型隔离 ----------
加倍值(整数 值):
    值 = 值 * 2
结束

// ---------- 引用传递：基础类型就地修改 ----------
加倍引用(传引用 整数 值):
    值 = 值 * 2
结束

// ---------- 引用交换两个变量 ----------
交换(传引用 整数 甲, 传引用 整数 乙):
    整数 临时 = 甲
    甲 = 乙
    乙 = 临时
结束

// ---------- 值传递：结构体按值拷贝（互不干扰） ----------
结构体 计数器():
    整数 数 = 0
    初始化():
        自身.数 = 0
    结束
    增加():
        自身.数 = 自身.数 + 1
    结束
结束

值传递增加(计数器 实例):
    实例.增加()
结束

引用传递增加(传引用 计数器 实例):
    实例.增加()
结束

// ---------- 引用传递：结构体字段修改 ----------
改字段(传引用 计数器 实例, 整数 新值):
    实例.数 = 新值
结束

// ---------- 接口 ----------
接口 可计算:
    计算() 整数:
    结束
结束

结构体 正方形() 适配 可计算:
    整数 边长 = 0
    初始化():
        自身.边长 = 0
    结束
    计算() 整数:
        返回 自身.边长 * 自身.边长
    结束
结束

结构体 长方形() 适配 可计算:
    整数 宽 = 0
    整数 高 = 0
    初始化():
        自身.宽 = 0
        自身.高 = 0
    结束
    计算() 整数:
        返回 自身.宽 * 自身.高
    结束
结束

// 接口作函数参数（值传递接收接口实例）
求面积(可计算 形状) 整数:
    返回 形状.计算()
结束

启动程序():
    输出("===== A. 基础类型值传递隔离 =====")
    整数 原数 = 5
    加倍值(原数)
    检查("值传递不改变原变量=5", 原数 == 5)

    输出("===== B. 基础类型引用传递就地修改 =====")
    整数 引用数 = 5
    加倍引用(引用数)
    检查("引用传递改变原变量=10", 引用数 == 10)

    输出("===== C. 引用交换两个变量 =====")
    整数 左 = 1
    整数 右 = 2
    交换(左, 右)
    检查("交换后左=2", 左 == 2)
    检查("交换后右=1", 右 == 1)

    输出("===== D. 结构体值传递隔离 =====")
    计数器 甲计数 = 计数器()
    值传递增加(甲计数)
    检查("值传递结构体方法不作用原实例 数=0", 甲计数.数 == 0)
    甲计数.增加()
    检查("原实例自行增加后 数=1", 甲计数.数 == 1)

    输出("===== E. 结构体引用传递就地修改 =====")
    计数器 乙计数 = 计数器()
    引用传递增加(乙计数)
    检查("引用传递结构体方法作用原实例 数=1", 乙计数.数 == 1)
    改字段(乙计数, 7)
    检查("引用传递改字段作用原实例 数=7", 乙计数.数 == 7)

    输出("===== F. 接口作变量 + 接口作函数参数 =====")
    正方形 方 = 正方形()
    方.边长 = 3
    长方形 长 = 长方形()
    长.宽 = 4
    长.高 = 5
    可计算 形状变量 = 方
    检查("接口变量(正方形)计算=9", 求面积(形状变量) == 9)
    形状变量 = 长
    检查("接口变量(长方形)计算=20", 求面积(形状变量) == 20)
    检查("接口参数(正方形)计算=9", 求面积(方) == 9)
    检查("接口参数(长方形)计算=20", 求面积(长) == 20)

    输出("===== G. 接口数组多元素（元素为不同实现） =====")
    数组<可计算> 形状表 = [方, 长]
    检查("接口数组长度=2", 形状表.长度() == 2)
    检查("接口数组[1]计算=9", 形状表[1].计算() == 9)
    检查("接口数组[2]计算=20", 形状表[2].计算() == 20)

    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.总数 - 本模块.通过数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
    输出("⚠ 已知架构限制（已在测试中标注，非测试缺陷）：")
    输出("  1. 接口数组/映射元素作接收者时方法写回原实例未生效")
    输出("  2. 链式成员方法写回（自身.字段.方法()）当前不落回原实例")
结束
