// 测试 规范「字段类型支持总表」第 1580-1583 行：
//   数组（有约束/无约束）字段「可省略（默认 []）」；映射（有约束/无约束）字段「可省略（默认 {}）」
// 并验证规范第 3477 行「变量字段：可变、各实例取值可不同」⇒ 每次构造必须新建独立容器。
// ★判定设计★ 用「字段 .长度()==0 且可 .追加()/.插入()」证明字段默认值是**真容器**而非空值。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  PASS " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  FAIL " + 名称)
    结束
结束

// 四种容器字段全部省略初始化；另有基本类型字段作对照
结构体 仓库:
    数组<整数> 有约束库存
    数组 无约束库存
    映射<文本, 整数> 有约束台账
    映射 无约束台账
    文本 名称 = "未命名"
    整数 编号
结束

启动程序():
    // ── 一、不传任何参数即可构造（字段有自然零值）──
    甲库 = 仓库()
    检查("容器字段 有约束数组默认长度0", 甲库.有约束库存.长度() == 0)
    检查("容器字段 无约束数组默认长度0", 甲库.无约束库存.长度() == 0)
    检查("容器字段 有约束映射默认长度0", 甲库.有约束台账.长度() == 0)
    检查("容器字段 无约束映射默认长度0", 甲库.无约束台账.长度() == 0)
    检查("基本类型字段 文本默认值", 甲库.名称 == "未命名")
    检查("基本类型字段 整数默认值", 甲库.编号 == 0)

    // ── 二、默认值是"真容器"：可写（若为空值，以下写入必报错）──
    甲库.有约束库存.追加(5)
    检查("容器字段 数组可追加(证明是[]非空值)", 甲库.有约束库存.长度() == 1)
    甲库.有约束台账.插入("甲", 1)
    检查("容器字段 映射可插入(证明是{}非空值)", 甲库.有约束台账["甲"] == 1)
    甲库.无约束库存.追加("文本元素")
    检查("容器字段 无约束数组可写", 甲库.无约束库存.长度() == 1)
    甲库.无约束台账.插入("开关", 真)
    检查("容器字段 无约束映射可写", 甲库.无约束台账.长度() == 1)

    // ── 三、各实例独立：每次构造各自新建容器 ──
    乙库 = 仓库()
    检查("新实例 数组字段为0", 乙库.有约束库存.长度() == 0)
    检查("新实例 映射字段为0", 乙库.有约束台账.长度() == 0)
    检查("实例间不共享(甲库仍为1)", 甲库.有约束库存.长度() == 1)
    乙库.有约束库存.追加(6)
    乙库.有约束库存.追加(7)
    检查("乙库独立写入(2)", 乙库.有约束库存.长度() == 2)
    检查("甲库不受影响(仍1)", 甲库.有约束库存.长度() == 1)

    输出("通过数 = " + 转文本(本模块.通过数) + " / 总数 = " + 转文本(本模块.总数))
结束
