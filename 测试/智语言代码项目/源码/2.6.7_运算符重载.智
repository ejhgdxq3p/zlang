测试_全部():
    甲 = 向量(1.0, 2.0)
    乙 = 向量(3.0, 4.0)

    丙 = 甲 + 乙
    检查("重载+ ⇒ 加法", 丙.横 == 4.0 且 丙.纵 == 6.0)
    丁 = 乙 - 甲
    检查("重载- ⇒ 减法", 丁.横 == 2.0 且 丁.纵 == 2.0)
    戊 = 甲 * 3.0
