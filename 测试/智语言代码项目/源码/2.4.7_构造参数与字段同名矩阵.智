// 文件: 2.4.7_构造参数与字段同名矩阵.智
// 职责: 规范 §2.4.7「结构体全局参数与字段同名 ⇒ ✅ 可以，字段通过 `自身.字段名` 访问；
//       字段默认值引用结构体全局参数 ⇒ ✅ 允许，此时参数优先」的**全矩阵防回归护栏**。
//   背景：曾记录「同名参数 + `初始化` 读 `自身.字段` ⇒ 字段得空值」的疑似缺陷（F17），
//   2026-10-15 以 13 组形态复核 ⇒ **不再复现**（双模全绿）⇒ 固化为本护栏用例。
结构体 用户(文本 姓名):
    文本 姓名 = "默认"

    初始化():
        本模块.初始化前 = 自身.姓名
        自身.姓名 = 姓名
    结束

    改名(文本 新名):
        自身.姓名 = 新名
    结束

    取姓名() 文本:
        返回 自身.姓名
    结束
结束

结构体 带默认(文本 姓名 = "匿名"):
    文本 姓名 = 姓名

    取姓名() 文本:
        返回 自身.姓名
    结束
结束

结构体 篮子(数组 物品):
    数组 物品 = []

    初始化():
        自身.物品 = 物品
    结束

    数量() 整数:
        返回 自身.物品.长度()
    结束
结束

结构体 计数器(整数 初始值):
    整数 当前 = 0

    初始化():
        自身.当前 = 初始值
    结束

    累加(整数 当前):
        自身.当前 = 自身.当前 + 当前
        返回 自身.当前
    结束
结束

结构体 内盒(文本 标签):
    文本 标签 = "内"
结束

结构体 外盒(文本 标签):
    内盒 标签 = 内盒("默认内")

    初始化():
        自身.标签 = 内盒(标签)
    结束

    取标签() 文本:
        返回 自身.标签.标签
    结束
结束

通过数 = 0
失败数 = 0
总数 = 0
初始化前 = ""
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("FAILCASE " + 名称)
    结束
结束

启动程序():
    甲 = 用户("张三")
    检查("初始化内赋值自身.字段生效", 甲.取姓名() == "张三")
    检查("外部读 实例.字段", 甲.姓名 == "张三")
    检查("初始化内**读** 自身.字段（赋值前）得字段默认值", 本模块.初始化前 == "默认")

    甲.改名("李四")
    检查("方法内读写 自身.字段", 甲.取姓名() == "李四")

    乙 = 用户("王五")
    检查("实例独立-乙", 乙.取姓名() == "王五")
    检查("实例独立-甲不受影响", 甲.取姓名() == "李四")
    甲.姓名 = "张三改"
    检查("直改字段只影响本实例", 甲.姓名 == "张三改" 且 乙.姓名 == "王五")

    丙 = 带默认()
    丁 = 带默认("张三")
    检查("字段默认值引用同名参数（参数优先）", 丁.取姓名() == "张三")
    检查("参数有默认值时省略实参", 丙.取姓名() == "匿名")

    篮 = 篮子([1, 2, 3])
    检查("容器字段与同名参数", 篮.数量() == 3)

    计 = 计数器(100)
    检查("方法参数与字段同名-首次累加", 计.累加(5) == 105)
    检查("方法参数与字段同名-再次累加", 计.累加(10) == 115)
    检查("字段在方法调用后保持", 计.当前 == 115)

    盒 = 外盒("外层")
    检查("结构体类型字段与同名参数", 盒.取标签() == "外层")

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
