// 308 接手回归：真实 C 接口（不带「智语言」修饰符）的端到端调用
// ══════════════════════════════════════════════════════════════════════════
// 覆盖：整数/小数/文本形参与返回值；带输出参数的函数（输出参数夹在输入参数中间、
//       排在最前面、多个输出参数）；C 函数返回非零状态码时抛出可捕获异常。
// 依赖：外部语言/嵌套结构库（源码在 测试/外部语言样例/嵌套结构库.c，由回归脚本现场编译）。
// 注意：规范 §6.5.2 / §6.5.10 写明外部块不支持输出参数。实现里原本就有「输出」修饰符这条路径，
//       第②③节只守护它在存在期间不把输入参数传错位，不代表它是语言的正式约定；去留由语言作者定。
// ══════════════════════════════════════════════════════════════════════════
外部:
    导入 嵌套结构库

    相加 关联 add_ll
    缩放 关联 scale
    字节数 关联 text_bytes
    除余 关联 div_rem
    平方 关联 square_out

    相加(长整数 甲, 长整数 乙) 长整数:
    结束

    缩放(长小数 值, 长小数 倍数) 长小数:
    结束

    字节数(文本 内容) 长整数:
    结束

    除余(长整数 被除数, 输出 长整数 商, 长整数 除数, 输出 长整数 余数) 长整数:
    结束

    平方(输出 长整数 结果, 长整数 值) 长整数:
    结束
结束

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== ① 标量与文本 =====")
    检查("整数相加 40+2 = 42", 相加(40, 2) == 42)
    检查("负数相加 -5+3 = -2", 相加(-5, 3) == -2)
    检查("小数缩放 1.5×4 = 6", 缩放(1.5, 4.0) == 6.0)
    检查("文本按字节数传到 C（abc中 = 6 字节）", 字节数("abc中") == 6)
    检查("空文本 = 0 字节", 字节数("") == 0)

    输出("===== ② 输出参数 =====")
    商余 = 除余(17, 5)
    检查("多个输出参数得到数组", 类型(商余) == "数组")
    检查("输出参数夹在输入参数中间：商 = 3", 商余[1] == 3)
    检查("末尾的输出参数：余数 = 2", 商余[2] == 2)
    检查("输入参数没有错位（100÷7 商 14 余 2）", 除余(100, 7)[1] == 14 且 除余(100, 7)[2] == 2)
    检查("输出参数排在最前面：9 的平方 = 81", 平方(9) == 81)

    输出("===== ③ 状态码非零抛异常 =====")
    抛了 = 假
    捕获:
        除余(1, 0)
    异常:
        抛了 = 真
    结束
    检查("C 返回非零状态码时抛出可捕获异常", 抛了)
    检查("异常之后仍可继续调用", 相加(1, 1) == 2)

    输出("结果：通过 " + 转文本(本模块.通过数) + " / 总数 " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
