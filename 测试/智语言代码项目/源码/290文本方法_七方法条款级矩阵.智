// §4.2 文本方法（7 个）条款级矩阵（双模）
// 规范条款：§4.2 方法表 + 6 条边界规则（位置从 1 开始、按 Unicode 字符计数）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 290 文本方法七方法条款级矩阵（§4.2）===")

    输出("-- .长度()（按字符计数）--")
    检查("空文本", "".长度() == 0)
    检查("单字符", "a".长度() == 1)
    检查("纯中文", "你好世界".长度() == 4)
    检查("中英混合", "a你b好".长度() == 4)
    检查("emoji 计 1 个字符", "🙂".长度() == 1)
    检查("emoji 与中文混合", "你好🙂".长度() == 3)
    检查("空白也计数", " \换行\制表 ".长度() == 4)
    检查("数字串", "12345".长度() == 5)

    输出("-- .截取(起始, 长度)：起点从 1 开始 --")
    相等文本("开头取 2", "你好世界".截取(1, 2), "你好")
    相等文本("中段取 2", "你好世界".截取(2, 2), "好世")
    相等文本("取末字", "你好世界".截取(4, 1), "界")
    相等文本("全长", "你好世界".截取(1, 4), "你好世界")
    相等文本("长度 0 得空串", "你好世界".截取(2, 0), "")
    相等文本("长度超出剩余取到结尾", "abc".截取(2, 99), "bc")
    相等文本("起始越界得空串", "abc".截取(5, 2), "")
    相等文本("起始 0（非法）得空串", "abc".截取(0, 2), "")
    相等文本("起始负数得空串", "abc".截取(0 - 1, 2), "")
    相等文本("空文本截取", "".截取(1, 3), "")
    相等文本("emoji 截取", "a🙂b".截取(2, 1), "🙂")

    输出("-- .查找(子串)：未找到返回 0 --")
    检查("命中首位置", "你好世界".查找("你好") == 1)
    检查("命中中段", "你好世界".查找("世界") == 3)
    检查("命中末字", "你好世界".查找("界") == 4)
    检查("未找到返回 0", "你好世界".查找("地球") == 0)
    检查("空文本查找返回 0", "".查找("a") == 0)
    检查("空子串返回 1（规则 2）", "abc".查找("") == 1)
    检查("重复取首次", "aaa".查找("a") == 1)
    检查("跨字匹配", "你好世界".查找("好世") == 2)
    检查("emoji 位置", "a🙂b".查找("🙂") == 2)
    检查("子串长于原文返回 0", "abc".查找("abcd") == 0)
    检查("区分大小写", "AbC".查找("abc") == 0)

    输出("-- .替换(旧, 新) --")
    相等文本("单处替换", "你好世界".替换("世界", "朋友"), "你好朋友")
    相等文本("多处全替换", "aaa".替换("a", "b"), "bbb")
    相等文本("未命中保持原文", "abc".替换("x", "y"), "abc")
    相等文本("替换为空串", "a-b-c".替换("-", ""), "abc")
    相等文本("新旧相同", "abc".替换("b", "b"), "abc")
    相等文本("中文替换", "我喜欢苹果".替换("苹果", "香蕉"), "我喜欢香蕉")
    相等文本("emoji 替换", "a🙂b".替换("🙂", "★"), "a★b")
    相等文本("空旧串逐位插入（规则 3）", "abc".替换("", "-"), "-a-b-c-")

    原文甲 = "abcabc"
    替换后 = 原文甲.替换("a", "z")
    相等文本("替换返回新文本", 替换后, "zbczbc")
    相等文本("原文本不变（文本不可变）", 原文甲, "abcabc")

    输出("-- .分隔(分隔符)：保留空元素 --")
    分隔甲 = "苹果,香蕉,橙子".分隔(",")
    检查("元素个数", 分隔甲.长度() == 3)
    相等文本("首元素", 分隔甲[1], "苹果")
    相等文本("次元素", 分隔甲[2], "香蕉")
    相等文本("末元素", 分隔甲[3], "橙子")
    空文本分隔 = "".分隔(",")
    检查("空文本得单空串元素（规则 4）", 空文本分隔.长度() == 1)
    相等文本("空文本唯一元素为空串", 空文本分隔[1], "")
    连续分隔 = "a,,b".分隔(",")
    检查("连续分隔符保留空段", 连续分隔.长度() == 3)
    相等文本("连续分隔符空段内容", 连续分隔[2], "")
    首尾分隔 = ",a,".分隔(",")
    检查("首尾分隔符保留空段", 首尾分隔.长度() == 3)
    相等文本("首空段", 首尾分隔[1], "")
    相等文本("尾空段", 首尾分隔[3], "")
    检查("多字符分隔符", "a::b::c".分隔("::") == ["a", "b", "c"])
    检查("分隔符不存在返回单元素", "abc".分隔("x") == ["abc"])
    检查("中文分隔符", "甲乙|丙丁".分隔("|") == ["甲乙", "丙丁"])
    检查("emoji 分隔符", "a🙂b".分隔("🙂") == ["a", "b"])

    输出("-- .是否包含(子串) --")
    检查("命中", "你好世界".是否包含("世界") == 真)
    检查("未命中", "你好世界".是否包含("地球") == 假)
    检查("空子串恒真（规则 2）", "abc".是否包含("") == 真)
    检查("空文本对非空子串为假", "".是否包含("a") == 假)
    检查("区分大小写", "AbC".是否包含("abc") == 假)
    检查("中文包含", "智语言编程".是否包含("语言") == 真)
    检查("emoji 包含", "a🙂b".是否包含("🙂") == 真)

    输出("-- .去除空白()：首尾空白（空格/制表/换行/回车）--")
    相等文本("前后空格", "  你好  ".去除空白(), "你好")
    相等文本("全空白变空串", " \换行\制表 ".去除空白(), "")
    相等文本("无空白保持", "你好".去除空白(), "你好")
    相等文本("保留内部空白", "  你 好  ".去除空白(), "你 好")
    相等文本("空文本", "".去除空白(), "")
    相等文本("只去首", "  尾".去除空白(), "尾")
    相等文本("只去尾", "首  ".去除空白(), "首")
    相等文本("含回车", " \回车你好\回车 ".去除空白(), "你好")
    相等文本("含换行", "\换行多行\换行".去除空白(), "多行")

    输出("-- 链式调用 --")
    相等文本("去空白→替换→截取", "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2), "你好")
    检查("长度→是否包含", "  中文  ".去除空白().是否包含("文") == 真)
    检查("分隔→查找索引", "a,b,c".分隔(",").查找索引("b") == 2)
    检查("分隔→长度→包含串", "x,y,z".分隔(",").包含("y"))

    收尾()
结束
