// 组合：数组<结构体> / 映射<结构体> / 结构体含容器字段 / 容器字段方法链 / 结构体数组排序查找
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

结构体 学生(文本 姓名, 整数 分数):
    整数 分数 = 分数
    文本 姓名 = 姓名
    整数 标签数 = 0
    数组<整数> 明细 = []
    记录分数(整数 值):
        自身.明细.追加(值)
        自身.标签数 = 自身.标签数 + 1
    结束
    取总分() 整数:
        合计 = 0
        循环 序 = 1, 序 <= 自身.明细.长度(), 序 += 1:
            合计 = 合计 + 自身.明细[序]
        结束
        返回 合计
    结束
结束

启动程序():
    输出("=== 180 组合-容器与结构体 ===")
    // 数组<结构体>
    名册 = [学生("甲", 90), 学生("乙", 80), 学生("丙", 70)]
    检查("数组<结构体>-长度", 名册.长度() == 3)
    检查("数组<结构体>-字段读取", 名册[1].姓名 == "甲")
    检查("数组<结构体>-末元素字段", 名册[3].分数 == 70)
    // 结构体含容器字段（值语义：各自独立）
    甲生 = 学生("甲", 90)
    甲生.记录分数(10)
    甲生.记录分数(20)
    检查("结构体容器字段-追加后长度", 甲生.明细.长度() == 2)
    检查("结构体容器字段-计数", 甲生.标签数 == 2)
    检查("结构体容器字段-累加", 甲生.取总分() == 30)
    乙生 = 学生("乙", 80)
    检查("结构体容器字段-副本独立", 乙生.明细.长度() == 0)
    // 映射<文本, 数组<整数>>
    分班 = {"一班": [90, 85], "二班": [70, 75]}
    检查("映射<文本,数组>-长度", 分班.长度() == 2)
    一班分 = 分班.获取("一班")
    检查("映射取容器-元素数", 一班分.长度() == 2)
    一班分.追加(60)
    检查("映射取容器-追加生效", 一班分.长度() == 3)
    // 结构体数组：排序 + 查找
    分数数组 = [30, 10, 20]
    分数数组.排序()
    检查("结构体场景-数组排序", 分数数组[1] == 10)
    检查("结构体场景-数组查找", 分数数组.查找索引(20) == 2)
    // 结构体字段作映射值
    成绩表 = {}
    成绩表.插入("甲", 90)
    成绩表.插入("乙", 85)
    检查("映射值-结构体场景", 成绩表.获取("甲") == 90)
    检查("映射值-所有键含乙", 成绩表.所有键().是否包含("乙") == 真)
    收尾()
结束
