// §4.2 文本方法完整矩阵（长度 / 截取 / 查找 / 替换 / 分隔 / 是否包含 / 去除空白）
// 依据：规范 §4.2（位置从 1 开始、未找到返回 0、每字符计 1）
// 规范未定义的情形（越界截取、空分隔符、空旧串替换）单独「记录」，不判失败，避免把实现选择当规范。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

启动程序():
    输出("=== 02 文本方法完整矩阵 ===")

    // ───────── 长度（按字符计，中文/emoji 均为 1）─────────
    检查("长度-空文本", "".长度() == 0)
    检查("长度-单字符", "a".长度() == 1)
    检查("长度-中文", "你好世界".长度() == 4)
    检查("长度-中英混合", "a你b好".长度() == 4)
    检查("长度-emoji 计 1", "🙂".长度() == 1)
    检查("长度-emoji 与中文混合", "你好🙂".长度() == 3)
    检查("长度-空白字符计数", " \换行\制表 ".长度() == 4)

    // ───────── 截取（起始从 1，长度单位=字符）─────────
    检查("截取-开头2字", "你好世界".截取(1, 2) == "你好")
    检查("截取-中段2字", "你好世界".截取(2, 2) == "好世")
    检查("截取-末字", "你好世界".截取(4, 1) == "界")
    检查("截取-全长", "你好世界".截取(1, 4) == "你好世界")
    检查("截取-长度0 返回空", "你好世界".截取(2, 0) == "")
    检查("截取-emoji", "a🙂b".截取(2, 1) == "🙂")
    记录("截取(1, 100) 越界（规范未定义）", "你好世界".截取(1, 100))
    记录("截取(0, 2)（规范未定义）", "abc".截取(0, 2))
    记录("截取(4, 1) 起始越界（规范未定义）", "abc".截取(4, 1))
    记录("截取(-1, 2)（规范未定义）", "abc".截取(0 - 1, 2))

    // ───────── 查找（1 基；未找到 0）─────────
    检查("查找-命中首位置", "你好世界".查找("你好") == 1)
    检查("查找-命中中段", "你好世界".查找("世界") == 3)
    检查("查找-命中单字", "你好世界".查找("界") == 4)
    检查("查找-未找到返回0", "你好世界".查找("地球") == 0)
    检查("查找-空文本中查找", "".查找("a") == 0)
    检查("查找-空子串返回1", "abc".查找("") == 1)
    检查("查找-重复取首次", "aaa".查找("a") == 1)
    检查("查找-多字符跨字", "你好世界".查找("好世") == 2)
    检查("查找-emoji 位置", "a🙂b".查找("🙂") == 2)
    检查("查找-子串长于原文", "abc".查找("abcd") == 0)
    检查("查找-区分大小写", "AbC".查找("abc") == 0)

    // ───────── 替换（全部匹配；返回新文本）─────────
    检查("替换-单处", "你好世界".替换("世界", "朋友") == "你好朋友")
    检查("替换-多处全替换", "aaa".替换("a", "b") == "bbb")
    检查("替换-未命中保持原文", "abc".替换("x", "y") == "abc")
    检查("替换-替换为空串", "a-b-c".替换("-", "") == "abc")
    检查("替换-新旧相同", "abc".替换("b", "b") == "abc")
    检查("替换-中文替换英文", "我喜欢苹果".替换("苹果", "香蕉") == "我喜欢香蕉")
    原文甲 = "abcabc"
    替换后 = 原文甲.替换("a", "z")
    检查("替换-返回新文本", 替换后 == "zbczbc")
    检查("替换-原文本不变（文本不可变）", 原文甲 == "abcabc")

    // ───────── 分隔（返回数组<文本>）─────────
    分隔甲 = "苹果,香蕉,橙子".分隔(",")
    检查("分隔-元素个数", 分隔甲.长度() == 3)
    检查("分隔-首元素", 分隔甲[1] == "苹果")
    检查("分隔-中元素", 分隔甲[2] == "香蕉")
    检查("分隔-末元素", 分隔甲[3] == "橙子")
    // 规范未定义空文本分隔结果；实测与 JS/Python/Rust 一致：`"".split(",")` ⇒ `[""]`（长度 1）。
    // ⚠ 该结果经 `转文本` 显示为 `[]`（文本元素不带引号）⇒ 与真正的空数组不可区分，
    //   已登记为「容器内文本元素显示不带引号 vs 规范 §4.1/§4.3 示例带引号」待裁定项。
    空文本分隔 = "".分隔(",")
    记录("空文本分隔.长度()", 转文本(空文本分隔.长度()))
    检查("分隔-空文本得到单空串元素", 空文本分隔.长度() == 1 且 空文本分隔[1] == "")
    连续 = "a,,b".分隔(",")
    检查("分隔-连续分隔符保留空段", 连续.长度() == 3 且 连续[2] == "")
    首尾 = ",a,".分隔(",")
    检查("分隔-首尾分隔符保留空段", 首尾.长度() == 3 且 首尾[1] == "" 且 首尾[3] == "")
    检查("分隔-多字符分隔符", "a::b::c".分隔("::") == ["a", "b", "c"])
    检查("分隔-分隔符不存在返回单元素", "abc".分隔("x") == ["abc"])
    检查("分隔-中文分隔符", "甲乙|丙丁".分隔("|") == ["甲乙", "丙丁"])
    记录("分隔(空串) 的实际结果", 转文本("abc".分隔("")))

    // ───────── 是否包含 ─────────
    检查("是否包含-命中", "你好世界".是否包含("世界") == 真)
    检查("是否包含-未命中", "你好世界".是否包含("地球") == 假)
    检查("是否包含-空串恒真", "abc".是否包含("") == 真)
    检查("是否包含-空文本非空子串", "".是否包含("a") == 假)
    检查("是否包含-区分大小写", "AbC".是否包含("abc") == 假)
    检查("是否包含-中文", "智语言编程".是否包含("语言") == 真)

    // ───────── 去除空白（首尾；不折叠内部）─────────
    检查("去除空白-前后空格", "  你好  ".去除空白() == "你好")
    检查("去除空白-全空白变空", " \换行\制表 ".去除空白() == "")
    检查("去除空白-无空白保持", "你好".去除空白() == "你好")
    检查("去除空白-保留内部空格", "  你 好  ".去除空白() == "你 好")
    检查("去除空白-空文本", "".去除空白() == "")
    检查("去除空白-只去首", "  尾".去除空白() == "尾")
    检查("去除空白-只去尾", "首  ".去除空白() == "首")

    // ───────── 链式与组合 ─────────
    链式 = "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2)
    检查("链式-去空白→替换→截取", 链式 == "你好")
    检查("链式-长度接是否包含", "  中文  ".去除空白().是否包含("文") == 真)
    检查("链式-分隔后查找", "a,b,c".分隔(",").查找索引("b") == 2)

    // ───────── 位置语义（文本不支持下标访问，只能用 查找/截取 定位）─────────
    样本 = "0123456789"
    检查("位置-查找第1位", 样本.查找("0") == 1)
    检查("位置-查找第10位", 样本.查找("9") == 10)
    检查("位置-查找与截取一致", 样本.截取(样本.查找("9"), 1) == "9")

    收尾()
结束
