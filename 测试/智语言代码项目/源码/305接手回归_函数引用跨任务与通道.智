// 305 接手回归（第三轮）：函数引用跨任务、跨通道
// ══════════════════════════════════════════════════════════════════════════
//   一、函数引用经通道发送，接收方拿到的仍是可调用的函数 ——曾在跨线程转换时变成空值
//   二、任务捕获「函数参数」并在任务内调用 ——解释模式曾得到空值
//   三、数组/映射的 删除、清空 单线程语义不变（实现改为单次加锁）
// 判据：解释 + 编译 双模一致且全部通过。
// ══════════════════════════════════════════════════════════════════════════
导入 并发
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

加倍(整数 数) 整数:
    返回 数 * 2
结束

加十(整数 数) 整数:
    返回 数 + 10
结束

在任务里调用(函数(整数) 整数 处理, 整数 入参) 整数:
    子任务 = 并发.启动任务(函数() 整数:
        返回 处理(入参)
    结束)
    返回 并发.批量等待([子任务], 3000)[1]
结束

启动程序():
    输出("===== 一、函数引用经通道传递 =====")
    函数通道 = 并发.通道(2)
    函数通道.发送(加倍)
    函数通道.发送(加十)
    收到一 = 函数通道.接收()
    收到二 = 函数通道.接收()
    检查("通道收到的不是空值", 收到一 != 空值 且 收到二 != 空值)
    整数 结果一 = 0
    整数 结果二 = 0
    捕获:
        结果一 = 收到一(21)
        结果二 = 收到二(21)
    异常:
        结果一 = -1
    结束
    检查("收到的函数可调用且结果正确", 结果一 == 42 且 结果二 == 31)

    输出("===== 二、任务捕获函数参数 =====")
    整数 任务结果 = 0
    捕获:
        任务结果 = 在任务里调用(加倍, 8) + 在任务里调用(加十, 8)
    异常:
        任务结果 = -1
    结束
    检查("任务内调用捕获的函数参数", 任务结果 == 34)

    输出("===== 三、删除与清空语义 =====")
    列表 = [["甲"], ["乙"], ["丙"]]
    列表.删除(2)
    检查("数组删除第 2 项", 列表.长度() == 2 且 列表[1][1] == "甲" 且 列表[2][1] == "丙")
    列表.清空()
    检查("数组清空", 列表.长度() == 0)
    表 = {"一": [1], "二": [2]}
    表.删除("一")
    检查("映射删除", 表.包含("一") == 假 且 表.获取("二")[1] == 2)
    表.清空()
    检查("映射清空", 表.包含("二") == 假)

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
