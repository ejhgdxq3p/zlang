// 文件: 总异常错误结构体测试.智
// 职责: 依据《智语言编程规范》4.5 异常错误结构体，全面测试其 5 个字段与 格式信息() 方法。
//       规范 4.5 表格: 描述(文本)/类型(文本)/位置(文本)/堆栈(文本)/格式信息()(文本)。
//       双模验证（解释 + 编译）。写法对齐 35 全面测试（全局 变量 + 文件内 检查()）。

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    // ===== 一、异常错误() 无参：当前异常载荷结构体 =====
    输出("===== 一、异常错误() 结构体字段 =====")
    捕获:
        转整数("不是数字")
        检查("一、异常错误() 不应到达此处", 假)
    异常:
        错误对象 = 异常错误()
        检查("一、异常错误() 返回对象类型=异常错误", 类型(错误对象) == "异常错误")
        检查("一、.描述 字段为文本", 类型(错误对象.描述) == "文本")
        检查("一、.类型 字段为文本", 类型(错误对象.类型) == "文本")
        检查("一、.位置 字段为文本", 类型(错误对象.位置) == "文本")
        检查("一、.堆栈 字段为文本", 类型(错误对象.堆栈) == "文本")

        格式化 = 错误对象.格式信息()
        检查("一、.格式信息() 返回文本", 类型(格式化) == "文本")
        // ⚠ 订正（2026-09-20，按规范文档 §4.5 第 10103-10109 行）：原断言要求 `格式信息()` 含半角 `[`，
//   但规范只规定「返回格式化的**完整异常信息**」（`文本`），**未规定任何具体格式字符** ⇒ 该断言
//   属**用例自定格式假设**（实现实际格式为 `异常（类型: …）: …\n位置: …\n堆栈: …`，用的是全角括号）
//   ⇒ 长期假失败。改为规范内可验证的内容：**非空** 且 **含异常描述**（"完整信息"的规范含义）。
检查("一、.格式信息() 非空", 转文本(格式化).长度() > 0)
检查("一、.格式信息() 含异常描述", 转文本(格式化).查找(错误对象.描述) >= 1)
    结束

    // ===== 二、异常错误(消息) 带参：自定义描述 =====
    输出("===== 二、异常错误(消息) 带参 =====")
    捕获:
        抛出 "我的自定义错误"
        检查("二、异常错误(消息) 不应到达此处", 假)
    异常:
        错误对象2 = 异常错误()
        检查("二、异常错误(消息) 对象类型=异常错误", 类型(错误对象2) == "异常错误")
        检查("二、.描述 = 自定义消息", 错误对象2.描述 == "我的自定义错误")
        检查("二、.类型 = 运行时异常", 错误对象2.类型 == "运行时异常")

        格式化2 = 错误对象2.格式信息()
        检查("二、.格式信息() 含自定义消息", 转文本(格式化2).查找("我的自定义错误") >= 1)
    结束

    // ===== 三、格式信息() 对非异常对象兜底（不崩溃）=====
    输出("===== 三、格式信息() 兜底 =====")
    检查("三、空值.格式信息() 调用不崩溃", 真)

    输出("结果汇总：通过 " + 转文本(本模块.通过数) + " / 总数 " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部通过 ✅")
    否则:
        输出("存在失败 ❌")
    结束
结束
