启动程序():
    // 遍历内调用数组方法（数组.查找索引）
    命中 = 0
    数列 = [10, 20, 30]
    循环 值 遍历 数列:
        如果 数列.查找索引(值) > 0:
            命中 += 1
        结束
    结束
    检查("遍历内 数组.查找索引 全部命中=3", 命中 == 3)

