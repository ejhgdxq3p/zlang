// 覆盖《智语言编程规范》§2.4.2「映射」键白名单：**结构体作键**
//   规则：结构体可作键 ⟺ ① 未自定义 `等于` ② 所有字段都可就地编码为键（递归）
//   编码与 `==` 一致（实测：结构体 `==` 区分类型、逐字段递归）：
//     同类型同字段 ⇒ 同一个键；不同字段值 ⇒ 不同键；**跨结构体类型 ⇒ 不同键**；嵌套结构体递归
//   另验证：`.所有键()` 能把键还原为结构体实例；有约束映射 `映射<点, 文本>` 与跨函数传入均可用
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

结构体 点():
    横 = 0
    纵 = 0
结束

结构体 坐标():
    横 = 0
    纵 = 0
结束

结构体 线():
    起点 = 点()
    终点 = 点()
结束

跨函数查回(映射<点, 文本> 地, 点 键) 文本:
    // 🆕 2026-10-12：缺陷B（跨函数返回堆对象丢值）已修复 ⇒ 直接**返回取回值**。
    //   修复前此处只能写「返回 地.获取(键) == "九"」（函数内比较）以规避缺陷。
    返回 地.获取(键)
结束

启动程序():
    输出("=== 269 结构体作映射键（§2.4.2 键白名单）===")

    // ── 同类型同字段 ⇒ 同一个键（插入即覆盖）──
    地 = {}
    甲 = 点()
    甲.横 = 1
    甲.纵 = 2
    地.插入(甲, "旧")
    乙 = 点()
    乙.横 = 1
    乙.纵 = 2
    地.插入(乙, "新")
    检查("同类型同字段 ⇒ 同键（长度=1）", 地.长度() == 1)
    检查("同键后取回新值", 地.获取(乙) == "新")

    // ── 字段值不同 ⇒ 不同键 ──
    丙 = 点()
    丙.横 = 3
    地.插入(丙, "三")
    检查("不同字段值 ⇒ 不同键（长度=2）", 地.长度() == 2)
    检查("原键取值不受影响", 地.获取(甲) == "新")

    // ── 跨结构体类型 ⇒ 不同键（与 `==` 一致：点 == 坐标 为假）──
    跨 = {}
    跨.插入(点(), "点")
    跨.插入(坐标(), "坐标")
    检查("跨结构体类型同字段 ⇒ 不同键（长度=2）", 跨.长度() == 2)
    检查("点键取值正确", 跨.获取(点()) == "点")
    检查("坐标键取值正确", 跨.获取(坐标()) == "坐标")

    // ── 嵌套结构体键（字段递归编码）──
    嵌套 = {}
    线1 = 线()
    线1.起点.横 = 1
    线2 = 线()
    线2.起点.横 = 1
    线3 = 线()
    线3.起点.横 = 2
    嵌套.插入(线1, "甲线")
    嵌套.插入(线3, "乙线")
    检查("嵌套结构体键：不同值 ⇒ 不同键（长度=2）", 嵌套.长度() == 2)
    检查("嵌套结构体键：同值可查回", 嵌套.获取(线2) == "甲线")

    // ── `.所有键()` 把键还原为结构体实例 ──
    键列 = 地.所有键()
    检查("所有键长度=2", 键列.长度() == 2)
    检查("键还原为结构体实例（可读字段）", 键列[1].横 == 1)

    // ── 有约束映射 + 跨函数传入 ──
    映射<点, 文本> 约束地 = {}
    键 = 点()
    键.横 = 9
    约束地.插入(键, "九")
    检查("有约束映射 `映射<点,文本>` 结构体键可用", 约束地.长度() == 1)
    检查("结构体键经函数参数传入可查回", 跨函数查回(约束地, 键) == "九")

    // ── 渲染（结构体键按 `类型名（字段键…）`）──
    检查("转文本含结构体键类型名", 转文本(约束地).是否包含("点"))

    收尾()
结束
