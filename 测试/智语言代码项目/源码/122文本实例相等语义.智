// 122 文本实例相等语义 —— 规范 §2.6.8 一致性回归（**规范一致性门禁**首批载体）
// ══════════════════════════════════════════════════════════════════════════
// 判据（全部取自规范原文，不依赖双模对比 ⇒ 可发现"两引擎同错"）：
//   R7（§2.6.8:7709-7718）「`整数`、`小数`、**`文本`**、`逻辑`、`空值` | 直接比较值本身」
//                        「**基本类型的 `==` 和 `===` 行为相同** —— 值相等即实例相等」
//       例（7726-7729）：`文本1 = "你好"` / `文本2 = "你好"` ⇒ `文本1 === 文本2` → **真**
//   R8（§2.6.8:7353-7357）结构体：`坐标3 = 坐标1` ⇒ `坐标1 === 坐标3` → **假**（对象按实例身份）
//       数组/映射同理（`==` 递归比较内容；`===` 比较是否同一实例）
//
// 历史：实现曾把 `文本`（运行期为 `标签_句柄`）也按**句柄身份**比较 ⇒
//       ① `甲 = "你好"; 丙 = 甲; 甲 === 丙` 为假（规范要求真）；
//       ② 两引擎共用同一 opcode↔base 单表 ⇒ **同错** ⇒ 全量双模门禁查不出来。
//       ⇒ 本用例即为补上该盲区（阶段 0.6 修复的验收载体）。
// ══════════════════════════════════════════════════════════════════════════
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 坐标():
    整数 横 = 0
    整数 纵 = 0
结束

启动程序():
    // ① R7 核心：值语义派生（赋值）之后，文本 `===` 必须仍为真
    甲 = "你好"
    丙 = 甲
    检查("文本 === 派生值（值语义）", 甲 === 丙)
    检查("文本 == 派生值", 甲 == 丙)

    // ② R7：两个独立字面量（不同对象）⇒ 仍按值相等（规范原文示例）
    文本1 = "你好"
    文本2 = "你好"
    检查("文本 === 同值字面量", 文本1 === 文本2)

    // ③ 内容不同 ⇒ 假（不能退化成恒真）
    丁 = "你好世界"
    检查("文本 === 不同内容为假", 非 (文本1 === 丁))
    检查("文本 !== 不同内容为真", 文本1 !== 丁)

    // ④ R7：**派生同值文本**（拼接/转换产生，intern 覆盖不到）⇒ 必须值相等
    戊 = "你" + "好"
    检查("文本 === 拼接同值", 戊 === 文本1)
    己 = 转文本(5)
    庚 = "5"
    检查("文本 === 转换同值", 己 === 庚)

    // ⑤ R8：对象类型保持**实例身份**（本次修复不得误伤）
    坐标1 = 坐标()
    坐标2 = 坐标1
    检查("结构体 == 值相等", 坐标1 == 坐标2)
    检查("结构体 === 不同实例为假", 非 (坐标1 === 坐标2))
    检查("结构体 === 自身为真", 坐标1 === 坐标1)

    数组1 = [1, 2, 3]
    数组2 = [1, 2, 3]
    检查("数组 == 值相等（递归元素）", 数组1 == 数组2)
    检查("数组 === 不同实例为假", 非 (数组1 === 数组2))
    检查("数组 === 自身为真", 数组1 === 数组1)

    // ⑥ 空值（基本类型）⇒ `===` 与 `==` 同（规范 §2.4.5 5449-5461）
    空甲 = 空值
    空乙 = 空值
    检查("空值 === 空值", 空甲 === 空乙)

    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        抛出 "文本实例相等语义存在失败项"
    结束
结束
