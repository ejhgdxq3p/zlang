// ============================================================
// 标准库 深层专项测试（全面测试 + 问题思考与解决）
// 聚焦 35/36/37 未充分覆盖的深层点：
//   1. 嵌套映射（已知架构限制：第二层键返回空值）
//   2. 文本.分隔 多字符分隔符 / 连续分隔符 / 首尾空段
//   3. 数组.排序 文本数组升序 / 已排序不变
//   4. 映射.所有键/所有值 返回类型与内容
//   5. 时间.休眠 实际耗时下限 + 计时器差值
//   6. 异常错误(消息) 描述精确值
//   7. 类型() 对结构体/数组/映射 返回值
// 全部用例用 检查() 统计，末行输出汇总。双模验证。
// ============================================================

导入 时间
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    // ===================== 一、嵌套映射 =====================
    输出("===== 一、嵌套映射 =====")
    外层 = {"用户": {"姓名": "张三", "年龄": 28}, "计数": 3}
    检查("嵌套映射 顶层键存在", 外层.是否包含("用户"))
    检查("嵌套映射 顶层计数=3", 转整数(外层.获取("计数")) == 3)
    内层 = 外层.获取("用户")
    检查("嵌套映射 取内层是映射", 类型(内层) == "映射")
    // 已知架构限制验证：第二层键经 任意 包装可能返回空值
    内层姓名 = 内层.获取("姓名")
    输出("    [观察] 内层.获取(姓名)=" + 转文本(内层姓名) + " 类型=" + 类型(内层姓名))
    检查("嵌套映射 第二层姓名=张三(预期,若架构限制则记SKIP)", 转文本(内层姓名) == "张三")
    检查("嵌套映射 第二层年龄=28", 转整数(内层.获取("年龄")) == 28)

    // ===================== 二、文本.分隔 边界 =====================
    输出("===== 二、文本.分隔 边界 =====")
    多字符 = "苹果##香蕉##橙子".分隔("##")
    检查("分隔 多字符分隔符 长度=3", 多字符.长度() == 3)
    检查("分隔 多字符[2]=香蕉", 多字符[2] == "香蕉")
    连续 = "a,,b".分隔(",")
    检查("分隔 连续分隔符 长度=3", 连续.长度() == 3)
    检查("分隔 连续分隔符[2]=空", 连续[2] == "")
    首尾空 = ",x,".分隔(",")
    检查("分隔 首尾空段 长度=3", 首尾空.长度() == 3)
    检查("分隔 首尾空段[1]=空", 首尾空[1] == "")
    检查("分隔 首尾空段[2]=x", 首尾空[2] == "x")
    单段 = "hello".分隔(",")
    检查("分隔 无分隔符 长度=1", 单段.长度() == 1)
    检查("分隔 无分隔符[1]=hello", 单段[1] == "hello")

    // ===================== 三、数组.排序 文本 =====================
    输出("===== 三、数组.排序 文本 =====")
    文本数组 = ["橙子", "苹果", "香蕉"]
    文本数组.排序()
    检查("排序 文本数组 长度=3", 文本数组.长度() == 3)
    // 规范定义"升序排序"，未规定中文拼音序；实现按 UTF-8 字节序（确定性）
    检查("排序 文本数组[1]=橙子(UTF-8字节序)", 文本数组[1] == "橙子")
    检查("排序 文本数组[2]=苹果(UTF-8字节序)", 文本数组[2] == "苹果")
    检查("排序 文本数组[3]=香蕉(UTF-8字节序)", 文本数组[3] == "香蕉")
    已排序 = [1, 2, 3, 4]
    已排序.排序()
    检查("排序 已升序不变[1]=1", 已排序[1] == 1)
    检查("排序 已升序不变[4]=4", 已排序[4] == 4)
    混合 = [3, 1, 2, 5, 4]
    混合.排序()
    检查("排序 混合[1]=1", 混合[1] == 1)
    检查("排序 混合[5]=5", 混合[5] == 5)

    // ===================== 四、映射.所有键/所有值 =====================
    输出("===== 四、映射.所有键/所有值 =====")
    配置 = {"主机": "localhost", "端口": 8080, "启用": 真}
    键数组 = 配置.所有键()
    检查("所有键 长度=3", 键数组.长度() == 3)
    检查("所有键 返回数组类型", 类型(键数组) == "数组")
    值数组 = 配置.所有值()
    检查("所有值 长度=3", 值数组.长度() == 3)
    检查("所有值 含 localhost", 值数组.是否包含("localhost"))
    检查("所有值 含 8080", 值数组.是否包含(8080))

    // ===================== 五、时间.休眠 与 计时器 =====================
    输出("===== 五、时间.休眠 与 计时器 =====")
    开始 = 时间.获取计时器()
    时间.休眠(1000)
    结束计时 = 时间.获取计时器()
    耗时 = 结束计时 - 开始
    输出("    [观察] 休眠1000毫秒 计时器差值=" + 转文本(耗时) + " 毫秒")
    检查("休眠(1000) 耗时>=900毫秒", 耗时 >= 900)
    检查("休眠(1000) 耗时<2000毫秒", 耗时 < 2000)

    // ===================== 六、异常错误(消息) =====================
    输出("===== 六、异常错误 =====")
    捕获:
        抛出 异常错误("精确消息测试")
    异常:
        错误 = 异常错误()
        检查("异常错误 描述=精确消息测试", 错误.描述 == "精确消息测试")
        检查("异常错误 类型名=异常错误", 类型(错误) == "异常错误")
    结束

    // ===================== 七、类型() 各类值 =====================
    输出("===== 七、类型() 各类值 =====")
    检查("类型(整数字面)=整数", 类型(7) == "整数")
    检查("类型(小数字面)=小数", 类型(2.5) == "小数")
    检查("类型(文本字面)=文本", 类型("abc") == "文本")
    检查("类型(逻辑字面)=逻辑", 类型(真) == "逻辑")
    检查("类型(空值)=空值", 类型(空值) == "空值")
    检查("类型(数组)=数组", 类型([1, 2]) == "数组")
    检查("类型(映射)=映射", 类型({"a": 1}) == "映射")

    输出("")
    输出("===== 标准库深层专项测试汇总 =====")
    输出("总数=" + 转文本(本模块.总数) + " 通过=" + 转文本(本模块.通过数) + " 失败=" + 转文本(本模块.失败数))
结束
