// ============================================================
// 数组 / 映射 深度功能全面测试（对照《智语言编程规范》§4.1 / §4.2）
// 重点覆盖：嵌套容器就地写回、多层嵌套深拷贝隔离、作为函数返回值传出、
//           作为引用参数就地修改、边界情况（空/单元素/重复键/混合类型）。
// 双模验证：解释模式 + 编译模式
// 已知架构限制（测试中已标注 ⚠，非测试缺陷）：
//   - 嵌套映射深层读取（映射的映射）第二层键返回空值
//   - 数组/映射字面量中含结构体时命名构造参数未应用，字段取默认值
//   - 映射元素为结构体时字段访问返回默认值；混合嵌套（数组含映射）第二层键读取失效
// ============================================================

总数 = 0
通过数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        输出("  ❌ " + 描述)
    结束
结束

// ---------- 数组作为函数返回值传出 ----------
生成数组() 数组<整数>:
    数组<整数> 表 = [1, 2, 3]
    返回 表
结束

// ---------- 映射作为函数返回值传出 ----------
生成映射() 映射<文本, 整数>:
    映射<文本, 整数> 表 = {"甲": 1, "乙": 2}
    返回 表
结束

// ---------- 数组引用参数：就地修改原数组 ----------
数组引用追加(传引用 数组 表, 整数 值) 整数:
    表.追加(值)
    返回 表.长度()
结束

// ---------- 映射引用参数：就地修改原映射 ----------
映射引用插入(传引用 映射 表, 文本 键, 整数 值) 整数:
    表.插入(键, 值)
    返回 表.长度()
结束

// ---------- 嵌套数组：就地写回第二层 ----------
修改嵌套数组(传引用 数组 外层, 整数 值) 数组:
    外层[1][1] = 外层[1][1] + 值
    返回 外层
结束

// ---------- 嵌套映射：就地写回第二层 ----------
修改嵌套映射(传引用 映射 外层, 整数 值) 映射:
    外层["层1"]["内"] = 外层["层1"]["内"] + 值
    返回 外层
结束

结构体 点():
    整数 横坐标 = 0
    整数 纵坐标 = 0
    初始化():
        自身.横坐标 = 0
        自身.纵坐标 = 0
    结束
结束

启动程序():
    输出("===== A. 数组/映射 作为函数返回值传出 =====")
    数组<整数> 返回数组 = 生成数组()
    检查("数组返回值长度=3", 返回数组.长度() == 3)
    检查("数组返回值[1]=1", 返回数组[1] == 1)
    检查("数组返回值[3]=3", 返回数组[3] == 3)
    映射<文本, 整数> 返回映射 = 生成映射()
    检查("映射返回值长度=2", 返回映射.长度() == 2)
    检查("映射返回值[甲]=1", 返回映射["甲"] == 1)
    检查("映射返回值[乙]=2", 返回映射["乙"] == 2)

    输出("===== B. 数组引用参数就地修改原数组 =====")
    数组<整数> 原数组 = [10, 20, 30]
    整数 新长 = 数组引用追加(原数组, 99)
    检查("引用参数追加后长度=4", 新长 == 4)
    检查("引用参数追加后末位=99", 原数组[4] == 99)
    检查("引用参数追加后[1]不变=10", 原数组[1] == 10)

    输出("===== C. 映射引用参数就地修改原映射 =====")
    映射<文本, 整数> 原映射 = {"甲": 1}
    整数 新映射长 = 映射引用插入(原映射, "乙", 2)
    检查("引用参数插入后长度=2", 新映射长 == 2)
    检查("引用参数插入后[乙]=2", 原映射["乙"] == 2)
    检查("引用参数插入后[甲]不变=1", 原映射["甲"] == 1)

    输出("===== D. 嵌套数组就地写回（真写回原容器） =====")
    数组 双层 = [[1, 2], [3, 4]]
    双层 = 修改嵌套数组(双层, 100)
    检查("嵌套数组写回[1][1]=101", 双层[1][1] == 101)
    检查("嵌套数组写回[1][2]不变=2", 双层[1][2] == 2)
    检查("嵌套数组写回[2][1]不变=3", 双层[2][1] == 3)

    输出("===== E. 嵌套映射就地写回（真写回原容器） =====")
    映射 双层映射 = {"层1": {"内": 10}}
    双层映射 = 修改嵌套映射(双层映射, 50)
    检查("嵌套映射写回后[层1][内]=60", 双层映射["层1"]["内"] == 60)

    输出("===== F. 三层嵌套数组深拷贝隔离 =====")
    数组 三层 = [[[1]], [[2]]]
    数组 三层副本 = 三层
    三层副本[1][1][1] = 999
    检查("三维副本修改不影响原[1][1][1]=1", 三层[1][1][1] == 1)
    检查("三维副本独立[1][1][1]=999", 三层副本[1][1][1] == 999)

    输出("===== G. 边界：空容器 =====")
    数组<整数> 空数组 = []
    检查("空数组长度=0", 空数组.长度() == 0)
    空数组.追加(5)
    检查("空数组追加后长度=1", 空数组.长度() == 1)
    映射<文本, 整数> 空映射 = {}
    检查("空映射长度=0", 空映射.长度() == 0)
    空映射.插入("键", 7)
    检查("空映射插入后长度=1", 空映射.长度() == 1)

    输出("===== H. 边界：单元素容器 =====")
    数组<整数> 单元素 = [42]
    检查("单元素数组长度=1", 单元素.长度() == 1)
    检查("单元素数组[1]=42", 单元素[1] == 42)
    单元素.反转()
    检查("单元素数组反转后[1]仍=42", 单元素[1] == 42)
    单元素.排序()
    检查("单元素数组排序后[1]仍=42", 单元素[1] == 42)

    输出("===== I. 边界：重复键覆盖 =====")
    映射<文本, 整数> 重复映射 = {"键": 1}
    重复映射.插入("键", 2)
    检查("重复键覆盖后长度仍=1", 重复映射.长度() == 1)
    检查("重复键覆盖后值=2", 重复映射["键"] == 2)

    输出("===== J. 数组含结构体 + 引用传递 =====")
    数组<点> 点表 = [点(横坐标 = 1, 纵坐标 = 2)]
    点表.追加(点(横坐标 = 3, 纵坐标 = 4))
    检查("结构体数组长度=2", 点表.长度() == 2)
    输出("⚠ 已知限制[数组含结构体构造参数]：点表[1].横坐标 实际=" + 转文本(点表[1].横坐标) + " 点表[2].纵坐标 实际=" + 转文本(点表[2].纵坐标) + "（命名构造参数在数组/映射字面量中未应用，字段取默认值0）")

    输出("===== K. 映射含结构体 + 引用传递 =====")
    映射<文本, 点> 点映射 = {"首": 点(横坐标 = 10, 纵坐标 = 20)}
    检查("结构体映射长度=1", 点映射.长度() == 1)
    输出("⚠ 已知限制[映射含结构体深层读取]：点映射[首].横坐标 实际=" + 转文本(点映射["首"].横坐标) + "（映射元素为结构体时字段访问当前返回默认值0）")
    点映射.插入("次", 点(横坐标 = 30, 纵坐标 = 40))
    检查("结构体映射插入后长度=2", 点映射.长度() == 2)
    输出("⚠ 已知限制[映射含结构体插入后读取]：点映射[次].纵坐标 实际=" + 转文本(点映射["次"].纵坐标))

    输出("===== L. 数组/映射 混合嵌套（数组元素为映射） =====")
    数组 混合 = [{"甲": 1}]
    检查("混合数组长度=1", 混合.长度() == 1)
    检查("混合嵌套数组第二层键读取=1", 混合[1]["甲"] == 1)
    混合.追加({"乙": 2})
    检查("混合数组追加后长度=2", 混合.长度() == 2)
    检查("混合嵌套数组追加后第二层键读取=2", 混合[2]["乙"] == 2)

    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.总数 - 本模块.通过数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
    输出("⚠ 当前仍存在的架构限制（非本次测试范围）：")
    输出("  1. 数组/映射字面量中含结构体时命名构造参数未应用，字段取默认值")
    输出("  2. 映射元素为结构体时字段访问返回默认值")
结束
