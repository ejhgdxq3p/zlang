// 规范 §2.9.2：聚合导入（别名形式）后访问 —— 全部「自定义类型」成员
//   别名形式 ⇒ 子命名空间改为 型库（原模块名 类型库 失效，另由负向用例守护）
//   覆盖：枚举 / 接口 / 结构体（字段 + 方法 + 结构体作参数）/ 结构体方法返回容器

导入 聚合校验/类型_别名 展开

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== §2.9 聚合导入 · 成员类型覆盖（自定义类型）=====")

    // —— 枚举 ——
    检查("枚举 上 != 下", 型库.型方向.上 != 型库.型方向.下)
    检查("枚举 上 == 上", 型库.型方向.上 == 型库.型方向.上)

    // —— 接口：经接口变量访问方法（适配接口的结构体）——
    型库.型可命名 形容 = 型库.型点(3, 4)
    检查("接口 名称()=点(3,4)", 形容.名称() == "点(3,4)")

    // —— 结构体：实例化 + 字段 + 方法 ——
    型库.型点 点 = 型库.型点(5, 6)
    检查("结构体 字段 横=5", 点.横 == 5)
    检查("结构体 字段 纵=6", 点.纵 == 6)
    检查("结构体 方法 名称()=点(5,6)", 点.名称() == "点(5,6)")

    // —— 结构体：容器字段 + 方法返回容器 ——
    型库.型容器盒 盒 = 型库.型容器盒([7, 8, 9])
    检查("结构体 容器字段 长度=3", 盒.数据.长度() == 3)
    检查("结构体 容器字段 总量=24", 盒.总量() == 24)
    检查("结构体 方法返回容器 [3]=9", 盒.取数据()[3] == 9)
    检查("结构体 映射字段 计数(甲)=1", 盒.计数.获取("甲") == 1)

    // —— 结构体：方法写字段并返回（值语义下返回值正确）——
    检查("结构体 方法改名 返回新名", 盒.改名("新盒") == "新盒")

    // —— 结构体作函数参数 ——
    检查("结构体作参数 型盒总量=24", 型库.型盒总量(盒) == 24)

    // —— 接口变量接收结构体后，再与具体类型方法交叉验证 ——
    型库.型可命名 另一个 = 型库.型点(8, 9)
    检查("第二个接口实例 名称()=点(8,9)", 另一个.名称() == "点(8,9)")

    // —— 接口作函数参数（按接口类型分派到具体结构体方法）——
    检查("接口作参数 型描述=点(3,4)", 型库.型描述(形容) == "点(3,4)")
    检查("接口作参数 第二个实例", 型库.型描述(另一个) == "点(8,9)")

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
