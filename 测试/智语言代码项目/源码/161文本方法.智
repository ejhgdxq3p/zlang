// 规范 §4.2 文本方法（共 7 个）：位置从 1 开始；查找未找到返回 0
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 161 文本方法 ===")
    消息 = "你好世界"
    空白消息 = "   你好   "
    多行消息 = "苹果,香蕉,橙子,葡萄"
    // ① 长度
    检查("长度-中文按字符计", 消息.长度() == 4)
    检查("长度-空文本", "".长度() == 0)
    检查("长度-含空白", 空白消息.长度() == 8)
    // ② 截取（起始, 长度）——起始从 1 开始
    检查("截取-从1取2", 消息.截取(1, 2) == "你好")
    检查("截取-从3取2", 消息.截取(3, 2) == "世界")
    检查("截取-取到末尾", 消息.截取(3, 2) == "世界")
    检查("截取-整串", 消息.截取(1, 4) == "你好世界")
    // ③ 查找（未找到返回 0）
    检查("查找-命中返回1基位置", 消息.查找("世界") == 3)
    检查("查找-未找到返回0", 消息.查找("地球") == 0)
    检查("查找-首字符", 消息.查找("你") == 1)
    // ④ 替换
    检查("替换-命中", 消息.替换("世界", "朋友") == "你好朋友")
    检查("替换-未命中保持原样", 消息.替换("地球", "朋友") == "你好世界")
    // ⑤ 分隔
    水果数组 = 多行消息.分隔(",")
    检查("分隔-元素个数", 水果数组.长度() == 4)
    检查("分隔-首元素", 水果数组[1] == "苹果")
    检查("分隔-末元素", 水果数组[4] == "葡萄")
    // ⑥ 是否包含
    检查("是否包含-真", 消息.是否包含("你好") == 真)
    检查("是否包含-假", 消息.是否包含("再见") == 假)
    // ⑦ 去除空白
    检查("去除空白-首尾", 空白消息.去除空白() == "你好")
    // 链式调用
    结果 = "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2)
    检查("链式调用", 结果 == "你好")
    收尾()
结束
