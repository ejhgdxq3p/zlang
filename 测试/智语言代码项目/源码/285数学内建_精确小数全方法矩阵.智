// 《智语言编程规范》§5.1.11 精确小数结构体 —— 全方法矩阵（双模）
// 覆盖：构造与显示规则 1~8、四则与整除/取余、幂、取负/绝对值/平方根/保留小数、
//       判定（正/负/零/为整数/符号值）、六种比较、最大最小、三种转换、科学计数法、
//       与整数/文本混合、异常路径（除零/非法文本/空文本）。
// 说明：`整除` 按规范返回 **整数**（示例 `转文本(甲.整除(乙))`）；`%%=` 返回 **精确小数**。
导入 数学

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 285 精确小数全方法矩阵（§5.1.11）===")

    // ── 规则 7：转文本保留小数位数、不去尾零 ──
    相等文本("转文本 3", 数学.精确小数("3").转文本(), "3")
    相等文本("转文本 3.0", 数学.精确小数("3.0").转文本(), "3.0")
    相等文本("转文本 3.50", 数学.精确小数("3.50").转文本(), "3.50")
    相等文本("转文本 3.00", 数学.精确小数("3.00").转文本(), "3.00")
    相等文本("转文本 -0.5 负号保留", 数学.精确小数("-0.5").转文本(), "-0.5")
    相等文本("转文本 零保留两位", 数学.精确小数("0.00").转文本(), "0.00")
    相等文本("转文本 整数构造", 数学.精确小数(10).转文本(), "10")
    相等文本("小数构造经转文本再解析", 数学.精确小数(0.3).转文本(), "0.3")
    检查("类型(精确小数) = 精确小数", 类型(数学.精确小数(1)) == "精确小数")

    // ── 加法/减法：对齐到较大小数位 ──
    相等文本("0.1 + 0.2 = 0.3（浮点做不到）", (数学.精确小数("0.1") + 数学.精确小数("0.2")).转文本(), "0.3")
    相等文本("19.99 + 3 对齐两位", (数学.精确小数("19.99") + 3).转文本(), "22.99")
    相等文本("1.00 - 0.90 = 0.10", (数学.精确小数("1.00") - 数学.精确小数("0.90")).转文本(), "0.10")
    相等文本("0.1 + 0.02 对齐两位", (数学.精确小数("0.1") + 数学.精确小数("0.02")).转文本(), "0.12")
    相等文本("减法取负结果", (数学.精确小数("3") - 数学.精确小数("5")).转文本(), "-2")

    // ── 乘法：小数位相加（超 28 位舍入）──
    相等文本("1.5 * 2 小数位 1", (数学.精确小数("1.5") * 数学.精确小数("2")).转文本(), "3.0")
    相等文本("19.99 * 3 = 59.97", (数学.精确小数("19.99") * 3).转文本(), "59.97")
    相等文本("0.1 * 0.1 = 0.01", (数学.精确小数("0.1") * 数学.精确小数("0.1")).转文本(), "0.01")
    相等文本("乘法超 28 位舍入到零", (数学.精确小数("0.0000000000000000000000000001") * 数学.精确小数("0.0000000000000000000000000001")).转文本(), "0.0000000000000000000000000000")

    // ── 除法：四舍五入保留 28 位（规则 3）──
    相等文本("1 / 3 保留 28 位", (数学.精确小数("1") / 数学.精确小数("3")).转文本(), "0.3333333333333333333333333333")
    相等文本("10 / 4 = 2.5000…（28 位）", (数学.精确小数("10") / 数学.精确小数("4")).转文本(), "2.5000000000000000000000000000")

    // ── 整除：规范返回 **整数**，向下取整 ──
    检查("整除返回整数类型", 类型(数学.精确小数("10").整除(数学.精确小数("3"))) == "整数")
    检查("10 整除 3 = 3", 数学.精确小数("10").整除(数学.精确小数("3")) == 3)
    检查("-11 整除 3 = -4（向负无穷）", 数学.精确小数("-11").整除(数学.精确小数("3")) == (0 - 4))
    检查("规范示例 转文本(甲.整除(乙)) 可用", 转文本(数学.精确小数("10").整除(数学.精确小数("3"))) == "3")
    // `%%` 运算符按规范 §5.1.11 运算符表映射到 `整除` ⇒ 同样返回整数；`%%=` 映射到 `整除赋值` ⇒ 仍为精确小数
    检查("%% 运算符返回整数", 类型(数学.精确小数("10") %% 数学.精确小数("3")) == "整数")
    检查("%% 运算符值 = 3", 数学.精确小数("10") %% 数学.精确小数("3") == 3)
    整除甲 = 数学.精确小数("10")
    整除甲 %%= 数学.精确小数("3")
    检查("%%= 后仍为精确小数（原地语义）", 类型(整除甲) == "精确小数")
    相等文本("%%= 结果文本", 整除甲.转文本(), "3")

    // ── 取余：非负（欧几里得）──
    相等文本("-11 取余 3 = 1", (数学.精确小数("-11") % 数学.精确小数("3")).转文本(), "1")
    相等文本("11 取余 -3 非负", (数学.精确小数("11") % 数学.精确小数("-3")).转文本(), "2")
    相等文本("10 取余 3 = 1", (数学.精确小数("10") % 数学.精确小数("3")).转文本(), "1")

    // ── 幂：正指数重复乘、负指数取倒数 ──
    相等文本("2 ^ 10 = 1024", (数学.精确小数("2") ^ 10).转文本(), "1024")
    相等文本("9 ^ 0 = 1", (数学.精确小数("9") ^ 0).转文本(), "1")
    相等文本("2 ^ -1 倒数 28 位", (数学.精确小数("2") ^ (0 - 1)).转文本(), "0.5000000000000000000000000000")
    相等文本("2 ^ -2 四分之一", (数学.精确小数("2") ^ (0 - 2)).转文本(), "0.2500000000000000000000000000")

    // ── 取负/绝对值/平方根/保留小数 ──
    相等文本("取负 3.5", 数学.精确小数("3.5").取负().转文本(), "-3.5")
    相等文本("绝对值 -3.5", 数学.精确小数("-3.5").绝对值().转文本(), "3.5")
    相等文本("平方根 16 保留 28 位", 数学.精确小数("16").平方根().转文本(), "4.0000000000000000000000000000")
    相等文本("保留小数 2.345 → 2.35（四舍五入）", 数学.精确小数("2.345").保留小数(2).转文本(), "2.35")
    相等文本("保留小数 2.5 → 3（到整数位）", 数学.精确小数("2.5").保留小数(0).转文本(), "3")
    相等文本("保留小数 0 位去掉小数点", 数学.精确小数("3.7").保留小数(0).转文本(), "4")

    // ── 判定 ──
    检查("3 是否正数", 数学.精确小数("3").是否正数() == 真)
    检查("-3 是否负数", 数学.精确小数("-3").是否负数() == 真)
    检查("0 是否为零", 数学.精确小数("0").是否为零() == 真)
    检查("3 是否为整数（小数位 0）", 数学.精确小数("3").是否为整数() == 真)
    检查("3.0 不是整数（小数位 1）", 数学.精确小数("3.0").是否为整数() == 假)
    检查("符号值 -5 = -1", 数学.精确小数("-5").符号值() == (0 - 1))
    检查("符号值 0 = 0", 数学.精确小数("0").符号值() == 0)
    检查("符号值 5 = 1", 数学.精确小数("5").符号值() == 1)

    // ── 六种比较：忽略小数位数差异 ──
    检查("1.0 等于 1.00（忽略 scale）", 数学.精确小数("1.0") == 数学.精确小数("1.00"))
    检查("1.0 不等于 1.01", 数学.精确小数("1.0") != 数学.精确小数("1.01"))
    检查("2.5 大于 2.49", 数学.精确小数("2.5") > 数学.精确小数("2.49"))
    检查("2.49 小于 2.5", 数学.精确小数("2.49") < 数学.精确小数("2.5"))
    检查("2.50 大于等于 2.5", 数学.精确小数("2.50") >= 数学.精确小数("2.5"))
    检查("2.50 小于等于 2.5", 数学.精确小数("2.50") <= 数学.精确小数("2.5"))

    // ── 最大/最小 ──
    相等文本("最大值取较大（保留其 scale）", 数学.精确小数("2.5").最大值(数学.精确小数("2.50")).转文本(), "2.50")
    相等文本("最小值取较小", 数学.精确小数("-1").最小值(数学.精确小数("3")).转文本(), "-1")

    // ── 转换 ──
    检查("转小数 3.50 = 3.5", 数学.精确小数("3.50").转小数() == 3.5)
    检查("转整数 3.99 = 3（向零）", 数学.精确小数("3.99").转整数() == 3)
    检查("转整数 -3.99 = -3（向零）", 数学.精确小数("-3.99").转整数() == (0 - 3))
    相等文本("科学计数法 12345 有效 3 位", 数学.精确小数("12345").科学计数法(3), "1.23e+4")
    相等文本("科学计数法默认 6 位", 数学.精确小数("12345").科学计数法(), "1.23450e+4")
    相等文本("科学计数法负指数", 数学.精确小数("0.001234").科学计数法(3), "1.23e-3")

    // ── 混合运算：整数/文本自动规整（规则 5）──
    相等文本("与整数混合加", (数学.精确小数("3.50") + 5).转文本(), "8.50")
    相等文本("与文本混合加", (数学.精确小数("3.50") + "1.5").转文本(), "5.00")
    相等文本("与整数乘法", (数学.精确小数("1.25") * 4).转文本(), "5.00")

    // ── 异常：除零/取余零/非法文本；空文本返回空值（规则 1）──
    捕获:
        零商 = 数学.精确小数("1") / 数学.精确小数("0")
        检查("除零必须抛异常", 假)
    异常:
        检查("除零抛异常且描述含除数为零", 异常错误().描述.是否包含("除数不能为零"))
    结束

    捕获:
        零余 = 数学.精确小数("1") % 数学.精确小数("0")
        检查("取余零必须抛异常", 假)
    异常:
        检查("取余零抛异常", 异常错误().描述.是否包含("除数不能为零"))
    结束

    捕获:
        零整 = 数学.精确小数("1").整除(数学.精确小数("0"))
        检查("整除零必须抛异常", 假)
    异常:
        检查("整除零抛异常", 异常错误().描述.是否包含("除数不能为零"))
    结束

    捕获:
        非法 = 数学.精确小数("abc")
        检查("非法文本必须抛异常", 假)
    异常:
        检查("非法文本异常类型为精确小数错误", 异常错误().类型 == "精确小数错误")
        检查("非法文本描述指明不是合法十进制数字", 异常错误().描述.是否包含("不是合法的十进制数字"))
    结束

    检查("空文本构造失败返回空值", 类型(数学.精确小数("")) == "空值")

    收尾()
结束
