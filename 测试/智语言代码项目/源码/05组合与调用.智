// ============================================================
// 结构体组合与结构体间调用测试
// 覆盖规范：一个结构体包含另一结构体实例作为字段(组合)、
//          一个结构体方法内部创建并调用另一个结构体实例(结构体间调用)
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 被组合的结构体 ──
结构体 地址(文本 省份, 文本 城市, 文本 详细地址):
    获取完整地址() 文本:
        返回 省份 + "省" + 城市 + "市" + 详细地址
    结束
结束

结构体 联系方式(文本 电话, 文本 邮箱):
    获取联系方式() 文本:
        返回 "电话：" + 电话 + "，邮箱：" + 邮箱
    结束
结束

// ── 组合：完整用户内嵌 地址 与 联系方式 实例 ──
结构体 完整用户(文本 姓名, 整数 年龄):
    私有 地址 地址信息 = 地址("广东", "深圳", "南山区")
    私有 联系方式 联系信息 = 联系方式("13800138000", "z@example.com")
    设置地址(文本 省份, 文本 城市, 文本 详细地址):
        自身.地址信息 = 地址(省份, 城市, 详细地址)
    结束
    设置联系方式(文本 电话, 文本 邮箱):
        自身.联系信息 = 联系方式(电话, 邮箱)
    结束
    获取完整信息() 文本:
        信息 = "姓名：" + 姓名 + "，年龄：" + 转文本(年龄)
        如果 自身.地址信息 != 空值:
            信息 += "，地址：" + 自身.地址信息.获取完整地址()
        结束
        如果 自身.联系信息 != 空值:
            信息 += "，" + 自身.联系信息.获取联系方式()
        结束
        返回 信息
    结束
结束

// ── 结构体间调用：订单系统方法内创建并调用 订单 实例 ──
结构体 订单(文本 商品, 小数 价格):
    获取描述() 文本:
        返回 商品 + " 价格" + 转文本(价格)
    结束
结束

结构体 订单系统():
    查询(文本 商品) 文本:
        新订单 = 订单(商品, 99.0)
        返回 新订单.获取描述()
    结束
    创建订单(文本 商品, 小数 价格) 订单:
        返回 订单(商品, 价格)
    结束
结束

// ── 测试 ──
测试_结构体组合():
    用户 = 完整用户("张三", 28)
    检查("组合-默认地址已内嵌", 用户.获取完整信息().查找("南山区") > 0)
    用户.设置地址("北京", "朝阳", "建国路1号")
    用户.设置联系方式("13900000000", "zhang@e.com")
    信息 = 用户.获取完整信息()
    检查("组合-设置地址生效", 信息.查找("北京省朝阳市建国路1号") > 0)
    检查("组合-设置联系方式生效", 信息.查找("13900000000") > 0)
    检查("组合-姓名年龄正确", 信息.查找("张三") > 0)
结束

测试_结构体间调用():
    订单管理器 = 订单系统()
    // ⚠ 修订（2026-09-19，按规范文档）：价格字段类型为 `小数`，而规范 §5.1.2 要求小数文本化
    //   **去尾零但至少保留一位小数**（`转文本(99.0) == "99.0"`，权威用例 `147 小数显示与格式化科学计数法`）。
    //   故期望值应为 `99.0` / `5.0` 而不再是 `99` / `5`（原断言系过期期望）。
    检查("结构体间调用-查询返回描述", 订单管理器.查询("书") == "书 价格99.0")
    笔订单 = 订单管理器.创建订单("笔", 5.0)
    检查("结构体间调用-创建订单返回可调用", 笔订单.获取描述() == "笔 价格5.0")
结束

// ── 主入口 ──
启动程序():
    输出("========== 结构体组合与结构体间调用测试 ==========")
    测试_结构体组合()
    测试_结构体间调用()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
