// ============================================================
// ZZ 文本静态判等专项（编译模式 文本_静态 漏判回归）
// 目的：编译模式把字符串字面量编进二进制作为 文本_静态（静态指针），
//       凡"按内容判等/键转换"若漏判 文本_静态 组合，会在编译模式误判。
//       本测试覆盖所有相关场景，解释/编译双模必须一致全绿。
// 覆盖：
//   ① 数组.是否包含(文本字面量)            —— 系统调用 94
//   ② 映射.包含(文本字面量键)              —— 键转换 值转键
//   ③ 映射[文本字面量键] 存取              —— 键转换 值转键
//   ④ == 对文本字面量（含 文本_静态 vs 文本）—— 运行时值::等于
//   ⑤ 属于/不属于 文本字面量               —— 数组映射包含→深度相等
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    // ① 数组.是否包含 文本字面量（编译模式 文本_静态 vs 堆 文本）
    文字集 = ["丙", "甲", "乙"]
    检查("数组.是否包含(字面量甲)", 文字集.是否包含("甲"))
    检查("数组.是否包含(字面量乙)", 文字集.是否包含("乙"))
    检查("数组.是否包含(字面量丙)", 文字集.是否包含("丙"))
    检查("数组.是否包含(字面量丁_应假)", 文字集.是否包含("丁") == 假)

    // 排序后是否包含（此前 bug 场景）
    排序集 = ["丙", "甲", "乙"]
    排序集.排序()
    检查("排序后 含甲", 排序集.是否包含("甲"))
    检查("排序后 含乙", 排序集.是否包含("乙"))
    检查("排序后 含丙", 排序集.是否包含("丙"))

    // ② 映射.包含 文本字面量键
    映射表 = {"甲": 1, "乙": 2, "丙": 3}
    检查("映射.包含(字面量甲键)", 映射表.包含("甲"))
    检查("映射.包含(字面量乙键)", 映射表.包含("乙"))
    检查("映射.包含(字面量丁_应假)", 映射表.包含("丁") == 假)

    // ③ 映射[文本字面量键] 存取
    查甲 = 映射表["甲"]
    查乙 = 映射表["乙"]
    检查("映射[字面量甲键]取值", 查甲 == 1)
    检查("映射[字面量乙键]取值", 查乙 == 2)

    // 写入后再查（写入键也是字面量）
    映射表["丁"] = 4
    检查("映射[字面量丁键]写入后包含", 映射表.包含("丁"))
    检查("映射[字面量丁键]写入后取值", 映射表["丁"] == 4)

    // ④ == 对文本字面量（文本_静态 vs 文本_静态 / 文本_静态 vs 文本）
    甲字面量1 = "甲"
    甲字面量2 = "甲"
    检查("文本字面量 == 字面量", 甲字面量1 == 甲字面量2)
    检查("文本字面量 == 堆文本", 甲字面量1 == 文字集[2])   // 数组1-based: 文字集[2] 是堆 文本"甲"
    检查("文本字面量 != 不同文本", 甲字面量1 == "乙" == 假)

    // ⑤ 属于/不属于 文本字面量
    检查("文本字面量 属于 数组", "甲" 属于 文字集)
    检查("文本字面量 不属于 数组(丁)", "丁" 属于 文字集 == 假)

    输出("")
    输出("文本静态判等专项: 总数=" + 转文本(本模块.总数) + " 通过=" + 转文本(本模块.通过数) + " 失败=" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("结果: 存在失败")
    否则:
        输出("结果: 全部通过")
    结束
结束
