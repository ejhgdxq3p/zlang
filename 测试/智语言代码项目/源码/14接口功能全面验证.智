// ============================================================
// 接口功能全面验证（对照用户接口规范，双模验证）
// 覆盖：
//   A. 接口定义（公开 / 私有）
//   B. 适配单 / 多接口
//   C. 接口作函数参数（方法修改作用于原实例）
//   D. 接口数组批量（值复制 + 元素写回槽位）
//   E. 接口返回值（函数返回接口 / 返回结构体）
//   F. 接口变量赋值（标签复制）
//   G. 多接口方法选择（同一结构体不同接口方法）
//   H. 接口方法带参数 / 返回值
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ───────────────── 接口与结构体定义 ─────────────────
接口 可移动:
    移动(速度):
    结束
    停止():
    结束
    当前速度() 小数:
    结束
结束

接口 可打印:
    打印信息():
    结束
    获取描述() 文本:
    结束
结束

私有 接口 内部处理器:
    处理():
    结束
结束

结构体 汽车(文本 品牌) 适配 可移动:
    速度 = 0
    移动(新速度):
        自身.速度 = 新速度
        输出(品牌 + "加速到" + 转文本(自身.速度))
    结束
    停止():
        自身.速度 = 0
        输出(品牌 + "已停止")
    结束
    当前速度() 小数:
        返回 自身.速度
    结束
结束

结构体 智能设备(文本 名称) 适配 可打印, 可移动:
    文本 名称 = 名称
    速度 = 0
    位置 = "原点"
    打印信息():
        输出("设备：" + 自身.名称 + "，位置：" + 自身.位置 + "，速度：" + 转文本(自身.速度))
    结束
    获取描述() 文本:
        返回 自身.名称 + "智能设备，当前位置" + 自身.位置
    结束
    移动(新速度):
        自身.速度 = 新速度
        自身.位置 = "移动中"
        输出(自身.名称 + "移动速度：" + 转文本(自身.速度))
    结束
    停止():
        自身.速度 = 0
        自身.位置 = "静止"
        输出(自身.名称 + "已停止")
    结束
    当前速度() 小数:
        返回 自身.速度
    结束
结束

// 适配 内部处理器（私有接口）的结构体，验证私有接口可正常适配
结构体 本地处理器 适配 内部处理器:
    计数 = 0
    处理():
        自身.计数 = 自身.计数 + 1
        输出("处理第" + 转文本(自身.计数) + "次")
    结束
结束

// ───────────────── 接口作函数参数 ─────────────────
测试移动(可移动 设备, 小数 速度):
    输出("开始测试移动...")
    设备.移动(速度)
    输出("当前速度：" + 转文本(设备.当前速度()))
    设备.停止()
    输出("测试完成")
结束

批量打印(数组<可打印> 设备列表):
    循环 设备 遍历 设备列表:
        设备.打印信息()
        输出(设备.获取描述())
        输出("---")
    结束
结束

// 返回接口类型：工厂返回适配了可移动的结构体
制造汽车() 可移动:
    新车 = 汽车("出厂车")
    返回 新车
结束

// 返回结构体类型
制造智能设备() 智能设备:
    新设备 = 智能设备("出厂设备")
    返回 新设备
结束

// ───────────────── 主程序 ─────────────────
启动程序():
    输出("===== A/B 接口定义与适配 =====")
    我的汽车 = 汽车("奔驰")
    我的设备 = 智能设备("机器人A")
    另一个设备 = 智能设备("无人机B")
    检查("结构体可适配（字段可读）", 我的汽车.速度 == 0)
    检查("多接口结构体字段可读", 我的设备.位置 == "原点")

    输出("===== C 接口作函数参数 =====")
    测试移动(我的汽车, 120)
    // 通过接口参数修改应作用于原实例
    检查("接口参数方法修改作用于原实例", 我的汽车.速度 == 0)
    测试移动(我的设备, 5)
    检查("多接口结构体经可移动参数修改", 我的设备.位置 == "静止")
    检查("多接口结构体速度归零", 我的设备.速度 == 0)

    输出("===== D 接口数组批量（值复制 + 元素写回槽位） =====")
    车甲 = 汽车("车甲")
    车乙 = 汽车("车乙")
    车甲.移动(30)
    数组<可移动> 列表 = [可移动 车甲, 可移动 车乙]
    列表[1].移动(99)
    检查("数组元素接收者修改（双模写回槽位）", 列表[1].当前速度() == 99)
    检查("原实例不受影响（值复制：标签≠数据）", 车甲.当前速度() == 30)
    可移动 元素 = 列表[1]
    元素.移动(55)
    检查("接口变量=数组元素：标签贴在槽位实例", 元素.当前速度() == 55)
    检查("元素修改写回数组槽位", 列表[1].当前速度() == 55)
    检查("车甲仍独立", 车甲.当前速度() == 30)
    列表[2].移动(77)
    检查("列表[2]独立修改", 列表[2].当前速度() == 77)
    检查("车乙不受影响", 车乙.当前速度() == 0)

    输出("===== E 接口返回值 =====")
    出厂车 = 制造汽车()
    出厂车.移动(40)
    检查("工厂返回接口可调用方法", 出厂车.当前速度() == 40)
    出厂设备 = 制造智能设备()
    出厂设备.移动(10)
    检查("工厂返回结构体可调用方法", 出厂设备.当前速度() == 10)
    检查("工厂返回结构体字段可读", 出厂设备.位置 == "移动中")

    输出("===== F 接口变量赋值（标签复制） =====")
    可移动 设备一 = 车甲
    设备一.移动(88)
    检查("接口变量设备一贴在车甲", 车甲.当前速度() == 88)
    可移动 设备二 = 设备一
    设备二.移动(66)
    检查("接口变量互赋=复制标签", 车甲.当前速度() == 66)
    检查("设备一标签同步", 设备一.当前速度() == 66)

    输出("===== G 多接口方法选择 =====")
    可打印 打印机 = 我的设备
    打印机.打印信息()
    描述文本 = 打印机.获取描述()
    检查("通过可打印接口调用正确方法", 描述文本 == "机器人A智能设备，当前位置静止")
    可移动 移动器 = 我的设备
    移动器.移动(3)
    检查("通过可移动接口调用正确方法（不影响可打印字段位置语义）", 移动器.当前速度() == 3)

    输出("===== H 私有接口适配 =====")
    处理器 = 本地处理器()
    处理器.处理()
    检查("私有接口适配可调用", 处理器.计数 == 1)

    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("❌ 存在失败用例")
    否则:
        输出("✅ 全部通过")
    结束
结束
