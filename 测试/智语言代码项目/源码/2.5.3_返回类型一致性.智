启动程序():
    检查("整数返回", 取整数() == 7)
    检查("整数→小数（唯一隐式转换）", 取小数() == 7)
    检查("文本返回", 取文本() == "文本")
    检查("逻辑返回", 取逻辑() == 真)
    检查("结构体返回", 造点().横 == 3)
    检查("接口适配返回", 造接口().描述() == "圆")
    检查("可空任意返回-有值", 取可空(1) == "张三")
    检查("可空任意返回-空值", 取可空(2) == 空值)
    检查("捕获内返回（除法结果为小数）", 安全除(10, 2) == 5.0)
    检查("始终在返回路径执行", 本模块.步骤 == "始终")
    盒子()
    检查("初始化裸返回合法", 真)
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
