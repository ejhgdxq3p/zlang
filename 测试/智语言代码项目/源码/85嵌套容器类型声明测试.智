// 测试 规范第 1356-1358 行「嵌套容器」：
//   数组<数组<整数>> 矩阵 = [[1,2,3], [4,5,6]]
//   映射<文本, 数组<整数>> 班级分数 = {"一班": [90, 85]}
// 并覆盖「嵌套容器显式声明省略初始化 ⇒ 默认 []」（规范第 1523-1526 行）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  PASS " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  FAIL " + 名称)
    结束
结束

启动程序():
    // ── 一、嵌套数组：声明 + 初始化 ──
    数组<数组<整数>> 矩阵 = [[1, 2, 3], [4, 5, 6]]
    检查("嵌套数组 外层长度", 矩阵.长度() == 2)
    检查("嵌套数组 内层长度", 矩阵[1].长度() == 3)
    检查("嵌套数组 元素取值", 矩阵[2][3] == 6)
    检查("嵌套数组 元素取值二", 矩阵[1][1] == 1)

    // ── 二、嵌套映射-数组：声明 + 初始化 ──
    映射<文本, 数组<整数>> 班级分数 = {"一班": [90, 85]}
    检查("嵌套映射数组 取值", 班级分数["一班"][2] == 85)
    检查("嵌套映射数组 内层长度", 班级分数["一班"].长度() == 2)

    // ── 三、嵌套容器省略初始化 ⇒ 默认 [] ──
    数组<数组<整数>> 空矩阵
    检查("嵌套数组 默认长度0", 空矩阵.长度() == 0)
    空矩阵.追加([7, 8])
    检查("嵌套数组 可追加(证明是空数组非空值)", 空矩阵.长度() == 1)
    检查("嵌套数组 追加后可读", 空矩阵[1][2] == 8)

    映射<文本, 数组<整数>> 空成绩表
    检查("嵌套映射 默认长度0", 空成绩表.长度() == 0)
    空成绩表.插入("二班", [70, 75])
    检查("嵌套映射 可插入", 空成绩表["二班"][1] == 70)

    // ── 四、嵌套容器可写回 ──
    矩阵[2][1] = 44
    检查("嵌套数组 深层写回", 矩阵[2][1] == 44)

    输出("通过数 = " + 转文本(本模块.通过数) + " / 总数 = " + 转文本(本模块.总数))
结束
