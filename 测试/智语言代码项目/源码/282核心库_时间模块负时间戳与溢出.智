// 274 的边界补充：负时间戳（1970 之前）、加减溢出、间隔天数截断、解析容错（规范 §5.4）
// 2026-10-19 实测修复项（本用例同时是护栏）：
//   ① 负时间戳格式化/分量曾用「向零截断」⇒ -1 秒被算成 1970-01-01 00:00:-1 ✗
//   ② 时间.加/减 溢出曾「解释模式 panic、编译模式回绕」✗ ⇒ 现抛可捕获异常（双模一致）
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

启动程序():
    输出("=== 282 时间模块负时间戳与溢出 ===")

    // ───────── 负时间戳：格式化与分量必须与正时间戳同一日历 ─────────
    检查("负戳--1 秒 = 1969-12-31 23:59:59", 时间.格式化("年-月-日 时:分:秒", 0 - 1) == "1969-12-31 23:59:59")
    检查("负戳--86400 秒 = 1969-12-31 00:00:00", 时间.格式化("年-月-日 时:分:秒", 0 - 86400) == "1969-12-31 00:00:00")
    检查("负戳-纪元零点仍为 1970-01-01", 时间.格式化("年-月-日", 0) == "1970-01-01")
    检查("负戳--1 秒 年=1969", 时间.获取年(0 - 1) == 1969)
    检查("负戳--1 秒 月=12", 时间.获取月(0 - 1) == 12)
    检查("负戳--1 秒 日=31", 时间.获取日(0 - 1) == 31)
    检查("负戳--1 秒 时=23", 时间.获取时(0 - 1) == 23)
    检查("负戳--1 秒 分=59", 时间.获取分(0 - 1) == 59)
    检查("负戳--1 秒 秒=59", 时间.获取秒(0 - 1) == 59)
    检查("负戳--1 秒 星期=3（周三）", 时间.获取星期(0 - 1) == 3)
    检查("负戳-分量与格式化自洽", 转文本(时间.获取年(0 - 86400)) + "-" + 转文本(时间.获取月(0 - 86400)) == "1969-12")

    // ───────── 闰年与世纪年 ─────────
    检查("闰年-2024-02-29", 时间.格式化("年-月-日", 时间.解析("2024-02-29", "年-月-日")) == "2024-02-29")
    检查("闰年-2000-02-29（400 年闰）", 时间.格式化("年-月-日", 时间.解析("2000-02-29", "年-月-日")) == "2000-02-29")
    // 2026-10-19 收口：非法日历日**不再静默规整**（旧行为 1900-02-29 → 1900-03-01），
    //   与「13 月 / 32 日 抛异常」口径统一 ⇒ 非闰年 2 月 29 日必须解析失败。
    捕获:
        时间.解析("1900-02-29", "年-月-日")
        检查("非闰年 1900-02-29 应抛异常", 假)
    异常:
        检查("非闰年 1900-02-29 抛异常", 真)
    结束

    // ───────── 加减：溢出必须抛可捕获异常（不得 panic / 回绕）─────────
    捕获:
        时间.加(9223372036854775807, 1)
        检查("加减-加溢出应抛异常", 假)
    异常:
        检查("加减-加溢出抛异常", 真)
        检查("加减-加溢出异常类型非空", 异常错误().类型.长度() > 0)
    结束
    捕获:
        时间.减(0 - 9223372036854775807 - 1, 1)
        检查("加减-减溢出应抛异常", 假)
    异常:
        检查("加减-减溢出抛异常", 真)
    结束
    检查("加减-正常加不受影响", 时间.加(1704112496, 3600) == 1704116096)
    检查("加减-正常减不受影响", 时间.减(1704116096, 3600) == 1704112496)
    检查("加减-加0不变", 时间.加(1704112496, 0) == 1704112496)
    检查("加减-减0不变", 时间.减(1704112496, 0) == 1704112496)

    // ───────── 间隔天数：向零截断（-23h ⇒ 0、-24h ⇒ -1）─────────
    检查("间隔天数-0", 时间.间隔天数(100000, 100000) == 0)
    检查("间隔天数-86399 秒为0", 时间.间隔天数(86399, 0) == 0)
    检查("间隔天数-86400 秒为1", 时间.间隔天数(86400, 0) == 1)
    检查("间隔天数--86399 秒为0", 时间.间隔天数(0 - 86399, 0) == 0)
    检查("间隔天数--86400 秒为-1", 时间.间隔天数(0 - 86400, 0) == 0 - 1)
    检查("间隔天数-172800 秒为2", 时间.间隔天数(172800, 0) == 2)
    检查("间隔天数-两端顺序敏感", 时间.间隔天数(0, 86400) == 0 - 1)

    // ───────── 解析：容错与往返 ─────────
    检查("解析-补零日期往返", 时间.格式化("年-月-日", 时间.解析("2024-01-05", "年-月-日")) == "2024-01-05")
    检查("解析-单数字月日（容错）", 时间.格式化("年-月-日", 时间.解析("2024-1-5", "年-月-日")) == "2024-01-05")
    检查("解析-斜杠分隔", 时间.格式化("年-月-日", 时间.解析("2024/01/05", "年-月-日")) == "2024-01-05")
    检查("解析-带时分秒", 时间.解析("2024-01-01 12:34:56", "年-月-日 时:分:秒") == 1704112496)
    检查("解析-纯数字视为时间戳", 时间.解析("1704112496", "年-月-日") == 1704112496)
    检查("解析-负数字时间戳", 时间.解析("-1", "年-月-日") == 0 - 1)
    捕获:
        时间.解析("完全不是日期", "年-月-日")
        检查("解析-非法文本抛异常", 假)
    异常:
        检查("解析-非法文本抛异常", 真)
    结束
    捕获:
        时间.解析("2024-13-01", "年-月-日")
        检查("解析-13 月抛异常", 假)
    异常:
        检查("解析-13 月抛异常", 真)
    结束

    // ───────── 格式化：占位符替换规则 ─────────
    检查("格式化-重复占位符全部替换", 时间.格式化("年年", 0) == "19701970")
    检查("格式化-未知字符原样", 时间.格式化("纯文本", 0) == "纯文本")
    检查("格式化-混合占位与文字", 时间.格式化("第年 年", 0) == "第1970 1970")
    检查("格式化-月日补零", 时间.格式化("月-日", 时间.解析("2024-03-05", "年-月-日")) == "03-05")
    检查("格式化-时分秒补零", 时间.格式化("时:分:秒", 时间.解析("2024-01-01 01:02:03", "年-月-日 时:分:秒")) == "01:02:03")

    // ───────── 计时器 / 休眠 ─────────
    起 = 时间.获取计时器()
    时间.休眠(5)
    止 = 时间.获取计时器()
    检查("计时器-休眠后前进≥4ms", 止 - 起 >= 4)
    检查("计时器-非负", 起 >= 0)

    // ───────── 当前时间与毫秒时间关系 ─────────
    秒 = 时间.当前时间()
    毫 = 时间.当前毫秒时间()
    差 = 毫 - 秒 * 1000
    检查("当前时间-毫秒与秒一致（±5秒）", 差 > 0 - 5000 且 差 < 5000)

    收尾()
结束
