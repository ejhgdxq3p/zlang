// 规范 §2.4.7：`初始化` 离开结构体后可自由使用（模块顶层可定义同名函数 ✓）
初始化():
    输出("普通函数：初始化")
结束

// ⚠ 字段名与参数名**不同名**：本轮实测发现缺陷 F17 —— 「同名参数 + `初始化` 读 `自身.字段`」
//   会读到**空值** ✗（最小复现见《裁决文档·F17》）；本用例只验证"上下文关键字自由度" ✓，
//   不覆盖该缺陷（待 F17 修复后另立用例 ✓）
结构体 订单(文本 名称):
    文本 订单名称 = 名称
    初始化():
        自身.订单名称 = 自身.订单名称 + "（已初始化）"
    结束
    取名称() 文本:
        返回 自身.订单名称
    结束
结束

测试_上下文关键字():
    // 函数内部可作变量名 ✓
    初始化 = 100
    检查("函数内 初始化 可作变量名", 初始化 == 100)

    // 启动程序 在函数内部可作变量名 ✓
    启动程序 = "局部名字"
    检查("函数内 启动程序 可作变量名", 启动程序 == "局部名字")

    // 结构体内 初始化 仍是生命周期方法（唯一保留位置 ✓）
    // ⚠ 不验证"显式调用 实例.初始化()"：规范只授予"在结构体内定义生命周期方法"这一用途 ✓
    //   （实测显式调用报「结构体【订单】没有方法【初始化】」⇒ 属未授予能力，不作规范一致性断言 ✓）
    单 = 订单("订单甲")
    检查("结构体 初始化 生命周期生效", 单.取名称() == "订单甲（已初始化）")
结束

启动程序():
    测试_上下文关键字()
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
