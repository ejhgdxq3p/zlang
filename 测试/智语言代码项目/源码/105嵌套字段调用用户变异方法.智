// 正向回归（2026-09-21 · COW 退役）：**经字段/元素调用用户自定义变异方法**在全部场景一致生效。
//
//   历史限制（代码内曾明确记载「行不通，勿重复尝试」/用例内标注「实测不生效」）：
//     `初始化()` 内 `自身.部件.设名("x")` —— 用户变异方法无返回值，其（COW 分离产生的）新句柄
//     无法传回调用方 ⇒ 修改丢失；同一写法在普通方法内 / 从外部调用"生效"（当时属计数=1 的巧合）。
//   真根因：**引用计数虚高触发 COW 误分离**（接口/字段来源的存储合法产生 count>1）。
//   ⇒ COW 退役后（隔离改由「存储即深拷贝」构造性承担），本类问题**整族消失**，
//     无需任何"写回机制"、无需用户改写法、亦无需"方法返回自身"。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 内件():
    文本 名 = "默认"
    设名(文本 新名):
        自身.名 = 新名
    结束
    取名() 文本:
        返回 自身.名
    结束
结束

结构体 外件():
    内件 部件 = 内件()
    初始化():
        自身.部件.设名("初始化设")
    结束
    改():
        自身.部件.设名("方法内设")
    结束
结束

启动程序():
    甲 = 外件()
    检查("初始化内-经嵌套字段调用", 甲.部件.取名() == "初始化设")

    乙 = 外件()
    乙.部件.设名("外部设")
    检查("外部-经嵌套字段调用", 乙.部件.取名() == "外部设")

    丙 = 外件()
    丙.改()
    检查("普通方法内-经嵌套字段调用", 丙.部件.取名() == "方法内设")

    丁 = 外件()
    临时 = 丁.部件
    临时.设名("显式写回设")
    丁.部件 = 临时
    检查("变量中介+显式写回（值语义）", 丁.部件.取名() == "显式写回设")

    戊 = 内件()
    戊.设名("变量直调")
    检查("变量直调", 戊.取名() == "变量直调")

    // 容器元素接收者（值语义，原地生效）
    己 = [内件()]
    己[1].设名("元素内调用")
    检查("数组元素-用户变异方法", 己[1].取名() == "元素内调用")

    // 三层嵌套字段链
    庚 = 层层容器()
    庚.中.内.设名("三层设")
    检查("三层字段链-用户变异方法", 庚.中.内.取名() == "三层设")

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

结构体 中层容器():
    内件 内 = 内件()
结束

结构体 层层容器():
    中层容器 中 = 中层容器()
结束
