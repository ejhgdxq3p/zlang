// C2 验证：命名参数跳过中间参数 / 乱序 / 跳过末尾默认值
// 正确语法：函数名(形参) 返回类型: 体 结束 （无大括号）

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

建用户(文本 姓名, 整数 年龄 = 18, 文本 城市 = "未知") 文本:
    返回 姓名 + "-" + 转文本(年龄) + "-" + 城市
结束

计算(整数 基数, 整数 乘 = 2, 整数 加 = 0) 整数:
    返回 基数 * 乘 + 加
结束

启动程序():
    // 场景1：跳过中间参数（年龄有默认），仅提供姓名+城市
    结果1 = 建用户("张三", 城市 = "上海")
    检查("跳过中间参数(年龄默认18)", 结果1 == "张三-18-上海")

    // 场景2：命名参数乱序
    结果2 = 建用户(城市 = "北京", 姓名 = "李四")
    检查("命名参数乱序(北京/李四)", 结果2 == "李四-18-北京")

    // 场景3：跳过末尾默认（仅提供必需参数）
    结果3 = 建用户("王五")
    检查("跳过末尾默认", 结果3 == "王五-18-未知")

    // 场景4：计算函数混合位置+命名跳过
    结果4 = 计算(10, 加 = 5)        // 基数=10, 乘默认2, 加=5 → 25
    检查("混合跳过中间(10*2+5=25)", 结果4 == 25)
    结果5 = 计算(加 = 3, 基数 = 7)   // 乱序：7*2+3=17
    检查("乱序+默认(7*2+3=17)", 结果5 == 17)

    // 场景5：必填参数缺失应在编译期报错
    检查("以上命名参数用例全部执行", 真)

    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
