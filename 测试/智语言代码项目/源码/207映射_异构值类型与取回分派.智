// 207 映射字面量**异构值**的类型推断与取回分派（F30 修复的常驻护栏，2026-10-02）
//
// 背景（**F30 真实缺陷，已修**，双模一致、**静默错值** ✗）：
//   映射字面量的**值类型原先只按"首对"推断** ✗ ⇒ 异构字面量（如 `{"甲": {…}, "丙": [1, 2, 3]}`）
//   的值类型被推成**首对的类型**（映射 ✗）⇒ 之后取回的**数组**被按「映射」做**静态方法分派** ⇒
//   `.长度()` 读到映射槽位 ⇒ **恒 0** ✗、`.是否包含()` 恒假 ✗、`.查找索引()` 恒 0 ✗，
//   而 `类型()`=数组 ✓、`索引`/`.取末尾()`/`转文本` **全部正确** ✓ ⇒ 「数据本体完好、只有长度类查询读错」✓。
//   判据：**把键顺序换成"数组在前"即恢复正常** ✓、标量在首也正常 ✓、同构（全数组）始终正常 ✓。
//
// 修复：`语义/类型推断.rs` 与 `模块加载器.rs`（模块级字面量走后者 ✓）两处映射字面量分支改为
//   **全对求统一类型** —— 全部相同 ⇒ 用该类型 ✓；出现不同 ⇒ **未推断** ⇒ 取回值走**运行时按实际类型分派** ✓。
通过数 = 0
失败数 = 0
总数 = 0

// 模块级异构映射（专门覆盖 `模块加载器.rs` 那条路径 ✓）
模块异构 = {"甲": {"乙": 1}, "丙": [11, 22, 33]}

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 207 映射异构值类型与取回分派（F30 护栏）===")

    // ① 核心形态：映射值在首 + 数组在后（修复前 ⇒ 长度 0 ✗）
    异构 = {"甲": {"乙": 1}, "丙": [1, 2, 3]}
    检查("异构 取回值 类型 = 数组", 类型(异构.获取("丙")) == "数组")
    检查("异构 取回数组 .长度() = 3（修复前恒 0 ✗）", 异构.获取("丙").长度() == 3)
    检查("异构 .是否包含(2) = 真（修复前恒假 ✗）", 异构.获取("丙").是否包含(2))
    检查("异构 .查找索引(2) = 2（修复前恒 0 ✗）", 异构.获取("丙").查找索引(2) == 2)
    检查("异构 .查找索引(9) = 0（未找到 ✓）", 异构.获取("丙").查找索引(9) == 0)
    检查("异构 索引[2] = 2（本就正常 ✓）", 异构.获取("丙")[2] == 2)
    检查("异构 转文本 = [1, 2, 3]", 转文本(异构.获取("丙")) == "[1, 2, 3]")
    检查("异构 取回映射仍正常（.长度() = 1）", 异构.获取("甲").长度() == 1)
    检查("异构 取回映射 继续取值 = 1", 异构.获取("甲").获取("乙") == 1)

    // ② 对照：同构 / 顺序调换 / 标量在首 / 三键异构
    同构 = {"甲": [1, 2], "丙": [7, 8, 9]}
    检查("同构（全数组）长度 = 3", 同构.获取("丙").长度() == 3)
    顺序甲 = {"丙": [1, 2, 3], "甲": {"乙": 1}}
    检查("数组在首 长度 = 3", 顺序甲.获取("丙").长度() == 3)
    标量首 = {"甲": 1, "丙": [1, 2, 3]}
    检查("标量在首 长度 = 3", 标量首.获取("丙").长度() == 3)
    三键 = {"甲": {"乙": 1}, "丙": [1, 2, 3], "戊": 9}
    检查("三键异构 长度 = 3（修复前 0 ✗）", 三键.获取("丙").长度() == 3)
    检查("三键异构 取标量 = 9", 三键.获取("戊") == 9)
    检查("三键异构 取映射 = 1", 三键.获取("甲").获取("乙") == 1)

    // ③ 局部变量中转（静态类型不再被首对误导 ✓）
    取回 = 异构.获取("丙")
    检查("局部中转 类型 = 数组", 类型(取回) == "数组")
    检查("局部中转 长度 = 3", 取回.长度() == 3)

    // ④ 模块级异构映射（覆盖 模块加载器.rs 的推断路径 ✓）
    检查("模块级异构 长度 = 3", 本模块.模块异构.获取("丙").长度() == 3)
    检查("模块级异构 是否包含(22)", 本模块.模块异构.获取("丙").是否包含(22))
    检查("模块级异构 取映射 = 1", 本模块.模块异构.获取("甲").获取("乙") == 1)

    // ⑤ 写入后再取回（插入路径本就正常 ✓，此处作回归对照）
    插入映射 = {}
    插入映射.插入("甲", {"乙": 1})
    插入映射.插入("丙", [4, 5, 6])
    检查("插入路径 长度 = 3", 插入映射.获取("丙").长度() == 3)

    // ⑥ 取末尾会在异构映射上正确"取出并移除"（自洽性 ✓）
    自洽 = {"甲": {"乙": 1}, "丙": [1, 2, 3]}
    末尾值 = 自洽.获取("丙").取末尾()
    检查("取末尾 = 3", 末尾值 == 3)
    检查("取末尾后长度 = 2", 自洽.获取("丙").长度() == 2)

    收尾()
结束
