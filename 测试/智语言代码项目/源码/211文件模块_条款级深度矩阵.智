// 211 文件模块**条款级深度矩阵**：规范 §5.2（15 个函数）
//
// 分工：既有 `48文件与系统模块全面测试` 已覆盖"每个函数能跑通"的广度 ✓；
// 本用例专攻**条款语义的精确性**与**边界**：
//   · §5.2 读取：文件不存在 ⇒ 抛异常（不返回空串）
//   · §5.2 写入：**覆盖**原有内容（不是追加）；目标目录不存在 ⇒ 抛异常
//   · §5.2 追加：追加到末尾；不存在时创建（规范未明写 ⇒ 只记录）
//   · §5.2 获取大小：**字节**数（中文 UTF-8 一个字 3 字节）
//   · §5.2 是否存在：文件 / 目录 皆真；不存在假
//   · §5.2 是目录 / 是文件：互斥
//   · §5.2 遍历目录：**列出目录下所有文件和子目录名**（只名字，不带路径前缀）
//   · §5.2 删除目录：**空目录**可删；非空目录规范未定义 ⇒ 只记录
//   · §5.2 重命名：**文件或目录**都可
//   · §5.2 获取当前目录 / 切换目录：切换生效、`..` 可回
//   · 中文路径 / 中文内容 / 空文件 / 覆盖截断 / 换行保留
//
// 临时目录：./测试临时211_<进程号>/（结束前清理干净）
导入 文件
导入 系统

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

启动程序():
    输出("=== 211 文件模块 条款级深度矩阵 ===")
    根 = "./测试临时211_" + 转文本(系统.获取进程编号())
    原目录 = 文件.获取当前目录()

    // ───────────── ① §5.2 目录创建与基本查询 ─────────────
    输出("-- ① 目录创建 / 三类路径查询 --")
    文件.创建目录(根)
    检查("创建目录后 是否存在=真", 文件.是否存在(根) == 真)
    检查("创建目录后 是目录=真", 文件.是目录(根) == 真)
    检查("创建目录后 是文件=假", 文件.是文件(根) == 假)
    文件.写入(根 + "/甲.txt", "内容甲")
    检查("文件 是否存在=真", 文件.是否存在(根 + "/甲.txt") == 真)
    检查("文件 是文件=真", 文件.是文件(根 + "/甲.txt") == 真)
    检查("文件 是目录=假", 文件.是目录(根 + "/甲.txt") == 假)
    检查("不存在的路径 是否存在=假", 文件.是否存在(根 + "/没有这个.txt") == 假)
    检查("不存在的路径 是文件=假", 文件.是文件(根 + "/没有这个.txt") == 假)
    检查("不存在的路径 是目录=假", 文件.是目录(根 + "/没有这个.txt") == 假)

    // ───────────── ② §5.2 写入是覆盖语义 ─────────────
    输出("-- ② 写入=覆盖（不是追加）--")
    覆盖文件 = 根 + "/覆盖.txt"
    文件.写入(覆盖文件, "AAAAAAAA")
    检查("首次写入 大小=8 字节", 文件.获取大小(覆盖文件) == 8)
    文件.写入(覆盖文件, "BB")
    检查("二次写入后 读取=BB（旧内容被覆盖）", 文件.读取(覆盖文件) == "BB")
    检查("二次写入后 大小=2 字节（截断而非原地覆盖）", 文件.获取大小(覆盖文件) == 2)

    // ───────────── ③ §5.2 追加 ─────────────
    输出("-- ③ 追加 --")
    追加文件 = 根 + "/追加.txt"
    文件.写入(追加文件, "甲")
    文件.追加(追加文件, "乙")
    检查("写入甲+追加乙 ⇒ 甲乙", 文件.读取(追加文件) == "甲乙")
    检查("追加后 大小=6 字节（两汉字）", 文件.获取大小(追加文件) == 6)
    文件.追加(追加文件, "\换行丙")
    检查("追加换行保留", 文件.读取(追加文件) == "甲乙" + "\换行" + "丙")
    文件.追加(根 + "/新建追加.txt", "自动建")
    检查("追加不存在文件 ⇒ 创建成功（记录项）", 文件.是否存在(根 + "/新建追加.txt") == 真)
    记录("追加不存在文件后的读取值", 文件.读取(根 + "/新建追加.txt"))

    // ───────────── ④ §5.2 获取大小 = 字节数 ─────────────
    输出("-- ④ 获取大小=字节数 --")
    空文件 = 根 + "/空.txt"
    文件.写入(空文件, "")
    检查("空文件 大小=0", 文件.获取大小(空文件) == 0)
    检查("空文件 读取=空文本", 文件.读取(空文件) == "")
    文件.写入(根 + "/中文.txt", "中文甲乙")
    检查("四汉字 大小=12 字节（UTF-8 三字节/字）", 文件.获取大小(根 + "/中文.txt") == 12)
    文件.写入(根 + "/混合.txt", "AB汉")
    检查("AB+一个汉字 大小=5 字节", 文件.获取大小(根 + "/混合.txt") == 5)

    // ───────────── ⑤ §5.2 读取不存在 ⇒ 异常 ─────────────
    输出("-- ⑤ 读取不存在的文件 ⇒ 抛异常 --")
    读取缺失抛异常 = 假
    捕获:
        临时内容 = 文件.读取(根 + "/根本没有.txt")
        记录("读取不存在文件返回值（本不该到达）", 转文本(临时内容))
    异常:
        读取缺失抛异常 = 真
    结束
    检查("读取不存在文件 抛可捕获异常", 读取缺失抛异常 == 真)

    写入缺目录抛异常 = 假
    捕获:
        文件.写入(根 + "/不存在子目录/文件.txt", "值")
    异常:
        写入缺目录抛异常 = 真
    结束
    检查("写入到不存在的目录 抛可捕获异常", 写入缺目录抛异常 == 真)

    // ───────────── ⑥ §5.2 复制 ─────────────
    输出("-- ⑥ 复制 --")
    源 = 根 + "/源.txt"
    目标 = 根 + "/目标.txt"
    文件.写入(源, "被复制的正文")
    文件.复制(源, 目标)
    检查("复制后 目标存在", 文件.是否存在(目标) == 真)
    检查("复制后 目标内容一致", 文件.读取(目标) == "被复制的正文")
    检查("复制后 目标大小与源一致", 文件.获取大小(目标) == 文件.获取大小(源))
    检查("复制后 源仍存在（复制非移动）", 文件.是否存在(源) == 真)

    // ───────────── ⑦ §5.2 重命名（文件与目录）─────────────
    输出("-- ⑦ 重命名 文件 / 目录 --")
    旧文件 = 根 + "/旧名.txt"
    新文件 = 根 + "/新名.txt"
    文件.写入(旧文件, "重命名内容")
    文件.重命名(旧文件, 新文件)
    检查("重命名文件后 旧路径不存在", 文件.是否存在(旧文件) == 假)
    检查("重命名文件后 新路径存在", 文件.是否存在(新文件) == 真)
    检查("重命名文件后 内容保留", 文件.读取(新文件) == "重命名内容")

    旧目录 = 根 + "/旧目录"
    新目录 = 根 + "/新目录"
    文件.创建目录(旧目录)
    文件.写入(旧目录 + "/里面.txt", "目录内文件")
    文件.重命名(旧目录, 新目录)
    检查("重命名目录后 旧路径不存在", 文件.是否存在(旧目录) == 假)
    检查("重命名目录后 新路径存在", 文件.是否存在(新目录) == 真)
    检查("重命名目录后 子文件跟随", 文件.读取(新目录 + "/里面.txt") == "目录内文件")

    // ───────────── ⑧ §5.2 遍历目录 ─────────────
    输出("-- ⑧ 遍历目录 = 只列名字 --")
    遍历根 = 根 + "/遍历"
    文件.创建目录(遍历根)
    文件.写入(遍历根 + "/一.txt", "1")
    文件.写入(遍历根 + "/二.txt", "2")
    文件.创建目录(遍历根 + "/子目录")
    条目 = 文件.遍历目录(遍历根)
    检查("遍历结果 类型=数组", 类型(条目) == "数组")
    检查("遍历结果 条目数=3（两文件+一子目录）", 条目.长度() == 3)
    检查("遍历结果 含 一.txt", 条目.是否包含("一.txt") == 真)
    检查("遍历结果 含 二.txt", 条目.是否包含("二.txt") == 真)
    检查("遍历结果 含子目录名 子目录", 条目.是否包含("子目录") == 真)
    检查("遍历结果 只给名字（不含路径分隔符）", 条目.是否包含(遍历根 + "/一.txt") == 假)
    空目录 = 根 + "/空目录"
    文件.创建目录(空目录)
    检查("空目录 遍历结果长度=0", 文件.遍历目录(空目录).长度() == 0)

    // ───────────── ⑨ §5.2 删除 ─────────────
    输出("-- ⑨ 删除 文件 / 空目录 --")
    待删 = 根 + "/待删.txt"
    文件.写入(待删, "删我")
    文件.删除(待删)
    检查("删除文件后 不存在", 文件.是否存在(待删) == 假)
    文件.删除目录(空目录)
    检查("删除空目录后 不存在", 文件.是否存在(空目录) == 假)
    非空目录删除已抛异常 = 假
    捕获:
        文件.删除目录(遍历根)
    异常:
        非空目录删除已抛异常 = 真
    结束
    记录("删除非空目录 是否抛异常（规范未定义）", 转文本(非空目录删除已抛异常))
    记录("删除非空目录调用后 目录是否仍存在（规范未定义）", 转文本(文件.是否存在(遍历根)))

    // ───────────── ⑩ 当前目录 / 切换目录 ─────────────
    输出("-- ⑩ 获取当前目录 / 切换目录 --")
    检查("获取当前目录 非空", 原目录.长度() > 0)
    检查("获取当前目录 含路径分隔符", 原目录.是否包含("/") 或 原目录.是否包含("\反斜杠"))
    切目录 = 根 + "/切换目标"
    文件.创建目录(切目录)
    文件.切换目录(切目录)
    切换后 = 文件.获取当前目录()
    检查("切换目录后 当前目录包含 切换目标", 切换后.是否包含("切换目标") == 真)
    文件.写入("./切换后相对文件.txt", "相对路径基于新当前目录")
    检查("切换后 相对路径写入落在新目录内", 文件.是否存在(切换后 + "/切换后相对文件.txt") == 真)
    检查("切换后 用相对路径可读回", 文件.读取("./切换后相对文件.txt") == "相对路径基于新当前目录")
    文件.切换目录("..")
    检查("切换 .. 后 回到临时根目录（路径含 测试临时211_）", 文件.获取当前目录().是否包含("测试临时211_"))
    文件.切换目录(原目录)
    检查("切回原目录 生效", 文件.获取当前目录() == 原目录)

    // ───────────── ⑪ 中文路径 / 嵌套内容 ─────────────
    输出("-- ⑪ 中文路径与嵌套目录 --")
    中文目录 = 根 + "/中文目录"
    文件.创建目录(中文目录)
    文件.写入(中文目录 + "/中文文件.数据", "中文内容甲乙丙")
    检查("中文目录+中文文件名 可读回", 文件.读取(中文目录 + "/中文文件.数据") == "中文内容甲乙丙")
    检查("中文文件名 大小=21 字节（7 汉字）", 文件.获取大小(中文目录 + "/中文文件.数据") == 21)
    多层结果 = 假
    捕获:
        文件.创建目录(根 + "/层一/层二")
        多层结果 = 文件.是目录(根 + "/层一/层二")
    异常:
        多层结果 = 假
    结束
    记录("创建多级目录 是否递归（规范未定义）", 转文本(多层结果))

    // ───────────── ⑫ 较大内容往返 ─────────────
    输出("-- ⑫ 较大内容往返 --")
    大文件 = 根 + "/大.txt"
    片段 = "0123456789"
    大内容 = ""
    循环 序 = 1, 序 <= 1000, 序 += 1:
        大内容 = 大内容 + 片段
    结束
    文件.写入(大文件, 大内容)
    检查("1 万字节写入后 大小=10000", 文件.获取大小(大文件) == 10000)
    读回 = 文件.读取(大文件)
    检查("1 万字节读回 长度=10000", 读回.长度() == 10000)
    检查("1 万字节读回 内容一致", 读回 == 大内容)

    // ───────────── 收尾：清理临时目录 ─────────────
    输出("-- 收尾：清理 --")
    文件.切换目录(原目录)
    清理目录(根)
    检查("临时目录已清理干净", 文件.是否存在(根) == 假)

    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

// 递归清理：先删文件、再删子目录、最后删自身（非空目录规范未定义，故手动清）
清理目录(文本 路径):
    条目 = 文件.遍历目录(路径)
    循环 名 遍历 条目:
        子 = 路径 + "/" + 名
        如果 文件.是目录(子):
            清理目录(子)
        否则:
            文件.删除(子)
        结束
    结束
    文件.删除目录(路径)
结束
