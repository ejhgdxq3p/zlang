// §5.6 工具模块完整矩阵（正则匹配 / 正则替换 / 哈希算法 / 编码方案 / 解码方案 / 解析数据 / 生成数据 / 唯一编号）
// 依据：规范 §5.6（仅 MD5、SHA256；仅 BASE64；JSON 数据格式）
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

启动程序():
    输出("=== 06 工具模块完整矩阵 ===")

    // ───────── 正则匹配 ─────────
    匹配甲 = 工具.正则匹配("[0-9]+", "abc123def456")
    检查("正则匹配-数量", 匹配甲.长度() == 2)
    检查("正则匹配-首个", 匹配甲[1] == "123")
    检查("正则匹配-次个", 匹配甲[2] == "456")
    检查("正则匹配-无匹配返回空数组", 工具.正则匹配("[0-9]+", "无数字").长度() == 0)
    检查("正则匹配-中文模式", 工具.正则匹配("智语言", "我爱智语言")== ["智语言"])
    检查("正则匹配-分组返回整体匹配", 工具.正则匹配("([a-z]+)([0-9]+)", "abc123") == ["abc123"])
    检查("正则匹配-锚点", 工具.正则匹配("^a", "abc") == ["a"])
    检查("正则匹配-锚点不命中", 工具.正则匹配("^b", "abc").长度() == 0)
    检查("正则匹配-返回文本数组", 类型(匹配甲) == "数组" 且 类型(匹配甲[1]) == "文本")
    捕获:
        工具.正则匹配("(", "abc")
        检查("正则匹配-非法模式应抛异常", 假)
    异常:
        检查("正则匹配-非法模式抛异常", 真)
        检查("正则匹配-异常描述非空", 异常错误().描述.长度() > 0)
    结束

    // ───────── 正则替换 ─────────
    检查("正则替换-全部替换", 工具.正则替换("[0-9]+", "#", "a1b22c333") == "a#b#c#")
    检查("正则替换-无匹配保持原文", 工具.正则替换("[0-9]+", "#", "无数字") == "无数字")
    检查("正则替换-捕获组引用 $1", 工具.正则替换("([0-9]+)", "[$1]", "a12b345") == "a[12]b[345]")
    检查("正则替换-中文模式", 工具.正则替换("苹果", "香蕉", "苹果派") == "香蕉派")
    捕获:
        工具.正则替换("(", "#", "abc")
        检查("正则替换-非法模式应抛异常", 假)
    异常:
        检查("正则替换-非法模式抛异常", 真)
    结束

    // ───────── 哈希算法（标准向量）─────────
    检查("MD5-abc", 工具.哈希算法("MD5", "abc") == "900150983cd24fb0d6963f7d28e17f72")
    检查("MD5-空串", 工具.哈希算法("MD5", "") == "d41d8cd98f00b204e9800998ecf8427e")
    检查("MD5-hello world", 工具.哈希算法("MD5", "hello world") == "5eb63bbbe01eeed093cb22bb8f5acdc3")
    检查("SHA256-abc", 工具.哈希算法("SHA256", "abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    检查("SHA256-空串", 工具.哈希算法("SHA256", "") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    检查("SHA256-hello world", 工具.哈希算法("SHA256", "hello world") == "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9")
    检查("MD5-确定性", 工具.哈希算法("MD5", "固定输入") == 工具.哈希算法("MD5", "固定输入"))
    检查("MD5-长度32", 工具.哈希算法("MD5", "任意输入").长度() == 32)
    检查("SHA256-长度64", 工具.哈希算法("SHA256", "任意输入").长度() == 64)
    检查("哈希-中文输入可用", 工具.哈希算法("MD5", "智语言").长度() == 32)
    捕获:
        工具.哈希算法("SHA1", "abc")
        检查("哈希-不支持算法应抛异常", 假)
    异常:
        检查("哈希-不支持算法抛异常", 真)
    结束
    捕获:
        工具.哈希算法("md5", "abc")
        检查("哈希-算法名大小写敏感（小写应抛异常）", 假)
    异常:
        检查("哈希-算法名大小写敏感，小写抛异常", 真)
    结束

    // ───────── 编码 / 解码（BASE64）─────────
    检查("BASE64-abc", 工具.编码方案("BASE64", "abc") == "YWJj")
    检查("BASE64-hello", 工具.编码方案("BASE64", "hello") == "aGVsbG8=")
    检查("BASE64-空串", 工具.编码方案("BASE64", "") == "")
    检查("BASE64-解码空串", 工具.解码方案("BASE64", "") == "")
    检查("BASE64-解码 abc", 工具.解码方案("BASE64", "YWJj") == "abc")
    中文原文 = "你好，智语言！"
    检查("BASE64-中文往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", 中文原文)) == 中文原文)
    检查("BASE64-编码结果不含中文原文", 非 工具.编码方案("BASE64", 中文原文).是否包含("你好"))
    检查("BASE64-解码容忍换行", 工具.解码方案("BASE64", "aGVs\换行bG8=") == "hello")
    捕获:
        工具.编码方案("HEX", "abc")
        检查("编码-不支持方案应抛异常", 假)
    异常:
        检查("编码-不支持方案抛异常", 真)
    结束
    捕获:
        工具.解码方案("URL", "a%20b")
        检查("解码-不支持方案应抛异常", 假)
    异常:
        检查("解码-不支持方案抛异常", 真)
    结束
    捕获:
        工具.解码方案("BASE64", "!!!!")
        检查("解码-非法数据应抛异常", 假)
    异常:
        检查("解码-非法数据抛异常", 真)
    结束
    捕获:
        工具.解码方案("BASE64", "YWJ")
        记录("解码-长度非4倍数的实际处置", 工具.解码方案("BASE64", "YWJ"))
    异常:
        检查("解码-长度非法抛异常", 真)
    结束
    捕获:
        工具.解码方案("BASE64", "//8=")
        检查("解码-非 UTF-8 字节应抛异常", 假)
    异常:
        检查("解码-非 UTF-8 字节抛异常", 真)
    结束

    // ───────── 解析数据（JSON）─────────
    映射原文 = "{\引号姓名\引号:\引号张三\引号,\引号年龄\引号:25}"
    解析映射 = 工具.解析数据("JSON", 映射原文)
    检查("解析-JSON 对象类型", 类型(解析映射) == "映射")
    检查("解析-对象键数", 解析映射.长度() == 2)
    检查("解析-取文本值", 解析映射.获取("姓名") == "张三")
    检查("解析-取整数值", 解析映射.获取("年龄") == 25)
    解析数组 = 工具.解析数据("JSON", "[4,5,6]")
    检查("解析-JSON 数组类型", 类型(解析数组) == "数组")
    检查("解析-数组长度", 解析数组.长度() == 3)
    检查("解析-数组元素", 解析数组[1] == 4 且 解析数组[3] == 6)
    检查("解析-整数标量", 工具.解析数据("JSON", "42") == 42)
    检查("解析-小数标量", 工具.解析数据("JSON", "3.5") == 3.5)
    检查("解析-逻辑真", 工具.解析数据("JSON", "true") == 真)
    检查("解析-逻辑假", 工具.解析数据("JSON", "false") == 假)
    检查("解析-null 为类型名空值", 类型(工具.解析数据("JSON", "null")) == "空值")
    检查("解析-文本标量", 工具.解析数据("JSON", "\引号纯文本\引号") == "纯文本")
    嵌套解析 = 工具.解析数据("JSON", "{\引号甲\引号:[1,{\引号乙\引号:2}]}")
    检查("解析-嵌套取数组", 嵌套解析.获取("甲").长度() == 2)
    检查("解析-嵌套取数组元素", 嵌套解析.获取("甲")[1] == 1)
    检查("解析-嵌套取内层对象", 嵌套解析.获取("甲")[2].获取("乙") == 2)
    捕获:
        工具.解析数据("JSON", "{不是JSON")
        检查("解析-非法 JSON 应抛异常", 假)
    异常:
        检查("解析-非法 JSON 抛异常", 真)
    结束
    捕获:
        记录("解析-空串的实际处置（规范未定义）", 类型(工具.解析数据("JSON", "")))
    异常:
        检查("解析-空串抛异常", 真)
    结束
    捕获:
        工具.解析数据("XML", "<a/>")
        检查("解析-不支持格式应抛异常", 假)
    异常:
        检查("解析-不支持格式抛异常", 真)
    结束

    // ───────── 生成数据（JSON）─────────
    检查("生成-整数", 工具.生成数据("JSON", 42) == "42")
    检查("生成-逻辑真", 工具.生成数据("JSON", 真) == "true")
    检查("生成-逻辑假", 工具.生成数据("JSON", 假) == "false")
    检查("生成-空值", 工具.生成数据("JSON", 空值) == "null")
    检查("生成-文本带引号", 工具.生成数据("JSON", "文本") == "\引号文本\引号")
    检查("生成-数组", 工具.生成数据("JSON", [1, 2, 3]) == "[1,2,3]")
    检查("生成-空数组", 工具.生成数据("JSON", []) == "[]")
    检查("生成-对象", 工具.生成数据("JSON", {"甲": 1}) == "{\引号甲\引号:1}")
    检查("生成-空对象", 工具.生成数据("JSON", {}) == "{}")
    检查("生成-嵌套", 工具.生成数据("JSON", {"甲": [1, {"乙": 2}]}) == "{\引号甲\引号:[1,{\引号乙\引号:2}]}")
    检查("生成-小数", 工具.生成数据("JSON", 2.5) == "2.5")
    检查("生成-中文不转义", 工具.生成数据("JSON", "智语言") == "\引号智语言\引号")
    往返映射 = 工具.解析数据("JSON", 工具.生成数据("JSON", {"甲": 1, "乙": "两"}))
    检查("往返-映射键值一致", 往返映射.获取("甲") == 1 且 往返映射.获取("乙") == "两")
    往返数组 = 工具.解析数据("JSON", 工具.生成数据("JSON", [1, 2, 3]))
    检查("往返-数组一致", 往返数组.长度() == 3 且 往返数组[3] == 3)

    // ───────── 唯一编号 ─────────
    编号甲 = 工具.唯一编号()
    编号乙 = 工具.唯一编号()
    检查("唯一编号-长度36", 编号甲.长度() == 36)
    检查("唯一编号-含连字符", 编号甲.是否包含("-"))
    检查("唯一编号-两次不同", 编号甲 != 编号乙)
    检查("唯一编号-字符集合法（16 进制+连字符）", 工具.正则匹配("^[0-9a-fA-F-]{36}$", 编号甲).长度() == 1)
    唯一集 = {}
    循环 计数 = 1, 计数 <= 200, 计数 += 1:
        唯一集.插入(工具.唯一编号(), 真)
    结束
    检查("唯一编号-200 次无重复", 唯一集.长度() == 200)

    收尾()
结束
