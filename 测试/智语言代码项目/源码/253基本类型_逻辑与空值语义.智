// 覆盖《智语言编程规范》§2.4.1「逻辑类型」+「空值类型」：
//   逻辑：真/假、且/或/非、比较产生逻辑值（正确叫法是逻辑类型）
//   空值：≠0 ≠假 ≠""，代表"缺失的信息"；只允许与自身 == / === 等值判断
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 253 逻辑与空值语义（§2.4.1）===")

    // ── 逻辑类型 ──
    甲 = 真
    乙 = 假
    检查("逻辑：且", (甲 且 乙) == 假)
    检查("逻辑：或", (甲 或 乙) == 真)
    检查("逻辑：非", (非 乙) == 真)
    检查("比较产生逻辑值（>）", (10 > 5) == 真)
    检查("比较产生逻辑值（==）", (10 == 5) == 假)

    // ── 空值类型 ──
    空值 结果 = 空值
    当前用户 = 空值

    检查("空值 == 空值", (当前用户 == 空值) == 真)
    // [停用·规范 §2.4.5 铁律：空值只允许与自身 == / === 判断 ⇒ 本行写法非法；同类已由 2.4.5_负向_空值与非空值比较.智 覆盖] 检查("空值 !== 零", (当前用户 != 0) == 真)
    // [停用·规范 §2.4.5 铁律：空值只允许与自身 == / === 判断 ⇒ 本行写法非法；同类已由 2.4.5_负向_空值与非空值比较.智 覆盖] 检查("空值 !== 假", (当前用户 != 假) == 真)
    // [停用·规范 §2.4.5 铁律：空值只允许与自身 == / === 判断 ⇒ 本行写法非法；同类已由 2.4.5_负向_空值与非空值比较.智 覆盖] 检查("空值 !== 空文本", (当前用户 != "") == 真)
    检查("空值变量可参与等值比较", (结果 == 空值) == 真)

    收尾()
结束
