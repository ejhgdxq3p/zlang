// 57 诊断：编译模式下 文本数组.排序() 后 是否包含 失效
启动程序():
    文本数组 = ["乙", "甲", "丙"]
    文本数组.排序()
    输出("长度=" + 转文本(文本数组.长度()))
    输出("元素1=" + 转文本(文本数组[1]))
    输出("元素2=" + 转文本(文本数组[2]))
	输出("元素3=" + 转文本(文本数组[3]))
    输出("含甲=" + 转文本(文本数组.是否包含("甲")))
    输出("含乙=" + 转文本(文本数组.是否包含("乙")))
    输出("含丙=" + 转文本(文本数组.是否包含("丙")))
    末 = 文本数组.取末尾()
    输出("取末尾=" + 转文本(末))
结束
