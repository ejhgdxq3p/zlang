打招呼():
    输出("  你好（回调被调用）")
结束

启动程序():
    // ── 一、隐式声明（自动推断为函数类型）──
    操作 = 加法
    检查("隐式函数类型 调用", 操作(3, 4) == 7)

    另一个 = 乘法
    检查("隐式函数类型 再绑定", 另一个(3, 4) == 12)

    // ── 二、显式声明（完整签名 + 直接赋值）──
    函数(整数, 整数) 整数 显式加法 = 加法
    检查("显式函数类型 调用", 显式加法(10, 20) == 30)

    函数(整数, 整数) 整数 显式乘法 = 乘法
    检查("显式函数类型 再绑定调用", 显式乘法(6, 7) == 42)

    // ── 三、返回类型省略 ⇒ 自动补 空值（`函数()` ≡ `函数() 空值`）──
    函数() 无参回调 = 打招呼
    无参回调()
    检查("返回类型省略 调用未报错", 真)

    // 显式写出「函数() 空值」应与省略写法等价
    函数() 空值 显式空返 = 打招呼
    显式空返()
    检查("显式 函数() 空值 调用未报错", 真)

    输出("通过数 = " + 转文本(本模块.通过数) + " / 总数 = " + 转文本(本模块.总数))
结束
