// ============================================================
// 接口数组「元素值复制」语义验证（规范2.3.7）
// 背景：接口是引用类型（接口变量/参数共享原实例，修改作用于原实例）；
//       但「数组元素取出」遵循规范2.3.7 的【值复制】——数组字面量
//       [车甲, 车乙] 会把结构体实例【复制】进数组，因此数组槽位持有的是
//       与原命名变量【相互独立】的实例。由此：
//         · 通过 列表[1] 修改，只作用于数组槽位的副本实例，不影响原命名 车甲；
//         · 数组槽位内部仍保持接口引用语义（取出到接口变量再改，作用于同槽位实例）。
// 注：编译模式对「接口数组元素带状态方法」存在 parity bug（修改未写回，速度=空值），
//     本用例仅在【解释模式】下断言；编译模式按 parity 策略跳过。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

接口 可移动:
    移动(速度):
    结束
    当前速度() 小数:
    结束
结束

结构体 汽车(文本 品牌) 适配 可移动:
    小数 速度 = 0.0
    移动(小数 新速度):
        自身.速度 = 新速度
    结束
    当前速度() 小数:
        返回 自身.速度
    结束
结束

测试_数组元素值复制():
    车甲 = 汽车("甲")
    车甲.移动(30.0)
    车乙 = 汽车("乙")
    车乙.移动(20.0)
    // 数组字面量：按 2.3.7 值复制，把结构体实例复制进数组（独立于原命名变量）
    数组<可移动> 列表 = [车甲, 车乙]

    检查("原命名实例甲速度=30", 车甲.当前速度() == 30.0)

    // 情形A：直接通过数组元素(1-based)调用带状态方法
    列表[1].移动(99.0)
    // 数组槽位副本被修改
    检查("数组元素修改-槽位速度=99", 列表[1].当前速度() == 99.0)
    // 原命名变量不受影响（值复制：数组槽位与原变量是不同实例）
    检查("数组元素修改-原命名甲速度仍为30(值复制)", 车甲.当前速度() == 30.0)

    // 情形B：取出到显式接口变量再修改（槽位内保持接口引用语义）
    可移动 元素 = 列表[1]
    元素.移动(55.0)
    检查("元素修改-槽位速度=55", 列表[1].当前速度() == 55.0)
    检查("元素修改-原命名甲速度仍为30(值复制)", 车甲.当前速度() == 30.0)

    // 对照：显式接口变量指向原命名实例时，修改作用于原实例（引用语义）
    可移动 设备 = 车甲
    设备.移动(88.0)
    检查("对照-接口变量引用语义-原命名甲=88", 车甲.当前速度() == 88.0)
结束

启动程序():
    输出("========== 接口数组元素值复制验证 ==========")
    测试_数组元素值复制()
    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
