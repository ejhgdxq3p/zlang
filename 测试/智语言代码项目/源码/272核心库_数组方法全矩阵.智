// §4.3 数组方法完整矩阵（11 个方法 + 1 基索引 + 越界语义 + 值语义）
// 依据：规范 §4.3 方法表、索引规则（`[i]` 越界抛异常 / `.获取` 越界返回空值 / 查找未找到返回 0）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

启动程序():
    输出("=== 03 数组方法完整矩阵 ===")

    // ───────── 长度 / 追加 ─────────
    甲 = [1, 2, 3]
    检查("长度-三元素", 甲.长度() == 3)
    检查("长度-空数组", [].长度() == 0)
    甲.追加(4)
    检查("追加-长度加一", 甲.长度() == 4)
    检查("追加-元素在末尾", 甲[4] == 4)
    检查("追加-连续追加", 甲.长度() == 4)
    文本容器 = ["甲", "乙"]
    文本容器.追加("丙")
    检查("追加-文本数组", 文本容器.长度() == 3 且 文本容器[3] == "丙")
    // 容器约束（整数数组写文本）是**编译期类型错误**，不能放在 捕获 里断言；
    // 由独立负向用例 09_容器类型约束_负向.智（@预期错误）覆盖。

    // ───────── 插入（1 基；允许 长度+1 = 末尾追加）─────────
    乙 = [10, 20, 30]
    乙.插入(1, 5)
    检查("插入-首位", 乙[1] == 5 且 乙.长度() == 4)
    乙.插入(3, 15)
    检查("插入-中间", 乙[3] == 15 且 乙[4] == 20)
    乙.插入(乙.长度() + 1, 99)
    检查("插入-长度+1 = 末尾追加", 乙[乙.长度()] == 99)
    捕获:
        丙 = [1, 2]
        丙.插入(0, 9)
        检查("插入-索引0 应抛异常", 假)
    异常:
        检查("插入-索引0 抛异常", 真)
    结束
    捕获:
        丁 = [1, 2]
        丁.插入(4, 9)
        检查("插入-长度+2 应抛异常", 假)
    异常:
        检查("插入-长度+2 抛异常", 真)
    结束

    // ───────── 删除（1 基；越界抛异常）─────────
    戊 = [1, 2, 3, 4]
    戊.删除(1)
    检查("删除-首位", 戊[1] == 2 且 戊.长度() == 3)
    戊.删除(3)
    检查("删除-末位", 戊.长度() == 2 且 戊[2] == 3)
    戊.删除(1)
    戊.删除(1)
    检查("删除-删空", 戊.长度() == 0)
    捕获:
        己 = [1]
        己.删除(0)
        检查("删除-索引0 应抛异常", 假)
    异常:
        检查("删除-索引0 抛异常", 真)
    结束
    捕获:
        庚 = [1]
        庚.删除(2)
        检查("删除-越界 应抛异常", 假)
    异常:
        检查("删除-越界 抛异常", 真)
    结束

    // ───────── 取末尾（弹出语义：返回并移除；空数组 ⇒ 空值）─────────
    辛 = [1, 2, 3]
    检查("取末尾-返回值", 辛.取末尾() == 3)
    检查("取末尾-已移除（长度减一）", 辛.长度() == 2)
    检查("取末尾-连续弹出", 辛.取末尾() == 2 且 辛.取末尾() == 1)
    检查("取末尾-弹空后长度0", 辛.长度() == 0)
    检查("取末尾-空数组返回空值", 辛.取末尾() == 空值)

    // ───────── 获取（越界/非法索引 ⇒ 空值，安全）─────────
    壬 = [10, 20, 30]
    检查("获取-首元素", 壬.获取(1) == 10)
    检查("获取-末元素", 壬.获取(3) == 30)
    检查("获取-索引0 返回空值", 壬.获取(0) == 空值)
    检查("获取-索引长度+1 返回空值", 壬.获取(4) == 空值)
    检查("获取-负索引返回空值", 壬.获取(0 - 1) == 空值)
    检查("获取-空数组返回空值", [].获取(1) == 空值)

    // ───────── 下标语法（越界抛异常）─────────
    癸 = [1, 2, 3]
    检查("下标-读首元素", 癸[1] == 1)
    检查("下标-读末元素", 癸[3] == 3)
    癸[2] = 99
    检查("下标-写入", 癸[2] == 99)
    捕获:
        越界下标 = 癸[0]
        检查("下标-索引0 应抛异常", 假)
    异常:
        检查("下标-索引0 抛异常", 真)
    结束
    捕获:
        越界下标二 = 癸[4]
        检查("下标-越界 应抛异常", 假)
    异常:
        检查("下标-越界 抛异常", 真)
    结束

    // ───────── 是否包含 / 查找索引 ─────────
    子 = [10, 20, 20, 30]
    检查("是否包含-命中", 子.是否包含(20) == 真)
    检查("是否包含-未命中", 子.是否包含(99) == 假)
    检查("是否包含-空数组", [].是否包含(1) == 假)
    检查("是否包含-数值等价 1 ≡ 1.0", [1.0, 2].是否包含(1) == 真)
    检查("查找索引-首次出现", 子.查找索引(20) == 2)
    检查("查找索引-末元素", 子.查找索引(30) == 4)
    检查("查找索引-未找到返回0", 子.查找索引(99) == 0)
    检查("查找索引-空数组返回0", [].查找索引(1) == 0)
    检查("查找索引-文本元素", ["甲", "乙"].查找索引("乙") == 2)

    // ───────── 反转 ─────────
    丑 = [1, 2, 3, 4]
    丑.反转()
    检查("反转-首变原末", 丑[1] == 4)
    检查("反转-末变原首", 丑[4] == 1)
    检查("反转-长度不变", 丑.长度() == 4)
    单 = [7]
    单.反转()
    检查("反转-单元素", 单[1] == 7)
    空反转 = []
    空反转.反转()
    检查("反转-空数组安全", 空反转.长度() == 0)

    // ───────── 排序（升序原地）─────────
    寅 = [3, 1, 4, 1, 5, 2]
    寅.排序()
    检查("排序-升序", 寅[1] == 1 且 寅[6] == 5)
    检查("排序-重复值相邻", 寅[1] == 1 且 寅[2] == 1)
    检查("排序-长度不变", 寅.长度() == 6)
    负 = [0, 0 - 5, 3, 0 - 1]
    负.排序()
    检查("排序-负数在前", 负[1] == 0 - 5 且 负[2] == 0 - 1)
    小数序列 = [3.5, 1.25, 2.75]
    小数序列.排序()
    检查("排序-小数升序", 小数序列[1] == 1.25 且 小数序列[3] == 3.5)
    // ★ 2026-10-19 修复项：整数与小数混合排序（此前跨类型比较一律 Equal ⇒ 完全不排序）
    混 = [3, 1.5, 2]
    混.排序()
    检查("排序-整数与小数混合（首为1.5）", 混[1] == 1.5)
    检查("排序-整数与小数混合（中为2）", 混[2] == 2)
    检查("排序-整数与小数混合（末为3）", 混[3] == 3)
    混二 = [2.5, 1, 3.5, 0 - 2]
    混二.排序()
    检查("排序-混合含负数（首为-2）", 混二[1] == 0 - 2)
    检查("排序-混合含负数（末为3.5）", 混二[4] == 3.5)
    文本序 = ["b", "a", "c"]
    文本序.排序()
    检查("排序-文本升序", 文本序[1] == "a" 且 文本序[3] == "c")
    中文序 = ["乙", "甲", "丙"]
    中文序.排序()
    记录("中文文本排序结果（规范未规定排序规则）", 转文本(中文序))
    检查("排序-中文元素不丢", 中文序.长度() == 3 且 中文序.查找索引("甲") > 0)
    单排 = [5]
    单排.排序()
    检查("排序-单元素", 单排[1] == 5)
    空排 = []
    空排.排序()
    检查("排序-空数组安全", 空排.长度() == 0)

    // ───────── 清空 ─────────
    卯 = [1, 2, 3]
    卯.清空()
    检查("清空-长度归零", 卯.长度() == 0)
    卯.追加(9)
    检查("清空-追加后长度1", 卯.长度() == 1)
    检查("清空-追加后可取回", 卯[1] == 9)

    // ───────── 值语义（赋值复制，互不影响）─────────
    原数组 = [1, 2, 3]
    副本 = 原数组
    副本.追加(4)
    检查("值语义-副本追加不影响原数组", 原数组.长度() == 3)
    检查("值语义-副本自身已变", 副本.长度() == 4)
    副本[1] = 100
    检查("值语义-副本改写不影响原数组元素", 原数组[1] == 1)

    // ───────── 嵌套数组 / 泛型声明 ─────────
    嵌套 = [[1, 2], [3, 4]]
    检查("嵌套-外层长度", 嵌套.长度() == 2)
    检查("嵌套-内层读取", 嵌套[2][2] == 4)
    嵌套[1][1] = 9
    检查("嵌套-内层写入", 嵌套[1][1] == 9)
    数组<整数> 泛型数组 = [1, 2, 3]
    检查("泛型声明-长度", 泛型数组.长度() == 3)
    泛型数组.追加(4)
    检查("泛型声明-追加", 泛型数组[4] == 4)

    收尾()
结束
