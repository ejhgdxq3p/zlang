通过数 = 0
失败数 = 0
总数 = 0
步骤 = ""
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("FAILCASE " + 名称)
    结束
结束

原始描述 = ""

测试_保留原始():
    捕获:
        捕获:
            本模块.步骤 = 本模块.步骤 + 转文本(1 / 0)
        异常:
            本模块.原始描述 = 异常错误().描述
            本模块.步骤 = 本模块.步骤 + "内层记录"
            抛出
        始终:
            本模块.步骤 = 本模块.步骤 + "内层收尾"
        结束
    异常:
        本模块.步骤 = 本模块.步骤 + "外层处理"
        检查("裸抛出保留原始异常描述", 异常错误().描述 == 本模块.原始描述)
        检查("裸抛出保留原始异常类型（除零异常）", 异常错误().类型 == "除零异常")
        检查("裸抛出保留原始代码位置（非空）", 异常错误().位置 != "")
    始终:
        本模块.步骤 = 本模块.步骤 + "外层收尾"
    结束
    检查("重抛路径的完整顺序", 本模块.步骤 == "内层记录内层收尾外层处理外层收尾")
结束

启动程序():
    测试_保留原始()
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
