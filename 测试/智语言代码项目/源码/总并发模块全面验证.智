// ============================================================
// 并发模块 全面验证（对照《智语言编程规范》§5.7 全接口）
// 覆盖：5.7.2 执行调度 / 5.7.3 通道 / 5.7.4 多路监听 / 5.7.5 生命周期 / 5.7.6 模式
// 相比 总并发模块详细验证.智 新增：超时终止器、任务异常传递、向已关闭通道发送抛异常、
//   尝试发送已关闭通道返回假、监听超时真正触发、任务让出主线程直测+长计算不饿死、空批量等待。
// 每个用例用 检查() 统计，末行输出汇总。双模(解释/编译执行)验证。
// 设计原则：确定性优先，避免长休眠与死锁；会崩溃/抛异常的用例放在末尾。
// ============================================================

导入 并发
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    // ===================== 一、任务启动 六种写法（§5.7.2）=====================
    输出("===== 一、启动任务 六种写法 =====")

    // 写法一：命名函数（无返回值）—— 定义见文件末尾辅助区
    无返1 = 并发.启动任务(打印消息)
    检查("写法一 命名无返回值：等待结果=空值", 无返1.等待结果() == 空值)

    // 写法二：命名函数（有返回值）
    有返1 = 并发.启动任务(获取数据)
    检查("写法二 命名有返回值：等待结果=数据已获取", 有返1.等待结果() == "数据已获取")

    // 写法三：匿名函数（无返回值）
    无返2 = 并发.启动任务(函数():
        临时 = 1
    结束)
    检查("写法三 匿名无返回值：等待结果=空值", 无返2.等待结果() == 空值)

    // 写法四：匿名函数（有返回值）
    无返3 = 并发.启动任务(函数() 整数:
        返回 42
    结束)
    检查("写法四 匿名有返回值：等待结果=42", 无返3.等待结果() == 42)

    // 写法五：包装函数（带参包装为无参）
    包装1 = 并发.启动任务(求和包装)
    检查("写法五 包装函数：10+20=30", 包装1.等待结果() == 30)

    // 写法六：匿名函数包装
    匿名包装 = 并发.启动任务(函数() 整数:
        返回 计算总和(10, 20)
    结束)
    检查("写法六 匿名函数包装：10+20=30", 匿名包装.等待结果() == 30)

    // ===================== 二、任务.是否完成（§5.7.2）=====================
    输出("===== 二、任务.是否完成 =====")
    完成测试任务 = 并发.启动任务(函数() 整数: 返回 7 结束)
    检查("是否完成：等待前返回 逻辑 类型", 类型(完成测试任务.是否完成()) == "逻辑")
    完成测试任务.等待结果()
    检查("是否完成：等待结果后=真", 完成测试任务.是否完成() == 真)

    // ===================== 三、批量等待 无超时（§5.7.2）=====================
    输出("===== 三、批量等待 无超时（按序返回） =====")
    句柄甲 = 并发.启动任务(函数() 整数: 返回 1 结束)
    句柄乙 = 并发.启动任务(函数() 整数: 返回 2 结束)
    句柄丙 = 并发.启动任务(函数() 整数: 返回 3 结束)
    批量1 = 并发.批量等待([句柄甲, 句柄乙, 句柄丙])
    检查("批量等待 长度=3", 批量1.长度() == 3)
    检查("批量等待[1]=1", 批量1[1] == 1)
    检查("批量等待[2]=2", 批量1[2] == 2)
    检查("批量等待[3]=3", 批量1[3] == 3)

    // ===================== 四、批量等待 空数组（边界）=====================
    输出("===== 四、批量等待 空数组边界 =====")
    空批量 = 并发.批量等待([])
    检查("批量等待([]) 返回空数组", 空批量.长度() == 0)

    // ===================== 五、批量等待 超时（§5.7.2 关键语义）=====================
    输出("===== 五、批量等待 超时：已完成得值 / 未完成空值，句柄仍有效 =====")
    快任务 = 并发.启动任务(函数() 整数: 返回 99 结束)
    慢任务 = 并发.启动任务(函数() 文本:
        时间.休眠(500)
        返回 "慢结果"
    结束)
    部分 = 并发.批量等待([快任务, 慢任务], 100)
    检查("超时批量等待：快任务得值 99", 部分[1] == 99)
    检查("超时批量等待：慢任务超时=空值", 部分[2] == 空值)
    后期 = 慢任务.等待结果()
    检查("超时后句柄仍有效：最终=慢结果", 后期 == "慢结果")

    // ===================== 六、任务让出（§5.7.2）=====================
    输出("===== 六、任务让出：主线程直测 + 长计算不饿死 =====")
    并发.任务让出()                    // 主线程调用不应阻塞/崩溃
    让出后 = 1
    检查("任务让出：主线程调用不阻塞且继续执行", 让出后 == 1)

    饿死1 = 并发.启动任务(函数() 整数: 返回 累加到(100) 结束)
    饿死2 = 并发.启动任务(函数() 整数: 返回 累加到(100) 结束)
    检查("任务让出：长计算任务1不饿死=5050", 饿死1.等待结果() == 5050)
    检查("任务让出：长计算任务2不饿死=5050", 饿死2.等待结果() == 5050)

    // ===================== 七、通道 基本收发 + 关闭语义（§5.7.3）=====================
    输出("===== 七、通道：收发 + 关闭语义 =====")
    数据通道 = 并发.通道(3)
    数据通道.发送(100)
    数据通道.发送(200)
    数据通道.关闭()
    检查("通道.接收 100", 数据通道.接收() == 100)
    检查("通道.接收 200", 数据通道.接收() == 200)
    检查("已关闭通道.接收=空值", 数据通道.接收() == 空值)
    检查("通道.是否关闭()=真", 数据通道.是否关闭() == 真)

    // ===================== 八、通道 尝试发送 / 尝试接收（§5.7.3）=====================
    输出("===== 八、通道：尝试发送 / 尝试接收（非阻塞） =====")
    缓冲通道 = 并发.通道(1)
    检查("尝试发送：缓冲有空位=真", 缓冲通道.尝试发送("A") == 真)
    检查("尝试发送：缓冲满=假", 缓冲通道.尝试发送("B") == 假)
    检查("尝试接收：返回 A", 缓冲通道.尝试接收() == "A")
    检查("尝试接收：空通道=空值", 缓冲通道.尝试接收() == 空值)
    缓冲通道.关闭()

    // ===================== 九、通道 尝试发送(已关闭)=假（§5.7.3 边界）=====================
    输出("===== 九、通道：尝试发送 已关闭通道返回假（不抛） =====")
    关闭缓冲 = 并发.通道(2)
    关闭缓冲.关闭()
    检查("尝试发送：已关闭通道=假（不抛异常）", 关闭缓冲.尝试发送(1) == 假)

    // ===================== 十、同步通道（容量 0）（§5.7.3）=====================
    输出("===== 十、同步通道（容量=0） =====")
    同步 = 并发.通道(0)
    检查("同步通道创建成功", 同步 != 空值)
    同步.关闭()
    检查("同步通道关闭后 是否关闭=真", 同步.是否关闭() == 真)

    // ===================== 十一、跨任务 生产-消费（阻塞收发）=====================
    输出("===== 十一、跨任务 生产-消费（任务间通信） =====")
    收集 = 消费生产()
    检查("生产-消费：收集长度=3", 收集.长度() == 3)
    检查("生产-消费[1]=1", 收集[1] == 1)
    检查("生产-消费[3]=3", 收集[3] == 3)

    // ===================== 十二、多路监听 通道+超时（§5.7.4）=====================
    输出("===== 十二、多路监听：监听通道 + 监听超时（数据就绪） =====")
    选择通道 = 并发.通道(10)
    选择通道.发送("重要数据")
    并发.监听通道("数据", 选择通道)
    并发.监听超时("超时", 5000)
    监听结果 = 并发.多路监听([])
    检查("多路监听 命中数据事件 来源=数据", 监听结果.获取("来源") == "数据")
    检查("多路监听 从通道读取 重要数据", 选择通道.接收() == "重要数据")
    选择通道.关闭()

    // ===================== 十三、多路监听 超时真正触发（§5.7.4）=====================
    输出("===== 十三、多路监听：监听超时 真正触发（无数据→超时） =====")
    空监听通道 = 并发.通道(5)
    并发.监听通道("数据", 空监听通道)
    并发.监听超时("超时", 200)
    超时结果 = 并发.多路监听([])
    检查("多路监听：无数据且超时 来源=超时", 超时结果.获取("来源") == "超时")
    空监听通道.关闭()

    // ===================== 十四、多路监听 非阻塞（超时 0ms）（§5.7.4）=====================
    输出("===== 十四、多路监听：非阻塞（超时 0ms） =====")
    跳过通道 = 并发.通道(10)
    并发.监听通道("通道", 跳过通道)
    并发.监听超时("跳过", 0)
    非阻塞结果 = 并发.多路监听([])
    检查("多路监听：0ms 非阻塞 来源=跳过", 非阻塞结果.获取("来源") == "跳过")
    跳过通道.关闭()

    // ===================== 十五、多路监听 关闭通道自动就绪（§5.7.4）=====================
    输出("===== 十五、多路监听：关闭通道自动就绪 =====")
    已关通道 = 并发.通道(5)
    已关通道.关闭()
    并发.监听通道("已关闭", 已关通道)
    关闭就绪 = 并发.多路监听([])
    检查("多路监听：关闭通道 来源=已关闭", 关闭就绪.获取("来源") == "已关闭")
    检查("多路监听：已关闭通道.接收()=空值", 已关通道.接收() == 空值)

    // ===================== 十六、终止器 手动触发（§5.7.5）=====================
    输出("===== 十六、终止器：手动触发 / 幂等 / 是否终止 =====")
    终止信号 = 并发.终止器()
    检查("终止器 未触发 是否终止=假", 终止信号.是否终止() == 假)
    终止信号.触发终止()
    检查("终止器 触发后 是否终止=真", 终止信号.是否终止() == 真)
    终止信号.触发终止()
    检查("终止器 重复触发 幂等仍为真", 终止信号.是否终止() == 真)

    // ===================== 十七、终止器 超时自动触发（§5.7.5 案例二）=====================
    输出("===== 十七、终止器(毫秒) 超时自动触发 =====")
    定时终止 = 并发.终止器(200)
    检查("终止器(200) 创建瞬间 是否终止=假", 定时终止.是否终止() == 假)
    时间.休眠(500)
    检查("终止器(200) 超时后 是否终止=真", 定时终止.是否终止() == 真)

    // ===================== 十八、终止器 信号通道 + 多路集成（§5.7.5）=====================
    输出("===== 十八、终止器：信号通道 + 多路监听集成 =====")
    工作通道 = 并发.通道(10)
    退出信号 = 并发.终止器()
    退出信号.触发终止()
    检查("终止器.信号通道() 返回通道(非空值)", 退出信号.信号通道() != 空值)
    检查("终止器 触发后 信号通道已关闭", 退出信号.信号通道().是否关闭() == 真)
    并发.监听通道("工作", 工作通道)
    并发.监听终止("退出", 退出信号)
    终止集成 = 并发.多路监听([])
    检查("多路监听 集成终止信号 来源=退出", 终止集成.获取("来源") == "退出")
    工作通道.关闭()

    // ===================== 十九、终止器(毫秒) 信号通道超时后关闭（§5.7.5）=====================
    输出("===== 十九、终止器(毫秒) 信号通道 超时后关闭 =====")
    定时退出 = 并发.终止器(200)
    信号前 = 定时退出.信号通道()
    检查("终止器(200) 信号通道 创建时未关闭", 信号前.是否关闭() == 假)
    时间.休眠(500)
    检查("终止器(200) 超时后 信号通道已关闭", 信号前.是否关闭() == 真)

    // ===================== 二十、常见模式 扇出-扇入（§5.7.6）=====================
    输出("===== 二十、常见模式：扇出-扇入（并行计算） =====")
    平方 = 并行映射([1, 2, 3, 4, 5])
    检查("扇出-扇入 长度=5", 平方.长度() == 5)
    检查("扇出-扇入[1]=1", 平方[1] == 1)
    检查("扇出-扇入[5]=25", 平方[5] == 25)

    // ===================== 二十一、常见模式 管线（§5.7.6）=====================
    输出("===== 二十一、常见模式：管线（多阶段流水线） =====")
    管线 = 运行管线()
    检查("管线 长度=5", 管线.长度() == 5)
    检查("管线[1]=数字1", 管线[1] == "数字1")
    检查("管线[5]=数字5", 管线[5] == "数字5")

    // ===================== 二十二、常见模式 并发限制(信号量)（§5.7.6 轻量版）=====================
    输出("===== 二十二、常见模式：并发限制（信号量，轻量） =====")
    信号量 = 并发.通道(3)
    信号任务列表 = []
    循环 编号 = 1, 编号 <= 9, 编号 += 1:
        当前 = 编号
        句柄 = 并发.启动任务(函数() 整数:
            信号量.发送(空值)
            结果 = 当前 * 2
            信号量.接收()
            返回 结果
        结束)
        信号任务列表.追加(句柄)
    结束
    并发限制结果 = 并发.批量等待(信号任务列表)
    检查("并发限制 9 任务全部完成 长度=9", 并发限制结果.长度() == 9)
    检查("并发限制[1]=2", 并发限制结果[1] == 2)
    检查("并发限制[9]=18", 并发限制结果[9] == 18)
    检查("并发限制 信号量未关闭", 信号量.是否关闭() == 假)

    // ===================== 二十三、任务异常传递 到 等待结果（§5.7.2 关键语义）=====================
    输出("===== 二十三、任务异常传递：等待结果 抛异常 =====")
    崩溃已捕获 = 假
    // ★F19b迁移20261015：λ 声明 `整数` 而 `10 / 0` 的类型是**小数**（§2.6.1 整数相除返回小数）
    //   ⇒ 声明改为 `小数`（保留整数除零的原始语义；除零行为与类型无关，§2.6.9 一律抛异常）。
    崩溃任务 = 并发.启动任务(函数() 小数:
        返回 10 / 0
    结束)
    捕获:
        崩溃任务.等待结果()
    异常:
        崩溃已捕获 = 真
    结束
    检查("任务内除零：等待结果() 抛出异常到调用方", 崩溃已捕获 == 真)

    // ===================== 二十四、向已关闭通道发送 抛运行时异常（§5.7.3 关闭语义）=====================
    输出("===== 二十四、向已关闭通道发送 抛运行时异常 =====")
    发送异常已捕获 = 假
    关闭发送通道 = 并发.通道(2)
    关闭发送通道.关闭()
    捕获:
        关闭发送通道.发送(1)
    异常:
        发送异常已捕获 = 真
    结束
    检查("向已关闭通道发送：抛运行时异常", 发送异常已捕获 == 真)

    // ===================== 汇总 =====================
    输出("")
    输出("===== 并发模块全面验证 汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "  通过：" + 转文本(本模块.通过数) + "  失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 == 0:
        输出("全部通过")
    否则:
        输出("存在失败用例")
    结束
结束

// ---------- 辅助函数（模块层定义；实现不支持函数内嵌套命名函数）----------

// §5.7.2 写法一：命名函数（无返回值）
打印消息():
    输出("（任务：打印消息执行中）")
结束

// §5.7.2 写法二：命名函数（有返回值）
获取数据() 文本:
    返回 "数据已获取"
结束

// §5.7.2 写法五：包装函数（带参包装为无参）
求和包装() 整数:
    返回 计算总和(10, 20)
结束

计算总和(整数 甲, 整数 乙) 整数:
    返回 甲 + 乙
结束

累加到(整数 上限) 整数:
    总计 = 0
    循环 索引 = 1, 索引 <= 上限, 索引 += 1:
        总计 = 总计 + 索引
        并发.任务让出()
    结束
    返回 总计
结束

消费生产() 数组<整数>:
    产通道 = 并发.通道(5)
    并发.启动任务(函数():
        循环 索引 = 1, 索引 <= 3, 索引 += 1:
            产通道.发送(索引)
        结束
        产通道.关闭()
    结束)
    收集 = []
    循环 真:
        数据 = 产通道.接收()
        如果 数据 == 空值:
            跳出
        结束
        收集.追加(数据)
    结束
    返回 收集
结束

并行映射(数组<整数> 数据列表) 数组<整数>:
    任务列表 = []
    循环 元素 遍历 数据列表:
        值 = 元素
        句柄 = 并发.启动任务(函数() 整数:
            返回 值 * 值
        结束)
        任务列表.追加(句柄)
    结束
    返回 并发.批量等待(任务列表)
结束

运行管线() 数组<文本>:
    阶段一输出 = 并发.通道(5)
    阶段二输出 = 并发.通道(5)
    并发.启动任务(函数():
        循环 索引 = 1, 索引 <= 5, 索引 += 1:
            阶段一输出.发送(索引)
        结束
        阶段一输出.关闭()
    结束)
