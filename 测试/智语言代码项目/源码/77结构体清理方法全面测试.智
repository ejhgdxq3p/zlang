// `清理` 已非生命周期方法、不再自动调用：资源方法一律由持有者显式调用。
// 覆盖：顶层局部 / 数组元素 的显式释放，以及「无自动析构」这一语义。

总数 = 0
通过数 = 0
释放计数 = 0
释放日志 = ""

检查(文本 描述, 逻辑 结果):
    本模块.总数 = 本模块.总数 + 1
    如果 结果:
        本模块.通过数 = 本模块.通过数 + 1
    结束
结束

结构体 资源(文本 名):
    文本 标识
    初始化():
        自身.标识 = 名
    结束
    关闭():
        本模块.释放计数 = 本模块.释放计数 + 1
        本模块.释放日志 = 本模块.释放日志 + 名 + ";"
    结束
结束

结构体 仅关闭:
    关闭():
        本模块.释放计数 = 本模块.释放计数 + 1
    结束
结束

运行测试():
    资源 顶层资源 = 资源("甲")
    仅关闭 仅关 = 仅关闭()
    数组<资源> 资源列表 = [资源("乙"), 资源("丙")]
    检查("初始化创建 标识=甲", 顶层资源.标识 == "甲")
    检查("数组内结构体 初始化执行", 资源列表[1].标识 == "乙")
    检查("无自动析构：未显式释放时计数为0", 本模块.释放计数 == 0)

    顶层资源.关闭()
    仅关.关闭()
    资源列表[1].关闭()
    资源列表[2].关闭()
    检查("显式释放 4 次", 本模块.释放计数 == 4)
    检查("释放顺序=调用顺序", 本模块.释放日志 == "甲;乙;丙;")
结束

启动程序():
    输出("===== 77 结构体资源方法全面测试 =====")
    运行测试()
    输出("释放计数=" + 转文本(本模块.释放计数) + " 日志=" + 本模块.释放日志)
    输出("===== 测试结果: " + 转文本(本模块.通过数) + "/" + 转文本(本模块.总数) + " =====")
    如果 本模块.通过数 == 本模块.总数:
        输出("全部通过 ✅")
