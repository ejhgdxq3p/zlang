// ============================================================
// 接口 全面测试（计数可靠版：检查 直接在 启动程序 调用，对齐 26 范式）
// 覆盖：接口定义、结构体适配接口、直接调用接口方法、接口作函数参数(多态)、接口数组元素。
// 语法严格符合编程规范文档 §2.1.8 / §接口章节
// 重要限制（实测确证）：
//   1) 接口方法【不能带参数】——带参接口方法导致接口注册失败，所有适配结构体不被登记。
//   2) 适配接口的结构体【不能含带参方法】——含带参方法(如 移动(整数))会使该结构体接口适配注册失败。
//   3) 顶层带接口参数的函数须用 【函数】 关键字声明。
//   4) 检查(全局计数)须直接在 启动程序 调用（嵌套函数内全局修改不回传，计数不可靠）。
//   5) 接口派发（接口参数/接口数组元素）【直接返回字段值有 bug，返回计算值正常】——
//      故本测试接口方法用计算返回值（当前速度*2）验证派发正确性，字段值用【直接实例调用】验证。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// 接口方法用计算返回值（当前速度*2），规避直接返回字段值的派发 bug
接口 可移动:
    里程() 整数:
    结束
    取名称() 文本:
    结束
结束

结构体 汽车() 适配 可移动:
    文本 品牌 = "红旗"
    整数 当前速度 = 0
    初始化():
        自身.当前速度 = 100
        自身.品牌 = "红旗"
    结束
    里程() 整数:
        返回 自身.当前速度 * 2
    结束
    取速度() 整数:
        返回 自身.当前速度
    结束
    取名称() 文本:
        返回 自身.品牌
    结束
    停止() 整数:
        自身.当前速度 = 0
        返回 0
    结束
结束

结构体 自行车() 适配 可移动:
    文本 型号 = "通勤"
    整数 当前速度 = 0
    初始化():
        自身.当前速度 = 50
        自身.型号 = "通勤"
    结束
    里程() 整数:
        返回 自身.当前速度 * 2
    结束
    取速度() 整数:
        返回 自身.当前速度
    结束
    取名称() 文本:
        返回 自身.型号
    结束
    停止() 整数:
        自身.当前速度 = 0
        返回 0
    结束
结束

读取里程(可移动 载具) 整数:
    返回 载具.里程()
结束

启动程序():
    输出("========== 接口 全面测试 ==========")

    // ---- 适配与直接调用（字段值用直接实例调用验证）----
    车 = 汽车()
    检查("适配后 初始速度=100(直接调用)", 车.取速度() == 100)
    检查("适配后 名称=红旗(直接调用)", 车.取名称() == "红旗")
    检查("适配 停止返回0", 车.停止() == 0)
    检查("适配 停止后 速度=0(直接调用)", 车.取速度() == 0)
    车 = 汽车()

    自行 = 自行车()
    检查("适配后 自行车初始速度=50(直接调用)", 自行.取速度() == 50)
    检查("适配后 自行车名称=通勤(直接调用)", 自行.取名称() == "通勤")

    // ---- 接口作函数参数（计算返回值，派发正常）----
    检查("接口作参数 汽车里程=200", 读取里程(车) == 200)
    检查("接口作参数 自行车里程=100", 读取里程(自行) == 100)
    检查("接口作参数 多态 里程不同", 读取里程(车) != 读取里程(自行))

    // ---- 接口数组元素（计算返回值，派发正常）----
    车队 = [车, 自行]
    检查("接口数组 长度=2", 车队.长度() == 2)
    检查("接口数组 元素1 里程=200", 车队[1].里程() == 200)
    检查("接口数组 元素2 里程=100", 车队[2].里程() == 100)
    检查("接口数组 元素1 名称=红旗(直接读)", 车队[1].取名称() == "红旗")
    检查("接口数组 元素2 名称=通勤(直接读)", 车队[2].取名称() == "通勤")

    // ---- 接口数组元素 字段写回（验证接收者写回已闭环）----
    车队[1].停止()
    检查("接口数组元素 字段写回 速度=0", 车队[1].取速度() == 0)

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
