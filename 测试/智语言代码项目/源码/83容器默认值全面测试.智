// 测试 规范 §2.3.4 默认值规则 + §2.3.2 类型声明规则：
//   容器类型（数组、映射）有自然零值 [] / {}，显式声明可省略初始化。
// 规范依据：
//   第 1295 行「容器类型（数组、映射）：有默认值 []/{}，隐式声明必须赋值，显式声明可省略初始化。」
//   第 1341/1345/1350/1354 行四种写法示例（有约束/无约束 × 数组/映射）
//   第 1523-1526 行「声明写法总表」：数组/映射 均「可省略 | 默认 [] / {}」
// ★判定设计★ 用「.长度()==0 且 .追加()/.插入() 成功」证明得到的是**真空容器**而不是空值：
//   空值调用容器方法必报错 ⇒ 若默认值误为空值，本用例必然失败。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  PASS " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  FAIL " + 名称)
    结束
结束

启动程序():
    // ── 一、显式声明省略初始化：四种容器写法（规范第 1338-1354 行）──
    数组<整数> 有约束数组
    检查("有约束数组 默认长度0", 有约束数组.长度() == 0)
    有约束数组.追加(7)
    检查("有约束数组 可追加(证明是空数组非空值)", 有约束数组.长度() == 1)

    数组 无约束数组
    检查("无约束数组 默认长度0", 无约束数组.长度() == 0)
    无约束数组.追加("文本元素")
    无约束数组.追加(真)
    检查("无约束数组 可追加异质元素", 无约束数组.长度() == 2)

    映射<文本, 整数> 有约束映射
    检查("有约束映射 默认长度0", 有约束映射.长度() == 0)
    有约束映射.插入("甲", 1)
    检查("有约束映射 可插入(证明是空映射非空值)", 有约束映射["甲"] == 1)

    映射 无约束映射
    检查("无约束映射 默认长度0", 无约束映射.长度() == 0)
    无约束映射.插入("键", "值")
    检查("无约束映射 可插入", 无约束映射.长度() == 1)

    // ── 二、与显式初始化 []/{} 行为一致（等价性对照）──
    数组<整数> 显式空数组 = []
    映射<文本, 整数> 显式空映射 = {}
    检查("显式[] 也是空数组", 显式空数组.长度() == 0)
    检查("显式{} 也是空映射", 显式空映射.长度() == 0)

    // ── 三、每个声明点各自求值 ⇒ 两变量绝不共享同一容器 ──
    数组<整数> 容器甲
    数组<整数> 容器乙
    容器甲.追加(1)
    容器甲.追加(2)
    检查("两数组变量不共享(甲=2)", 容器甲.长度() == 2)
    检查("两数组变量不共享(乙=0)", 容器乙.长度() == 0)

    映射<文本, 整数> 映射甲
    映射<文本, 整数> 映射乙
    映射甲.插入("k", 9)
    检查("两映射变量不共享(甲=1)", 映射甲.长度() == 1)
    检查("两映射变量不共享(乙=0)", 映射乙.长度() == 0)

    // ── 四、基本类型默认值（对照组，行为不变）──
    整数 计数
    小数 温度
    文本 名称
    逻辑 开关
    空值 结果
    检查("整数 默认0", 计数 == 0)
    检查("小数 默认0.0", 温度 == 0.0)
    检查("文本 默认空串", 名称 == "")
    检查("逻辑 默认假", 开关 == 假)
    检查("空值 默认空值", 结果 == 空值)

    输出("通过数 = " + 转文本(本模块.通过数) + " / 总数 = " + 转文本(本模块.总数))
结束
