// ============================================================
// 结构体参数 与 函数参数 一致性测试
// 覆盖规范：
//   ① 结构体参数可赋值（赋值 = 新建同名局部变量遮蔽参数，不改实例）
//      —— §2.3.5 L1928 / §L4620 / §四者对比总表 L4721 / L4709
//   ② 结构体参数支持默认值（调用时可省略），与函数参数默认值规则一致
//      —— §L4158-4269「结构体参数赋默认值」
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 结构体参数带默认值（规则同函数参数默认值）──
结构体 矩形丙(小数 宽 = 2.0, 小数 高 = 3.0):
    获取宽() 小数:
        返回 宽
    结束
    获取高() 小数:
        返回 高
    结束
    // 赋值结构体参数：相当于新建同名局部变量（遮蔽参数），不改实例
    改宽(小数 新值):
        宽 = 新值
    结束
    改宽并读(小数 新值) 小数:
        宽 = 新值
        返回 宽
    结束
结束

测试_参数默认值():
    全默认 = 矩形丙()
    检查("默认值-全省略-宽=2.0", 全默认.获取宽() == 2.0)
    检查("默认值-全省略-高=3.0", 全默认.获取高() == 3.0)
    部分 = 矩形丙(5.0)
    检查("默认值-只传宽-宽=5.0", 部分.获取宽() == 5.0)
    检查("默认值-只传宽-高=3.0", 部分.获取高() == 3.0)
    全传 = 矩形丙(5.0, 6.0)
    检查("默认值-全传-宽=5.0", 全传.获取宽() == 5.0)
    检查("默认值-全传-高=6.0", 全传.获取高() == 6.0)
结束

测试_参数可赋值():
    甲 = 矩形丙(1.0, 2.0)
    甲.改宽(99.0)
    检查("赋值-方法内新值生效(改宽并读=99)", 甲.改宽并读(99.0) == 99.0)
    检查("赋值-不修改实例参数(获取宽仍=1.0)", 甲.获取宽() == 1.0)
    乙 = 矩形丙(7.0, 8.0)
    检查("赋值-不跨实例污染(乙宽=7.0)", 乙.获取宽() == 7.0)
    检查("赋值-乙高=8.0", 乙.获取高() == 8.0)
结束

启动程序():
    输出("========== 结构体参数赋值与默认值测试 ==========")
    测试_参数默认值()
    测试_参数可赋值()
    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
