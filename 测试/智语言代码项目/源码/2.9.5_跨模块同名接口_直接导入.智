// 规范 §2.7.4 + §2.9：两个模块各自定义「同名接口 + 同名方法 + 不同返回类型」
// 消费者**直接导入**两者 ⇒ 接口身份必须按模块区分，方法返回类型不得串味。
// （曾缺陷：甲库 `取值() 文本` 覆盖乙库 `取值() 整数` ⇒ `乙.取值() + 5` 被误判「文本 和 整数」）
导入 聚合校验/接口库甲
导入 聚合校验/接口库乙

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== §2.9.5 跨模块同名接口 · 直接导入 =====")

    接口库甲.型可命名 甲 = 接口库甲.型甲("x")
    检查("甲.取值() = 甲:x（文本）", 甲.取值() == "甲:x")
    检查("甲 类型敏感：文本拼接", 甲.取值() + "尾巴" == "甲:x尾巴")

    接口库乙.型可命名 乙 = 接口库乙.型乙(3)
    检查("乙.取值() = 30（整数）", 乙.取值() == 30)
    检查("乙 类型敏感：整数加法", 乙.取值() + 5 == 35)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
