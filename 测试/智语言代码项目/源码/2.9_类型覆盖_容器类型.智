// 规范 §2.9.2：聚合导入（展开形式）后访问 —— 全部「容器类型」成员
//   展开形式 ⇒ 只留裸名（源模块名前缀去掉），子命名空间不可用
//   覆盖：数组 / 映射 / 嵌套容器 / 容器常量 / 容器函数（参数与返回）/ 结构体容器字段

导入 聚合校验/类型_展开 展开

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== §2.9 聚合导入 · 成员类型覆盖（容器类型）=====")

    // —— 数组变量 ——
    检查("数组变量 长度=3", 型数组变量.长度() == 3)
    检查("数组变量 [1]=1", 型数组变量[1] == 1)
    检查("数组变量 [3]=3", 型数组变量[3] == 3)

    // —— 映射变量 ——
    检查("映射变量 长度=2", 型映射变量.长度() == 2)
    检查("映射变量 获取(甲)=1", 型映射变量.获取("甲") == 1)
    检查("映射变量 获取(乙)=2", 型映射变量.获取("乙") == 2)

    // —— 嵌套容器 ——
    检查("矩阵 行数=2", 型矩阵变量.长度() == 2)
    检查("矩阵 [1][2]=2", 型矩阵变量[1][2] == 2)
    检查("矩阵 [2][1]=3", 型矩阵变量[2][1] == 3)
    检查("映射数组 获取(组)[2]=6", 型映射数组变量.获取("组")[2] == 6)

    // —— 容器常量 ——
    检查("文本数组常量 长度=3", 型文本数组常量.长度() == 3)
    检查("文本数组常量 [2]=乙", 型文本数组常量[2] == "乙")

    // —— 容器函数：容器作参数 ——
    检查("型数组求和([1,2,3])=6", 型数组求和([1, 2, 3]) == 6)
    检查("型数组求和(型数组变量)=6", 型数组求和(型数组变量) == 6)
    检查("型嵌套求和([[1,2],[3,4]])=10", 型嵌套求和([[1, 2], [3, 4]]) == 10)

    // —— 容器函数：返回容器 ——
    结果数组 = 型造数组(5)
    检查("型造数组(5) 长度=2", 结果数组.长度() == 2)
    检查("型造数组(5)[1]=5", 结果数组[1] == 5)
    检查("型造数组(5)[2]=6", 结果数组[2] == 6)

    结果映射 = 型造映射()
    检查("型造映射 长度=2", 结果映射.长度() == 2)
    检查("型造映射 获取(甲)=10", 结果映射.获取("甲") == 10)
    检查("型造映射 获取(乙)=20", 结果映射.获取("乙") == 20)

    // —— 结构体：容器字段 + 容器方法 ——
    盒 = 型容器盒([4, 5, 6])
    检查("结构体容器字段 总量=15", 盒.总量() == 15)
    检查("结构体容器字段 数据长度=3", 盒.数据.长度() == 3)
    检查("结构体映射字段 计数(甲)=1", 盒.计数.获取("甲") == 1)
    检查("结构体方法返回容器 长度=3", 盒.取数据().长度() == 3)
    检查("结构体方法返回容器 [2]=5", 盒.取数据()[2] == 5)
    检查("结构体作函数参数 型盒总量=15", 型盒总量(盒) == 15)

    // —— 聚合导出的结构体：容器字段**可写**（不是只读副本）——
    盒.数据 = [1, 2, 3, 4]
    检查("容器字段整体赋值后 总量=10", 盒.总量() == 10)
    检查("容器字段整体赋值后 长度=4", 盒.数据.长度() == 4)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
