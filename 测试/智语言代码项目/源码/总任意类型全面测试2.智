// 一、有名任意类型 无约束：类型守恒
测试有名无约束():
    整数 整数结果 = 取原样(10)
    检查("有名无约束 整数守恒", 整数结果 == 10)
    文本 文本结果 = 取原样("你好")
    检查("有名无约束 文本守恒", 文本结果 == "你好")
    小数 小数结果 = 取原样(3.14)
    检查("有名无约束 小数守恒", 小数结果 == 3.14)
    逻辑 逻辑结果 = 取原样(真)
    检查("有名无约束 逻辑守恒", 逻辑结果 == 真)
结束

// 二、有名任意类型 有约束：类型守恒 + 多约束
测试有名约束():
    整数 较大整数 = 取较大值(10, 20)
    检查("有名约束 整数取较大", 较大整数 == 20)
    小数 较大小数 = 取较大值(3.5, 2.1)
    检查("有名约束 小数取较大", 较大小数 == 3.5)

    整数 回声整数 = 回声(42)
    检查("多约束 整数守恒", 回声整数 == 42)
    文本 回声文本 = 回声("消息")
    检查("多约束 文本守恒", 回声文本 == "消息")
    逻辑 回声逻辑 = 回声(假)
    检查("多约束 逻辑守恒", 回声逻辑 == 假)
结束

// 三、匿名任意类型：变量声明（必须显式初始化）+ 重新赋值跨类型
测试匿名变量():
    任意<整数|文本> 可变数据 = 42
    检查("匿名变量 初始整数", 可变数据 == 42)
    可变数据 = "状态更新"
    检查("匿名变量 重赋文本", 可变数据 == "状态更新")
    可变数据 = 99
    检查("匿名变量 重赋整数", 可变数据 == 99)

    // 单类型约束（匿名任意：用 任意<整数|小数> 形式，规范允许约束范围写法）
    任意<整数|小数> 单类型 = 7
    检查("匿名变量 单类型约束", 单类型 == 7)
    单类型 = 3.5
    检查("匿名变量 单类型约束重赋小数", 单类型 == 3.5)

    // 含空值约束
    任意<整数|文本|空值> 可能姓名 = 空值
    检查("匿名变量 含空值初始", 可能姓名 == 空值)
    可能姓名 = "张三"
    检查("匿名变量 含空值重赋", 可能姓名 == "张三")
    可能姓名 = 空值
    检查("匿名变量 重赋回空值", 可能姓名 == 空值)
结束

// 四、匿名任意类型返回值：多分支
测试匿名返回():
    任意<小数|文本> 结果1 = 安全除法(10.0, 2.0)
    检查("匿名返回 小数分支", 结果1 == 5.0)
    任意<小数|文本> 结果2 = 安全除法(10.0, 0.0)
    检查("匿名返回 文本分支", 结果2 == "除数不能为零")

    整数 标签1 = 取标签(1)
    检查("匿名返回 整数分支", 标签1 == 100)
    文本 标签2 = 取标签(2)
    检查("匿名返回 文本分支", 标签2 == "文本标签")
    逻辑 标签3 = 取标签(3)
    检查("匿名返回 逻辑分支", 标签3 == 真)
结束

// 五、接收方式一（具体类型接收）vs 方式二（运行时类型判断分发）
分发处理(任意<甲> 数据) 空值:
    如果 类型(数据) == "整数":
        整数 数字 = 数据
        输出("    分发到整数：" + 转文本(数字))
    否则如果 类型(数据) == "文本":
        文本 文字 = 数据
        输出("    分发到文本：" + 文字)
    否则如果 类型(数据) == "逻辑":
        逻辑 标志 = 数据
        输出("    分发到逻辑：" + 转文本(标志))
    否则:
        输出("    分发到其他类型")
    结束
    返回 空值
结束

测试接收分发():
    分发处理(100)
    分发处理("消息")
    分发处理(真)
    // 方式一：内置容器类型已知
    数组<整数> 数字列表 = [1, 2, 3]
    整数 第一个 = 数字列表[1]
    检查("方式一 具体类型接收", 第一个 == 1)
    检查("方式一 类型守恒接收", 取原样(数字列表[2]) == 2)
结束

