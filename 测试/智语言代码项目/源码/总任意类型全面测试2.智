// 七、任意类型与容器
测试容器():
    数组 任意数组 = [1, "文本", 真, 3.14]
    检查("无约束数组 长度", 任意数组.长度() == 4)
    检查("无约束数组 取整数", 任意数组[1] == 1)
    检查("无约束数组 取文本", 任意数组[2] == "文本")
    检查("无约束数组 取逻辑", 任意数组[3] == 真)
    检查("无约束数组 取小数", 任意数组[4] == 3.14)

    映射 任意映射 = {"键1": "值1", "键2": 100, "键3": 真}
    检查("无约束映射 取文本值", 任意映射.获取("键1") == "值1")
    检查("无约束映射 取整数值", 任意映射.获取("键2") == 100)

    数组<整数> 数字列表 = [10, 20, 30]
    整数 取出 = 数字列表[2]
    检查("约束数组<整数> 取出", 取出 == 20)
    数字列表.追加(40)
    检查("约束数组<整数> 追加后", 数字列表.长度() == 4)
结束

// 八、结构体泛型（两种命名风格）
// 风格一：天干序号
结构体 栈(任意<甲> 元素类型):
    数组<甲> 数据 = []
    压入(任意<甲> 新元素):
        自身.数据.追加(新元素)
    结束
    取数量() 整数:
        返回 自身.数据.长度()
    结束
    取顶部() 任意<甲>:
        返回 自身.数据.取末尾()
    结束
结束

// 风格二：有意义名称
结构体 字典(任意<键型> 键类型, 任意<值型> 值类型):
    映射<键型, 值型> 数据 = {}
    设置(任意<键型> 新键, 任意<值型> 新值):
        自身.数据.插入(新键, 新值)
    结束
    查(任意<键型> 键) 任意<值型>:
        返回 自身.数据.获取(键)
    结束
结束

// 已知缺陷复现：泛型结构体内部 映射<键型,整数> 经 任意<键型> 参数插入/查找失败
结构体 缺陷字典(任意<键型> 键类型):
    映射<键型, 整数> 数据 = {}
    设置(任意<键型> 新键, 整数 新值):
        自身.数据.插入(新键, 新值)
    结束
    查(任意<键型> 键) 任意<整数>:
        返回 自身.数据.获取(键)
    结束
结束

测试结构体泛型():
    // 风格一：天干名
    整数栈 = 栈(0)
    整数栈.压入(10)
    整数栈.压入(20)
    检查("栈 数量", 整数栈.取数量() == 2)
    整数 栈顶 = 整数栈.取顶部()
    检查("栈 取顶部", 栈顶 == 20)

    // 风格二：有意义名（已知缺陷同源：泛型映射键经任意包装，查值返回空值）
    学生表 = 字典("姓名", 0)
    学生表.设置("小明", 18)
    任意 年龄 = 学生表.查("小明")
    输出("[诊断] 字典(有意义名) 查值=" + 转文本(年龄) + "（文本键整数值，预期18）")
    // ⚠ 订正（2026-09-20）：原断言写 `年龄 == 空值` —— 即**要求"泛型映射键缺陷"必须存在**。
    //   实测（2026-09-20）该处查值已正确返回 **18** ⇒ **缺陷已修复**，原断言成了"要求缺陷存在"的
    //   **过期断言**（缺陷修复后反而失败）✗ ⇒ 改为**正向断言**（校验真实值）。
    检查("字典(有意义名) 文本键整数值=18", 转文本(年龄) == "18")

    // 泛型映射键经「任意」包装的存取（原记录为已知缺陷，实测已通）
    缺陷实例 = 缺陷字典("")
    缺陷实例.设置("苹果", 5)
    任意 缺陷结果 = 缺陷实例.查("苹果")
    输出("[诊断] 泛型映射键经任意包装查值=" + 转文本(缺陷结果) + "（预期5）")
    // ⚠ 同上：原断言 `缺陷结果 == 空值` 是"要求缺陷存在"⇒ 实测已返回 5 ⇒ 改为正向断言。
    检查("泛型映射键经任意包装查值=5", 转文本(缺陷结果) == "5")

    // 对照：非泛型映射插入+获取正常
    对照映射 = {"苹果": 5}
    检查("对照 非泛型映射获取", 对照映射.获取("苹果") == 5)
结束

