// 【规范 §2.9.2 守护用例 —— 标准库聚合导入 默认形式（消费者侧）】
//   门面模块：源码/数学默认门面.智（`聚合导入 数学`，纯净聚合模块）
//   规范 §2.9.2 外部访问形式：子命名空间保留源模块名 ⇒ `数学默认门面.数学.成员`
//   ⇒ 验证标准库可作为聚合导入的目标（默认形式），且与展开/别名形式并存不冲突。
导入 数学默认门面

通过数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    结束
结束

启动程序():
    输出("===== §2.9.2 标准库聚合导入 默认形式（子命名空间保留源模块名） =====")

    检查("数学默认门面.数学.绝对值(-3)=3", 数学默认门面.数学.绝对值(-3) == 3)
    检查("数学默认门面.数学.最大值(2,7)=7", 数学默认门面.数学.最大值(2, 7) == 7)
    检查("数学默认门面.数学.最小值(2,7)=2", 数学默认门面.数学.最小值(2, 7) == 2)
    检查("数学默认门面.数学.取整(3.7)=3", 数学默认门面.数学.取整(3.7) == 3)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
