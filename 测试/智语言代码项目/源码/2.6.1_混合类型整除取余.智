测试_全部():
    检查("整数%%整数", 10 %% 3 == 3)
    检查("整数%%小数", 10 %% 3.0 == 3)
    检查("小数%%小数", 10.5 %% 3.0 == 3)
    检查("整数%整数", 10 % 3 == 1)
    检查("整数%小数", 10 % 3.0 == 1)
    检查("小数%小数", 10.5 % 3.0 == 1.5)
    检查("负数整除向下取整-11%%3", -11 %% 3 == -4)
    检查("负数取余非负-11%3", -11 % 3 == 1)
    检查("负数%%小数", -11 %% 3.0 == -4)
    检查("负数%小数非负", -11 % 3.0 == 1)
    检查("恒等式(整数)", 3 * (-11 %% 3) + (-11 % 3) == -11)
    检查("恒等式(小数)", 3.0 * (-11.0 %% 3.0) + (-11.0 % 3.0) == -11.0)
    检查("25%%10=2", 25 %% 10 == 2)
    检查("25%10=5", 25 % 10 == 5)
    检查("除法混合提升 10/4.0", 10 / 4.0 == 2.5)
    检查("除法整数得小数 10/4", 10 / 4 == 2.5)
