// 273 工具模块：**正则进阶** + **JSON / CSV 往返保真**（2026-10-22）
//
// 与 220 的分工：220 覆盖 §5.6.1~5.6.5 的"能用"（基本匹配/标准向量/大小写敏感/空白容忍）；
//   本用例专攻**真实项目里最容易出问题**的两块：
//     ① 正则：全局匹配语义、锚点、贪婪 vs 非贪婪、量词、交替、空模式、非法模式报错、捕获引用 `$1`；
//     ② 数据往返保真：紧凑输出格式、嵌套、空容器、`null`⇒`空值`、小数精度、**> 2^53 的大整数**、
//        科学计数、转义引号、非法 JSON 的报错可读性；CSV 二维解析与生成。
//
// ⚠ 参数顺序（§5.6.2，极易写错 ⇒ 会误判成"替换坏了"）：
//   `工具.正则替换(文本 模式, 文本 替换文本, 文本 原文)` —— 原文在**第三个**参数。
//
// 断言值全部来自探针实测（`探针_工具正则与数据.智`），非规范推测。
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 273 工具模块：正则进阶 / JSON·CSV 往返保真 ===")

    // ───────── ① 正则匹配：全局语义与结构 ─────────
    输出("-- ① 正则匹配 --")
    数字们 = 工具.正则匹配("\反斜杠d+", "a12b345")
    检查("返回类型 = 数组", 类型(数字们) == "数组")
    检查("★ 全局匹配：a12b345 里的数字 ⇒ 2 段", 数字们.长度() == 2)
    检查("首段 = 12", 数字们.获取(1) == "12")
    检查("次段 = 345", 数字们.获取(2) == "345")
    检查("★ 无匹配 ⇒ 空数组（不是空值/不抛异常）", 工具.正则匹配("\反斜杠d+", "abc").长度() == 0)
    检查("锚点 行首 ^ ⇒ 命中 12", 工具.正则匹配("^\反斜杠d+", "12a").获取(1) == "12")
    检查("锚点 行尾 $ ⇒ 命中 12", 工具.正则匹配("\反斜杠d+$", "a12").获取(1) == "12")
    检查("★ 贪婪 a.*b ⇒ 整段 a1b2b", 工具.正则匹配("a.*b", "a1b2b").获取(1) == "a1b2b")
    检查("★ 非贪婪 a.*?b ⇒ 只到第一个 b", 工具.正则匹配("a.*?b", "a1b2b").获取(1) == "a1b")
    检查("交替 甲|乙 ⇒ 命中 甲", 工具.正则匹配("甲|乙", "丙甲").获取(1) == "甲")
    量词 = 工具.正则匹配("\反斜杠d{2}", "1234")
    检查("量词 {2} ⇒ 非重叠 2 段", 量词.长度() == 2)
    检查("量词首段 = 12、次段 = 34", 量词.获取(1) == "12" 且 量词.获取(2) == "34")
    检查("★ 空模式 ⇒ 每个位置都匹配（长度 = 源长 + 1 = 4）",
        工具.正则匹配("", "abc").长度() == 4)
    检查("★ 捕获组只返回整体匹配（不含分组内容）",
        工具.正则匹配("(\反斜杠d+)", "a12").获取(1) == "12")

    非法模式被拒 = 假
    非法模式描述 = ""
    捕获:
        坏 = 工具.正则匹配("(", "a")
        坏 = 坏.长度()
    异常:
        非法模式被拒 = 真
        非法模式描述 = 异常错误().描述
    结束
    检查("★ 非法正则 ⇒ 抛可捕获异常（不是静默空数组）", 非法模式被拒)
    // ⚠ 不原样打印报错文案：其中含「语法错误: 」会被门禁的"错误[:：]"标志误判为运行出错
    记录("非法正则的报错是否含关键词（正则表达式语法错误）",
        转文本(非法模式描述.是否包含("正则表达式语法错误")))
    检查("错误文案指明「正则表达式语法错误」", 非法模式描述.是否包含("正则表达式语法错误"))

    // ───────── ② 正则替换（模式, 替换, 原文）─────────
    输出("-- ② 正则替换 --")
    检查("★ 全局替换：a1b2 的数字 ⇒ aXbX", 工具.正则替换("\反斜杠d", "X", "a1b2") == "aXbX")
    检查("★ 捕获引用 $1：a1 ⇒ a[1]", 工具.正则替换("(\反斜杠d)", "[$1]", "a1") == "a[1]")
    检查("无匹配 ⇒ 原文原样返回", 工具.正则替换("\反斜杠d", "X", "abc") == "abc")
    检查("替换为空串 ⇒ 删除匹配项（a1 ⇒ a）", 工具.正则替换("\反斜杠d", "", "a1") == "a")
    检查("返回类型 = 文本", 类型(工具.正则替换("\反斜杠d", "X", "a1")) == "文本")
    检查("替换多段：a1b2c3 ⇒ a##b##c##",
        工具.正则替换("\反斜杠d", "##", "a1b2c3") == "a##b##c##")

    // ───────── ③ JSON 生成（紧凑格式）─────────
    输出("-- ③ JSON 生成 --")
    生成数组 = 工具.生成数据("JSON", [1, 2.5, 真, 空值, "文本"])
    记录("数组生成结果", 生成数组)
    检查("★ 无多余空格（紧凑）：[1,2.5,true,null,…]",
        生成数组 == "[1,2.5,true,null,\引号文本\引号]")
    检查("映射生成 = 甲 键:1（紧凑、无空格）", 工具.生成数据("JSON", {"甲": 1}) == "{\引号甲\引号:1}")
    检查("空数组生成 = []", 工具.生成数据("JSON", []) == "[]")
    检查("空映射生成 = {}", 工具.生成数据("JSON", {}) == "{}")
    检查("嵌套生成含内层括号",
        工具.生成数据("JSON", [[1], {"甲": 2}]) == "[[1],{\引号甲\引号:2}]")
    含引号文本 = 工具.生成数据("JSON", ["a\引号b"])
    记录("含引号文本的生成结果", 含引号文本)
    检查("生成含引号文本时自动转义（出现 反斜杠+引号）", 含引号文本.是否包含("\反斜杠\引号"))
    检查("生成结果首尾带引号", 含引号文本 == "[\引号a\反斜杠\引号b\引号]")

    // ───────── ④ JSON 解析（往返保真）─────────
    输出("-- ④ JSON 解析往返 --")
    往返 = 工具.解析数据("JSON", 生成数组)
    记录("往返结果", 转文本(往返))
    检查("往返：类型仍是数组", 类型(往返) == "数组")
    检查("往返：长度 5", 往返.长度() == 5)
    检查("往返：整数保真 1", 往返.获取(1) == 1)
    检查("往返：小数保真 2.5", 往返.获取(2) == 2.5)
    检查("往返：逻辑保真 真", 往返.获取(3) == 真)
    检查("往返：null ⇒ 空值", 往返.获取(4) == 空值)
    检查("往返：文本保真", 往返.获取(5) == "文本")

    嵌套 = 工具.解析数据("JSON", "[[1],[2,3]]")
    检查("嵌套数组层数正确", 类型(嵌套) == "数组" 且 类型(嵌套.获取(1)) == "数组")
    检查("嵌套内层长度 1 与 2", 嵌套.获取(1).长度() == 1 且 嵌套.获取(2).长度() == 2)
    检查("空数组解析 ⇒ 长度 0", 工具.解析数据("JSON", "[]").长度() == 0)
    检查("空映射解析 ⇒ 长度 0", 工具.解析数据("JSON", "{}").长度() == 0)
    检查("裸 null ⇒ 空值", 工具.解析数据("JSON", "null") == 空值)
    检查("★ 小数精度保真：3.141592653589793",
        工具.解析数据("JSON", "3.141592653589793") == 3.141592653589793)
    检查("★★ 大整数（> 2^53）保真：9007199254740993",
        转文本(工具.解析数据("JSON", "9007199254740993")) == "9007199254740993")
    检查("科学计数 1e3 ⇒ 1000.0（小数）", 工具.解析数据("JSON", "1e3") == 1000)
    检查("负数 -42 ⇒ -42", 工具.解析数据("JSON", "-42") == 0 - 42)
    检查("含转义引号的文本解析正确",
        工具.解析数据("JSON", "{\引号甲\引号: \引号乙\反斜杠\引号丙\引号}").获取("甲") == "乙\引号丙")

    非法数据被拒 = 假
    非法数据描述 = ""
    捕获:
        坏二 = 工具.解析数据("JSON", "{")
        坏二 = 坏二.长度()
    异常:
        非法数据被拒 = 真
        非法数据描述 = 异常错误().描述
    结束
    检查("★ 非法 JSON ⇒ 抛可捕获异常（不是静默空值）", 非法数据被拒)
    记录("非法 JSON 的错误文案", 非法数据描述)
    检查("错误文案指明「JSON 解析失败」", 非法数据描述.是否包含("JSON 解析失败"))

    // ───────── ⑤ CSV 往返 ─────────
    输出("-- ⑤ CSV --")
    表 = 工具.解析数据("CSV", "甲,乙\换行1,2")
    记录("CSV 解析结果", 转文本(表))
    检查("CSV 解析 ⇒ 二维数组（2 行）", 表.长度() == 2)
    检查("首行 2 列", 表.获取(1).长度() == 2)
    检查("首行首列 = 甲", 表.获取(1).获取(1) == "甲")
    检查("次行次列 = 2", 表.获取(2).获取(2) == "2")
    检查("单行 CSV ⇒ 1 行 2 列",
        工具.解析数据("CSV", "甲,乙").长度() == 1 且 工具.解析数据("CSV", "甲,乙").获取(1).长度() == 2)
    生成结果 = 工具.生成数据("CSV", [["甲", "乙"], ["1", "2"]])
    记录("CSV 生成结果", 生成结果)
    检查("CSV 生成含逗号分隔与换行", 生成结果.是否包含(",") 且 生成结果.是否包含("\换行"))
    检查("CSV 生成首行以 甲 开头", 生成结果.是否包含("甲,乙"))

    // ───────── ⑥ 跨函数组合（正则 + JSON + 时间）─────────
    输出("-- ⑥ 组合 --")
    原文 = "订单号:A1001 金额:250.50"
    号码们 = 工具.正则匹配("A\反斜杠d+", 原文)
    检查("组合：从文本中提取订单号", 号码们.长度() == 1 且 号码们.获取(1) == "A1001")
    脱敏 = 工具.正则替换("\反斜杠d", "*", "A1001")
    检查("组合：订单号脱敏 ⇒ A****", 脱敏 == "A****")
    数据文本 = 工具.生成数据("JSON", {"号码": 号码们.获取(1), "脱敏": 脱敏})
    检查("组合：生成的 JSON 含两个键值",
        数据文本.是否包含("A1001") 且 数据文本.是否包含("A****"))
    回读 = 工具.解析数据("JSON", 数据文本)
    检查("组合：回读后取回号码", 回读.获取("号码") == "A1001")
    检查("组合：回读后取回脱敏串", 回读.获取("脱敏") == "A****")

    收尾()
结束
