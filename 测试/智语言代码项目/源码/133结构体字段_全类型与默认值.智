结构体 内部结构():
    整数 值 = 0
结束

默认回调():
    输出("  （默认回调）")
结束

结构体 全类型字段(文本 名称):
    整数 计数
    小数 比例
    文本 描述
    逻辑 启用
    空值 父节点
    数组<整数> 分数
    数组 任意列表
    映射<文本, 整数> 成绩
    映射 任意映射
    任意<整数|文本> 灵活数据 = 0
    函数() 空值 回调 = 默认回调
    内部结构 子对象 = 内部结构()
    颜色 主题色 = 颜色.红色
    任意<可移动|空值> 当前车辆 = 空值
结束

结构体 可见性示例():
    文本 姓名
    私有 文本 密码 = "秘密"
    常量 版本号 = "1.0.0"
    超时秒数 = 30
    取密码() 文本:
        返回 自身.密码
    结束
结束

启动程序():
    输出("=== 133 结构体字段全类型 ===")
    甲 = 全类型字段("整体")
    检查("字段-整数默认0", 甲.计数 == 0)
    检查("字段-小数默认0.0", 甲.比例 == 0.0)
    检查("字段-文本默认空文本", 甲.描述 == "")
    检查("字段-逻辑默认假", 甲.启用 == 假)
    检查("字段-空值默认空值", 甲.父节点 == 空值)
    检查("字段-数组默认[]", 甲.分数.长度() == 0)
    检查("字段-无约束数组默认[]", 甲.任意列表.长度() == 0)
    检查("字段-映射默认{}", 甲.成绩.长度() == 0)
    检查("字段-无约束映射默认{}", 甲.任意映射.长度() == 0)
    检查("字段-任意类型-显式初始化", 甲.灵活数据 == 0)
    检查("字段-函数类型-必须有函数值", 甲.回调 != 空值)
    甲.回调()
    检查("字段-函数类型可调用", 真)
    检查("字段-结构体类型-必须初始化", 甲.子对象.值 == 0)
    检查("字段-枚举类型-必须初始化", 甲.主题色 == 颜色.红色)
    检查("字段-接口字段用任意包装-初值空值", 甲.当前车辆 == 空值)
    乙 = 可见性示例("乙")
    检查("字段-构造参数按实参", 乙.姓名 == "乙")
    检查("字段-私有字段(经方法访问)", 乙.取密码() == "秘密")
    检查("字段-常量字段", 乙.版本号 == "1.0.0")
    检查("字段-隐式推断字段", 乙.超时秒数 == 30)
    收尾()
结束
