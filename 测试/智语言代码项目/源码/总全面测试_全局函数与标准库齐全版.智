导入 时间
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 += 1
        输出("  ❌ " + 名称)
    结束
结束

示例函数():
    返回 1
结束

结构体 点:
    整数 横坐标
    整数 纵坐标
    初始化():
        自身.横坐标 = 3
        自身.纵坐标 = 4
    结束
结束

启动程序():
    输出("===== ZZ 全面测试（规范齐全版） =====")

    // ===================== 一、8 个全局函数（规范 §4.1） =====================
    输出("===== 一、8 个全局函数 =====")
    输出("全局函数-输出")
    错误输出("全局函数-错误输出")
    检查("输出/错误输出 不崩溃", 真)
    检查("转文本(整数)='42'", 转文本(42) == "42")
    检查("转文本(小数)='3.14'", 转文本(3.14) == "3.14")
    检查("转文本(逻辑真)='真'", 转文本(真) == "真")
    检查("转文本(逻辑假)='假'", 转文本(假) == "假")
    检查("转文本(数组)='[1, 2, 3]'", 转文本([1, 2, 3]) == "[1, 2, 3]")
    检查("转文本(映射) 含键", 转文本({"x": 1}).是否包含("x"))
    检查("转整数(文本'123')=123", 转整数("123") == 123)
    检查("转整数(文本'-9')=-9", 转整数("-9") == -9)
    检查("转整数(小数2.9)=2 向零取整", 转整数(2.9) == 2)
    检查("转整数(小数-2.9)=-2 向零取整", 转整数(-2.9) == -2)
    检查("转整数(整数)=恒等", 转整数(7) == 7)
    整数异常 = 假
    捕获:
        转整数("abc")
    异常:
        整数异常 = 真
    结束
    检查("转整数(非法文本) 抛异常", 整数异常 == 真)
    检查("转小数(整数)=42.0", 转小数(42) == 42.0)
    检查("转小数(文本'2.5')=2.5", 转小数("2.5") == 2.5)
    小数异常 = 假
    捕获:
        转小数("xyz")
    异常:
        小数异常 = 真
    结束
    检查("转小数(非法文本) 抛异常", 小数异常 == 真)
    检查("类型(整数)='整数'", 类型(42) == "整数")
    检查("类型(小数)='小数'", 类型(3.14) == "小数")
    检查("类型(文本)='文本'", 类型("你") == "文本")
    检查("类型(逻辑)='逻辑'", 类型(真) == "逻辑")
    检查("类型(空值)='空值'", 类型(空值) == "空值")
    检查("类型(数组)='数组'", 类型([1, 2]) == "数组")
    检查("类型(映射)='映射'", 类型({"a": 1}) == "映射")
    检查("类型(函数)='函数'", 类型(示例函数) == "函数")
    点实例 = 点()
    检查("类型(结构体实例)='点'", 类型(点实例) == "点")
    捕获:
        抛出 "构造消息"
    异常:
        错误对象 = 异常错误()
        检查("异常错误() 描述=构造消息", 错误对象.描述 == "构造消息")
        检查("异常错误() 类型='异常错误'", 类型(错误对象) == "异常错误")
        检查("异常错误() 格式信息() 非空", 错误对象.格式信息().长度() > 0)
        检查("异常错误() 格式信息() 含描述", 错误对象.格式信息().是否包含("构造消息"))
    结束
    构造错误 = 异常错误("直接构造")
    检查("异常错误(消息) 描述=直接构造", 构造错误.描述 == "直接构造")
    // 输入：非交互环境 stdin=EOF，应返回空文本而非崩溃
    输入值 = 输入()
    检查("输入() 返回文本类型", 类型(输入值) == "文本")

    // ===================== 二、文本 7 方法（规范 §4.2） =====================
    输出("===== 二、文本 7 方法 =====")
    原文 = "你好世界"
    检查("文本.长度 中文=4", 原文.长度() == 4)
    检查("文本.截取(1,2)='你好'", 原文.截取(1, 2) == "你好")
    检查("文本.截取(3,2)='世界'", 原文.截取(3, 2) == "世界")
    检查("文本.查找('世界')=3", 原文.查找("世界") == 3)
    检查("文本.查找('地球')=0", 原文.查找("地球") == 0)
    检查("文本.替换 结果正确", 原文.替换("世界", "朋友") == "你好朋友")
    分隔数组 = "苹果,香蕉,橙子".分隔(",")
    检查("文本.分隔 长度=3", 分隔数组.长度() == 3)
    检查("文本.分隔[3]='橙子'", 分隔数组[3] == "橙子")
    检查("文本.是否包含('你好')=真", 原文.是否包含("你好"))
    检查("文本.是否包含('再见')=假", 原文.是否包含("再见") == 假)
    检查("文本.去除空白 去首尾", "  你好  ".去除空白() == "你好")
    检查("文本 链式调用", "  你好世界  ".去除空白().替换("世界", "智语言").截取(1, 2) == "你好")

    // ===================== 三、数组 11 方法（规范 §4.3，补 .获取） =====================
    输出("===== 三、数组 11 方法 =====")
    数字数组 = [10, 20, 30, 40, 50]
    检查("数组.长度=5", 数字数组.长度() == 5)
    数字数组.追加(60)
    检查("数组.追加 长度=6", 数字数组.长度() == 6)
    检查("数组.追加 末位=60", 数字数组[6] == 60)
    数字数组.插入(1, 5)
    检查("数组.插入(1,5) 长度=7", 数字数组.长度() == 7)
    检查("数组.插入(1,5) 首=5", 数字数组[1] == 5)
    数字数组.删除(1)
    检查("数组.删除(1) 长度=6", 数字数组.长度() == 6)
    取末 = 数字数组.取末尾()
    检查("数组.取末尾=60", 取末 == 60)
    检查("数组.取末尾 后长度-1", 数字数组.长度() == 5)
    检查("数组.获取(1)=10", 数字数组.获取(1) == 10)
    检查("数组.获取(末位)=50", 数字数组.获取(5) == 50)
    检查("数组.是否包含(20)=真", 数字数组.是否包含(20))
    检查("数组.是否包含(99)=假", 数字数组.是否包含(99) == 假)
    检查("数组.查找索引(40)>0", 数字数组.查找索引(40) > 0)
    检查("数组.查找索引(99)=0", 数字数组.查找索引(99) == 0)
    数字数组.反转()
    检查("数组.反转 长度不变", 数字数组.长度() == 5)
    数字数组.反转()
    数字数组.排序()
    检查("数组.排序 长度=5", 数字数组.长度() == 5)
    数字数组.清空()
    检查("数组.清空 长度=0", 数字数组.长度() == 0)
    文本数组 = ["乙", "甲", "丙"]
    文本数组.排序()
    检查("数组.排序 文本 长度=3", 文本数组.长度() == 3)
    检查("数组.排序 文本 取末尾=甲", 文本数组.取末尾() == "甲")
    嵌套数组 = [[1, 2, 3], [4, 5, 6]]
    检查("嵌套数组.长度=2", 嵌套数组.长度() == 2)
    检查("嵌套数组[1].长度=3", 嵌套数组[1].长度() == 3)
    检查("多维访问 嵌套数组[1][2]=2", 嵌套数组[1][2] == 2)
    检查("多维访问 嵌套数组[2][3]=6", 嵌套数组[2][3] == 6)

    // ===================== 四、映射 8 方法（规范 §4.4） =====================
    输出("===== 四、映射 8 方法 =====")
    学生 = {"姓名": "小明", "年龄": 18, "班级": "一班"}
    检查("映射.长度=3", 学生.长度() == 3)
    所有键 = 学生.所有键()
    检查("映射.所有键 长度=3", 所有键.长度() == 3)
    所有值 = 学生.所有值()
    检查("映射.所有值 长度=3", 所有值.长度() == 3)
    学生.插入("性别", "男")
    检查("映射.插入 新增 长度=4", 学生.长度() == 4)
    学生.插入("年龄", 19)
    检查("映射.插入 覆盖 值=19", 学生.获取("年龄") == 19)
    学生.删除("班级")
    检查("映射.删除 后长度=3", 学生.长度() == 3)
    检查("映射.是否包含('姓名')=真", 学生.是否包含("姓名"))
    检查("映射.是否包含('班级')=假", 学生.是否包含("班级") == 假)
    检查("映射.获取('姓名')=小明", 学生.获取("姓名") == "小明")
    检查("映射.获取(缺失)=空值", 学生.获取("地址") == 空值)
    学生.清空()
    检查("映射.清空 长度=0", 学生.长度() == 0)
    成绩 = {"语文": 90, "数学": 95, "英语": 88}
    计数 = 0
    总和 = 0
    循环 科目, 分 遍历 成绩:
        计数 += 1
        总和 += 分
    结束
    检查("映射遍历 元素数=3", 计数 == 3)
    检查("映射遍历 总和=273", 总和 == 273)

    // ===================== 五、时间模块 16 函数（规范 §5.4） =====================
    输出("===== 五、时间模块 16 函数 =====")
    现在 = 时间.当前时间()
    检查("时间.当前时间 >0", 现在 > 0)
    检查("时间.当前毫秒时间 >=0", 时间.当前毫秒时间() >= 0)
    检查("时间.格式化 返回文本", 类型(时间.格式化("年-月-日", 现在)) == "文本")
    生日戳 = 时间.解析("2000-01-01", "年-月-日")
    检查("时间.解析 返回整数", 类型(生日戳) == "整数")
    检查("时间.获取年 >2000", 时间.获取年(现在) > 2000)
    检查("时间.获取月 1-12", 时间.获取月(现在) >= 1 且 时间.获取月(现在) <= 12)
    检查("时间.获取日 1-31", 时间.获取日(现在) >= 1 且 时间.获取日(现在) <= 31)
    检查("时间.获取时 0-23", 时间.获取时(现在) >= 0 且 时间.获取时(现在) <= 23)
    检查("时间.获取分 0-59", 时间.获取分(现在) >= 0 且 时间.获取分(现在) <= 59)
    检查("时间.获取秒 0-59", 时间.获取秒(现在) >= 0 且 时间.获取秒(现在) <= 59)
    检查("时间.获取星期 1-7", 时间.获取星期(现在) >= 1 且 时间.获取星期(现在) <= 7)
    检查("时间.加(86400) 比现在大", 时间.加(现在, 86400) == 现在 + 86400)
    检查("时间.减(3600) 比现在小", 时间.减(现在, 3600) == 现在 - 3600)
    检查("时间.间隔天数(明天,现在)=1", 时间.间隔天数(时间.加(现在, 86400), 现在) == 1)
    检查("时间.获取计时器 >=0", 时间.获取计时器() >= 0)
    时间.休眠(20)
    检查("时间.休眠(20) 正常返回", 真)

    // ===================== 六、工具模块（规范 §5.6，文档 8 函数） =====================
    输出("===== 六、工具模块 =====")
    匹配结果 = 工具.正则匹配("[0-9]+", "a1b22")
    检查("工具.正则匹配 返回数组", 类型(匹配结果) == "数组")
    检查("工具.正则匹配 命中>=2", 匹配结果.长度() >= 2)
    替换 = 工具.正则替换("[0-9]+", "X", "a1b2")
    检查("工具.正则替换 返回文本", 类型(替换) == "文本")
    检查("工具.正则替换 结果='aXbX'", 替换 == "aXbX")
    生成 = 工具.生成数据("JSON", [1, 2, 3])
    检查("工具.生成数据 返回文本", 类型(生成) == "文本")
    解析 = 工具.解析数据("JSON", "[4, 5, 6]")
    检查("工具.解析数据 JSON数组 长度=3", 解析.长度() == 3)
    检查("工具.解析数据 JSON数组[1]=4", 解析[1] == 4)
    映射文本 = 工具.生成数据("JSON", {"姓名": "张三", "年龄": 25})
    回解 = 工具.解析数据("JSON", 映射文本)
    检查("工具.解析JSON映射 取姓名", 回解.获取("姓名") == "张三")
    检查("工具.解析JSON映射 取年龄", 回解.获取("年龄") == 25)
    检查("工具.哈希算法 MD5 长度32", 工具.哈希算法("MD5", "hello").长度() == 32)
    检查("工具.哈希算法 SHA256 长度64", 工具.哈希算法("SHA256", "hello").长度() == 64)
    编码 = 工具.编码方案("BASE64", "hello")
    检查("工具.编码方案 BASE64 可解码还原", 工具.解码方案("BASE64", 编码) == "hello")
    编号1 = 工具.唯一编号()
    编号2 = 工具.唯一编号()
    检查("工具.唯一编号 非空", 编号1.长度() > 0)
    检查("工具.唯一编号 两次不同", 编号1 != 编号2)

    // ===================== 结果汇总 =====================
    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
