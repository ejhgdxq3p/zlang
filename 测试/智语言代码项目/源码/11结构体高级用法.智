// ============================================================
// 结构体高级用法测试（补充覆盖面）
// 覆盖规范：工厂函数返回结构体、模块顶层变量共享状态(类静态)、
//          结构体名不能访问实例成员(改为顶层函数)、私有结构体/私有接口可见性、
//          方法内调用自身其他方法(方法间相互调用)、初始化覆盖字段默认值、
//          无初始化时参数手动声明为同名字段、结构体作为参数按引用修改
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 工厂函数返回结构体 ──
// 注：参数与字段不能同名(否则字段需显式绑定)。这里字段用 用户名/用户年龄，
//     在 初始化() 中由参数绑定（无初始化示例的等价写法）。
结构体 用户(文本 姓名, 整数 年龄):
    文本 用户名
    整数 用户年龄
    私有 文本 编号 = ""
    初始化():
        自身.用户名 = 姓名
        自身.用户年龄 = 年龄
        输出("创建用户：" + 姓名)
    结束
    设置编号(文本 新编号):
        自身.编号 = 新编号
    结束
    获取编号() 文本:
        返回 自身.编号
    结束
结束

创建高级用户(文本 姓名, 整数 年龄, 文本 编号) 用户:
    实例 = 用户(姓名, 年龄)
    实例.设置编号(编号)
    返回 实例
结束

// ── 模块顶层共享状态（类静态变量替代）──
私有 全局计数 = 0

增加计数():
    本模块.全局计数 += 1
结束

获取计数() 整数:
    返回 本模块.全局计数
结束

// ── 无状态功能提升到模块顶层（替代结构体名.静态方法）──
顶层计算加法(整数 甲, 整数 乙) 整数:
    返回 甲 + 乙
结束

// ── 无初始化：参数手动声明为同名字段（字段默认值位置不能引用参数，
//      实现规范差异点A，故在 初始化() 中绑定；字段名与参数同名，值取自参数）──
结构体 矩形无初始化(小数 宽, 小数 高):
    小数 宽
    小数 高
    文本 颜色 = "黑色"
    初始化():
        自身.宽 = 宽
        自身.高 = 高
    结束
    获取面积() 小数:
        返回 自身.宽 * 自身.高
    结束
    获取宽() 小数:
        返回 自身.宽
    结束
    获取高() 小数:
        返回 自身.高
    结束
结束

// ── 初始化覆盖字段默认值 ──
结构体 银行账户(文本 账户名, 小数 初始余额):
    私有 小数 余额
    文本 账号
    初始化():
        自身.余额 = 10.2         // 覆盖：字段默认值位置不支持引用参数，此处显式绑定
        自身.账号 = "BANK-" + 账户名
    结束
    获取余额() 小数:
        返回 自身.余额
    结束
    获取账号() 文本:
        返回 自身.账号
    结束
结束

// ── 方法间相互调用（自身.其他方法）──
结构体 计算器():
    私有 整数 累计值 = 0
    累加(整数 数值):
        自身.累计值 += 数值
    结束
    翻倍累加(整数 数值):
        自身.累加(数值)
        自身.累加(数值)
    结束
    获取值() 整数:
        返回 自身.累计值
    结束
结束

// ── 结构体按引用修改（方法参数传结构体，修改其字段）──
结构体 计数器():
    整数 值 = 0
    增加(整数 步):
        自身.值 += 步
    结束
    获取值() 整数:
        返回 自身.值
    结束
结束

批量增加(计数器 目标, 整数 步):
    目标.增加(步)
    目标.增加(步)
结束

// ── 测试 ──
测试_工厂函数():
    普通用户 = 用户("张三", 25)
    检查("工厂函数-普通用户姓名", 普通用户.用户名 == "张三")
    高级用户 = 创建高级用户("李四", 30, "VIP-001")
    检查("工厂函数-高级用户姓名", 高级用户.用户名 == "李四")
    检查("工厂函数-高级用户编号", 高级用户.获取编号() == "VIP-001")
    检查("工厂函数-高级用户年龄", 高级用户.用户年龄 == 30)
结束

测试_顶层共享状态():
    增加计数()
    增加计数()
    增加计数()
    检查("顶层共享状态-计数3", 获取计数() == 3)
    检查("顶层函数-加法3+4=7", 顶层计算加法(3, 4) == 7)
结束

测试_无初始化同名参数():
    矩形实例 = 矩形无初始化(3.0, 4.0)
    检查("无初始化-字段宽3", 矩形实例.获取宽() == 3.0)
    检查("无初始化-字段高4", 矩形实例.获取高() == 4.0)
    检查("无初始化-面积12", 矩形实例.获取面积() == 12.0)
结束

测试_初始化覆盖():
    账户 = 银行账户("张三", 1000.0)
    // 注：实现中字段默认值位置不能引用参数，故 余额=初始余额 实际为 0.0(小数默认)，
    //     但 初始化() 覆盖为 10.2；以下断言基于"初始化覆盖生效"：余额=10.2
    检查("初始化覆盖-余额被初始化覆盖为10.2", 账户.获取余额() == 10.2)
    检查("初始化覆盖-账号BANK-张三", 账户.获取账号() == "BANK-张三")
结束

测试_方法相互调用():
    计算 = 计算器()
    计算.翻倍累加(5)
    检查("方法相互调用-翻倍累加5两次=10", 计算.获取值() == 10)
结束

测试_结构体按引用修改():
    // 注意：按 规范 2.3.7「值复制」语义，结构体作为参数传递时是副本，
    //       函数内对副本的修改不影响原实例。故 计数 保持 0（值复制，非引用）。
    计数 = 计数器()
    批量增加(计数, 3)
    检查("结构体传参值复制-原实例不受影响仍为0", 计数.获取值() == 0)
结束

// ── 主入口 ──
启动程序():
    输出("========== 结构体高级用法测试 ==========")
    测试_工厂函数()
    测试_顶层共享状态()
    测试_无初始化同名参数()
    测试_初始化覆盖()
    测试_方法相互调用()
    测试_结构体按引用修改()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
