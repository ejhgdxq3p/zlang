// 【规范 §2.9.2 守护夹具 —— 标准库聚合导入 别名形式（消费者侧）】
//   门面模块：源码/数学别名门面.智（`聚合导入 数学 别名 算`，纯净聚合模块）
//   规范 §2.9.2 外部访问形式：`数学别名门面.算.成员`（别名限定，模块名限定）
//   ⇒ 本用例按规范**首选形式**访问，验证标准库可作为聚合导入的目标。
//   双模验证：
//     智语言开发套件.exe 运行       --直接执行 .\聚合导入_标准库_别名形式_主程序.智  （解释）
//     智语言开发套件.exe 构建运行   --重新编译 .\聚合导入_标准库_别名形式_主程序.智  （编译）
// ══════════════════════════════════════════════════════════════════════════
导入 数学别名门面

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 标准库聚合导入 别名形式（别名限定访问）=====")

    检查("数学别名门面.算.绝对值(-3)=3", 数学别名门面.算.绝对值(-3) == 3)
    检查("数学别名门面.算.最大值(2,7)=7", 数学别名门面.算.最大值(2, 7) == 7)
    检查("数学别名门面.算.最小值(2,7)=2", 数学别名门面.算.最小值(2, 7) == 2)
    检查("数学别名门面.算.取整(3.7)=3", 数学别名门面.算.取整(3.7) == 3)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
