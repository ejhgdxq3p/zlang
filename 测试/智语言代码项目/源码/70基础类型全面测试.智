// ── 文本 ──
测试_转文本():
    检查("文本 拼接 同类型", "你好" + "世界" == "你好世界")
    检查("文本 与整数拼接需转换", "值=" + 转文本(42) == "值=42")
    检查("文本 比较 相等", "abc" == "abc")
    检查("文本 比较 不等", "abc" != "abd")
    // 文本排序比较（规范 §2.6.2 / §4.2）：按 UTF-8 字节序（= Unicode 码点序）
    检查("文本 小于 字典序", "abc" < "abd")
    检查("文本 大于 字典序", "abd" > "abc")
    检查("文本 小于等于", "abc" <= "abc")
    检查("文本 大于等于", "abd" >= "abc")
    检查("文本 中文 码点序 北京>上海", "北京" > "上海")
    检查("文本 中文 码点序 上海<北京", "上海" < "北京")
    检查("文本 长度 中文", "你好".长度() == 2)
    检查("文本 空串长度=0", "".长度() == 0)
    检查("文本 类型", 类型("x") == "文本")
结束

// ── 逻辑 逻辑（仅中文关键字）──
测试_逻辑():
    检查("逻辑 且 真且真", 真 且 真 == 真)
    检查("逻辑 且 真且假=假", 真 且 假 == 假)
    检查("逻辑 或 假或真=真", 假 或 真 == 真)
    检查("逻辑 或 假或假=假", 假 或 假 == 假)
    检查("逻辑 非 非假=真", 非 假 == 真)
    检查("逻辑 非 非真=假", 非 真 == 假)
    检查("逻辑 混合 (真且假)或真=真", (真 且 假) 或 真 == 真)
    // 短路验证：真 或 (10/0==0) —— 左侧为真时右侧(除零)不执行，若短路失效会抛异常崩溃
    检查("逻辑 短路 真或(右侧不执行)", 真 或 (10 / 0 == 0))
    // 短路验证：假 且 (10/0==0) 整体为假且不执行右侧(若短路失效会除零崩溃)
    检查("逻辑 短路 假且(右侧不执行不崩溃)", 非(假 且 (10 / 0 == 0)))
    检查("逻辑 类型", 类型(真) == "逻辑")
结束

// ── 空值 安全 ──
测试_空值():
    检查("空值 类型", 类型(空值) == "空值")
    检查("空值 自等 ==空值", 空值 == 空值)
    // [规范 §2.4.5 铁律：空值只允许与自身 == / === 判断 ⇒ 该写法非法，已停用；见 2.4.5_负向_空值与非空值比较.智] 检查("空值 不等于整数", 空值 != 0)
    // 匿名任意类型包装空值后可安全传递（空值不参与运算，仅能与自身等值判断）
    任意容器 = 空值
    检查("空值 经任意包装 仍为空值", 任意容器 == 空值)
    任意容器 = 100
    检查("空值 包装后赋整数", 任意容器 == 100)
结束

// ── 数组 基础（索引1-based）──
测试_数组基础():
    表 = [10, 20, 30]
    检查("数组 创建 长度=3", 表.长度() == 3)
    检查("数组 索引1-based [1]=10", 表[1] == 10)
    检查("数组 索引末位 [3]=30", 表[3] == 30)
    检查("数组 嵌套索引 [1][1]", [[1, 2], [3, 4]][1][1] == 1)
    检查("数组 类型", 类型(表) == "数组")
    检查("数组 字面量直接索引 [5,6][2]=6", [5, 6][2] == 6)
结束

// ── 映射 基础 ──
测试_映射基础():
    表 = {"a": 1, "b": 2}
    检查("映射 创建 长度=2", 表.长度() == 2)
    检查("映射 访问 [a]=1", 表["a"] == 1)
    检查("映射 所有键 含a", 表.所有键().包含("a"))
    检查("映射 所有值 含2", 表.所有值().包含(2))
    检查("映射 类型", 类型(表) == "映射")
    检查("映射 获取 缺失=空值", 表.获取("z") == 空值)
结束

