启动程序():
    输出("========== 基础类型全面测试 ==========")
    测试_整数算术()
    测试_整数复合赋值()
    测试_小数算术()
    测试_除零异常()
    测试_转文本()
    测试_逻辑()
    测试_空值()
    测试_数组基础()
    测试_映射基础()

