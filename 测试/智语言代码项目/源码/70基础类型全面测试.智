// ============================================================
// 基础类型全面测试（整数/小数/文本/逻辑/空值/数组/映射）
// 覆盖：算术运算、比较、逻辑、取负、整除/取余、复合赋值、空值安全、类型判断、索引规则
// 语法严格符合编程规范文档
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 整数 算术 ──
测试_整数算术():
    检查("整数 加 1+2=3", 1 + 2 == 3)
    检查("整数 减 5-3=2", 5 - 3 == 2)
    检查("整数 乘 4*3=12", 4 * 3 == 12)
    检查("整数 除 7/2=3.5(恒小数)", 转文本(7 / 2) == "3.5")
    检查("整数 整除 10%%3=3", 10 %% 3 == 3)
    检查("整数 整除 10%%小数=整数", 类型(10 %% 3) == "整数")
    检查("整数 取余 10%3=1", 10 % 3 == 1)
    检查("整数 取余 非负 -10%3=2", -10 % 3 == 2)
    检查("整数 取余 10%-3=1", 10 % -3 == 1)
    检查("整数 取负 -8=-8", -8 == -8)
    检查("整数 大数 9999999999", 9999999999 == 9999999999)
    检查("整数 负数比较 -5<3", -5 < 3)
    检查("整数 比较 10>=10", 10 >= 10)
    检查("整数 比较 5!=6", 5 != 6)
结束

// ── 整数 复合赋值 ──
测试_整数复合赋值():
    甲 = 10
    甲 += 5
    检查("+= 后=15", 甲 == 15)
    甲 -= 3
    检查("-= 后=12", 甲 == 12)
    甲 *= 2
    检查("*= 后=24", 甲 == 24)
    甲 %%= 5
    检查("%%= 后=4", 甲 == 4)
    甲 %= 3
    检查("%= 后=1", 甲 == 1)
结束

// ── 小数 算术 ──
测试_小数算术():
    检查("小数 加 1.5+2.5=4.0", 转小数(1.5) + 转小数(2.5) == 转小数(4.0))
    检查("小数 减 5.5-1.5=4.0", 转小数(5.5) - 转小数(1.5) == 转小数(4.0))
    检查("小数 乘 2.0*3.0=6.0", 转小数(2.0) * 转小数(3.0) == 转小数(6.0))
    检查("小数 除 1.0/4.0=0.25", 转小数(1.0) / 转小数(4.0) == 转小数(0.25))
    检查("小数 取负 -2.5", -转小数(2.5) == 转小数(-2.5))
    检查("小数 比较 3.14>3.13", 转小数(3.14) > 转小数(3.13))
    检查("小数 比较 2.0<=2.0", 转小数(2.0) <= 转小数(2.0))
结束

