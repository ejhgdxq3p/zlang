// §5.1.11~§5.1.15 内建数值结构体的「值语义 × 容器/字段/参数」整合矩阵（双模）
// 重点护栏（两处曾真实失效的静默错值缺陷）：
//   F53：变量复合赋值对内建数值结构体完全无效（base 返回新对象、前端只调用不回写）
//   F59：容器元素复合赋值被降级为普通赋值（索引分支忽略了运算符）
// 同时验证值语义：赋值/传参/容器元素均独立，修改一份不影响另一份。
导入 数学

结构体 小数盒子():
    精确小数 小数值 = 数学.精确小数("0")
    短小数 短值 = 数学.短小数(0)
    整数 整数值 = 0
结束

结构体 计数器(整数 初始):
    整数 值 = 初始

    加法赋值(计数器 另一个):
        自身.值 = 自身.值 + 另一个.值
    结束

    加法(计数器 另一个) 计数器:
        返回 计数器(自身.值 + 另一个.值)
    结束
结束

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 288 内建数值结构体值语义整合矩阵（F53/F59 护栏）===")

    输出("-- 变量赋值隔离（值语义深拷贝）--")
    甲 = 数学.精确小数("1.5")
    乙 = 甲
    乙 += 1
    相等文本("乙 复合赋值生效", 乙.转文本(), "2.5")
    相等文本("甲 不受乙影响", 甲.转文本(), "1.5")

    短甲 = 数学.短小数(1.5)
    短乙 = 短甲
    短乙 *= 2
    相等文本("短小数副本修改生效", 短乙.转文本(), "3")
    相等文本("短小数原件不变", 短甲.转文本(), "1.5")

    输出("-- 数组元素复合赋值（F59）--")
    小数列表 = [数学.精确小数("1.5"), 数学.精确小数("2.5")]
    小数列表[1] += 数学.精确小数("1")
    相等文本("数组元素 += 生效", 小数列表[1].转文本(), "2.5")
    相等文本("相邻元素不受影响", 小数列表[2].转文本(), "2.5")
    小数列表[2] *= 2
    相等文本("数组元素 *= 生效", 小数列表[2].转文本(), "5.0")

    整数列表 = [10, 20]
    整数列表[1] += 5
    整数列表[2] *= 3
    检查("数组整数 += 生效", 整数列表[1] == 15)
    检查("数组整数 *= 生效", 整数列表[2] == 60)

    字节列表 = [数学.字节(200)]
    字节列表[1] -= 数学.字节(50)
    相等文本("数组字节元素 -= 生效", 字节列表[1].转文本(), "150")

    输出("-- 映射值复合赋值（F59）--")
    映射 = {"甲": 数学.精确小数("3.5")}
    映射["甲"] += 数学.精确小数("1")
    相等文本("映射结构体值 += 生效", 映射["甲"].转文本(), "4.5")
    整数映射 = {"乙": 100}
    整数映射["乙"] += 1
    检查("映射整数 += 生效", 整数映射["乙"] == 101)

    输出("-- 混合值映射（元素静态类型为 任意）显式标注类型 --")
    // ⚠ 已知限制（F60，架构级，未修）：`任意 变量 <op> 结构体` 的二元运算会落到 base 基本运算
    //   （句柄按文本拼接处理）⇒ 抛「精确小数转文本：类型错误」。规范做法是**显式标注具体类型**
    //   把任意值收窄后再运算（下面的写法），或直接用单一类型的容器。
    混合映射 = {"甲": 数学.精确小数("3.5"), "乙": 100}
    精确小数 临时值 = 混合映射["甲"]
    临时值 += 数学.精确小数("1")
    混合映射["甲"] = 临时值
    相等文本("显式标注后 += 生效", 混合映射["甲"].转文本(), "4.5")
    检查("混合映射其它键不受影响", 混合映射["乙"] == 100)

    输出("-- 结构体字段复合赋值（F53 裸名类型）--")
    盒 = 小数盒子()
    盒.小数值 += 数学.精确小数("2.25")
    相等文本("字段 精确小数 += 生效", 盒.小数值.转文本(), "2.25")
    盒.短值 += 数学.短小数(0.5)
    相等文本("字段 短小数（裸名）+= 生效", 盒.短值.转文本(), "0.5")
    盒.整数值 += 8
    检查("字段整数 += 生效", 盒.整数值 == 8)

    输出("-- 参数按值传递（形参修改不外泄、内部生效）--")
    原件 = 数学.精确小数("10")
    加倍(原件)
    相等文本("外部原件不变（值语义）", 原件.转文本(), "10")

    短件 = 数学.短小数(2)
    短加倍(短件)
    相等文本("短小数形参外部不变", 短件.转文本(), "2")

    输出("-- 取出副本修改不回写容器（值语义一致性）--")
    副本 = 小数列表[1]
    副本 += 数学.精确小数("100")
    相等文本("副本自身被修改", 副本.转文本(), "102.5")
    相等文本("容器内元素保持不变", 小数列表[1].转文本(), "2.5")

    输出("-- 任意类型持有内建结构体 --")
    任意值 = 数学.无限整数(10)
    相等文本("类型() 透过任意仍是具体类型名", 类型(任意值), "无限整数")
    相等文本("任意持有者可调用结构体方法", 任意值.转文本(), "10")
    任意值 += 数学.无限整数(5)
    相等文本("任意变量复合赋值生效", 任意值.转文本(), "15")

    输出("-- 容器查存与相等（重载比较参与）--")
    检查("数组包含内建结构体", 小数列表.包含(数学.精确小数("2.5")))
    检查("不包含错值", 小数列表.包含(数学.精确小数("9.9")) == 假)
    检查("映射取值后可比较", 映射["甲"] == 数学.精确小数("4.5"))

    输出("-- 用户结构体元素复合赋值（走普通运算返回新实例）--")
    计数器列表 = [计数器(1)]
    计数器列表[1] += 计数器(5)
    检查("用户结构体数组元素 += 生效", 计数器列表[1].值 == 6)
    计数器列表[1] += 计数器(2)
    检查("用户结构体数组元素连续 += 生效", 计数器列表[1].值 == 8)

    输出("-- 用户结构体变量复合赋值（就地修改，规范 §2.6.7）--")
    单独 = 计数器(3)
    单独 += 计数器(4)
    检查("用户结构体变量就地 += 生效", 单独.值 == 7)

    收尾()
结束

加倍(精确小数 形参):
    形参 += 数学.精确小数("10")
    输出("  内部形参 = " + 形参.转文本())
结束

短加倍(短小数 形参):
    形参 += 数学.短小数(1)
    输出("  内部短形参 = " + 形参.转文本())
结束
