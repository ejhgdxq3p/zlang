// 规范 §4.5 异常错误结构体：描述 / 类型 / 位置 / 堆栈 / 格式信息()
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

会除以零(整数 甲, 整数 乙) 小数:
    返回 甲 / 乙
结束

三级调用():
    返回 会除以零(1, 0)
结束

启动程序():
    输出("=== 195 §4.5 异常错误结构体 ===")
    // ① 除零异常
    捕获:
        三级调用()
        检查("除零-应抛异常", 假)
    异常:
        错 = 异常错误()
        检查("除零-描述非空", 错.描述.长度() > 0)
        检查("除零-类型为文本", 类型(错.类型) == "文本")
        记录("除零-描述", 错.描述)
        记录("除零-类型", 错.类型)
        记录("除零-位置", 错.位置)
        // ✅ F8-① 回归护栏（2026-09-28 修复）：**两种模式都必须有非空堆栈**。
        //   修复前：解释模式有（`#0 调用点偏移 …`）✓，编译模式恒为**空串** ✗
        //     （根因：运行时 `智语言_压入调用帧/弹出调用帧` 虽已实现，但编译器**从未发射** ⇒ 调用栈恒空）。
        //   ⚠ 只断言「非空」而**不逐字比较**：两种模式的堆栈**格式天然不同** ——
        //     解释器给代码偏移（`#0 调用点偏移 32`），编译器给函数名（`#0 内层 ()`），
        //     这是各自可获得的最有价值信息，强求一致反而会丢失诊断力 ✓。
        检查("除零-堆栈非空", 错.堆栈.长度() > 0)
        检查("除零-格式信息非空", 错.格式信息().长度() > 0)
        检查("除零-格式信息包含描述", 错.格式信息().是否包含(错.描述) 或 错.格式信息().长度() > 错.描述.长度())
        检查("除零-格式信息含换行", 错.格式信息().是否包含("\换行") 或 错.格式信息().长度() > 0)
    结束
    // ② 数组越界异常
    捕获:
        数组甲 = [1, 2]
        数组甲.删除(99)
        检查("越界-应抛异常", 假)
    异常:
        错2 = 异常错误()
        检查("越界-描述非空", 错2.描述.长度() > 0)
        记录("越界-描述", 错2.描述)
        记录("越界-类型", 错2.类型)
        // ✅ F8-② 回归护栏（2026-09-27 修复）：**容器方法**（`.删除`/`.插入`/`.清空`）越界时，
        //   异常「位置」在**两种模式下都必须非空**。
        //   修复前：解释模式为 `路径:行:列` ✓，编译模式为**空串** ✗
        //     （根因：语义层把容器方法合成为「调用」节点时填了 `源码位置::默认()` ⇒ 编译模式注入空位置）。
        //   ⚠ 对照：`容器[键]` 索引访问路径一直正常（其合成处用的是真实位置）⇒ 本护栏专盯方法路径。
        检查("越界-位置非空(容器方法)", 错2.位置.长度() > 0)
        记录("越界-位置", 错2.位置)
    结束
    捕获:
        数组丙 = [1, 2]
        数组丙.插入(99, 7)
    异常:
        检查("插入越界-位置非空(容器方法)", 异常错误().位置.长度() > 0)
    结束
    // ③ 类型转换异常
    捕获:
        转整数("甲乙")
        检查("转换-应抛异常", 假)
    异常:
        错3 = 异常错误()
        检查("转换-描述非空", 错3.描述.长度() > 0)
        记录("转换-描述", 错3.描述)
    结束
    // ④ 自定义抛出
    捕获:
        抛出 异常错误("库存不足：仅剩 3 件")
    异常:
        错4 = 异常错误()
        检查("自定义-描述精确", 错4.描述 == "库存不足：仅剩 3 件")
        检查("自定义-位置存在或有值", 类型(错4.位置) == "文本")
        记录("自定义-位置", 错4.位置)
    结束
    // ⑤ 嵌套捕获：内层处理后外层不受影响
    捕获:
        捕获:
            抛出 异常错误("内层消息")
        异常:
            检查("嵌套-内层捕获到", 异常错误().描述 == "内层消息")
        结束
        检查("嵌套-内层处理后继续", 真)
    异常:
        检查("嵌套-外层不应触发", 假)
    结束
    // ⑥ 始终 块
    始终执行 = 假
    捕获:
        抛出 异常错误("测试始终")
    异常:
        检查("始终前-异常块执行", 真)
    始终:
        始终执行 = 真
    结束
    检查("始终-块已执行", 始终执行 == 真)
    收尾()
结束
