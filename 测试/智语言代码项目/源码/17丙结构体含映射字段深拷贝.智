// 最小验证：结构体含映射字段时，变量赋值的值复制隔离
// 用中间变量拆链方式操作结构体映射字段，隔离「链式字段写回」与「深拷贝隔离」两个问题。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  PASS " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  FAIL " + 名称)
    结束
结束

结构体 盒子:
    标签 = "空"
    表 = {"k": 0}
    读表(文本 键) 整数:
        返回 自身.表.获取(键)
    结束
结束

启动程序():
    甲 = 盒子()
    甲表 = 甲.表
    甲表.插入("k", 111)
    甲.表 = 甲表
    乙 = 甲
    乙表 = 乙.表
    乙表.插入("k", 222)
    乙.表 = 乙表
    检查("结构体含映射-原甲表[k] 不变(=111)", 甲.读表("k") == 111)
    检查("结构体含映射-副本乙表[k] 已改(=222)", 乙.读表("k") == 222)

    输出("通过: " + 转文本(本模块.通过数) + "/" + 转文本(本模块.总数))
结束
