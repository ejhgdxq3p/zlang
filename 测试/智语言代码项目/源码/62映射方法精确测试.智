// 62 映射方法精确测试（规范 4.4 八个方法 + 遍历 逐项精确断言）
// 覆盖：长度 / 包含 / 获取 / 插入 / 删除 / 键 / 值 / 清空 / 遍历循环
// 注意：变量名须用中文（单字母 ASCII 标识符不被接受）

总数 = 0
通过数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
    否则:
        输出("❌ " + 名称)
    结束
结束

启动程序():
    // ===== 长度 / 包含 / 获取 =====
    映射 = {"a": 1, "b": 2}
    检查("长度=2", 映射.长度() == 2)
    检查("包含 a=真", 映射.包含("a") == 真)
    检查("包含 z=假", 映射.包含("z") == 假)
    检查("获取 a=1", 映射.获取("a") == 1)
    检查("获取 缺失=空值", 映射.获取("缺失") == 空值)

    // ===== 插入 =====
    映射.插入("c", 3)
    检查("插入 后长度=3", 映射.长度() == 3)
    检查("插入 取值=3", 映射["c"] == 3)

    // ===== 插入 重复键 覆盖（规范 4.4：重复键覆盖原值，长度不变）=====
    重复映射 = {"主题": "蓝"}
    重复映射.插入("主题", "暗")
    检查("重复键插入 覆盖值=暗", 重复映射["主题"] == "暗")
    检查("重复键插入 长度不变=1", 重复映射.长度() == 1)

    // ===== 删除 =====
    映射.删除("a")
    检查("删除 后长度=2", 映射.长度() == 2)
    检查("删除后 含a=假", 映射.包含("a") == 假)

    // ===== 键 / 值 =====
    所有键 = 映射.所有键()
    检查("键 是数组", 类型(所有键) == "数组")
    检查("键 含b", 所有键.包含("b"))
    检查("键 含c", 所有键.包含("c"))
    所有值 = 映射.所有值()
    检查("值 是数组", 类型(所有值) == "数组")
    检查("值 含2", 所有值.包含(2))
    检查("值 含3", 所有值.包含(3))

    // ===== 清空 =====
    映射.清空()
    检查("清空 长度=0", 映射.长度() == 0)

    // ===== 遍历循环（循环 键名, 值名 遍历 映射:）=====
    成绩 = {"语文": 88, "数学": 95, "英语": 76}
    总和 = 0
    计数 = 0
    循环 键名, 值名 遍历 成绩:
        总和 += 值名
        计数 += 1
    结束
    检查("遍历 计数=3", 计数 == 3)
    检查("遍历 总和=259", 总和 == 259)
    收集键 = []
    循环 某键, 某值 遍历 成绩:
        收集键.追加(某键)
    结束
    检查("遍历 收集含语文", 收集键.包含("语文"))
    检查("遍历 收集含英语", 收集键.包含("英语"))

    // ===== 重复键 覆盖 =====
    重复 = {"k": 1}
    重复.插入("k", 2)
    检查("重复键 覆盖值=2", 重复["k"] == 2)
    检查("重复键 长度仍=1", 重复.长度() == 1)
    检查("重复键 获取新值", 重复.获取("k") == 2)

    // ===== 是否包含 仅检查键（规范明确）=====
    键表 = {"a": 1, "b": 2}
    检查("是否包含 键存在=真", 键表.是否包含("a") == 真)
    检查("是否包含 值不存在=假", 键表.是否包含(1) == 假)

    // ===== 空映射 边界 =====
    空映 = {}
    检查("空映射 长度=0", 空映.长度() == 0)
    检查("空映射 不含任意键", 空映.包含("x") == 假)
    检查("空映射 获取=空值", 空映.获取("x") == 空值)

    // ===== 嵌套映射 =====
    外层 = {"层1": {"内": 10}}
    检查("嵌套 内层类型=映射", 类型(外层["层1"]) == "映射")
    检查("嵌套 取内层值=10", 外层["层1"]["内"] == 10)

    // ===== [] 越界访问 报错（缺失键抛异常）=====
    越界映 = {"a": 1}
    捕获:
        哑 = 越界映["不存在"]
    异常:
        检查("[] 缺失键抛异常", 真)
    结束

    输出("")
    输出("===== 62 映射方法精确测试 结果 =====")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
