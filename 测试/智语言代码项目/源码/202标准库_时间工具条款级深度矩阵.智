// 202 标准库**条款级深度矩阵**：§5.4 时间模块（16 个）+ §5.6 工具模块（8 个）
//
// 分工：既有 164时间模块 / 177工具模块_边界 / 192时间_闰年跨月跨年极限 / 196 等已覆盖成员广度与闰年规则 ✓；
// 本用例专攻**规范条款与已知向量**的精确性：
//   · §5.4 时间戳单位=秒；获取星期 **1=星期一**；加/减 以秒计；间隔天数 有符号（甲−乙）
//   · §5.6 正则/数据/哈希/编码/唯一编号 各函数的**规范示例**与**标准向量**（MD5/SHA256 of "abc"）
//   · 规范未规定者（非法格式、编码非法数据、UUID 版本位）只 `记录()` ✓
//
// ⚠ 本语言转义为**中文词**：反斜杠写 `\反斜杠`，双引号写 `\引号`（规范 §5.6.1/§5.6.2 即如此书写 ✓）
导入 时间
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 202 时间 / 工具 条款级深度矩阵 ===")

    // ───────────── ① §5.4.1 获取时间 ─────────────
    输出("-- §5.4.1 获取时间 --")
    现在 = 时间.当前时间()
    现在毫秒 = 时间.当前毫秒时间()
    检查("当前时间 为合理 Unix 秒（> 1.7e9）", 现在 > 1700000000)
    检查("当前毫秒时间 约为秒 * 1000", 现在毫秒 > 1700000000000)
    差秒 = 现在毫秒 / 1000 - 现在
    如果 差秒 < 0:
        差秒 = 0 - 差秒
    结束
    检查("毫秒与秒自洽（差 ≤ 1）", 差秒 <= 1)
    检查("毫秒时间 精度：毫秒 % 1000 在 0~999", (现在毫秒 % 1000) >= 0 且 (现在毫秒 % 1000) < 1000)

    // ───────────── ② §5.4.2 时间分量（1=星期一）─────────────
    输出("-- §5.4.2 时间分量 --")
    基准 = 时间.解析("2024-06-15 12:34:56", "年-月-日 时:分:秒")
    检查("获取年=2024", 时间.获取年(基准) == 2024)
    检查("获取月=6", 时间.获取月(基准) == 6)
    检查("获取日=15", 时间.获取日(基准) == 15)
    检查("获取时=12", 时间.获取时(基准) == 12)
    检查("获取分=34", 时间.获取分(基准) == 34)
    检查("获取秒=56", 时间.获取秒(基准) == 56)
    检查("获取星期：2024-06-15 为星期六 ⇒ 6（1=星期一）", 时间.获取星期(基准) == 6)
    检查("获取星期：1970-01-01 为星期四 ⇒ 4", 时间.获取星期(时间.解析("1970-01-01", "年-月-日")) == 4)
    检查("获取星期：2024-06-17 为星期一 ⇒ 1", 时间.获取星期(时间.解析("2024-06-17", "年-月-日")) == 1)
    检查("获取星期：2024-06-16 为星期日 ⇒ 7", 时间.获取星期(时间.解析("2024-06-16", "年-月-日")) == 7)

    // ───────────── ③ 格式化 / 解析 往返 ─────────────
    输出("-- §5.4.1 格式化 / 解析 --")
    检查("解析→格式化 往返（年-月-日）", 时间.格式化("年-月-日", 时间.解析("2024-02-29", "年-月-日")) == "2024-02-29")
    检查("解析→格式化 往返（时:分:秒）", 时间.格式化("时:分:秒", 时间.解析("2024-06-15 12:34:56", "年-月-日 时:分:秒")) == "12:34:56")
    检查("格式化 组合格式含年月日", 时间.格式化("年-月-日", 基准).是否包含("2024"))
    记录("格式化(“年/月/日”, 基准)", 时间.格式化("年/月/日", 基准))

    // ───────────── ④ §5.4.3 时间计算（加/减/间隔天数）─────────────
    输出("-- §5.4.3 时间计算 --")
    检查("加 3600 秒 ⇒ 时 +1", 时间.获取时(时间.加(基准, 3600)) == 13)
    检查("减 3600 秒 ⇒ 时 -1", 时间.获取时(时间.减(基准, 3600)) == 11)
    检查("加 60 秒 ⇒ 分 +1", 时间.获取分(时间.加(基准, 60)) == 35)
    检查("加/减 互逆（86400 秒）", 时间.减(时间.加(基准, 86400), 86400) == 基准)
    检查("跨月：2024-12-31 +1 天 ⇒ 2025-01-01", 时间.格式化("年-月-日", 时间.加(时间.解析("2024-12-31", "年-月-日"), 86400)) == "2025-01-01")
    检查("跨年反向：2025-01-01 −1 天 ⇒ 2024-12-31", 时间.格式化("年-月-日", 时间.减(时间.解析("2025-01-01", "年-月-日"), 86400)) == "2024-12-31")
    检查("闰日：2024-02-28 +1 天 ⇒ 2024-02-29", 时间.格式化("年-月-日", 时间.加(时间.解析("2024-02-28", "年-月-日"), 86400)) == "2024-02-29")
    检查("平年：2023-02-28 +1 天 ⇒ 2023-03-01", 时间.格式化("年-月-日", 时间.加(时间.解析("2023-02-28", "年-月-日"), 86400)) == "2023-03-01")
    甲 = 时间.解析("2025-01-01", "年-月-日")
    乙 = 时间.解析("2024-01-01", "年-月-日")
    检查("间隔天数(甲, 乙) 有符号 ⇒ 甲−乙 = 366（2024 闰年）", 时间.间隔天数(甲, 乙) == 366)
    检查("间隔天数(乙, 甲) = −366", 时间.间隔天数(乙, 甲) == 0 - 366)
    检查("间隔天数 同日 = 0", 时间.间隔天数(甲, 甲) == 0)
    检查("间隔天数 跨 30 天", 时间.间隔天数(时间.加(乙, 86400 * 30), 乙) == 30)

    // ───────────── ⑤ §5.4.4 计时与休眠（资源受限：仅 10ms）─────────────
    输出("-- §5.4.4 计时 / 休眠 --")
    计时甲 = 时间.获取计时器()
    循环 序 = 1, 序 <= 2000, 序 += 1:
        临时 = 序 * 序
    结束
    计时乙 = 时间.获取计时器()
    检查("获取计时器 单调不减", 计时乙 >= 计时甲)
    // 实测语义确认：`获取计时器()` = **程序启动以来毫秒** ⇒ 启动即取可为 0 ✓（规范只说"运行毫秒数"）
    检查("获取计时器 ≥ 0（启动即取可为 0）", 计时甲 >= 0)
    记录("获取计时器 启动即取 / 2 万次循环后（毫秒）",
        转文本(计时甲) + " / " + 转文本(计时乙))
    时间.休眠(10)
    计时丙 = 时间.获取计时器()
    检查("休眠(10) 至少等待 5ms（宽松下界）", 计时丙 - 计时乙 >= 5)
    捕获:
        时间.休眠(0)
        记录("休眠(0) 未抛", "正常返回")
    异常:
        记录("休眠(0)", "抛异常")
    结束

    // ───────────── ⑥ §5.6.1 正则（规范示例 + 全部替换）─────────────
    输出("-- §5.6.1 正则 --")
    数字数组 = 工具.正则匹配("\反斜杠d+", "abc123def456")
    检查("正则匹配 规范示例 ⇒ 2 个匹配", 数字数组.长度() == 2)
    检查("正则匹配 首匹配 “123”", 数字数组[1] == "123")
    检查("正则匹配 次匹配 “456”", 数字数组[2] == "456")
    检查("正则 无匹配 ⇒ 空数组", 工具.正则匹配("\反斜杠d+", "abcdef").长度() == 0)
    检查("正则 锚定 ^ 生效", 工具.正则匹配("^a", "abc").长度() == 1)
    检查("正则 锚定 $ 生效", 工具.正则匹配("c$", "abc").长度() == 1)
    检查("正则 中文字符类/字面量匹配", 工具.正则匹配("你", "你好你好").长度() == 2)
    脱敏文本 = 工具.正则替换("\反斜杠d{3}\反斜杠d{4}\反斜杠d{4}", "138****8000", "我的电话是13800138000")
    检查("正则替换 规范示例（脱敏手机号）", 脱敏文本.是否包含("138****8000"))
    检查("正则替换 替换**全部**匹配（a1b2c3 ⇒ aXbXcX）", 工具.正则替换("\反斜杠d", "X", "a1b2c3") == "aXbXcX")
    检查("正则替换 无匹配 ⇒ 原样", 工具.正则替换("\反斜杠d", "X", "abc") == "abc")

    // ───────────── ⑦ §5.6.2 数据格式 ─────────────
    输出("-- §5.6.2 数据格式 --")
    // ⚠ F29（**文档缺陷**，已修规范）：`\引号` 是转义、其后的**空格会计入内容** ✗ ⇒
    //   规范原示例 `"{\引号 姓名\引号 : …}"` 解析出的键是 `" 姓名"`（带前导空格）⇒ `获取("姓名")` 得 空值 ✗
    //   实测结论（双模一致）：`\引号` 紧贴键值（紧凑写法）⇒ 键干净、取值正确 ✓（下面是紧凑写法）
    文本数据 = "{\引号姓名\引号:\引号张三\引号,\引号年龄\引号:25}"
    数据 = 工具.解析数据("JSON", 文本数据)
    检查("解析数据 返回映射", 类型(数据) == "映射")
    检查("解析数据 取文本字段", 数据.获取("姓名") == "张三")
    检查("解析数据 取数值字段", 数据.获取("年龄") == 25)
    用户数据 = {"姓名": "李四", "年龄": 30, "城市": "北京"}
    结果文本 = 工具.生成数据("JSON", 用户数据)
    记录("生成数据(JSON) 结果", 结果文本)
    检查("生成数据 含键", 结果文本.是否包含("姓名"))
    检查("生成数据 含值", 结果文本.是否包含("李四"))
    回环 = 工具.解析数据("JSON", 结果文本)
    检查("生成→解析 回环：姓名一致", 回环.获取("姓名") == "李四")
    检查("生成→解析 回环：年龄一致", 回环.获取("年龄") == 30)
    数组文本 = 工具.生成数据("JSON", [1, 2, 3])
    记录("生成数据([1,2,3])", 数组文本)
    解析数组 = 工具.解析数据("JSON", "[1, 2, 3]")
    检查("解析数据 顶层数组 ⇒ 类型=数组", 类型(解析数组) == "数组")
    检查("解析数据 顶层数组 长度 3", 解析数组.长度() == 3)
    捕获:
        坏 = 工具.解析数据("JSON", "{\引号 甲\引号 : }")
        记录("非法 JSON 未抛", 转文本(坏))
        检查("非法 JSON 应抛异常", 假)
    异常:
        检查("非法 JSON ⇒ 抛可捕获异常", 真)
    结束

    // ───────────── ⑧ §5.6.3 哈希（标准向量）─────────────
    输出("-- §5.6.3 哈希 --")
    检查("MD5(“abc”) 标准向量（小写 hex）", 工具.哈希算法("MD5", "abc") == "900150983cd24fb0d6963f7d28e17f72")
    检查("MD5(“”) 标准向量", 工具.哈希算法("MD5", "") == "d41d8cd98f00b204e9800998ecf8427e")
    检查("SHA256(“abc”) 标准向量（小写 hex）", 工具.哈希算法("SHA256", "abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    检查("MD5 长度 32", 工具.哈希算法("MD5", "hello").长度() == 32)
    检查("SHA256 长度 64", 工具.哈希算法("SHA256", "hello").长度() == 64)
    检查("同输入同哈希（确定性）", 工具.哈希算法("MD5", "hello world") == 工具.哈希算法("MD5", "hello world"))
    检查("异输入异哈希", 工具.哈希算法("MD5", "a") != 工具.哈希算法("MD5", "b"))
    检查("中文可哈希", 工具.哈希算法("SHA256", "你好").长度() == 64)
    捕获:
        非法哈希 = 工具.哈希算法("SHA1", "abc")
        记录("非法算法 SHA1 未抛", 非法哈希)
        检查("非法哈希算法 应抛异常", 假)
    异常:
        检查("非法哈希算法 ⇒ 抛可捕获异常", 真)
    结束

    // ───────────── ⑨ §5.6.4 编码 / 解码 ─────────────
    输出("-- §5.6.4 编码方案 --")
    原始文本 = "你好，智语言！"
    编码结果 = 工具.编码方案("BASE64", 原始文本)
    检查("编码方案 规范示例：往返一致", 工具.解码方案("BASE64", 编码结果) == 原始文本)
    检查("Base64 编码 不含中文原文", 非 (编码结果.是否包含("你好")))
    检查("Base64 空串 ⇒ 空串", 工具.编码方案("BASE64", "") == "")
    检查("Base64 解码 空串 ⇒ 空串", 工具.解码方案("BASE64", "") == "")
    长文本 = "abcdefghijklmnopqrstuvwxyz0123456789"
    检查("Base64 长文本往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", 长文本)) == 长文本)
    检查("Base64 已知向量 “abc” ⇒ “YWJj”", 工具.编码方案("BASE64", "abc") == "YWJj")
    捕获:
        非法方案 = 工具.编码方案("HEX", "hi")
        记录("编码(HEX) 未抛", 非法方案)
        检查("非法编码方案 应抛异常", 假)
    异常:
        检查("非法编码方案 ⇒ 抛可捕获异常", 真)
    结束
    捕获:
        非法解码 = 工具.解码方案("URL", "a%20b")
        记录("解码(URL) 未抛", 非法解码)
        检查("非法解码方案 应抛异常", 假)
    异常:
        检查("非法解码方案 ⇒ 抛可捕获异常", 真)
    结束

    // ───────────── ⑩ §5.6.5 唯一编号 ─────────────
    输出("-- §5.6.5 唯一编号 --")
    编号甲 = 工具.唯一编号()
    编号乙 = 工具.唯一编号()
    检查("唯一编号 长度 36（UUID 形式）", 编号甲.长度() == 36)
    检查("唯一编号 含 4 个连字符", 编号甲.分隔("-").长度() == 5)
    检查("两次生成不相同", 编号甲 != 编号乙)
    记录("唯一编号 示例", 编号甲)
    检查("唯一编号 第三段以 4 开头（UUIDv4，非强制）", 编号甲.分隔("-")[3].截取(1, 1) == "4")

    收尾()
结束
