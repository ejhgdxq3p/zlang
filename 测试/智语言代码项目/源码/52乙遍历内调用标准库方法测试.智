// 52b 遍历/条件 控制流内调用标准库方法（独立文件，规避解析器在大型文件内的状态累积问题）
// 目的：验证 遍历/条件 循环内可正常调用标准库数组/文本方法。
总数 = 0
通过数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
    否则:
        输出("❌ " + 名称)
    结束
结束

启动程序():
    // 遍历内 条件 + 数组方法
    计数 = 0
    循环 值 遍历 [1, 2, 3, 4, 5]:
        如果 值 > 3:
            计数 += 1
        结束
    结束
    检查("遍历+条件 内联比较 计数=2", 计数 == 2)

    // 遍历内求最大（比较运算符）
    最大 = 0
    循环 值 遍历 [3, 7, 2, 9, 1]:
        如果 值 > 最大:
            最大 = 值
        结束
    结束
    检查("遍历内比较求最大=9", 最大 == 9)

    // 遍历内调用数组方法 查找索引
    命中 = 0
    数列 = [10, 20, 30]
    循环 值 遍历 数列:
        如果 数列.查找索引(值) > 0:
            命中 += 1
        结束
    结束
    检查("遍历内 数组.查找索引 全部命中=3", 命中 == 3)

    // 遍历内调用文本方法
    命中 = 0
    循环 词 遍历 ["apple", "banana", "cherry"]:
        如果 词.长度() > 5:
            命中 += 1
        结束
    结束
    检查("遍历内 文本.长度() 调用 命中=2", 命中 == 2)

    输出("")
    输出("===== 52b 遍历内调用标准库方法 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + " 通过：" + 转文本(本模块.通过数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
