// 文件: 聚合导入_组合_冲突化解.智
// 职责: 验证【多模块聚合 + 命名冲突化解】（规范 §2.9.5）：
//       聚合_组合 同时聚合 成员库(展开) 与 成员库乙(别名 乙)。
//       两模块成员经不同形态导出，互不冲突，验证「展开裸名 + 别名子命名空间」并存。

导入 聚合子模块/聚合_组合 展开

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 聚合导入 多模块组合（展开 + 别名 冲突化解） =====")

    // 来自 成员库（展开，裸名）
    检查("展开裸名: 求平方(4)=16", 求平方(4) == 16)
    检查("展开裸名: 公开变量=100", 公开变量 == 100)
    矩形 矩形实例 = 矩形(3, 3)
    检查("展开裸名: 结构体 面积()=9", 矩形实例.面积() == 9)

    // 来自 成员库乙（别名 乙，子命名空间）
    检查("别名: 乙.求立方(3)=27", 乙.求立方(3) == 27)
    检查("别名: 乙.乙变量=200", 乙.乙变量 == 200)
    乙.三角形 三角实例 = 乙.三角形(5)
    检查("别名: 乙.结构体 字段 底边=5", 三角实例.底边 == 5)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
