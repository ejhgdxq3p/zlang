// 覆盖《智语言编程规范》§2.4.1「浮点小数与精确小数的区别」：
//   · 普通小数：IEEE754 二进制浮点 ⇒ 0.1+0.2 ≠ 0.3（浮点噪声）
//   · 精确小数：三个整数模拟 128 位缩放值 + 小数位数 ⇒ 0.1+0.2 == 0.3（精确）
//   · 除法四舍五入到 28 位；转文本按小数位数输出（不去尾零）
导入 数学

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 256 精确小数与浮点小数对比（§2.4.1）===")

    // ── 浮点：0.1 + 0.2 ≠ 0.3 ──
    普通甲 = 0.1 + 0.2
    检查("浮点 0.1+0.2 不等于 0.3", (普通甲 == 0.3) == 假)
    检查("浮点 0.1+0.2 显示如实", 转文本(普通甲) == "0.30000000000000004")

    // ── 精确小数：0.1 + 0.2 == 0.3 ──
    精确甲 = 数学.精确小数("0.1") + 数学.精确小数("0.2")
    检查("精确小数 0.1+0.2 == 0.3", (精确甲 == 数学.精确小数("0.3")) == 真)
    检查("精确小数 转文本 = 0.3", 精确甲.转文本() == "0.3")

    // ── 精确小数：除法四舍五入到 28 位 ──
    精确乙 = 数学.精确小数("1") / 数学.精确小数("3")
    检查("精确小数 1/3 为 28 位", 精确乙.转文本() == "0.3333333333333333333333333333")

    // ── 精确小数保留小数位数（不去尾零，与浮点相反）──
    检查("精确小数 19.99 原样", 数学.精确小数("19.99").转文本() == "19.99")
    检查("精确小数 0.10 保留小数位（不去尾零）", 数学.精确小数("0.10").转文本() == "0.10")

    // ── 精确小数用于金额：一分钱不差 ──
    价格 = 数学.精确小数("0.1") + 数学.精确小数("0.2")
    检查("金额精确相加", 价格.转文本() == "0.3")

    // ── 加减乘精确性（结果小数位 = 操作数最大小数位）──
    检查("精确小数减法 1.00-0.90 = 0.10", (数学.精确小数("1.00") - 数学.精确小数("0.90")).转文本() == "0.10")
    检查("精确小数乘法 1.5*2 = 3.0", (数学.精确小数("1.5") * 数学.精确小数("2")).转文本() == "3.0")
    检查("精确小数整数无小数位", 数学.精确小数("3").转文本() == "3")

    收尾()
结束
