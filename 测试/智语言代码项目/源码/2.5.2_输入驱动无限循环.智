通过数 = 0
失败数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("FAILCASE " + 名称)
    结束
结束

测试_全部():
    整数 收到条数 = 0
    文本 末条 = ""
    整数 安全上限 = 0
    循环 真:
        安全上限 += 1
        如果 安全上限 > 10:
            跳出
        结束
        指令 = 输入()
        如果 指令 == "退出":
            跳出
        结束
        收到条数 += 1
        末条 = 指令
    结束
    检查("输入驱动-收到2条", 收到条数 == 2)
    检查("输入驱动-末条为乙", 末条 == "乙")

    // 菜单式：按输入分派（规范 §2.5.2 菜单循环同款）
    文本 动作 = ""
    整数 轮次 = 0
    循环 真:
        轮次 += 1
        如果 轮次 > 10:
            跳出
        结束
        选择 = 输入()
        如果 选择 == "1":
            动作 = "查看信息"
        否则如果 选择 == "2":
            动作 = "修改设置"
        否则如果 选择 == "3":
            动作 = "退出"
            跳出
        否则:
            动作 = "无效"
        结束
    结束
    检查("菜单-末次动作=退出", 动作 == "退出")
结束

启动程序():
    测试_全部()
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
