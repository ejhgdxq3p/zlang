// 307 接手回归（第四轮）：通道接收三态
// ══════════════════════════════════════════════════════════════════════════
//   接收() 把「收到空值」「已关闭」都折叠成空值，尝试接收() 再加上「暂时没数据」，三者无法区分。
//   新增 接收结果() / 尝试接收结果()，返回 {"状态": "有值"|"暂无"|"已关闭", "值": …}。
//   原有 接收() / 尝试接收() 行为不变。
// 判据：解释 + 编译 双模一致且全部通过。
// ══════════════════════════════════════════════════════════════════════════
导入 并发
导入 时间
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 一、非阻塞三态 =====")
    甲通道 = 并发.通道(4)
    空时 = 甲通道.尝试接收结果()
    检查("空通道：暂无", 空时.获取("状态") == "暂无")
    甲通道.发送(空值)
    甲通道.发送("文")
    收空值 = 甲通道.尝试接收结果()
    检查("发送过的空值：有值且值为空值", 收空值.获取("状态") == "有值" 且 收空值.获取("值") == 空值)
    收文本 = 甲通道.尝试接收结果()
    检查("普通值：有值", 收文本.获取("状态") == "有值" 且 收文本.获取("值") == "文")
    甲通道.发送(7)
    甲通道.关闭()
    残留 = 甲通道.尝试接收结果()
    检查("关闭后残留数据仍是有值", 残留.获取("状态") == "有值" 且 残留.获取("值") == 7)
    排空 = 甲通道.尝试接收结果()
    检查("关闭且排空：已关闭", 排空.获取("状态") == "已关闭")

    输出("===== 二、阻塞形式 =====")
    乙通道 = 并发.通道(1)
    生产者 = 并发.启动任务(函数() 整数:
        时间.休眠(100)
        乙通道.发送(空值)
        时间.休眠(100)
        乙通道.关闭()
        返回 1
    结束)
    第一次 = 乙通道.接收结果()
    检查("阻塞等到发送的空值：有值", 第一次.获取("状态") == "有值" 且 第一次.获取("值") == 空值)
    第二次 = 乙通道.接收结果()
    检查("阻塞等到关闭：已关闭", 第二次.获取("状态") == "已关闭")
    并发.批量等待([生产者], 3000)

    输出("===== 三、原有接口不变 =====")
    丙通道 = 并发.通道(1)
    检查("尝试接收 空通道仍得空值", 丙通道.尝试接收() == 空值)
    丙通道.关闭()
    检查("接收 已关闭通道仍得空值", 丙通道.接收() == 空值)

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
