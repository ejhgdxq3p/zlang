// 116 并发 / 闭包 语义回归（由缺陷复现件转正）
// ══════════════════════════════════════════════════════════════════════════
// 来源：
//   · F2（`缺陷复现/115_F2匿名函数体内字段赋值被拒.智`）：闭包体内 `对象.字段 = 值` 曾被语义层
//     误判为「类型标注」（`表达式中不允许类型标注【X Y】`）。现已不再复现 ⇒ 转正为常态回归。
//   · F4（`缺陷复现/115_F4超时批量等待后等待结果错值.智`）：`批量等待(句柄, 超时)` 后再次
//     `等待结果()` 必须能取到最终结果（规范 §5.7.2）。真因曾是「超时后误释放句柄」⇒ 已修。
// 判据：**双模一致**（解释 + 编译）；任一条失败即视为回归。
// ══════════════════════════════════════════════════════════════════════════
导入 并发
导入 时间
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 载荷:
    整数 编号 = 0
    数组<整数> 数据 = []
结束

// 具名函数体内「对象.字段 = 值」+ 形参 RHS
造载荷(整数 编号) 载荷:
    结果 = 载荷()
    结果.编号 = 编号
    结果.数据.追加(编号 * 2)
    返回 结果
结束

启动程序():
    输出("===== 一、闭包体内「对象.字段 = 值」（F2 回归）=====")

    // ① 字面量 RHS
    任务甲 = 并发.启动任务(函数() 整数:
        甲 = 载荷()
        甲.编号 = 3
        返回 甲.编号
    结束)
    检查("闭包体内字段赋值（字面量 RHS）= 3", 任务甲.等待结果() == 3)

    // ② 外层变量 RHS（捕获变量）
    外层 = 5
    任务乙 = 并发.启动任务(函数() 整数:
        乙 = 载荷()
        乙.编号 = 外层
        返回 乙.编号 + 乙.数据.长度()
    结束)
    检查("闭包体内字段赋值（外层变量 RHS）= 5", 任务乙.等待结果() == 5)

    // ③ 具名函数体内字段赋值 + 容器成员（对照）
    检查("具名函数体内字段赋值 = 9", 造载荷(9).编号 == 9)
    检查("具名函数体内容器成员 = 18", 造载荷(9).数据[1] == 18)

    输出("===== 二、超时批量等待后仍可取结果（F4 回归，规范 §5.7.2）=====")
    慢任务 = 并发.启动任务(函数() 文本:
        时间.休眠(400)
        返回 "慢结果"
    结束)
    部分 = 并发.批量等待([慢任务], 80)
    检查("超时批量等待：未完成 ⇒ 空值", 部分[1] == 空值)
    检查("超时批量等待：立即 是否完成 = 假", 慢任务.是否完成() == 假)
    检查("超时后 等待结果 仍取到最终结果", 慢任务.等待结果() == "慢结果")
    检查("超时后 再次 批量等待 仍取到最终结果", 并发.批量等待([慢任务])[1] == "慢结果")

    输出("")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
