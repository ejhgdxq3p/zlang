// 时间 16 函数 × 闰年 / 跨月 / 跨年 / 负时间戳 / 大时间戳
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 196 闰年规则矩阵（F16 回归护栏）===")
    // ① 闰年判定：4 年一闰、百年不闰、四百年再闰
    检查("闰年-2024 有 2月29", 时间.格式化("年-月-日", 时间.解析("2024-02-29", "年-月-日")) == "2024-02-29")
    检查("闰年-2020 有 2月29", 时间.格式化("年-月-日", 时间.解析("2020-02-29", "年-月-日")) == "2020-02-29")
    检查("闰年-2000 有 2月29(四百年闰)", 时间.格式化("年-月-日", 时间.解析("2000-02-29", "年-月-日")) == "2000-02-29")
    检查("闰年-2400 有 2月29(四百年闰)", 时间.格式化("年-月-日", 时间.解析("2400-02-29", "年-月-日")) == "2400-02-29")
    // ② 平年与百年非闰：2月28 正常；**不存在的 2月29 严格报错**（2026-10-19：原宽松规整到 3月1 已废止）
    检查("平年-2023-02-28 精确往返", 时间.格式化("年-月-日", 时间.解析("2023-02-28", "年-月-日")) == "2023-02-28")
    捕获:
        时间.解析("2023-02-29", "年-月-日")
        检查("平年-2023-02-29 应抛异常", 假)
    异常:
        检查("平年-2023-02-29 抛异常", 真)
    结束
    捕获:
        时间.解析("1900-02-29", "年-月-日")
        检查("百年非闰-1900-02-29 应抛异常", 假)
    异常:
        检查("百年非闰-1900-02-29 抛异常", 真)
    结束
    捕获:
        时间.解析("2100-02-29", "年-月-日")
        检查("百年非闰-2100-02-29 应抛异常", 假)
    异常:
        检查("百年非闰-2100-02-29 抛异常", 真)
    结束
    // ③ 闰年 2 月逐日往返（F16 主战场：1→29 每一天的分量都必须等于序号）
    二月一 = 时间.解析("2024-02-01", "年-月-日")
    逐日全对 = 真
    循环 序 = 0, 序 <= 28, 序 += 1:
        实际日 = 时间.获取日(时间.加(二月一, 86400 * 序))
        如果 实际日 != 序 + 1:
            逐日全对 = 假
            记录("2月逐日-序号" + 转文本(序) + "实际日", 转文本(实际日))
        结束
    结束
    检查("闰年2月-1至29日逐日分量全对", 逐日全对)
    检查("闰年2月-29日之后是3月1日", 时间.格式化("年-月-日", 时间.加(二月一, 86400 * 29)) == "2024-03-01")
    检查("闰年2月-3月1日反推为2月29日", 时间.格式化("年-月-日", 时间.减(时间.解析("2024-03-01", "年-月-日"), 86400)) == "2024-02-29")
    // ④ 平年 2 月逐日往返（1→28，第 28 天之后即 3月1日）
    平二月一 = 时间.解析("2023-02-01", "年-月-日")
    平逐日全对 = 真
    循环 序2 = 0, 序2 <= 27, 序2 += 1:
        实际日2 = 时间.获取日(时间.加(平二月一, 86400 * 序2))
        如果 实际日2 != 序2 + 1:
            平逐日全对 = 假
        结束
    结束
    检查("平年2月-1至28日逐日分量全对", 平逐日全对)
    检查("平年2月-28日之后是3月1日", 时间.格式化("年-月-日", 时间.加(平二月一, 86400 * 28)) == "2023-03-01")
    // ⑤ 12 个月的「1 日」分量自洽（月份不漂移）
    月首全对 = 真
    循环 月序 = 1, 月序 <= 12, 月序 += 1:
        该月一日 = 时间.解析("2024-" + 转文本(月序) + "-01", "年-月-日")
        如果 时间.获取月(该月一日) != 月序 或 时间.获取日(该月一日) != 1:
            月首全对 = 假
            记录("月首异常-月" + 转文本(月序), 时间.格式化("年-月-日", 该月一日))
        结束
    结束
    检查("2024-12 个月的首日分量全对", 月首全对)
    // ⑥ 全年天数（闰年 366 / 平年 365）与跨闰日计算
    检查("全年-2024 为 366 天", 时间.间隔天数(时间.解析("2025-01-01", "年-月-日"), 时间.解析("2024-01-01", "年-月-日")) == 366)
    检查("全年-2023 为 365 天", 时间.间隔天数(时间.解析("2024-01-01", "年-月-日"), 时间.解析("2023-01-01", "年-月-日")) == 365)
    检查("跨闰日-闰年2月28日+1天", 时间.格式化("年-月-日", 时间.加(时间.解析("2024-02-28", "年-月-日"), 86400)) == "2024-02-29")
    检查("跨闰日-平年2月28日+1天", 时间.格式化("年-月-日", 时间.加(时间.解析("2023-02-28", "年-月-日"), 86400)) == "2023-03-01")
    收尾()
结束
