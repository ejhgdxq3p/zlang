// 220 §5.6 工具模块**条款级矩阵（第二十七轮）**
// 断言取自规范原文与标准向量：
//   §5.6.1 正则：`工具.正则匹配(模式, 内容) → 数组<文本>`、`工具.正则替换(模式, 替换文本, 原文) → 文本`
//          示例 `\反斜杠d+` 匹配 "abc123def456" ⇒ ["123", "456"]；电话脱敏示例
//   §5.6.2 数据格式：`解析数据(格式, 数据)` 支持 JSON/CSV，JSON null ⇒ 空值，
//          **格式非法或 JSON 语法错误抛可捕获异常**（不得静默返回空值）
//   §5.6.3 哈希：MD5 / SHA256（实现明确只支持两者，SHA1 等抛异常）
//   §5.6.4 编码：方案名**大小写敏感**、仅 `BASE64`；解码**容忍空白**；
//          方案不支持 / 非法字符 / 非 UTF-8 一律**抛可捕获异常（运行时异常）**
//   §5.6.5 唯一编号：UUID（36 字符、两次不同）
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

启动程序():
    输出("=== 220 §5.6 工具模块 条款矩阵 ===")

    // ───────── ① §5.6.1 正则匹配 ─────────
    输出("-- ① §5.6.1 正则匹配 --")
    数字数组 = 工具.正则匹配("\反斜杠d+", "abc123def456")
    检查("匹配数字 ⇒ 2 个", 数字数组.长度() == 2)
    检查("第一个匹配 123", 数字数组[1] == "123")
    检查("第二个匹配 456", 数字数组[2] == "456")
    检查("无匹配 ⇒ 空数组", 工具.正则匹配("\反斜杠d+", "无数字").长度() == 0)
    检查("匹配中文模式", 工具.正则匹配("智语言", "我爱智语言也爱智语言").长度() == 2)
    检查("分组未捕获时返回整体匹配", 工具.正则匹配("第\反斜杠d+章", "第1章 第22章").长度() == 2)
    非法正则被拒 = 假
    捕获:
        工具.正则匹配("[未闭合", "abc")
    异常:
        非法正则被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("非法正则 ⇒ 抛运行时异常", 非法正则被拒)

    // ───────── ② §5.6.1 正则替换 ─────────
    输出("-- ② §5.6.1 正则替换 --")
    检查("替换全部数字", 工具.正则替换("\反斜杠d+", "#", "a1b22c333") == "a#b#c#")
    检查("规范示例：电话脱敏", 工具.正则替换("\反斜杠d{3}\反斜杠d{4}\反斜杠d{4}", "138****8000", "我的电话是13800138000") == "我的电话是138****8000")
    检查("无匹配 ⇒ 原样返回", 工具.正则替换("\反斜杠d+", "#", "无数字") == "无数字")
    检查("替换为空串 ⇒ 删除", 工具.正则替换("\反斜杠d+", "", "a1b2") == "ab")
    非法替换模式被拒 = 假
    捕获:
        工具.正则替换("[", "#", "abc")
    异常:
        非法替换模式被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("非法模式替换 ⇒ 抛运行时异常", 非法替换模式被拒)

    // ───────── ③ §5.6.2 解析数据 JSON ─────────
    输出("-- ③ §5.6.2 解析数据（JSON）--")
    对象 = 工具.解析数据("JSON", "{\引号姓名\引号:\引号张三\引号,\引号年龄\引号:25}")
    检查("对象 ⇒ 类型 映射", 类型(对象) == "映射")
    检查("对象 取文本值", 对象.获取("姓名") == "张三")
    检查("对象 取整数值", 对象.获取("年龄") == 25)
    数组值 = 工具.解析数据("JSON", "[1,2,3]")
    检查("数组 ⇒ 类型 数组", 类型(数组值) == "数组")
    检查("数组 长度 3", 数组值.长度() == 3)
    检查("纯数字 ⇒ 整数", 工具.解析数据("JSON", "42") == 42)
    检查("小数 ⇒ 小数", 工具.解析数据("JSON", "3.5") == 3.5)
    检查("true ⇒ 逻辑真", 工具.解析数据("JSON", "true") == 真)
    检查("false ⇒ 逻辑假", 工具.解析数据("JSON", "false") == 假)
    检查("null ⇒ 空值（§5.6.2 明文）", 工具.解析数据("JSON", "null") == 空值)
    检查("JSON 字符串 ⇒ 文本", 工具.解析数据("JSON", "\引号甲\引号") == "甲")
    嵌套 = 工具.解析数据("JSON", "{\引号甲\引号:[1,{\引号乙\引号:true}]}")
    检查("嵌套 类型 映射", 类型(嵌套) == "映射")
    检查("嵌套 内层数组长度 2", 嵌套.获取("甲").长度() == 2)
    坏数据被拒 = 假
    捕获:
        工具.解析数据("JSON", "{\引号甲\引号:}")
    异常:
        坏数据被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("JSON 语法错误 ⇒ 抛运行时异常（不静默）", 坏数据被拒)
    空串被拒 = 假
    捕获:
        工具.解析数据("JSON", "")
    异常:
        空串被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("空串 JSON ⇒ 抛运行时异常", 空串被拒)
    未知格式被拒 = 假
    捕获:
        工具.解析数据("XML", "<a/>")
    异常:
        未知格式被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("未知格式 ⇒ 抛运行时异常", 未知格式被拒)

    // ───────── ④ §5.6.2 解析 / 生成 CSV ─────────
    输出("-- ④ §5.6.2 CSV --")
    表格数据 = 工具.解析数据("CSV", "甲,乙\换行1,2\换行")
    检查("CSV ⇒ 数组<数组<文本>>", 类型(表格数据) == "数组" 且 类型(表格数据[1]) == "数组")
    检查("CSV 行数 2", 表格数据.长度() == 2)
    检查("CSV 每行字段数 2", 表格数据[1].长度() == 2)
    检查("CSV 元素均为文本（1 ⇒ 文本 1）", 表格数据[2][1] == "1" 且 类型(表格数据[2][1]) == "文本")
    表格文本 = 工具.生成数据("CSV", [["甲", "乙"], [1, 2]])
    检查("CSV 生成 含首行", 表格文本.是否包含("甲,乙"))
    检查("CSV 生成 含数据行", 表格文本.是否包含("1,2"))
    检查("CSV 生成 以换行分隔", 表格文本.是否包含("\换行"))

    // ───────── ⑤ §5.6.2 生成数据 JSON ─────────
    输出("-- ⑤ §5.6.2 生成数据（JSON）--")
    生成对象 = 工具.生成数据("JSON", {"甲": 1})
    检查("生成对象 = {\引号甲\引号:1}（紧凑无空格）", 生成对象 == "{\引号甲\引号:1}")
    检查("生成数组 = [1,2]", 工具.生成数据("JSON", [1, 2]) == "[1,2]")
    检查("生成空值 ⇒ null", 工具.生成数据("JSON", {"甲": 空值}) == "{\引号甲\引号:null}")
    检查("生成文本带引号", 工具.生成数据("JSON", {"甲": "x"}) == "{\引号甲\引号:\引号x\引号}")
    检查("生成嵌套结构", 工具.生成数据("JSON", {"甲": [1, {"乙": 2}]}) == "{\引号甲\引号:[1,{\引号乙\引号:2}]}")
    检查("JSON 生成 → 解析 往返（整数）", 工具.解析数据("JSON", 工具.生成数据("JSON", {"甲": 7})).获取("甲") == 7)
    检查("JSON 生成 → 解析 往返（数组）", 工具.解析数据("JSON", 工具.生成数据("JSON", [1, 2, 3])).长度() == 3)

    // ───────── ⑥ §5.6.3 哈希算法（标准向量）─────────
    输出("-- ⑥ §5.6.3 哈希（标准向量）--")
    检查("MD5(空) = d41d8cd9…", 工具.哈希算法("MD5", "") == "d41d8cd98f00b204e9800998ecf8427e")
    检查("MD5(abc) = 900150983c…", 工具.哈希算法("MD5", "abc") == "900150983cd24fb0d6963f7d28e17f72")
    检查("SHA256(abc) = ba7816bf…", 工具.哈希算法("SHA256", "abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    检查("SHA256(空) = e3b0c442…", 工具.哈希算法("SHA256", "") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    检查("MD5 长度 32", 工具.哈希算法("MD5", "甲").长度() == 32)
    检查("SHA256 长度 64", 工具.哈希算法("SHA256", "甲").长度() == 64)
    检查("MD5 中文输入稳定（两次相同）", 工具.哈希算法("MD5", "你好") == 工具.哈希算法("MD5", "你好"))
    不支持算法被拒 = 假
    捕获:
        工具.哈希算法("SHA1", "abc")
    异常:
        不支持算法被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("SHA1 ⇒ 抛运行时异常（规范仅 MD5/SHA256）", 不支持算法被拒)
    小写算法被拒 = 假
    捕获:
        工具.哈希算法("md5", "abc")
    异常:
        小写算法被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("算法名大小写敏感（md5 ⇒ 抛异常）", 小写算法被拒)

    // ───────── ⑦ §5.6.4 编码 / 解码 ─────────
    输出("-- ⑦ §5.6.4 编码方案 BASE64 --")
    检查("BASE64(你好) = 5L2g5aW9", 工具.编码方案("BASE64", "你好") == "5L2g5aW9")
    检查("BASE64 往返 中文", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "你好，智语言！")) == "你好，智语言！")
    检查("BASE64(空) = 空串", 工具.编码方案("BASE64", "") == "")
    检查("BASE64 解码空串 = 空串", 工具.解码方案("BASE64", "") == "")
    检查("解码容忍空格", 工具.解码方案("BASE64", "aGVs bG8=") == "hello")
    检查("解码容忍换行与制表", 工具.解码方案("BASE64", "aGVs\换行bG8=\制表") == "hello")
    方案小写被拒 = 假
    捕获:
        工具.编码方案("base64", "abc")
    异常:
        方案小写被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("方案名大小写敏感（base64 ⇒ 抛异常）", 方案小写被拒)
    非法字符被拒 = 假
    捕获:
        工具.解码方案("BASE64", "@@@@")
    异常:
        非法字符被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("解码遇非法字符 ⇒ 抛运行时异常（不静默返回空串）", 非法字符被拒)
    未知方案被拒 = 假
    捕获:
        工具.编码方案("HEX", "abc")
    异常:
        未知方案被拒 = 异常错误().类型 == "运行时异常"
    结束
    检查("未知编码方案 ⇒ 抛运行时异常", 未知方案被拒)

    // ───────── ⑧ §5.6.5 唯一编号 ─────────
    输出("-- ⑧ §5.6.5 唯一编号 --")
    编号甲 = 工具.唯一编号()
    编号乙 = 工具.唯一编号()
    检查("编号 类型 文本", 类型(编号甲) == "文本")
    检查("编号 长度 36（UUID 文本形式）", 编号甲.长度() == 36)
    检查("编号 含连字符", 编号甲.是否包含("-"))
    检查("两次编号不同", 编号甲 != 编号乙)
    检查("编号 不以连字符开头结尾", 编号甲.查找("-") > 1 且 编号甲.查找("-") < 36)
    // 不打印编号原文：UUID 每次不同，打印会破坏双模 stdout 逐字节一致性判据
    检查("编号 去掉连字符后 32 位（UUID 十六进制）", 编号甲.替换("-", "").长度() == 32)

    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
