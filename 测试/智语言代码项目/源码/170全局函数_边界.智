启动程序():
    输出("=== 170 全局函数-边界 ===")
    // 转整数：文本解析的边界
    检查("转整数-零文本", 转整数("0") == 0)
    检查("转整数-正号文本", 转整数("+7") == 7)
    检查("转整数-多位小数文本向零取整?", 转整数(0.0) == 0)
    记录("转整数(「3.7「) 实际", 转文本(转整数(3.7)))
    记录("转整数(「12「) 实际", 转文本(转整数("12")))
    // 转小数：整数提升与小数恒等
    检查("转小数-零", 转小数(0) == 0.0)
    检查("转小数-负整数", 转小数(-3) == -3.0)
    检查("转小数-文本整数", 转小数("5") == 5.0)
    // 类型()：5 基本 + 2 容器 + 4 自定义
    检查("类型-整数", 类型(1) == "整数")
    检查("类型-小数", 类型(1.0) == "小数")
    检查("类型-文本", 类型("文") == "文本")
    检查("类型-逻辑", 类型(假) == "逻辑")
    检查("类型-空值", 类型(空值) == "空值")
    检查("类型-数组", 类型([]) == "数组")
    检查("类型-映射", 类型({}) == "映射")
    检查("类型-结构体", 类型(甲型()) == "甲型")
    // ⚠ 缺口 F10（2026-09-27 实测）：`类型()` 对**枚举**返回错误名字 ——
    //   `类型(枚举成员)` 实测 = "数组" ✗、`类型(枚举类型引用)` 实测 = "函数" ✗，
    //   而规范 §4.1 明示 `类型(任意<甲> 值)` 返回「当前运行时值的**具体类型名**」，
    //   同节的对照示例 `类型(学生实例)` = "学生" ✓（结构体正确）。⇒ 枚举应返回枚举名。
    //   本用例暂只断言「非空」，期望值 "乙枚举" 待实现修正后恢复。
