// ============================================================
// 结构体参数作用域测试
// 覆盖规范：字段默认值引用参数、普通方法引用参数、
//          初始化方法引用参数、参数不是字段、
//          无初始化(手动字段)/有初始化(赋值)、实例化执行流程(初始化覆盖字段默认值)
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 参数作用域：字段默认值、方法、初始化都直接引用参数 ──
结构体 银行账户(文本 账户名, 小数 初始余额):
    私有 小数 余额
    文本 账号
    初始化():
        自身.余额 = 初始余额
        自身.账号 = "BANK-" + 账户名
    结束
    打招呼():
        输出("欢迎，" + 账户名)
    结束
    获取余额() 小数:
        返回 自身.余额
    结束
    获取账号() 文本:
        返回 自身.账号
    结束
结束

// ── 无初始化：参数不是字段，手动声明同名字段用参数值初始化 ──
结构体 矩形乙(小数 宽, 小数 高):
    小数 宽
    小数 高
    文本 颜色 = "黑色"
    初始化():
        自身.宽 = 宽
        自身.高 = 高
    结束
    获取宽() 小数:
        返回 自身.宽
    结束
    获取高() 小数:
        返回 自身.高
    结束
结束

// ── 有初始化：参数不是字段，在初始化中赋值给字段 ──
结构体 银行账户2(文本 账户名, 小数 初始余额):
    私有 小数 余额
    文本 账号
    初始化():
        自身.余额 = 初始余额
        自身.账号 = "BANK-" + 账户名
    结束
    获取余额() 小数:
        返回 自身.余额
    结束
    获取账号() 文本:
        返回 自身.账号
    结束
结束

// ── 实例化执行流程：初始化在字段默认值之后，可覆盖 ──
结构体 银行账户3(文本 账户名, 小数 初始余额):
    私有 小数 余额 = 999.0
    文本 账号
    初始化():
        自身.余额 = 10.2
        自身.账号 = "BANK-" + 账户名
    结束
    获取余额() 小数:
        返回 自身.余额
    结束
    获取账号() 文本:
        返回 自身.账号
    结束
结束

// ── 测试 ──
测试_参数作用域():
    账户 = 银行账户("张三", 1000.0)
    检查("参数作用域-字段默认值引用参数=1000", 账户.获取余额() == 1000.0)
    检查("参数作用域-初始化引用参数-账号BANK-张三", 账户.获取账号() == "BANK-张三")
    账户.打招呼()
    检查("参数作用域-普通方法引用参数", 真)
结束

测试_无初始化手动字段():
    矩形实例 = 矩形乙(3.0, 4.0)
    检查("无初始化-手动字段宽=3", 矩形实例.获取宽() == 3.0)
    检查("无初始化-手动字段高=4", 矩形实例.获取高() == 4.0)
结束

测试_有初始化赋值():
    账户2 = 银行账户2("李四", 2000.0)
    检查("有初始化-余额=2000", 账户2.获取余额() == 2000.0)
    检查("有初始化-账号BANK-李四", 账户2.获取账号() == "BANK-李四")
结束

测试_初始化覆盖字段默认值():
    账户3 = 银行账户3("王五", 1000.0)
    检查("初始化覆盖-余额被改为10.2", 账户3.获取余额() == 10.2)
    检查("初始化覆盖-账号BANK-王五", 账户3.获取账号() == "BANK-王五")
结束

// ── 主入口 ──
启动程序():
    输出("========== 结构体参数作用域测试 ==========")
    测试_参数作用域()
    测试_无初始化手动字段()
    测试_有初始化赋值()
    测试_初始化覆盖字段默认值()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
