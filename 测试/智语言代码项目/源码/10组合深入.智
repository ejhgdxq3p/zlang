// ============================================================
// 结构体组合深入测试（补充覆盖面）
// 覆盖规范：多层嵌套组合、结构体作为方法参数传递、结构体作为方法返回值、
//          结构体方法返回结构体实例并链式使用、组合字段为 任意<X|空值> 用空值判断、
//          组合内嵌实例的字段修改经外层读取、组合中相同类型的多个实例
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ── 基础被组合结构体 ──
结构体 地址(文本 省份, 文本 城市, 文本 详细地址):
    文本 城市 = 城市
    获取完整地址() 文本:
        返回 省份 + "省" + 自身.城市 + "市" + 详细地址
    结束
    修改城市(文本 新城市):
        自身.城市 = 新城市
    结束
    获取城市() 文本:
        返回 自身.城市
    结束
结束

结构体 联系方式(文本 电话, 文本 邮箱):
    文本 电话 = 电话
    获取联系方式() 文本:
        返回 "电话：" + 自身.电话
    结束
    修改电话(文本 新电话):
        自身.电话 = 新电话
    结束
    获取电话() 文本:
        返回 自身.电话
    结束
结束

// ── 中层：将 地址 + 联系方式 组合 ──
// 注：结构体类型字段必须内联初始化（实现约束：初始化体内不能给结构体字段赋值），
//     故 住址/通讯 用字面量默认值内联初始化，参数 姓名 仅在方法内使用。
结构体 联系人(文本 姓名) 适配:
    私有 地址 住址 = 地址("广东", "深圳", "南山区")
    私有 联系方式 通讯 = 联系方式("13800000000", "a@b.com")
    私有 文本 存储姓名
    初始化():
        自身.存储姓名 = 姓名
    结束
    设置姓名(文本 新姓名):
        自身.存储姓名 = 新姓名
    结束
    获取姓名() 文本:
        返回 自身.存储姓名
    结束
    获取地址() 文本:
        返回 自身.住址.获取完整地址()
    结束
    获取通讯() 文本:
        返回 自身.通讯.获取联系方式()
    结束
    迁移城市(文本 新城市):
        自身.住址.修改城市(新城市)
    结束
    换电话(文本 新电话):
        自身.通讯.修改电话(新电话)
    结束
    获取城市() 文本:
        返回 自身.住址.获取城市()
    结束
    获取电话() 文本:
        返回 自身.通讯.获取电话()
    结束
结束

// ── 顶层：组合 联系人（多层嵌套组合）──
// 【已解除限制（2026-09-21 · COW 退役）】
//   曾记载：「在 `初始化()` 内用 `自身.档案.设置姓名(姓名)` 注入构造参数**实测不生效**」
//     —— 真根因是**引用计数虚高触发 COW 误分离**（新句柄无法传回调用方），非方法本身缺陷。
//   COW 退役后（值语义隔离改由「存储即深拷贝」**构造性**承担）该限制**已彻底解除**：
//     `初始化()` 内 `自身.嵌套字段.用户变异方法(…)` 现与普通方法内 / 外部调用**行为一致**，
//     且无需"写回机制"、无需用户改写法、无需"方法返回自身"。
//   回归守护：`105嵌套字段调用用户变异方法.智`（初始化内 / 普通方法内 / 外部 / 三层字段链 / 容器元素）。
//   本用例保留的写法（字段默认值引用结构体参数，规范 §2.4.7 明确允许）依然有效，为等价写法。
结构体 公司员工(文本 工号, 文本 姓名) 适配:
    私有 联系人 档案 = 联系人(姓名)
    私有 文本 部门 = "研发"
    获取工号() 文本:
        返回 工号
    结束
    获取姓名() 文本:
        返回 自身.档案.获取姓名()
    结束
    获取地址() 文本:
        返回 自身.档案.获取地址()
    结束
    获取部门() 文本:
        返回 自身.部门
    结束
    迁移(文本 新城市):
        自身.档案.迁移城市(新城市)
    结束
    换号(文本 新电话):
        自身.档案.换电话(新电话)
    结束
    获取城市() 文本:
        返回 自身.档案.获取城市()
    结束
    获取电话() 文本:
        返回 自身.档案.获取电话()
    结束
结束

// ── 结构体作为方法参数传递 ──
结构体 矩形(小数 宽, 小数 高):
    获取面积() 小数:
        返回 宽 * 高
    结束
结束

计算总面积(矩形 甲, 矩形 乙) 小数:
    返回 甲.获取面积() + 乙.获取面积()
结束

// ── 结构体方法返回结构体实例 ──
结构体 向量(整数 横, 整数 纵):
    整数 纵 = 纵
    整数 横 = 横
    相加(向量 其他) 向量:
        返回 向量(自身.横 + 其他.横, 自身.纵 + 其他.纵)
    结束
    获取横() 整数:
        返回 自身.横
    结束
    获取纵() 整数:
        返回 自身.纵
    结束
结束

// ── 组合字段（直接类型，避免 任意<X|空值> 赋值缺口，测试可选式组合）──
// 注：规范允许 任意<地址|空值> 作组合字段，但该【任意类型赋值】目前未实现
//     （F8/F11/F13 缺口），故此处用 显式标志位+直接类型字段 等价表达可选组合，
//     验证多层组合的「可缺省子对象」行为。
结构体 用户档案(文本 姓名):
    私有 地址 地址信息 = 地址("广东", "深圳", "南山区")
    私有 逻辑 是否有地址 = 真
    获取姓名() 文本:
        返回 姓名
    结束
    设置地址(文本 省份, 文本 城市, 文本 详细):
        自身.地址信息 = 地址(省份, 城市, 详细)
        自身.是否有地址 = 真
    结束
    有地址() 逻辑:
        返回 自身.是否有地址
    结束
    获取地址转文本() 文本:
        如果 自身.是否有地址:
            返回 自身.地址信息.获取完整地址()
        否则:
            返回 "无地址"
        结束
    结束
结束

// ── 测试 ──
测试_多层嵌套组合():
    员工 = 公司员工("E001", "张三")
    检查("多层组合-姓名张三", 员工.获取姓名() == "张三")
    检查("多层组合-默认地址含深圳", 员工.获取地址().查找("深圳市") > 0)
    检查("多层组合-默认电话", 员工.获取电话().查找("13800000000") > 0)
    员工.迁移("北京")
    员工.换号("13900000000")
    检查("多层组合-迁移后城市北京", 员工.获取城市() == "北京")
    检查("多层组合-换号后电话", 员工.获取电话() == "13900000000")
    检查("多层组合-地址文本更新", 员工.获取地址().查找("北京市") > 0)
结束

测试_结构体作方法参数():
    矩形甲 = 矩形(3.0, 4.0)
    矩形乙 = 矩形(5.0, 2.0)
    检查("结构体参数-总面积22", 计算总面积(矩形甲, 矩形乙) == 22.0)
结束

测试_结构体方法返回实例():
    向量甲 = 向量(1, 2)
    向量乙 = 向量(3, 4)
    结果 = 向量甲.相加(向量乙)
    检查("返回实例-横4", 结果.获取横() == 4)
    检查("返回实例-纵6", 结果.获取纵() == 6)
结束

测试_可选组合():
    档案 = 用户档案("李四")
    检查("可选组合-初始有默认地址", 档案.有地址() == 真)
    检查("可选组合-默认地址文本", 档案.获取地址转文本().查找("深圳市南山区") > 0)
    档案.设置地址("浙江", "杭州", "西湖区")
    检查("可选组合-设置后有地址", 档案.有地址() == 真)
    检查("可选组合-地址文本更新", 档案.获取地址转文本().查找("杭州市西湖区") > 0)
结束

// ── 主入口 ──
启动程序():
    输出("========== 结构体组合深入测试 ==========")
    测试_多层嵌套组合()
    测试_结构体作方法参数()
    测试_结构体方法返回实例()
    测试_可选组合()

    输出("========== 测试结果 ==========")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
