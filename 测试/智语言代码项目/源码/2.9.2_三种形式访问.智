// 规范 §2.9.2：聚合导入三种形式 —— 默认（子命名空间）/ 展开（裸名）/ 别名（子命名空间，原名失效）
导入 聚合校验/默认聚合 展开
导入 聚合校验/展开聚合 展开
导入 聚合校验/别名聚合 展开

通过数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    结束
结束

启动程序():
    输出("===== §2.9.2 聚合导入三种形式 =====")

    // 默认形式：源模块名保留为子命名空间
    检查("默认: 基础库.求平方(5)=25", 基础库.求平方(5) == 25)
    检查("默认: 基础库.公开变量=100", 基础库.公开变量 == 100)
    检查("默认: 基础库.公开常量=2.5", 基础库.公开常量 == 2.5)
    检查("默认: 基础库.矩形(3,4).面积()=12", 基础库.矩形(3, 4).面积() == 12)
    检查("默认: 基础库.颜色.红!=绿", 基础库.颜色.红 != 基础库.颜色.绿)

    // 展开形式：裸名（子命名空间不复存在）
    检查("展开: 求平方(6)=36", 求平方(6) == 36)
    检查("展开: 公开变量=100", 公开变量 == 100)
    矩形 甲 = 矩形(2, 5)
    检查("展开: 结构体方法与字段", 甲.面积() == 10 且 甲.宽 == 2)

    // 别名形式：改用别名作为子命名空间（原名不可用，另由负向用例守护）
    检查("别名: 库.求平方(7)=49", 库.求平方(7) == 49)
    检查("别名: 库.公开变量=100", 库.公开变量 == 100)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
