// 遍历返回 任意，返回 索引*10
查序号(数组<整数> 列表, 整数 目标) 任意:
    循环 索引, 元素 遍历 列表:
        如果 元素 == 目标:
            返回 索引 * 10
        结束
    结束
    返回 0
结束

启动程序():
    任意 结果1 = 查序号([3,99,10], 3)
    输出("目标3 序号=" + 转文本(结果1))
    检查("目标3 应为10", 结果1 == 10)

    任意 结果2 = 查序号([3,99,10], 99)
    输出("目标99 序号=" + 转文本(结果2))
    检查("目标99 应为20", 结果2 == 20)

    任意 结果3 = 查序号([3,99,10], 10)
    输出("目标10 序号=" + 转文本(结果3))
    检查("目标10 应为30", 结果3 == 30)

    输出("总用例:" + 转文本(本模块.总用例数) + " 通过:" + 转文本(本模块.通过数) + " 失败:" + 转文本(本模块.失败数))
