// 272 的边界补充：数组 11 方法的身份语义、越界差异、不可比较元素（规范 §2.4.2 / §4.3 / §2.4.5）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

启动程序():
    输出("=== 279 数组方法边界与身份 ===")

    // ───────── 是否包含：结构相等（嵌套数组/映射按值比较）─────────
    检查("包含-嵌套数组按值相等", [1, [2]].是否包含([2]) == 真)
    检查("包含-嵌套数组不等", [1, [2]].是否包含([3]) == 假)
    检查("包含-映射按值相等", [{"甲": 1}].是否包含({"甲": 1}) == 真)
    检查("包含-映射键不同不等", [{"甲": 1}].是否包含({"甲": 2}) == 假)
    检查("包含-空值元素", [空值].是否包含(空值) == 真)
    检查("包含-数值等价 1 ≡ 1.0", [1, 2].是否包含(1.0) == 真)
    检查("包含-文本按值比较", ["甲"].是否包含("甲") == 真)

    // ───────── 查找索引：数值等价、结构相等、重复取首个 ─────────
    检查("查找索引-1.0 命中整数1", [1, 2].查找索引(1.0) == 1)
    检查("查找索引-重复取首个", [7, 7, 7].查找索引(7) == 1)
    检查("查找索引-嵌套数组按值", [1, [2]].查找索引([2]) == 2)
    检查("查找索引-空值元素", [1, 空值].查找索引(空值) == 2)

    // ───────── 获取 vs 下标：越界语义相反 ─────────
    样本 = [10, 20]
    检查("获取-索引0返回空值", 样本.获取(0) == 空值)
    检查("获取-长度+1返回空值", 样本.获取(3) == 空值)
    检查("获取-负索引返回空值", 样本.获取(0 - 5) == 空值)
    检查("获取-不改变长度", 样本.长度() == 2)
    捕获:
        越界读 = 样本[3]
        检查("下标-越界应抛异常", 假)
    异常:
        检查("下标-越界抛异常", 真)
    结束
    捕获:
        越界写 = 样本
        越界写[3] = 99
        检查("下标-写入越界应抛异常", 假)
    异常:
        检查("下标-写入越界抛异常", 真)
    结束

    // ───────── 取末尾：弹出语义（长度递减）与空数组 ─────────
    弹出 = [1, 2, 3]
    检查("取末尾-返回值", 弹出.取末尾() == 3)
    检查("取末尾-长度递减", 弹出.长度() == 2)
    弹出.取末尾()
    弹出.取末尾()
    检查("取末尾-弹空后长度0", 弹出.长度() == 0)
    检查("取末尾-空数组返回空值", 弹出.取末尾() == 空值)
    检查("取末尾-空数组再次调用仍空值", 弹出.取末尾() == 空值)

    // ───────── 排序：可比性校验（空值/跨类型 ⇒ 抛可捕获异常）─────────
    捕获:
        不可比 = [2, 空值, 1]
        不可比.排序()
        检查("排序-含空值应抛异常", 假)
    异常:
        检查("排序-含空值抛异常", 真)
        检查("排序-异常描述说明不可比较", 异常错误().描述.是否包含("不可比较") 或 异常错误().描述.是否包含("不一致"))
    结束
    捕获:
        跨类型 = [2, "a", 1]
        跨类型.排序()
        检查("排序-文本整数混合应抛异常", 假)
    异常:
        检查("排序-文本整数混合抛异常", 真)
    结束
    捕获:
        对象数组 = [[1], [2]]
        对象数组.排序()
        检查("排序-数组元素应抛异常", 假)
    异常:
        检查("排序-数组元素抛异常", 真)
    结束
    逻辑序 = [真, 假, 真]
    逻辑序.排序()
    检查("排序-逻辑按 假<真", 逻辑序[1] == 假 且 逻辑序[3] == 真)
    稳定 = [3, 1.5, 2]
    稳定.排序()
    检查("排序-整数小数混合升序", 稳定[1] == 1.5 且 稳定[3] == 3)
    空排 = []
    空排.排序()
    检查("排序-空数组安全", 空排.长度() == 0)

    // ───────── 插入/删除：边界索引 ─────────
    边界 = [1, 2]
    边界.插入(边界.长度() + 1, 3)
    检查("插入-长度+1 追加", 边界[3] == 3)
    捕获:
        坏插入 = [1]
        坏插入.插入(0, 9)
        检查("插入-索引0 应抛异常", 假)
    异常:
        检查("插入-索引0 抛异常", 真)
    结束
    捕获:
        坏删除 = [1]
        坏删除.删除(2)
        检查("删除-越界应抛异常", 假)
    异常:
        检查("删除-越界抛异常", 真)
    结束

    // ───────── 值语义（赋值/传参复制）─────────
    原始 = [1, 2]
    副本 = 原始
    副本.追加(3)
    副本[1] = 99
    检查("值语义-副本变更不影响原数组", 原始.长度() == 2 且 原始[1] == 1)
    检查("值语义-副本自身已变", 副本.长度() == 3 且 副本[1] == 99)

    // ───────── 清空后复用 ─────────
    清空样本 = [1, 2, 3]
    清空样本.清空()
    检查("清空-长度0", 清空样本.长度() == 0)
    清空样本.追加(7)
    检查("清空-可复用", 清空样本.长度() == 1 且 清空样本[1] == 7)

    // ───────── 反转：多元素/单元素/回文 ─────────
    多 = [1, 2, 3, 4]
    多.反转()
    检查("反转-四元素", 多[1] == 4 且 多[4] == 1)
    回文 = ["甲", "乙", "甲"]
    回文.反转()
    检查("反转-回文不变", 回文[1] == "甲" 且 回文[3] == "甲")

    收尾()
结束
