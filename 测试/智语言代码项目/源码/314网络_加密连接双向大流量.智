// 314 网络：加密连接两端同时大量写、同时读，不能互相等死
// ══════════════════════════════════════════════════════════════════════════
// 两端各起一个任务连续写 24MB，同时各自把对端发来的 24MB 读完。数据量远超套接字缓冲，
// 任何一端在「写套接字」时挡住了自己的读方，对端的写就会被堵住，两边一起卡到超时。
// 依赖：测试/夹具产物/ 下的证书（由回归脚本用 openssl 生成）。
// ══════════════════════════════════════════════════════════════════════════
导入 网络
导入 并发
导入 文件

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// 一边写一边读：写在单独的任务里，读在当前任务里。返回读到的字节数；出异常返回 -1。
收发(网络连接 连接, 文本 块, 整数 块数) 整数:
    写任务 = 并发.启动任务(函数() 逻辑:
        捕获:
            循环 序 = 1, 序 <= 块数, 序 += 1:
                连接.写入(块)
            结束
        异常:
            返回 假
        结束
        返回 真
    结束)
    已读 = 0
    捕获:
        循环 序 = 1, 序 <= 块数, 序 += 1:
            已读 = 已读 + 连接.读取指定(块.长度()).长度()
        结束
    异常:
        返回 -1
    结束
    如果 写任务.等待结果() == 假:
        返回 -1
    结束
    返回 已读
结束

启动程序():
    证书文件 = "../夹具产物/cert.pem"
    密钥文件 = "../夹具产物/key.pem"
    如果 文件.是否存在(证书文件) == 假:
        输出("跳过：没有测试证书（需要 openssl，由回归脚本生成）")
        返回
    结束

    块 = "0123456789abcdef"
    循环 倍 = 1, 倍 <= 12, 倍 += 1:
        块 = 块 + 块
    结束
    块数 = 384
    总字节 = 块.长度() * 块数

    监听器 = 网络.监听(18362, {"TLS": 真, "证书": 证书文件, "密钥": 密钥文件})
    服务端任务 = 并发.启动任务(函数() 整数:
        服务端 = 监听器.接受()
        服务端.设置超时(20000)
        读到 = 收发(服务端, 块, 块数)
        服务端.关闭()
        返回 读到
    结束)
    客户端 = 网络.连接("127.0.0.1", 18362, {"TLS": 真, "验证证书": 假, "超时": 3000})
    客户端.设置超时(20000)
    客户端读到 = 收发(客户端, 块, 块数)
    检查("客户端读完对端的全部数据", 客户端读到 == 总字节)
    检查("服务端读完对端的全部数据", 服务端任务.等待结果() == 总字节)
    客户端.关闭()
    监听器.关闭()

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
