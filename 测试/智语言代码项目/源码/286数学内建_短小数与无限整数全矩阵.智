// 《智语言编程规范》§5.1.12 短小数 + §5.1.13 无限整数 —— 全方法矩阵（双模）
// 短小数：f32 单精度（规则 6 按最短唯一表示输出）；与整数可混合，与普通小数禁止混合（规则 4）。
// 无限整数：任意精度；除法/整除向下取整，取余为非负（欧几里得）；不支持位运算/小数。
导入 数学

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 286 短小数与无限整数全方法矩阵（§5.1.12 / §5.1.13）===")

    // ══════════ 短小数 ══════════
    输出("-- 短小数：构造与显示 --")
    相等文本("小数构造 3.14", 数学.短小数(3.14).转文本(), "3.14")
    相等文本("整数构造 10", 数学.短小数(10).转文本(), "10")
    相等文本("文本构造 2.5", 数学.短小数("2.5").转文本(), "2.5")
    相等文本("f32 精度截断 1.23456789", 数学.短小数(1.23456789).转文本(), "1.2345679")
    检查("类型(短小数) = 短小数", 类型(数学.短小数(1)) == "短小数")

    输出("-- 短小数：四则 --")
    相等文本("3.14 * 2.0 = 6.28（规范示例）", (数学.短小数(3.14) * 数学.短小数(2.0)).转文本(), "6.28")
    相等文本("1 + 2 = 3", (数学.短小数(1) + 数学.短小数(2)).转文本(), "3")
    相等文本("1.5 - 0.5 = 1", (数学.短小数(1.5) - 数学.短小数(0.5)).转文本(), "1")
    相等文本("1 / 3 单精度 8 位", (数学.短小数(1) / 数学.短小数(3)).转文本(), "0.33333334")
    相等文本("与整数混合加", (数学.短小数(3.14) + 2).转文本(), "5.1400003")
    相等文本("与整数混合乘", (数学.短小数(1.25) * 4).转文本(), "5")

    输出("-- 短小数：幂/取负/绝对值/平方根/保留小数 --")
    相等文本("2 ^ 10 = 1024", (数学.短小数(2) ^ 10).转文本(), "1024")
    相等文本("4 ^ 0.5 = 2（小数指数）", (数学.短小数(4) ^ 数学.短小数(0.5)).转文本(), "2")
    相等文本("取负 1.5", 数学.短小数(1.5).取负().转文本(), "-1.5")
    相等文本("绝对值 -1.5", 数学.短小数(-1.5).绝对值().转文本(), "1.5")
    相等文本("平方根 16 = 4", 数学.短小数(16).平方根().转文本(), "4")
    相等文本("平方根 2 = 1.4142135", 数学.短小数(2).平方根().转文本(), "1.4142135")
    相等文本("保留小数 2.345 → 2.35", 数学.短小数(2.345).保留小数(2).转文本(), "2.35")
    相等文本("保留小数 2.5 → 3", 数学.短小数(2.5).保留小数(0).转文本(), "3")

    输出("-- 短小数：判定与比较 --")
    检查("1 是否正数", 数学.短小数(1).是否为正数() == 真)
    检查("-1 是否为负数（§5.1.12 命名）", 数学.短小数(-1).是否为负数() == 真)
    检查("0 是否为零", 数学.短小数(0).是否为零() == 真)
    相等文本("最大 2.5 vs 3.5", 数学.短小数(2.5).最大值(数学.短小数(3.5)).转文本(), "3.5")
    相等文本("最小 2.5 vs 3.5", 数学.短小数(2.5).最小值(数学.短小数(3.5)).转文本(), "2.5")
    检查("等于", 数学.短小数(1) == 数学.短小数(1))
    检查("不等于", 数学.短小数(1) != 数学.短小数(2))
    检查("大于", 数学.短小数(2) > 数学.短小数(1))
    检查("小于", 数学.短小数(1) < 数学.短小数(2))
    检查("大于等于", 数学.短小数(2) >= 数学.短小数(2))
    检查("小于等于", 数学.短小数(2) <= 数学.短小数(2))

    输出("-- 短小数：转换 --")
    检查("转整数 -1.9 = -1（向零）", 数学.短小数(-1.9).转整数() == (0 - 1))
    检查("转整数 3.9 = 3", 数学.短小数(3.9).转整数() == 3)
    检查("转小数 1.5 = 1.5", 数学.短小数(1.5).转小数() == 1.5)
    检查("转文本后长度可用", 数学.短小数(1.5).转文本().长度() == 3)

    输出("-- 短小数：复合赋值（F53 护栏）--")
    短甲 = 数学.短小数(1.5)
    短甲 += 数学.短小数(2.5)
    相等文本("+= 生效", 短甲.转文本(), "4")
    短甲 -= 数学.短小数(1)
    相等文本("-= 生效", 短甲.转文本(), "3")
    短甲 *= 数学.短小数(2)
    相等文本("*= 生效", 短甲.转文本(), "6")
    短甲 /= 数学.短小数(4)
    相等文本("/= 生效", 短甲.转文本(), "1.5")
    短甲 ^= 2
    相等文本("^= 生效", 短甲.转文本(), "2.25")

    输出("-- 短小数：异常（规则 3/4）--")
    捕获:
        非法 = 数学.短小数("abc")
        检查("非法文本必须抛异常", 假)
    异常:
        检查("非法文本异常类型为短小数错误", 异常错误().类型 == "短小数错误")
    结束
    捕获:
        零除 = 数学.短小数(1) / 数学.短小数(0)
        检查("除零必须抛异常", 假)
    异常:
        检查("除零抛异常", 异常错误().描述.是否包含("除数不能为零"))
    结束
    捕获:
        混小数 = 数学.短小数(1) + 1.5
        检查("与普通小数混合必须报错（规则 4）", 假)
    异常:
        检查("与普通小数混合抛异常", 异常错误().类型 == "短小数错误")
    结束

    // ══════════ 无限整数 ══════════
    输出("-- 无限整数：构造与显示 --")
    巨 = 数学.无限整数("123456789012345678901234567890")
    相等文本("文本构造 30 位", 巨.转文本(), "123456789012345678901234567890")
    相等文本("整数构造", 数学.无限整数(10).转文本(), "10")
    相等文本("负数文本构造", 数学.无限整数("-123456789012345678901234567890").转文本(), "-123456789012345678901234567890")
    检查("类型(无限整数) = 无限整数", 类型(数学.无限整数(1)) == "无限整数")

    输出("-- 无限整数：四则（任意精度）--")
    相等文本("大数 + 1", (巨 + 1).转文本(), "123456789012345678901234567891")
    相等文本("7 - 10 = -3", (数学.无限整数(7) - 数学.无限整数(10)).转文本(), "-3")
    相等文本("20 位平方（40 位）", (数学.无限整数("99999999999999999999") * 数学.无限整数("99999999999999999999")).转文本(), "9999999999999999999800000000000000000001")
    相等文本("7 / 2 = 3（向下取整）", (数学.无限整数(7) / 数学.无限整数(2)).转文本(), "3")
    相等文本("-7 / 2 = -4（向负无穷）", (数学.无限整数(-7) / 数学.无限整数(2)).转文本(), "-4")
    相等文本("0 / 5 = 0", (数学.无限整数(0) / 数学.无限整数(5)).转文本(), "0")
    相等文本("巨 / 1000", (巨 / 数学.无限整数(1000)).转文本(), "123456789012345678901234567")
    相等文本("-7 整除 3 = -3（向下取整）", (数学.无限整数(-7) %% 数学.无限整数(3)).转文本(), "-3")
    相等文本("-7 取余 3 = 2（非负）", (数学.无限整数(-7) % 数学.无限整数(3)).转文本(), "2")
    相等文本("7 取余 -3 = 1（非负，F57）", (数学.无限整数(7) % 数学.无限整数(-3)).转文本(), "1")
    相等文本("7 取余 3 = 1", (数学.无限整数(7) % 数学.无限整数(3)).转文本(), "1")
    相等文本("混合减整数", (数学.无限整数(10) - 3).转文本(), "7")
    相等文本("混合加整数", (数学.无限整数("18446744073709551615") + 1).转文本(), "18446744073709551616")

    输出("-- 无限整数：幂/取负/绝对值/平方根 --")
    相等文本("2 ^ 100", (数学.无限整数(2) ^ 100).转文本(), "1267650600228229401496703205376")
    相等文本("2 ^ 0 = 1", (数学.无限整数(2) ^ 0).转文本(), "1")
    相等文本("0 ^ 0 = 1", (数学.无限整数(0) ^ 0).转文本(), "1")
    相等文本("取负 5", 数学.无限整数(5).取负().转文本(), "-5")
    相等文本("绝对值 -5", 数学.无限整数(-5).绝对值().转文本(), "5")
    相等文本("平方根 100 = 10", 数学.无限整数(100).平方根().转文本(), "10")
    相等文本("平方根 2 = 1（向下取整）", 数学.无限整数(2).平方根().转文本(), "1")

    输出("-- 无限整数：判定与比较 --")
    检查("0 是否为零", 数学.无限整数(0).是否为零() == 真)
    检查("1 是否为正数（§5.1.13 命名）", 数学.无限整数(1).是否为正数() == 真)
    检查("-1 是否为负数（§5.1.13 命名）", 数学.无限整数(-1).是否为负数() == 真)
    检查("符号值 0 = 0", 数学.无限整数(0).符号值() == 0)
    检查("符号值 -1 = -1", 数学.无限整数(-1).符号值() == (0 - 1))
    相等文本("最大 3 vs 5", 数学.无限整数(3).最大值(数学.无限整数(5)).转文本(), "5")
    相等文本("最小 3 vs 5", 数学.无限整数(3).最小值(数学.无限整数(5)).转文本(), "3")
    检查("等于", 数学.无限整数(5) == 数学.无限整数(5))
    检查("不等于", 数学.无限整数(5) != 数学.无限整数(4))
    检查("大于", 数学.无限整数(5) > 数学.无限整数(4))
    检查("小于", 数学.无限整数(4) < 数学.无限整数(5))
    检查("大于等于", 数学.无限整数(5) >= 数学.无限整数(5))
    检查("小于等于", 数学.无限整数(5) <= 数学.无限整数(5))
    检查("大数比较（超出 i64）", 数学.无限整数("18446744073709551615") > 数学.无限整数("9223372036854775807"))

    输出("-- 无限整数：转换 --")
    检查("转整数 i64 最大值", 数学.无限整数(9223372036854775807).转整数() == 9223372036854775807)
    检查("转整数 -1", 数学.无限整数(-1).转整数() == (0 - 1))

    输出("-- 无限整数：复合赋值（F53 护栏）--")
    巨甲 = 数学.无限整数(10)
    巨甲 += 数学.无限整数(5)
    相等文本("+= 生效", 巨甲.转文本(), "15")
    巨甲 -= 数学.无限整数(3)
    相等文本("-= 生效", 巨甲.转文本(), "12")
    巨甲 *= 数学.无限整数(2)
    相等文本("*= 生效", 巨甲.转文本(), "24")
    巨甲 /= 数学.无限整数(5)
    相等文本("/= 生效（向下取整）", 巨甲.转文本(), "4")
    巨甲 %= 数学.无限整数(3)
    相等文本("%= 生效", 巨甲.转文本(), "1")
    巨甲 ^= 10
    相等文本("^= 生效", 巨甲.转文本(), "1")
    巨乙 = 数学.无限整数(10)
    巨乙 %%= 数学.无限整数(3)
    相等文本("%%= 生效", 巨乙.转文本(), "3")
    检查("%%= 结果仍为无限整数（§5.1.13 表）", 类型(巨乙) == "无限整数")

    输出("-- 无限整数：异常（规则 3）--")
    捕获:
        非法 = 数学.无限整数("abc")
        检查("非法文本必须抛异常", 假)
    异常:
        检查("非法文本异常类型为无限整数错误", 异常错误().类型 == "无限整数错误")
    结束
    捕获:
        零除 = 数学.无限整数(1) / 数学.无限整数(0)
        检查("除零必须抛异常", 假)
    异常:
        检查("除零抛异常", 异常错误().描述.是否包含("除数不能为零"))
    结束
    捕获:
        零余 = 数学.无限整数(1) % 数学.无限整数(0)
        检查("取余零必须抛异常", 假)
    异常:
        检查("取余零抛异常", 异常错误().描述.是否包含("除数不能为零"))
    结束
    捕获:
        负幂 = 数学.无限整数(2) ^ 数学.无限整数(-1)
        检查("负指数幂必须抛异常", 假)
    异常:
        检查("负指数异常类型为无限整数错误", 异常错误().类型 == "无限整数错误")
    结束
    捕获:
        溢出 = 数学.无限整数("123456789012345678901234567890").转整数()
        检查("转整数溢出必须抛异常", 假)
    异常:
        检查("转整数溢出异常类型为无限整数错误", 异常错误().类型 == "无限整数错误")
    结束

    收尾()
结束
