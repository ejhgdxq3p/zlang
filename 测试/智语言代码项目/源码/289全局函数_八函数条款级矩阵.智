// §4.1 全局函数（8 个）条款级矩阵（双模）
// 规范条款：§4.1 全局函数表 + 类型转换/类型判断/异常错误 三节
//   ① 转整数：整数恒等、小数向零取整、文本解析；非法格式抛异常
//   ② 转小数：整数安全提升、小数恒等、文本解析；非法格式抛异常
//   ③ 转文本：整数/小数/文本/逻辑/数组/映射（结构体与空值不在范围，另有负向用例）
//   ④ 类型：返回运行时具体类型名
//   ⑤ 异常错误：仅异常块内，含 类型/描述/位置/格式信息
结构体 坐标点():
    整数 横 = 0
    整数 纵 = 0
结束

枚举 三原色:
    红
    绿
    蓝
结束

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

应抛(文本 名称, 匿名函数 操作):
    捕获:
        操作()
        检查(名称 + "（应抛异常却成功）", 假)
    异常:
        检查(名称, 异常错误().类型 == "类型转换错误")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 289 全局函数八函数条款级矩阵（§4.1）===")

    输出("-- ① 转整数 --")
    检查("整数恒等", 转整数(42) == 42)
    检查("整数零", 转整数(0) == 0)
    检查("整数负数", 转整数(0 - 7) == 0 - 7)
    检查("小数向零取整 3.7", 转整数(3.7) == 3)
    检查("小数向零取整 -3.7", 转整数(0.0 - 3.7) == 0 - 3)
    检查("小数 .5 向零取整", 转整数(0.5) == 0)
    相等文本("文本 42", 转文本(转整数("42")), "42")
    相等文本("文本 -42", 转文本(转整数("-42")), "-42")
    相等文本("文本 +42（正号）", 转文本(转整数("+42")), "42")
    相等文本("文本前后空白", 转文本(转整数(" 42 ")), "42")
    相等文本("文本前导零 007", 转文本(转整数("007")), "7")
    相等文本("文本 -0", 转文本(转整数("-0")), "0")
    相等文本("文本 i64 上界", 转文本(转整数("9223372036854775807")), "9223372036854775807")
    相等文本("文本 i64 下界", 转文本(转整数("-9223372036854775808")), "-9223372036854775808")

    输出("-- ① 转整数 非法输入（规范：非法格式抛异常）--")
    应抛("小数文本 3.7 抛", 函数(): 转整数("3.7") 结束)
    应抛("空文本 抛", 函数(): 转整数("") 结束)
    应抛("字母 抛", 函数(): 转整数("abc") 结束)
    应抛("溢出上界 抛", 函数(): 转整数("9223372036854775808") 结束)
    应抛("溢出下界 抛", 函数(): 转整数("-9223372036854775809") 结束)

    输出("-- ② 转小数 --")
    检查("整数安全提升", 转小数(42) == 42.0)
    检查("小数恒等", 转小数(3.14) == 3.14)
    检查("文本 3.14", 转小数("3.14") == 3.14)
    检查("文本 -2.5", 转小数("-2.5") == 0.0 - 2.5)
    检查("文本 +3.14", 转小数("+3.14") == 3.14)
    检查("文本前后空白", 转小数(" 3.14 ") == 3.14)
    检查("文本科学计数法 1e3", 转小数("1e3") == 1000.0)
    检查("文本 .5（省略整数位）", 转小数(".5") == 0.5)
    检查("文本 5.（省略小数位）", 转小数("5.") == 5.0)
    检查("整数 0 提升", 转小数(0) == 0.0)

    输出("-- ② 转小数 非法输入 --")
    应抛("空文本 抛", 函数(): 转小数("") 结束)
    应抛("字母 抛", 函数(): 转小数("abc") 结束)
    应抛("混合 12a 抛", 函数(): 转小数("12a") 结束)

    输出("-- ③ 转文本 --")
    相等文本("整数", 转文本(42), "42")
    相等文本("大整数", 转文本(9223372036854775807), "9223372036854775807")
    相等文本("负数", 转文本(0 - 42), "-42")
    相等文本("小数保留小数点", 转文本(3.0), "3.0")
    相等文本("小数 3.14", 转文本(3.14), "3.14")
    相等文本("逻辑 真", 转文本(真), "真")
    相等文本("逻辑 假", 转文本(假), "假")
    相等文本("文本恒等", 转文本("原样"), "原样")
    空数组 = []
    相等文本("空数组", 转文本(空数组), "[]")
    相等文本("整数数组", 转文本([1, 2, 3]), "[1, 2, 3]")
    相等文本("嵌套数组", 转文本([1, [2, 3], 真]), "[1, [2, 3], 真]")
    相等文本("文本数组带引号", 转文本(["甲", "乙"]), "[\引号甲\引号, \引号乙\引号]")
    空映射 = {}
    相等文本("空映射", 转文本(空映射), "{}")
    单键映射 = {"甲": 1}
    相等文本("单键映射", 转文本(单键映射), "{\引号甲\引号: 1}")

    输出("-- ④ 类型 --")
    相等文本("整数", 类型(42), "整数")
    相等文本("小数", 类型(3.14), "小数")
    相等文本("文本", 类型("你好"), "文本")
    相等文本("逻辑", 类型(真), "逻辑")
    相等文本("空值", 类型(空值), "空值")
    相等文本("数组", 类型([1, 2, 3]), "数组")
    相等文本("映射", 类型({"键": "值"}), "映射")
    点值 = 坐标点()
    相等文本("结构体返回类型名", 类型(点值), "坐标点")
    相等文本("枚举成员返回枚举名", 类型(三原色.红), "三原色")
    任意包装 = 42
    相等文本("任意包装保持实际类型", 类型(任意包装), "整数")

    输出("-- ⑤ 异常错误 --")
    捕获:
        转整数("不是数字")
        检查("异常块未进入", 假)
    异常:
        错误 = 异常错误()
        相等文本("异常类型", 错误.类型, "类型转换错误")
        检查("异常描述非空", 错误.描述.长度() > 0)
        检查("异常位置含行号分隔符", 错误.位置.是否包含(":") 或 错误.位置.长度() > 0)
        检查("格式信息非空", 错误.格式信息().长度() > 0)
        检查("格式信息含类型名", 错误.格式信息().是否包含("类型转换错误"))
    结束

    捕获:
        结果 = 10 / 0
        检查("除零未抛", 假)
    异常:
        检查("除零异常类型非空", 异常错误().类型.长度() > 0)
        检查("除零异常描述含零", 异常错误().描述.是否包含("零") 或 异常错误().描述.长度() > 0)
    结束

    捕获:
        捕获:
            抛出 "内层异常"
        异常:
            抛出 "外层包装：" + 异常错误().描述
        结束
    异常:
        检查("嵌套捕获外层描述可读", 异常错误().描述.是否包含("外层包装"))
    结束

    检查("异常处理后程序继续执行", 真)
    收尾()
结束
