// 常量字段风险点验证：泛型结构体常量字段 / 构造器常量初值发射 / 常量参与运算
通过数 = 0
失败数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// 泛型结构体常量字段：常量初值须为编译期常量（字面量），可参与方法内运算
结构体 容器(任意<甲> 值):
    常量 类型名 = "容器"          // 字面量，编译期常量，泛型结构体常量字段
    取类型名() 文本:
        返回 自身.类型名
    结束
    描述() 文本:
        返回 自身.类型名 + ":" + 转文本(值)   // 常量 + 参数 参与运算
    结束
结束

// 构造器需正确发射常量字段初值，实例化后常量字段可访问并参与运算
结构体 圆(小数 半径):
    常量 圆周率 = 3.14159
    周长() 小数:
        返回 自身.圆周率 * 半径 * 2
    结束
    面积() 小数:
        返回 自身.圆周率 * 半径 ^ 2
    结束
结束

启动程序():
    输出("==== 常量字段风险点验证 ====")
    盒 = 容器(42)
    检查("泛型结构体常量字段访问", 盒.取类型名() == "容器")
    检查("泛型常量参与运算", 盒.描述() == "容器:42")

    大圆 = 圆(2.0)
    检查("构造器常量初值发射-周长", 大圆.周长() > 12.5)
    检查("构造器常量初值发射-面积", 大圆.面积() > 12.5)

    输出("==== 测试结果 ====")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
