// 273 的边界补充：映射键身份（空值键/整数≡小数/负零）、所有键/值是副本、删除语义（规范 §2.4.2 / §4.4）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

启动程序():
    输出("=== 280 映射键身份与副本 ===")

    // ───────── 空值可作键（规范 §2.4.2 键白名单含「空值」）─────────
    含空值键 = {}
    含空值键.插入(空值, "空键值")
    检查("空值键-长度1", 含空值键.长度() == 1)
    检查("空值键-取回", 含空值键.获取(空值) == "空键值")
    检查("空值键-是否包含", 含空值键.是否包含(空值) == 真)
    含空值键.插入("甲", 1)
    检查("空值键-可与其它键共存（异构）", 含空值键.长度() == 2)

    // ───────── 数值键身份：1 ≡ 1.0、-0.0 ≡ 0 ─────────
    数值键 = {1: "整数一"}
    检查("键身份-小数取整数键", 数值键.获取(1.0) == "整数一")
    检查("键身份-是否包含小数形式", 数值键.是否包含(1.0) == 真)
    负零 = {0 - 0.0: "零"}
    检查("键身份-负零与0同键", 负零.获取(0) == "零")
    检查("键身份-负零长度1", 负零.长度() == 1)
    数值键.插入(1.0, "覆盖")
    检查("键身份-1.0 覆盖同一键", 数值键.长度() == 1 且 数值键.获取(1) == "覆盖")

    // ───────── 逻辑键：真/假独立 ─────────
    逻辑键 = {真: "是", 假: "否"}
    检查("逻辑键-真", 逻辑键.获取(真) == "是")
    检查("逻辑键-假", 逻辑键.获取(假) == "否")
    检查("逻辑键-长度2", 逻辑键.长度() == 2)
    检查("逻辑键-与整数1不同键", 逻辑键.是否包含(1) == 假)

    // ───────── 所有键 / 所有值 返回**副本**（改副本不影响映射）─────────
    原映射 = {"甲": 1, "乙": 2}
    键副本 = 原映射.所有键()
    键副本.追加("丙")
    键副本[1] = "改"
    检查("所有键-是副本（映射长度不变）", 原映射.长度() == 2)
    检查("所有键-副本自身可改", 键副本.长度() == 3 且 键副本[1] == "改")
    值副本 = 原映射.所有值()
    值副本[1] = 99
    检查("所有值-是副本（映射值不变）", 原映射.获取("甲") == 1)
    检查("所有值-副本自身可改", 值副本[1] == 99)

    // ───────── 插入/更新/删除 的键序 ─────────
    顺序 = {"一": 1, "二": 2}
    顺序.插入("三", 3)
    检查("插入-追加末尾", 顺序.所有键()[3] == "三")
    顺序.插入("一", 10)
    检查("插入-更新不改序", 顺序.所有键()[1] == "一" 且 顺序.获取("一") == 10)
    顺序.删除("二")
    检查("删除-剩余顺序保持", 顺序.所有键()[1] == "一" 且 顺序.所有键()[2] == "三")
    长度前 = 顺序.长度()
    顺序.删除("不存在")
    记录("删除不存在键（规范未定义）后的长度", 转文本(顺序.长度()))
    检查("删除不存在键-长度不变、不抛异常", 顺序.长度() == 长度前)

    // ───────── 值可以本身是空值（与"键不存在"靠 是否包含 区分）─────────
    空值值映射 = {"甲": 空值}
    检查("空值值-键存在", 空值值映射.是否包含("甲") == 真)
    检查("空值值-获取为空值", 空值值映射.获取("甲") == 空值)
    检查("空值值-缺键也是空值（不可区分）", 空值值映射.获取("乙") == 空值)
    检查("空值值-缺键 是否包含为假", 空值值映射.是否包含("乙") == 假)

    // ───────── 下标 vs 获取 ─────────
    混合 = {"甲": 1}
    检查("下标-命中", 混合["甲"] == 1)
    捕获:
        缺失 = 混合["乙"]
        检查("下标-缺键应抛异常", 假)
    异常:
        检查("下标-缺键抛异常", 真)
    结束
    检查("获取-缺键返回空值", 混合.获取("乙") == 空值)

    // ───────── 清空 + 值语义 ─────────
    清空样本 = {"甲": 1}
    清空样本.清空()
    检查("清空-长度0", 清空样本.长度() == 0)
    清空样本.插入("乙", 2)
    检查("清空-可复用", 清空样本.长度() == 1)
    原 = {"甲": 1}
    副本 = 原
    副本.插入("乙", 2)
    检查("值语义-副本插入不影响原映射", 原.长度() == 1)

    // ───────── 嵌套映射访问 ─────────
    嵌套 = {"外层": {"内层": 42}}
    检查("嵌套-逐层获取", 嵌套.获取("外层").获取("内层") == 42)
    检查("嵌套-下标逐层", 嵌套["外层"]["内层"] == 42)
    嵌套["外层"]["内层"] = 43
    检查("嵌套-写入生效", 嵌套.获取("外层").获取("内层") == 43)

    收尾()
结束
