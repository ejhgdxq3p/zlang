// 时间模块 16 函数矩阵：格式往返、分量自洽、计算正负、计时器/休眠
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 188 时间模块矩阵 ===")
    基 = 时间.解析("2024-01-01 08:09:10", "年-月-日 时:分:秒")
    // ① 解析↔格式化 精确往返
    检查("往返-完整格式", 时间.格式化("年-月-日 时:分:秒", 基) == "2024-01-01 08:09:10")
    检查("往返-仅日期", 时间.格式化("年-月-日", 基) == "2024-01-01")
    检查("往返-仅时分秒", 时间.格式化("时:分:秒", 基) == "08:09:10")
    检查("格式化-年", 时间.格式化("年", 基) == "2024")
    // ② 分量与格式化一致（交叉自洽）
    检查("分量-年一致", 时间.获取年(基) == 2024)
    检查("分量-月一致", 时间.获取月(基) == 1)
    检查("分量-日一致", 时间.获取日(基) == 1)
    检查("分量-时一致", 时间.获取时(基) == 8)
    检查("分量-分一致", 时间.获取分(基) == 9)
    检查("分量-秒一致", 时间.获取秒(基) == 10)
    检查("分量-与格式化年一致", 时间.格式化("年", 基) == 转文本(时间.获取年(基)))
    // ③ 星期（规范：1=星期一）
    检查("星期-2024-01-01 是周一", 时间.获取星期(基) == 1)
    检查("星期-加一天变周二", 时间.获取星期(时间.加(基, 86400)) == 2)
    检查("星期-加六天变周日", 时间.获取星期(时间.加(基, 86400 * 6)) == 7)
    检查("星期-加七天回周一", 时间.获取星期(时间.加(基, 86400 * 7)) == 1)
    检查("星期-恒在1到7", 时间.获取星期(基 + 12345) >= 1 且 时间.获取星期(基 + 12345) <= 7)
    // ④ 时间计算
    检查("加-一天后日分量", 时间.获取日(时间.加(基, 86400)) == 2)
    检查("减-一天前为上年末", 时间.格式化("年-月-日", 时间.减(基, 86400)) == "2023-12-31")
    检查("加减互逆", 时间.减(时间.加(基, 777), 777) == 基)
    检查("间隔天数-同日为0", 时间.间隔天数(基, 基) == 0)
    检查("间隔天数-正序一天", 时间.间隔天数(时间.加(基, 86400), 基) == 1)
    检查("间隔天数-反序一天", 时间.间隔天数(基, 时间.加(基, 86400)) == -1)
    检查("间隔天数-自纪元", 时间.间隔天数(基, 0) == 19723)
    // ⑤ 游标时钟
    开始毫秒 = 时间.获取计时器()
    检查("计时器-类型为整数", 类型(开始毫秒) == "整数")
    检查("计时器-非负", 开始毫秒 >= 0)
    现在秒 = 时间.当前时间()
    现在毫秒 = 时间.当前毫秒时间()
    检查("当前时间-量级合理", 现在秒 > 1700000000)
    检查("当前毫秒-约为秒的1000倍", 现在毫秒 / 1000 >= 现在秒 - 5)
    检查("计时器-单调不减", 时间.获取计时器() >= 开始毫秒)
    // ⑥ 休眠（仅验证不报错且耗时下限）
    起 = 时间.获取计时器()
    时间.休眠(20)
    检查("休眠-至少耗时20毫秒", 时间.获取计时器() - 起 >= 20)
    收尾()
结束
