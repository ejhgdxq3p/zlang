// ============================================================
// 标准库 边界/负面用例 全面测试（验证健壮性，不崩溃且行为符合规范）
// 对照《智语言编程规范》4.x/5.4/5.6 的异常行为约定
// 覆盖：数组越界、映射[键]缺失抛异常、文本截取越界、非法类型转换抛异常、时间解析异常
// 全部用例用 检查() 统计。双模验证。
// ============================================================

导入 时间
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 标准库边界/负面用例 =====")

    // 数组越界：索引超过长度 → 抛异常
    数组测 = [1, 2, 3]
    是否抛 = 假
    捕获:
        临时1 = 数组测[10]
        输出("未触发异常：" + 转文本(临时1))
    异常:
        是否抛 = 真
    结束
    检查("数组越界访问 抛异常", 是否抛)

    // 映射[键] 缺失键：应抛异常（.获取 才返回空值）
    映射测 = {"甲": 1}
    是否抛 = 假
    捕获:
        临时2 = 映射测["不存在"]
        输出("未触发异常：" + 转文本(临时2))
    异常:
        是否抛 = 真
    结束
    检查("映射[缺失键] 抛异常", 是否抛)

    // 文本截取越界：应从容处理（不崩溃，返回文本）
    检查("文本.截取 越界不崩溃 返回文本", 类型("你好".截取(10, 5)) == "文本")

    // 非法整数转换：应抛异常
    是否抛 = 假
    捕获:
        临时3 = 转整数("abc")
        输出("未触发异常：" + 转文本(临时3))
    异常:
        是否抛 = 真
    结束
    检查("转整数(文本'abc') 抛异常", 是否抛)

    // 非法小数转换：应抛异常
    是否抛 = 假
    捕获:
        临时4 = 转小数("abc")
        输出("未触发异常：" + 转文本(临时4))
    异常:
        是否抛 = 真
    结束
    检查("转小数(文本'abc') 抛异常", 是否抛)

    // 时间解析非法格式：应抛异常（解析失败）
    是否抛 = 假
    捕获:
        临时5 = 时间.解析("不是日期", "年-月-日")
        输出("未触发异常：" + 转文本(临时5))
    异常:
        是否抛 = 真
    结束
    检查("时间.解析 非法格式 抛异常", 是否抛)

    // 时间解析 正确日期字符串：应返回约 2000-01-01 的时间戳（≈9.4亿秒）
    正确戳 = 时间.解析("2000-01-01", "年-月-日")
    检查("时间.解析 正确日期返回正整数", 正确戳 > 900000000 且 正确戳 < 1000000000)
    检查("时间.解析 纯数字时间戳兼容", 时间.解析("1000000", "") == 1000000)

    // 映射.获取 缺失键：返回空值（不抛异常，与 [键] 区分）
    检查("映射.获取(缺失键)=空值", 映射测.获取("不存在") == 空值)
    // 数组.查找索引 未找到=0
    检查("数组.查找索引(不存在)=0", 数组测.查找索引(99) == 0)
    // 文本.查找 未找到=0
    检查("文本.查找(不存在)=0", "你好".查找("再见") == 0)

    // 正则替换非法正则：应抛异常
    是否抛 = 假
    捕获:
        临时6 = 工具.正则替换("([", "X", "ab")
        输出("未触发异常：" + 临时6)
    异常:
        是否抛 = 真
    结束
    检查("正则替换 非法正则 抛异常", 是否抛)

    输出("")
    输出("===== 边界结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部边界用例通过")
    结束
结束
