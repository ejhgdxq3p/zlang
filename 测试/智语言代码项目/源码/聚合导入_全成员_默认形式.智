// 文件: 聚合导入_全成员_默认形式.智
// 职责: 验证【默认形式聚合】导入后，子命名空间 成员库 下全部成员类型均可外部访问：
//       函数、变量、常量、枚举、接口(适配结构体方法)、结构体(字段+方法)。
// 项目模式：聚合模块名不作为前缀，子命名空间 成员库 直接作为前缀（成员库.成员）。

导入 聚合子模块/聚合_默认 展开

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 聚合导入 默认形式（子命名空间）全成员访问 =====")

    // 函数
    检查("函数: 求平方(5)=25", 成员库.求平方(5) == 25)

    // 变量
    检查("变量: 公开变量=100", 成员库.公开变量 == 100)

    // 常量
    检查("常量: 公开常量=3.14159", 成员库.公开常量 == 3.14159)

    // 枚举
    检查("枚举: 红!=绿", 成员库.颜色.红 != 成员库.颜色.绿)
    检查("枚举: 蓝存在", 成员库.颜色.蓝 != 成员库.颜色.红)

    // 结构体（字段 + 方法）
    成员库.矩形 矩形实例 = 成员库.矩形(3, 4)
    检查("结构体字段: 宽=3", 矩形实例.宽 == 3)
    检查("结构体字段: 高=4", 矩形实例.高 == 4)
    检查("结构体方法: 面积()=12", 矩形实例.面积() == 12)

    // 接口方法（适配接口的结构体，经聚合后方法可调用）
    成员库.圆形 圆实例 = 成员库.圆形(3)
    检查("接口方法: 圆形.描述()", 圆实例.描述() == "圆形半径=3")

    // 经聚合导出的函数接收经聚合导出的结构体（类型身份一致）
    检查("跨聚合类型一致: 面积汇总(矩形)", 成员库.面积汇总(矩形实例) == 12)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
