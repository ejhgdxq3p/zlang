// 271 的边界补充：文本 7 方法的极限与未定义行为实测（规范 §4.2）
// 规范未定义的情形用 ℹ 记录 + 只断言"不崩、不丢信息"，避免把实现细节写成契约。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

启动程序():
    输出("=== 278 文本方法边界极限 ===")

    // ───────── 替换：空旧串（每个位置插入）、不存在、全文替换 ─────────
    检查("替换-空旧串每个位置插入", "abc".替换("", "-") == "-a-b-c-")
    检查("替换-旧串不存在原样返回", "abc".替换("z", "y") == "abc")
    检查("替换-替换为空串即删除", "banana".替换("na", "") == "ba")
    检查("替换-旧串等于全文", "abc".替换("abc", "x") == "x")
    检查("替换-新旧相同不变", "abc".替换("b", "b") == "abc")
    检查("替换-中文替换", "我爱编程".替换("编程", "智语言") == "我爱智语言")

    // ───────── 分隔：末尾分隔符产生空串元素、多字符分隔、无匹配 ─────────
    末尾 = "a,b,".分隔(",")
    检查("分隔-末尾分隔符产生空元素", 末尾.长度() == 3 且 末尾[3] == "")
    前导 = ",a,b".分隔(",")
    检查("分隔-前导分隔符产生空元素", 前导.长度() == 3 且 前导[1] == "")
    多字符 = "aa".分隔("aa")
    检查("分隔-多字符分隔符", 多字符.长度() == 2 且 多字符[1] == "" 且 多字符[2] == "")
    无匹配 = "abc".分隔(",")
    检查("分隔-无匹配得到单元素", 无匹配.长度() == 1 且 无匹配[1] == "abc")
    检查("分隔-中文分隔符", "甲|乙|丙".分隔("|")[2] == "乙")

    // ───────── 查找：空子串、首末位置、未找到 ─────────
    检查("查找-空子串返回1", "abc".查找("") == 1)
    检查("查找-空串查空串返回1", "".查找("") == 1)
    检查("查找-首字符", "abc".查找("a") == 1)
    检查("查找-末字符", "ab".查找("b") == 2)
    检查("查找-未找到返回0", "abc".查找("z") == 0)
    检查("查找-空串查非空返回0", "".查找("a") == 0)
    检查("查找-中文位置按字符计", "你好世界".查找("世界") == 3)

    // ───────── 去除空白：空格/制表/换行都应去掉，中间空白保留 ─────────
    检查("去除空白-制表与换行", " \制表\换行 a \制表\换行 ".去除空白() == "a")
    检查("去除空白-中间空格保留", "  a b  ".去除空白() == "a b")
    检查("去除空白-纯空白得空串", " \制表 ".去除空白() == "")
    检查("去除空白-空串安全", "".去除空白() == "")

    // ───────── 统一码：按 Unicode 标量计数（emoji 算 1 个字符）─────────
    检查("统一码-emoji 与字母长度2", "😀a".长度() == 2)
    检查("统一码-截取 emoji 完整", "😀a".截取(1, 1) == "😀")
    检查("统一码-查找字母在 emoji 之后", "😀a".查找("a") == 2)
    检查("统一码-中文长度", "你好世界".长度() == 4)
    检查("统一码-组合文本截取", "甲乙丙丁".截取(2, 2) == "乙丙")

    // ───────── 截取：长度 0 / 边界（越界行为规范未定义 ⇒ ℹ 记录）─────────
    检查("截取-长度0得空串", "abc".截取(2, 0) == "")
    记录("截取-长度超出（未定义）", "abc".截取(1, 100))
    检查("截取-长度超出不抛异常且不丢首字符", "abc".截取(1, 100).截取(1, 1) == "a")
    记录("截取-起始0（未定义）", "abc".截取(0, 2))
    检查("截取-起始越界得空串", "abc".截取(4, 1) == "")

    // ───────── 是否包含：空串、全文、中文 ─────────
    检查("是否包含-空串恒真", "abc".是否包含("") == 真)
    检查("是否包含-全文", "abc".是否包含("abc") == 真)
    检查("是否包含-子串", "abcdef".是否包含("cd") == 真)
    检查("是否包含-未命中", "abc".是否包含("z") == 假)
    检查("是否包含-空串容器查非空", "".是否包含("a") == 假)

    // ───────── 链式调用（规范 §4.2 示例同款）─────────
    链 = "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2)
    检查("链式-去除空白+替换+截取", 链 == "你好")
    检查("链式-分隔后取长度", "苹果,香蕉,橙子,葡萄".分隔(",").长度() == 4)
    检查("链式-分隔后拼接", "甲,乙".分隔(",")[1] + "丙" == "甲丙")

    // ───────── 文本不可变 ─────────
    原文 = "abc"
    改后 = 原文.替换("a", "z")
    检查("文本不可变-原值不变", 原文 == "abc" 且 改后 == "zbc")

    收尾()
结束
