    映射 外层 = {"层1": {"内": 10}}
    映射 新内层 = {"内": 60}
    外层["层1"] = 新内层
    整数 读回 = 外层["层1"]["内"]
    输出("单层映射写回后[层1][内]=" + 转文本(读回) + " (期望60)")

    // 单层映射值写回：外层["层1"]["内"] 直接赋值（嵌套）
