// 全局 8 函数 × 转换边界（整数/小数/文本互转的极值与异常面）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 194 全局函数 转换边界 ===")
    // ① 转整数 边界
    检查("转整数-常规", 转整数("42") == 42)
    检查("转整数-前导零", 转整数("007") == 7)
    检查("转整数-负载正号", 转整数("+42") == 42)
    检查("转整数-零", 转整数("0") == 0)
    检查("转整数-负零", 转整数("-0") == 0)
    检查("转整数-小数文本被拒或截断", 真)
    捕获:
        得 = 转整数("42.9")
        记录("转整数-小数文本(42.9)", 转文本(得))
    异常:
        记录("转整数-小数文本(42.9)", "抛异常")
    结束
    捕获:
        得2 = 转整数(" 42 ")
        记录("转整数-含空格", 转文本(得2))
    异常:
        记录("转整数-含空格", "抛异常")
    结束
    捕获:
        得3 = 转整数("")
        记录("转整数-空串", 转文本(得3))
    异常:
        记录("转整数-空串", "抛异常")
    结束
    捕获:
        得4 = 转整数("甲乙")
        记录("转整数-中文", 转文本(得4))
    异常:
        记录("转整数-中文", "抛异常")
    结束
    // ② 转小数 边界
    检查("转小数-常规", 转小数("2.5") == 2.5)
    检查("转小数-整数文本", 转小数("7") == 7.0)
    检查("转小数-负值", 转小数("-0.25") == -0.25)
    检查("转小数-零", 转小数("0.0") == 0.0)
    捕获:
        小 = 转小数("1e3")
        记录("转小数-科学计数(1e3)", 转文本(小))
    异常:
        记录("转小数-科学计数(1e3)", "抛异常")
    结束
    捕获:
        小2 = 转小数(".5")
        记录("转小数-省略整数部分(.5)", 转文本(小2))
    异常:
        记录("转小数-省略整数部分(.5)", "抛异常")
    结束
    // ③ 小数 ↔ 整数 互转的取整方向（规范 §4.1：向零取整）
    检查("取整-正数向零", 转整数(2.9) == 2)
    检查("取整-负数向零", 转整数(-2.9) == -2)
    检查("取整-正零点五", 转整数(0.5) == 0)
    检查("取整-负零点五", 转整数(-0.5) == 0)
    // ④ 转文本 精度与形态
    检查("转文本-小数整数形态", 转文本(2.0) == "2.0" 或 转文本(2.0) == "2")
    记录("转文本(2.0)", 转文本(2.0))
    记录("转文本(0.1 + 0.2)", 转文本(0.1 + 0.2))
    记录("转文本(1.0 / 3.0)", 转文本(1.0 / 3.0))
    检查("转文本-负数小数", 转文本(-1.5) == "-1.5")
    // ⑤ 类型() 与 转文本 的交叉一致性
    检查("交叉-整数", 类型(1) == "整数" 且 转文本(1) == "1")
    检查("交叉-逻辑真", 类型(真) == "逻辑" 且 转文本(真) == "真")
    检查("交叉-文本", 类型("甲") == "文本" 且 转文本("甲") == "甲")
    检查("交叉-数组", 类型([1]) == "数组")
    检查("交叉-映射", 类型({"甲": 1}) == "映射")
    检查("交叉-小数", 类型(1.5) == "小数")
    // ⑥ 文本 ↔ 数值 往返（值域内）
    检查("往返-整数", 转整数(转文本(12345)) == 12345)
    检查("往返-负整数", 转整数(转文本(-12345)) == -12345)
    检查("往返-小数", 转小数(转文本(1.25)) == 1.25)
    检查("往返-小数负", 转小数(转文本(-1.25)) == -1.25)
    检查("往返-零", 转整数(转文本(0)) == 0)
    // ⑦ 异常错误() 仅在异常块内可用：此处只验证捕获链路
    捕获:
        抛出 异常错误("自定义消息")
    异常:
        检查("捕获-自定义异常描述", 异常错误().描述 == "自定义消息")
    结束
    收尾()
结束
