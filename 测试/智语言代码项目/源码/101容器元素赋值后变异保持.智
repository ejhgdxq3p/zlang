// 正向回归（2026-09-21）：容器元素「赋值后方法内变异」必须保持（同 RC 平衡根因）。
//   根因：索引存储/数组存储 对写入值 +1，而新建值临时未 −1 ⇒ 计数虚高 ⇒ COW 分离丢失修改
//   （实测 `列表[1] = 单车(4); 列表[1].移动(85)` 读回 4 而非 85，双模一致）。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 单车(整数 初始速度):
    整数 速度 = 初始速度
    移动(整数 新速度):
        自身.速度 = 新速度
    结束
    取速度() 整数:
        返回 自身.速度
    结束
结束

启动程序():
    列表 = [单车(1)]
    列表[1].移动(83)
    检查("数组元素直链变异", 列表[1].取速度() == 83)

    列表[1] = 单车(4)
    检查("数组元素赋值后读值正确", 列表[1].取速度() == 4)
    列表[1].移动(85)
    检查("数组元素赋值后变异保持", 列表[1].取速度() == 85)

    映射表 = {"车": 单车(2)}
    映射表["车"].移动(84)
    检查("映射元素直链变异", 映射表["车"].取速度() == 84)

    映射表["车"] = 单车(6)
    检查("映射元素赋值后读值正确", 映射表["车"].取速度() == 6)
    映射表["车"].移动(86)
    检查("映射元素赋值后变异保持", 映射表["车"].取速度() == 86)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
