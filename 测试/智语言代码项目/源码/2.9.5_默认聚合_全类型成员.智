// 规范 §2.9.2「默认形式」：聚合后对外名 = `被聚合模块末段.成员`
//   专项验证默认形式下**全部成员类型**可用：变量 / 常量 / 函数 / 容器 / 枚举 / 结构体（字段 + 方法）。
//   （2026-10-17：项目外聚合曾因模块键是绝对路径、末段被 `.智` 后缀干扰而报「类型没有方法」，
//     本用例锁定项目内默认形式基线，与项目外用例 `聚合导入项目外/主模块/入口.智` 成对。）
导入 聚合校验/类型_默认 展开

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== §2.9.5 默认形式聚合 · 全类型成员 =====")

    // —— 基础类型 ——
    检查("变量 类型库.型整数变量 = 42", 类型库.型整数变量 == 42)
    检查("变量 类型库.型文本变量", 类型库.型文本变量 == "智语言")
    检查("常量 类型库.型整数常量 = 7", 类型库.型整数常量 == 7)
    检查("函数 类型库.型整数加(2,3) = 5", 类型库.型整数加(2, 3) == 5)
    检查("函数 类型库.型文本拼接", 类型库.型文本拼接("甲", "乙") == "甲乙")

    // —— 容器类型 ——
    检查("容器 类型库.型数组变量 长度 = 3", 类型库.型数组变量.长度() == 3)
    检查("容器 类型库.型映射变量 获取(甲) = 1", 类型库.型映射变量.获取("甲") == 1)
    检查("容器函数 类型库.型数组求和 = 6", 类型库.型数组求和([1, 2, 3]) == 6)

    // —— 自定义类型：枚举 ——
    检查("枚举 类型库.型方向.上 != 下", 类型库.型方向.上 != 类型库.型方向.下)

    // —— 自定义类型：结构体（字段 + 方法 + 方法返回容器）——
    类型库.型容器盒 盒 = 类型库.型容器盒([1, 2, 3])
    检查("结构体字段 数据长度 = 3", 盒.数据.长度() == 3)
    检查("结构体方法 总量 = 6", 盒.总量() == 6)
    检查("结构体方法返回容器 [2] = 2", 盒.取数据()[2] == 2)
    检查("结构体作参数 型盒总量 = 6", 类型库.型盒总量(盒) == 6)

    类型库.型点 点 = 类型库.型点(1, 2)
    检查("结构体方法 名称 = 点(1,2)", 点.名称() == "点(1,2)")

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
