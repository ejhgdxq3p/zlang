    检查("映射.是否包含 不存在键=假", 映射甲.是否包含("不存在") == 假)
    映射甲.插入("空值键", 空值)
    检查("映射.插入 空值作值 长度=2", 映射甲.长度() == 2)
    检查("映射.获取 空值键可取回空值", 映射甲.获取("空值键") == 空值)
    空映射 = {}
    检查("映射.所有键 空映射长度=0", 空映射.所有键().长度() == 0)
    检查("映射.所有值 空映射长度=0", 空映射.所有值().长度() == 0)
    重复插 = {"k": 1}
    重复插.插入("k", 2)
    检查("映射.插入 同键覆盖 长度不变", 重复插.长度() == 1)
    检查("映射.插入 同键覆盖 值=2", 重复插.获取("k") == 2)

    // ===================== 五、时间模块边界 =====================
    输出("===== 五、时间模块边界 =====")
    // 时间.解析 非法格式 真实行为：抛「时间解析失败」可捕获异常（与 转整数("abc")/转小数("abc") 一致，规范空值/非法不参与转换应抛异常）
    捕获:
        时间.解析("不是日期", "年-月-日")
        检查("时间.解析 非法格式 不应到达此处", 假)
    异常:
        检查("时间.解析 非法格式 抛异常", 真)
    结束
    现在 = 时间.当前时间()
    过去 = 时间.减(现在, 86400)
    反向间隔 = 时间.间隔天数(过去, 现在)
    检查("时间.间隔天数 反向为负", 反向间隔 == -1)
    计时1 = 时间.获取计时器()
    计时2 = 时间.获取计时器()
    检查("时间.获取计时器 单调递增", 计时2 >= 计时1)

    // ===================== 六、工具模块边界 =====================
    输出("===== 六、工具模块边界 =====")
    无命中 = 工具.正则匹配("[0-9]+", "纯中文无数字")
    检查("工具.正则匹配 无命中 空数组", 无命中.长度() == 0)
