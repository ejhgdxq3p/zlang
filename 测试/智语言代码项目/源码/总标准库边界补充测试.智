    检查("数组.排序 已排序不变首=1", 已排序[1] == 1)
    检查("数组.排序 已排序不变尾=4", 已排序[4] == 4)
    空数组 = []
    空数组.反转()
    检查("数组.反转 空数组长度=0", 空数组.长度() == 0)
    越界查找 = [10, 20].查找索引(99)
    检查("数组.查找索引 不存在=0", 越界查找 == 0)
    // 数组.插入 越界索引 真实行为：抛出「数组越界」可捕获异常（规范 §7157 索引越界抛异常）
    越界插入 = [1, 2]
    插入越界抛 = 假
    捕获:
        越界插入.插入(99, 100)
    异常:
        插入越界抛 = 真
    结束
    检查("数组.插入 越界索引 抛异常", 插入越界抛)
    检查("数组.插入 越界索引 原[1]=1", 越界插入[1] == 1)
    检查("数组.插入 越界索引 原[2]=2", 越界插入[2] == 2)
    重复元素 = [5, 5, 5]
    检查("数组.是否包含 重复元素=真", 重复元素.是否包含(5))
    重复查找 = [5, 5, 5].查找索引(5)
    检查("数组.查找索引 重复取首个>0", 重复查找 > 0)

    // ===================== 四、映射方法边界 =====================
    输出("===== 四、映射方法边界 =====")
    映射甲 = {"键1": "值1"}
