    检查("文本.分隔 无匹配 长度=1", 分隔越界.长度() == 1)
    检查("文本.分隔 无匹配[1]='a,b,c'", 分隔越界[1] == "a,b,c")
    截取越界 = "你好".截取(1, 10)
    检查("文本.截取 超出长度 截断", 截取越界 == "你好")
    替换无 = "abc".替换("x", "y")
    检查("文本.替换 无匹配 原样", 替换无 == "abc")
    中间空白 = "  a b  c  ".去除空白()
    检查("文本.去除空白 仅去首尾 中间保留", 中间空白 == "a b  c")
    空文本长 = "".长度()
    检查("文本.长度 空文本=0", 空文本长 == 0)
    查找零 = "abc".查找("")
    检查("文本.查找 空串 返回位置1(空串视为存在)", 查找零 == 1)
    是否含空 = "abc".是否包含("")
    检查("文本.是否包含 空串=真(空串视为包含)", 是否含空 == 真)

    // ===================== 三、数组方法边界 =====================
    输出("===== 三、数组方法边界 =====")
    已排序 = [1, 2, 3, 4]
