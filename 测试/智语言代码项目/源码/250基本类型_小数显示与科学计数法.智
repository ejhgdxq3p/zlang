// 覆盖《智语言编程规范》§2.4.1「小数类型」显示规则（汇总表）+ 科学计数法：
//   L1119-1170 附近「小数显示默认规则」：普通十进制（不用科学计数法）+ 去末尾零但至少一位小数
//     + 最短唯一表示（不隐藏浮点噪声）+ 特殊值中文名；科学计数法须显式调用 数学.科学计数法
导入 数学

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 250 小数显示与科学计数法（§2.4.1）===")

    // 1. 不使用科学计数法
    检查("转文本(1234567.89) 用普通十进制", 转文本(1234567.89) == "1234567.89")
    检查("转文本(0.000012345) 不用科学计数法", 转文本(0.000012345) == "0.000012345")

    // 2. 去末尾零，但至少保留一位小数
    检查("转文本(3.0) → 3.0", 转文本(3.0) == "3.0")
    检查("转文本(3.50) → 3.5", 转文本(3.50) == "3.5")
    检查("转文本(3.00) → 3.0", 转文本(3.00) == "3.0")
    检查("转文本(-2.5) → -2.5", 转文本(-2.5) == "-2.5")

    // 3. 最短唯一表示，不隐藏浮点噪声
    检查("转文本(0.1+0.2) = 0.30000000000000004", 转文本(0.1 + 0.2) == "0.30000000000000004")
    检查("转文本(1.0/3.0) 如实显示", 转文本(1.0 / 3.0) == "0.3333333333333333")
    检查("0.1+0.2 不等于 0.3（浮点真相）", (0.1 + 0.2 == 0.3) == 假)

    // 4. 特殊值保留中文名
    检查("正无穷 → 正无穷", 转文本(数学.正无穷) == "正无穷")
    检查("负无穷 → 负无穷", 转文本(数学.负无穷) == "负无穷")
    检查("无效小数 → 无效小数", 转文本(数学.无效小数) == "无效小数")

    // 5. 科学计数法：仅显式调用
    检查("数学.科学计数法(1234567.89, 6)", 数学.科学计数法(1234567.89, 6) == "1.23457e+6")
    检查("数学.科学计数法(0.000012345, 3)", 数学.科学计数法(0.000012345, 3) == "1.23e-5")
    检查("科学计数法默认 6 位生效", 数学.科学计数法(1234567.89) == "1.23457e+6")

    收尾()
结束
