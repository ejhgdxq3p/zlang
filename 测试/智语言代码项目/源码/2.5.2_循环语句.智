测试_全部():
    整数 序甲 = 0
    文本 序列 = ""
    循环 序甲 < 5:
        序列 = 序列 + 转文本(序甲)
        序甲 += 1
    结束
    检查("基础递增-0到4", 序列 == "01234")

    整数 序乙 = 5
    整数 递减和 = 0
    循环 序乙 > 0:
        递减和 = 递减和 + 序乙
        序乙 -= 1
    结束
    检查("基础递减-5到1求和15", 递减和 == 15)

    整数 总和 = 0
    整数 当前 = 1
    循环 当前 <= 100:
        总和 += 当前
        当前 += 1
    结束
    检查("1到100累加=5050", 总和 == 5050)

    整数 区间次数 = 0
    循环 序丙 = 1, 序丙 <= 10, 序丙 += 1:
        区间次数 += 1
    结束
    检查("区间递增执行10次", 区间次数 == 10)

    整数 偶数和 = 0
    循环 序丁 = 2, 序丁 <= 20, 序丁 += 2:
        偶数和 += 序丁
    结束
    检查("区间偶数累加=110", 偶数和 == 110)

    文本 反向 = ""
    循环 序戊 = 3, 序戊 >= 1, 序戊 -= 1:
        反向 = 反向 + 转文本(序戊)
    结束
    检查("反向区间321", 反向 == "321")

    整数 步数 = 0
    循环 序己 = 1, 序己 <= 30, 序己 += 3:
        步数 += 1
    结束
    检查("步长3共11项(1..31>30)", 步数 == 10)

    水果 = ["苹果", "香蕉", "橙子", "葡萄"]
    文本 拼接 = ""
    循环 水果项 遍历 水果:
        拼接 = 拼接 + 水果项
    结束
    检查("遍历数组元素", 拼接 == "苹果香蕉橙子葡萄")

    文本 带序号 = ""
    循环 索引, 元素 遍历 水果:
        带序号 = 带序号 + 转文本(索引) + 元素
    结束
    检查("数组索引从1开始", 带序号 == "1苹果2香蕉3橙子4葡萄")

    分数数组 = [85, 58, 92, 66, 45, 78, 95]
    优秀数组 = []
    不及格数组 = []
    循环 分数 遍历 分数数组:
        如果 分数 >= 90:
            优秀数组.追加(分数)
        否则如果 分数 < 60:
            不及格数组.追加(分数)
        结束
    结束
    检查("筛选优秀2条", 优秀数组.长度() == 2)
    检查("筛选不及格2条", 不及格数组.长度() == 2)

    学生信息 = {"姓名": "小明", "年龄": 18, "班级": "高一(1)班", "成绩": 92}
    整数 项数 = 0
    文本 取值 = ""
    循环 键, 值 遍历 学生信息:
        项数 += 1
        如果 键 == "姓名":
            取值 = 值
        结束
    结束
    检查("遍历映射4项", 项数 == 4)
    检查("映射键值取值", 取值 == "小明")

    整数 键数 = 0
    循环 键2 遍历 学生信息.所有键():
        键数 += 1
    结束
    检查("所有键4个", 键数 == 4)

    整数 值数 = 0
    循环 值2 遍历 学生信息.所有值():
        值数 += 1
    结束
    检查("所有值4个", 值数 == 4)

    商品库存 = {"苹果": 100, "香蕉": 80, "橙子": 50}
    整数 补充数 = 0
    循环 键3, 值3 遍历 商品库存:
        如果 值3 < 60:
            商品库存.插入(键3, 值3 + 50)
            补充数 += 1
        结束
    结束
    检查("遍历中补充1条", 补充数 == 1)
    检查("补充后橙子=100", 商品库存.获取("橙子") == 100)

    整数 计数 = 0
    循环 真:
        计数 += 1
        如果 计数 == 5:
            跳出
        结束
    结束
    检查("无限循环跳出于5", 计数 == 5)

    数组<整数> 空数组 = []
    整数 空计 = 0
    循环 空项 遍历 空数组:
        空计 += 1
    结束
    检查("空数组遍历跳过", 空计 == 0)

    映射<文本, 整数> 空映射 = {}
    整数 空计2 = 0
    循环 空键, 空项值 遍历 空映射:
        空计2 += 1
    结束
    检查("空映射遍历跳过", 空计2 == 0)

    检查("取模4%2=0", 4 % 2 == 0)
    检查("取模5%2=1", 5 % 2 == 1)

    整数 序号和 = 0
    循环 序号 = 1, 序号 <= 100, 序号 += 1:
        编号 = "USER-" + 转文本(序号)
        如果 编号.是否包含("USER-"):
            序号和 += 1
        结束
    结束
    检查("批量编号100条均含前缀", 序号和 == 100)
结束

