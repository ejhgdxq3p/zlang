// 规范 §5.4 时间模块（共 16 个）：获取时间 4 / 时间分量 7 / 时间计算 3 / 计时 2
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 164 时间模块 ===")
    // ① 获取时间
    现在 = 时间.当前时间()
    检查("当前时间-为正整数", 现在 > 0)
    检查("当前时间-量级合理(>2020年)", 现在 > 1577836800)
    毫秒 = 时间.当前毫秒时间()
    检查("当前毫秒时间-大于秒级*1000", 毫秒 > 现在 * 100)
    // ② 格式化 / 解析（用固定时间戳 946684800 = 2000-01-01 00:00:00 UTC）
    固定 = 946684800
    格式化秒 = 时间.格式化("秒", 固定)
    检查("格式化-返回非空", 格式化秒.长度() > 0)
    格式化年月日 = 时间.格式化("年-月-日", 固定)
    检查("格式化-含分隔符", 格式化年月日.查找("-") > 0)
    解析回 = 时间.解析(格式化年月日, "年-月-日")
    检查("解析-往返为整数时间戳", 解析回 > 0)
    检查("解析-往返取年一致", 时间.获取年(解析回) == 时间.获取年(固定))
    // ③ 时间分量
    检查("获取年-范围", 时间.获取年(固定) >= 1970)
    检查("获取月-1到12", 时间.获取月(固定) >= 1 且 时间.获取月(固定) <= 12)
    检查("获取日-1到31", 时间.获取日(固定) >= 1 且 时间.获取日(固定) <= 31)
    检查("获取时-0到23", 时间.获取时(固定) >= 0 且 时间.获取时(固定) <= 23)
    检查("获取分-0到59", 时间.获取分(固定) >= 0 且 时间.获取分(固定) <= 59)
    检查("获取秒-0到59", 时间.获取秒(固定) >= 0 且 时间.获取秒(固定) <= 59)
    检查("获取星期-1到7", 时间.获取星期(固定) >= 1 且 时间.获取星期(固定) <= 7)
    // ④ 时间计算
    检查("加-加3600秒", 时间.加(固定, 3600) == 固定 + 3600)
    检查("减-减3600秒", 时间.减(固定, 3600) == 固定 - 3600)
    检查("间隔天数-同一天为0", 时间.间隔天数(固定, 固定) == 0)
    // ⑤ 计时
    开始 = 时间.获取计时器()
    检查("获取计时器-返回整数", 开始 >= 0)
    结束时间 = 时间.获取计时器()
    检查("获取计时器-单调不减", 结束时间 >= 开始)
    时间.休眠(10)
    检查("休眠-可调用", 时间.获取计时器() >= 开始)
    收尾()
结束
