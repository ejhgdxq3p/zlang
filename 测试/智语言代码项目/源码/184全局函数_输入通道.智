// 第 8 个全局函数 输入()：**EOF 安全** —— 喂入管道时精确校验读到的内容；
// 无标准输入（如语料批量扫描）时，读尽即空串，此时只校验类型与稳定性 ⇒ 两种环境下都应为绿。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 184 输入() 通道 ===")
    第一行 = 输入()
    检查("输入-返回文本类型", 类型(第一行) == "文本")
    如果 第一行 == "甲乙丙":
        // 管道喂入路径：精确校验
        检查("输入-第1行精确匹配", 真)
        第二行 = 输入()
        检查("输入-第2行精确匹配", 第二行 == "12345")
        检查("输入-可转整数", 转整数(第二行) == 12345)
        第三行 = 输入()
        检查("输入-第3行(空行)", 第三行 == "")
        结束行 = 输入()
        记录("输入-读尽后返回", 结束行)
        检查("输入-读尽返回空串", 结束行 == "")
    否则:
        // 无 stdin 路径（语料扫描）：退化为可判定性质
        记录("输入-无标准输入时返回", 第一行)
        检查("输入-无 stdin 时返回空串", 第一行 == "")
        检查("输入-连续调用稳定", 输入() == 第一行)
    结束
    收尾()
结束
