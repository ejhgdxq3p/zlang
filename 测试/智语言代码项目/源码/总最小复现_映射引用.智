// 最小复现 v3：函数内诊断 + 区分模式

改映射引用(传引用 映射<文本, 整数> 数据):
    输出("[函数内] 插入前 数据长度:" + 转文本(数据.长度()))
    数据.插入("x", 999)
    输出("[function内] 插入后 数据长度:" + 转文本(数据.长度()))
    输出("[function内] 插入后 数据含x:" + 转文本(数据.包含("x")))
结束

启动程序():
    映射 表 = {"a": 1}
    输出("[全局] 调用前 表长度:" + 转文本(表.长度()))
    改映射引用(表)
    输出("[全局] 调用后 表长度:" + 转文本(表.长度()))
    输出("[全局] 调用后 表含x:" + 转文本(表.包含("x")))
    输出("[全局] 调用后 表含a:" + 转文本(表.包含("a")))
结束
