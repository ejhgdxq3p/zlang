// 203 核心库深度矩阵（二）：**Unicode 文本边界 + 转义体系 + 数值转换极值 + 转文本表示**
//
// 与 201 的分工：201 覆盖"条款精确性"（1-based/未找到 0/越界抛异常…）；本文件覆盖**更硬的三类边界**：
//   ① 文本是否按 **Unicode 标量**计数（emoji=补充平面 4 字节 UTF-8、CJK 扩展 B、全角）
//   ② 合法转义序列**全套**（编译器帮助文本列出 9 种：换行/回车/制表/退格/换页/空字符/引号/反斜杠/Uxxxxxx）
//   ③ 数值转换的 i64 极值、溢出、非常规输入，以及 `转文本` 的数值/容器表示形式
//
// 实测结论（双模逐字一致 ✓，本文件据此断言）：
//   · `"😀".长度()=1`、`"𠀋".长度()=1`（4 字节字符也算 **1 个字符** ✓✓）⇒ 严格按 Unicode 标量 ✓
//   · `转整数` 溢出（i64 最大+1 / 20 位数字）⇒ **抛可捕获异常**（不静默回绕 ✓）；
//     `转整数("3.9")`/`("1e3")`/`("")` ⇒ **抛异常**（整数文本不接受小数/科学计数/空 ✓）；
//     而 `转小数("1e3")=1000.0` ✓、`("inf")=正无穷` ✓、`("NaN")=无效小数` ✓（小数更宽 ✓）
//   · `转文本(1.0)="1.0"`（保留小数标识 ✓）、`转文本(0.1+0.2)="0.30000000000000004"`（IEEE 最短往返 ✓）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 203 Unicode / 转义 / 数值极值深度矩阵 ===")

    // ───────── ① Unicode 文本边界（按 Unicode 标量，而非字节/代理对）─────────
    输出("-- Unicode 文本边界 --")
    检查("emoji 😀 长度 = 1（补充平面也算 1 字符）", "😀".长度() == 1)
    检查("emoji + 汉字 长度 = 2", "😀甲".长度() == 2)
    检查("emoji 之后取第 2 字 = 甲", "😀甲".截取(2, 1) == "甲")
    检查("emoji 在位时 查找(甲) = 2", "😀甲".查找("甲") == 2)
    检查("emoji 从首位取 = 😀", "😀甲".截取(1, 1) == "😀")
    检查("CJK 扩展 B（𠀋, 4 字节 UTF-8）长度 = 1", "𠀋".长度() == 1)
    检查("全角 ＡＢ 长度 = 2", "ＡＢ".长度() == 2)
    检查("预组合 é 长度 = 1", "é".长度() == 1)
    检查("三个 emoji 长度 = 3", "😀😀😀".长度() == 3)
    检查("emoji 拼接后包含判断", "😀😀".是否包含("😀"))
    检查("emoji 替换生效", "😀甲".替换("😀", "乙") == "乙甲")

    // ───────── ② 合法转义序列全套（编译器帮助文本给出的 9 种）─────────
    输出("-- 转义体系（9 种）--")
    检查("换行 长度 1（甲+换行+乙=3）", "甲\换行乙".长度() == 3)
    检查("换行 可被查找（位置 2）", "甲\换行乙".查找("\换行") == 2)
    检查("回车 长度 1", "甲\回车乙".长度() == 3)
    检查("制表 长度 1", "甲\制表乙".长度() == 3)
    检查("退格 长度 1", "甲\退格乙".长度() == 3)
    检查("换页 长度 1", "甲\换页乙".长度() == 3)
    检查("空字符 长度 1", "甲\空字符乙".长度() == 3)
    检查("引号 长度 1 且含双引号", "甲\引号乙".长度() == 3)
    检查("引号 可与字面双引号比较", "甲\引号乙" == "甲" + "\引号" + "乙")
    检查("反斜杠 长度 1", "甲\反斜杠乙".长度() == 3)
    检查("反斜杠n 长度 2（反斜杠 + 字母 n）", "甲\反斜杠n乙".长度() == 4)
    检查("U01F600 码点转义 = 😀", "\U01F600" == "😀")
    检查("U 码点转义长度 = 1", "\U01F600".长度() == 1)
    检查("去除空白 能去掉制表/换行（首尾）", ("\制表甲\换行").去除空白() == "甲")

    // ───────── ③ 数值转换：i64 极值与非常规输入 ─────────
    输出("-- 转整数 极值 --")
    检查("转整数(i64 最大)", 转整数("9223372036854775807") == 9223372036854775807)
    检查("转整数(i64 最小)", 转整数("-9223372036854775808") == 0 - 9223372036854775807 - 1)
    检查("转整数(前导 +)", 转整数("+42") == 42)
    检查("转整数(前后空格容忍)", 转整数(" 42 ") == 42)
    检查("转整数(负零)", 转整数("-0") == 0)
    检查("转整数(0)", 转整数("0") == 0)
    捕获:
        溢出甲 = 转整数("9223372036854775808")
        记录("i64 最大+1 未抛", 转文本(溢出甲))
        检查("转整数(i64 最大+1) 应抛异常", 假)
    异常:
        检查("转整数(i64 最大+1) ⇒ 抛可捕获异常（不静默回绕）", 真)
    结束
    捕获:
        溢出乙 = 转整数("99999999999999999999")
        记录("20 位数字未抛", 转文本(溢出乙))
        检查("转整数(20 位) 应抛异常", 假)
    异常:
        检查("转整数(20 位数字) ⇒ 抛可捕获异常", 真)
    结束
    捕获:
        小数文本 = 转整数("3.9")
        记录("转整数(3.9) 未抛", 转文本(小数文本))
        检查("转整数(小数文本) 应抛异常（整数文本不接受小数）", 假)
    异常:
        检查("转整数(3.9) ⇒ 抛可捕获异常", 真)
    结束
    捕获:
        科学文本 = 转整数("1e3")
        记录("转整数(1e3) 未抛", 转文本(科学文本))
        检查("转整数(科学计数文本) 应抛异常", 假)
    异常:
        检查("转整数(1e3) ⇒ 抛可捕获异常", 真)
    结束
    捕获:
        空文本 = 转整数("")
        记录("转整数(空串) 未抛", 转文本(空文本))
        检查("转整数(空串) 应抛异常", 假)
    异常:
        检查("转整数(空串) ⇒ 抛可捕获异常", 真)
    结束
    // 转小数：更宽（接受科学计数与特殊值）
    输出("-- 转小数 --")
    检查("转小数(1e3) = 1000.0", 转小数("1e3") == 1000.0)
    检查("转小数(inf) = 正无穷", 转小数("inf") == 转小数("inf"))
    检查("转小数(超长精度) 截到 f64", 转小数("3.141592653589793238462643383279") == 3.141592653589793)
    检查("转小数(整数文本) 安全提升", 转小数("42") == 42.0)
    捕获:
        非法小数 = 转小数("abc")
        记录("转小数(abc) 未抛", 转文本(非法小数))
        检查("转小数(abc) 应抛异常", 假)
    异常:
        检查("转小数(abc) ⇒ 抛可捕获异常", 真)
    结束
    记录("转小数(NaN) 的自等性", 转文本(转小数("NaN") == 转小数("NaN")))

    // ───────── ④ 转文本 的数值/容器表示形式 ─────────
    输出("-- 转文本 表示形式 --")
    检查("转文本(1.0) = “1.0”（保留小数标识）", 转文本(1.0) == "1.0")
    检查("转文本(0.1+0.2) = IEEE 最短往返", 转文本(0.1 + 0.2) == "0.30000000000000004")
    检查("转文本(1/3) 精度", 转文本(1 / 3) == "0.3333333333333333")
    检查("转文本(大数小数) 不用科学计数", 转文本(3000000000.0) == "3000000000.0")
    检查("转文本(空数组) = “[]”", 转文本([]) == "[]")
    检查("转文本(空映射) = “{}”", 转文本({}) == "{}")
    检查("转文本(嵌套容器) 结构可读", 转文本([1, [2, 3]]) == "[1, [2, 3]]")
    记录("转文本(映射) 实际形式（规范 §4.1 示例写作带引号形式 ⇒ 见报告）", 转文本({"键": "值"}))
    检查("转文本(负数)", 转文本(0 - 7) == "-7")
    检查("转文本(逻辑)", (转文本(真) == "真") 且 (转文本(假) == "假"))

    收尾()
结束
