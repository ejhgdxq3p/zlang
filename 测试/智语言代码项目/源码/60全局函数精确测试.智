// 60 全局函数精确测试（规范 4.1 全局函数逐项精确断言）
// 说明：实现当前可调用全局函数为 输出/错误输出/整数/小数/文本/类型/异常错误 共 7 个；
//       “输入” 已在类型推断中声明，但未注册为可调用内建（已知缺口），故本测试不调用它。

总数 = 0
通过数 = 0

// 供 类型() 自定义类型测试 使用
结构体 样本点(整数 横, 整数 纵):
    整数 横坐标
    整数 纵坐标
    初始化():
        自身.横坐标 = 横
        自身.纵坐标 = 纵
    结束
结束

接口 可绘制:
    名称() 文本:
    结束
结束

结构体 方块 适配 可绘制:
    整数 边长
    名称() 文本:
        返回 "方块"
    结束
结束

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
    否则:
        输出("❌ " + 名称)
    结束
结束

启动程序():
    // ===== 输出 / 错误输出 =====
    输出("全局函数-输出测试")
    错误输出("全局函数-错误输出测试")
    检查("输出/错误输出 不崩溃", 真)

    // ===== 整数 =====
    检查("转整数(123)=123", 转整数("123") == 123)
    检查("转整数( -7 )=-7", 转整数(" -7") == -7)
    检查("转整数(转文本(456))=456", 转整数(转文本(456)) == 456)
    检查("类型(转整数())=整数", 类型(转整数("1")) == "整数")
    // 整数 接受 小数（向零取整）/ 整数（恒等）
    检查("转整数(小数3.7)=3 向零取整", 转整数(3.7) == 3)
    检查("转整数(小数-3.7)=-3 向零取整", 转整数(-3.7) == -3)
    检查("转整数(整数)=恒等", 转整数(99) == 99)
    整数异常 = 假
    捕获:
        转整数("abc")
    异常:
        整数异常 = 真
    结束
    检查("转整数(非法文本) 抛异常", 整数异常 == 真)

    // ===== 小数 =====
    检查("转小数(3.14)≈3.14", 转小数("3.14") > 转小数(3.13) 且 转小数("3.14") < 转小数(3.15))
    检查("转小数(2)≈2.0", 转小数("2") > 转小数(1.9) 且 转小数("2") < 转小数(2.1))
    检查("转小数(1.5e2)≈150", 转小数("1.5e2") > 转小数(149) 且 转小数("1.5e2") < 转小数(151))
    检查("类型(转小数())=小数", 类型(转小数("1.0")) == "小数")
    // 小数 接受 整数（安全提升）/ 小数（恒等）
    检查("转小数(整数42)=42.0", 转小数(42) == 转小数("42.0"))
    检查("转小数(小数3.14)=恒等", 转小数(3.14) == 转小数("3.14"))
    小数异常 = 假
    捕获:
        转小数("xyz")
    异常:
        小数异常 = 真
    结束
    检查("转小数(非法文本) 抛异常", 小数异常 == 真)

    // ===== 文本 =====
    检查("转文本(123)=123", 转文本(123) == "123")
    检查("转文本(3.14)=3.14", 转文本(3.14) == "3.14")
    检查("转文本(真)=真", 转文本(真) == "真")
    检查("转文本(假)=假", 转文本(假) == "假")
    检查("转文本(数组)=[1,2]", 转文本([1, 2]) == "[1,2]" 或 转文本([1, 2]).是否包含("1"))

    // 空值不能参与类型转换：转文本(空值) 在编译期直接报“空值不能参与类型转换”（正确空值安全行为）
    // 注意：此为编译期拦截，无法用 捕获 块捕获，故此处仅作注释记录，不写成断言。
    // 验证空值安全：转文本(真) 与 转文本(假) 已分别验证；空值需先赋值再判断类型。
    检查("类型(空值)=空值", 类型(空值) == "空值")
    检查("转文本(映射) 含键", 转文本({"x": 1}).是否包含("x"))
    检查("转文本() 嵌套转换", 转文本(转整数(转文本(789))) == "789")

    // ===== 输出 单参数（§4.1 签名：输出(文本 内容)） =====
    // 2026-10-19：全局函数形参补登记，多参数调用改为编译期报错；多值拼接用显式 转文本。
    输出("多值:" + 转文本(1) + "二" + 转文本(真))
    检查("输出 单参数 + 显式拼接可用", 真)

    // ===== 小数 精度 =====
    检查("小数 负数", 转小数("-2.5") < 转小数("0"))
    检查("小数 多小数位", 转文本(转小数("3.14159")).长度() >= 6)
    检查("小数 科学计数", 转小数("1e3") == 转小数("1000"))

    // ===== 类型 =====
    检查("类型(整数)=整数", 类型(123) == "整数")
    检查("类型(小数)=小数", 类型(3.14) == "小数")
    检查("类型(文本)=文本", 类型("abc") == "文本")
    检查("类型(逻辑)=逻辑", 类型(真) == "逻辑")
    检查("类型(数组)=数组", 类型([1, 2]) == "数组")
    检查("类型(映射)=映射", 类型({"a": 1}) == "映射")
    检查("类型(空值)=空值", 类型(空值) == "空值")

    // ===== 异常错误（必须在 异常: 块内调用）=====
    捕获:
        抛出 异常错误("测试错误内容")
    异常:
        错误 = 异常错误()
        检查("异常错误.类型=异常错误", 错误.类型 == "异常错误")
        检查("异常错误.类型 非通道(历史缺陷)", 错误.类型 != "通道")
        检查("异常错误.描述=测试错误内容", 错误.描述 == "测试错误内容")
        检查("异常错误.格式信息() 非空", 错误.格式信息().长度() > 0)
        检查("异常错误.格式信息() 含描述", 错误.格式信息().是否包含("测试错误内容"))

    // ===== 类型 边界 =====
    检查("类型(0)=整数", 类型(0) == "整数")
    检查("类型(0.0)=小数", 类型(0.0) == "小数")
    检查("类型(空数组)=数组", 类型([]) == "数组")
    检查("类型(空映射)=映射", 类型({}) == "映射")

    // ===== 类型 对 自定义类型（结构体/接口/任意）=====
    样本 = 样本点(3, 4)
    检查("类型(结构体实例)=样本点", 类型(样本) == "样本点")
    形状 = 方块(5)
    检查("类型(接口实例)=方块", 类型(形状) == "方块")
    任意 变体 = 123
    检查("类型(任意=整数)=整数", 类型(变体) == "整数")
    变体 = "文本值"
    检查("类型(任意=文本)=文本", 类型(变体) == "文本")

    // ===== 整数 边界 =====
    检查("转整数(0)=0", 转整数("0") == 0)
    检查("转整数(大数) 精确", 转整数("9999999999") == 9999999999)
    结束

    输出("")
    输出("===== 60 全局函数精确测试 结果 =====")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
