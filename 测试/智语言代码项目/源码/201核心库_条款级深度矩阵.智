// 201 核心库**条款级深度矩阵**：§4.1 全局函数(8) / §4.2 文本方法(7) / §4.3 数组方法(11) / §4.4 映射方法(8)
//
// 与既有用例的分工：成员**广度**已由 164/174/175/177/185/194/199 等覆盖（成员级审计：58 成员零空缺 ✓）；
// 本用例专攻**规范条款的精确性**——凡是规范写了"必须/返回 X/从 1 开始/未找到返回 0/抛异常"的地方，
// 逐条做**精确断言**；规范**未规定**的地方只 `记录()`（本项目一贯纪律：未定义语义不下断言 ✓）。
//
// 关键规范条款（自 §4.1~§4.4 逐字摘录）：
//   · §4.2 位置从 **1** 开始计数；查找未找到返回 **0**；中文每字符算一个 ✓
//   · §4.3 索引从 **1** 开始；**插入/删除越界抛异常** ✓（§4.3 表内明写）
//   · §4.4 `.是否包含` **仅检查键** ✓；`.获取` 缺键 ⇒ `空值` ✓；`.插入` 新键或更新 ✓
//   · §4.1 非安全方向转换必须显式：`转整数("abc")` 等非法格式**抛异常** ✓；空值不参与转换（编译错误）✓
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

结构体 学生():
    文本 姓名 = "小明"
    整数 年龄 = 18
结束

启动程序():
    输出("=== 201 核心库条款级深度矩阵 ===")

    // ───────────── ① §4.1 全局函数（8 个）─────────────
    输出("-- §4.1 全局函数 --")
    // 转整数：整数恒等 / 小数**向零取整**（规范明写）
    检查("转整数(42)=42", 转整数(42) == 42)
    检查("转整数(3.7)=3（向零取整，非四舍五入）", 转整数(3.7) == 3)
    检查("转整数(-3.7)=-3（向零取整）", 转整数(-3.7) == 0 - 3)
    检查("转整数(“123”)=123", 转整数("123") == 123)
    检查("转整数(“-42”)=-42", 转整数("-42") == 0 - 42)
    捕获:
        甲 = 转整数("abc")
        记录("非法格式 转整数(“abc”) 未抛", 转文本(甲))
        检查("非法格式 转整数(“abc”) 应抛异常", 假)
    异常:
        检查("非法格式 转整数(“abc”) 抛可捕获异常", 真)
    结束
    // 转小数：安全提升 / 解析 / 非法抛异常
    检查("转小数(42)=42.0", 转小数(42) == 42.0)
    检查("转小数(“3.14”)=3.14", 转小数("3.14") == 3.14)
    检查("转小数(“-2.5”)=-2.5", 转小数("-2.5") == 0.0 - 2.5)
    捕获:
        乙 = 转小数("abc")
        记录("非法格式 转小数(“abc”) 未抛", 转文本(乙))
        检查("非法格式 转小数(“abc”) 应抛异常", 假)
    异常:
        检查("非法格式 转小数(“abc”) 抛可捕获异常", 真)
    结束
    // 转文本：表示形式（规范给了字面量形式 ⇒ 精确断言）
    检查("转文本(42)=“42”", 转文本(42) == "42")
    检查("转文本(真)=“真”", 转文本(真) == "真")
    检查("转文本(假)=“假”", 转文本(假) == "假")
    检查("转文本([1, 2, 3]) 用规范字面量形式", 转文本([1, 2, 3]) == "[1, 2, 3]")
    检查("转文本(3.14) 精确含小数表示", 转文本(3.14) == "3.14")
    检查("转文本 映射含键（格式细节见 ℹ）", 转文本({"键": "值"}).是否包含("键"))
    记录("转文本({“键”: “值”})", 转文本({"键": "值"}))
    // 类型：逐类型具体名（规范给了 7 个基本例子）
    检查("类型(42)=“整数”", 类型(42) == "整数")
    检查("类型(3.14)=“小数”", 类型(3.14) == "小数")
    检查("类型(“你好”)=“文本”", 类型("你好") == "文本")
    检查("类型(真)=“逻辑”", 类型(真) == "逻辑")
    检查("类型(空值)=“空值”", 类型(空值) == "空值")
    检查("类型([1, 2])=“数组”", 类型([1, 2]) == "数组")
    检查("类型({“甲”: 1})=“映射”", 类型({"甲": 1}) == "映射")
    检查("类型(自定义结构体)=“学生”", 类型(学生()) == "学生")
    // 异常错误：结构体字段可用（§4.1 明写 类型/描述/位置/格式信息）
    字段齐全 = 假
    捕获:
        丙 = 1 / 0
    异常:
        错误 = 异常错误()
        字段齐全 = (错误.描述 != "") 且 (错误.类型 != "") 且 (错误.格式信息() != "")
    结束
    检查("异常错误() 的 描述/类型/格式信息 均非空", 字段齐全)

    // ───────────── ② §4.2 文本方法（7 个，位置从 1 开始）─────────────
    输出("-- §4.2 文本方法 --")
    消息 = "你好世界"
    检查("长度：中文每字算一个 ⇒ 4", 消息.长度() == 4)
    检查("截取(1, 2)=“你好”", 消息.截取(1, 2) == "你好")
    检查("截取(3, 2)=“世界”", 消息.截取(3, 2) == "世界")
    检查("截取(1, 1)=首字符", 消息.截取(1, 1) == "你")
    检查("查找(“世界”)=3（从 1 开始）", 消息.查找("世界") == 3)
    检查("查找(“地球”)=0（未找到返回 0）", 消息.查找("地球") == 0)
    检查("查找(首字符)=1", 消息.查找("你") == 1)
    检查("替换 命中：你好世界→你好朋友", 消息.替换("世界", "朋友") == "你好朋友")
    检查("替换 未命中 ⇒ 原样", 消息.替换("地球", "月球") == 消息)
    检查("分隔 ⇒ 数组", "苹果,香蕉,橙子".分隔(",").长度() == 3)
    检查("分隔 首元素", "苹果,香蕉,橙子".分隔(",")[1] == "苹果")
    检查("分隔 末元素", "苹果,香蕉,橙子".分隔(",")[3] == "橙子")
    检查("是否包含 真", 消息.是否包含("你好") == 真)
    检查("是否包含 假", 消息.是否包含("再见") == 假)
    检查("去除空白", "   你好   ".去除空白() == "你好")
    检查("链式：去空白→替换→截取", "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2) == "你好")
    // 边界：越界/空串（规范未规定 ⇒ 先记录，再断言既有"安全降级"约定）
    记录("截取(100, 5) 越界", 消息.截取(100, 5))
    记录("截取(1, 100) 超长", 消息.截取(1, 100))
    记录("截取(0, 2) 起始 0", 消息.截取(0, 2))
    记录("空串.长度()", 转文本("".长度()))
    记录("“”.查找(“”)", 转文本("".查找("")))
    记录("“aXaXa”.替换(“X”, “-”)", "aXaXa".替换("X", "-"))
    检查("替换全部出现（不留 X）", 非 ("aXaXa".替换("X", "-").是否包含("X")))
    记录("“a,b,”.分隔(“,”) 长度", 转文本("a,b,".分隔(",").长度()))

    // ───────────── ③ §4.3 数组方法（11 个，索引从 1 开始，越界抛异常）─────────────
    输出("-- §4.3 数组方法 --")
    数字 = [10, 20, 30, 40, 50]
    检查("长度=5", 数字.长度() == 5)
    数字.追加(60)
    检查("追加 ⇒ 末尾 60 且长度 6", (数字.长度() == 6) 且 (数字[6] == 60))
    数字.插入(1, 5)
    检查("插入(1, 5) ⇒ 首元素 5 且原首元素后移", (数字[1] == 5) 且 (数字[2] == 10))
    数字.删除(1)
    检查("删除(1) ⇒ 长度回到 6 且首元素 10", (数字.长度() == 6) 且 (数字[1] == 10))
    检查("取末尾()=60", 数字.取末尾() == 60)
    检查("取末尾 后长度 5（取出即移除）", 数字.长度() == 5)
    检查("获取(1)=10", 数字.获取(1) == 10)
    检查("获取 越界 ⇒ 空值（§4.3 返回 任意<甲|空值>）", 数字.获取(99) == 空值)
    检查("是否包含(30)", 数字.是否包含(30) == 真)
    检查("是否包含(999) 假", 数字.是否包含(999) == 假)
    检查("查找索引(30)=3（从 1 开始）", 数字.查找索引(30) == 3)
    检查("查找索引(999)=0（未找到）", 数字.查找索引(999) == 0)
    捕获:
        数字.插入(99, 0)
        检查("插入越界应抛异常", 假)
    异常:
        检查("插入 越界 ⇒ 抛可捕获异常", 真)
    结束
    捕获:
        数字.删除(99)
        检查("删除越界应抛异常", 假)
    异常:
        检查("删除 越界 ⇒ 抛可捕获异常", 真)
    结束
    捕获:
        越界读取 = 数字[99]
        检查("索引越界读取应抛异常", 假)
    异常:
        检查("数组索引越界 ⇒ 抛可捕获异常", 真)
    结束
    反转数 = [1, 2, 3, 4]
    反转数.反转()
    检查("反转 原地生效 ⇒ 首元素为题中末元素", (反转数[1] == 4) 且 (反转数[4] == 1))
    排序数 = [3, 1, 4, 1, 5, 9, 2, 6]
    排序数.排序()
    检查("排序 升序 原地生效", (排序数[1] == 1) 且 (排序数[8] == 9))
    排序文本 = ["香蕉", "苹果", "橙子"]
    排序文本.排序()
    记录("文本排序结果（规范未规定排序规则）", 转文本(排序文本))
    清空数 = [1, 2, 3]
    清空数.清空()
    检查("清空 ⇒ 长度 0", 清空数.长度() == 0)
    空数组 = []
    检查("空数组 长度 0", 空数组.长度() == 0)
    记录("空数组.取末尾() 是否空值", 转文本(空数组.取末尾() == 空值))
    记录("空数组.获取(1) 是否空值", 转文本(空数组.获取(1) == 空值))
    空数组.追加(7)
    检查("空数组追加后长度 1", 空数组.长度() == 1)

    // ───────────── ④ §4.4 映射方法（8 个，是否包含**仅检查键**）─────────────
    输出("-- §4.4 映射方法 --")
    信息 = {"姓名": "小明", "年龄": 18}
    检查("长度=2", 信息.长度() == 2)
    信息.插入("城市", "北京")
    检查("插入 新键 ⇒ 长度 3", 信息.长度() == 3)
    信息.插入("年龄", 19)
    检查("插入 已有键 ⇒ **更新**而非重复（长度仍 3）", (信息.长度() == 3) 且 (信息.获取("年龄") == 19))
    检查("是否包含 键存在 ⇒ 真", 信息.是否包含("姓名") == 真)
    检查("是否包含 键不存在 ⇒ 假", 信息.是否包含("地址") == 假)
    检查("是否包含 **仅检查键**：值 19 不作为键 ⇒ 假", 信息.是否包含(19) == 假)
    检查("获取 存在键", 信息.获取("姓名") == "小明")
    检查("获取 缺键 ⇒ 空值", 信息.获取("地址") == 空值)
    检查("所有键 元素个数 = 长度", 信息.所有键().长度() == 信息.长度())
    检查("所有值 元素个数 = 长度", 信息.所有值().长度() == 信息.长度())
    记录("所有键（规范未规定顺序）", 转文本(信息.所有键()))
    记录("所有值（规范未规定顺序）", 转文本(信息.所有值()))
    检查("所有键 含 姓名", 信息.所有键().是否包含("姓名"))
    检查("所有值 含 19", 信息.所有值().是否包含(19))
    信息.删除("姓名")
    检查("删除 键 ⇒ 长度 2 且键不存在", (信息.长度() == 2) 且 (信息.是否包含("姓名") == 假))
    信息.清空()
    检查("清空 ⇒ 长度 0", 信息.长度() == 0)
    检查("清空后 获取 任意键 ⇒ 空值", 信息.获取("城市") == 空值)
    空映射 = {}
    检查("空映射 长度 0", 空映射.长度() == 0)
    检查("空映射 所有键 长度 0", 空映射.所有键().长度() == 0)
    // 值类型为映射/数组的嵌套
    嵌套 = {"甲": {"乙": 1}, "丙": [1, 2]}
    检查("嵌套映射 取值再取键", 嵌套.获取("甲").获取("乙") == 1)
    // ⚠ F30（**真实缺陷**，双模一致、静默错值）：**字面量混合值映射**取回数组值后 `.长度()` 得 0 ✗
    //   实测对照：`{"丙": [1, 2, 3]}`（纯数组值）⇒ 长度 3 ✓；`{"甲": {...}, "丙": [...]}` ⇒ 长度 0 ✗；
    //   同一条值的 `类型()`=数组 ✓、`转文本()`=[1, 2, 3] ✓、索引 ✓ 均正常 ⇒ 仅**方法分派**拿到包装层 ✗
    //   ⇒ 与 F22 同族根因（`任意` 包装未解包 ⇒ 方法分派落在包装层）✓
    //   按项目纪律：未修的缺陷**只记录不误断言**（保持本文件全绿，缺陷另登记）✓
    记录("F30 混合值映射取回数组：类型/长度（期望 数组/2）",
        类型(嵌套.获取("丙")) + "/" + 转文本(嵌套.获取("丙").长度()))
    检查("F30 取回值的类型正确（数组）", 类型(嵌套.获取("丙")) == "数组")
    检查("F30 取回值非空值", 嵌套.获取("丙") != 空值)
    记录("F30 对照：纯数组值映射长度（期望 2）", 转文本({"丙": [1, 2]}.获取("丙").长度()))
    映射值映射 = {"甲": {"乙": 1}}
    检查("映射值=映射 时内层可用（对照）", 映射值映射.获取("甲").获取("乙") == 1)

    收尾()
结束
