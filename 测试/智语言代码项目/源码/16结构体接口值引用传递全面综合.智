// ============================================================
// 结构体 / 接口 / 值传递 / 引用传递 全面综合验证
// 对照《智语言编程规范》2.3.7「所有类型变量赋值是值复制」
//    + 接口引用语义（句柄共享同一实例，逻辑版本138 闭环）
//
// 本文件作为「全面回归固化」单一入口，覆盖：
//   【结构体】变量赋值深度独立 / 含数组字段嵌套独立 / 含映射字段嵌套独立
//   【值传递】函数传值参数独立（不改原实例）
//   【引用传递】传引用参数共享（改原实例）+ 引用参数改嵌套字段/数组
//   【数组】数组赋值值复制 / 嵌套数组独立 / 数组元素接收者方法写回槽位
//   【接口】引用语义（复制标签共享实例）/ 作函数参数（带状态改原实例）/ 作函数返回值
//           / 数组元素接收者写回 / 接口变量=数组元素 / 多接口方法选择
//   【映射】映射承载结构体（值复制独立）/ 映射承载接口（引用共享）
//   【COW】结构体变量赋值深拷贝、接口标签复制零数据复制、数组变量赋值槽位值复制
// 全部双模（解释/编译）验证。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ───────────── 基础结构体（含数组/映射字段）─────────────
结构体 盒子(整数 编号):
    整数 编号 = 编号
    标签 = "空"
    列表 = [0, 0, 0]
    表 = {"k": 0}
    改标签(文本 新标签):
        自身.标签 = 新标签
    结束
    改列表(整数 位置, 整数 值):
        自身.列表[位置] = 值
    结束
    改表(文本 键, 整数 值):
        自身.表.插入(键, 值)
    结束
    读表(文本 键) 整数:
        返回 自身.表.获取(键)
    结束
结束

// 传值参数
修改盒子(盒子 目标, 整数 新编号):
    目标.编号 = 新编号
    目标.改标签("已改")
    目标.改列表(1, 999)
    临时 = 目标.表                       // 拆链写回映射字段
    临时.插入("k", 555)
    目标.表 = 临时
结束

// 传引用参数
修改盒子引用(传引用 盒子 目标, 整数 新编号):
    目标.编号 = 新编号
    目标.改标签("引用改")
    目标.改列表(2, 777)
    临时 = 目标.表
    临时.插入("k", 888)
    目标.表 = 临时
结束

// ───────────── 接口 ─────────────
接口 可移动:
    移动(速度):
    结束
    当前速度() 小数:
    结束
结束

接口 可打印:
    描述() 文本:
    结束
结束

结构体 汽车(文本 品牌) 适配 可移动, 可打印:
    小数 速度 = 0.0
    移动(小数 新速度):
        自身.速度 = 新速度
    结束
    当前速度() 小数:
        返回 自身.速度
    结束
    描述() 文本:
        返回 品牌 + " 速度=" + 转文本(转整数(自身.速度))
    结束
结束

结构体 机器人(文本 代号) 适配 可移动, 可打印:
    小数 速度 = 0.0
    位置 = "静止"
    移动(小数 新速度):
        自身.速度 = 新速度
        自身.位置 = "移动中"
    结束
    当前速度() 小数:
        返回 自身.速度
    结束
    描述() 文本:
        返回 代号 + " 位置=" + 自身.位置
    结束
结束

// 接口作函数参数（带状态，验证引用语义作用于原实例）
驱动(可移动 设备, 小数 速度) 小数:
    设备.移动(速度)
    返回 设备.当前速度()
结束

// 接口作函数返回值
制造(文本 品牌) 可移动:
    返回 汽车(品牌)
结束

// 多接口方法选择
打印(可打印 设备) 文本:
    返回 设备.描述()
结束

// 接口数组参数（批量只读）
批量速度(数组<可移动> 列表) 小数:
    合计 = 0.0
    循环 设备 遍历 列表:
        合计 += 设备.当前速度()
    结束
    返回 合计
结束

// ───────────── 测试 ─────────────
测试_结构体值复制() 整数:
    // 值复制：整数/标签/数组字段（非映射）深拷贝隔离已正确；映射字段用拆链验证隔离。
    甲 = 盒子(1)
    甲.改标签("甲")
    甲.改列表(1, 11)
    甲表 = 甲.表                       // 拆链式字段写回，专测深拷贝隔离
    甲表.插入("k", 111)
    甲.表 = 甲表
    乙 = 甲                           // 值复制
    乙.编号 = 2
    乙.改标签("乙")
    乙.改列表(1, 22)
    乙表 = 乙.表
    乙表.插入("k", 222)
    乙.表 = 乙表
    检查("结构体值复制-甲.编号 独立", 甲.编号 == 1)
    检查("结构体值复制-甲.标签 独立", 甲.标签 == "甲")
    检查("结构体值复制-甲.列表[1] 嵌套独立", 甲.列表[1] == 11)
    检查("结构体值复制-甲.表[k] 嵌套独立", 甲.读表("k") == 111)
    检查("结构体值复制-乙.编号 已改", 乙.编号 == 2)
    检查("结构体值复制-乙.标签 已改", 乙.标签 == "乙")
    检查("结构体值复制-乙.列表[1] 已改", 乙.列表[1] == 22)
    检查("结构体值复制-乙.表[k] 已改", 乙.读表("k") == 222)
    返回 0
结束

