// §5.6 边界：正则多匹配/无命中、哈希长度与一致性、编码往返与非法方案、数据格式往返、唯一编号
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 177 工具模块-边界 ===")
    // 正则匹配：多匹配 / 无命中 / 字符类
    检查("正则-多匹配个数", 工具.正则匹配("[0-9]+", "1a22b333").长度() == 3)
    检查("正则-无命中为空数组", 工具.正则匹配("[0-9]+", "abc").长度() == 0)
    检查("正则-单字符类", 工具.正则匹配("[A-Z]", "aBcD").长度() == 2)
    记录("正则匹配(中文模式)", 转文本(工具.正则匹配("[你好世界]", "abc")))
    // 正则替换：多匹配 / 无命中
    检查("正则替换-多匹配全替换", 工具.正则替换("[0-9]", "*", "1a2b3") == "*a*b*")
    检查("正则替换-无命中保持原样", 工具.正则替换("[0-9]", "*", "abc") == "abc")
    // 哈希：长度、同输入同结果、不同输入不同结果
    哈希甲 = 工具.哈希算法("MD5", "abc")
    检查("哈希-MD5长度32", 哈希甲.长度() == 32)
    检查("哈希-MD5确定性", 工具.哈希算法("MD5", "abc") == 哈希甲)
    检查("哈希-MD5区分输入", 工具.哈希算法("MD5", "abd") != 哈希甲)
    检查("哈希-SHA256长度64", 工具.哈希算法("SHA256", "abc").长度() == 64)
    捕获:
        结果甲 = 工具.哈希算法("不存在算法", "abc")
        记录("哈希-非法算法未抛", 转文本(结果甲.长度()))
    异常:
        检查("哈希-非法算法抛异常", 真)
    结束
    // 编码/解码：往返 + 空串 + 非法方案
    检查("编码-空串", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "")) == "")
    检查("解码-ASCII往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "hello")) == "hello")
    检查("编码-中文往返", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "智语言")) == "智语言")
    捕获:
        不支持方案结果 = 工具.编码方案("HEX", "hi")
        记录("编码方案(HEX) 未抛", 不支持方案结果)
    异常:
        检查("编码-非法方案(HEX)抛异常", 真)
    结束
    捕获:
        结果乙 = 工具.编码方案("不存在方案", "x")
        记录("编码-非法方案未抛", 结果乙)
    异常:
        检查("编码-非法方案抛异常", 真)
    结束
    // 数据格式：映射往返 + 数组往返 + 空映射
    检甲 = 工具.解析数据("JSON", 工具.生成数据("JSON", {"甲": 1, "乙": "文"}))
    检查("数据-映射往返键数", 检甲.长度() == 2)
    检查("数据-映射往返取值", 检甲.获取("甲") == 1)
    生成数组文本 = 工具.生成数据("JSON", [1, 2, 3])
    检查("数据-数组生成非空", 生成数组文本.长度() > 0)
    解析数组 = 工具.解析数据("JSON", 生成数组文本)
    记录("解析数组后长度", 转文本(解析数组.长度()))
    捕获:
        非法 = 工具.解析数据("JSON", "不是一个JSON")
        记录("解析-非法数据未抛", 转文本(非法.长度()))
    异常:
        检查("解析-非法数据抛异常", 真)
    结束
    // 唯一编号
    编号甲乙 = 工具.唯一编号()
    检查("唯一编号-非空", 编号甲乙.长度() > 0)
    检查("唯一编号-连续两次不同", 工具.唯一编号() != 编号甲乙)
    记录("唯一编号 长度", 转文本(编号甲乙.长度()))
    收尾()
结束
