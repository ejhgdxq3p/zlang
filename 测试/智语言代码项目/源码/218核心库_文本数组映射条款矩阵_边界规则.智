    检查("所有值 含 3", 映.所有值().是否包含(3))
    键序一致 = 映.所有键()[1] == "甲" 且 映.所有值()[1] == 1
    检查("所有键/所有值 顺序一一对应", 键序一致)

    输出("-- ⑰ §4.4 插入（新增 / 更新）--")
    映.插入("丁", 4)
    检查("插入新键 ⇒ 长度 4", 映.长度() == 4)
    映.插入("甲", 9)
    检查("插入已有键 ⇒ 长度不变（更新）", 映.长度() == 4)
    检查("更新后取值 9", 映.获取("甲") == 9)

    输出("-- ⑱ §4.4 删除 / 是否包含（仅键）--")
    映.删除("丁")
    检查("删除已存在键 ⇒ 长度 3", 映.长度() == 3)
    检查("删除后 是否包含 丁 ⇒ 假", 映.是否包含("丁") == 假)
    删除不存在结果 = 真
    捕获:
        映.删除("没有这个键")
        删除不存在结果 = 真
    异常:
        删除不存在结果 = 假
    结束
    检查("删除不存在的键 不抛异常", 删除不存在结果)
    检查("删除不存在键后长度不变", 映.长度() == 3)
    检查("是否包含 只看键：键存在 ⇒ 真", 映.是否包含("乙") == 真)
    检查("是否包含 只看键：值存在但键不存在 ⇒ 假", 映.是否包含(2) == 假)
    空值映 = {"键": 空值}
    检查("值为空值 仍算包含该键", 空值映.是否包含("键") == 真)

    输出("-- ⑲ §4.4 获取（键不存在返回空值）--")
    检查("获取 已存在键", 映.获取("乙") == 2)
    检查("获取 不存在键 ⇒ 空值", 映.获取("不存在") == 空值)
    检查("值为空值 获取 ⇒ 空值", 空值映.获取("键") == 空值)

    输出("-- ⑳ §4.4 清空 --")
    映.清空()
    检查("清空后长度 0", 映.长度() == 0)
    检查("清空后 所有键 长度 0", 映.所有键().长度() == 0)
    检查("清空后 所有值 长度 0", 映.所有值().长度() == 0)
    检查("清空后 获取 ⇒ 空值", 映.获取("甲") == 空值)

    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
