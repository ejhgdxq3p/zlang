    单排表 = [5]
    单排表.排序()
    检查("单元素排序无操作", 单排表 == [5])

    输出("-- ⑮ §4.3 清空 --")
    清表 = [1, 2, 3]
    清表.清空()
    检查("清空后长度 0", 清表.长度() == 0)
    检查("清空后可继续追加", 真)
