启动程序():
    输出("=== 218 §4.2 文本 / §4.3 数组 / §4.4 映射 边界矩阵 ===")

    // ══════════ §4.2 文本（7 方法）══════════
    输出("-- ① §4.2 长度：按 Unicode 字符计数 --")
    检查("中文 4 字 = 4", "你好世界".长度() == 4)
    检查("空文本 = 0", "".长度() == 0)
    检查("emoji 算 1 个字符", "😀".长度() == 1)
    检查("中文+emoji 混合 = 3", "甲😀乙".长度() == 3)
    检查("ASCII = 字节数一致", "abc".长度() == 3)

    输出("-- ② §4.2 截取：起始 1、长度 0、越界、超长 --")
    检查("起始 1 取 2", "你好世界".截取(1, 2) == "你好")
    检查("起始 3 取 2", "你好世界".截取(3, 2) == "世界")
    检查("长度 0 ⇒ 空串", "你好世界".截取(2, 0) == "")
    检查("起始越界 ⇒ 空串", "你好世界".截取(99, 2) == "")
    检查("长度超长 ⇒ 取到结尾", "你好世界".截取(3, 99) == "世界")
    检查("emoji 截取按字符", "甲😀乙".截取(2, 1) == "😀")
    记录("截取(0, 2) 实际（规范未定义起始 0）", "你好世界".截取(0, 2))

    输出("-- ③ §4.2 查找：首个位置、未找到 0、空子串 1 --")
    检查("查找 世界 ⇒ 3", "你好世界".查找("世界") == 3)
    检查("未找到 ⇒ 0", "你好世界".查找("地球") == 0)
    检查("空子串 ⇒ 1（边界规则 2）", "你好世界".查找("") == 1)
    检查("重复出现取首个", "甲乙甲乙".查找("乙") == 2)
    检查("emoji 位置按字符", "甲😀乙".查找("乙") == 3)

    输出("-- ④ §4.2 替换：全部出现、不存在原样、空旧串插空 --")
    检查("替换全部出现", "aaa".替换("a", "b") == "bbb")
    检查("替换 世界 ⇒ 朋友", "你好世界".替换("世界", "朋友") == "你好朋友")
    检查("旧串不存在 ⇒ 原样", "你好".替换("再见", "x") == "你好")
    检查("空旧串 ⇒ 每个字符位置插入（边界规则 3）", "甲乙丙".替换("", "-") == "-甲-乙-丙-")
    检查("替换为空串 ⇒ 删除", "甲乙丙".替换("乙", "") == "甲丙")

    输出("-- ⑤ §4.2 分隔：保留空元素 --")
    检查("常规分隔", "a,b,c".分隔(",") == ["a", "b", "c"])
    检查("尾随空元素保留（边界规则 4）", "a,b,".分隔(",") == ["a", "b", ""])
    检查("连续空元素保留", "a,,b".分隔(",") == ["a", "", "b"])
    检查("空文本分隔 ⇒ 长度 1 的 [空串]", "".分隔(",").长度() == 1)
    检查("空文本分隔 ⇒ 元素为空串", "".分隔(",")[1] == "")
    检查("无分隔符 ⇒ 单元素", "abc".分隔(",") == ["abc"])
    检查("多字符分隔符", "甲::乙".分隔("::") == ["甲", "乙"])

    输出("-- ⑥ §4.2 是否包含：空子串恒真 --")
    检查("包含子串", "你好世界".是否包含("世界") == 真)
    检查("不包含 ⇒ 假", "你好世界".是否包含("地球") == 假)
    检查("空子串恒真（边界规则 2）", "".是否包含("") == 真)
    检查("非空包含于空 ⇒ 假", "".是否包含("甲") == 假)

    输出("-- ⑦ §4.2 去除空白：首尾制表/换行、中间保留 --")
    检查("首尾空格", "  甲乙  ".去除空白() == "甲乙")
    检查("含制表与换行", " \制表甲乙\换行 ".去除空白() == "甲乙")
    检查("中间空白保留", "甲 乙".去除空白() == "甲 乙")
    检查("纯空白 ⇒ 空串", "   ".去除空白() == "")

    输出("-- ⑧ §4.2 链式调用 --")
    检查("去除空白→替换→截取", "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2) == "你好")
    检查("分隔→长度", "甲,乙,丙".分隔(",").长度() == 3)
    检查("替换→长度（emoji 计字符）", "甲😀".替换("甲", "😀").长度() == 2)

    // ══════════ §4.3 数组（11 方法）══════════
    输出("-- ⑨ §4.3 长度 / 追加 / 插入 --")
    表 = [10, 20, 30]
    检查("长度 3", 表.长度() == 3)
    表.追加(40)
    检查("追加后长度 4", 表.长度() == 4)
    检查("追加到末尾", 表[4] == 40)
    表.插入(1, 5)
    检查("插入索引 1 ⇒ 首元素 5", 表[1] == 5)
    检查("插入后长度 5", 表.长度() == 5)
    表.插入(6, 99)
    检查("插入到末尾之后（索引=长度+1）合法", 表.长度() == 6 且 表[6] == 99)

    输出("-- ⑩ §4.3 插入/删除 越界抛异常；获取 越界空值 --")
    越界表 = [1, 2, 3]
    插入越界 = ""
    捕获:
        越界表.插入(99, 9)
    异常:
        插入越界 = 异常错误().类型
    结束
    检查("插入越界抛数组越界", 插入越界 == "数组越界")
    删除越界 = ""
    捕获:
        越界表.删除(99)
    异常:
        删除越界 = 异常错误().类型
    结束
    检查("删除越界抛数组越界", 删除越界 == "数组越界")
    检查("获取 越界 ⇒ 空值", 越界表.获取(99) == 空值)
    检查("获取 合法 ⇒ 值", 越界表.获取(1) == 1)
    下标越界 = 假
    捕获:
        值越 = 越界表[99]
    异常:
        下标越界 = 异常错误().类型 == "数组越界"
    结束
    检查("数组[99] 抛数组越界", 下标越界)

    输出("-- ⑪ §4.3 删除 / 取末尾（弹出语义）--")
    删表 = [1, 2, 3]
    删表.删除(2)
    检查("删除索引 2 ⇒ [1, 3]", 删表 == [1, 3])
    弹表 = [7, 8, 9]
    弹出 = 弹表.取末尾()
    检查("取末尾 返回 9", 弹出 == 9)
    检查("取末尾 移除末尾（长度 2）", 弹表.长度() == 2 且 弹表 == [7, 8])
    空弹表 = []
    空弹值 = 空弹表.取末尾()
    检查("空数组取末尾 ⇒ 空值", 空弹值 == 空值)
    检查("空数组取末尾后长度仍 0", 空弹表.长度() == 0)

    输出("-- ⑫ §4.3 是否包含 / 查找索引 --")
    查表 = ["甲", "乙", "甲"]
    检查("是否包含 甲 ⇒ 真", 查表.是否包含("甲") == 真)
    检查("是否包含 丙 ⇒ 假", 查表.是否包含("丙") == 假)
    检查("查找索引 取首个 ⇒ 1", 查表.查找索引("甲") == 1)
    检查("查找索引 乙 ⇒ 2", 查表.查找索引("乙") == 2)
    检查("查找索引 未找到 ⇒ 0", 查表.查找索引("丙") == 0)
    数值表 = [1, 2, 1.0]
    检查("数值比较：1.0 与 1 相等（查找索引）", 数值表.查找索引(1.0) == 1)

    输出("-- ⑬ §4.3 反转 --")
    反表 = [1, 2, 3]
    反表.反转()
    检查("反转 ⇒ [3, 2, 1]", 反表 == [3, 2, 1])
    空反表 = []
    空反表.反转()
    检查("空数组反转无副作用", 空反表.长度() == 0)
    单反表 = [9]
    单反表.反转()
    检查("单元素反转不变", 单反表 == [9])

    输出("-- ⑭ §4.3 排序：可比较性三条 --")
    乱表 = [3, 1, 2]
    乱表.排序()
    检查("整数升序", 乱表 == [1, 2, 3])
    负表 = [0, -3, 5, -1]
    负表.排序()
    检查("含负数升序", 负表 == [0 - 3, 0 - 1, 0, 5])
    混表 = [3, 1.5, 2, 0.5]
    混表.排序()
    检查("整数小数混合按数值", 混表 == [0.5, 1.5, 2, 3])
    逻辑表 = [真, 假, 真]
    逻辑表.排序()
    检查("逻辑 假 < 真", 逻辑表 == [假, 真, 真])
    文本表 = ["乙", "甲", "丙"]
    文本表.排序()
    检查("文本按码点序（丙 < 乙 < 甲）", 文本表 == ["丙", "乙", "甲"])
    跨类异常 = ""
    跨类表 = [1, "甲"]
    捕获:
        跨类表.排序()
    异常:
        跨类异常 = 异常错误().类型
    结束
