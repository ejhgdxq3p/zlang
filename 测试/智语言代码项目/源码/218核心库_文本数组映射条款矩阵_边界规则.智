    // ══════════ §4.4 映射（8 方法）══════════
    输出("-- ⑯ §4.4 长度 / 所有键 / 所有值 --")
    映 = {"甲": 1, "乙": 2, "丙": 3}
    检查("长度 3", 映.长度() == 3)
    检查("所有键 长度 3", 映.所有键().长度() == 3)
    检查("所有值 长度 3", 映.所有值().长度() == 3)
