// ============================================================
// 数组 / 映射 组合与边界专项测试（对比《智语言编程规范》§4.3 / §4.4）
// 聚焦此前测试尚未专项覆盖的点：
//   A. 结构体字段为数组/映射
//   B. 数组/映射 作为函数返回值后在外部继续操作（值复制隔离深度验证）
//   C. 文本数组排序（排序仅测过整数/小数）
//   D. 空数组/空映射 的遍历/反转/排序 边界
//   E. 映射.是否包含 仅检查键（传值不检查 value）
//   F. 数组方法链式组合（追加→排序→反转→取末尾）
// 双模验证：解释模式 + 编译模式
// ============================================================

总数 = 0
通过数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        输出("  ❌ " + 描述)
    结束
结束

// ---- 结构体含数组/映射字段 ----
结构体 班级(数组<文本> 学生列表, 映射<文本, 整数> 分数表):
    映射<文本, 整数> 分数表 = 分数表
    数组<文本> 学生列表 = 学生列表
    添加学生(文本 姓名):
        自身.学生列表.追加(姓名)
    结束

    学生数() 整数:
        返回 自身.学生列表.长度()
    结束
结束

// ---- 返回数组/映射的函数 ----
生成分数表() 映射<文本, 整数>:
    返回 {"甲": 10, "乙": 20, "丙": 30}
结束

生成数列() 数组<整数>:
    返回 [3, 1, 2]
结束

启动程序():
    输出("===== A. 结构体字段为数组/映射 =====")
    班 = 班级(["张三", "李四"], {"张三": 90})
    检查("构造初始化数组字段长度=2", 班.学生列表.长度() == 2)
    检查("构造初始化映射字段长度=1", 班.分数表.长度() == 1)
    班.添加学生("王五")
    检查("方法内追加数组字段后长度=3", 班.学生列表.长度() == 3)
    检查("方法内追加后末位=王五", 班.学生列表[3] == "王五")
    检查("学生数=3", 班.学生数() == 3)

    // ⚠ 已知限制（双模一致）：结构体字段为映射类型时，方法内 .插入() 不落回字段
    // （写时复制未写回映射字段，详见 内存/架构限制清单）。本段仅记录行为，不计入通过数。
    输出("  ⚠ 已知限制：结构体映射字段方法内 .插入() 当前不落回（数组字段正常）")
    输出("     构造映射字段长度观察=" + 转文本(班.分数表.长度()) + "（期望=1，因插入未落回）")

    // 结构体字段赋值值复制隔离（数组字段）
    班副本 = 班
    班副本.学生列表.追加("赵六")
    检查("副本修改数组字段不影响原（原仍=3）", 班.学生列表.长度() == 3)
    检查("副本独立数组字段=4", 班副本.学生列表.长度() == 4)

    输出("===== B. 数组/映射 作为返回值的外部操作 =====")
    外部表 = 生成分数表()
    检查("函数返回映射长度=3", 外部表.长度() == 3)
    外部表.插入("丁", 40)
    检查("返回值外部插入后长度=4", 外部表.长度() == 4)
    检查("返回值外部插入[丁]=40", 外部表["丁"] == 40)

    外部数列 = 生成数列()
    检查("函数返回数组长度=3", 外部数列.长度() == 3)
    外部数列.追加(4)
    检查("返回值外部追加后长度=4", 外部数列.长度() == 4)
    检查("返回值外部追加[4]=4", 外部数列[4] == 4)
    外部数列.排序()
    检查("返回值外部排序后[1]=1", 外部数列[1] == 1)
    检查("返回值外部排序后[4]=4", 外部数列[4] == 4)

    输出("===== C. 文本数组排序（按 UTF-8 字节序升序） =====")
    文本序 = ["香蕉", "苹果", "橙子"]
    文本序.排序()
    // 香=E9A699 苹=E88BB9 橙=E6A99F（UTF-8）→ 升序 橙 < 苹 < 香
    // 原序 [香蕉,苹果,橙子] 首字节序 [E9,E8,E6] 为降序，升序排序后应为 [橙子,苹果,香蕉]
    检查("文本排序后[1]=橙子", 文本序[1] == "橙子")
    检查("文本排序后[2]=苹果", 文本序[2] == "苹果")
    检查("文本排序后[3]=香蕉", 文本序[3] == "香蕉")
    // 乱序验证：按字节升序应得 [橙子,苹果,香蕉]
    乱序 = ["香", "橙", "苹"]
    乱序.排序()
    检查("乱序文本排序后[1]=橙", 乱序[1] == "橙")
    检查("乱序文本排序后[2]=苹", 乱序[2] == "苹")
    检查("乱序文本排序后[3]=香", 乱序[3] == "香")

    输出("===== D. 空容器 边界 =====")
    空数组 = []
    检查("空数组长度=0", 空数组.长度() == 0)
    空数组.反转()
    检查("空数组反转后长度仍=0", 空数组.长度() == 0)
    空数组.排序()
    检查("空数组排序后长度仍=0", 空数组.长度() == 0)
    空映射 = {}
    检查("空映射长度=0", 空映射.长度() == 0)
    空映射.清空()
    检查("空映射清空后长度仍=0", 空映射.长度() == 0)
    // 空容器遍历（不应抛异常，循环体 0 次）
    空遍历计数 = 0
    循环 项 遍历 空数组:
        空遍历计数 = 空遍历计数 + 1
    结束
    检查("空数组遍历 0 次", 空遍历计数 == 0)
    空映射计数 = 0
    循环 键, 值 遍历 空映射:
        空映射计数 = 空映射计数 + 1
    结束
    检查("空映射遍历 0 次", 空映射计数 == 0)

    输出("===== E. 映射.是否包含 仅检查键 =====")
    检查表 = {"a": 1, "b": 2}
    检查("是否包含(键 a)=真", 检查表.是否包含("a"))
    检查("是否包含(值 1)=假（仅查键）", 检查表.是否包含(1) == 假)
    检查("是否包含(不存在键)=假", 检查表.是否包含("z") == 假)

    输出("===== F. 数组方法链式组合 =====")
    组合 = []
    组合.追加(3).追加(1).追加(2).追加(5).追加(4)
    组合.排序()
    检查("链式追加+排序后[1]=1", 组合[1] == 1)
    检查("链式追加+排序后[5]=5", 组合[5] == 5)
    组合.反转()
    检查("排序后再反转[1]=5", 组合[1] == 5)
    检查("排序后再反转[5]=1", 组合[5] == 1)
    末 = 组合.取末尾()
    检查("组合取末尾=1", 末 == 1)
    检查("取末尾后长度=4", 组合.长度() == 4)

    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.总数 - 本模块.通过数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
