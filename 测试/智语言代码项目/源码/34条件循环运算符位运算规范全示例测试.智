// ======== 条件语句：规范 2.5.1 示例逐条 ========

// 单条件：条件不成立时不执行
单条件不成立() 整数:
    执行 = 0
    分数 = 55
    如果 分数 >= 60:
        执行 = 1
    结束
    返回 执行    // 期望 0（不执行）
结束

// 双条件：余额购买
双条件购买() 文本:
    余额 = 500
    商品价格 = 300
    如果 余额 >= 商品价格:
        余额 -= 商品价格
        返回 "购买成功，剩余余额：" + 转文本(余额)
    否则:
        返回 "余额不足"
    结束
    返回 "异常"
结束

// 多条件：成绩等级
评定成绩(整数 分数) 文本:
    如果 分数 >= 90:
        返回 "A"
    否则如果 分数 >= 80:
        返回 "B"
    否则如果 分数 >= 70:
        返回 "C"
    否则如果 分数 >= 60:
        返回 "D"
    否则:
        返回 "F"
    结束
    返回 "X"
结束

// 嵌套条件：分数+出勤率
嵌套分数出勤(整数 分数, 整数 出勤率) 文本:
    如果 分数 >= 60:
        如果 出勤率 >= 80:
            返回 "合格_出勤良好"
        否则:
            返回 "合格_出勤不足"
        结束
    否则:
        返回 "不合格"
    结束
    返回 "X"
结束

// 复合条件：会员折扣嵌套（规范复杂条件判断）
会员折扣(逻辑 有卡, 逻辑 周末, 整数 金额) 文本:
    折扣 = 0.9
    如果 有卡:
        如果 周末:
            折扣 = 0.8
        否则:
            如果 金额 > 100:
                折扣 = 0.85
            否则:
                折扣 = 0.9
            结束
        结束
        实际支付 = 金额 * 折扣
        // 浮点比较用区间
        如果 实际支付 > (金额 * 折扣 - 0.01) 且 实际支付 < (金额 * 折扣 + 0.01):
            返回 "会员支付"
        结束
        返回 "会员支付"
    否则:
        返回 "非会员"
    结束
    返回 "X"
结束

// 复合逻辑：且/或/非 + 括号组合
复合逻辑() 整数:
    计数 = 0
    年龄 = 20
    有会员卡 = 真
    是否学生 = 假
    如果 年龄 >= 18 且 有会员卡: 计数 = 计数 + 1 结束
    如果 是否学生 或 年龄 >= 60: 计数 = 计数 + 1 结束
    如果 非 是否学生: 计数 = 计数 + 1 结束
    如果 (年龄 >= 18 且 有会员卡) 或 是否学生: 计数 = 计数 + 1 结束
    // 4
    返回 计数
结束

// 权限判断嵌套（规范复合逻辑实际应用）
权限判断(逻辑 管理员, 逻辑 登录, 逻辑 冻结, 整数 年龄) 文本:
    如果 登录 且 非 冻结:
        如果 管理员 或 年龄 >= 18:
            如果 管理员:
                返回 "管理员"
            否则:
                返回 "普通登录"
            结束
        否则:
            返回 "需监护"
        结束
    否则:
        返回 "请登录"
    结束
    返回 "X"
结束

// ======== 循环语句：规范 2.5.2 示例逐条 ========

// 基础递增
基础递增() 整数:
    总和 = 0
    序号 = 0
    循环 序号 < 5:
        总和 = 总和 + 序号
        序号 += 1
    结束
    // 0+1+2+3+4 = 10
    返回 总和
结束

// 基础递减
基础递减() 文本:
    输出串 = ""
    序号 = 5
    循环 序号 > 0:
        输出串 = 输出串 + 转文本(序号) + ","
        序号 -= 1
    结束
    // 5,4,3,2,1,
    返回 输出串
结束

// 累加 1..100
累加百() 整数:
    总和 = 0
    当前 = 1
    循环 当前 <= 100:
        总和 += 当前
        当前 += 1
    结束
    // 5050
    返回 总和
结束

// 区间循环
区间循环() 文本:
    串 = ""
    循环 序号 = 1, 序号 <= 10, 序号 += 1:
        串 = 串 + 转文本(序号) + ","
    结束
    循环 序二 = 2, 序二 <= 20, 序二 += 2:
        串 = 串 + 转文本(序二) + ","
    结束
    // 1..10, 2,4..20
    返回 串
结束

// 反向区间
反向区间() 文本:
    串 = ""
    循环 序号 = 10, 序号 >= 1, 序号 -= 1:
        串 = 串 + 转文本(序号) + ","
    结束
    返回 串
结束

// 步长3
步长三() 整数:
    计数 = 0
    循环 序号 = 1, 序号 <= 30, 序号 += 3:
        计数 = 计数 + 1
    结束
    // 1,4,...,28 -> 10个
    返回 计数
结束

// 遍历数组元素
遍历元素() 文本:
    串 = ""
    水果数组 = ["苹果", "香蕉", "橙子", "葡萄"]
    循环 水果 遍历 水果数组:
        串 = 串 + 水果 + ","
    结束
    返回 串
结束

// 遍历数组索引+元素（索引从1开始）
遍历索引元素() 文本:
    串 = ""
    水果数组 = ["苹果", "香蕉", "橙子", "葡萄"]
    循环 索引, 元素 遍历 水果数组:
        串 = 串 + 转文本(索引) + ":" + 元素 + ","
    结束
    // 1:苹果,2:香蕉,3:橙子,4:葡萄
    返回 串
结束

// 映射遍历键值对
映射遍历() 文本:
    串 = ""
    学生信息 = {"姓名": "小明", "年龄": 18, "成绩": 92}
    循环 键, 值 遍历 学生信息:
        串 = 串 + 键 + "=" + 转文本(值) + ","
    结束
    返回 串
结束

// 遍历键
遍历键() 文本:
    串 = ""
    学生信息 = {"姓名": "小明", "年龄": 18, "成绩": 92}
    循环 键 遍历 学生信息.所有键():
        串 = 串 + 键 + ","
    结束
    返回 串
结束

// 遍历值
遍历值() 文本:
    串 = ""
    学生信息 = {"姓名": "小明", "年龄": 18, "成绩": 92}
    循环 值 遍历 学生信息.所有值():
        串 = 串 + 转文本(值) + ","
    结束
    返回 串
结束

// 筛选遍历（数组拆优秀/不及格）
筛选遍历() 文本:
    优秀 = ""
    不及格 = ""
    分数数组 = [85, 58, 92, 66, 45, 78, 95]
    循环 分数 遍历 分数数组:
        如果 分数 >= 90:
            优秀 = 优秀 + 转文本(分数) + ","
        否则如果 分数 < 60:
            不及格 = 不及格 + 转文本(分数) + ","
        结束
    结束
    // 优秀:92,95 不及格:58,45
    返回 优秀 + "|" + 不及格
结束

// 遍历映射修改值
遍历改值() 文本:
    商品库存 = {"苹果": 100, "香蕉": 80, "橙子": 50}
    循环 键, 值 遍历 商品库存:
        如果 值 < 60:
            商品库存.插入(键, 值 + 50)
        结束
    结束
    // 橙子 50+50=100
    返回 转文本(商品库存.获取("苹果")) + "," + 转文本(商品库存.获取("香蕉")) + "," + 转文本(商品库存.获取("橙子"))
结束

// ======== 跳转语句：规范 2.5.3 ========

// 跳出
跳出演示() 文本:
    串 = ""
    循环 序号 = 1, 序号 < 10, 序号 += 1:
        如果 序号 == 5:
            跳出
        结束
        串 = 串 + 转文本(序号) + ","
    结束
    返回 串    // 1,2,3,4
结束

// 继续
继续演示() 文本:
    串 = ""
    循环 序号 = 1, 序号 < 10, 序号 += 1:
        如果 序号 % 2 == 0:
            继续
        结束
        串 = 串 + 转文本(序号) + ","
    结束
    返回 串    // 1,3,5,7,9
结束

// 组合
组合跳出继续() 文本:
    串 = ""
    循环 序号 = 1, 序号 < 20, 序号 += 1:
        如果 序号 < 5:
            继续
        结束
        如果 序号 == 7:
            跳出
        结束
        串 = 串 + 转文本(序号) + ","
    结束
    返回 串    // 5,6
结束

// 无限循环跳出
无限跳出() 整数:
    计数 = 0
    安全计数 = 0
    循环 真:
        安全计数 = 安全计数 + 1
        如果 安全计数 >= 100:
            跳出
        结束
        计数 += 1
        如果 计数 == 5:
            跳出
        结束
    结束
    返回 计数    // 5
结束

// 返回语句
判断正负(整数 值) 文本:
    如果 值 > 0:
        返回 "正数"
    否则如果 值 < 0:
        返回 "负数"
    否则:
