// ======== 运算符：规范 2.6 全案例 ========

// 算术
算术全() 小数:
    甲 = 10
    乙 = 3
    和 = 甲 + 乙
    差 = 甲 - 乙
    积 = 甲 * 乙
    幂 = 甲 ^ 2      // 100
    返回 和 * 1000 + 差 * 100 + 积 + 幂 / 10   // 13*1000+7*100+30+10 = 13730+10=13740
结束

// 整除与取余
整除取余() 整数:
    返回 25 %% 10 * 100 + 25 % 10    // 2*100+5 = 205
结束

// 比较全套
比较全套() 整数:
    计数 = 0
    如果 10 > 5: 计数 += 1 结束
    如果 5 < 10: 计数 += 1 结束
    如果 5 == 5: 计数 += 1 结束
    如果 5 != 6: 计数 += 1 结束
    如果 10 >= 10: 计数 += 1 结束
    如果 10 <= 10: 计数 += 1 结束
    // 6
    返回 计数
结束

// 字符串比较
字符比较() 整数:
    计数 = 0
    如果 "abc" == "abc": 计数 += 1 结束
    如果 "abc" != "ABC": 计数 += 1 结束
    如果 "abc" != "abc": 计数 += 1 结束
    // 2
    返回 计数
结束

// 属于不属于
属于不属于() 整数:
    计数 = 0
    数组 = [1, 2, 3]
    如果 2 属于 数组: 计数 += 1 结束
    如果 9 不属于 数组: 计数 += 1 结束
    // 2
    返回 计数
结束

// ======== 位运算：边缘案例强化 ========

// 位运算基础（复刻规范属性）
位基础正确() 整数:
    甲 = 5
    乙 = 3
    位与值 = 甲 & 乙
    位或值 = 甲 | 乙
    位非值 = ~甲
    位异或值 = 甲 ~| 乙
    左移值 = 甲 << 1
    右移值 = 甲 >> 1
    返回 位与值 * 100000 + 位或值 * 10000 + 位非值 * 1000 + 位异或值 * 100 + 左移值 * 10 + 右移值
结束

// 负数位移边缘
负数位移() 整数:
    甲 = -8        // 补码 ...11111000
    左移 = 甲 << 1 // -16
    右移 = 甲 >> 1 // -4
    返回 左移 * 10 + 右移   // -160 + (-4) = -164
结束

// 大数位运算
大数位() 整数:
    甲 = 1024
    乙 = 255       // 0xFF
    左移 = 甲 << 4  // 16384
    位或结果 = 甲 | 乙    // 1024 | 255 = 1279
    位与值 = 甲 & 乙    // 0
    位异或值 = 甲 ~| 乙 // 1279
    返回 左移 * 10000 + 位或结果 * 100 + 位与值   // 163840000 + 127900 + 0 = 163967900
结束

// 取反边界（全1取反 = -1）
取反边界() 整数:
    甲 = 0
    非甲 = ~甲      // -1
    非负 = ~非甲    // 0
    返回 非甲 * 10 + 非负   // -10
结束

// 位复合赋值全套
位复合全套() 整数:
    甲 = 5
    甲 &= 3        // 1
    乙 = 5
    乙 |= 3        // 7
    丙 = 5
    丙 ~|= 3       // 6
    丁 = 5
    丁 <<= 2       // 20
    戊 = 5
    戊 >>= 2       // 1
    己 = 5
    己 ^= 2        // 5^2=25  （普通幂，验证幂与位移区分）
    返回 甲 * 100000 + 乙 * 10000 + 丙 * 1000 + 丁 * 100 + 戊 * 10 + 己   // 100000+70000+6000+2000+10+25=178035
结束

// 位运算真实应用：开关组合
开关组合() 整数:
    权限甲 = 1
    权限乙 = 2
    权限丙 = 4
    组合值 = 权限甲 | 权限乙 | 权限丙        // 7
    仅甲 = 组合值 & 权限甲          // 1
    仅乙 = 组合值 & 权限乙          // 2
    仅丙 = 组合值 & 权限丙          // 4
    清乙 = 组合值 & ~权限乙         // 7 & ~2 = 5
    返回 仅甲 * 1000 + 仅乙 * 100 + 仅丙 * 10 + 清乙   // 1000+200+40+5=1245
结束

