// §4.2 边界：位置从 1 起、未找到返 0、越界/非法参数的从容返回；链式调用
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 173 文本方法-边界 ===")
    文本甲 = "abc"
    检查("长度-空串", "".长度() == 0)
    检查("长度-单字符", "甲".长度() == 1)
    检查("长度-纯空格", "   ".长度() == 3)
    // 查找边界
    检查("查找-空子串", 文本甲.查找("") >= 0)
    检查("查找-首字符位置1", 文本甲.查找("a") == 1)
    检查("查找-末字符位置", 文本甲.查找("c") == 3)
    检查("查找-大小写敏感", 文本甲.查找("A") == 0)
    // 截取边界（越界从容返回，不抛异常）
    记录("截取(0,2) 实际", 文本甲.截取(0, 2))
    记录("截取(2,99) 实际", 文本甲.截取(2, 99))
    记录("截取(99,2) 实际", 文本甲.截取(99, 2))
    记录("截取(1,0) 实际", 文本甲.截取(1, 0))
    检查("截取-刚好取完", 文本甲.截取(1, 3) == "abc")
    // 分隔边界
    检查("分隔-分隔符不存在", "abc".分隔(",").长度() == 1)
    检查("分隔-结尾分隔符产生空元素", "a,".分隔(",").长度() == 2)
    检查("分隔-空文本", "".分隔(",").长度() >= 1)
    // 替换边界
    检查("替换-替换为空串", 文本甲.替换("b", "") == "ac")
    检查("替换-多次出现全替换", "aXaXa".替换("a", "b") == "bXbXb")
    检查("替换-替换为原样", 文本甲.替换("a", "a") == "abc")
    // 去除空白边界
    检查("去除空白-全空白", "   ".去除空白() == "")
    检查("去除空白-无空白", 文本甲.去除空白() == "abc")
    检查("去除空白-仅左侧", "  a".去除空白() == "a")
    // 链式（规范示例同形）
    链式结果 = "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2)
    检查("链式-规范示例", 链式结果 == "你好")
    检查("分隔后长度(链式)", "a,b,c".分隔(",").长度() == 3)
    收尾()
结束
