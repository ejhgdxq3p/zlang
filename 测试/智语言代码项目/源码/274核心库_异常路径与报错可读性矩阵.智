// 274 核心库：**异常路径与报错可读性**矩阵（2026-10-22）
//
// 为什么需要：217~220/271/273 都在测"正确输入下的正确结果"；而**"好不好用"的另一半是
//   "错了会怎样"** —— 该抛的必须抛（不能静默返回空值/0）、能捕获、且**文案要能定位原因**。
//   本项目历史缺陷里最危险的一族正是"静默失败"（F49 小数位运算返回空值、F43 容器显示歧义…）。
//
// 断言策略（避免把文案写死成脆弱断言）：
//   · 断言 **异常类型** + **文案必须包含的关键词**（如「越界」「无法将文本」「除零」）；
//   · 同时断言"不静默"：用 `被拒` 标志确认真的抛了，而不是返回了一个看着对的值；
//   · 对"设计上不抛"的形态（`.获取` 越界、`.取末尾` 空数组）单独断言返回 `空值` —— **对照项**，
//     证明"该抛的抛、该软着陆的软着陆"，不是一刀切。
//
// ⚠ 所有 `检查` 都在 `捕获` 之外读标志，避免"在异常块里断言"造成的假通过。
导入 时间
导入 工具
导入 数学

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

// ── 统一探针：跑一个会抛异常的表达式，返回 "类型 | 描述"；不抛则返回 "未抛" ──
启动程序():
    输出("=== 274 异常路径与报错可读性 ===")

    // ───────── ① 数组：越界（硬错误）vs 安全获取（软着陆）─────────
    输出("-- ① 数组越界 --")
    表 = [1, 2, 3]
    下标越界 = 假
    下标描述 = ""
    捕获:
        越界值 = 表[99]
        记录("表[99] 未抛，得到", 转文本(越界值))
    异常:
        下标越界 = 真
        下标描述 = 异常错误().描述
    结束
    检查("★ `表[99]` ⇒ 抛可捕获异常（不静默返回空值）", 下标越界)
    记录("[99] 的报错文案", 下标描述)
    // 实测文案 = 「数组索引超出范围」（不是"越界"）⇒ 断言用"超出范围"或"索引"，避免写死措辞
    检查("报错文案指明索引超出范围",
        下标描述.是否包含("超出范围") 或 下标描述.是否包含("索引"))
    检查("★ 抛异常后数组长度不变（无副作用）", 表.长度() == 3)

    检查("★ 对照：`.获取(99)` 越界 ⇒ 返回 空值（设计如此，不抛）", 表.获取(99) == 空值)
    检查("★ 对照：空数组 `.取末尾()` ⇒ 空值且长度仍 0",
        类型([].取末尾()) == "空值")

    插入越界 = 假
    捕获:
        表.插入(99, 0)
    异常:
        插入越界 = 真
    结束
    检查("★ `.插入(99, 0)` 越界 ⇒ 抛异常", 插入越界)
    检查("插入失败后长度仍 3", 表.长度() == 3)

    删除越界 = 假
    捕获:
        表.删除(99)
    异常:
        删除越界 = 真
    结束
    检查("★ `.删除(99)` 越界 ⇒ 抛异常", 删除越界)

    // ───────── ② 排序的可比较性（§4.3 规则 2）─────────
    输出("-- ② 排序类型约束 --")
    混合排序被拒 = 假
    混合描述 = ""
    捕获:
        混排 = [1, "甲"]
        混排.排序()
    异常:
        混合排序被拒 = 真
        混合描述 = 异常错误().描述
    结束
    检查("★ 整数与文本混排 ⇒ 排序抛异常（不静默乱序）", 混合排序被拒)
    记录("混排排序的报错文案", 混合描述)

    空值排序被拒 = 假
    捕获:
        含空 = [1, 空值]
        含空.排序()
    异常:
        空值排序被拒 = 真
    结束
    检查("★ 含空值 ⇒ 排序抛异常（§2.4.5 空值不参与比较）", 空值排序被拒)

    检查("★ 对照：空数组排序不抛（无操作）", 真)
    单元素 = [7]
    单元素.排序()
    检查("对照：单元素排序后仍 [7]", 单元素.获取(1) == 7)

    // ───────── ③ 类型转换（同族文案一致性）─────────
    输出("-- ③ 类型转换失败 --")
    转整数被拒 = 假
    转整数描述 = ""
    捕获:
        坏整数 = 转整数("abc")
        记录("转整数(abc) 未抛，得到", 转文本(坏整数))
    异常:
        转整数被拒 = 真
        转整数描述 = 异常错误().描述
    结束
    检查("★ `转整数(\引号abc\引号)` ⇒ 抛异常", 转整数被拒)
    记录("转整数失败文案", 转整数描述)
    检查("文案含「无法将文本」", 转整数描述.是否包含("无法将文本"))

    转小数被拒 = 假
    转小数描述 = ""
    捕获:
        坏小数 = 转小数("xyz")
        记录("转小数(xyz) 未抛，得到", 转文本(坏小数))
    异常:
        转小数被拒 = 真
        转小数描述 = 异常错误().描述
    结束
    检查("★ `转小数(\引号xyz\引号)` ⇒ 抛异常", 转小数被拒)
    检查("文案含「无法将文本」", 转小数描述.是否包含("无法将文本"))
    检查("★ 与 转整数 的文案族一致（都提「转换为」）",
        转小数描述.是否包含("转换为") 且 转整数描述.是否包含("转换为"))

    // ───────── ④ 除零（§2.6.9 统一抛）─────────
    输出("-- ④ 除零 --")
    整数除零 = 假
    捕获:
        商 = 1 / 0
        记录("1/0 未抛，得到", 转文本(商))
    异常:
        整数除零 = 真
    结束
    检查("★ 整数除零 ⇒ 抛异常", 整数除零)

    整除零 = 假
    捕获:
        商二 = 1 %% 0
        记录("1%%0 未抛，得到", 转文本(商二))
    异常:
        整除零 = 真
    结束
    检查("★ 整除除零 ⇒ 抛异常", 整除零)

    取余零 = 假
    捕获:
        余 = 1 % 0
        记录("1%0 未抛，得到", 转文本(余))
    异常:
        取余零 = 真
    结束
    检查("★ 取余除零 ⇒ 抛异常", 取余零)

    小数除零 = 假
    捕获:
        商三 = 1.0 / 0
        记录("1.0/0 未抛，得到", 转文本(商三))
    异常:
        小数除零 = 真
    结束
    检查("★ 小数除零 ⇒ 抛异常（不返回 IEEE 特殊值）", 小数除零)

    // ───────── ⑤ 位运算类型（F49 护栏）─────────
    输出("-- ⑤ 位运算类型 --")
    小数位与被拒 = 假
    小数位与描述 = ""
    捕获:
        位值 = 1.5 & 1
        记录("1.5&1 未抛，得到", 转文本(位值))
    异常:
        小数位与被拒 = 真
        小数位与描述 = 异常错误().描述
    结束
    检查("★ 小数 & ⇒ 抛异常（不静默空值）", 小数位与被拒)
    检查("文案含「仅支持整数」", 小数位与描述.是否包含("仅支持整数"))

    检查("★ 对照：移位量 64 不抛（模 64 语义）", (1 << 64) == 1)

    // ───────── ⑥ 时间模块 ─────────
    输出("-- ⑥ 时间异常路径 --")
    非法日期被拒 = 假
    非法日期描述 = ""
    捕获:
        戳 = 时间.解析("2026-13-01", "年-月-日")
        记录("非法月 未抛，得到", 转文本(戳))
    异常:
        非法日期被拒 = 真
        非法日期描述 = 异常错误().描述
    结束
    检查("★ 非法月份 13 ⇒ 抛异常（§5.4 定稿：严格日历日）", 非法日期被拒)
    记录("非法日期文案", 非法日期描述)

    负休眠被拒 = 假
    捕获:
        时间.休眠(0 - 1)
    异常:
        负休眠被拒 = 真
    结束
    检查("★ `时间.休眠(-1)` ⇒ 抛异常（不永久挂起，F31 护栏）", 负休眠被拒)

    // ───────── ⑦ 工具模块 ─────────
    输出("-- ⑦ 工具异常路径 --")
    哈希被拒 = 假
    哈希描述 = ""
    捕获:
        摘要 = 工具.哈希算法("SHA1", "abc")
        记录("哈希算法(SHA1) 未抛，得到", 摘要)
    异常:
        哈希被拒 = 真
        哈希描述 = 异常错误().描述
    结束
    检查("★ 不支持的哈希算法 ⇒ 抛异常（不返回错误说明当摘要）", 哈希被拒)
    记录("哈希算法文案", 哈希描述)

    数据被拒 = 假
    捕获:
        解析 = 工具.解析数据("JSON", "{")
        记录("非法 JSON 未抛，得到", 转文本(解析))
    异常:
        数据被拒 = 真
    结束
    检查("★ 非法 JSON ⇒ 抛异常", 数据被拒)

    格式被拒 = 假
    捕获:
        解析二 = 工具.解析数据("XML", "<a/>")
        记录("未知格式 XML 未抛，得到", 转文本(解析二))
    异常:
        格式被拒 = 真
    结束
    检查("★ 未知数据格式 ⇒ 抛异常（不静默空值）", 格式被拒)

    // ───────── ⑧ 数学模块 ─────────
    输出("-- ⑧ 数学异常路径 --")
    // 注：`数学.取整("甲")` 属**编译期**参数类型约束（语义层直接报「参数类型不满足约束范围」），
    //   无法用 捕获 断言 ⇒ 由负向用例守护，此处只测**运行期**才可能出错的情形。
    开方被拒 = 假
    捕获:
        根 = 数学.平方根(0 - 1)
        记录("平方根(-1) 未抛，得到", 转文本(根))
    异常:
        开方被拒 = 真
    结束
    记录("平方根(-1) 是否抛异常", 转文本(开方被拒))

    // ───────── ⑨ 文本方法边界（不抛，软着陆）─────────
    输出("-- ⑨ 文本边界（设计为软着陆）--")
    检查("★ `\引号abc\引号.截取(10, 1)` ⇒ 返回空串（不抛）", "abc".截取(10, 1) == "")
    检查("★ `\引号abc\引号.查找(不存在)` ⇒ 返回 0（不抛，不是 -1）", "abc".查找("z") == 0)
    检查("★ `\引号\引号.去除空白()` ⇒ 空串", "".去除空白() == "")
    检查("★ `\引号\引号.分隔(\引号,\引号)` ⇒ 长度 1（不是 0）", "".分隔(",").长度() == 1)

    收尾()
结束
