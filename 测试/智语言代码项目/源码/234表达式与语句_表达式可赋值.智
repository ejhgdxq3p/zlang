// 覆盖《智语言编程规范》§2.3.6「表达式与语句」：
//   L2042-2045 属于表达式的语言结构（字面值 / 变量引用 / 函数与方法调用 / 运算）—— 全部可用于赋值
//   L2033 核心规则：类型系统产生值（表达式），流程控制控制流程（语句）；语句不能赋值（负向见 235）
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

加法(整数 甲, 整数 乙) 整数:
    返回 甲 + 乙
结束

启动程序():
    输出("=== 234 表达式与语句：表达式可赋值（§2.3.6）===")

    年龄 = 18
    甲 = 3
    乙 = 4
    条件 = 真
    数字数组 = [1, 2, 3]
    学生信息 = {"姓名": "小明"}

    // 字面值
    整数结果 = 42
    检查("整数字面值可赋值", 整数结果 == 42)
    文本结果 = "你好"
    检查("文本字面值可赋值", 文本结果 == "你好")
    逻辑结果 = 真
    检查("逻辑字面值可赋值", 逻辑结果 == 真)
    数组结果 = [1, 2, 3]
    检查("数组字面值可赋值", 数组结果.长度() == 3)
    映射结果 = {"键": "值"}
    检查("映射字面值可赋值", 映射结果.获取("键") == "值")

    // 变量引用
    引用结果 = 年龄
    检查("变量引用可赋值", 引用结果 == 18)

    // 函数调用 / 方法调用
    调用结果 = 加法(甲, 乙)
    检查("函数调用可赋值", 调用结果 == 7)
    方法结果 = 数字数组.长度()
    检查("方法调用可赋值", 方法结果 == 3)
    取值结果 = 学生信息.获取("姓名")
    检查("映射取值（方法调用）可赋值", 取值结果 == "小明")

    // 运算
    算术结果 = 甲 + 乙
    检查("算术运算可赋值", 算术结果 == 7)
    逻辑运算结果 = 非 假
    检查("逻辑运算（非）可赋值", 逻辑运算结果 == 真)
    比较结果 = 甲 > 乙 且 条件
    检查("比较与逻辑运算可赋值", 比较结果 == 假)
    取负结果 = -甲
    检查("一元取负可赋值", 取负结果 == -3)

    // 文本拼接
    拼接结果 = "你好，" + "世界"
    检查("文本拼接表达式可赋值", 拼接结果 == "你好，世界")

    收尾()
结束
