    乙 = 3
    甲 = 甲 ~| 乙     // 6
    返回 甲
结束

// 左移多位 / 右移多位
移位多位() 整数:
    甲 = 1
    甲 = 甲 << 3     // 8
    乙 = 64
    乙 = 乙 >> 2     // 16
    // 24
    返回 甲 + 乙
结束

// ---------- 运算符优先级综合 ----------
优先级综合() 整数:
    // 算术优先级：^ > * / %% % > + -
    甲 = 2 + 3 * 4       // 14
    乙 = 10 - 2 * 3      // 4
    丙 = 2 ^ 3 * 2       // 8*2=16 (^ 高于 *)
    丁 = 100 %% 3 + 1    // 33+1=34
    戊 = -5 + 3          // -2
    // 14,4,16,34,-2 -> 1441632
    返回 甲 * 100000 + 乙 * 10000 + 丙 * 100 + 丁 + 戊
结束

// 位运算优先级：& > | ，算术高于位运算
位优先级() 整数:
    // 1 | 2 & 4 = 1 | 0 = 1
    结果 = 1 | 2 & 4
    // 5 << 1 + 1 = 5 << 2 = 20 (算术 + 高于 <<)
    结果2 = 5 << 1 + 1
    // 1, 20 -> 120
    返回 结果 * 100 + 结果2
结束

