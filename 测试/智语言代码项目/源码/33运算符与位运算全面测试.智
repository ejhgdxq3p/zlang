结束

// 取余规则：数学非负余数（0 ≤ 余数 < |除数|）
取余规则() 整数:
    负取余1 = -10 % 3      // 2
    负取余2 = 10 % -3      // 1
    正取余 = 10 % 3        // 1
    // 2,1,1 -> 211
    返回 负取余1 * 100 + 负取余2 * 10 + 正取余
结束

// 取负一元
取负测试() 整数:
    甲 = 8
    负甲 = -甲
    负负 = --甲
    // -8, 8 -> -72
    返回 负甲 * 10 + 负负
结束

// 算术复合赋值
算术复合() 小数:
    计数 = 1
    计数 += 9      // 10
    计数 *= 3      // 30
    计数 -= 5      // 25
    计数 %%= 4     // 6
    计数 ^= 2      // 36
    计数 %= 3      // 36 % 3 = 0
    计数 /= 4      // 0 / 4 = 0
    返回 计数
结束

// 幂运算
幂运算() 整数:
    二方 = 2 ^ 10     // 1024
    平方 = 5 ^ 2      // 25
    立方 = 3 ^ 3      // 27
    返回 二方 + 平方 + 立方
结束

// 复杂括号表达式
复杂算术() 整数:
    甲 = 10
    乙 = 3
    结果 = (甲 + 乙) * 2 - 5   // 21
    返回 结果
结束

// 整除应用：总页数
整除应用() 整数:
    总数 = 25
    每页 = 10
    总页数 = 总数 %% 每页       // 2
    最后一页 = 总数 % 每页     // 5
    返回 总页数 * 100 + 最后一页
结束

// ---------- 比较运算符 ----------
比较运算() 整数:
    甲 = 10
    乙 = 20
    大 = 0
    小 = 0
    等 = 0
    不等 = 0
    大等 = 0
    小等 = 0
    如果 甲 > 乙: 大 = 1 否则: 大 = 0 结束
    如果 甲 < 乙: 小 = 1 否则: 小 = 0 结束
    如果 甲 == 乙: 等 = 1 否则: 等 = 0 结束
    如果 甲 != 乙: 不等 = 1 否则: 不等 = 0 结束
    如果 甲 >= 10: 大等 = 1 否则: 大等 = 0 结束
    如果 乙 <= 20: 小等 = 1 否则: 小等 = 0 结束
    // 0,1,0,1,1,1 -> 4
    返回 大 + 小 + 等 + 不等 + 大等 + 小等
结束

// 字符串比较
字符串比较() 整数:
    甲 = 0
    乙 = 0
    丙 = 0
    如果 "abc" == "abc": 甲 = 1 否则: 甲 = 0 结束
    如果 "abc" != "ABC": 乙 = 1 否则: 乙 = 0 结束
    如果 "abc" == "ABC": 丙 = 1 否则: 丙 = 0 结束
    // 1,1,0 -> 2
    返回 甲 + 乙 + 丙
结束

// 属于 / 不属于
集合判断() 整数:
    数组 = [1, 2, 3, 4, 5]
    映射数据 = {"苹果": 1, "香蕉": 2}
    属于1 = 0
    不属于1 = 0
    键属于 = 0
    如果 2 属于 数组: 属于1 = 1 否则: 属于1 = 0 结束
    如果 10 不属于 数组: 不属于1 = 1 否则: 不属于1 = 0 结束
    如果 "苹果" 属于 映射数据: 键属于 = 1 否则: 键属于 = 0 结束
    // 3
    返回 属于1 + 不属于1 + 键属于
结束

// ---------- 逻辑运算符真值表 ----------
逻辑真值表() 整数:
    计数 = 0
    如果 真 且 真: 计数 = 计数 + 1 结束
    如果 真 且 假: 计数 = 计数 + 1 结束
    如果 假 或 真: 计数 = 计数 + 1 结束
    如果 假 或 假: 计数 = 计数 + 1 结束
    如果 非 真: 计数 = 计数 + 1 结束
    如果 非 假: 计数 = 计数 + 1 结束
    // 3
    返回 计数
结束

// 逻辑优先级：比较 > 非 > 且 > 或
逻辑优先级() 整数:
    计数 = 0
    年龄 = 20
    有卡 = 真
    如果 年龄 >= 18 且 有卡 == 真: 计数 = 计数 + 1 结束
    如果 (年龄 >= 18 且 有卡) 或 假: 计数 = 计数 + 1 结束
    如果 非 (年龄 >= 18): 计数 = 计数 + 1 结束
    // 2
    返回 计数
结束

// ---------- 位运算符 ----------
位运算() 整数:
    甲 = 5     // 0101
    乙 = 3     // 0011
    位与值 = 甲 & 乙         // 1
    位或值 = 甲 | 乙         // 7
    位非值 = ~甲            // -6
    异或值 = 甲 ~| 乙      // 6
    左移值 = 甲 << 1       // 10
    右移值 = 甲 >> 1       // 2
    // 1,7,-6,6,10,2 -> 164702
    返回 位与值 * 100000 + 位或值 * 10000 + 位非值 * 1000 + 异或值 * 100 + 左移值 * 10 + 右移值
结束

// 位复合赋值
位复合() 整数:
    甲 = 5
    乙 = 3
    甲 &= 乙      // 1
    丙 = 5
    丙 |= 乙      // 7
    丁 = 5
    丁 ~|= 乙     // 6
    戊 = 5
    戊 <<= 1      // 10
    己 = 5
    己 >>= 1      // 2
    // 1,7,6,10,2 -> 17702
    返回 甲 * 10000 + 丙 * 1000 + 丁 * 100 + 戊 * 10 + 己
结束

// 位运算权限控制应用
权限控制() 整数:
    读权限 = 4     // 100
    写权限 = 2     // 010
    执行权限 = 1   // 001
    用户权限 = 读权限 | 写权限   // 110 = 6
    有读 = 0
    有执行 = 0
    有写 = 0
    如果 (用户权限 & 读权限) != 0: 有读 = 1 否则: 有读 = 0 结束
    如果 (用户权限 & 执行权限) != 0: 有执行 = 1 否则: 有执行 = 0 结束
    如果 (用户权限 & 写权限) != 0: 有写 = 1 否则: 有写 = 0 结束
    // 1,0,1 -> 2
    返回 有读 + 有执行 + 有写
结束

// 异或不提供复合赋值
异或展开() 整数:
