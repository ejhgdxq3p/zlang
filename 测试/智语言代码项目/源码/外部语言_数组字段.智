// ══════════════════════════════════════════════════════════════════════════
// 【规范 §6.5.6 守护夹具 —— 外部块内结构体：数组字段】
//   规范 §6.5.6 规则③：「`数组<标量外部类型>`（元素为标量外部类型的定长数组字段）」
//   规范 §6.5 数组映射表：「`数组<短整数>` → C `int*`」；Rust 侧 `*const i32` + `usize`
//     ⇒ **指针口径**：数组字段在 C 侧是**指针** `X*`，元素个数由**紧邻的无符号整数类字段**承载
//        （规范数组「紧邻模式」：`T* data, size_t len`）。
//   依赖：外部语言/嵌套结构库（C 结构体 DataBag{ long long* data; size_t count; }）
//   本用例聚焦「返回方向往返」：C 按值返回含数组字段的结构体，验证 shim 序列化编组正确。
//   双模验证：
//     智语言开发套件.exe 运行       --直接执行 .\外部FFI_数组字段.智  （解释）
//     智语言开发套件.exe 构建运行   --重新编译 .\外部FFI_数组字段.智  （编译）
//   要点：① 不用 `智语言` 修饰符（扁平约定逃生舱）；默认即真实 C ABI，走 shim 编组。
//         ② 声明层只用外部类型名：`长整数` = 码4 = i64 = C long long（与 C 库 long long 一致）。
//         ③ 数组字段「类型在前」`数组<长整数> 数值`；紧邻 `无符号位宽整数 数量` 为长度。
// ══════════════════════════════════════════════════════════════════════════
外部:
    导入 嵌套结构库

    造数据包 关联 make_bag

    结构体 数据包():
        数组<长整数> 数值
        无符号位宽整数 数量
    结束

    造数据包() 数据包:
    结束
结束

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 外部块内结构体：数组字段 FFI（返回方向往返）=====")

    包 = 造数据包()

    检查("紧邻长度字段 数量 = 5", 包.数量 == 5)
    检查("数组字段 长度 = 5", 包.数值.长度() == 5)

    // ⚠ 智语言容器下标为 **1-based**（规范 §2.4.2「索引从 1 开始」）：`[1]` 为首元素。
    检查("数组字段 数值[1] = 10", 包.数值[1] == 10)
    检查("数组字段 数值[2] = 20", 包.数值[2] == 20)
    检查("数组字段 数值[3] = 30", 包.数值[3] == 30)
    检查("数组字段 数值[4] = 40", 包.数值[4] == 40)
    检查("数组字段 数值[5] = 50", 包.数值[5] == 50)

    求和 = 0
    循环 项 遍历 包.数值:
        求和 = 求和 + 项
    结束
    检查("数组字段 遍历求和 = 150", 求和 == 10 + 20 + 30 + 40 + 50)

    输出("结果：通过 " + 转文本(本模块.通过数) + " / 总数 " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
