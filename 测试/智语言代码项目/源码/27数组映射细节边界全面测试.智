// ============================================================
// 数组 / 映射 细节边界全面测试（对照《智语言编程规范》§4.3 / §4.4）
// 重点覆盖现有测试尚未充分验证的细粒度点：
//   数组：查找索引（整数/文本/重复元素首次位置）、空数组取末尾、
//         插入边界（末尾插入）、删除末尾、取末尾弹出式语义、
//         取末尾后原数组内容、是否包含边界（空数组/单元素）
//   映射：所有键具体值断言与顺序、所有值具体值断言、获取返回类型、
//         整数键是否包含、映射更新后长度变化、是否包含边界
// 双模验证：解释模式 + 编译模式
// ============================================================

总数 = 0
通过数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        输出("  ❌ " + 描述)
    结束
结束

启动程序():
    输出("===== A. 数组 查找索引 细节 =====")
    数测 = [11, 22, 33, 22, 44]
    检查("查找索引(11)=1（首元素）", 数测.查找索引(11) == 1)
    检查("查找索引(22)=2（重复元素取首次）", 数测.查找索引(22) == 2)
    检查("查找索引(44)=5（末元素）", 数测.查找索引(44) == 5)
    检查("查找索引(99)=0（不存在）", 数测.查找索引(99) == 0)
    文本测 = ["甲", "乙", "丙"]
    检查("文本查找索引(乙)=2", 文本测.查找索引("乙") == 2)
    检查("文本查找索引(丁)=0（不存在）", 文本测.查找索引("丁") == 0)

    输出("===== B. 数组 取末尾 细节 =====")
    空测 = []
    // ℹ 空数组取末尾：规范 §4.3 **未定义**该情形，实现**返回空值**（双模一致）。
    //   2026-09-27 曾试改为「抛可捕获异常」，因实测**破坏"弹到空为止"的算法用例**
    //   （`测试/1单个代码文件测试/…/排序二分丙.智`、`排序二分丁.智`）而**回退** ⇒ 保持既有语义。
    弹出空 = 空测.取末尾()
    检查("空数组取末尾返回空值", 弹出空 == 空值)
    检查("空数组取末尾后长度仍=0", 空测.长度() == 0)
    末测 = [7, 8, 9]
    弹出 = 末测.取末尾()
    检查("取末尾返回值=9", 弹出 == 9)
    检查("取末尾后长度=2", 末测.长度() == 2)
    检查("取末尾后末位=8", 末测[2] == 8)
    检查("取末尾后[1]不变=7", 末测[1] == 7)

    输出("===== C. 数组 插入边界 =====")
    插末 = [1, 2, 3]
    插末.插入(4, 99)          // 在长度+1位置插入=末尾追加
    检查("插入位置=长度+1 视为末尾: 长度=4", 插末.长度() == 4)
    检查("插入位置=长度+1: 末位=99", 插末[4] == 99)
    插中 = [1, 2, 3, 4]
    插中.插入(2, 100)         // 中间插入
    检查("中间插入[2]=100", 插中[2] == 100)
    检查("中间插入后[3]=原2", 插中[3] == 2)
    检查("中间插入后[4]=原3", 插中[4] == 3)

    输出("===== D. 数组 删除边界 =====")
    删末 = [1, 2, 3]
    删末.删除(3)              // 删末尾
    检查("删除末尾: 长度=2", 删末.长度() == 2)
    检查("删除末尾: 末位=2", 删末[2] == 2)
    删中 = [1, 2, 3, 4]
    删中.删除(2)              // 删中间
    检查("删除中间[2]: 长度=3", 删中.长度() == 3)
    检查("删除中间后[2]=原3", 删中[2] == 3)
    检查("删除中间后[3]=原4", 删中[3] == 4)

    输出("===== E. 数组 取末尾返回值继续操作 =====")
    // 注意：数组.追加 不返回数组本身（仅 取末尾 返回元素），故分步验证
    // ⚠ 已知限制：对【字面量数组】直接 .追加 不生效（值类型字面量边界），
    //   须先赋给变量再操作（与 18 基础测试一致）。此处用变量写法。
    // ⚠ 重要语义：数组.取末尾() 是【弹出式】——返回末位元素并移除它（长度-1）
    链追加 = [5, 6, 7]
    链追加.追加(8)
    检查("追加后长度=4", 链追加.长度() == 4)
    检查("追加后[4]=8", 链追加[4] == 8)
    末值 = 链追加.取末尾()       // 弹出末位
    检查("取末尾返回=8", 末值 == 8)
    检查("取末尾后长度=3（已弹出）", 链追加.长度() == 3)
    检查("取末尾后[3]=7", 链追加[3] == 7)

    输出("===== F. 数组 是否包含 边界 =====")
    空含 = []
    检查("空数组是否包含(任意)=假", 空含.是否包含(1) == 假)
    单含 = [42]
    检查("单元素是否包含(42)=真", 单含.是否包含(42))
    检查("单元素是否包含(其他)=假", 单含.是否包含(43) == 假)

    输出("===== G. 映射 所有键/所有值 具体断言 =====")
    表 = {"甲": 10, "乙": 20, "丙": 30}
    键表 = 表.所有键()
    检查("所有键长度=3", 键表.长度() == 3)
    // 值复制隔离：表 改不影响 键表
    表.插入("丁", 40)
    检查("原表增加后 键表长度仍=3（值复制隔离）", 键表.长度() == 3)
    值表 = 表.所有值()
    检查("所有值长度=4（含新增丁）", 值表.长度() == 4)
    检查("所有值包含10", 值表.是否包含(10))
    检查("所有值包含20", 值表.是否包含(20))
    检查("所有值包含30", 值表.是否包含(30))
    检查("所有值包含40", 值表.是否包含(40))
    检查("所有值不包含99", 值表.是否包含(99) == 假)

    输出("===== H. 映射 获取 返回类型与类型一致 =====")
    获取整数 = 表.获取("甲")
    检查("获取整数值=10", 获取整数 == 10)
    获取缺失 = 表.获取("不存在")
    检查("获取缺失键返回空值", 获取缺失 == 空值)
    字符串表 = {"名": "张三"}
    获取文本 = 字符串表.获取("名")
    检查("获取文本值=张三", 获取文本 == "张三")

    输出("===== I. 映射 整数键 是否包含 =====")
    整数键表 = {1: "一", 2: "二"}
    检查("整数键是否包含(1)=真", 整数键表.是否包含(1))
    检查("整数键是否包含(3)=假", 整数键表.是否包含(3) == 假)

    输出("===== J. 映射 更新后长度变化 =====")
    更新表 = {"a": 1}
    检查("初始长度=1", 更新表.长度() == 1)
    更新表.插入("b", 2)
    检查("插入后长度=2", 更新表.长度() == 2)
    更新表.插入("a", 100)       // 覆盖
    检查("覆盖后长度仍=2", 更新表.长度() == 2)
    检查("覆盖后[a]=100", 更新表["a"] == 100)
    更新表.删除("a")
    检查("删除后长度=1", 更新表.长度() == 1)
    更新表.删除("b")
    检查("全删后长度=0", 更新表.长度() == 0)

    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.总数 - 本模块.通过数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
