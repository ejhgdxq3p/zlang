// 189 并发模块：**单文件模式**下的通道/监听/终止器语义矩阵（2026-09-28）
//
// 与「并发语义项目」（项目模式）的分工：
//   · 项目模式走「项目 → 模块加载 → 启动程序」链路 ✓；
//   · 本用例走**单文件模式**链路 ✓（两条链路的并发行为都要成立 ✓）。
//
// 资源纪律（硬要求）：休眠 ≤ 100ms、任务数 ≤ 4、任何阻塞等待都配**超时看护** ✓，绝不无限阻塞 ✗。
导入 并发
导入 时间

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

返回常量() 整数:
    返回 42
结束

慢返回() 整数:
    时间.休眠(100)
    返回 9
结束

任务内抛异常() 整数:
    抛出 "单文件模式-任务内异常"
    返回 0
结束

启动程序():
    输出("=== 189 并发（单文件模式）===")

    // ① 任务：等待结果 / 批量等待 / 超时部分结果
    句柄甲 = 并发.启动任务(返回常量)
    检查("任务-等待结果=42", 句柄甲.等待结果() == 42)
    检查("任务-已获取结果后是否完成=真", 句柄甲.是否完成() == 真)

    快句柄 = 并发.启动任务(函数() 整数:
        返回 7
    结束)
    慢句柄 = 并发.启动任务(慢返回)
    部分结果 = 并发.批量等待([快句柄, 慢句柄], 20)
    检查("批量等待超时-长度=2", 部分结果.长度() == 2)
    检查("批量等待超时-快的已完成=7", 部分结果[1] == 7)
    检查("批量等待超时-慢的填空值", 部分结果[2] == 空值)
    检查("批量等待超时-慢任务可稍后取=9", 慢句柄.等待结果() == 9)

    // ② 通道：关闭语义 + 非阻塞收发
    通道甲 = 并发.通道(2)
    通道甲.发送(11)
    通道甲.关闭()
    检查("已关闭+有残留-接收=11", 通道甲.接收() == 11)
    检查("已关闭+无残留-接收=空值", 通道甲.接收() == 空值)
    检查("关闭后是否关闭=真", 通道甲.是否关闭() == 真)
    捕获:
        通道甲.发送(1)
        检查("向已关闭通道发送-未抛(应抛)", 假)
    异常:
        检查("向已关闭通道发送-抛可捕获异常", 真)
    结束

    通道乙 = 并发.通道(1)
    检查("尝试发送-空位⇒真", 通道乙.尝试发送(3) == 真)
    检查("尝试发送-已满⇒假", 通道乙.尝试发送(4) == 假)
    检查("尝试接收-有数据⇒3", 通道乙.尝试接收() == 3)
    检查("尝试接收-已空⇒空值", 通道乙.尝试接收() == 空值)
    通道乙.关闭()

    // ③ 多路监听：三源（通道 / 超时 / 终止）
    数据通道 = 并发.通道(3)
    数据通道.发送("甲")
    并发.监听通道("数据", 数据通道)
    并发.监听超时("超时", 300)
    结果甲 = 并发.多路监听([])
    检查("多路监听-只含「来源」一键", 结果甲.长度() == 1)
    检查("多路监听-来源=数据", 结果甲.获取("来源") == "数据")
    检查("多路监听-数据由调用方接收=甲", 数据通道.接收() == "甲")

    空通道 = 并发.通道(1)
    并发.监听通道("通道", 空通道)
    并发.监听超时("跳过", 0)
    结果乙 = 并发.多路监听([])
    检查("零超时多路监听-来源=跳过（非阻塞）", 结果乙.获取("来源") == "跳过")
    空通道.关闭()

    // ⚠ 注意：这里必须用**新建且未关闭**的通道 —— 若复用上面那个**已关闭**的通道，
    //   按 §5.7.4「已关闭且已空 ⇒ 该事件立即就绪」它会抢先返回 ✗（首版即此用例缺陷 ✓）
    工作通道 = 并发.通道(1)
    退出信号 = 并发.终止器()
    退出信号.触发终止()
    并发.监听通道("工作", 工作通道)
    并发.监听终止("退出", 退出信号)
    结果丙 = 并发.多路监听([])
    检查("监听终止-来源=退出（规范 §5.7.5 案例三）", 结果丙.获取("来源") == "退出")
    工作通道.关闭()
    检查("终止器-是否终止=真（幂等）", 退出信号.是否终止() == 真)
    检查("终止器-信号通道随终止关闭", 退出信号.信号通道().是否关闭() == 真)

    // ④ 任务异常传递（规范 §5.7.2）
    异常句柄 = 并发.启动任务(任务内抛异常)
    捕获:
        异常句柄.等待结果()
        检查("任务异常-未传递(应传递)", 假)
    异常:
        检查("任务异常-经等待结果传递并可捕获", 真)
    结束

    // ⑤ 任务让出（§5.7.2）：可调用且不抛
    并发.任务让出()
    检查("任务让出-可调用且不抛", 真)

    收尾()
结束
