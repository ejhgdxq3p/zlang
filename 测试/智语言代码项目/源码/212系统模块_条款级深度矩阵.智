// 212 系统模块**条款级深度矩阵**：规范 §5.5（7 个函数）
//
// 分工：既有 `48文件与系统模块全面测试` 只做"能调通"的广度；本用例专攻条款细节：
//   · §5.5 获取参数：返回 `数组<文本>`；元素全为文本
//   · §5.5 执行：返回**命令输出文本**；输出内容原样带回
//   · §5.5 获取环境变量 / 设置环境变量：设置后立即生效、覆盖生效、**不存在的变量**行为（规范未定义 ⇒ 记录）
//   · §5.5 获取进程编号：正整数、稳定、与操作系统概念一致
//   · §5.5 获取平台：`Windows` / `Linux` / `Macos` 三者之一
//   · §5.5 退出：**另见** `212系统_退出码.智`（退出会终止进程，不能与其他断言同文件）
//
// 全部断言只用 ASCII 命令与 ASCII 变量名，规避编码干扰。
导入 系统

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

启动程序():
    输出("=== 212 系统模块 条款级深度矩阵 ===")

    // ───────────── ① §5.5 获取参数 ─────────────
    输出("-- ① 获取参数 --")
    参数 = 系统.获取参数()
    检查("获取参数 类型=数组", 类型(参数) == "数组")
    检查("获取参数 长度 >= 1", 参数.长度() >= 1)
    // ⚠ 不打印具体长度：解释模式含「运行/文件路径」等 3 项，编译模式产物只带 1 项，
    //   属两种执行载体的正常差异（不是缺陷），打印会破坏双模 stdout 逐字节一致性判据。
    记录("获取参数 长度是否 >= 1", 转文本(参数.长度() >= 1))
    全为文本 = 真
    循环 项 遍历 参数:
        如果 类型(项) != "文本":
            全为文本 = 假
        结束
    结束
    检查("获取参数 每个元素 类型=文本", 全为文本 == 真)

    // ───────────── ② §5.5 执行 ─────────────
    输出("-- ② 执行外部命令 --")
    回显 = 系统.执行("echo ABC123")
    检查("执行 返回类型=文本", 类型(回显) == "文本")
    检查("执行 输出含 ABC123", 回显.是否包含("ABC123") == 真)
    记录("echo ABC123 的原始返回长度", 转文本(回显.长度()))
    段一 = 系统.执行("echo LINE_ONE")
    段二 = 系统.执行("echo LINE_TWO")
    检查("执行 两次独立命令 各回显自身", 段一.是否包含("LINE_ONE") 且 段二.是否包含("LINE_TWO"))
    命令失败抛异常 = 假
    失败返回 = ""
    捕获:
        失败返回 = 系统.执行("definitely_not_a_command_212")
    异常:
        命令失败抛异常 = 真
    结束
    记录("执行不存在的命令 是否抛异常（规范未定义）", 转文本(命令失败抛异常))
    如果 命令失败抛异常 == 假:
        记录("执行不存在的命令 返回长度", 转文本(失败返回.长度()))
    结束

    // ───────────── ③ §5.5 环境变量 ─────────────
    输出("-- ③ 环境变量 --")
    系统.设置环境变量("ZHILANG_TEST_212", "值一")
    检查("设置后 获取 = 值一", 系统.获取环境变量("ZHILANG_TEST_212") == "值一")
    系统.设置环境变量("ZHILANG_TEST_212", "值二")
    检查("覆盖设置后 获取 = 值二", 系统.获取环境变量("ZHILANG_TEST_212") == "值二")
    系统.设置环境变量("ZHILANG_TEST_212", "含 空格 与 中文")
    检查("设置含空格与中文的值 可原样读回", 系统.获取环境变量("ZHILANG_TEST_212") == "含 空格 与 中文")
    不存在值 = 系统.获取环境变量("ZHILANG_NOT_EXIST_212")
    记录("不存在环境变量 的类型", 类型(不存在值))
    记录("不存在环境变量 的值长度", 转文本(不存在值.长度()))
    检查("不存在环境变量 不抛异常且可参与类型判断", 类型(不存在值) == "文本")
    系统.设置环境变量("ZHILANG_TEST_212", "")
    检查("设为空串后 获取 = 空串", 系统.获取环境变量("ZHILANG_TEST_212") == "")

    // ───────────── ④ §5.5 获取进程编号 ─────────────
    输出("-- ④ 获取进程编号 --")
    号一 = 系统.获取进程编号()
    号二 = 系统.获取进程编号()
    检查("进程编号 类型=整数", 类型(号一) == "整数")
    检查("进程编号 > 0", 号一 > 0)
    检查("同一进程内 两次获取一致", 号一 == 号二)

    // ───────────── ⑤ §5.5 获取平台 ─────────────
    输出("-- ⑤ 获取平台 --")
    平台 = 系统.获取平台()
    检查("获取平台 类型=文本", 类型(平台) == "文本")
    检查("获取平台 为 Windows/Linux/Macos 之一", 平台 == "Windows" 或 平台 == "Linux" 或 平台 == "Macos")
    记录("获取平台 实际值", 平台)

    // ───────────── ⑥ 跨函数自洽 ─────────────
    输出("-- ⑥ 跨函数自洽 --")
    系统.设置环境变量("ZHILANG_TEST_212", "ENV212OK")
    继承一 = 系统.执行("echo %ZHILANG_TEST_212%")
    继承二 = 系统.执行("echo $ZHILANG_TEST_212")
    检查("子进程继承本进程设置的环境变量", 继承一.是否包含("ENV212OK") 或 继承二.是否包含("ENV212OK"))

    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
