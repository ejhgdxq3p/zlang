通过数 = 0
失败数 = 0
总用例数 = 0
// ⚠ 订正（2026-09-20，按规范文档 §2.4.7）：以下三个变量在下方 `启动程序()` 内**以 `本模块.X` 读写**，
//   即按「模块级变量」使用 ⇒ 必须在**顶层**声明。原代码把它们声明在 `启动程序()` 内部（= 局部变量），
//   导致 `本模块.前测零次` / `本模块.区间零次` / `本模块.隔离` 指向**从未声明的模块级名字**，
//   语义未定义 ⇒ 3 项断言长期失败（实测：把它们移到顶层后 `前测零次=0 / 区间零次=0 / 隔离=8` 全部正确）。
前测零次 = 0
区间零次 = 0
隔离 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总用例数 = 本模块.总用例数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  OK " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  XX " + 名称)
    结束
结束

// 否则如果首匹配即停：命中第一个分支后，后续分支体内修改不应发生
首匹配即停(整数 分) 文本:
    副作用 = "未改"
    如果 分 >= 90:
        返回 "A"
    否则如果 分 >= 60:
        副作用 = "进了B"
        返回 "D"
    否则如果 分 >= 0:
        副作用 = "进了F"
        返回 "F"
    结束
    返回 副作用
结束

// 逻辑变量直接作条件（规范示例 如果 是否有会员卡:）
逻辑直判(逻辑 标志) 文本:
    结果 = "假"
    如果 标志:
        结果 = "真"
    结束
    如果 非 标志:
        结果 = 结果 + "非"
    结束
    返回 结果
结束

// 非 作用于比较表达式
非比较(整数 年龄) 逻辑:
    如果 非 (年龄 >= 18):
        返回 真
    结束
    返回 假
结束

// 三元复合 (A 且 B) 或 (C 且 D)
三元复合(逻辑 甲, 逻辑 乙, 逻辑 丙, 逻辑 丁) 逻辑:
    如果 (甲 且 乙) 或 (丙 且 丁):
        返回 真
    结束
    返回 假
结束

// 嵌套循环：跳出只作用于内层
跳出仅内层() 文本:
    外层命中 = "无"
    循环 外 = 1, 外 <= 3, 外 += 1:
        循环 内 = 1, 内 <= 3, 内 += 1:
            如果 内 == 2:
                跳出
            结束
        结束
        如果 外 == 2:
            外层命中 = "第二层跑完"
        结束
    结束
    返回 外层命中
结束

// 遍历中删除元素（验证迭代器安全，不崩溃且结果正确）
遍历中删除() 整数:
    表 = [1, 2, 3, 4, 5]
    保留 = []
    循环 元素 遍历 表:
        如果 元素 % 2 == 1:
            保留.追加(元素)
        结束
    结束
    // 不应在原表删除（规范未定义遍历中删原表语义），改为过滤到新表
    // 同时验证原表长度不变
    返回 保留.长度() * 100 + 表.长度()
结束

// 无限循环内 继续 后 跳出 不卡死
无限继续跳出() 整数:
    计数 = 0
    安全计数 = 0
    循环 真:
        安全计数 = 安全计数 + 1
        如果 安全计数 >= 100:
            跳出
        结束
        计数 = 计数 + 1
        如果 计数 < 3:
            继续
        结束
        如果 计数 >= 5:
            跳出
        结束
    结束
    返回 计数
结束

// 映射遍历值就地修改（值类型为整数，重新插入）
映射值修改() 整数:
    库存 = {"苹果": 100, "香蕉": 80, "橙子": 50}
    循环 键, 值 遍历 库存:
        如果 值 < 60:
            库存.插入(键, 值 + 50)
        结束
    结束
    // ★F2/F15 迁移（2026-10-14）：`.获取` 返回 `任意<整数|空值>`（规范 §10319）⇒ 不可直接参与算术 ✗
    //   ⇒ 按规范显式转换后运算（本用例键必存在 ⇒ 取值不变 ✓）
    返回 转整数(库存.获取("橙子")) + 转整数(库存.获取("苹果"))
结束

启动程序():
输出("##### 条件语句深度 #####")

检查("否则如果首匹配即停 95返回A", 首匹配即停(95) == "A")
检查("否则如果首匹配即停 65返回D", 首匹配即停(65) == "D")
检查("否则如果首匹配即停 5返回F", 首匹配即停(5) == "F")

检查("逻辑直判 真->真", 逻辑直判(真) == "真")
检查("逻辑直判 假->假非", 逻辑直判(假) == "假非")

检查("非比较 10岁->真(未成年)", 非比较(10) == 真)
检查("非比较 20岁->假(成年)", 非比较(20) == 假)

检查("三元复合 甲且乙 成立", 三元复合(真, 真, 假, 假) == 真)
检查("三元复合 丙且丁 成立", 三元复合(假, 假, 真, 真) == 真)
检查("三元复合 均不成立", 三元复合(真, 假, 假, 真) == 假)
检查("三元复合 甲且乙或丙且丁 双成立", 三元复合(真, 真, 真, 真) == 真)

输出("##### 循环语句深度 #####")

// 前测循环：条件初始为假，0次（⚠ `前测零次` 已在**顶层**声明为模块级变量）
初值 = 0
循环 初值 > 5:
    本模块.前测零次 = 本模块.前测零次 + 1
结束
检查("前测循环条件初始假 执行0次", 本模块.前测零次 == 0)

// 区间起始大于终止：0次（⚠ `区间零次` 已在**顶层**声明为模块级变量）
循环 逆 = 10, 逆 <= 1, 逆 -= 1:
    本模块.区间零次 = 本模块.区间零次 + 1
结束
检查("区间起始大于终止 执行0次", 本模块.区间零次 == 0)

检查("嵌套循环跳出仅内层 第二层跑完", 跳出仅内层() == "第二层跑完")
检查("遍历中过滤 奇数3个原表5个 合计305", 遍历中删除() == 305)
检查("无限循环继续后跳出 计数到5", 无限继续跳出() == 5)
检查("映射值修改 橙子100苹果100 合计200", 映射值修改() == 200)

// 变量重名隔离：内层循环变量不影响外层（⚠ `隔离` 已在**顶层**声明为模块级变量）
外层计数 = 0
循环 外层计数 = 1, 外层计数 <= 2, 外层计数 += 1:
    内层求和 = 0
    循环 内层求和 = 1, 内层求和 <= 3, 内层求和 += 1:
        // 空体，仅验证变量名不冲突
    结束
    本模块.隔离 = 本模块.隔离 + 内层求和
结束
// 内层循环 内层求和<=3 步+1：1,2,3,4(4>3停)，末值=4；外层循环2次累加 4+4=8
检查("变量重名隔离 内层末值4累加两次得8", 本模块.隔离 == 8)

