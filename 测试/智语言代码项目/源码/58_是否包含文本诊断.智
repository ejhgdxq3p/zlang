// 58 诊断：是否包含 对文本元素（无排序）编译模式表现
启动程序():
    文字集 = ["丙", "甲", "乙"]
    输出("无排序 含甲=" + 转文本(文字集.是否包含("甲")))
    输出("无排序 含乙=" + 转文本(文字集.是否包含("乙")))
    输出("无排序 含丙=" + 转文本(文字集.是否包含("丙")))
    输出("无排序 含丁=" + 转文本(文字集.是否包含("丁")))

    目标 = "甲"
    输出("变量比较 含甲=" + 转文本(文字集.是否包含(目标)))

    // 数字对照
    数字集 = [10, 20, 30]
    输出("数字 含20=" + 转文本(数字集.是否包含(20)))
结束
