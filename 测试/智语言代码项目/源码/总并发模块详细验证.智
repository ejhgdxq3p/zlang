// ============================================================
// 并发模块详细验证
// 严格对照《智语言编程规范》5.7 并发模块
// 覆盖：
//   5.7.2 任务（有返回值/无返回值/匿名/批量等待/超时批量等待/是否完成/任务让出）
//   5.7.3 通道（基本收发/缓冲/关闭语义/尝试发送/尝试接收/同步通道）
//   5.7.4 多路事件监听（监听通道/监听超时/监听终止/关闭通道自动就绪）
//   5.7.5 生命周期控制（终止器手动触发/是否终止/信号通道/多路集成）
//   5.7.6 常见模式（扇出-扇入/管线）
// 全部用例用 检查() 统计，末行输出汇总。双模验证。
// ============================================================

导入 并发

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    // ===================== 一、任务：有返回值 =====================
    输出("===== 一、任务：有返回值 / 等待结果 =====")
    任务句柄 = 并发.启动任务(函数() 整数:
        返回 21 * 2
    结束)
    结果 = 任务句柄.等待结果()
    检查("有返回值任务：返回 42", 结果 == 42)
    检查("任务.是否完成()=真", 任务句柄.是否完成())

    // ===================== 二、任务：无返回值 =====================
    输出("===== 二、任务：无返回值 =====")
    // 任务内的变量是任务局部副本（并发隔离语义），不回写主线程变量。
    // 用无返回值任务 + 等待结果返回空值 验证其正确执行且不报错。
    无返任务 = 并发.启动任务(函数():
        局部变量 = 100
    结束)
    无返结果 = 无返任务.等待结果()
    检查("无返回值任务执行：等待结果返回空值", 无返结果 == 空值)

    // ===================== 三、任务：匿名函数包装（带参调用） =====================
    输出("===== 三、匿名函数包装（带参调用） =====")
    求和任务 = 并发.启动任务(函数() 整数:
        返回 计算总和(10, 20)
    结束)
    检查("匿名包装任务：10+20=30", 求和任务.等待结果() == 30)

    // ===================== 四、批量等待 =====================
    输出("===== 四、批量等待（按序返回） =====")
    句柄1 = 并发.启动任务(函数() 整数: 返回 1 结束)
    句柄2 = 并发.启动任务(函数() 整数: 返回 2 结束)
    句柄3 = 并发.启动任务(函数() 整数: 返回 3 结束)
    批量结果 = 并发.批量等待([句柄1, 句柄2, 句柄3])
    检查("批量等待长度=3", 批量结果.长度() == 3)
    检查("批量等待[0]=1", 批量结果[1] == 1)
    检查("批量等待[1]=2", 批量结果[2] == 2)
    检查("批量等待[2]=3", 批量结果[3] == 3)

    // ===================== 五、批量等待超时 =====================
    输出("===== 五、批量等待超时（未完成任务继续运行） =====")
    慢任务 = 并发.启动任务(函数() 文本:
        并发.任务让出()
        返回 "慢结果"
    结束)
    部分结果 = 并发.批量等待([慢任务], 200)
    // 超时返回：若任务未完成为空值，若已完成为真实结果（两种均合法，重点验证句柄有效）
    片段 = 部分结果[1]
    检查("超时批量等待：返回空值或已完成结果（句柄有效）", 片段 == 空值 或 片段 == "慢结果")
    后期结果 = 慢任务.等待结果()
    检查("超时后句柄仍有效：最终得到 慢结果", 后期结果 == "慢结果")

    // ===================== 六、通道：基本收发 + 缓冲 =====================
    输出("===== 六、通道：基本收发 + 关闭语义 =====")
    数据通道 = 并发.通道(3)
    数据通道.发送(100)
    数据通道.发送(200)
    数据通道.关闭()
    检查("通道接收 100", 数据通道.接收() == 100)
    检查("通道接收 200", 数据通道.接收() == 200)
    检查("已关闭通道接收=空值", 数据通道.接收() == 空值)
    检查("通道.是否关闭()=真", 数据通道.是否关闭())

    // ===================== 七、通道：尝试发送 / 尝试接收 =====================
    输出("===== 七、通道：尝试发送 / 尝试接收（非阻塞） =====")
    缓冲通道 = 并发.通道(1)
    发送成功 = 缓冲通道.尝试发送("A")
    检查("尝试发送：缓冲有空位返回真", 发送成功 == 真)
    满时发送 = 缓冲通道.尝试发送("B")
    检查("尝试发送：缓冲满返回假", 满时发送 == 假)
    尝试接收值 = 缓冲通道.尝试接收()
    检查("尝试接收：返回 A", 尝试接收值 == "A")
    空接收 = 缓冲通道.尝试接收()
    检查("尝试接收：空通道返回空值", 空接收 == 空值)
    缓冲通道.关闭()

    // ===================== 八、通道：同步通道（容量 0） =====
    输出("===== 八、同步通道（容量=0） =====")
    同步 = 并发.通道(0)
    检查("同步通道创建成功", 同步 != 空值)
    同步.关闭()
    检查("同步通道关闭后是否关闭=真", 同步.是否关闭())

    // ===================== 九、多路监听：通道 + 超时 =====
    输出("===== 九、多路监听：监听通道 + 监听超时 =====")
    选择通道 = 并发.通道(10)
    选择通道.发送("重要数据")
    并发.监听通道("数据", 选择通道)
    并发.监听超时("超时", 5000)
    监听结果 = 并发.多路监听([])
    来源 = 监听结果.获取("来源")
    检查("多路监听命中数据事件", 来源 == "数据")
    接收数据 = 选择通道.接收()
    检查("从通道读取 重要数据", 接收数据 == "重要数据")
    选择通道.关闭()

    // ===================== 十、多路监听：关闭通道自动就绪 =====
    输出("===== 十、多路监听：关闭通道自动就绪 =====")
    空通道 = 并发.通道(5)
    空通道.关闭()
    并发.监听通道("已关闭", 空通道)
    关闭结果 = 并发.多路监听([])
    检查("关闭通道触发已关闭事件", 关闭结果.获取("来源") == "已关闭")

    // ===================== 十一、多路监听：非阻塞（超时 0ms） =====
    输出("===== 十一、多路监听：非阻塞（超时 0ms） =====")
    跳过通道 = 并发.通道(10)
    并发.监听通道("通道", 跳过通道)
    并发.监听超时("跳过", 0)
    非阻塞结果 = 并发.多路监听([])
    检查("空通道+0ms超时：来源=跳过", 非阻塞结果.获取("来源") == "跳过")
    跳过通道.关闭()

    // ===================== 十二、终止器：手动触发 =====
    输出("===== 十二、终止器：手动触发 / 是否终止 =====")
    终止信号 = 并发.终止器()
    检查("未触发时 是否终止=假", 终止信号.是否终止() == 假)
    终止信号.触发终止()
    检查("触发后 是否终止=真", 终止信号.是否终止() == 真)
    终止信号.触发终止()
    检查("重复触发无副作用：仍为真", 终止信号.是否终止() == 真)

    // ===================== 十三、终止器：信号通道 + 多路集成 =====
    输出("===== 十三、终止器：信号通道 + 多路监听集成 =====")
    工作通道 = 并发.通道(10)
    退出信号 = 并发.终止器()
    退出信号.触发终止()
    并发.监听通道("工作", 工作通道)
    并发.监听终止("退出", 退出信号)
    终止监听结果 = 并发.多路监听([])
    检查("多路监听集成终止信号：来源=退出", 终止监听结果.获取("来源") == "退出")
    工作通道.关闭()

    // ===================== 十四、常见模式：扇出-扇入 =====
    输出("===== 十四、常见模式：扇出-扇入（并行计算） =====")
    平方结果 = 并行映射([1, 2, 3, 4, 5])
    检查("扇出-扇入长度=5", 平方结果.长度() == 5)
    检查("扇出-扇入[1]=1", 平方结果[1] == 1)
    检查("扇出-扇入[5]=25", 平方结果[5] == 25)

    // ===================== 十五、常见模式：管线 =====
    输出("===== 十五、常见模式：管线（多阶段流水线） =====")
    管线结果 = 运行管线()
    检查("管线结果长度=5", 管线结果.长度() == 5)
    检查("管线结果[1]=数字1", 管线结果[1] == "数字1")

    // ===================== 汇总 =====================
    输出("")
    输出("===== 并发模块详细验证 汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "  通过：" + 转文本(本模块.通过数) + "  失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 == 0:
        输出("全部通过")
    否则:
        输出("存在失败用例")
    结束
结束

// ---------- 辅助函数 ----------

计算总和(整数 甲, 整数 乙) 整数:
    返回 甲 + 乙
结束

并行映射(数组<整数> 数据列表) 数组<整数>:
    任务列表 = []
    循环 元素 遍历 数据列表:
        值 = 元素
        句柄 = 并发.启动任务(函数() 整数:
            返回 值 * 值
        结束)
        任务列表.追加(句柄)
    结束
    返回 并发.批量等待(任务列表)
结束

运行管线() 数组<文本>:
    阶段一输出 = 并发.通道(5)
    阶段二输出 = 并发.通道(5)

    并发.启动任务(函数():
        循环 索引 = 1, 索引 <= 5, 索引 += 1:
            阶段一输出.发送(索引)
        结束
        阶段一输出.关闭()
    结束)

    并发.启动任务(函数():
        循环 真:
            数字 = 阶段一输出.接收()
            如果 数字 == 空值:
                跳出
            结束
            阶段二输出.发送("数字" + 转文本(数字))
        结束
        阶段二输出.关闭()
    结束)

    收集 = []
    循环 真:
        文本数据 = 阶段二输出.接收()
        如果 文本数据 == 空值:
            跳出
        结束
        收集.追加(文本数据)
    结束
    返回 收集
结束
