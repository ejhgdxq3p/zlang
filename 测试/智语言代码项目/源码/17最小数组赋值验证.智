// 最小验证：数组 / 映射 变量赋值是否按规范 §2.3.7 做「值复制」（深拷贝隔离）
// 真正可区分「深拷贝生效」与「共享引用」的判据：赋值并修改副本后，原数组必须【完全不变】。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  PASS " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  FAIL " + 描述)
    结束
结束

启动程序():
    // ===== 数组 =====
    数组甲 = [1, 2, 3]
    数组乙 = 数组甲            // 值复制，应深拷贝
    数组乙[1] = 20            // 改副本第一个元素

    检查("数组赋值: 甲[1] 不变(=1)", 数组甲[1] == 1)
    检查("数组赋值: 甲[2] 不变(=2)", 数组甲[2] == 2)
    检查("数组赋值: 甲[3] 不变(=3)", 数组甲[3] == 3)
    检查("数组赋值: 乙[1] 已改(=20)", 数组乙[1] == 20)
    检查("数组赋值: 甲[3] 不变(=3)", 数组甲[3] == 3)

    // ===== 映射 =====
    映射甲 = {"k": 1, "m": 2}
    映射乙 = 映射甲            // 值复制，应深拷贝
    映射乙["k"] = 99          // 改副本

    检查("映射赋值: 甲[k] 不变(=1)", 映射甲["k"] == 1)
    检查("映射赋值: 甲[m] 不变(=2)", 映射甲["m"] == 2)
    检查("映射赋值: 乙[k] 已改(=99)", 映射乙["k"] == 99)
    检查("映射赋值: 乙[m] 不变(=2)", 映射乙["m"] == 2)

    输出("通过: " + 转文本(本模块.通过数) + "/" + 转文本(本模块.总数))
    如果 本模块.通过数 == 本模块.总数:
        输出("结果: 全部通过")
    否则:
        输出("结果: 存在失败")
    结束
结束
