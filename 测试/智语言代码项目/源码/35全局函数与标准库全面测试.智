导入 时间
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    // ===================== 一、8 个全局函数 =====================
    输出("===== 一、8 个全局函数 =====")
    输出("诊断：输出() 正常")
    错误输出("诊断：错误输出() 正常")
    // 转文本()
    检查("转文本(整数42)='42'", 转文本(42) == "42")
    检查("转文本(小数3.14)='3.14'", 转文本(3.14) == "3.14")
    检查("转文本(逻辑真)='真'", 转文本(真) == "真")
    检查("转文本(逻辑假)='假'", 转文本(假) == "假")
    检查("转文本(数组)='[1, 2, 3]'", 转文本([1, 2, 3]) == "[1, 2, 3]")
    检查("转文本(映射)含键值", 转文本({"键": "值"}).是否包含("键"))
    // 转整数()
    检查("转整数(小数3.7)=3", 转整数(3.7) == 3)
    检查("转整数(小数-3.7)=-3", 转整数(-3.7) == -3)
    检查("转整数(文本'123')=123", 转整数("123") == 123)
    检查("转整数(文本'-42')=-42", 转整数("-42") == -42)
    检查("转整数(整数)=恒等", 转整数(100) == 100)
    // 转小数()
    检查("转小数(整数42)=42.0", 转小数(42) == 42.0)
    检查("转小数(小数)=恒等", 转小数(1.5) == 1.5)
    检查("转小数(文本'3.14')=3.14", 转小数("3.14") == 3.14)
    检查("转小数(文本'-2.5')=-2.5", 转小数("-2.5") == -2.5)
    // 类型()
    检查("类型(42)=整数", 类型(42) == "整数")
    检查("类型(3.14)=小数", 类型(3.14) == "小数")
    检查("类型('你好')=文本", 类型("你好") == "文本")
    检查("类型(真)=逻辑", 类型(真) == "逻辑")
    检查("类型(空值)=空值", 类型(空值) == "空值")
    检查("类型([1,2,3])=数组", 类型([1, 2, 3]) == "数组")
    检查("类型({'键':'值'})=映射", 类型({"键": "值"}) == "映射")
    // 异常错误()：仅限异常块内调用
    捕获:
        抛出 "测试异常消息"
    异常:
        错误对象 = 异常错误()
        检查("异常错误() 可返回对象(非崩溃)", 真)
        检查("异常错误().描述 含消息", 错误对象.描述.是否包含("测试异常消息"))
        // 第十四轮修复：类型名应="异常错误"（此前错挂"通道"）
        检查("异常错误() 类型名=异常错误", 类型(错误对象) == "异常错误")
    结束
    // 异常错误(消息)：带参构造（第十四轮新增系统调用178）
    构造异常 = 异常错误("构造测试消息")
    检查("异常错误(消息) 类型名=异常错误", 类型(构造异常) == "异常错误")
    检查("异常错误(消息).描述=构造测试消息", 构造异常.描述 == "构造测试消息")
    // 输入()：解释/编译模式下从 stdin 读取；此处仅验证可调用且返回文本类型
    输入值 = 输入()
    检查("输入() 返回文本类型", 类型(输入值) == "文本")

    // ===================== 二、文本 7 方法 =====================
    输出("===== 二、文本 7 方法 =====")
    原文 = "你好世界"
    检查("文本.长度() 中文=4", 原文.长度() == 4)
    检查("文本.截取(1,2)='你好'", 原文.截取(1, 2) == "你好")
    检查("文本.截取(3,2)='世界'", 原文.截取(3, 2) == "世界")
    检查("文本.查找('世界')=3", 原文.查找("世界") == 3)
    检查("文本.查找('地球')=0(未找到)", 原文.查找("地球") == 0)
    替换文 = 原文.替换("世界", "朋友")
    检查("文本.替换 结果正确", 替换文 == "你好朋友")
    分隔数组 = "苹果,香蕉,橙子,葡萄".分隔(",")
    检查("文本.分隔 长度=4", 分隔数组.长度() == 4)
    检查("文本.分隔[1]='苹果'", 分隔数组[1] == "苹果")
    检查("文本.是否包含('你好')=真", 原文.是否包含("你好"))
    检查("文本.是否包含('再见')=假", 原文.是否包含("再见") == 假)
    检查("文本.去除空白 去首尾", "   你好   ".去除空白() == "你好")
    // 链式调用（规范示例）
    链式 = "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2)
    检查("文本 链式调用结果='你好'", 链式 == "你好")

    // ===================== 三、数组 10 方法 =====================
    输出("===== 三、数组 10 方法 =====")
    数字数组 = [10, 20, 30, 40, 50]
    检查("数组.长度()=5", 数字数组.长度() == 5)
    数字数组.追加(60)
    检查("数组.追加 后长度=6", 数字数组.长度() == 6)
    检查("数组.追加 末位=60", 数字数组[6] == 60)
    水果数组 = ["苹果", "香蕉", "橙子"]
    水果数组.追加("葡萄")
    检查("数组.追加 字符串元素", 水果数组.长度() == 4)
    数字数组.插入(1, 5)
    检查("数组.插入(1,5) 后长度=7", 数字数组.长度() == 7)
    检查("数组.插入(1,5) 首=5", 数字数组[1] == 5)
    数字数组.删除(1)
    检查("数组.删除(1) 后长度=6", 数字数组.长度() == 6)
    检查("数组.删除 后首=10", 数字数组[1] == 10)
    数字数组.删除(3)
    检查("数组.删除(3) 后长度=5", 数字数组.长度() == 5)
    // 取末尾：用独立干净数组验证（取末尾是弹出式，长度-1）
    取末数组 = [10, 20, 30, 40, 50]
    末位 = 取末数组.取末尾()
    检查("数组.取末尾 返回末位=50", 末位 == 50)
    检查("数组.取末尾 后长度-1", 取末数组.长度() == 4)
    检查("数组.是否包含(20)=真", 数字数组.是否包含(20))
    检查("数组.是否包含(80)=假", 数字数组.是否包含(80) == 假)
    检查("数组.查找索引(40)=正确索引>0", 数字数组.查找索引(40) > 0)
    检查("数组.查找索引(80)=0(未找到)", 数字数组.查找索引(80) == 0)
    反转前末位 = 数字数组[数字数组.长度()]
    数字数组.反转()
    检查("数组.反转 后长度不变", 数字数组.长度() == 5)
    检查("数组.反转 原末位变首", 数字数组[1] == 反转前末位)
    数字数组.反转()  // 还原
    数字数组.排序()
    检查("数组.排序 长度为5", 数字数组.长度() == 5)
    检查("数组.排序 首<=尾", 数字数组[1] <= 数字数组[数字数组.长度()])
    数字数组.清空()
    检查("数组.清空 后长度=0", 数字数组.长度() == 0)
    // 链式调用（规范示例：追加是void不可链式，但规范示例写 新数组.追加(10).追加(20).追加(30) 实测需先变量化）
    链式数组 = []
    链式数组.追加(10).追加(20).追加(30)
    检查("数组 链式调用 长度=3", 链式数组.长度() == 3)

    // ===================== 四、映射 8 方法 =====================
    输出("===== 四、映射 8 方法 =====")
    学生信息 = {"姓名": "小明", "年龄": 18, "班级": "高一(1)班", "成绩": 92}
    检查("映射.长度()=4", 学生信息.长度() == 4)
    所有键 = 学生信息.所有键()
    检查("映射.所有键 长度=4", 所有键.长度() == 4)
    所有值 = 学生信息.所有值()
    检查("映射.所有值 长度=4", 所有值.长度() == 4)
    学生信息.插入("性别", "男")
    检查("映射.插入 新增键 长度=5", 学生信息.长度() == 5)
    学生信息.插入("年龄", 19)
    检查("映射.插入 更新已有键 值=19", 学生信息.获取("年龄") == 19)
    学生信息.删除("班级")
    检查("映射.删除 后长度=4", 学生信息.长度() == 4)
    检查("映射.是否包含('姓名')=真", 学生信息.是否包含("姓名"))
    检查("映射.是否包含('地址')=假", 学生信息.是否包含("地址") == 假)
    检查("映射.获取('姓名')=小明", 学生信息.获取("姓名") == "小明")
    检查("映射.获取('地址')=空值", 学生信息.获取("地址") == 空值)
    临时映射 = {"甲": 1, "乙": 2}
    临时映射.清空()
    检查("映射.清空 后长度=0", 临时映射.长度() == 0)

    // ===================== 五、时间模块 15 函数 =====================
    输出("===== 五、时间模块 15 函数 =====")
    现在 = 时间.当前时间()
    检查("时间.当前时间 为正整数", 现在 > 0)
    毫秒 = 时间.当前毫秒时间()
    检查("时间.当前毫秒时间 非负", 毫秒 >= 0)
    格式化文 = 时间.格式化("年-月-日 时:分:秒", 现在)
    检查("时间.格式化 返回文本", 类型(格式化文) == "文本")
    检查("时间.格式化 含横线", 格式化文.是否包含("-"))
    生日戳 = 时间.解析("2000-01-01", "年-月-日")
    检查("时间.解析 返回整数", 类型(生日戳) == "整数")
    检查("时间.解析 早于现在", 生日戳 < 现在)
    年 = 时间.获取年(现在)
    检查("时间.获取年 合理(>2000)", 年 > 2000)
    月 = 时间.获取月(现在)
    检查("时间.获取月 在1-12", 月 >= 1 且 月 <= 12)
    日 = 时间.获取日(现在)
    检查("时间.获取日 在1-31", 日 >= 1 且 日 <= 31)
    时 = 时间.获取时(现在)
    检查("时间.获取时 在0-23", 时 >= 0 且 时 <= 23)
    分 = 时间.获取分(现在)
    检查("时间.获取分 在0-59", 分 >= 0 且 分 <= 59)
    秒 = 时间.获取秒(现在)
    检查("时间.获取秒 在0-59", 秒 >= 0 且 秒 <= 59)
    星期 = 时间.获取星期(现在)
    检查("时间.获取星期 在1-7", 星期 >= 1 且 星期 <= 7)
    明天 = 时间.加(现在, 86400)
    检查("时间.加(86400) 比现在大", 明天 == 现在 + 86400)
    昨 = 时间.减(现在, 3600)
    检查("时间.减(3600) 比现在小", 昨 == 现在 - 3600)
    间隔 = 时间.间隔天数(明天, 现在)
    检查("时间.间隔天数=1", 间隔 == 1)
    计时 = 时间.获取计时器()
    检查("时间.获取计时器 非负", 计时 >= 0)
    时间.休眠(1)
    检查("时间.休眠(1) 正常返回", 真)

    // ===================== 六、工具模块 11 函数 =====================
    输出("===== 六、工具模块 11 函数 =====")
    匹配结果 = 工具.正则匹配("[0-9]+", "订单123和456")
    检查("工具.正则匹配 返回数组", 类型(匹配结果) == "数组")
    检查("工具.正则匹配 命中>=2", 匹配结果.长度() >= 2)
    替换结果 = 工具.正则替换("[0-9]+", "X", "a1b2")
    检查("工具.正则替换 返回文本", 类型(替换结果) == "文本")
    检查("工具.正则替换 数字被替换", 替换结果 == "aXbX")
    数据文 = 工具.生成数据("JSON", [1, 2, 3])
    检查("工具.生成数据 JSON 返回文本", 类型(数据文) == "文本")
    检查("工具.生成数据 JSON 含数字", 数据文.是否包含("1"))
    解析回 = 工具.解析数据("JSON", "[4,5,6]")
    // 第十四轮修复：解析数据返回类型应为数组（此前被推为映射致 .长度()=0）
    检查("工具.解析数据 JSON 返回数组", 类型(解析回) == "数组")
    检查("工具.解析数据 JSON数组 长度=3", 解析回.长度() == 3)
    检查("工具.解析数据 JSON数组[1]=4", 解析回[1] == 4)
    // 映射解析：用 生成数据 产生 JSON 文本（免手写引号），再 解析数据 往返验证
    用户映射 = {"姓名": "张三", "年龄": 25}
    往返文本 = 工具.生成数据("JSON", 用户映射)
    解析映射 = 工具.解析数据("JSON", 往返文本)
    检查("工具.解析数据 JSON映射 返回映射", 类型(解析映射) == "映射")
    检查("工具.解析数据 JSON映射 可取姓名", 解析映射.获取("姓名") == "张三")
    哈希值 = 工具.哈希算法("MD5", "hello")
    检查("工具.哈希算法 MD5 返回文本", 类型(哈希值) == "文本")
    检查("工具.哈希算法 MD5 长度32", 哈希值.长度() == 32)
    哈希校验值 = 工具.哈希算法("SHA256", "hello")
    检查("工具.哈希算法 SHA256 返回文本", 类型(哈希校验值) == "文本")
    检查("工具.哈希算法 SHA256 长度64", 哈希校验值.长度() == 64)
    编码值 = 工具.编码方案("BASE64", "hello")
    检查("工具.编码方案 BASE64 返回文本", 类型(编码值) == "文本")
    解码值 = 工具.解码方案("BASE64", 编码值)
    检查("工具.解码方案 BASE64 还原", 解码值 == "hello")
    编号1 = 工具.唯一编号()
    编号2 = 工具.唯一编号()
    检查("工具.唯一编号 返回非空文本", 编号1.长度() > 0)
    检查("工具.唯一编号 两次不同", 编号1 != 编号2)

    // ===================== 结果汇总 =====================
    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
