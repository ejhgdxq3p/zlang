    // ===== 追加 =====
    甲 = [1]
    甲.追加(2)
    检查("追加 后长度=2", 甲.长度() == 2)
    检查("追加 末位=2", 甲[2] == 2)

    // ===== 追加 链式调用（规范 §4.3 示例 新数组.追加(10).追加(20).追加(30)）=====
    链数组 = []
    链结果 = 链数组.追加(10).追加(20).追加(30)
    检查("追加链式 返回自身可继续", 类型(链结果) == "数组" 或 链数组.长度() == 3)
    检查("追加链式 长度=3", 链数组.长度() == 3)
    检查("追加链式[1]=10", 链数组[1] == 10)
    检查("追加链式[3]=30", 链数组[3] == 30)

    // ===== 插入 =====
    乙 = [1, 2, 3]
    乙.插入(2, 99)
    检查("插入 后长度=4", 乙.长度() == 4)
    检查("插入 位置2=99", 乙[2] == 99)

    // ===== 删除 =====
    丙 = [1, 2, 3]
    丙.删除(2)
    检查("删除 后长度=2", 丙.长度() == 2)
    检查("删除 后位置2=3", 丙[2] == 3)

    // ===== 包含 =====
    检查("包含 存在=真", [1, 2, 3].包含(2) == 真)
    检查("包含 不存在=假", [1, 2, 3].包含(9) == 假)

    // ===== 反转 =====
    丁 = [1, 2, 3]
    丁.反转()
    检查("反转 长度不变=3", 丁.长度() == 3)
    检查("反转 首=3", 丁[1] == 3)
    检查("反转 尾=1", 丁[3] == 1)

    // ===== 排序 =====
    戊 = [3, 1, 2]
    戊.排序()
    检查("排序 首=1", 戊[1] == 1)
    检查("排序 中=2", 戊[2] == 2)
    检查("排序 尾=3", 戊[3] == 3)
    检查("排序 单调递增", 戊[1] <= 戊[2] 且 戊[2] <= 戊[3])

    // ===== 查找索引（实现方法名，返回 1-based 索引，未找到返回 0）=====
    检查("查找索引 存在=2", [10, 20, 30].查找索引(20) == 2)
    检查("查找索引 不存在=0", [10, 20, 30].查找索引(99) == 0)

    // ===== 清空 =====
    辛 = [1, 2]
    辛.清空()
    检查("清空 长度=0", 辛.长度() == 0)

    // ===== 取末尾（弹出式）=====
    壬 = [1, 2, 3]
    末位 = 壬.取末尾()
    检查("取末尾 值=3", 末位 == 3)
    检查("取末尾 后长度=2", 壬.长度() == 2)

    // ===== 取末尾 空数组（ℹ 实现返回空值；规范未定义，见下方说明）=====
    空取 = []
    // ℹ 空数组取末尾：规范 §4.3 **未定义**该情形，实现**返回空值**（双模一致）。
    //   2026-09-27 曾试改为「抛可捕获异常」，因实测**破坏"弹到空为止"的算法用例**
    //   （`测试/1单个代码文件测试/…/排序二分丙.智`、`排序二分丁.智`）而**回退** ⇒ 保持既有语义。
    检查("取末尾 空数组=空值", 空取.取末尾() == 空值)

    // ===== 反转 还原（反转两次=原序）=====
    原 = [1, 2, 3, 4]
    原.反转()
    原.反转()
    检查("反转两次 首=1", 原[1] == 1)
    检查("反转两次 尾=4", 原[4] == 4)

    // ===== 排序 文本数组 =====
    文序 = ["香蕉", "苹果", "橙子"]
    文序.排序()
    检查("排序 文本 首=橙子", 文序[1] == "橙子")
    检查("排序 文本 尾=香蕉", 文序[3] == "香蕉")

    // ===== 排序 小数数组 =====
    小序 = [3.3, 1.1, 2.2]
    小序.排序()
    检查("排序 小数 首=1.1", 小序[1] == 转小数(1.1))
    检查("排序 小数 尾=3.3", 小序[3] == 转小数(3.3))

    // ===== 是否包含 方法（规范名 是否包含）=====
    检查("是否包含 方法 存在", [5, 6, 7].是否包含(6) == 真)
    检查("是否包含 方法 不存在", [5, 6, 7].是否包含(9) == 假)

    // ===== 遍历 =====
    总和 = 0
    循环 元素 遍历 [10, 20, 30]:
        总和 += 元素
    结束
    检查("遍历 求和=60", 总和 == 60)

    // ===== 排序 已序不变 =====
    有序 = [1, 2, 3]
    有序.排序()
    检查("排序 已序首=1", 有序[1] == 1)
    检查("排序 已序尾=3", 有序[3] == 3)

    // ===== 嵌套数组 =====
    嵌套 = [[1, 2], [3, 4]]
    检查("嵌套 长度=2", 嵌套.长度() == 2)
    检查("嵌套[1][2]=2", 嵌套[1][2] == 2)
    检查("嵌套 类型=数组", 类型(嵌套[1]) == "数组")

    // ===== 空数组 边界 =====
    空 = []
    检查("空数组 取末尾=空值", 空.取末尾() == 空值)
    检查("空数组 长度=0", 空.长度() == 0)

    // ===== 删除/插入 越界报错（逻辑版本146 已闭环）=====
    越界测试 = [1, 2, 3]
    捕获:
        越界测试.删除(99)
    异常:
        检查("删除 越界抛异常", 真)
    结束
    越界测试2 = [1, 2, 3]
    捕获:
        越界测试2.插入(99, 1)
    异常:
        检查("插入 越界抛异常", 真)
    结束

    // ===== 取末尾 后再访问末位 越界 =====
    弹 = [1, 2, 3]
    弹出值 = 弹.取末尾()
    检查("取末尾 弹出值=3", 弹出值 == 3)
    捕获:
        哑 = 弹[3]
