// 规范 §2.4.7「预定义标识符」表：模块级 ❌ 不能用；**结构体成员级（字段、常量、方法）✅ 可以用**，
//   通过 `实例.成员名` 访问，与全局函数不冲突；方法内 `自身.X` = 成员，裸名 = 全局函数。
通过数 = 0
失败数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("FAILCASE " + 名称)
    结束
结束

结构体 包装(文本 原始值):
    文本 输出 = 原始值        // 字段名 = 预定义标识符 ✓（结构体成员级允许）
    常量 转整数 = 42          // 常量名 = 预定义标识符 ✓
    取输出() 文本:
        返回 自身.输出
    结束
    取常量() 整数:
        返回 自身.转整数
    结束
    转文本() 文本:            // 方法名 = 预定义标识符 ✓
        返回 "方法:" + 自身.输出
    结束
结束

测试_成员级预定义标识符():
    实例 = 包装("abc")
    检查("字段名用 输出 可访问", 实例.取输出() == "abc")
    检查("常量名用 转整数 可访问", 实例.取常量() == 42)
    检查("方法名用 转文本 可访问", 实例.转文本() == "方法:abc")
    检查("同名全局函数仍可用（不冲突）", 转文本(123) == "123")
    检查("全局 转整数 仍可用", 转整数("7") == 7)
结束

启动程序():
    测试_成员级预定义标识符()
    输出("RESULT 通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " 失败：" + 转文本(本模块.失败数))
结束
