// 124 双引擎等价性：**字面量作实参**（判据 J1/J2 载体，双引擎等价性矩阵门禁纳入）
// ══════════════════════════════════════════════════════════════════════════
// 背景（2026-09-23 实测缺陷，已修 —— 阶段 1e）：
//   编译模式「推送实参」路径的 `字符串常量` 分支**直接调 `智语言分配文本自静态`**，
//   绕过了「统一字面量表」⇒ ① 该对象不入表 ⇒ **不是根** ⇒ 对账判为"不可达"（两引擎口径不可比）；
//   ② **每次调用都新建一个 `文本_静态` 且无主** ⇒ **字面量作实参**在循环内**逐次泄漏**。
// 判据（本用例 = 载体）：
//   `*内存*.智` / 本矩阵门禁下，终局 `存活` 应与轮数**解耦**（本形状应为个位数），
//   且**解释与编译逐项相同**（J1 存活按种类 / J2 可达·不可达）。
// ══════════════════════════════════════════════════════════════════════════
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

回声(文本 载荷) 文本:
    返回 载荷
结束

启动程序():
    输出("===== 字面量作实参：循环 300 轮 =====")
    轮 = 0
    末值 = ""
    循环 轮 <= 300:
        末值 = 回声("锚")
        轮 = 轮 + 1
    结束
    检查("字面量作实参：值正确", 末值 == "锚")
    检查("字面量作实参：循环次数正确", 轮 == 301)
    检查("字面量作实参：拼接后仍是值语义", 末值 + "尾" == "锚尾")

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
