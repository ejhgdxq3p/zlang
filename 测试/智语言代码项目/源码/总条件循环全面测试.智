// ---------------- 2.5.1 条件语句 ----------------

测试单条件():
    年龄 = 18
    命中 = 假
    如果 年龄 >= 18:
        命中 = 真
    结束
    检查("单条件 成立执行", 命中 == 真)

    分数 = 55
    未命中 = 假
    如果 分数 >= 60:
        未命中 = 真   // 不应执行
    结束
    检查("单条件 不成立不执行", 未命中 == 假)
结束

测试双条件():
    成绩 = 85
    结果 = ""
    如果 成绩 >= 60:
        结果 = "及格"
    否则:
        结果 = "不及格"
    结束
    检查("双条件 成立走如果", 结果 == "及格")

    余额 = 500
    价格 = 300
    购买成功 = 假
    剩余 = 0
    如果 余额 >= 价格:
        余额 -= 价格
        剩余 = 余额
        购买成功 = 真
    否则:
        购买成功 = 假
    结束
    检查("双条件 应用 扣款", 购买成功 == 真 且 剩余 == 200)
结束

