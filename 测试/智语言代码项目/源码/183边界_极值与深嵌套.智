收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 183 边界-极值与深嵌套 ===")
    // 极值整数（64 位）
    大甲 = 9007199254740993
    检查("大整数-转文本往返", 转整数(转文本(大甲)) == 大甲)
    检查("大整数-比较", 大甲 > 9007199254740992)
    负甲 = -9007199254740993
    检查("负大整数-往返", 转整数(转文本(负甲)) == 负甲)
    检查("零-转文本", 转文本(0) == "0")
    // 深嵌套容器
    深 = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
    检查("深嵌套-外层2", 深.长度() == 2)
    检查("深嵌套-逐层下标", 深[2][2][2] == 8)
    检查("深嵌套-首元素", 深[1][1][1] == 1)
    深映射 = {"甲": {"乙": {"丙": [1, 2, 3]}}}
    检查("深嵌套映射-三层取到", 深映射.获取("甲").获取("乙").获取("丙")[3] == 3)
    // 单元素容器全方法
    单个 = [7]
    检查("单元素-长度", 单个.长度() == 1)
    检查("单元素-是否包含", 单个.是否包含(7) == 真)
    检查("单元素-查找索引", 单个.查找索引(7) == 1)
    检查("单元素-获取", 单个.获取(1) == 7)
    单个.反转()
    检查("单元素-反转", 单个[1] == 7)
    单个.排序()
    检查("单元素-排序", 单个[1] == 7)
    单个.插入(1, 8)
    检查("单元素-插入到首位", 单个[1] == 8)
    单个.删除(2)
    检查("单元素-删除后长度", 单个.长度() == 1)
    // 空文本/空容器矩阵
    空文 = ""
    检查("空文本-长度", 空文.长度() == 0)
    检查("空文本-查找返0", 空文.查找("a") == 0)
    检查("空文本-是否包含假", 空文.是否包含("a") == 假)
    检查("空文本-去除空白", 空文.去除空白() == "")
    检查("空文本-替换", 空文.替换("a", "b") == "")
    检查("空文本-分隔", 空文.分隔(",").长度() >= 1)
    检查("空文本-截取", 空文.截取(1, 1) == "")
    空数 = []
    检查("空数组-所有方法安全", 空数.长度() == 0 且 空数.是否包含(1) == 假 且 空数.查找索引(1) == 0)
    空映射 = {}
    检查("空映射-所有方法安全", 空映射.长度() == 0 且 空映射.获取("a") == 空值)
    // 长文本
    长文 = ""
    循环 序 = 1, 序 <= 50, 序 += 1:
        长文 = 长文 + "文"
    结束
    检查("长文本-长度50", 长文.长度() == 50)
    检查("长文本-截取首字", 长文.截取(1, 1) == "文")
    检查("长文本-查找末位", 长文.查找("文") == 1)
    检查("长文本-替换全部", 长文.替换("文", "字").长度() == 50)
    // 小数精度
    检查("小数-往返", 转小数(转文本(1.5)) == 1.5)
    检查("小数-负零", 转小数("-0.0") == 0.0)
    收尾()
结束
