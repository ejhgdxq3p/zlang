// 63 文本方法精确测试（规范 4.2 七个方法 + 链式 逐项精确断言）
// 覆盖：长度 / 截取 / 替换 / 查找 / 分隔 / 是否包含 / 去除空白 / 链式调用

总数 = 0
通过数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
    否则:
        输出("❌ " + 名称)
    结束
结束

启动程序():
    消息 = "你好世界"
    // ===== 长度 =====
    检查("长度 中文=4", 消息.长度() == 4)

    // ===== 截取(起,长) =====
    检查("截取(1,2)=你好", 消息.截取(1, 2) == "你好")
    检查("截取(3,2)=世界", 消息.截取(3, 2) == "世界")
    检查("截取 起>长 返回空", 消息.截取(10, 2) == "")
    检查("截取 长>余 截到末尾", 消息.截取(3, 100) == "世界")

    // ===== 查找 =====
    检查("查找(世界)=3", 消息.查找("世界") == 3)
    检查("查找(地球)=0", 消息.查找("地球") == 0)

    // ===== 替换 =====
    检查("替换 世界->朋友", 消息.替换("世界", "朋友") == "你好朋友")
    检查("替换 全替换多处", "a-b-c".替换("-", "/") == "a/b/c")
    检查("替换 无匹配不变", "abc".替换("x", "y") == "abc")
    检查("替换 替换为空串", "aXbXc".替换("X", "") == "abc")

    // ===== 查找 起始语义 =====
    检查("查找 重复串首个位置", "abab".查找("ab") == 1)
    检查("查找 子串在中部", "abcdef".查找("cd") == 3)

    // ===== 分隔 多字符分隔符 =====
    多分 = "甲<>乙<>丙"
    多分结果 = 多分.分隔("<>")
    检查("分隔 多字符分隔符 长度=3", 多分结果.长度() == 3)
    检查("分隔 多字符[2]=乙", 多分结果[2] == "乙")
    检查("分隔 尾随空段", "a,b,".分隔(",").长度() == 3)

    // ===== 分隔 =====
    水果 = "苹果,香蕉,橙子,葡萄"
    分 = 水果.分隔(",")
    检查("分隔 长度=4", 分.长度() == 4)
    检查("分隔[1]=苹果", 分[1] == "苹果")
    检查("分隔[4]=葡萄", 分[4] == "葡萄")

    // ===== 是否包含 =====
    检查("是否包含(你好)=真", 消息.是否包含("你好") == 真)
    检查("是否包含(再见)=假", 消息.是否包含("再见") == 假)

    // ===== 去除空白 =====
    检查("去除空白 前后", "   你好   ".去除空白() == "你好")
    检查("去除空白 中间保留", "  a b  ".去除空白() == "a b")

    // ===== 链式调用 =====
    链 = "   你好世界   ".去除空白().替换("世界", "智语言").截取(1, 2)
    检查("链式=你好", 链 == "你好")

    // ===== 转义序列（规范 9 种中文形式：\换行 \制表 \引号 等）
    // 注意：词法器转义名贪婪读取（语言限制），转义后紧跟标识符字符会误并入转义名，
    // 故用字符串拼接将转义符号独立出来，避免 "行二"/"b"/"你好" 被吞入转义名。
    换 = "行一" + "\换行" + "行二"
    检查("换行转义 长度=5", 换.长度() == 5)
    制 = "a" + "\制表" + "b"
    检查("制表转义 长度=3", 制.长度() == 3)
    引 = "他说" + "\引号" + "你好" + "\引号"
    检查("引号转义 含引号", 引.是否包含("\引号"))
    反 = "路径" + "\反斜杠" + "名"
    检查("反斜杠转义 含单斜杠", 反.是否包含("\反斜杠"))

    // ===== 转文本() 嵌套转换 =====
    检查("转文本(转整数(转文本(5)))=5", 转文本(转整数(转文本(5))) == "5")
    检查("转文本(转小数(转文本(2.5)))=2.5", 转文本(转小数(转文本(2.5))) == "2.5")

    // ===== 长链式 =====
    长链 = "  a,b,c  ".去除空白().分隔(",").长度()
    检查("长链 分隔后长度=3", 长链 == 3)

    // ===== 查找 边界 =====
    检查("查找 起首=1", "abc".查找("a") == 1)
    检查("查找 末位", "abc".查找("c") == 3)
    检查("查找 空串=1(空串匹配位置0→1-based)", "abc".查找("") == 1)
    检查("查找 无匹配=0", "abc".查找("z") == 0)

    // ===== 分隔 边界 =====
    检查("分隔 无分隔符=1项", "单个".分隔(",").长度() == 1)
    检查("分隔 连续分隔", "a,,b".分隔(",").长度() == 3)

    输出("")
    输出("===== 63 文本方法精确测试 结果 =====")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.通过数 == 本模块.总数:
        输出("全部用例通过")
    否则:
        输出("存在失败用例")
    结束
结束
