// 221 并发**项目模式**（多模块）综合矩阵（2026-10-22）
//
// 与既有并发用例的分工（三条链路都要成立 ✓）：
//   · `189并发_通道与监听语义.智` = **单文件模式**的通道/监听/终止器契约 ✓
//   · `199并发_背压让出与协作取消.智` = 单文件模式的背压/让出/协作取消 ✓
//   · `210并发_任务内读模块变量与常量.智` = F34 护栏（子 VM 继承全局表）✓
//   · **本用例 = 项目模式 + 跨模块**：并发逻辑拆进 3 个模块（流水线 / 工作池 / 事件总线），
//     由本项目 `源码/并发项目/*.智` 提供，用例只做"组装 + 断言" ✓
//     ⇒ 覆盖"模块间传递通道/终止器句柄、模块内 λ 捕获通道、跨模块任务池"这些**只在项目模式才暴露**的路径。
//
// 规范依据（逐条对应断言）：
//   §5.7.2 `启动任务` / `等待结果` / `批量等待` / `任务让出` / `是否完成`
//   §5.7.3 `通道(容量)` / `发送`（满则阻塞）/ `接收`（关闭后返回空值）/ `关闭`（幂等、可读残留）/
//           `是否关闭` / `尝试发送`（非阻塞，满或已关闭返回假）/ `尝试接收`（非阻塞，空返回空值）
//   §5.7.4 `监听通道` / `监听超时`（0ms = 非阻塞）/ `监听终止` / `多路监听`（返回只含 "来源" 的映射）
//   §5.7.5 `终止器()` / `触发终止`（幂等）/ `是否终止`
//
// 资源纪律（硬要求，绝不耗尽 CPU/内存）：
//   · 任务数 ≤ 6（含模块内）·消息 ≤ 8 条·通道容量 ≤ 8·休眠仅 50ms 一处·总耗时目标 < 3s
//   · 每个 `循环 真` 的唯一出口是"接收空值（通道已关闭）"或"终止器已触发" ✓
//   · 所有阻塞等待都先保证对端已启动（先关通道/先发数据），不依赖"等待超时"兜底
导入 并发
导入 时间
导入 并发项目/流水线
导入 并发项目/工作池
导入 并发项目/事件总线

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

启动程序():
    输出("=== 221 并发项目模式：多模块流水线 / 工作池 / 事件总线 ===")

    // ───────── ① 跨模块流水线（生产 → 加工 → 消费）─────────
    输出("-- ① 跨模块流水线 --")
    结果 = 流水线.做流水线(5, 3)
    记录("流水线(5, ×3) 结果", 转文本(结果))
    检查("流水线 条数 = 5", 结果.长度() == 5)
    检查("流水线 逐条 ×3 且保序", 结果 == [3, 6, 9, 12, 15])
    空结果 = 流水线.做流水线(0, 3)
    检查("流水线 0 条 ⇒ 空数组（通道立即关闭、不挂死）", 空结果.长度() == 0)

    // ───────── ② 批量等待（§5.7.2）─────────
    输出("-- ② 批量等待 --")
    句柄甲 = 并发.启动任务(函数() 整数:
        返回 10
    结束)
    句柄乙 = 并发.启动任务(函数() 整数:
        返回 20
    结束)
    句柄丙 = 并发.启动任务(函数() 整数:
        返回 30
    结束)
    批量 = 并发.批量等待([句柄甲, 句柄乙, 句柄丙])
    检查("批量等待 返回 3 个结果", 批量.长度() == 3)
    检查("批量等待 结果保序 = 10/20/30",
        转文本(批量[1]) == "10" 且 转文本(批量[2]) == "20" 且 转文本(批量[3]) == "30")
    检查("批量等待后 句柄仍可单独取结果", 转文本(句柄甲.等待结果()) == "10")
    检查("任务完成后 `是否完成()` ⇒ 真", 句柄甲.是否完成() == 真)

    // ───────── ③ 跨模块工作池（固定工人 + 共享任务通道）─────────
    输出("-- ③ 跨模块工作池 --")
    池合计 = 工作池.跑池(4, 8)
    记录("工作池(4 工人, 8 任务) 合计", 转文本(池合计))
    检查("工作池 8 个任务 ×2 求和 = 72", 池合计 == 72)
    空池 = 工作池.跑池(1, 0)
    检查("工作池 0 任务 ⇒ 0（不挂死）", 空池 == 0)
    单池 = 工作池.跑池(1, 1)
    检查("工作池 1 工人 1 任务 ⇒ 2", 单池 == 2)

    // ───────── ④ 让出：长计算任务不饿死其它任务（§5.7.2）─────────
    输出("-- ④ 任务让出 --")
    计算任务 = 并发.启动任务(函数() 整数:
        返回 工作池.累加(1000)
    结束)
    并行小任务 = 并发.启动任务(函数() 整数:
        返回 7
    结束)
    小结果 = 并行小任务.等待结果()
    检查("长计算期间 另一个任务照常完成", 转文本(小结果) == "7")
    检查("累加(1000) = 500500（让出不破坏结果）", 转文本(计算任务.等待结果()) == "500500")

    // ───────── ⑤ 通道语义（§5.7.3）─────────
    输出("-- ⑤ 通道语义 --")
    缓存通道 = 并发.通道(1)
    首次 = 缓存通道.尝试发送(1)
    再次 = 缓存通道.尝试发送(2)
    检查("尝试发送：容量 1 第一次 ⇒ 真", 首次 == 真)
    检查("尝试发送：已满 第二次 ⇒ 假（不阻塞）", 再次 == 假)
    检查("是否关闭：未关闭 ⇒ 假", 缓存通道.是否关闭() == 假)
    检查("尝试接收：有数据 ⇒ 值 1", 转文本(缓存通道.尝试接收()) == "1")
    空取 = 缓存通道.尝试接收()
    检查("尝试接收：空 ⇒ 空值（不阻塞）", 空取 == 空值)
    缓存通道.关闭()
    检查("关闭后 是否关闭 ⇒ 真", 缓存通道.是否关闭() == 真)
    检查("重复关闭 无副作用（仍为真、不抛）", 缓存通道.是否关闭() == 真)
    检查("关闭后 尝试发送 ⇒ 假（不抛异常）", 缓存通道.尝试发送(9) == 假)
    检查("关闭且无残留 ⇒ 接收 返回空值", 缓存通道.接收() == 空值)

    残留通道 = 并发.通道(3)
    残留通道.发送(11)
    残留通道.发送(22)
    残留通道.关闭()
    检查("关闭后仍可读残留（第 1 条 = 11）", 转文本(残留通道.接收()) == "11")
    检查("关闭后仍可读残留（第 2 条 = 22）", 转文本(残留通道.接收()) == "22")
    检查("残留读尽后 ⇒ 空值", 残留通道.接收() == 空值)

    已关发送被拒 = 假
    捕获:
        关闭通道 = 并发.通道(1)
        关闭通道.关闭()
        关闭通道.发送(1)
    异常:
        已关发送被拒 = 真
    结束
    检查("★ 向已关闭通道 `发送` ⇒ 抛运行时异常（与尝试发送区分）", 已关发送被拒)

    // ───────── ⑥ 多路监听（§5.7.4，跨模块）─────────
    输出("-- ⑥ 多路监听 --")
    数据通道 = 并发.通道(2)
    数据通道.发送("载荷甲")
    来源一 = 事件总线.等数据或超时(数据通道, 50)
    检查("多路监听：有数据 ⇒ 来源 = 数据", 来源一 == "数据")
    检查("多路监听 不搬运数据（调用方自己接收）", 转文本(数据通道.接收()) == "载荷甲")

    空通道二 = 并发.通道(1)
    来源二 = 事件总线.等数据或超时(空通道二, 50)
    检查("多路监听：无数据 ⇒ 来源 = 超时（50ms 兜底，不永久阻塞）", 来源二 == "超时")

    来源三 = 事件总线.探测(空通道二)
    检查("多路监听：超时 0ms ⇒ 非阻塞返回 跳过", 来源三 == "跳过")

    即将关闭 = 并发.通道(1)
    即将关闭.关闭()
    来源四 = 事件总线.等数据或超时(即将关闭, 5000)
    检查("★ 通道已关闭 ⇒ 该事件立即就绪（来源 = 数据，不等到 5s 超时）", 来源四 == "数据")

    停止信号 = 并发.终止器()
    停止信号.触发终止()
    等待通道 = 并发.通道(1)
    来源五 = 事件总线.等数据或终止(等待通道, 停止信号)
    检查("多路监听：终止器已触发 ⇒ 来源 = 停止", 来源五 == "停止")
    检查("终止器 幂等：重复触发无副作用", 停止信号.是否终止() == 真)
    等待通道.关闭()
    空通道二.关闭()

    // ───────── ⑦ 任务异常传播（§5.7.2）─────────
    输出("-- ⑦ 任务异常传播 --")
    异常被捕获 = 假
    异常描述 = ""
    抛出任务 = 并发.启动任务(函数() 整数:
        抛出 "任务内异常-221"
        返回 0
    结束)
    捕获:
        抛出任务.等待结果()
    异常:
        异常被捕获 = 真
        异常描述 = 异常错误().描述
    结束
    检查("★ 任务内抛出 ⇒ `等待结果()` 抛到调用方", 异常被捕获)
    检查("异常描述透传任务内原文", 异常描述.是否包含("任务内异常-221"))

    // ───────── ⑧ 收尾 ─────────
    输出("")
    输出("=== 结果汇总 ===")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束
