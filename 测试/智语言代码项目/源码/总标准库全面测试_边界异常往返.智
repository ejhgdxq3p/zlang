// ============================================================
// 标准库全面测试 —— 边界 / 异常 / 往返 补充版
// 对照《智语言编程规范》4.1/4.2/4.3/4.4/5.4/5.6
// 本文件专补「正常路径测试(总标准库全面测试.智 / 35全局函数与标准库全面测试.智)」
// 未覆盖的规范明示行为：类型转换非法格式抛异常、空值转换抛异常、
// 数组插入/删除越界抛异常、时间与工具往返一致性、嵌套结构等。
// 双模验证（解释 / 编译）。
// ============================================================

导入 时间
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// 类型() 对结构体：结构体定义须置于模块级
结构体 书本():
    标题 = ""
结束

启动程序():
    // ===== 一、全局函数：类型转换非法格式 / 空值 应抛异常（规范 4.1）=====
    输出("===== 一、全局函数 边界/异常 =====")
    // 转整数() 非法文本应抛异常
    捕获:
        转整数("abc")
        检查("转整数('abc') 非法格式应抛异常(未抛=失败)", 假)
    异常:
        检查("转整数('abc') 非法格式抛异常", 真)
    结束
    // 转小数() 非法文本应抛异常
    捕获:
        转小数("abc")
        检查("转小数('abc') 非法格式应抛异常(未抛=失败)", 假)
    异常:
        检查("转小数('abc') 非法格式抛异常", 真)
    结束
    // 转整数() 空文本应抛异常
    捕获:
        转整数("")
        检查("转整数('') 空文本应抛异常(未抛=失败)", 假)
    异常:
        检查("转整数('') 空文本抛异常", 真)
    结束
    // 转文本(空值)：规范 4.1「除空值外任何类型都可转换」——空值在【编译期】即被拒绝
    // （报错「空值不能参与类型转换」），属正确行为，双模一致；因是编译期错误，
    // 无法用 捕获 运行期捕获，故此处仅注释记录，不纳入 检查 计数。
    // 转整数()/转小数() 边界合法值
    检查("转整数('0')=0", 转整数("0") == 0)
    检查("转整数('-0')=0", 转整数("-0") == 0)
    检查("转小数('-0')=0.0", 转小数("-0") == 0.0)
    检查("转小数('0')=0.0", 转小数("0") == 0.0)
    // 类型() 对结构体（定义见模块级）
    我的书 = 书本()
    检查("类型(结构体实例)=结构体名", 类型(我的书) == "书本")

    // ===== 二、文本方法：边界（规范 4.2）=====
    输出("===== 二、文本方法 边界 =====")
    原文 = "你好世界"
    // 截取 长度超出末尾应截断（不抛）
    检查("文本.截取(1,100)=全串", 原文.截取(1, 100) == "你好世界")
    // 截取 起始超出长度应返回空
    检查("文本.截取(5,2)=空(起点越界)", 原文.截取(5, 2) == "")
    // 去除空白 本无空白应不变
    检查("文本.去除空白(无空白)不变", "abc".去除空白() == "abc")
    // 分隔 连续分隔符
    连分 = "苹果,,香蕉".分隔(",")
    检查("文本.分隔 连续分隔符 长度=3", 连分.长度() == 3)
    检查("文本.分隔 连续分隔符[2]=空", 连分[2] == "")
    // 分隔 多字符分隔符
    多分 = "一::二::三".分隔("::")
    检查("文本.分隔 多字符分隔符 长度=3", 多分.长度() == 3)
    检查("文本.分隔 多字符分隔符[1]=一", 多分[1] == "一")
    // 查找 空子串（规范未定义，跳过）；查找 起点为1
    检查("文本.查找 子串在起始", "ababa".查找("aba") == 1)
    // 是否包含 空文本
    检查("文本.是否包含(空)=真", 原文.是否包含("") == 真)

    // ===== 三、数组方法：越界抛异常 + 边界（规范 4.3）=====
    输出("===== 三、数组方法 边界/异常 =====")
    越界数组 = [1, 2, 3]
    // 插入 越界应抛异常
    捕获:
        越界数组.插入(10, 99)
        检查("数组.插入 越界应抛异常(未抛=失败)", 假)
    异常:
        检查("数组.插入 越界抛异常", 真)
    结束
    // 删除 越界应抛异常
    捕获:
        越界数组.删除(10)
        检查("数组.删除 越界应抛异常(未抛=失败)", 假)
    异常:
        检查("数组.删除 越界抛异常", 真)
    结束
    // 反转 空数组
    空数组 = []
    空数组.反转()
    检查("数组.反转 空数组 长度=0", 空数组.长度() == 0)
    // 反转 单元素
    单元素 = [5]
    单元素.反转()
    检查("数组.反转 单元素 不变", 单元素[1] == 5)
    // 排序 逆序
    逆序 = [3, 2, 1]
    逆序.排序()
    检查("数组.排序 逆序升序", 逆序[1] == 1 且 逆序[3] == 3)
    // 排序 含重复
    含重 = [2, 1, 2]
    含重.排序()
    检查("数组.排序 含重复[2]=2", 含重[2] == 2)
    // 插入 末尾之后一位(合法上界 len+1)
    边界插 = [1, 2]
    边界插.插入(3, 9)
    检查("数组.插入(len+1) 合法 末位=9", 边界插[3] == 9)
    // 取末尾 空数组：规范未要求抛异常，实测不抛（返回空值）
    捕获:
        取末 = 空数组.取末尾()
        检查("数组.取末尾 空数组 不抛异常", 真)
    异常:
        检查("数组.取末尾 空数组 不抛异常", 假)
    结束

    // ===== 四、映射方法：删除不存在键 / 嵌套（规范 4.4）=====
    输出("===== 四、映射方法 边界 =====")
    学生信息 = {"姓名": "小明", "年龄": 18}
    // 删除 不存在键 不应抛、长度不变
    学生信息.删除("地址")
    检查("映射.删除 不存在键 长度不变", 学生信息.长度() == 2)
    // 嵌套值：数组作为值
    学生信息.插入("成绩表", [90, 85, 77])
    成绩 = 学生信息.获取("成绩表")
    检查("映射.插入 数组值 可取回[3]", 成绩[3] == 77)
    检查("映射.插入 数组值 取元素", 成绩[1] == 90)
    // 所有键/所有值 为数组类型
    检查("映射.所有键 返回数组类型", 类型(学生信息.所有键()) == "数组")
    检查("映射.所有值 返回数组类型", 类型(学生信息.所有值()) == "数组")

    // ===== 五、时间模块：格式化⇄解析 往返 + 固定日期分量（规范 5.4）=====
    输出("===== 五、时间模块 往返/固定 =====")
    固定戳 = 时间.解析("2026-08-18 12:30:45", "年-月-日 时:分:秒")
    检查("时间.解析 固定日期 返回整数", 类型(固定戳) == "整数")
    检查("时间.获取年 固定=2026", 时间.获取年(固定戳) == 2026)
    检查("时间.获取月 固定=8", 时间.获取月(固定戳) == 8)
    检查("时间.获取日 固定=18", 时间.获取日(固定戳) == 18)
    检查("时间.获取时 固定=12", 时间.获取时(固定戳) == 12)
    检查("时间.获取分 固定=30", 时间.获取分(固定戳) == 30)
    检查("时间.获取秒 固定=45", 时间.获取秒(固定戳) == 45)
    // 格式化 ⇄ 解析 往返一致
    回文本 = 时间.格式化("年-月-日 时:分:秒", 固定戳)
    回戳 = 时间.解析(回文本, "年-月-日 时:分:秒")
    检查("时间 格式化⇄解析 往返一致", 回戳 == 固定戳)
    // 加/减 0 = 恒等
    检查("时间.加(0)=恒等", 时间.加(固定戳, 0) == 固定戳)
    检查("时间.减(0)=恒等", 时间.减(固定戳, 0) == 固定戳)
    // 间隔天数 反向 = -1
    现在 = 时间.当前时间()
    明天 = 时间.加(现在, 86400)
    检查("时间.间隔天数 反向=-1", 时间.间隔天数(现在, 明天) == -1)
    // 当前毫秒时间 >= 当前时间*1000（同刻近似）
    检查("时间.当前毫秒时间 >= 当前时间*1000", 时间.当前毫秒时间() >= 现在 * 1000)

    // ===== 六、工具模块：嵌套解析 / 正则多组 / 确定性（规范 5.6）=====
    输出("===== 六、工具模块 往返/嵌套 =====")
    // 解析数据 嵌套 JSON（数组+映射）
    嵌套 = 工具.解析数据("JSON", "{\引号" + "列表" + "\引号 : [1, 2, 3], \引号" + "对象" + "\引号 : {\引号" + "甲" + "\引号 : 5}}")
    检查("工具.解析数据 嵌套返回映射", 类型(嵌套) == "映射")
    列表 = 嵌套.获取("列表")
    检查("工具.解析数据 嵌套取数组 长度=3", 列表.长度() == 3)
    检查("工具.解析数据 嵌套取数组[1]=1", 列表[1] == 1)
    对象 = 嵌套.获取("对象")
    检查("工具.解析数据 嵌套取对象.甲=5", 对象.获取("甲") == 5)
    // 生成数据⇄解析数据 映射往返
    源映射 = {"姓名": "张三", "年龄": 25, "城市": "北京"}
    往返 = 工具.解析数据("JSON", 工具.生成数据("JSON", 源映射))
    检查("工具.生成⇄解析 往返取姓名", 往返.获取("姓名") == "张三")
    检查("工具.生成⇄解析 往返取年龄", 往返.获取("年龄") == 25)
    // 正则匹配 多组
    多组 = 工具.正则匹配("[a-z]+", "ab12cd34ef")
    检查("工具.正则匹配 多组=3", 多组.长度() == 3)
    检查("工具.正则匹配[1]=ab", 多组[1] == "ab")
    // 正则替换 多组
    多替 = 工具.正则替换("[0-9]", "#", "a1b2c3")
    检查("工具.正则替换 多组全替换", 多替 == "a#b#c#")
    // 哈希 确定性
    检查("工具.哈希算法 MD5 确定性", 工具.哈希算法("MD5", "hello") == 工具.哈希算法("MD5", "hello"))
    检查("工具.哈希算法 SHA256 确定性", 工具.哈希算法("SHA256", "hello") == 工具.哈希算法("SHA256", "hello"))
    // 编码 确定性 + 往返
    编 = 工具.编码方案("BASE64", "你好，智语言")
    检查("工具.编码方案 BASE64 确定性", 编 == 工具.编码方案("BASE64", "你好，智语言"))
    检查("工具.解码方案 BASE64 往返", 工具.解码方案("BASE64", 编) == "你好，智语言")
    // 唯一编号 格式（36字符含连字符）
    编号 = 工具.唯一编号()
    检查("工具.唯一编号 标准UUID长度36", 编号.长度() == 36)

    // ===== 结果汇总 =====
    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
