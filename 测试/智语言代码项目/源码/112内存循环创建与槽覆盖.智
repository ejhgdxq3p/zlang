// 112 内存循环创建与槽覆盖（分层回收的"内存基线"守护用例）
// ══════════════════════════════════════════════════════════════════════════
// 场景：循环体内**反复创建**结构体/容器并**覆盖**同名槽 —— 这是内存增长的主要来源
//   （历史实测：30 万次迭代 99.4MB）。分层回收落地后，本用例须满足：
//   · 语义正确（累计值精确）——本用例断言；
//   · **存活槽位不随迭代增长** ——由 `内存对账门禁` 观测（同一用例报告存活/不可达）。
// ⇒ 本用例是"语义正确 + 内存可回收"两条判据的共同载体（双模均须一致）。
// ══════════════════════════════════════════════════════════════════════════
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 点:
    整数 横 = 0
    整数 纵 = 0
结束

结构体 轨迹:
    数组<点> 点列表 = []
结束

启动程序():
    输出("===== ① 循环内反复创建结构体 + 覆盖槽 =====")
    整数 累计 = 0
    整数 计数 = 1
    循环 计数 <= 200:
        点 临时 = 点()
        临时.横 = 计数
        临时.纵 = 计数 * 2
        累计 = 累计 + 临时.横 + 临时.纵
        计数 = 计数 + 1
    结束
    检查("200 轮累计 = 3 * (1+…+200) = 60300", 累计 == 60300)

    输出("===== ② 循环内反复创建容器（含嵌套）=====")
    整数 元素和 = 0
    整数 轮 = 1
    循环 轮 <= 100:
        数组<整数> 小列 = [轮, 轮 + 1]
        轨迹 小轨 = 轨迹()
        点 小点 = 点()
        小点.横 = 小列[1]
        小轨.点列表.追加(小点)
        元素和 = 元素和 + 小列[1] + 小列[2] + 小轨.点列表[1].横
        轮 = 轮 + 1
    结束
    检查("100 轮元素和 = 3*(1+…+100) + 100 = 15250", 元素和 == 15250)

    输出("===== ③ 循环内覆盖既有槽（旧值必须可回收且不影响新值）=====")
    车 = 点()
    车.横 = 1
    整数 最终 = 0
    整数 步 = 1
    循环 步 <= 50:
        车 = 点()
        车.横 = 步 * 10
        最终 = 最终 + 车.横
        步 = 步 + 1
    结束
    检查("50 轮覆盖后累计 = 10*(1+…+50) = 12750", 最终 == 12750)
    检查("覆盖后槽内为最后一轮的值", 车.横 == 500)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
