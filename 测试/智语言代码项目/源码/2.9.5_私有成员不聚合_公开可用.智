// 规范 §2.9.5：只聚合公开成员 —— 子模块的公开成员经聚合后全部可用
导入 聚合校验/默认聚合 展开

通过数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    结束
结束

启动程序():
    输出("===== §2.9.5 私有成员不聚合（公开成员可用） =====")

    检查("公开函数可用", 基础库.求平方(4) == 16)
    检查("公开变量可用", 基础库.公开变量 == 100)
    检查("公开常量可用", 基础库.公开常量 == 2.5)
    检查("公开结构体可用", 基础库.矩形(3, 3).面积() == 9)
    检查("公开枚举可用", 基础库.颜色.红 != 基础库.颜色.绿)

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
