通过数 = 0
失败数 = 0
总数 = 0
检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("FAILCASE " + 名称)
    结束
结束

结构体 矩形(小数 宽, 小数 高):
    小数 宽 = 宽
    小数 高 = 高

    取宽() 小数:
        返回 自身.宽
    结束

    取参数宽() 小数:
        返回 宽
    结束

    面积() 小数:
        返回 自身.宽 * 自身.高
    结束

    设置宽(小数 新宽):
        自身.宽 = 新宽
    结束
结束

测试_规范形态():
    甲 = 矩形(3.0, 4.0)
    检查("字段初值取自参数", 甲.取宽() == 3.0)
    检查("参数可直接读取（裸名）", 甲.取参数宽() == 3.0)
    检查("面积=12", 甲.面积() == 12.0)
    甲.设置宽(5.0)
    检查("字段可改", 甲.取宽() == 5.0)
    检查("字段改动不影响参数（隔离）", 甲.取参数宽() == 3.0)
结束

启动程序():
    测试_规范形态()
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
结束
