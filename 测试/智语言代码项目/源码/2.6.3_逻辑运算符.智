    检查("真或真", (真 或 真) == 真)
    检查("真或假", (真 或 假) == 真)
    检查("假或真", (假 或 真) == 真)
    检查("假或假", (假 或 假) == 假)
    检查("非真", (非 真) == 假)
    检查("非假", (非 假) == 真)

    数组 = [1, 2, 3, 4, 5]
    映射数据 = {"苹果": 1, "香蕉": 2}
    检查("属于-数组", 2 属于 数组)
    检查("不属于-数组", 10 不属于 数组)
