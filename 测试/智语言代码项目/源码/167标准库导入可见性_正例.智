// 规范依据：
//   §5 L10536「标准库…需要先导入再使用」（数学/文件/网络/时间/系统/工具/并发）；
//   §2.7.2 L7956-7960 三条访问通道表「前提」列：`模块名.成员()` 前提＝已 `导入 …`；
//   §2.7.3 L8082「展开只留裸名，子命名空间不能使用」；
//   §2.7.3 L8098「命名别名后原来的名字不可使用」；
//   §4 L9949「核心库…无需导入」（8 个全局函数 + 文本/数组/映射/异常错误 的内置方法）。
//   §2.7.5 同一模块不可重复导入 ⇒ 三种导入形态各用**不同**的标准库模块。
// 本用例：**合法写法全部可用**（F5 修复后的正例护栏，双模须一致通过）
导入 数学
导入 工具 别名 器
导入 时间 展开

通过数 = 0
总数 = 0

检查(文本 说明, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("✅ " + 说明)
    否则:
        输出("❌ " + 说明)
    结束
结束

启动程序():
    输出("===== F5 正例：标准库导入可见性 =====")

    // ① 基本导入：`模块名.成员` 可用（§2.7.3 L8062；常量形态同受管）
    检查("基本导入-函数", 数学.绝对值(-5) == 5)
    检查("基本导入-常量", 数学.圆周率 > 3)

    // ② 别名导入：`别名.成员` 可用，原名不可用（§2.7.3 L8098）
    检查("别名导入-函数", 器.正则匹配("[0-9]+", "ab12cd").长度() == 1)

    // ③ 展开导入：仅裸名可用，不能再带模块前缀（§2.7.3 L8082）
    检查("展开导入-裸名函数", 当前时间() > 0)

    // ④ 核心库免导入（不经模块前缀 ⇒ 不受 F5 闸门影响，§4 L9949）
    检查("核心库-全局函数", 类型(42) == "整数")
    甲 = [3, 1, 2]
    甲.追加(4)
    检查("核心库-数组方法", 甲.长度() == 4 且 甲.获取(1) == 3)
    检查("核心库-文本方法", "甲乙丙".长度() == 3)

    输出("===== 通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + " =====")
结束
