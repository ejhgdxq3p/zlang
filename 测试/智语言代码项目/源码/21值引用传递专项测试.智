// ============================================================
// 值传递 / 引用传递 专项全面测试（对照《智语言编程规范》§2.3.7 / §4.1）
// 覆盖：
//   1. 传值（默认）：整数/小数/文本/逻辑 修改不影响外部
//   2. 传值：结构体修改不影响外部
//   3. 传值：数组/映射修改不影响外部（值复制隔离）
//   4. 传引用（显式）：整数/结构体/数组/映射 修改影响外部
//   5. 传引用：函数内对参数重新赋值不影响原变量（仅别名局部）
//   6. 接口参数：引用语义作用于原实例
// 全部双模验证。
// ============================================================

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// 基本值类型
改转整数(整数 数据):
    数据 = 数据 + 100
结束

改转文本(文本 数据):
    数据 = "改"
结束

改整数引用(传引用 整数 数据):
    数据 = 数据 + 100
结束

// 结构体
结构体 盒子(文本 标签):
    整数 数量 = 0
    增加(整数 增量):
        自身.数量 = 自身.数量 + 增量
    结束
结束

改结构体(盒子 数据):
    数据.增加(50)
结束

改结构体引用(传引用 盒子 数据):
    数据.增加(50)
结束

// 容器
改数组(数组<整数> 数据):
    数据.追加(999)
结束

改数组引用(传引用 数组<整数> 数据):
    数据.追加(999)
结束

改映射(映射<文本, 整数> 数据):
    数据.插入("x", 999)
结束

改映射引用(传引用 映射<文本, 整数> 数据):
    数据.插入("x", 999)
结束

// 传引用后重新赋值（不影响原变量）
重赋值引用(传引用 数组<整数> 数据):
    数据 = [4, 5, 6]
结束

// 接口
接口 可计数:
    增加(整数 量):
    结束
    取数() 整数:
    结束
结束

结构体 计数器(整数 初始) 适配 可计数:
    整数 值 = 0
    增加(整数 量):
        自身.值 = 自身.值 + 量
    结束
    取数() 整数:
        返回 自身.值
    结束
    初始化():
        自身.值 = 初始
    结束
结束

改接口(可计数 设备, 整数 量) 整数:
    设备.增加(量)
    返回 0
结束

启动程序():
    输出("===== A. 传值：基本类型 =====")
    甲 = 10
    改转整数(甲)
    检查("整数传值：原地不变=10", 甲 == 10)

    文本乙 = "原"
    改转文本(文本乙)
    检查("文本传值：原地不变=原", 文本乙 == "原")

    输出("===== B. 传引用：基本类型 =====")
    丙 = 20
    改整数引用(丙)
    检查("整数传引用：原地被改=120", 丙 == 120)

    输出("===== C. 传值：结构体 =====")
    盒 = 盒子("A")
    盒.增加(5)
    改结构体(盒)
    检查("结构体传值：原地不变=5", 盒.数量 == 5)

    输出("===== D. 传引用：结构体 =====")
    盒2 = 盒子("B")
    盒2.增加(5)
    改结构体引用(盒2)
    检查("结构体传引用：原地被改=55", 盒2.数量 == 55)

    输出("===== E. 传值：数组 =====")
    列 = [1, 2, 3]
    改数组(列)
    检查("数组传值：原地长度不变=3", 列.长度() == 3)

    输出("===== F. 传引用：数组 =====")
    列2 = [1, 2, 3]
    改数组引用(列2)
    检查("数组传引用：原地被追加=4", 列2.长度() == 4)
    检查("数组传引用：新末位=999", 列2[4] == 999)

    输出("===== G. 传值：映射 =====")
    表 = {"a": 1}
    改映射(表)
    检查("映射传值：原地长度不变=1", 表.长度() == 1)

    输出("===== H. 传引用：映射 =====")
    表2 = {"a": 1}
    改映射引用(表2)
    // 映射传引用已修复（版本139）：存储类路径(映射存储)的COW写回改用 间接存储，修改顺着引用单元写回调用方变量。
    检查("映射传引用: 表2长度=2", 表2.长度() == 2)
    检查("映射传引用: 表2含新键x", 表2.是否包含("x"))
    检查("映射传引用: 表2[x]=999", 表2.获取("x") == 999)
    检查("映射传引用: 表2仍含原键a", 表2.是否包含("a"))

    输出("===== I. 传引用后函数内重新赋值不影响原变量 =====")
    原链 = [1, 2, 3]
    重赋值引用(原链)
    检查("传引用重赋值：原变量仍=3长度", 原链.长度() == 3)

    输出("===== J. 接口参数引用语义作用于原实例 =====")
    计 = 计数器(10)
    改接口(计, 5)
    检查("接口参数：原实例被改=15", 计.取数() == 15)

    输出("")
    输出("===== 结果汇总 =====")
    输出("总数：" + 转文本(本模块.总数) + "，通过：" + 转文本(本模块.通过数) + "，失败：" + 转文本(本模块.失败数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例")
    否则:
        输出("全部用例通过")
    结束
结束
