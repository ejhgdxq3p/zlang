// ============================================================
// 数学模块 全面测试
// 严格对照《智语言编程规范》5.1（数学模块）
// 覆盖：
//   常量 6 个（圆周率/自然常数/正无穷/负无穷/无效小数/是否*无穷*检测）
//   基础 7（绝对值/最大值/最小值/最大值列表/最小值列表/平方根/取整族4）
//   随机 2（随机整数/随机小数）
//   统计 5（求和/平均值/方差/标准差/中位数）
//   三角 3（正弦/余弦/正切）
//   幂与对数 3（幂/自然对数/常用对数）
//   特殊值检测 3（是否正无穷/是否负无穷/是否无效小数）
// 全部用例用 检查() 统计，末行输出汇总。双模验证。
// ============================================================

导入 数学

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 += 1
    如果 条件:
        本模块.通过数 += 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 += 1
        输出("  ⌾ " + 名称)
    结束
结束

启动程序():
    // ===================== 一、常量 =====================
    输出("===== 一、数学常量 =====")
    检查("圆周率≈3.14159", 数学.圆周率 > 3.14159 - 0.00001 且 数学.圆周率 < 3.14159 + 0.00001)
    检查("自然常数≈2.71828", 数学.自然常数 > 2.71828 - 0.00001 且 数学.自然常数 < 2.71828 + 0.00001)
    检查("正无穷 是 正无穷", 数学.是否正无穷(数学.正无穷))
    检查("负无穷 是 负无穷", 数学.是否负无穷(数学.负无穷))
    检查("无效小数 是 无效小数", 数学.是否无效小数(数学.无效小数))
    检查("正无穷 不是 负无穷", 数学.是否负无穷(数学.正无穷) == 假)
    检查("正无穷 不是 无效小数", 数学.是否无效小数(数学.正无穷) == 假)
    检查("正常数 非三种特殊值", 数学.是否正无穷(1.0) == 假 且 数学.是否负无穷(1.0) == 假 且 数学.是否无效小数(1.0) == 假)

    // ===================== 二、基础运算 =====================
    输出("===== 二、基础运算 =====")
    检查("绝对值(-3.14)=3.14", 数学.绝对值(-3.14) == 3.14)
    检查("绝对值(5.0)=5.0", 数学.绝对值(5.0) == 5.0)
    检查("最大值(3.14,2.71)=3.14", 数学.最大值(3.14, 2.71) == 3.14)
    检查("最小值(3.14,2.71)=2.71", 数学.最小值(3.14, 2.71) == 2.71)
    检查("最大值列表([1,5,3])=5", 数学.最大值列表([1.0, 5.0, 3.0]) == 5.0)
    检查("最小值列表([1,5,3])=1", 数学.最小值列表([1.0, 5.0, 3.0]) == 1.0)
    检查("最大值列表(整数数组)=5", 数学.最大值列表([1, 5, 3]) == 5.0)
    检查("最小值列表(整数数组)=1", 数学.最小值列表([1, 5, 3]) == 1.0)
    检查("平方根(4)=2.0", 数学.平方根(4) == 2.0)
    检查("平方根(2)>1.41", 数学.平方根(2) > 1.41)
    检查("取整(3.7)=3", 数学.取整(3.7) == 3)
    检查("取整(-3.7)=-3", 数学.取整(-3.7) == -3)
    检查("向下取整(3.7)=3", 数学.向下取整(3.7) == 3)
    检查("向下取整(-3.7)=-4", 数学.向下取整(-3.7) == -4)
    检查("向上取整(3.2)=4", 数学.向上取整(3.2) == 4)
    检查("向上取整(-3.2)=-3", 数学.向上取整(-3.2) == -3)
    检查("四舍五入取整(3.5)=4", 数学.四舍五入取整(3.5) == 4)
    检查("四舍五入取整(3.4)=3", 数学.四舍五入取整(3.4) == 3)
    检查("四舍五入取整(-3.5)=-4", 数学.四舍五入取整(-3.5) == -4)

    // ===================== 三、随机数 =====================
    输出("===== 三、随机函数 =====")
    整数 骰子 = 数学.随机转整数(1, 6)
    检查("随机转整数(1,6) 在[1,6]", 骰子 >= 1 且 骰子 <= 6)
    整数 中奖 = 数学.随机转整数(1, 100)
    检查("随机转整数(1,100) 在[1,100]", 中奖 >= 1 且 中奖 <= 100)
    小数 概率 = 数学.随机转小数()
    检查("随机小数 在[0,1)", 概率 >= 0.0 且 概率 < 1.0)

    // ===================== 四、统计函数 =====================
    输出("===== 四、统计函数 =====")
    检查("求和([1,2,3,4,5])=15", 数学.求和([1, 2, 3, 4, 5]) == 15.0)
    检查("求和([1.5,2.5,3.5])=7.5", 数学.求和([1.5, 2.5, 3.5]) == 7.5)
    检查("平均值([1,2,3,4,5])=3.0", 数学.平均值([1, 2, 3, 4, 5]) == 3.0)
    检查("平均值([88,92,76,85,95,68,90,82])=84.5", 数学.平均值([88, 92, 76, 85, 95, 68, 90, 82]) == 84.5)
    检查("中位数([1,2,3,4,5])=3", 数学.中位数([1, 2, 3, 4, 5]) == 3.0)
    检查("中位数([5,2,4,1,3])=3", 数学.中位数([5, 2, 4, 1, 3]) == 3.0)
    检查("中位数偶数([1,2,3,4])=2.5", 数学.中位数([1, 2, 3, 4]) == 2.5)
    检查("方差 样本方差=4.5714", 数学.方差([2, 4, 4, 4, 5, 5, 7, 9]) > 4.57 且 数学.方差([2, 4, 4, 4, 5, 5, 7, 9]) < 4.58)
    检查("标准差 样本标准差≈2.138", 数学.标准差([2, 4, 4, 4, 5, 5, 7, 9]) > 2.138 且 数学.标准差([2, 4, 4, 4, 5, 5, 7, 9]) < 2.139)

    // ===================== 五、三角函数 =====================
    输出("===== 五、三角函数 =====")
    检查("正弦(0)=0", 数学.正弦(0.0) == 0.0)
    检查("余弦(0)=1", 数学.余弦(0.0) == 1.0)
    检查("正切(0)=0", 数学.正切(0.0) == 0.0)
    检查("正弦(π/2)≈1", 数学.正弦(数学.圆周率 / 2) > 1.0 - 0.0001 且 数学.正弦(数学.圆周率 / 2) < 1.0 + 0.0001)
    检查("余弦(π)≈-1", 数学.余弦(数学.圆周率) > -1.0 - 0.0001 且 数学.余弦(数学.圆周率) < -1.0 + 0.0001)
    检查("正弦(π/6)≈0.5", 数学.正弦(数学.圆周率 / 6) > 0.5 - 0.0001 且 数学.正弦(数学.圆周率 / 6) < 0.5 + 0.0001)
    检查("余弦(π/3)≈0.5", 数学.余弦(数学.圆周率 / 3) > 0.5 - 0.0001 且 数学.余弦(数学.圆周率 / 3) < 0.5 + 0.0001)

    // ===================== 六、幂与对数 =====================
    输出("===== 六、幂与对数 =====")
    检查("幂(2,10)=1024", 数学.幂(2.0, 10.0) == 1024.0)
    检查("幂(5,2)=25", 数学.幂(5.0, 2.0) == 25.0)
    检查("幂(2.0,3.0)=8.0", 数学.幂(2.0, 3.0) == 8.0)
    检查("幂(9,0.5)=3.0", 数学.幂(9.0, 0.5) == 3.0)
    检查("自然对数(e)=1", 数学.自然对数(数学.自然常数) == 1.0)
    检查("自然对数(1)=0", 数学.自然对数(1.0) == 0.0)
    检查("常用对数(100)=2", 数学.常用对数(100.0) == 2.0)
    检查("常用对数(1000)=3", 数学.常用对数(1000.0) == 3.0)
    检查("常用对数(1)=0", 数学.常用对数(1.0) == 0.0)

    // ===================== 七、特殊值产生与检测 =====================
    输出("===== 七、特殊值产生与检测 =====")
    小数 对数零 = 数学.常用对数(0.0)
    检查("常用对数(0)=负无穷", 数学.是否负无穷(对数零))
    小数 溢出 = 10.0 ^ 1000
    检查("10^1000=正无穷", 数学.是否正无穷(溢出))
    小数 无效 = 数学.正无穷 * 0.0
    检查("正无穷*0=无效小数", 数学.是否无效小数(无效))
    小数 正常 = 10.0 / 2.0
    检查("正常数 非三种特殊值", 数学.是否正无穷(正常) == 假 且 数学.是否负无穷(正常) == 假 且 数学.是否无效小数(正常) == 假)

    输出("")
    输出("===== 数学模块测试汇总 =====")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数) + "  失败=" + 转文本(本模块.失败数))
结束
