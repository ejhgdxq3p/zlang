// 覆盖《智语言编程规范》§2.4.2「映射」：
//   键不重复；键类型与值类型可多类型（映射<文本|整数, 整数>）；
//   方法表：长度/所有键/所有值/插入（新增或更新）/删除/是否包含/获取（缺键返回空值）/清空；
//   遍历：`循环 键, 值 遍历 映射`
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 255 映射方法矩阵（§2.4.2）===")

    学生信息 = {"姓名": "小明", "年龄": 18, "班级": "高一(1)班"}
    检查("长度()", 学生信息.长度() == 3)

    // 所有键 / 所有值
    键列 = 学生信息.所有键()
    值列 = 学生信息.所有值()
    检查("所有键数量", 键列.长度() == 3)
    检查("所有值数量", 值列.长度() == 3)
    检查("所有键元素为键类型", 键列.是否包含("姓名") == 真)
    检查("所有值元素为值类型", 值列.是否包含("小明") == 真)

    // 插入（新增）/ 插入（更新）
    学生信息.插入("成绩", 92)
    检查("插入新键后长度 4", 学生信息.长度() == 4)
    学生信息.插入("年龄", 19)
    检查("插入已有键 → 更新值", 学生信息.获取("年龄") == 19)
    检查("更新不增加长度", 学生信息.长度() == 4)

    // 是否包含 / 获取
    检查("是否包含（存在）", 学生信息.是否包含("姓名") == 真)
    检查("是否包含（不存在）", 学生信息.是否包含("地址") == 假)
    检查("获取已有键", 学生信息.获取("姓名") == "小明")
    缺项 = 学生信息.获取("地址")
    检查("获取缺失键返回空值", (缺项 == 空值) == 真)

    // 删除
    学生信息.删除("班级")
    检查("删除后长度 3", 学生信息.长度() == 3)
    检查("删除后不再包含", 学生信息.是否包含("班级") == 假)

    // 多类型键/值约束：映射<文本|整数, 整数>
    映射<文本|整数, 整数> 数据 = {}
    数据.插入("文本键", 1)
    数据.插入(7, 2)
    检查("多类型键-长度 2", 数据.长度() == 2)
    检查("多类型键-文本键取值", 数据.获取("文本键") == 1)
    检查("多类型键-整数键取值", 数据.获取(7) == 2)

    // 遍历键值对
    遍历个数 = 0
    见过姓名 = 假
    循环 键, 值 遍历 学生信息:
        遍历个数 = 遍历个数 + 1
        如果 键 == "姓名":
            见过姓名 = 值 == "小明"
        结束
    结束
    检查("遍历键值对计数", 遍历个数 == 学生信息.长度())
    检查("遍历可取到键对应值", 见过姓名 == 真)

    // 清空
    数据.清空()
    检查("清空后长度 0", 数据.长度() == 0)

    收尾()
结束
