// §4.4 映射方法完整矩阵（8 个方法 + 键身份 + 插入序 + 值语义）
// 依据：规范 §4.4 方法表（是否包含仅检查键、获取缺失返回空值）
// 规范未定义的情形（删除不存在的键、键为空值）单独「记录」，不判失败。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

记录(文本 名称, 文本 实际):
    输出("  ℹ " + 名称 + " = [" + 实际 + "]")
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束

启动程序():
    输出("=== 04 映射方法完整矩阵 ===")

    // ───────── 长度 / 空映射 ─────────
    空映射 = {}
    检查("长度-空映射", 空映射.长度() == 0)
    学生 = {"姓名": "小明", "年龄": 18, "班级": "高一(1)班"}
    检查("长度-三键", 学生.长度() == 3)

    // ───────── 所有键 / 所有值（插入序）─────────
    键列表 = 学生.所有键()
    检查("所有键-数量", 键列表.长度() == 3)
    检查("所有键-顺序保持插入序", 键列表[1] == "姓名" 且 键列表[2] == "年龄" 且 键列表[3] == "班级")
    值列表 = 学生.所有值()
    检查("所有值-数量", 值列表.长度() == 3)
    检查("所有值-顺序与键对应", 值列表[1] == "小明" 且 值列表[2] == 18 且 值列表[3] == "高一(1)班")
    检查("所有键-空映射", 空映射.所有键().长度() == 0)
    检查("所有值-空映射", 空映射.所有值().长度() == 0)

    // ───────── 插入（新键追加末尾；旧键原位置更新）─────────
    学生.插入("成绩", 92)
    检查("插入-新键长度加一", 学生.长度() == 4)
    检查("插入-新键在末尾", 学生.所有键()[4] == "成绩")
    学生.插入("年龄", 19)
    检查("插入-更新旧键长度不变", 学生.长度() == 4)
    检查("插入-更新旧键取到新值", 学生.获取("年龄") == 19)
    检查("插入-更新不改变键顺序", 学生.所有键()[2] == "年龄")
    学生.插入("姓名", "小红")
    检查("插入-更新首键仍居首", 学生.所有键()[1] == "姓名" 且 学生.获取("姓名") == "小红")

    // ───────── 删除 ─────────
    学生.删除("班级")
    检查("删除-长度减一", 学生.长度() == 3)
    检查("删除-键已不存在", 学生.是否包含("班级") == 假)
    检查("删除-其余键顺序保持", 学生.所有键()[1] == "姓名" 且 学生.所有键()[2] == "年龄")
    检查("删除-剩余值可正常获取", 学生.获取("成绩") == 92)
    长度前 = 学生.长度()
    学生.删除("不存在的键")
    检查("删除-不存在键不改变长度", 学生.长度() == 长度前)
    记录("删除不存在键 的实际处置", "已记录：未抛异常、长度不变")

    // ───────── 是否包含（仅检查键）─────────
    样本 = {"甲": 1, "乙": 2}
    检查("是否包含-命中键", 样本.是否包含("甲") == 真)
    检查("是否包含-未命中键", 样本.是否包含("丙") == 假)
    检查("是否包含-只查键不查值", 样本.是否包含(1) == 假)
    检查("是否包含-空映射", 空映射.是否包含("甲") == 假)

    // ───────── 获取（缺失返回空值；安全）─────────
    检查("获取-命中", 样本.获取("甲") == 1)
    检查("获取-缺失返回空值", 样本.获取("丙") == 空值)
    检查("获取-空映射返回空值", 空映射.获取("甲") == 空值)
    检查("获取-值本身为空值仍可区分（缺失=空值）", 样本.获取("乙") == 2)

    // ───────── 下标访问（缺失抛异常）─────────
    检查("下标-读取命中", 样本["甲"] == 1)
    样本["甲"] = 10
    检查("下标-写入", 样本["甲"] == 10)
    样本["丙"] = 3
    检查("下标-写入新键", 样本.长度() == 3 且 样本.获取("丙") == 3)
    捕获:
        缺失 = 样本["不存在"]
        检查("下标-缺失键应抛异常", 假)
    异常:
        检查("下标-缺失键抛异常", 真)
    结束

    // ───────── 清空 ─────────
    清空样本 = {"甲": 1, "乙": 2}
    清空样本.清空()
    检查("清空-长度归零", 清空样本.长度() == 0)
    检查("清空-取键返回空值", 清空样本.获取("甲") == 空值)
    清空样本.插入("丙", 3)
    检查("清空-可再次插入", 清空样本.长度() == 1)

    // ───────── 键身份与键类型 ─────────
    整数键 = {1: "一", 2: "二"}
    检查("整数键-取回", 整数键.获取(1) == "一")
    检查("整数键-长度", 整数键.长度() == 2)
    小数键 = {1.0: "一"}
    检查("键身份-1.0 与 1 同一键", 小数键.获取(1) == "一")
    混合键 = {1: "整数键"}
    检查("键身份-整数键用小数取回", 混合键.获取(1.0) == "整数键")
    逻辑键 = {真: "是", 假: "否"}
    检查("逻辑键-取真", 逻辑键.获取(真) == "是")
    检查("逻辑键-取假", 逻辑键.获取(假) == "否")
    检查("逻辑键-长度", 逻辑键.长度() == 2)

    // ───────── 值语义（赋值复制，互不影响）─────────
    原映射 = {"甲": 1}
    副本 = 原映射
    副本.插入("乙", 2)
    检查("值语义-副本插入不影响原映射", 原映射.长度() == 1)
    检查("值语义-副本自身已变", 副本.长度() == 2)
    副本["甲"] = 99
    检查("值语义-副本改写不影响原值", 原映射.获取("甲") == 1)

    // ───────── 嵌套映射与遍历 ─────────
    嵌套 = {"外层": {"内层": 42}, "列表": [1, 2]}
    检查("嵌套-取内层值", 嵌套.获取("外层").获取("内层") == 42)
    检查("嵌套-取列表长度", 嵌套.获取("列表").长度() == 2)
    键序 = ""
    循环 键, 值 遍历 样本:
        键序 = 键序 + 键
    结束
    检查("遍历-按插入序（甲、乙、丙）", 键序 == "甲乙丙")

    收尾()
结束
