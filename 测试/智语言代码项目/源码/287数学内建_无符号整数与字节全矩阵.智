// 《智语言编程规范》§5.1.14 无符号整数 + §5.1.15 字节 —— 全方法矩阵（双模）
// 无符号整数：0 ~ 2^64-1，溢出/下溢抛异常不静默回绕，转整数按位模式。
// 字节：0 ~ 255，算术越界抛异常，转字符按 Unicode 码点，多字节字符构造抛异常。
导入 数学

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 287 无符号整数与字节全方法矩阵（§5.1.14 / §5.1.15）===")

    // ══════════ 无符号整数 ══════════
    输出("-- 无符号整数：构造与显示 --")
    相等文本("整数构造 4294967295", 数学.无符号整数(4294967295).转文本(), "4294967295")
    相等文本("文本构造最大值", 数学.无符号整数("18446744073709551615").转文本(), "18446744073709551615")
    相等文本("规范示例 4294967295+1", (数学.无符号整数(4294967295) + 数学.无符号整数(1)).转文本(), "4294967296")
    检查("类型(无符号整数) = 无符号整数", 类型(数学.无符号整数(1)) == "无符号整数")

    输出("-- 无符号整数：算术 --")
    相等文本("加法", (数学.无符号整数(10) + 数学.无符号整数(5)).转文本(), "15")
    相等文本("减法", (数学.无符号整数(10) - 数学.无符号整数(4)).转文本(), "6")
    相等文本("乘法", (数学.无符号整数(1000000) * 数学.无符号整数(1000000)).转文本(), "1000000000000")
    相等文本("除法 10/3 = 3", (数学.无符号整数(10) / 数学.无符号整数(3)).转文本(), "3")
    相等文本("整除 10 %% 3 = 3（商，向下取整）", (数学.无符号整数(10) %% 数学.无符号整数(3)).转文本(), "3")
    相等文本("取余 10%3 = 1", (数学.无符号整数(10) % 数学.无符号整数(3)).转文本(), "1")
    相等文本("与整数混合加", (数学.无符号整数(10) + 5).转文本(), "15")
    相等文本("与整数混合乘", (数学.无符号整数(10) * 3).转文本(), "30")

    输出("-- 无符号整数：位运算（按无符号位模式）--")
    相等文本("位与 12 & 10 = 8", (数学.无符号整数(12) & 数学.无符号整数(10)).转文本(), "8")
    相等文本("位或 12 | 10 = 14", (数学.无符号整数(12) | 数学.无符号整数(10)).转文本(), "14")
    相等文本("异或 12 ~| 10 = 6", (数学.无符号整数(12) ~| 数学.无符号整数(10)).转文本(), "6")
    相等文本("位非 0 = 2^64-1", (~数学.无符号整数(0)).转文本(), "18446744073709551615")
    相等文本("位非 12", (~数学.无符号整数(12)).转文本(), "18446744073709551603")
    相等文本("左移 1 << 8 = 256", (数学.无符号整数(1) << 8).转文本(), "256")
    相等文本("逻辑右移 2^63 >> 63 = 1", (数学.无符号整数("9223372036854775808") >> 63).转文本(), "1")
    相等文本("最大右移 60", (数学.无符号整数("18446744073709551615") >> 60).转文本(), "15")

    输出("-- 无符号整数：判定/比较/转换 --")
    检查("0 是否为零", 数学.无符号整数(0).是否为零() == 真)
    检查("1 是否为零（假）", 数学.无符号整数(1).是否为零() == 假)
    检查("等于", 数学.无符号整数(5) == 数学.无符号整数(5))
    检查("不等于", 数学.无符号整数(5) != 数学.无符号整数(4))
    检查("大于", 数学.无符号整数(5) > 数学.无符号整数(4))
    检查("小于", 数学.无符号整数(4) < 数学.无符号整数(5))
    检查("大于等于", 数学.无符号整数(5) >= 数学.无符号整数(5))
    检查("小于等于", 数学.无符号整数(5) <= 数学.无符号整数(5))
    检查("大数比较（超出 i64）", 数学.无符号整数("18446744073709551615") > 数学.无符号整数("9223372036854775807"))
    检查("转整数最大值 = -1（按位模式）", 数学.无符号整数("18446744073709551615").转整数() == (0 - 1))
    检查("转整数 2^63 = i64 最小值", 数学.无符号整数("9223372036854775808").转整数() == (0 - 9223372036854775807 - 1))

    输出("-- 无符号整数：复合赋值（F53 护栏）--")
    无甲 = 数学.无符号整数(10)
    无甲 += 数学.无符号整数(5)
    相等文本("+= 生效", 无甲.转文本(), "15")
    无甲 -= 数学.无符号整数(3)
    相等文本("-= 生效", 无甲.转文本(), "12")
    无甲 *= 数学.无符号整数(2)
    相等文本("*= 生效", 无甲.转文本(), "24")
    无甲 /= 数学.无符号整数(5)
    相等文本("/= 生效", 无甲.转文本(), "4")
    无甲 %= 数学.无符号整数(3)
    相等文本("%= 生效", 无甲.转文本(), "1")
    无甲 <<= 4
    相等文本("<<= 生效", 无甲.转文本(), "16")
    无甲 >>= 2
    相等文本(">>= 生效", 无甲.转文本(), "4")
    无乙 = 数学.无符号整数(12)
    无乙 &= 数学.无符号整数(10)
    相等文本("&= 生效", 无乙.转文本(), "8")
    无乙 |= 数学.无符号整数(3)
    相等文本("|= 生效", 无乙.转文本(), "11")
    无乙 ~|= 数学.无符号整数(1)
    相等文本("~|= 生效", 无乙.转文本(), "10")
    无丙 = 数学.无符号整数(10)
    无丙 %%= 数学.无符号整数(3)
    相等文本("%%= 生效", 无丙.转文本(), "3")
    检查("%%= 结果仍为无符号整数（§5.1.14 表）", 类型(无丙) == "无符号整数")

    输出("-- 无符号整数：异常（规则 2/3/5）--")
    捕获:
        负数 = 数学.无符号整数(0 - 1)
        检查("负数构造必须抛异常", 假)
    异常:
        检查("负数构造异常类型为无符号整数错误", 异常错误().类型 == "无符号整数错误")
    结束
    捕获:
        非法 = 数学.无符号整数("abc")
        检查("非法文本必须抛异常", 假)
    异常:
        检查("非法文本异常类型为无符号整数错误", 异常错误().类型 == "无符号整数错误")
    结束
    捕获:
        下溢 = 数学.无符号整数(0) - 数学.无符号整数(1)
        检查("下溢必须抛异常（不回绕）", 假)
    异常:
        检查("下溢异常类型为无符号整数错误", 异常错误().类型 == "无符号整数错误")
    结束
    捕获:
        上溢 = 数学.无符号整数("18446744073709551615") + 数学.无符号整数(1)
        检查("上溢必须抛异常（不回绕）", 假)
    异常:
        检查("上溢异常类型为无符号整数错误", 异常错误().类型 == "无符号整数错误")
    结束
    捕获:
        零除 = 数学.无符号整数(1) / 数学.无符号整数(0)
        检查("除零必须抛异常", 假)
    异常:
        检查("除零抛异常", 异常错误().描述.是否包含("除数不能为零"))
    结束
    捕获:
        混负 = 数学.无符号整数(10) + (0 - 5)
        检查("与负整数混合必须抛异常（规则 5）", 假)
    异常:
        检查("与负整数混合抛异常", 异常错误().描述.是否包含("不能为负"))
    结束
    捕获:
        混小数 = 数学.无符号整数(10) + 1.5
        检查("与普通小数混合必须抛异常（规则 5）", 假)
    异常:
        检查("与普通小数混合抛异常", 异常错误().类型 == "无符号整数错误")
    结束

    // ══════════ 字节 ══════════
    输出("-- 字节：构造与显示 --")
    相等文本("整数构造 65", 数学.字节(65).转文本(), "65")
    相等文本("规范示例 字节(B) = 66", 数学.字节("B").转文本(), "66")
    相等文本("字节(A) = 65", 数学.字节("A").转文本(), "65")
    相等文本("数字文本构造 200", 数学.字节("200").转文本(), "200")
    相等文本("边界 0", 数学.字节(0).转文本(), "0")
    相等文本("边界 255", 数学.字节(255).转文本(), "255")
    检查("类型(字节) = 字节", 类型(数学.字节(1)) == "字节")

    输出("-- 字节：算术（0~255，越界抛异常）--")
    相等文本("规范示例 65 + 66 = 131", (数学.字节(65) + 数学.字节(66)).转文本(), "131")
    相等文本("200 + 55 = 255（上界）", (数学.字节(200) + 55).转文本(), "255")
    相等文本("255 - 255 = 0", (数学.字节(255) - 数学.字节(255)).转文本(), "0")
    相等文本("10 * 20 = 200", (数学.字节(10) * 数学.字节(20)).转文本(), "200")
    相等文本("200 / 3 = 66", (数学.字节(200) / 数学.字节(3)).转文本(), "66")
    相等文本("200 %% 3 = 66（商，向下取整）", (数学.字节(200) %% 数学.字节(3)).转文本(), "66")
    相等文本("200 % 3 = 2", (数学.字节(200) % 数学.字节(3)).转文本(), "2")
    相等文本("与整数混合加", (数学.字节(200) + 55).转文本(), "255")

    输出("-- 字节：位运算（8 位）--")
    相等文本("位与 12 & 10 = 8", (数学.字节(12) & 数学.字节(10)).转文本(), "8")
    相等文本("位或 12 | 10 = 14", (数学.字节(12) | 数学.字节(10)).转文本(), "14")
    相等文本("异或 12 ~| 10 = 6", (数学.字节(12) ~| 数学.字节(10)).转文本(), "6")
    相等文本("位非 0 = 255", (~数学.字节(0)).转文本(), "255")
    相等文本("位非 12 = 243", (~数学.字节(12)).转文本(), "243")
    相等文本("左移 1 << 4 = 16", (数学.字节(1) << 4).转文本(), "16")
    相等文本("右移 200 >> 3 = 25", (数学.字节(200) >> 3).转文本(), "25")

    输出("-- 字节：判定/比较/转换 --")
    检查("0 是否为零", 数学.字节(0).是否为零() == 真)
    检查("1 是否为零（假）", 数学.字节(1).是否为零() == 假)
    检查("等于", 数学.字节(5) == 数学.字节(5))
    检查("不等于", 数学.字节(5) != 数学.字节(4))
    检查("大于", 数学.字节(5) > 数学.字节(4))
    检查("小于", 数学.字节(4) < 数学.字节(5))
    检查("大于等于", 数学.字节(5) >= 数学.字节(5))
    检查("小于等于", 数学.字节(5) <= 数学.字节(5))
    检查("转整数 255", 数学.字节(255).转整数() == 255)
    相等文本("转字符 97 = a", 数学.字节(97).转字符(), "a")
    相等文本("转字符 65 = A", 数学.字节(65).转字符(), "A")
    检查("转字符 0 长度为 1", 数学.字节(0).转字符().长度() == 1)
    检查("转字符 255 长度为 1", 数学.字节(255).转字符().长度() == 1)

    输出("-- 字节：复合赋值（F53 护栏）--")
    字节甲 = 数学.字节(200)
    字节甲 += 数学.字节(50)
    相等文本("+= 生效", 字节甲.转文本(), "250")
    字节甲 -= 数学.字节(100)
    相等文本("-= 生效", 字节甲.转文本(), "150")
    字节甲 *= 数学.字节(1)
    相等文本("*= 生效", 字节甲.转文本(), "150")
    字节甲 /= 数学.字节(2)
    相等文本("/= 生效", 字节甲.转文本(), "75")
    字节甲 %= 数学.字节(7)
    相等文本("%= 生效", 字节甲.转文本(), "5")
    字节甲 <<= 2
    相等文本("<<= 生效", 字节甲.转文本(), "20")
    字节甲 >>= 1
    相等文本(">>= 生效", 字节甲.转文本(), "10")
    字节乙 = 数学.字节(12)
    字节乙 &= 数学.字节(10)
    相等文本("&= 生效", 字节乙.转文本(), "8")
    字节乙 |= 数学.字节(3)
    相等文本("|= 生效", 字节乙.转文本(), "11")
    字节乙 ~|= 数学.字节(1)
    相等文本("~|= 生效", 字节乙.转文本(), "10")
    字节丙 = 数学.字节(10)
    字节丙 %%= 数学.字节(3)
    相等文本("%%= 生效", 字节丙.转文本(), "3")
    检查("%%= 结果仍为字节（§5.1.15 表）", 类型(字节丙) == "字节")

    输出("-- 字节：异常（规则 1/2/3/5）--")
    捕获:
        过界 = 数学.字节(256)
        检查("256 构造必须抛异常", 假)
    异常:
        检查("256 构造异常类型为字节错误", 异常错误().类型 == "字节错误")
    结束
    捕获:
        负数 = 数学.字节(0 - 1)
        检查("-1 构造必须抛异常", 假)
    异常:
        检查("-1 构造异常类型为字节错误", 异常错误().类型 == "字节错误")
    结束
    捕获:
        多字节 = 数学.字节("甲乙")
        检查("多字节字符必须抛异常", 假)
    异常:
        检查("多字节字符异常类型为字节错误", 异常错误().类型 == "字节错误")
    结束
    捕获:
        非法 = 数学.字节("abc")
        检查("非法文本必须抛异常", 假)
    异常:
        检查("非法文本异常类型为字节错误", 异常错误().类型 == "字节错误")
    结束
    捕获:
        下溢 = 数学.字节(0) - 数学.字节(1)
        检查("下溢必须抛异常", 假)
    异常:
        检查("下溢异常类型为字节错误", 异常错误().类型 == "字节错误")
    结束
    捕获:
        上溢 = 数学.字节(200) + 数学.字节(100)
        检查("上溢必须抛异常", 假)
    异常:
        检查("上溢异常类型为字节错误", 异常错误().类型 == "字节错误")
    结束
    捕获:
        混过界 = 数学.字节(10) + 300
        检查("与超界整数混合必须抛异常（规则 5）", 假)
    异常:
        检查("与超界整数混合抛异常", 异常错误().类型 == "字节错误")
    结束
    捕获:
        混小数 = 数学.字节(10) + 1.5
        检查("与普通小数混合必须抛异常（规则 5）", 假)
    异常:
        检查("与普通小数混合抛异常", 异常错误().类型 == "字节错误")
    结束

    收尾()
结束
