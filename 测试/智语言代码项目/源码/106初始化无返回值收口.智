// 正向回归（2026-09-21 · A2 收口）：**初始化 = 普通方法，无返回值；实例由创建表达式产出。**
//
//   规范依据：§2.4 初始化方法由编译器自动调用、**不能写返回类型**，可使用**无值 `返回`** 提前退出。
//
//   历史（A2 机制，已彻底删除）：语义层曾在其函数体**末尾隐式追加 `返回 自身`**、并把返回类型设为结构体；
//   降级层在构造处把该返回值**加载回实例句柄**（"持久化"）；双后端还把初始化方法内的无值 `返回`
//   特判改写为 `返回 自身`。其唯一目的 = 让 **COW 分离产生的新句柄** 能回到构造处。
//
//   COW 退役后（值语义隔离由降级层「存储即深拷贝」构造性承担：写入一律原地、句柄恒不变）
//   ⇒ 上述"持久化"是**恒等冗余**、无值 `返回` 也无需特判 ⇒ **A2 及其配套（`当前函数为初始化方法`
//   开关、编译器后端设置点）全部删除**，初始化与普通函数**完全同源**（单源：`返回语句(None)` 仅一条路径）。
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

// ① 含「提前 返回」（无值）的初始化
结构体 账户(文本 名, 整数 余额):
    文本 户名
    整数 存款 = 0
    初始化():
        如果 余额 < 0:
            自身.户名 = "早退"
            自身.存款 = 0
            返回
        结束
        自身.户名 = 名
        自身.存款 = 余额
    结束
    取户名() 文本:
        返回 自身.户名
    结束
    取存款() 整数:
        返回 自身.存款
    结束
结束

// ② 无用户初始化（走**合成初始化**路径）：构造参数与字段同名 ⇒ 写入字段
结构体 点(整数 横坐标, 整数 纵坐标):
    整数 横坐标 = 0
    整数 纵坐标 = 0
结束

// ③ 初始化内嵌套字段调用用户变异方法（原 ④ 限制，现与普通方法同源）
结构体 内件():
    文本 名 = "默认"
    设名(文本 新名):
        自身.名 = 新名
    结束
    取名() 文本:
        返回 自身.名
    结束
结束

结构体 外件():
    内件 部件 = 内件()
    初始化():
        自身.部件.设名("初始化设")
    结束
结束

启动程序():
    // ① 正常路径
    甲 = 账户("张三", 100)
    检查("正常路径-户名", 甲.取户名() == "张三")
    检查("正常路径-存款", 甲.取存款() == 100)

    // ② 提前返回：实例由创建表达式完好产出（不因无返回值而变空值/崩溃）
    乙 = 账户("李四", -5)
    检查("提前返回-实例可用", 乙.取存款() == 0)
    检查("提前返回-早退前写入的字段生效", 乙.取户名() == "早退")

    // ③ 合成初始化（无用户初始化）
    丙 = 点(3, 4)
    检查("合成初始化-横坐标", 丙.横坐标 == 3)
    检查("合成初始化-纵坐标", 丙.纵坐标 == 4)

    // ④ 初始化内嵌套字段调用用户变异方法
    丁 = 外件()
    检查("初始化内嵌套调用", 丁.部件.取名() == "初始化设")

    // ⑤ 初始化后实例可继续被方法修改（句柄稳定）
    戊 = 账户("王五", 10)
    戊.取存款()
    检查("构造后状态稳定", 戊.取户名() == "王五")

    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
