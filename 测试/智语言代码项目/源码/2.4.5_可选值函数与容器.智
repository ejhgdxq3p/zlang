查找用户(整数 编号) 任意<文本|空值>:
    如果 编号 == 1:
        返回 "张三"
    否则:
        返回 空值
    结束
结束

测试_可选值():
    结果 = 查找用户(1)
    如果 结果 != 空值:
        检查("找到用户", 转文本(结果) == "张三")
    否则:
        检查("找到用户", 假)
    结束
    无 = 查找用户(3)
    检查("未找到 ⇒ 空值", 无 == 空值)
结束

测试_容器():
    学生成绩 = {"小明": 95, "小红": 88}
    成绩 = 学生成绩.获取("小刚")
    检查("缺键 ⇒ 空值", 成绩 == 空值)
    任意<整数|空值> 查询结果 = 学生成绩.获取("小明")
    如果 查询结果 != 空值:
        检查("可空承接 + 转换", 转文本(查询结果) == "95")
    否则:
        检查("可空承接 + 转换", 假)
    结束
    命中 = 学生成绩.获取("小明")
    如果 命中 != 空值:
        检查("命中键分支", 转文本(命中) == "95")
    否则:
        检查("命中键分支", 假)
    结束
结束

启动程序():
    测试_可选值()
    测试_容器()
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
