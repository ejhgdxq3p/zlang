// 文件: 40不同库同名模块别名导入测试.智
// 职责: 验证用户结论——
//   ① 可以导入【不同库】中【模块名相同】的模块（库甲/工具箱 与 库乙/工具箱 同名）；
//   ② 同名模块必须用【别名】区分，否则命名冲突；
//   ③ 重复导入【同一库】的【同一模块】是严禁的（见 41重复导入报错测试.智）。
// 本文件验证 ①②：通过别名前缀访问两个不同库的同名模块，**函数与全局变量都互不干扰**。
// [2026-09-28 A3 修复] 全局变量此前会被后导入的库覆盖（函数因带模块前缀而正常）；现按模块身份归属，别名 = 视图 ⇒ 真正隔离。

导入 库甲/工具箱 别名 甲工具
导入 库乙/工具箱 别名 乙工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

启动程序():
    输出("===== 不同库同名模块（别名区分） =====")

    // 同名函数 加法：甲+乙定义不同，验证别名隔离生效（按模块命名空间分派）
    检查("甲工具.加法(1,2)=3", 甲工具.加法(1, 2) == 3)
    检查("乙工具.加法(1,2)=1003", 乙工具.加法(1, 2) == 1003)

    // 同名函数 打招呼：内容不同，验证别名隔离生效
    检查("甲工具.打招呼", 甲工具.打招呼("张三") == "【库甲】你好，张三")
    检查("乙工具.打招呼", 乙工具.打招呼("张三") == "【库乙】你好，张三")

    // ★ A3 修复后（2026-09-28）：同名模块的**全局变量**也必须被别名正确隔离，与函数同一口径。
    //   【修前实测】两个 `来源标识` 塌进同一全局槽（降级层「任意前缀 → 裸名」兜底）；
    //     解释模式恒为「先导入胜（库甲）」、编译模式为「后导入覆盖（库乙）」，
    //     F20 修复前编译模式甚至**每次重新编译随机**（4×库甲 / 4×库乙）。
    //   【修后模型】成员按**模块身份**归属，别名只是访问视图 —— 与方法/函数一致
    //     （Go 同名包必须别名后完全隔离 / Python module 各自 `__dict__` / C++ namespace）。
    //   ⇒ 故此处由「如实记录」升级为**精确断言**（旧记录型分支会把偏差固化成基线 ✗）。
    检查("甲工具.来源标识 = 库甲", 甲工具.来源标识 == "库甲")
    检查("乙工具.来源标识 = 库乙", 乙工具.来源标识 == "库乙")
    检查("甲工具.版本号 = 1", 甲工具.版本号 == 1)
    检查("乙工具.版本号 = 2", 乙工具.版本号 == 2)
    检查("两库同名全局变量互不相等", 甲工具.来源标识 != 乙工具.来源标识)

    输出("结果：通过 " + 转文本(本模块.通过数) + " / 总数 " + 转文本(本模块.总数) + " / 失败 " + 转文本(本模块.失败数))
结束
