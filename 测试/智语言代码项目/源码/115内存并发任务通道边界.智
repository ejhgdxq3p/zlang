// 115 内存并发任务通道边界（内存管理专项：并发维度）
// ══════════════════════════════════════════════════════════════════════════
// 目的：把**并发**纳入内存管理验收（此前并发只有功能用例，无内存观测）。
// 覆盖（全部为**百轮量级重复创建** ⇒ 同时是"内存基线"载体）：
//   一、**跨任务在途值**：任务内创建「自定义(结构体) + 容器(数组)」并返回值 ⇒ 等待结果 收下所有权
//   二、**通道承载堆对象**（文本，入堆）100 条：发送/接收 + move 记账
//   三、**批量等待 50 任务**（结果数组持有所有权）
//   四、**丢弃 30 个任务句柄**：不崩溃（句柄资源表生命周期，最坏泄漏、绝不误回收）
// 判据：
//   · 语义精确（各段校验和）；· 内存（`内存对账门禁` 自动纳入，两模式）：违例 == 0，存活不随轮数增长
// ⚠ 编写约束（对应缺陷复现件，避免踩语言表面限制）：
//   · **F2**：闭包体内不写「对象.字段 = 值」⇒ 结构体操作集中到具名函数，闭包体只留「返回 <调用>」；
//   · **F3**：通道接收值的「值.字段」被拒 ⇒ 通道负载用**文本**（入堆对象），接收侧只用方法/函数取值。
// ══════════════════════════════════════════════════════════════════════════
导入 并发
通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

结构体 载荷:
    整数 编号 = 0
    数组<整数> 数据 = []
结束

// 在**具名函数**内创建「自定义 + 容器」（F2：闭包内不可写字段 ⇒ 集中在此）
造载荷(整数 编号) 载荷:
    结果 = 载荷()
    结果.编号 = 编号
    结果.数据.追加(编号 * 2)
    返回 结果
结束

// 取值：3 × 编号（编号 + 数据[1] = 编号*2）
取载荷值(整数 编号) 整数:
    临时 = 造载荷(编号)
    返回 临时.编号 + 临时.数据[1]
结束

启动程序():
    输出("===== 一、任务内创建自定义+容器并返回（跨任务在途值）=====")
    整数 累计 = 0
    整数 轮 = 1
    循环 轮 <= 200:
        当前轮 = 轮
        句柄 = 并发.启动任务(函数() 整数:
            返回 取载荷值(当前轮)
        结束)
        累计 = 累计 + 句柄.等待结果()
        轮 = 轮 + 1
    结束
    检查("200 轮任务返回值精确 = 3×(1+…+200) = 60300", 累计 == 60300)

    输出("===== 二、通道承载堆对象（文本）100 条 =====")
    通道甲 = 并发.通道(200)
    整数 序号 = 1
    循环 序号 <= 100:
        通道甲.发送(转文本(序号 * 2))
        序号 = 序号 + 1
    结束
    整数 消息和 = 0
    循环 序号2 = 1, 序号2 <= 100, 序号2 += 1:
        收 = 通道甲.接收()
        消息和 = 消息和 + 转整数(收)
    结束
    通道甲.关闭()
    检查("通道 100 条文本消息校验和 = 2×(1+…+100) = 10100", 消息和 == 10100)
    检查("通道关闭后 接收=空值", 通道甲.接收() == 空值)

    输出("===== 三、批量等待 50 任务（句柄数组持有所有权）=====")
    句柄列表 = []
    循环 序号3 = 1, 序号3 <= 50, 序号3 += 1:
        值 = 序号3
        句柄 = 并发.启动任务(函数() 整数:
            返回 取载荷值(值)
        结束)
        句柄列表.追加(句柄)
    结束
    结果列表 = 并发.批量等待(句柄列表)
    整数 结果和 = 0
    循环 元素 遍历 结果列表:
        结果和 = 结果和 + 元素
    结束
    检查("批量等待 50 任务：长度=50", 结果列表.长度() == 50)
    检查("批量等待 50 任务：结果和 = 3×(1+…+50) = 3825", 结果和 == 3825)

    输出("===== 四、丢弃 30 个任务句柄（生命周期边界，不崩溃即通过）=====")
    循环 序号4 = 1, 序号4 <= 30, 序号4 += 1:
        并发.启动任务(函数() 整数:
            返回 取载荷值(1)
        结束)
    结束
    并发.任务让出()
    检查("丢弃 30 个任务句柄：不崩溃", 真)

    输出("")
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    结束
结束
