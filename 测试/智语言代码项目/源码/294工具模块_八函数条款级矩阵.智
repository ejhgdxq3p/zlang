// §5.6 工具模块（8 个函数）条款级矩阵（双模）
// 规范条款：§5.6.1~§5.6.5 函数表 + 编码/解码约定 + 数据格式约定
//   ① 正则匹配返回 数组<文本>（无命中为空数组）；非法正则抛异常
//   ② 解析数据 支持 JSON/CSV；JSON null ⇒ 空值；格式非法或 JSON 语法错误抛异常
//   ③ 生成数据 将值生成指定格式文本
//   ④ 哈希算法 仅 MD5 / SHA256；未知算法抛异常
//   ⑤ 编码方案 大小写敏感，仅 "BASE64"；解码容忍空白；非法方案/字符/非 UTF-8 抛异常
//   ⑥ 唯一编号 生成 UUID 文本，多次不同
导入 工具

通过数 = 0
失败数 = 0
总数 = 0

检查(文本 名称, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 名称)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 名称)
    结束
结束

相等文本(文本 名称, 文本 实际, 文本 预期):
    检查(名称, 实际 == 预期)
    如果 实际 != 预期:
        输出("      实际=[" + 实际 + "] 预期=[" + 预期 + "]")
    结束
结束

应抛运行时(文本 名称, 匿名函数 操作):
    捕获:
        操作()
        检查(名称 + "（应抛异常却成功）", 假)
    异常:
        检查(名称, 异常错误().类型 == "运行时异常")
    结束
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 294 工具模块八函数条款级矩阵（§5.6）===")

    输出("-- 5.6.1 正则匹配 --")
    数字数组 = 工具.正则匹配("\反斜杠d+", "abc123def456")
    检查("匹配两组", 数字数组.长度() == 2)
    相等文本("第一组", 数字数组[1], "123")
    相等文本("第二组", 数字数组[2], "456")
    无命中 = 工具.正则匹配("\反斜杠d+", "abc")
    检查("无命中返回空数组", 无命中.长度() == 0)
    检查("中文匹配", 工具.正则匹配("智语言", "我爱智语言").长度() == 1)
    检查("锚点匹配", 工具.正则匹配("^abc$", "abc").长度() == 1)
    检查("锚点不匹配多行内容", 工具.正则匹配("^abc$", "xabc").长度() == 0)
    检查("字符类", 工具.正则匹配("[0-9]+", "a1b22").长度() == 2)
    检查("单词匹配", 工具.正则匹配("\反斜杠w+", "hi there").长度() == 2)

    输出("-- 5.6.1 正则替换 --")
    相等文本("全替换", 工具.正则替换("\反斜杠d+", "#", "a1b22c333"), "a#b#c#")
    相等文本("无命中保持原文", 工具.正则替换("\反斜杠d+", "#", "abc"), "abc")
    相等文本("中文替换", 工具.正则替换("苹果", "香蕉", "我喜欢苹果和苹果"), "我喜欢香蕉和香蕉")
    应抛运行时("非法正则抛", 函数(): 工具.正则匹配("(", "abc") 结束)

    输出("-- 5.6.2 解析数据 JSON --")
    对象 = 工具.解析数据("JSON", "{\引号姓名\引号:\引号张三\引号,\引号年龄\引号:25}")
    检查("对象键数", 对象.长度() == 2)
    相等文本("字符串值", 对象.获取("姓名"), "张三")
    检查("整数值", 对象.获取("年龄") == 25)
    嵌套 = 工具.解析数据("JSON", "{\引号列表\引号:[1,2,3],\引号子\引号:{\引号甲\引号:1}}")
    检查("嵌套数组长度", 嵌套.获取("列表").长度() == 3)
    检查("嵌套对象取值", 嵌套.获取("子").获取("甲") == 1)
    纯数组 = 工具.解析数据("JSON", "[4,5,6]")
    检查("纯数组长度", 纯数组.长度() == 3)
    检查("纯数组元素", 纯数组[2] == 5)
    空值项 = 工具.解析数据("JSON", "{\引号甲\引号:null}")
    空值成员 = 空值项.获取("甲")
    检查("JSON null ⇒ 空值", 空值成员 == 空值)
    逻辑项 = 工具.解析数据("JSON", "{\引号甲\引号:true}")
    检查("JSON true ⇒ 逻辑真", 逻辑项.获取("甲") == 真)
    小数项 = 工具.解析数据("JSON", "{\引号甲\引号:1.5}")
    检查("JSON 小数", 小数项.获取("甲") == 1.5)
    转义项 = 工具.解析数据("JSON", "{\引号甲\引号:\引号行1\反斜杠n行2\引号}")
    检查("JSON 转义换行", 转义项.获取("甲").是否包含("\换行"))

    输出("-- 5.6.2 解析数据 非法输入 --")
    应抛运行时("JSON 语法错误抛", 函数(): 工具.解析数据("JSON", "{非法}") 结束)
    应抛运行时("JSON 截断抛", 函数(): 工具.解析数据("JSON", "{\引号甲\引号:") 结束)
    应抛运行时("未知格式抛", 函数(): 工具.解析数据("XML", "<a/>") 结束)

    输出("-- 5.6.2 解析数据 CSV --")
    表格 = 工具.解析数据("CSV", "甲,乙\换行1,2\换行")
    检查("CSV 行数", 表格.长度() == 2)
    检查("CSV 首行列数", 表格[1].长度() == 2)
    相等文本("CSV 首行首列", 表格[1][1], "甲")
    相等文本("CSV 数值保留为文本", 表格[2][2], "2")

    输出("-- 5.6.2 生成数据 --")
    相等文本("生成单键对象", 工具.生成数据("JSON", {"甲": 1}), "{\引号甲\引号:1}")
    相等文本("生成数组", 工具.生成数据("JSON", [1, 2, 3]), "[1,2,3]")
    相等文本("生成整数", 工具.生成数据("JSON", 42), "42")
    相等文本("生成文本加引号", 工具.生成数据("JSON", "abc"), "\引号abc\引号")
    相等文本("生成逻辑 true", 工具.生成数据("JSON", 真), "true")
    相等文本("生成空值 null", 工具.生成数据("JSON", 空值), "null")
    回读 = 工具.解析数据("JSON", 工具.生成数据("JSON", [1, [2, 3]]))
    检查("生成→解析 往返一致", 回读.长度() == 2 且 回读[2].长度() == 2)

    输出("-- 5.6.3 哈希算法 --")
    相等文本("MD5 空串", 工具.哈希算法("MD5", ""), "d41d8cd98f00b204e9800998ecf8427e")
    相等文本("MD5 hello world", 工具.哈希算法("MD5", "hello world"), "5eb63bbbe01eeed093cb22bb8f5acdc3")
    相等文本("SHA256 空串", 工具.哈希算法("SHA256", ""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    相等文本("SHA256 hello world", 工具.哈希算法("SHA256", "hello world"), "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9")
    检查("MD5 定长 32", 工具.哈希算法("MD5", "任意内容").长度() == 32)
    检查("SHA256 定长 64", 工具.哈希算法("SHA256", "任意内容").长度() == 64)
    检查("中文内容可哈希", 工具.哈希算法("MD5", "智语言").长度() == 32)
    检查("相同输入结果稳定", 工具.哈希算法("SHA256", "稳定") == 工具.哈希算法("SHA256", "稳定"))
    应抛运行时("未知算法 SHA1 抛", 函数(): 工具.哈希算法("SHA1", "x") 结束)
    应抛运行时("未知算法 NOPE 抛", 函数(): 工具.哈希算法("NOPE", "x") 结束)

    输出("-- 5.6.4 编码/解码方案（BASE64）--")
    相等文本("BASE64 abc", 工具.编码方案("BASE64", "abc"), "YWJj")
    相等文本("BASE64 中文", 工具.编码方案("BASE64", "你好，智语言！"), "5L2g5aW977yM5pm66K+t6KiA77yB")
    相等文本("BASE64 空串", 工具.编码方案("BASE64", ""), "")
    相等文本("解码回原文", 工具.解码方案("BASE64", 工具.编码方案("BASE64", "你好，智语言！")), "你好，智语言！")
    相等文本("解码容忍前导空白", 工具.解码方案("BASE64", " YWJj"), "abc")
    相等文本("解码容忍尾随空白", 工具.解码方案("BASE64", "YWJj "), "abc")
    相等文本("解码容忍换行", 工具.解码方案("BASE64", "YW\换行Jj"), "abc")
    相等文本("解码空串", 工具.解码方案("BASE64", ""), "")
    应抛运行时("方案名小写抛（大小写敏感）", 函数(): 工具.编码方案("base64", "abc") 结束)
    应抛运行时("未知方案抛", 函数(): 工具.编码方案("HEX", "abc") 结束)
    应抛运行时("非法字符解码抛", 函数(): 工具.解码方案("BASE64", "!!!") 结束)
    应抛运行时("非 UTF-8 结果抛", 函数(): 工具.解码方案("BASE64", "/w==") 结束)
    // 缺 padding 是宽容的（规范只列「非法字符 / 非 UTF-8 / 方案不支持」三类必须抛）
    相等文本("缺 padding 容忍（YWJ ⇒ ab）", 工具.解码方案("BASE64", "YWJ"), "ab")
    相等文本("缺 padding 容忍（YWJjZA ⇒ abcd）", 工具.解码方案("BASE64", "YWJjZA"), "abcd")
    应抛运行时("无法解出的长度抛（YWJjZ）", 函数(): 工具.解码方案("BASE64", "YWJjZ") 结束)

    输出("-- 5.6.5 唯一编号 --")
    编号甲 = 工具.唯一编号()
    编号乙 = 工具.唯一编号()
    相等文本("UUID 长度 36", 转文本(编号甲.长度()), "36")
    检查("UUID 含连字符", 编号甲.是否包含("-"))
    检查("两次生成不同", 编号甲 != 编号乙)
    编号集 = {编号甲: 1, 编号乙: 2}
    检查("不同编号可作不同键", 编号集.长度() == 2)
    循环 轮次 = 1, 轮次 <= 20, 轮次 += 1:
        编号集.插入(工具.唯一编号(), 轮次)
    结束
    检查("连续 20 次生成无重复", 编号集.长度() == 22)

    收尾()
结束
