// 206 时间.休眠 边界与**负数异常**（F31 修复的常驻回归护栏，2026-10-02）
//
// 背景（**F31 真实缺陷，已修**）：`时间.休眠(负数)` 原先经 `ms as u64` 变 u64 巨值 ⇒ **永久挂起** ✗
//   实测（修复前，双模一致）：解释模式仅打印首行后挂死（6s 硬超时救回）；编译模式同样挂死，
//   且**遗留进程无法被工具链自动清理** ✗ ⇒ 任何含该写法的测试会拖死整条流水线 ✗。
//   ⚠ 本用例是修复后才可能存在的（修复前它会挂死 ✗）—— 这正是它的价值：**把挂死钉死为历史** ✓。
//
// 修复口径（规范 §5.4.4 只说「暂停执行指定毫秒数」，负值无定义 ⇒ 按项目铁律**不静默、不挂死** ✓）：
//   负数 ⇒ 抛**可捕获异常**（类型「运行时异常」，描述含「毫秒数不能为负」✓），与 `时间.解析` 非法格式同族 ✓；
//   0 / 正数 ⇒ 正常返回 ✓。实现位于 `基础功能/src/标准库功能/时间系统函数.rs`（双后端共用真相层 ⇒ 自动 parity ✓）。
通过数 = 0
失败数 = 0
总数 = 0

导入 时间

检查(文本 描述, 逻辑 条件):
    本模块.总数 = 本模块.总数 + 1
    如果 条件:
        本模块.通过数 = 本模块.通过数 + 1
        输出("  ✅ " + 描述)
    否则:
        本模块.失败数 = 本模块.失败数 + 1
        输出("  ❌ " + 描述)
    结束
结束

记录(文本 描述, 文本 值):
    输出("  ℹ " + 描述 + " = " + 值)
结束

收尾():
    输出("通过：" + 转文本(本模块.通过数) + " / " + 转文本(本模块.总数))
    如果 本模块.失败数 > 0:
        输出("存在失败用例：" + 转文本(本模块.失败数))
    否则:
        输出("全部用例通过")
    结束
结束

启动程序():
    输出("=== 206 时间.休眠 负数与边界（F31 护栏）===")

    // ① 负数 ⇒ 可捕获异常（**绝不挂起** ✓）
    捕获:
        时间.休眠(0 - 1)
        输出("  ❌ 休眠(-1) 未抛异常（应抛可捕获异常 ✗）")
        检查("休眠(-1) 应抛异常", 假)
    异常:
        错误 = 异常错误()
        记录("休眠(-1) 异常描述", 错误.描述)
        检查("休眠(-1) ⇒ 抛可捕获异常", 真)
        检查("异常描述含「不能为负」", 错误.描述.是否包含("不能为负"))
        检查("异常描述含原始值 -1", 错误.描述.是否包含("-1"))
    结束
    捕获:
        时间.休眠(0 - 1000000)
        检查("休眠(-1000000) 应抛异常", 假)
    异常:
        检查("休眠(-1000000) ⇒ 抛可捕获异常", 真)
    结束
    // 异常被捕获后**程序继续正常执行** ✓（关键：证明是可控异常而非进程终止 ✓）
    检查("捕获后程序继续执行（本行即证据）", 真)

    // ② 0 与正数 ⇒ 正常返回
    开始 = 时间.获取计时器()
    时间.休眠(0)
    检查("休眠(0) 正常返回", 真)
    时间.休眠(1)
    检查("休眠(1) 正常返回", 真)
    时间.休眠(2)
    检查("休眠(2) 正常返回", 真)
    结束时刻 = 时间.获取计时器()
    检查("休眠累计耗时 ≥ 0（计时器单调 ✓）", 结束时刻 >= 开始)
    记录("休眠 0+1+2ms 实测耗时（毫秒）", 转文本(结束时刻 - 开始))

    // ③ 循环内负数首次即抛（不会"睡死"✗），且可被外层捕获
    // ⚠ 注意（§2.4.7）：函数内**裸名 = 局部变量**，模块变量必须 `本模块.名` —— 两者是不同变量 ✗
    //   （本项目编译器会给出精确诊断：「模块级变量必须用 `本模块.X` 访问」✓）
    捕到次数 = 0
    循环序数 = 0
    循环 序 = 1, 序 <= 3, 序 += 1:
        循环序数 = 循环序数 + 1
        捕获:
            时间.休眠(0 - 序)
        异常:
            捕到次数 = 捕到次数 + 1
        结束
    结束
    记录("循环实际迭代次数（期望 3）", 转文本(循环序数))
    记录("循环内捕获到的异常次数（期望 3）", 转文本(捕到次数))
    检查("循环内 3 次负数休眠 ⇒ 3 次可捕获异常", 捕到次数 == 3)

    收尾()
结束
